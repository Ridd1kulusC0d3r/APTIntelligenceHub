# Potential Persistence Via GlobalFlags | T1546.012 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_persistence_globalflags.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=13 ((TargetObject="*\\Microsoft\\Windows NT\\CurrentVersion\\*" TargetObject="*\\Image File Execution Options\\*" TargetObject="*\\GlobalFlag*") OR (TargetObject="*\\Microsoft\\Windows NT\\CurrentVersion\\*" TargetObject="*\\SilentProcessExit\\*" (TargetObject IN ("*\\ReportingMode*", "*\\MonitorProcess*"))))
