# Suspicious Double Extension Files | T1036.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_double_extension.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=11
| rex field=TargetFilename "(?<TargetFilenameMatch>(?i)\\.(docx?|gif|jpe?g|mp3|mp4|pdf|png|pptx?|rtf|svg|txt|xlsx?)\\.(bat|exe|iso|rar|svg|vbe|vbs|zip)$)"
| eval TargetFilenameCondition=if(isnotnull(TargetFilenameMatch), "true", "false")
| search (TargetFilenameCondition="true" OR TargetFilename IN ("*.rar.exe", "*.zip.exe")) NOT (TargetFilename IN ("*.svg.svg", "*.png.svg", "*.jpg.svg", "*.jpeg.svg")) NOT TargetFilename="/usr/share/icons/*"
