# Enable Microsoft Dynamic Data Exchange | T1559.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_office_enable_dde.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=13 ((TargetObject="*\\Word\\Security\\AllowDDE" (Details IN ("DWORD (0x00000001)", "DWORD (0x00000002)"))) OR ((TargetObject IN ("*\\Excel\\Security\\DisableDDEServerLaunch", "*\\Excel\\Security\\DisableDDEServerLookup")) Details="DWORD (0x00000000)"))
