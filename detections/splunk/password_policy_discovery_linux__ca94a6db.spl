# Password Policy Discovery - Linux | T1201 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/lnx_auditd_password_policy_discovery.yml
(type="PATH" (name IN ("/etc/login.defs", "/etc/pam.d/auth", "/etc/pam.d/common-account", "/etc/pam.d/common-auth", "/etc/pam.d/common-password", "/etc/pam.d/system-auth", "/etc/security/pwquality.conf"))) OR (type="EXECVE" a0="chage" (a1 IN ("--list", "-l"))) OR (type="EXECVE" a0="passwd" (a1 IN ("-S", "--status")))
