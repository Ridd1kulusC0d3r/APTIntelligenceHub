# LSA PPL Protection Setting Modification via CommandLine | T1689 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_lsa_ppl_protection_setting_modification_via_cli.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (Image IN ("*\\reg.exe", "*\\powershell.exe", "*\\pwsh.exe") OR OriginalFileName IN ("reg.exe", "powershell.exe", "pwsh.dll")) CommandLine="*ControlSet*" CommandLine="*\\Control\\Lsa*" (CommandLine IN ("*Set-ItemProperty*", "*New-ItemProperty*", "* add *")) (CommandLine IN ("*IsPplAutoEnabled*", "*RunAsPPL*", "*RunAsPPLBoot*"))
