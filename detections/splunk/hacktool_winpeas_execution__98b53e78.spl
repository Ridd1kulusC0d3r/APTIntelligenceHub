# HackTool - winPEAS Execution | T1046, T1082, T1087 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_winpeas.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (OriginalFileName="winPEAS.exe" OR Image IN ("*\\winPEASany_ofs.exe", "*\\winPEASany.exe", "*\\winPEASx64_ofs.exe", "*\\winPEASx64.exe", "*\\winPEASx86_ofs.exe", "*\\winPEASx86.exe") OR CommandLine IN ("* applicationsinfo*", "* browserinfo*", "* eventsinfo*", "* fileanalysis*", "* filesinfo*", "* processinfo*", "* servicesinfo*", "* windowscreds*") OR CommandLine="*https://github.com/carlospolop/PEASS-ng/releases/latest/download/*" OR ParentCommandLine="* -linpeas" OR CommandLine="* -linpeas")
