# Set Suspicious Files as System Files Using Attrib.EXE | T1564.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_attrib_system_susp_paths.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (Image="*\\attrib.exe" OR OriginalFileName="ATTRIB.EXE") CommandLine="* +s*" (CommandLine IN ("* %*", "*\\Users\\Public\\*", "*\\AppData\\Local\\*", "*\\ProgramData\\*", "*\\Downloads\\*", "*\\Windows\\Temp\\*")) (CommandLine IN ("*.bat*", "*.dll*", "*.exe*", "*.hta*", "*.ps1*", "*.vbe*", "*.vbs*")) NOT (CommandLine="*\\Windows\\TEMP\\*" CommandLine="*.exe*")
