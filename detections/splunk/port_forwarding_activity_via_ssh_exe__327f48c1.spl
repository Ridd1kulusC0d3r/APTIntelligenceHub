# Port Forwarding Activity Via SSH.EXE | T1021.001, T1021.004, T1572 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_ssh_port_forward.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 Image="*\\ssh.exe" (CommandLine="* -R *" OR CommandLine="* /R *" OR CommandLine="* –R *" OR CommandLine="* —R *" OR CommandLine="* ―R *")
