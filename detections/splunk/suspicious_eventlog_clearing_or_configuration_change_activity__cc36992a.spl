# Suspicious Eventlog Clearing or Configuration Change Activity | T1685.001, T1685.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_eventlog_clear.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (((Image="*\\wevtutil.exe" OR OriginalFileName="wevtutil.exe") (CommandLine IN ("*clear-log *", "* cl *", "*set-log *", "* sl *", "*lfn:*"))) OR ((Image IN ("*\\powershell.exe", "*\\powershell_ise.exe", "*\\pwsh.exe")) (CommandLine IN ("*Clear-EventLog *", "*Remove-EventLog *", "*Limit-EventLog *", "*Clear-WinEvent *") OR (CommandLine="*Eventing.Reader.EventLogSession*" CommandLine="*ClearLog*") OR (CommandLine="*Diagnostics.EventLog*" CommandLine="*Clear*"))) OR ((Image IN ("*\\powershell.exe", "*\\powershell_ise.exe", "*\\pwsh.exe", "*\\wmic.exe")) CommandLine="*ClearEventLog*")) NOT ((ParentImage IN ("C:\\Windows\\SysWOW64\\msiexec.exe", "C:\\Windows\\System32\\msiexec.exe")) CommandLine="* sl *")
