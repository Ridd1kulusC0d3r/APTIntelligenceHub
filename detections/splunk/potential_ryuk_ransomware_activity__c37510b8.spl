# Potential Ryuk Ransomware Activity | T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/Malware/Ryuk/proc_creation_win_malware_ryuk.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 ((CommandLine="*Microsoft\\Windows\\CurrentVersion\\Run*" CommandLine="*C:\\users\\Public\\*") OR (CommandLine="*del /s /f /q c:\\*" CommandLine="*\*.bac*" CommandLine="*\*.bak*" CommandLine="*\*.bkf*") OR ((Image IN ("*\\net.exe", "*\\net1.exe")) CommandLine="* stop *" CommandLine="* /y*" (CommandLine IN ("*samss*", "*audioendpointbuilder*", "*unistoresvc_*", "*AcrSch2Svc*"))))
