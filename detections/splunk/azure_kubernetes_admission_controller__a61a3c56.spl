# Azure Kubernetes Admission Controller | T1078, T1552, T1552.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/azure/activity_logs/azure_kubernetes_admission_controller.yml
(operationName IN ("MICROSOFT.KUBERNETES/CONNECTEDCLUSTERS/ADMISSIONREGISTRATION.K8S.IO*", "MICROSOFT.CONTAINERSERVICE/MANAGEDCLUSTERS/ADMISSIONREGISTRATION.K8S.IO*")) (operationName IN ("*/MUTATINGWEBHOOKCONFIGURATIONS/WRITE", "*/VALIDATINGWEBHOOKCONFIGURATIONS/WRITE"))
