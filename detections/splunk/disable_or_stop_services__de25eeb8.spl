# Disable Or Stop Services | T1489, T1685 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_services_stop_and_disable.yml
(Image IN ("*/service", "*/systemctl", "*/chkconfig")) (CommandLine IN ("* stop *", "* disable *")) NOT ((Image="*/systemctl" (CommandLine IN ("*--no-reload disable snap-snapd-*", "* stop snap-snapd-*"))) OR (Image="*/systemctl" ParentCommandLine="*tmp.ci/preinst upgrade*" CommandLine="* stop *" CommandLine="*ssh.*") OR (ParentCommandLine="*/dpkg/info/ubuntu-pro-client.prerm upgrade*" Image="*/systemctl")) NOT (Image="*/systemctl" CommandLine="*snap.amazon-ssm-agent.amazon-ssm-agent.service")
