# Google Cloud Kubernetes Admission Controller | T1078, T1552, T1552.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/gcp/audit/gcp_kubernetes_admission_controller.yml
gcp.audit.method_name="admissionregistration.k8s.io.v*" (gcp.audit.method_name IN ("*.mutatingwebhookconfigurations.*", "*.validatingwebhookconfigurations.*")) (gcp.audit.method_name IN ("*create", "*patch", "*replace"))
