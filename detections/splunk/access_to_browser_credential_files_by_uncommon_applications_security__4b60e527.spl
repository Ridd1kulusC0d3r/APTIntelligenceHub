# Access To Browser Credential Files By Uncommon Applications - Security | T1555.003 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/builtin/security/win_security_file_access_browser_credential.yml
source="WinEventLog:Security" EventCode=4663 ObjectType="File" AccessMask="0x1" (ObjectName IN ("*\\User Data\\Default\\Login Data*", "*\\User Data\\Local State*", "*\\User Data\\Default\\Network\\Cookies*") OR FileName IN ("*\\cookies.sqlite", "*\\places.sqlite", "*release\\key3.db", "*release\\key4.db", "*release\\logins.json")) NOT (ProcessName="System" OR ProcessName IN ("C:\\Program Files (x86)\\*", "C:\\Program Files\\*", "C:\\Windows\\system32\\*", "C:\\Windows\\SysWOW64\\*")) NOT (ProcessName="C:\\ProgramData\\Microsoft\\Windows Defender\\*" (ProcessName IN ("*\\MpCopyAccelerator.exe", "*\\MsMpEng.exe")))
