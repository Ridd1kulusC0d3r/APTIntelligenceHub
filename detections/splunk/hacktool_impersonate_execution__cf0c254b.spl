# HackTool - Impersonate Execution | T1134.001, T1134.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_impersonate.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 ((CommandLine="*impersonate.exe*" (CommandLine IN ("* list *", "* exec *", "* adduser *"))) OR Hashes IN ("*MD5=9520714AB576B0ED01D1513691377D01*", "*SHA256=E81CC96E2118DC4FBFE5BAD1604E0AC7681960143E2101E1A024D52264BB0A8A*", "*IMPHASH=0A358FFC1697B7A07D0E817AC740DF62*"))
