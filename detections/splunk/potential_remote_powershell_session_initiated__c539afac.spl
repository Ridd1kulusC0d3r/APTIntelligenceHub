# Potential Remote PowerShell Session Initiated | T1021.006, T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_susp_remote_powershell_session.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=3 (DestinationPort IN (5985, 5986)) Initiated="true" SourceIsIpv6="false" NOT (User IN ("*NETWORK SERVICE*", "*NETZWERKDIENST*", "*SERVICIO DE RED*", "*SERVIZIO DI RETE*") OR (User="*SERVICE R*" User="*SEAU*") OR ((SourceIp IN ("::1", "127.0.0.1")) (DestinationIp IN ("::1", "127.0.0.1")))) NOT (Image IN ("C:\\Program Files\\Avast Software\\Avast\\AvastSvc.exe", "C:\\Program Files (x86)\\Avast Software\\Avast\\AvastSvc.exe"))
