# HackTool - CrackMapExec Execution Patterns | T1047, T1053, T1059.001, T1059.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_crackmapexec_execution_patterns.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (CommandLine IN ("*cmd.exe /Q /c * 1> \\\\*\\*\\* 2>&1*", "*cmd.exe /C * > \\\\*\\*\\* 2>&1*", "*cmd.exe /C * > *\\Temp\\* 2>&1*", "*powershell.exe -exec bypass -noni -nop -w 1 -C \"*", "*powershell.exe -noni -nop -w 1 -enc *"))
