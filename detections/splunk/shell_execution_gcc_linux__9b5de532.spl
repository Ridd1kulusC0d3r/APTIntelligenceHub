# Shell Execution GCC  - Linux | T1083 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_gcc_shell_execution.yml
(Image IN ("*/c89", "*/c99", "*/gcc")) CommandLine="*-wrapper*" (CommandLine IN ("*/bin/bash,-s*", "*/bin/dash,-s*", "*/bin/fish,-s*", "*/bin/sh,-s*", "*/bin/zsh,-s*"))
