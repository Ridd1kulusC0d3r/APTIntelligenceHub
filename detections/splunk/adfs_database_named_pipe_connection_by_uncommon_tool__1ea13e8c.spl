# ADFS Database Named Pipe Connection By Uncommon Tool | T1005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/pipe_created/pipe_created_adfs_namedpipe_connection_uncommon_tool.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" (EventCode IN (17, 18)) PipeName="\\MICROSOFT##WID\\tsql\\query" NOT (Image IN ("*:\\Windows\\System32\\mmc.exe", "*:\\Windows\\system32\\svchost.exe", "*:\\Windows\\System32\\wsmprovhost.exe", "*:\\Windows\\SysWOW64\\mmc.exe", "*:\\Windows\\SysWOW64\\wsmprovhost.exe", "*:\\Windows\\WID\\Binn\\sqlwriter.exe", "*\\AzureADConnect.exe", "*\\Microsoft.Identity.Health.Adfs.PshSurrogate.exe", "*\\Microsoft.IdentityServer.ServiceHost.exe", "*\\Microsoft.Tri.Sensor.exe", "*\\sqlservr.exe", "*\\tssdis.exe"))
