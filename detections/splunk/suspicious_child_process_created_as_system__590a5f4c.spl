# Suspicious Child Process Created as System | T1134.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_child_process_as_system_.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (ParentUser IN ("*AUTHORI*", "*AUTORI*")) (ParentUser IN ("*\\NETWORK SERVICE", "*\\LOCAL SERVICE")) (User IN ("*AUTHORI*", "*AUTORI*")) (User IN ("*\\SYSTEM", "*\\Système", "*\\СИСТЕМА")) (IntegrityLevel IN ("System", "S-1-16-16384")) NOT (Image="*\\rundll32.exe" CommandLine="*DavSetCookie*")
