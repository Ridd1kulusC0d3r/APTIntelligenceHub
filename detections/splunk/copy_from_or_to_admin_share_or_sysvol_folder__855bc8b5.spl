# Copy From Or To Admin Share Or Sysvol Folder | T1021.002, T1039, T1048 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_copy_lateral_movement.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (CommandLine IN ("*\\\\*\\*$*", "*\\Sysvol\\*")) (Image IN ("*\\robocopy.exe", "*\\xcopy.exe") OR OriginalFileName IN ("robocopy.exe", "XCOPY.EXE") OR ((Image="*\\cmd.exe" OR OriginalFileName="Cmd.Exe") CommandLine="*copy*") OR ((Image IN ("*\\powershell_ise.exe*", "*\\powershell.exe*", "*\\pwsh.exe*") OR OriginalFileName IN ("powershell_ise.exe", "PowerShell.EXE", "pwsh.dll")) (CommandLine IN ("*copy-item*", "*copy *", "*cpi *", "* cp *", "*move *", "* move-item*", "* mi *", "* mv *"))))
