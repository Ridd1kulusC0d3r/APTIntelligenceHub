# CredUI.DLL Loaded By Uncommon Process | T1056.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/image_load/image_load_dll_credui_uncommon_process_load.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=7 (ImageLoaded IN ("*\\credui.dll", "*\\wincredui.dll") OR OriginalFileName IN ("credui.dll", "wincredui.dll")) NOT (Image IN ("C:\\Program Files (x86)\\*", "C:\\Program Files\\*", "C:\\Windows\\System32\\*", "C:\\Windows\\SysWOW64\\*", "C:\\Windows\\SystemApps\\*") OR Image IN ("C:\\Windows\\explorer.exe", "C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe", "C:\\Windows\\regedit.exe")) NOT (Image="*\\opera_autoupdate.exe" OR Image IN ("*\\procexp64.exe", "*\\procexp64a.exe", "*\\procexp.exe") OR (Image="C:\\Users\\*" Image="*\\AppData\\Local\\Microsoft\\Teams\\*" Image="*\\Teams.exe") OR (Image="C:\\Users\\*" Image="*\\AppData\\Local\\Microsoft\\OneDrive\\*"))
