# Unsigned DLL Loaded by Windows Utility | T1218.010, T1218.011 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/image_load/image_load_susp_unsigned_dll.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=7 (Image IN ("*\\InstallUtil.exe", "*\\RegAsm.exe", "*\\RegSvcs.exe", "*\\regsvr32.exe", "*\\rundll32.exe")) NOT (Signed="true" OR SignatureStatus IN ("errorChaining", "errorCode_endpoint", "errorExpired", "trusted", "Valid") OR NOT Signed=* OR Signed IN ("", "-") OR NOT SignatureStatus=* OR SignatureStatus IN ("", "-") OR ((Image IN ("C:\\Windows\\SysWOW64\\rundll32.exe", "C:\\Windows\\System32\\rundll32.exe")) ImageLoaded="C:\\Windows\\Installer\\*" (ImageLoaded IN ("*.tmp-\\Microsoft.Deployment.WindowsInstaller.dll", "*.tmp-\\Avira.OE.Setup.CustomActions.dll"))) OR ((Image IN ("C:\\Windows\\SysWOW64\\*", "C:\\Windows\\System32\\*", "C:\\Windows\\Microsoft.NET\\Framework64*")) Image="*\\RegAsm.exe" ImageLoaded="*.dll" ImageLoaded="C:\\Windows\\assembly\\NativeImages*")) NOT ((Image IN ("C:\\Windows\\SysWOW64\\regsvr32.exe", "C:\\Windows\\System32\\regsvr32.exe")) (ImageLoaded IN ("C:\\Program Files (x86)\\K-Lite Codec Pack\\*", "C:\\Program Files\\K-Lite Codec Pack\\*")))
