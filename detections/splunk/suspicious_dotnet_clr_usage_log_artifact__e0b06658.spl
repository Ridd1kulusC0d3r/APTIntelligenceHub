# Suspicious DotNET CLR Usage Log Artifact | T1218 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_net_cli_artefact.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=11 (TargetFilename IN ("*\\UsageLogs\\cmstp.exe.log", "*\\UsageLogs\\cscript.exe.log", "*\\UsageLogs\\mshta.exe.log", "*\\UsageLogs\\msxsl.exe.log", "*\\UsageLogs\\regsvr32.exe.log", "*\\UsageLogs\\rundll32.exe.log", "*\\UsageLogs\\svchost.exe.log", "*\\UsageLogs\\wscript.exe.log", "*\\UsageLogs\\wmic.exe.log")) NOT (ParentImage="*\\MsiExec.exe" ParentCommandLine="* -Embedding*" Image="*\\rundll32.exe" CommandLine="*Temp*" CommandLine="*zzzzInvokeManagedCustomActionOutOfProc*")
