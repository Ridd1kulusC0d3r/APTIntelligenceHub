# PUA - Seatbelt Execution | T1083, T1087, T1526 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_pua_seatbelt.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (Image="*\\Seatbelt.exe" OR OriginalFileName="Seatbelt.exe" OR Description="Seatbelt" OR CommandLine IN ("* DpapiMasterKeys*", "* InterestingProcesses*", "* InterestingFiles*", "* CertificateThumbprints*", "* ChromiumBookmarks*", "* ChromiumHistory*", "* ChromiumPresence*", "* CloudCredentials*", "* CredEnum*", "* CredGuard*", "* FirefoxHistory*", "* ProcessCreationEvents*") OR ((CommandLine IN ("* -group=misc*", "* -group=remote*", "* -group=chromium*", "* -group=slack*", "* -group=system*", "* -group=user*", "* -group=all*")) CommandLine="* -outputfile=*"))
