# Use of W32tm as Timer | T1124 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_w32tm.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (Image="*\\w32tm.exe" OR OriginalFileName="w32time.dll") CommandLine="*/stripchart*" CommandLine="*/computer:*" CommandLine="*/period:*" CommandLine="*/dataonly*" CommandLine="*/samples:*"
