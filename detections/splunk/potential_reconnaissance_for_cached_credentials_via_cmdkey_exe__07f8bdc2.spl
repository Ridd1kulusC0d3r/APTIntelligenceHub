# Potential Reconnaissance For Cached Credentials Via Cmdkey.EXE | T1003.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_cmdkey_recon.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (Image="*\\cmdkey.exe" OR OriginalFileName="cmdkey.exe") (CommandLine="* -l*" OR CommandLine="* /l*" OR CommandLine="* –l*" OR CommandLine="* —l*" OR CommandLine="* ―l*")
