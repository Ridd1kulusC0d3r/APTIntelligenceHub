# Access To Potentially Sensitive Sysvol Files By Uncommon Applications | T1552.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_access/file_access_win_susp_gpo_files.yml
FileName="\\*" FileName="*\\sysvol\\*" FileName="*\\Policies\\*" (FileName IN ("*audit.csv", "*Files.xml", "*GptTmpl.inf", "*groups.xml", "*Registry.pol", "*Registry.xml", "*scheduledtasks.xml", "*scripts.ini", "*services.xml")) NOT (Image IN ("C:\\Program Files (x86)\\*", "C:\\Program Files\\*", "C:\\Windows\\system32\\*", "C:\\Windows\\SysWOW64\\*") OR Image="C:\\Windows\\explorer.exe")
