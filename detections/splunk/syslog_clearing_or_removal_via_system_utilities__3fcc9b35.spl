# Syslog Clearing or Removal Via System Utilities | T1685.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_clear_syslog.yml
(CommandLine="*/var/log/syslog*" ((Image="*/rm" (CommandLine IN ("* -r *", "* -f *", "* -rf *", "*/var/log/syslog*"))) OR Image="*/unlink" OR Image="*/mv" OR (Image="*/truncate" CommandLine="*0 *" CommandLine="*/var/log/syslog*" (CommandLine IN ("*-s *", "*-c *", "*--size*"))) OR (Image="*/ln" CommandLine="*/dev/null *" CommandLine="*/var/log/syslog*" (CommandLine IN ("*-sf *", "*-sfn *", "*-sfT *"))) OR (Image="*/cp" CommandLine="*/dev/null*") OR (Image="*/shred" CommandLine="*-u *"))) OR CommandLine IN ("* > /var/log/syslog*", "* >/var/log/syslog*", "* >| /var/log/syslog*", "*: > /var/log/syslog*", "*:> /var/log/syslog*", "*:>/var/log/syslog*", "*>|/var/log/syslog*") OR CommandLine IN ("*journalctl --vacuum*", "*journalctl --rotate*")
