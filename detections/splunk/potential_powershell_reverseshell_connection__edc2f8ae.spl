# Potential Powershell ReverseShell Connection | T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_reverse_shell_connection.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (OriginalFileName IN ("PowerShell.EXE", "pwsh.dll") OR Image IN ("*\\powershell.exe", "*\\pwsh.exe")) CommandLine="* Net.Sockets.TCPClient*" CommandLine="*.GetStream(*" CommandLine="*.Write(*"
