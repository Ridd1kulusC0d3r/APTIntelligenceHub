# HackTool - Certipy Execution | T1649 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_certipy.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (Image="*\\Certipy.exe" OR OriginalFileName="Certipy.exe" OR Description="*Certipy*" OR ((CommandLine IN ("* account *", "* auth *", "* cert *", "* find *", "* forge *", "* ptt *", "* relay *", "* req *", "* shadow *", "* template *")) (CommandLine IN ("* -bloodhound*", "* -ca-pfx *", "* -dc-ip *", "* -kirbi*", "* -old-bloodhound*", "* -pfx *", "* -target*", "* -template*", "* -username *", "* -vulnerable*", "*auth -pfx*", "*shadow auto*", "*shadow list*"))))
