# Suspicious Child Process Of Manage Engine ServiceDesk | T1102 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_java_manageengine_susp_child_process.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 ParentImage="*\\ManageEngine\\ServiceDesk\\*" ParentImage="*\\java.exe*" (Image IN ("*\\AppVLP.exe", "*\\bash.exe", "*\\bitsadmin.exe", "*\\calc.exe", "*\\certutil.exe", "*\\cscript.exe", "*\\curl.exe", "*\\forfiles.exe", "*\\mftrace.exe", "*\\mshta.exe", "*\\net.exe", "*\\net1.exe", "*\\notepad.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\query.exe", "*\\reg.exe", "*\\schtasks.exe", "*\\scrcons.exe", "*\\sh.exe", "*\\systeminfo.exe", "*\\whoami.exe", "*\\wmic.exe", "*\\wscript.exe")) NOT ((Image IN ("*\\net.exe", "*\\net1.exe")) CommandLine="* stop*")
