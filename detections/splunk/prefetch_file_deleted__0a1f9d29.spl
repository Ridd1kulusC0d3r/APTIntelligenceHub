# Prefetch File Deleted | T1070.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_delete/file_delete_win_delete_prefetch.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=23 TargetFilename="*:\\Windows\\Prefetch\\*" TargetFilename="*.pf" NOT (Image="*:\\windows\\system32\\svchost.exe" (User IN ("*AUTHORI*", "*AUTORI*")))
