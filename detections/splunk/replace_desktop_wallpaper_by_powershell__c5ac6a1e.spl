# Replace Desktop Wallpaper by Powershell | T1491.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_susp_wallpaper.yml
(ScriptBlockText="*Get-ItemProperty*" ScriptBlockText="*Registry::*" ScriptBlockText="*HKEY_CURRENT_USER\\Control Panel\\Desktop\\*" ScriptBlockText="*WallPaper*") OR ScriptBlockText="*SystemParametersInfo(20,0,*,3)*"
