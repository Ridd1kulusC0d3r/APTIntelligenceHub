# Suspicious File Created by ArcSOC.exe | T1105, T1127, T1133 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_arcsoc_susp_file_created.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=11 Image="*\\ArcSOC.exe" (TargetFilename IN ("*.ahk", "*.aspx", "*.au3", "*.bat", "*.cmd", "*.dll", "*.exe", "*.hta", "*.js", "*.ps1", "*.py", "*.vbe", "*.vbs", "*.wsf"))
