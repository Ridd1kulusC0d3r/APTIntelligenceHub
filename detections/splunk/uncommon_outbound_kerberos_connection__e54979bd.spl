# Uncommon Outbound Kerberos Connection | T1550.003, T1558 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_susp_outbound_kerberos_connection.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=3 DestinationPort=88 Initiated="true" NOT Image="C:\\Windows\\System32\\lsass.exe" NOT (Image IN ("C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe", "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe") OR Image IN ("C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe", "C:\\Program Files\\Mozilla Firefox\\firefox.exe") OR Image="*\\tomcat\\bin\\tomcat8.exe" OR Image IN ("C:\\Program Files\\Zscaler\\ZSATunnel\\ZSATunnel.exe", "C:\\Program Files (x86)\\Zscaler\\ZSATunnel\\ZSATunnel.exe"))
