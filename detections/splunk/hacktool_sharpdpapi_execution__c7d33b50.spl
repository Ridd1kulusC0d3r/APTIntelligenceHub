# HackTool - SharpDPAPI Execution | T1134.001, T1134.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_sharp_dpapi_execution.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (Image="*\\SharpDPAPI.exe" OR OriginalFileName="SharpDPAPI.exe" OR ((CommandLine IN ("* backupkey *", "* blob *", "* certificates *", "* credentials *", "* keepass *", "* masterkeys *", "* rdg *", "* vaults *")) ((CommandLine="* {*" CommandLine="*}:*") OR CommandLine IN ("* /file:*", "* /machine*", "* /mkfile:*", "* /password:*", "* /pvk:*", "* /server:*", "* /target:*", "* /unprotect*"))))
