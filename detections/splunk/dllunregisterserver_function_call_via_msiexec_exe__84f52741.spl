# DllUnregisterServer Function Call Via Msiexec.EXE | T1218.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_msiexec_dll.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (Image="*\\msiexec.exe" OR OriginalFileName="msiexec.exe") (CommandLine="* -z *" OR CommandLine="* /z *" OR CommandLine="* –z *" OR CommandLine="* —z *" OR CommandLine="* ―z *") CommandLine="*.dll*" NOT CommandLine="*\\MsiExec.exe\" /Z \"C:\\Windows\\CCM\\MsiHandler.dll\""
