# Regedit as Trusted Installer | T1548 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_regedit_trustedinstaller.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 Image="*\\regedit.exe" (ParentImage IN ("*\\TrustedInstaller.exe", "*\\ProcessHacker.exe"))
