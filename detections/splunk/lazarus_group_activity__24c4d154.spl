# Lazarus Group Activity | T1059 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2020/TA/Lazarus/proc_creation_win_apt_lazarus_group_activity.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (CommandLine IN ("*reg.exe save hklm\\sam %temp%\\~reg_sam.save*", "*1q2w3e4r@#$@#$@#$*", "* -hp1q2w3e4 *", "*.dat data03 10000 -p *") OR (CommandLine="*netstat -aon | find *" CommandLine="*ESTA*" CommandLine="* > %temp%\\~*") OR (CommandLine="*.255 10 C:\\ProgramData\\IBM\\*" CommandLine="*.DAT*") OR (CommandLine="* /c *" CommandLine="* -p 0x*" (CommandLine IN ("*C:\\ProgramData\\*", "*C:\\RECYCLER\\*"))) OR (CommandLine="*rundll32 *" CommandLine="*C:\\ProgramData\\*" (CommandLine IN ("*.bin,*", "*.tmp,*", "*.dat,*", "*.io,*", "*.ini,*", "*.db,*"))))
