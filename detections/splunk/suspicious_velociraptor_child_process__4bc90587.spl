# Suspicious Velociraptor Child Process | T1219 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_velociraptor_child_process.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 ParentImage="*\\Velociraptor.exe" ((CommandLine="*code.exe*" CommandLine="*tunnel*" CommandLine="*--accept-server-license-terms*") OR (CommandLine="*msiexec*" CommandLine="*/i*" CommandLine="*http*") OR ((Image IN ("*\\powershell.exe", "*\\powershell_ise.exe", "*\\pwsh.exe")) (CommandLine IN ("*Invoke-WebRequest *", "*IWR *", "*.DownloadFile*", "*.DownloadString*"))))
