# Cred Dump Tools Dropped Files | T1003.001, T1003.002, T1003.003, T1003.004, T1003.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_cred_dump_tools_dropped_files.yml
source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=11 (TargetFilename IN ("*\\fgdump-log*", "*\\kirbi*", "*\\pwdump*", "*\\pwhashes*", "*\\wce_ccache*", "*\\wce_krbtkts*") OR TargetFilename IN ("*\\cachedump.exe", "*\\cachedump64.exe", "*\\DumpExt.dll", "*\\DumpSvc.exe", "*\\Dumpy.exe", "*\\fgexec.exe", "*\\lsremora.dll", "*\\lsremora64.dll", "*\\NTDS.out", "*\\procdump.exe", "*\\procdump64.exe", "*\\procdump64a.exe", "*\\pstgdump.exe", "*\\pwdump.exe", "*\\SAM.out", "*\\SECURITY.out", "*\\servpw.exe", "*\\servpw64.exe", "*\\SYSTEM.out", "*\\test.pwd", "*\\wceaux.dll"))
