// Potential Initial Access via DLL Search Order Hijacking | T1566, T1566.001, T1574, T1574.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_initial_access_dll_search_order_hijacking.yml
((process.executable.caseless:(*\\winword.exe OR *\\excel.exe OR *\\powerpnt.exe OR *\\MSACCESS.EXE OR *\\MSPUB.EXE OR *\\fltldr.exe OR *\\cmd.exe OR *\\certutil.exe OR *\\mshta.exe OR *\\cscript.exe OR *\\wscript.exe OR *\\curl.exe OR *\\powershell.exe OR *\\pwsh.exe)) AND file.path:*.dll AND (file.path:*\\Users\\* AND file.path:*\\AppData\\*) AND (file.path:(*\\Microsoft\\OneDrive\\* OR *\\Microsoft\ OneDrive\\* OR *\\Microsoft\\Teams\\* OR *\\Local\\slack\\app\-* OR *\\Local\\Programs\\Microsoft\ VS\ Code\\*))) AND (NOT (process.executable.caseless:*\\cmd.exe AND (file.path:*\\Users\\* AND file.path:*\\AppData\\* AND file.path:*\\Microsoft\\OneDrive\\* AND file.path:*\\api\-ms\-win\-core\-*)))
