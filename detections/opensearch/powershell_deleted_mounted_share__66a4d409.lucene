// PowerShell Deleted Mounted Share | T1070.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_susp_mounted_share_deletion.yml
(powershell.file.script_block_text:(*Remove\-SmbShare* OR *Remove\-FileShare*)) AND (NOT (powershell.file.script_block_text:*FileShare.cdxml* AND powershell.file.script_block_text:*Microsoft.PowerShell.Core\\Export\-ModuleMember* AND powershell.file.script_block_text:*ROOT\/Microsoft\/Windows\/Storage\/MSFT_FileShare* AND powershell.file.script_block_text:*ObjectModelWrapper* AND powershell.file.script_block_text:*Cmdletization.MethodParameter*))
