// Access To Windows Credential History File By Uncommon Applications | T1555.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_access/file_access_win_susp_credhist.yml
file.path:*\\Microsoft\\Protect\\CREDHIST AND (NOT ((process.executable.caseless:(C\:\\Program\ Files\\* OR C\:\\Program\ Files\ \(x86\)\\* OR C\:\\Windows\\system32\\* OR C\:\\Windows\\SysWOW64\\*)) OR process.executable.caseless:C\:\\Windows\\explorer.exe))
