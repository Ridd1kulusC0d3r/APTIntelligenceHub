// PUA - Rclone Execution | T1567.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_pua_rclone_execution.yml
(process.command_line:*\-\-config\ * AND process.command_line:*\-\-no\-check\-certificate\ * AND process.command_line:*\ copy\ *) OR ((process.executable.caseless:*\\rclone.exe OR process.pe.description:"Rsync for cloud storage") AND (process.command_line:(*pass* OR *user* OR *copy* OR *sync* OR *config* OR *lsd* OR *remote* OR *ls* OR *mega* OR *pcloud* OR *ftp* OR *ignore\-existing* OR *auto\-confirm* OR *transfers* OR *multi\-thread\-streams* OR *no\-check\-certificate\ *)))
