// Suspicious Program Location Whitelisted In Firewall Via Netsh.EXE | T1686.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_netsh_fw_allow_program_in_susp_location.yml
(process.executable.caseless:*\\netsh.exe OR process.pe.original_file_name:netsh.exe) AND ((process.command_line:*firewall* AND process.command_line:*add* AND process.command_line:*allowedprogram*) OR (process.command_line:*advfirewall* AND process.command_line:*firewall* AND process.command_line:*add* AND process.command_line:*rule* AND process.command_line:*action\=allow* AND process.command_line:*program\=*)) AND (process.command_line:(*\:\\$Recycle.bin\\* OR *\:\\RECYCLER.BIN\\* OR *\:\\RECYCLERS.BIN\\* OR *\:\\SystemVolumeInformation\\* OR *\:\\Temp\\* OR *\:\\Users\\Default\\* OR *\:\\Users\\Desktop\\* OR *\:\\Users\\Public\\* OR *\:\\Windows\\addins\\* OR *\:\\Windows\\cursors\\* OR *\:\\Windows\\debug\\* OR *\:\\Windows\\drivers\\* OR *\:\\Windows\\fonts\\* OR *\:\\Windows\\help\\* OR *\:\\Windows\\system32\\tasks\\* OR *\:\\Windows\\Tasks\\* OR *\:\\Windows\\Temp\\* OR *\\Downloads\\* OR *\\Local\ Settings\\Temporary\ Internet\ Files\\* OR *\\Temporary\ Internet\ Files\\Content.Outlook\\* OR *%Public%\\* OR *%TEMP%* OR *%TMP%*))
