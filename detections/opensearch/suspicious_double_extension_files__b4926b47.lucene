// Suspicious Double Extension Files | T1036.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_double_extension.yml
(file.path:/(?i)\.(docx?|gif|jpe?g|mp3|mp4|pdf|png|pptx?|rtf|svg|txt|xlsx?)\.(bat|exe|iso|rar|svg|vbe|vbs|zip)$/ OR (file.path:(*.rar.exe OR *.zip.exe))) AND (NOT (file.path:(*.svg.svg OR *.png.svg OR *.jpg.svg OR *.jpeg.svg))) AND (NOT file.path:\/usr\/share\/icons\/*)
