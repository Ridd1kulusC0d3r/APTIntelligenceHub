// Unsigned DLL Loaded by Windows Utility | T1218.010, T1218.011 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/image_load/image_load_susp_unsigned_dll.yml
(process.executable.caseless:(*\\InstallUtil.exe OR *\\RegAsm.exe OR *\\RegSvcs.exe OR *\\regsvr32.exe OR *\\rundll32.exe)) AND (NOT (file.code_signature.signed:true OR (file.code_signature.status:(errorChaining OR errorCode_endpoint OR errorExpired OR trusted OR Valid)) OR (NOT _exists_:file.code_signature.signed) OR (file.code_signature.signed:("" OR \-)) OR (NOT _exists_:file.code_signature.status) OR (file.code_signature.status:("" OR \-)) OR ((process.executable.caseless:(C\:\\Windows\\SysWOW64\\rundll32.exe OR C\:\\Windows\\System32\\rundll32.exe)) AND file.path:C\:\\Windows\\Installer\\* AND (file.path:(*.tmp\-\\Microsoft.Deployment.WindowsInstaller.dll OR *.tmp\-\\Avira.OE.Setup.CustomActions.dll))) OR ((process.executable.caseless:(C\:\\Windows\\SysWOW64\\* OR C\:\\Windows\\System32\\* OR C\:\\Windows\\Microsoft.NET\\Framework64*)) AND process.executable.caseless:*\\RegAsm.exe AND file.path:*.dll AND file.path:C\:\\Windows\\assembly\\NativeImages*))) AND (NOT ((process.executable.caseless:(C\:\\Windows\\SysWOW64\\regsvr32.exe OR C\:\\Windows\\System32\\regsvr32.exe)) AND (file.path:(C\:\\Program\ Files\ \(x86\)\\K\-Lite\ Codec\ Pack\\* OR C\:\\Program\ Files\\K\-Lite\ Codec\ Pack\\*))))
