// Uncommon File Created In Office Startup Folder | T1587.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_office_uncommon_file_startup.yml
(((file.path:*\\Microsoft\\Word\\STARTUP* OR (file.path:*\\Office* AND file.path:*\\Program\ Files* AND file.path:*\\STARTUP*)) AND (NOT (file.path:(*.docb OR *.docm OR *.docx OR *.dotm OR *.mdb OR *.mdw OR *.pdf OR *.wll OR *.wwl)))) OR ((file.path:*\\Microsoft\\Excel\\XLSTART* OR (file.path:*\\Office* AND file.path:*\\Program\ Files* AND file.path:*\\XLSTART*)) AND (NOT (file.path:(*.xll OR *.xls OR *.xlsm OR *.xlsx OR *.xlt OR *.xltm OR *.xlw))))) AND (NOT ((process.executable.caseless:*\:\\Program\ Files\\Common\ Files\\Microsoft\ Shared\\ClickToRun\\* AND process.executable.caseless:*\\OfficeClickToRun.exe) OR ((process.executable.caseless:(*\:\\Program\ Files\\Microsoft\ Office\\* OR *\:\\Program\ Files\ \(x86\)\\Microsoft\ Office\\*)) AND (process.executable.caseless:(*\\winword.exe OR *\\excel.exe)))))
