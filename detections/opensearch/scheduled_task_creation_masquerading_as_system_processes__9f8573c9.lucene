// Scheduled Task Creation Masquerading as System Processes | T1036.004, T1036.005, T1053.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_schtasks_system_process.yml
(process.executable.caseless:*\\schtasks.exe OR process.pe.original_file_name:schtasks.exe) AND (process.command_line:(*\ \-create\ * OR *\ \/create\ * OR *\ –create\ * OR *\ —create\ * OR *\ ―create\ *) AND (process.command_line:(*\ audiodg* OR *\ conhost* OR *\ dwm.exe* OR *\ explorer* OR *\ lsass* OR *\ lsm* OR *\ mmc* OR *\ msiexec* OR *\ regsvr32* OR *\ rundll32* OR *\ services* OR *\ spoolsv* OR *\ svchost* OR *\ taskeng* OR *\ taskhost* OR *\ wininit* OR *\ winlogon*)))
