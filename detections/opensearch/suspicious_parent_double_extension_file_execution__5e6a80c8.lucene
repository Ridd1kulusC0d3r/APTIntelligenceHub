// Suspicious Parent Double Extension File Execution | T1036.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_double_extension_parent.yml
(process.parent.executable.caseless:(*.doc.lnk OR *.docx.lnk OR *.xls.lnk OR *.xlsx.lnk OR *.ppt.lnk OR *.pptx.lnk OR *.rtf.lnk OR *.pdf.lnk OR *.txt.lnk OR *.doc.js OR *.docx.js OR *.xls.js OR *.xlsx.js OR *.ppt.js OR *.pptx.js OR *.rtf.js OR *.pdf.js OR *.txt.js)) OR (process.parent.command_line:(*.doc.lnk* OR *.docx.lnk* OR *.xls.lnk* OR *.xlsx.lnk* OR *.ppt.lnk* OR *.pptx.lnk* OR *.rtf.lnk* OR *.pdf.lnk* OR *.txt.lnk* OR *.doc.js* OR *.docx.js* OR *.xls.js* OR *.xlsx.js* OR *.ppt.js* OR *.pptx.js* OR *.rtf.js* OR *.pdf.js* OR *.txt.js*))
