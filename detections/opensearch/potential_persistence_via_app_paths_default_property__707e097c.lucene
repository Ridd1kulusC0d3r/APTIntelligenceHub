// Potential Persistence Via App Paths Default Property | T1546.012 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_persistence_app_paths.yml
registry.path:*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App\ Paths* AND (registry.path:(*\(Default\) OR *Path)) AND (winlog.event_data.Details:(*\\Users\\Public* OR *\\AppData\\Local\\Temp\\* OR *\\Windows\\Temp\\* OR *\\Desktop\\* OR *\\Downloads\\* OR *%temp%* OR *%tmp%* OR *iex* OR *Invoke\-* OR *rundll32* OR *regsvr32* OR *mshta* OR *cscript* OR *wscript* OR *.bat* OR *.hta* OR *.dll* OR *.ps1*))
