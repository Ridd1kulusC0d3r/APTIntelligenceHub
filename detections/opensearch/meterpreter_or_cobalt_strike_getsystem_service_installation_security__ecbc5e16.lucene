// Meterpreter or Cobalt Strike Getsystem Service Installation - Security | T1134.001, T1134.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_meterpreter_or_cobaltstrike_getsystem_service_install.yml
winlog.channel:Security AND (event.code:4697 AND (((winlog.event_data.ServiceFileName:*\/c* AND winlog.event_data.ServiceFileName:*echo* AND winlog.event_data.ServiceFileName:*\\pipe\\*) AND (winlog.event_data.ServiceFileName:(*cmd* OR *%COMSPEC%*))) OR (winlog.event_data.ServiceFileName:*rundll32* AND winlog.event_data.ServiceFileName:*.dll,a* AND winlog.event_data.ServiceFileName:*\/p\:*) OR winlog.event_data.ServiceFileName:\\\\127.0.0.1\\ADMIN$\\*))
