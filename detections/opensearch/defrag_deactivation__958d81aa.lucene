// Defrag Deactivation | T1053.005 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2018/TA/Slingshot/proc_creation_win_apt_slingshot.yml
process.executable.caseless:*\\schtasks.exe AND (process.command_line:(*\/delete* OR *\/change*)) AND (process.command_line:*\/TN* AND process.command_line:*\\Microsoft\\Windows\\Defrag\\ScheduledDefrag*)
