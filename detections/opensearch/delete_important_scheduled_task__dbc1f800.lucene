// Delete Important Scheduled Task | T1489 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_schtasks_delete.yml
(process.executable.caseless:*\\schtasks.exe OR process.pe.original_file_name:schtasks.exe) AND process.command_line:(*\-delete* OR *\/delete* OR *–delete* OR *—delete* OR *―delete*) AND (process.command_line:(*\\Windows\\BitLocker* OR *\\Windows\\ExploitGuard* OR *\\Windows\\SystemRestore\\SR* OR *\\Windows\\UpdateOrchestrator\\* OR *\\Windows\\Windows\ Defender\\* OR *\\Windows\\WindowsBackup\\* OR *\\Windows\\WindowsUpdate\\*))
