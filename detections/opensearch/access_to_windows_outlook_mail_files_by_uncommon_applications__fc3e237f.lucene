// Access To Windows Outlook Mail Files By Uncommon Applications | T1070.008 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/file/file_access/file_access_win_office_outlook_mail_credential.yml
(file.path:(*\\AppData\\Local\\Comms\\Unistore\\data* OR *\\AppData\\Local\\Comms\\UnistoreDB\\store.vol)) AND (NOT (process.executable.caseless:System OR (process.executable.caseless:(C\:\\Program\ Files\ \(x86\)\\* OR C\:\\Program\ Files\\* OR C\:\\Windows\\system32\\* OR C\:\\Windows\\SysWOW64\\*)))) AND (NOT ((process.executable.caseless:C\:\\ProgramData\\Microsoft\\Windows\ Defender\\* AND (process.executable.caseless:(*\\MpCopyAccelerator.exe OR *\\MsMpEng.exe))) OR (process.executable.caseless:(*\\thor64.exe OR *\\thor.exe))))
