// CMSTP App Paths Registry Key Modification | T1218.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_cmstp_execution_by_registry.yml
registry.path:*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App\ Paths\\cmmgr32.exe\\* AND (NOT ((registry.path:*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App\ Paths\\cmmgr32.exe\\CmstpExtensionDll AND (winlog.event_data.Details:(C\:\\Windows\\System32\\cmcfg32.dll OR C\:\\Windows\\SysWOW64\\cmcfg32.dll))) OR winlog.event_data.Details:\(Empty\)))
