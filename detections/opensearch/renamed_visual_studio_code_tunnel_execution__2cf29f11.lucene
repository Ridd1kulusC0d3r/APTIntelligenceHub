// Renamed Visual Studio Code Tunnel Execution | T1071.001, T1219 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_vscode_tunnel_renamed_execution.yml
((((NOT _exists_:process.pe.original_file_name) AND process.command_line:*.exe\ tunnel) OR (process.command_line:*.exe\ tunnel* AND process.command_line:*\-\-accept\-server\-license\-terms*) OR (process.command_line:*tunnel\ * AND process.command_line:*service* AND process.command_line:*internal\-run* AND process.command_line:*tunnel\-service.log*)) AND (NOT (process.executable.caseless:(*\\code\-tunnel.exe OR *\\code.exe)))) OR ((process.parent.command_line:*\ tunnel AND process.executable.caseless:*\\cmd.exe AND (process.command_line:*\/d\ \/c\ * AND process.command_line:*\\servers\\Stable\-* AND process.command_line:*code\-server.cmd*)) AND (NOT (process.parent.executable.caseless:(*\\code\-tunnel.exe OR *\\code.exe))))
