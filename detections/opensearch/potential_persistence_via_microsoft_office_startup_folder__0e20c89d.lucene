// Potential Persistence Via Microsoft Office Startup Folder | T1137 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_office_startup_persistence.yml
(((file.path:*\\Microsoft\\Word\\STARTUP* OR (file.path:*\\Office* AND file.path:*\\Program\ Files* AND file.path:*\\STARTUP*)) AND (file.path:(*.doc OR *.docm OR *.docx OR *.dot OR *.dotm OR *.rtf))) OR ((file.path:*\\Microsoft\\Excel\\XLSTART* OR (file.path:*\\Office* AND file.path:*\\Program\ Files* AND file.path:*\\XLSTART*)) AND (file.path:(*.xls OR *.xlsm OR *.xlsx OR *.xlt OR *.xltm)))) AND (NOT (process.executable.caseless:(*\\WINWORD.exe OR *\\EXCEL.exe)))
