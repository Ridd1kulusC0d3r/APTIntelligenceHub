// Suspicious Active Directory Database Snapshot Via ADExplorer | T1069.002, T1087.002, T1482 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_sysinternals_adexplorer_susp_execution.yml
((process.executable.caseless:(*\\ADExp.exe OR *\\ADExplorer.exe OR *\\ADExplorer64.exe OR *\\ADExplorer64a.exe)) OR process.pe.original_file_name:AdExp OR process.pe.description:"Active Directory Editor" OR process.pe.product:"Sysinternals ADExplorer") AND process.command_line:*snapshot* AND (process.command_line:(*\\Downloads\\* OR *\\Users\\Public\\* OR *\\AppData\\* OR *\\Windows\\Temp\\*))
