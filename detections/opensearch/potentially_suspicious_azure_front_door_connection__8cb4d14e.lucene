// Potentially Suspicious Azure Front Door Connection | T1090.004, T1102.002 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/network_connection/net_connection_win_susp_azurefd_connection.yml
destination.domain:*azurefd.net* AND (NOT ((process.executable.caseless:(*brave.exe OR *chrome.exe OR *chromium.exe OR *firefox.exe OR *msedge.exe OR *msedgewebview2.exe OR *opera.exe OR *vivaldi.exe)) OR process.executable.caseless:*searchapp.exe OR (destination.domain:(*afdxtest.z01.azurefd.net* OR *fp\-afd.azurefd.net* OR *fp\-afdx\-bpdee4gtg6frejfd.z01.azurefd.net* OR *roxy.azurefd.net* OR *powershellinfraartifacts\-gkhedzdeaghdezhr.z01.azurefd.net* OR *storage\-explorer\-publishing\-feapcgfgbzc2cjek.b01.azurefd.net* OR *graph.azurefd.net*))))
