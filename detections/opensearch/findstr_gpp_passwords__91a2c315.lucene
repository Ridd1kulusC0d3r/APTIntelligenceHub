// Findstr GPP Passwords | T1552.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_findstr_gpp_passwords.yml
((process.executable.caseless:(*\\find.exe OR *\\findstr.exe)) OR (process.pe.original_file_name:(FIND.EXE OR FINDSTR.EXE))) AND (process.command_line:*cpassword* AND process.command_line:*\\sysvol\\* AND process.command_line:*.xml*)
