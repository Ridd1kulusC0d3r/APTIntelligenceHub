// PowerShell Logging Disabled Via Registry Key Tampering | T1112, T1564.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_powershell_logging_disabled.yml
(registry.path:(*\\Microsoft\\Windows\\PowerShell\\* OR *\\Microsoft\\PowerShellCore\\*)) AND (registry.path:(*\\ModuleLogging\\EnableModuleLogging OR *\\ScriptBlockLogging\\EnableScriptBlockLogging OR *\\ScriptBlockLogging\\EnableScriptBlockInvocationLogging OR *\\Transcription\\EnableTranscripting OR *\\Transcription\\EnableInvocationHeader OR *\\EnableScripts)) AND winlog.event_data.Details:"DWORD \(0x00000000\)"
