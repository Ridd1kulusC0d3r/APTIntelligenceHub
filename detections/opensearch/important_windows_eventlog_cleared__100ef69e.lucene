// Important Windows Eventlog Cleared | T1685.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/microsoft_windows_eventlog/win_system_susp_eventlog_cleared.yml
winlog.channel:System AND (event.code:104 AND winlog.provider_name:Microsoft\-Windows\-Eventlog AND (winlog.channel:(Microsoft\-Windows\-PowerShell\/Operational OR Microsoft\-Windows\-Sysmon\/Operational OR PowerShellCore\/Operational OR Security OR System OR "Windows PowerShell")))
