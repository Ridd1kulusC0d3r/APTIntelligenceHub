// Windows Binaries Write Suspicious Extensions | T1036 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_shell_write_susp_files_extensions.yml
(((process.executable.caseless:(*\\csrss.exe OR *\\lsass.exe OR *\\RuntimeBroker.exe OR *\\sihost.exe OR *\\smss.exe OR *\\wininit.exe OR *\\winlogon.exe)) AND (file.path:(*.bat OR *.dll OR *.exe OR *.hta OR *.iso OR *.ps1 OR *.txt OR *.vbe OR *.vbs))) OR ((process.executable.caseless:(*\\dllhost.exe OR *\\rundll32.exe OR *\\svchost.exe)) AND (file.path:(*.bat OR *.hta OR *.iso OR *.ps1 OR *.vbe OR *.vbs)))) AND (NOT ((process.executable.caseless:C\:\\Windows\\System32\\dllhost.exe AND (file.path:*\:\\Users\\* AND file.path:*\\AppData\\Local\\Temp\\__PSScriptPolicyTest_*) AND file.path:*.ps1) OR (process.executable.caseless:C\:\\Windows\\system32\\svchost.exe AND (file.path:*C\:\\Windows\\System32\\GroupPolicy\\DataStore\\* AND file.path:*\\sysvol\\* AND file.path:*\\Policies\\* AND file.path:*\\Machine\\Scripts\\Startup\\*) AND (file.path:(*.ps1 OR *.bat))) OR (process.executable.caseless:C\:\\Windows\\system32\\svchost.exe AND (file.path:*C\:\\Program\ Files\\WindowsApps\\Clipchamp* AND file.path:*.ps1*)) OR ((process.executable.caseless:(C\:\\Windows\\system32\\svchost.exe OR C\:\\Windows\\SysWOW64\\svchost.exe)) AND (file.path:(C\:\\Program\ Files\\WindowsApps\\Microsoft.PowerShellPreview* OR C\:\\Program\ Files\ \(x86\)\\WindowsApps\\Microsoft.PowerShellPreview*)) AND file.path:*.ps1)))
