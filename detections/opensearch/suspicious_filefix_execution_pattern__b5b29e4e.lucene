// Suspicious FileFix Execution Pattern | T1204.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_filefix_execution_pattern.yml
((process.parent.executable.caseless:(*\\brave.exe OR *\\chrome.exe OR *\\firefox.exe OR *\\msedge.exe)) AND process.command_line:*#*) AND ((process.command_line:(*%comspec%* OR *bitsadmin* OR *certutil* OR *cmd* OR *cscript* OR *curl* OR *finger* OR *mshta* OR *powershell* OR *pwsh* OR *regsvr32* OR *rundll32* OR *schtasks* OR *wget* OR *wscript*)) OR (process.command_line:(*account* OR *anti\-bot* OR *botcheck* OR *captcha* OR *challenge* OR *confirmation* OR *fraud* OR *human* OR *identification* OR *identificator* OR *identity* OR *robot* OR *validation* OR *verification* OR *verify*)))
