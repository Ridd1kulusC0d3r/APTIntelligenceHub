// Renamed ProcDump Execution | T1036.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_renamed_sysinternals_procdump.yml
(process.pe.original_file_name:procdump OR ((process.command_line:(*\ \-ma\ * OR *\ \/ma\ * OR *\ –ma\ * OR *\ —ma\ * OR *\ ―ma\ *) OR process.command_line:(*\ \-mp\ * OR *\ \/mp\ * OR *\ –mp\ * OR *\ —mp\ * OR *\ ―mp\ *)) AND process.command_line:(*\ \-accepteula* OR *\ \/accepteula* OR *\ –accepteula* OR *\ —accepteula* OR *\ ―accepteula*))) AND (NOT (process.executable.caseless:(*\\procdump.exe OR *\\procdump64.exe OR *\\procdump64a.exe)))
