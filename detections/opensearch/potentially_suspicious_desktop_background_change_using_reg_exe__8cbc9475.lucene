// Potentially Suspicious Desktop Background Change Using Reg.EXE | T1112, T1491.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_reg_desktop_background_change.yml
((process.executable.caseless:*\\reg.exe OR process.pe.original_file_name:reg.exe) AND process.command_line:*add*) AND (process.command_line:(*Control\ Panel\\Desktop* OR *CurrentVersion\\Policies\\ActiveDesktop* OR *CurrentVersion\\Policies\\System*)) AND ((process.command_line:*\/v\ NoChangingWallpaper* AND process.command_line:*\/d\ 1*) OR (process.command_line:*\/v\ Wallpaper* AND process.command_line:*\/t\ REG_SZ*) OR (process.command_line:*\/v\ WallpaperStyle* AND process.command_line:*\/d\ 2*))
