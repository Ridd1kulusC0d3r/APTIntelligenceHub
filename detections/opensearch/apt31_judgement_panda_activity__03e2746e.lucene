(process.command_line:*ldifde* AND process.command_line:*\-f\ \-n* AND process.command_line:*eprod.ldf*) OR ((process.command_line:*copy\ \\\\* AND process.command_line:*c$*) AND (process.command_line:(*\\aaaa\\procdump64.exe* OR *\\aaaa\\netsess.exe* OR *\\aaaa\\7za.exe* OR *\\c$\\aaaa\\*)))
