// Suspicious Velociraptor Child Process | T1219 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_velociraptor_child_process.yml
process.parent.executable.caseless:*\\Velociraptor.exe AND ((process.command_line:*code.exe* AND process.command_line:*tunnel* AND process.command_line:*\-\-accept\-server\-license\-terms*) OR (process.command_line:*msiexec* AND process.command_line:*\/i* AND process.command_line:*http*) OR ((process.executable.caseless:(*\\powershell.exe OR *\\powershell_ise.exe OR *\\pwsh.exe)) AND (process.command_line:(*Invoke\-WebRequest\ * OR *IWR\ * OR *.DownloadFile* OR *.DownloadString*))))
