// Root Certificate Installed From Susp Locations | T1553.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_import_cert_susp_locations.yml
(process.command_line:*Import\-Certificate* AND process.command_line:*\ \-FilePath\ * AND process.command_line:*Cert\:\\LocalMachine\\Root*) AND (process.command_line:(*\\AppData\\Local\\Temp\\* OR *\:\\Windows\\TEMP\\* OR *\\Desktop\\* OR *\\Downloads\\* OR *\\Perflogs\\* OR *\:\\Users\\Public\\*))
