// Copy From Or To Admin Share Or Sysvol Folder | T1021.002, T1039, T1048 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_copy_lateral_movement.yml
(process.command_line:(*\\\\*\\*$* OR *\\Sysvol\\*)) AND (((process.executable.caseless:(*\\robocopy.exe OR *\\xcopy.exe)) OR (process.pe.original_file_name:(robocopy.exe OR XCOPY.EXE))) OR ((process.executable.caseless:*\\cmd.exe OR process.pe.original_file_name:Cmd.Exe) AND process.command_line:*copy*) OR (((process.executable.caseless:(*\\powershell_ise.exe* OR *\\powershell.exe* OR *\\pwsh.exe*)) OR (process.pe.original_file_name:(powershell_ise.exe OR PowerShell.EXE OR pwsh.dll))) AND (process.command_line:(*copy\-item* OR *copy\ * OR *cpi\ * OR *\ cp\ * OR *move\ * OR *\ move\-item* OR *\ mi\ * OR *\ mv\ *))))
