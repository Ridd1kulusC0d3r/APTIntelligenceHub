// Remote Thread Creation In Uncommon Target Image | T1055.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/create_remote_thread/create_remote_thread_win_susp_uncommon_target_image.yml
(winlog.event_data.TargetImage:(*\\calc.exe OR *\\calculator.exe OR *\\mspaint.exe OR *\\notepad.exe OR *\\ping.exe OR *\\sethc.exe OR *\\spoolsv.exe OR *\\wordpad.exe OR *\\write.exe)) AND (NOT (process.executable.caseless:C\:\\Windows\\System32\\csrss.exe OR ((process.executable.caseless:(C\:\\Windows\\System32\\explorer.exe OR C\:\\Windows\\System32\\OpenWith.exe)) AND winlog.event_data.TargetImage:C\:\\Windows\\System32\\notepad.exe) OR (process.executable.caseless:C\:\\Windows\\System32\\AtBroker.exe AND winlog.event_data.TargetImage:C\:\\Windows\\System32\\Sethc.exe))) AND (NOT (winlog.event_data.StartFunction:EtwpNotificationThread OR process.executable.caseless:*unknown\ process* OR (process.executable.caseless:"C\:\\Program Files\\VMware\\VMware Tools\\vmtoolsd.exe" AND winlog.event_data.StartFunction:GetCommandLineW AND (winlog.event_data.TargetImage:(C\:\\Windows\\System32\\notepad.exe OR C\:\\Windows\\System32\\spoolsv.exe))) OR (process.executable.caseless:"C\:\\Program Files\\Xerox\\XeroxPrintExperience\\CommonFiles\\XeroxPrintJobEventManagerService.exe" AND winlog.event_data.StartFunction:LoadLibraryW AND winlog.event_data.TargetImage:C\:\\Windows\\System32\\spoolsv.exe)))
