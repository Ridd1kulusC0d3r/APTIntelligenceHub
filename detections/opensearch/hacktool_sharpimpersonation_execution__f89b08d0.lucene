// HackTool - SharpImpersonation Execution | T1134.001, T1134.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_sharp_impersonation.yml
(process.executable.caseless:*\\SharpImpersonation.exe OR process.pe.original_file_name:SharpImpersonation.exe) OR ((process.command_line:*\ user\:* AND process.command_line:*\ binary\:*) OR (process.command_line:*\ user\:* AND process.command_line:*\ shellcode\:*) OR (process.command_line:(*\ technique\:CreateProcessAsUserW* OR *\ technique\:ImpersonateLoggedOnuser*)))
