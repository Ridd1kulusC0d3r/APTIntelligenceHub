// Console CodePage Lookup Via CHCP | T1614.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_chcp_codepage_lookup.yml
process.parent.executable.caseless:*\\cmd.exe AND (process.parent.command_line:(*\ \-c\ * OR *\ \/c\ * OR *\ –c\ * OR *\ —c\ * OR *\ ―c\ *) OR process.parent.command_line:(*\ \-r\ * OR *\ \/r\ * OR *\ –r\ * OR *\ —r\ * OR *\ ―r\ *) OR process.parent.command_line:(*\ \-k\ * OR *\ \/k\ * OR *\ –k\ * OR *\ —k\ * OR *\ ―k\ *)) AND process.executable.caseless:*\\chcp.com AND (process.command_line:(*chcp OR *chcp\  OR *chcp\ \ ))
