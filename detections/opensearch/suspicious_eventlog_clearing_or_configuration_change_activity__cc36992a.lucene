// Suspicious Eventlog Clearing or Configuration Change Activity | T1685.001, T1685.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_eventlog_clear.yml
(((process.executable.caseless:*\\wevtutil.exe OR process.pe.original_file_name:wevtutil.exe) AND (process.command_line:(*clear\-log\ * OR *\ cl\ * OR *set\-log\ * OR *\ sl\ * OR *lfn\:*))) OR ((process.executable.caseless:(*\\powershell.exe OR *\\powershell_ise.exe OR *\\pwsh.exe)) AND ((process.command_line:(*Clear\-EventLog\ * OR *Remove\-EventLog\ * OR *Limit\-EventLog\ * OR *Clear\-WinEvent\ *)) OR (process.command_line:*Eventing.Reader.EventLogSession* AND process.command_line:*ClearLog*) OR (process.command_line:*Diagnostics.EventLog* AND process.command_line:*Clear*))) OR ((process.executable.caseless:(*\\powershell.exe OR *\\powershell_ise.exe OR *\\pwsh.exe OR *\\wmic.exe)) AND process.command_line:*ClearEventLog*)) AND (NOT ((process.parent.executable.caseless:(C\:\\Windows\\SysWOW64\\msiexec.exe OR C\:\\Windows\\System32\\msiexec.exe)) AND process.command_line:*\ sl\ *))
