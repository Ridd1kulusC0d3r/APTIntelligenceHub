// Control Panel Items | T1218.002, T1546 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_control_panel_item.yml
((process.executable.caseless:*\\reg.exe OR process.pe.original_file_name:reg.exe) AND (process.command_line:*add* AND process.command_line:*CurrentVersion\\Control\ Panel\\CPLs*)) OR (process.command_line:*.cpl AND (NOT ((process.command_line:(*\\System32\\* OR *%System%* OR *\|C\:\\Windows\\system32\|*)) OR (process.command_line:*regsvr32\ * AND process.command_line:*\ \/s\ * AND process.command_line:*igfxCPL.cpl*))))
