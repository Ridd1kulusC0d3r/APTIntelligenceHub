// Suspicious Response File Execution Via Odbcconf.EXE | T1218.008 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_odbcconf_response_file_susp.yml
((process.executable.caseless:*\\odbcconf.exe OR process.pe.original_file_name:odbcconf.exe) AND process.command_line:(*\ \-f\ * OR *\ \/f\ * OR *\ –f\ * OR *\ —f\ * OR *\ ―f\ *)) AND (NOT (process.command_line:*.rsp* OR (process.parent.executable.caseless:C\:\\Windows\\System32\\runonce.exe AND process.executable.caseless:C\:\\Windows\\System32\\odbcconf.exe AND process.command_line:*.exe\ \/E\ \/F\ \"C\:\\WINDOWS\\system32\\odbcconf.tmp\"*)))
