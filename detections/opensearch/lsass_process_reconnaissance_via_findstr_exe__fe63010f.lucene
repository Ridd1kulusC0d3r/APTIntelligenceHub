// LSASS Process Reconnaissance Via Findstr.EXE | T1552.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_findstr_lsass.yml
(((process.executable.caseless:(*\\find.exe OR *\\findstr.exe)) OR (process.pe.original_file_name:(FIND.EXE OR FINDSTR.EXE))) AND process.command_line:*lsass*) OR (process.command_line:(*\ \-i\ \"lsass* OR *\ \/i\ \"lsass* OR *\ –i\ \"lsass* OR *\ —i\ \"lsass* OR *\ ―i\ \"lsass*) OR process.command_line:(*\ \-i\ lsass.exe* OR *\ \/i\ lsass.exe* OR *\ –i\ lsass.exe* OR *\ —i\ lsass.exe* OR *\ ―i\ lsass.exe*) OR process.command_line:(*findstr\ \"lsass*) OR process.command_line:(*findstr\ lsass*) OR process.command_line:(*findstr.exe\ \"lsass*) OR process.command_line:(*findstr.exe\ lsass*))
