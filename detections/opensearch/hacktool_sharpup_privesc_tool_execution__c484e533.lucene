// HackTool - SharpUp PrivEsc Tool Execution | T1569.002, T1574.005, T1615 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_sharpup.yml
process.executable.caseless:*\\SharpUp.exe OR process.pe.description:SharpUp OR (process.command_line:(*HijackablePaths* OR *UnquotedServicePath* OR *ProcessDLLHijack* OR *ModifiableServiceBinaries* OR *ModifiableScheduledTask* OR *DomainGPPPassword* OR *CachedGPPPassword*))
