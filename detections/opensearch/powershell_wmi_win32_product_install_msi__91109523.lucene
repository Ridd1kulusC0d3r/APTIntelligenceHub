// PowerShell WMI Win32_Product Install MSI | T1218.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_win32_product_install_msi.yml
powershell.file.script_block_text:*Invoke\-CimMethod\ * AND powershell.file.script_block_text:*\-ClassName\ * AND powershell.file.script_block_text:*Win32_Product\ * AND powershell.file.script_block_text:*\-MethodName\ * AND powershell.file.script_block_text:*.msi*
