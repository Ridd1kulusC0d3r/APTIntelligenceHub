// HackTool - winPEAS Execution | T1046, T1082, T1087 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_winpeas.yml
(process.pe.original_file_name:winPEAS.exe OR (process.executable.caseless:(*\\winPEASany_ofs.exe OR *\\winPEASany.exe OR *\\winPEASx64_ofs.exe OR *\\winPEASx64.exe OR *\\winPEASx86_ofs.exe OR *\\winPEASx86.exe))) OR (process.command_line:(*\ applicationsinfo* OR *\ browserinfo* OR *\ eventsinfo* OR *\ fileanalysis* OR *\ filesinfo* OR *\ processinfo* OR *\ servicesinfo* OR *\ windowscreds*)) OR process.command_line:*https\:\/\/github.com\/carlospolop\/PEASS\-ng\/releases\/latest\/download\/* OR (process.parent.command_line:*\ \-linpeas OR process.command_line:*\ \-linpeas)
