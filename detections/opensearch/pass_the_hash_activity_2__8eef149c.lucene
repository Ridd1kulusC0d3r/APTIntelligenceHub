// Pass the Hash Activity 2 | T1550.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/account_management/win_security_pass_the_hash_2.yml
winlog.channel:Security AND (((event.code:4624 AND user.id:S\-1\-0\-0 AND winlog.event_data.LogonType:3 AND winlog.event_data.LogonProcessName:NtLmSsp AND winlog.event_data.KeyLength:0) OR (event.code:4624 AND winlog.event_data.LogonType:9 AND winlog.event_data.LogonProcessName:seclogo)) AND (NOT winlog.event_data.TargetUserName:"ANONYMOUS LOGON"))
