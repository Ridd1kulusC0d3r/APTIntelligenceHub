// Windows Update Error | T1584 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/microsoft_windows_windows_update_client/win_system_susp_system_update_error.yml
winlog.channel:System AND (winlog.provider_name:Microsoft\-Windows\-WindowsUpdateClient AND (event.code:(16 OR 20 OR 24 OR 213 OR 217)))
