// New Connection Initiated To Potential Dead Drop Resolver Domain | T1102, T1102.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_domain_dead_drop_resolvers.yml
(network.direction:true AND (destination.domain:(*.t.me OR *0x0.st OR *4shared.com OR *abuse.ch OR *anonfiles.com OR *bashupload.com OR *cdn.discordapp.com OR *chunk.io OR *cloudflare.com OR *ddns.net OR *discord.com OR *docs.google.com OR *drive.google.com OR *dropbox.com OR *dropmefiles.com OR *facebook.com OR *feeds.rapidfeeds.com OR *fotolog.com OR *ghostbin.co\/ OR *githubusercontent.com OR *gofile.io OR *hastebin.com OR *imgur.com OR *livejournal.com OR *mediafire.com OR *mega.co.nz OR *mega.nz OR *onedrive.com OR *pages.dev OR *paste.ee OR *pastebin.com OR *pastebin.pl OR *pastetext.net OR *pixeldrain.com OR *privatlab.com OR *privatlab.net OR *reddit.com OR *send.exploit.in OR *sendspace.com OR *steamcommunity.com OR *storage.googleapis.com OR *technet.microsoft.com OR *temp.sh OR *transfer.sh OR *trycloudflare.com OR *twitter.com OR *ufile.io OR *vimeo.com OR *w3spaces.com OR *wetransfer.com OR *workers.dev OR *x0.at OR *youtube.com))) AND (NOT ((process.executable.caseless:("C\:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR "C\:\\Program Files \(x86\)\\Google\\Chrome\\Application\\chrome.exe")) OR (process.executable.caseless:C\:\\Users\\* AND process.executable.caseless:*\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe) OR (process.executable.caseless:("C\:\\Program Files\\Mozilla Firefox\\firefox.exe" OR "C\:\\Program Files \(x86\)\\Mozilla Firefox\\firefox.exe")) OR (process.executable.caseless:C\:\\Users\\* AND process.executable.caseless:*\\AppData\\Local\\Mozilla\ Firefox\\firefox.exe) OR (process.executable.caseless:("C\:\\Program Files \(x86\)\\Internet Explorer\\iexplore.exe" OR "C\:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (process.executable.caseless:C\:\\Program\ Files\ \(x86\)\\Microsoft\\EdgeWebView\\Application\\* OR process.executable.caseless:*\\WindowsApps\\MicrosoftEdge.exe OR (process.executable.caseless:("C\:\\Program Files \(x86\)\\Microsoft\\Edge\\Application\\msedge.exe" OR "C\:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable.caseless:(C\:\\Program\ Files\ \(x86\)\\Microsoft\\EdgeCore\\* OR C\:\\Program\ Files\\Microsoft\\EdgeCore\\*)) AND (process.executable.caseless:(*\\msedge.exe OR *\\msedgewebview2.exe))) OR ((process.executable.caseless:(*C\:\\Program\ Files\ \(x86\)\\Safari\\* OR *C\:\\Program\ Files\\Safari\\*)) AND process.executable.caseless:*\\safari.exe) OR ((process.executable.caseless:(*C\:\\Program\ Files\\Windows\ Defender\ Advanced\ Threat\ Protection\\* OR *C\:\\Program\ Files\\Windows\ Defender\\* OR *C\:\\ProgramData\\Microsoft\\Windows\ Defender\\Platform\\*)) AND (process.executable.caseless:(*\\MsMpEng.exe OR *\\MsSense.exe))) OR (process.executable.caseless:(*C\:\\Program\ Files\ \(x86\)\\PRTG\ Network\ Monitor\\PRTG\ Probe.exe OR *C\:\\Program\ Files\\PRTG\ Network\ Monitor\\PRTG\ Probe.exe)) OR (process.executable.caseless:C\:\\Program\ Files\\BraveSoftware\\* AND process.executable.caseless:*\\brave.exe) OR (process.executable.caseless:*\\AppData\\Local\\Maxthon\\* AND process.executable.caseless:*\\maxthon.exe) OR (process.executable.caseless:*\\AppData\\Local\\Programs\\Opera\\* AND process.executable.caseless:*\\opera.exe) OR ((process.executable.caseless:(C\:\\Program\ Files\\SeaMonkey\\* OR C\:\\Program\ Files\ \(x86\)\\SeaMonkey\\*)) AND process.executable.caseless:*\\seamonkey.exe) OR (process.executable.caseless:*\\AppData\\Local\\Vivaldi\\* AND process.executable.caseless:*\\vivaldi.exe) OR ((process.executable.caseless:(C\:\\Program\ Files\\Naver\\Naver\ Whale\\* OR C\:\\Program\ Files\ \(x86\)\\Naver\\Naver\ Whale\\*)) AND process.executable.caseless:*\\whale.exe) OR ((process.executable.caseless:(C\:\\Program\ Files\\Waterfox\\* OR C\:\\Program\ Files\ \(x86\)\\Waterfox\\*)) AND process.executable.caseless:*\\Waterfox.exe) OR (process.executable.caseless:*\\AppData\\Local\\Programs\\midori\-ng\\* AND process.executable.caseless:*\\Midori\ Next\ Generation.exe) OR ((process.executable.caseless:(C\:\\Program\ Files\\SlimBrowser\\* OR C\:\\Program\ Files\ \(x86\)\\SlimBrowser\\*)) AND process.executable.caseless:*\\slimbrowser.exe) OR (process.executable.caseless:*\\AppData\\Local\\Flock\\* AND process.executable.caseless:*\\Flock.exe) OR (process.executable.caseless:*\\AppData\\Local\\Phoebe\\* AND process.executable.caseless:*\\Phoebe.exe) OR ((process.executable.caseless:(C\:\\Program\ Files\\Falkon\\* OR C\:\\Program\ Files\ \(x86\)\\Falkon\\*)) AND process.executable.caseless:*\\falkon.exe) OR ((process.executable.caseless:(C\:\\Program\ Files\ \(x86\)\\QtWeb\\* OR C\:\\Program\ Files\\QtWeb\\*)) AND process.executable.caseless:*\\QtWeb.exe) OR ((process.executable.caseless:(C\:\\Program\ Files\ \(x86\)\\Avant\ Browser\\* OR C\:\\Program\ Files\\Avant\ Browser\\*)) AND process.executable.caseless:*\\avant.exe) OR ((process.executable.caseless:(C\:\\Program\ Files\ \(x86\)\\WindowsApps\\* OR C\:\\Program\ Files\\WindowsApps\\*)) AND process.executable.caseless:*\\WhatsApp.exe AND destination.domain:*facebook.com) OR (process.executable.caseless:*\\AppData\\Roaming\\Telegram\ Desktop\\* AND process.executable.caseless:*\\Telegram.exe AND destination.domain:*.t.me) OR (process.executable.caseless:*\\AppData\\Local\\Microsoft\\OneDrive\\* AND process.executable.caseless:*\\OneDrive.exe AND destination.domain:*onedrive.com) OR ((process.executable.caseless:(C\:\\Program\ Files\ \(x86\)\\Dropbox\\Client\\* OR C\:\\Program\ Files\\Dropbox\\Client\\*)) AND (process.executable.caseless:(*\\Dropbox.exe OR *\\DropboxInstaller.exe)) AND destination.domain:*dropbox.com) OR ((process.executable.caseless:(*\\MEGAsync.exe OR *\\MEGAsyncSetup32_*RC.exe OR *\\MEGAsyncSetup32.exe OR *\\MEGAsyncSetup64.exe OR *\\MEGAupdater.exe)) AND (destination.domain:(*mega.co.nz OR *mega.nz))) OR ((process.executable.caseless:(*C\:\\Program\ Files\\Google\\Drive\ File\ Stream\\* OR *C\:\\Program\ Files\ \(x86\)\\Google\\Drive\ File\ Stream\\*)) AND process.executable.caseles