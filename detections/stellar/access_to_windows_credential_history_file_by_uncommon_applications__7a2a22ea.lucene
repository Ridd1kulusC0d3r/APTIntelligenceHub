// Access To Windows Credential History File By Uncommon Applications | T1555.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_access/file_access_win_susp_credhist.yml
FileName:*\\Microsoft\\Protect\\CREDHIST AND (NOT ((Image:(C\:\\Program\ Files\\* OR C\:\\Program\ Files\ \(x86\)\\* OR C\:\\Windows\\system32\\* OR C\:\\Windows\\SysWOW64\\*)) OR Image:C\:\\Windows\\explorer.exe))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "FileName:*\\\\Microsoft\\\\Protect\\\\CREDHIST AND (NOT ((Image:(C\\:\\\\Program\\ Files\\\\* OR C\\:\\\\Program\\ Files\\ \\(x86\\)\\\\* OR C\\:\\\\Windows\\\\system32\\\\* OR C\\:\\\\Windows\\\\SysWOW64\\\\*)) OR Image:C\\:\\\\Windows\\\\explorer.exe))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
