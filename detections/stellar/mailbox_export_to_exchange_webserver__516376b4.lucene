// Mailbox Export to Exchange Webserver | T1505.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/msexchange/win_exchange_proxyshell_mailbox_export.yml
((*New\-MailboxExportRequest* AND *\ \-Mailbox\ *) AND (*\-FilePath\ \"\\\\* OR *.aspx*)) OR (*New\-ManagementRoleAssignment* AND *\ \-Role\ \"Mailbox\ Import\ Export\"* AND *\ \-User\ *)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "((*New\\-MailboxExportRequest* AND *\\ \\-Mailbox\\ *) AND (*\\-FilePath\\ \\\"\\\\\\\\* OR *.aspx*)) OR (*New\\-ManagementRoleAssignment* AND *\\ \\-Role\\ \\\"Mailbox\\ Import\\ Export\\\"* AND *\\ \\-User\\ *)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
