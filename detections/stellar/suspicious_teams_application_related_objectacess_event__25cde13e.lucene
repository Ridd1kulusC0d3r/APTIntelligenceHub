// Suspicious Teams Application Related ObjectAcess Event | T1528 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_teams_suspicious_objectaccess.yml
(EventID:4663 AND (ObjectName:(*\\Microsoft\\Teams\\Cookies* OR *\\Microsoft\\Teams\\Local\ Storage\\leveldb*))) AND (NOT ProcessName:*\\Microsoft\\Teams\\current\\Teams.exe*)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(EventID:4663 AND (ObjectName:(*\\\\Microsoft\\\\Teams\\\\Cookies* OR *\\\\Microsoft\\\\Teams\\\\Local\\ Storage\\\\leveldb*))) AND (NOT ProcessName:*\\\\Microsoft\\\\Teams\\\\current\\\\Teams.exe*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
