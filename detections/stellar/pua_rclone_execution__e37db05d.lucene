        {
          "query_string": {
            "query": "(CommandLine:*\\-\\-config\\ * AND CommandLine:*\\-\\-no\\-check\\-certificate\\ * AND CommandLine:*\\ copy\\ *) OR ((Image:*\\\\rclone.exe OR Description:\"Rsync for cloud storage\") AND (CommandLine:(*pass* OR *user* OR *copy* OR *sync* OR *config* OR *lsd* OR *remote* OR *ls* OR *mega* OR *pcloud* OR *ftp* OR *ignore\\-existing* OR *auto\\-confirm* OR *transfers* OR *multi\\-thread\\-streams* OR *no\\-check\\-certificate\\ *)))",
            "analyze_wildcard": true
          }
        }
      ]
