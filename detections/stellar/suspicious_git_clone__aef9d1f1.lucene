// Suspicious Git Clone | T1593.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_git_susp_clone.yml
((Image:(*\\git.exe OR *\\git\-remote\-https.exe)) OR OriginalFileName:git.exe) AND (CommandLine:(*\ clone\ * OR *git\-remote\-https\ *)) AND (CommandLine:(*exploit* OR *Vulns* OR *vulnerability* OR *RemoteCodeExecution* OR *Invoke\-* OR *CVE\-* OR *poc\-* OR *ProofOfConcept* OR *proxyshell* OR *log4shell* OR *eternalblue* OR *eternal\-blue* OR *MS17\-*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "((Image:(*\\\\git.exe OR *\\\\git\\-remote\\-https.exe)) OR OriginalFileName:git.exe) AND (CommandLine:(*\\ clone\\ * OR *git\\-remote\\-https\\ *)) AND (CommandLine:(*exploit* OR *Vulns* OR *vulnerability* OR *RemoteCodeExecution* OR *Invoke\\-* OR *CVE\\-* OR *poc\\-* OR *ProofOfConcept* OR *proxyshell* OR *log4shell* OR *eternalblue* OR *eternal\\-blue* OR *MS17\\-*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
