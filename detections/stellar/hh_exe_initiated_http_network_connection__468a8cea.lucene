// HH.EXE Initiated HTTP Network Connection | T1218.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/network_connection/net_connection_win_hh_http_connection.yml
Image:*\\hh.exe AND Initiated:true AND (DestinationPort:(80 OR 443))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "Image:*\\\\hh.exe AND Initiated:true AND (DestinationPort:(80 OR 443))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
