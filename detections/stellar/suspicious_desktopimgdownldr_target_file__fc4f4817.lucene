            "query": "(Image:*\\\\svchost.exe AND TargetFilename:*\\\\Personalization\\\\LockScreenImage\\\\*) AND (NOT TargetFilename:*C\\:\\\\Windows\\\\*) AND (NOT (TargetFilename:(*.jpg* OR *.jpeg* OR *.png*)))",
            "analyze_wildcard": true
