// Suspicious Windows ANONYMOUS LOGON Local Account Created | T1136.001, T1136.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_susp_local_anon_logon_created.yml
EventID:4720 AND (SamAccountName:*ANONYMOUS* AND SamAccountName:*LOGON*)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "EventID:4720 AND (SamAccountName:*ANONYMOUS* AND SamAccountName:*LOGON*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
