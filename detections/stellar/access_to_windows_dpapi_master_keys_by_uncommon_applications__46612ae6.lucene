// Access To Windows DPAPI Master Keys By Uncommon Applications | T1555.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_access/file_access_win_susp_dpapi_master_key_access.yml
(FileName:(*\\Microsoft\\Protect\\S\-1\-5\-18\\* OR *\\Microsoft\\Protect\\S\-1\-5\-21\-*)) AND (NOT ((Image:(C\:\\Program\ Files\\* OR C\:\\Program\ Files\ \(x86\)\\* OR C\:\\Windows\\system32\\* OR C\:\\Windows\\SysWOW64\\*)) OR Image:C\:\\Windows\\explorer.exe))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(FileName:(*\\\\Microsoft\\\\Protect\\\\S\\-1\\-5\\-18\\\\* OR *\\\\Microsoft\\\\Protect\\\\S\\-1\\-5\\-21\\-*)) AND (NOT ((Image:(C\\:\\\\Program\\ Files\\\\* OR C\\:\\\\Program\\ Files\\ \\(x86\\)\\\\* OR C\\:\\\\Windows\\\\system32\\\\* OR C\\:\\\\Windows\\\\SysWOW64\\\\*)) OR Image:C\\:\\\\Windows\\\\explorer.exe))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
