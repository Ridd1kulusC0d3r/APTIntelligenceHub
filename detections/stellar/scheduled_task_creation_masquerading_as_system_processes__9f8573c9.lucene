// Scheduled Task Creation Masquerading as System Processes | T1036.004, T1036.005, T1053.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_schtasks_system_process.yml
(Image:*\\schtasks.exe OR OriginalFileName:schtasks.exe) AND (CommandLine:(*\ \-create\ * OR *\ \/create\ * OR *\ –create\ * OR *\ —create\ * OR *\ ―create\ *) AND (CommandLine:(*\ audiodg* OR *\ conhost* OR *\ dwm.exe* OR *\ explorer* OR *\ lsass* OR *\ lsm* OR *\ mmc* OR *\ msiexec* OR *\ regsvr32* OR *\ rundll32* OR *\ services* OR *\ spoolsv* OR *\ svchost* OR *\ taskeng* OR *\ taskhost* OR *\ wininit* OR *\ winlogon*)))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(Image:*\\\\schtasks.exe OR OriginalFileName:schtasks.exe) AND (CommandLine:(*\\ \\-create\\ * OR *\\ \\/create\\ * OR *\\ \u2013create\\ * OR *\\ \u2014create\\ * OR *\\ \u2015create\\ *) AND (CommandLine:(*\\ audiodg* OR *\\ conhost* OR *\\ dwm.exe* OR *\\ explorer* OR *\\ lsass* OR *\\ lsm* OR *\\ mmc* OR *\\ msiexec* OR *\\ regsvr32* OR *\\ rundll32* OR *\\ services* OR *\\ spoolsv* OR *\\ svchost* OR *\\ taskeng* OR *\\ taskhost* OR *\\ wininit* OR *\\ winlogon*)))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
