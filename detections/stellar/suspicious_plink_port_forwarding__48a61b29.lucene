// Suspicious Plink Port Forwarding | T1021.001, T1572 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_plink_port_forwarding.yml
Description:"Command\-line SSH, Telnet, and Rlogin client" AND CommandLine:*\ \-R\ *

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "Description:\"Command\\-line SSH, Telnet, and Rlogin client\" AND CommandLine:*\\ \\-R\\ *",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
