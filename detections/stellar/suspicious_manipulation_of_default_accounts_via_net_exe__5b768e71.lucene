// Suspicious Manipulation Of Default Accounts Via Net.EXE | T1560.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_net_user_default_accounts_manipulation.yml
(((Image:(*\\net.exe OR *\\net1.exe)) OR (OriginalFileName:(net.exe OR net1.exe))) AND CommandLine:*\ user\ * AND (CommandLine:(*\ Järjestelmänvalvoja\ * OR *\ Rendszergazda\ * OR *\ Администратор\ * OR *\ Administrateur\ * OR *\ Administrador\ * OR *\ Administratör\ * OR *\ Administrator\ * OR *\ guest\ * OR *\ DefaultAccount\ * OR *\ \"Järjestelmänvalvoja\"\ * OR *\ \"Rendszergazda\"\ * OR *\ \"Администратор\"\ * OR *\ \"Administrateur\"\ * OR *\ \"Administrador\"\ * OR *\ \"Administratör\"\ * OR *\ \"Administrator\"\ * OR *\ \"guest\"\ * OR *\ \"DefaultAccount\"\ * OR *\ 'Järjestelmänvalvoja'\ * OR *\ 'Rendszergazda'\ * OR *\ 'Администратор'\ * OR *\ 'Administrateur'\ * OR *\ 'Administrador'\ * OR *\ 'Administratör'\ * OR *\ 'Administrator'\ * OR *\ 'guest'\ * OR *\ 'DefaultAccount'\ *))) AND (NOT (CommandLine:*guest* AND CommandLine:*\/active\ no*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(((Image:(*\\\\net.exe OR *\\\\net1.exe)) OR (OriginalFileName:(net.exe OR net1.exe))) AND CommandLine:*\\ user\\ * AND (CommandLine:(*\\ J\u00e4rjestelm\u00e4nvalvoja\\ * OR *\\ Rendszergazda\\ * OR *\\ \u0410\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\\ * OR *\\ Administrateur\\ * OR *\\ Administrador\\ * OR *\\ Administrat\u00f6r\\ * OR *\\ Administrator\\ * OR *\\ guest\\ * OR *\\ DefaultAccount\\ * OR *\\ \\\"J\u00e4rjestelm\u00e4nvalvoja\\\"\\ * OR *\\ \\\"Rendszergazda\\\"\\ * OR *\\ \\\"\u0410\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\\\"\\ * OR *\\ \\\"Administrateur\\\"\\ * OR *\\ \\\"Administrador\\\"\\ * OR *\\ \\\"Administrat\u00f6r\\\"\\ * OR *\\ \\\"Administrator\\\"\\ * OR *\\ \\\"guest\\\"\\ * OR *\\ \\\"DefaultAccount\\\"\\ * OR *\\ 'J\u00e4rjestelm\u00e4nvalvoja'\\ * OR *\\ 'Rendszergazda'\\ * OR *\\ '\u0410\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440'\\ * OR *\\ 'Administrateur'\\ * OR *\\ 'Administrador'\\ * OR *\\ 'Administrat\u00f6r'\\ * OR *\\ 'Administrator'\\ * OR *\\ 'guest'\\ * OR *\\ 'DefaultAccount'\\ *))) AND (NOT (CommandLine:*guest* AND CommandLine:*\\/active\\ no*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
