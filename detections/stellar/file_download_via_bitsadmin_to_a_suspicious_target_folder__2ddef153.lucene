// File Download Via Bitsadmin To A Suspicious Target Folder | T1036.003, T1105, T1197 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_bitsadmin_download_susp_targetfolder.yml
(Image:*\\bitsadmin.exe OR OriginalFileName:bitsadmin.exe) AND (CommandLine:(*\ \/transfer\ * OR *\ \/create\ * OR *\ \/addfile\ *)) AND (CommandLine:(*\:\\Perflogs* OR *\:\\ProgramData\\* OR *\:\\Temp\\* OR *\:\\Users\\Public\\* OR *\:\\Windows\\* OR *\\$Recycle.Bin\\* OR *\\AppData\\Local\\* OR *\\AppData\\Roaming\\* OR *\\Contacts\\* OR *\\Desktop\\* OR *\\Favorites\\* OR *\\Favourites\\* OR *\\inetpub\\wwwroot\\* OR *\\Music\\* OR *\\Pictures\\* OR *\\Start\ Menu\\Programs\\Startup\\* OR *\\Users\\Default\\* OR *\\Videos\\* OR *%ProgramData%* OR *%public%* OR *%temp%* OR *%tmp%*))

