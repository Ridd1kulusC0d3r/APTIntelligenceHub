// Netcat The Powershell Version | T1059.001, T1095 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_classic/posh_pc_powercat.yml
Data:(*powercat\ * OR *powercat.ps1*)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "Data:(*powercat\\ * OR *powercat.ps1*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
