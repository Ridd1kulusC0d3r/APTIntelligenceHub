// Office Macro File Creation From Suspicious Process | T1566.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_office_macro_files_from_susp_process.yml
((Image:(*\\cscript.exe OR *\\mshta.exe OR *\\regsvr32.exe OR *\\rundll32.exe OR *\\wscript.exe)) OR (ParentImage:(*\\cscript.exe OR *\\mshta.exe OR *\\regsvr32.exe OR *\\rundll32.exe OR *\\wscript.exe))) AND (TargetFilename:(*.docm OR *.dotm OR *.xlsm OR *.xltm OR *.potm OR *.pptm))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "((Image:(*\\\\cscript.exe OR *\\\\mshta.exe OR *\\\\regsvr32.exe OR *\\\\rundll32.exe OR *\\\\wscript.exe)) OR (ParentImage:(*\\\\cscript.exe OR *\\\\mshta.exe OR *\\\\regsvr32.exe OR *\\\\rundll32.exe OR *\\\\wscript.exe))) AND (TargetFilename:(*.docm OR *.dotm OR *.xlsm OR *.xltm OR *.potm OR *.pptm))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
