// ESXi Account Creation Via ESXCLI | T1059.012, T1136 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_esxcli_user_account_creation.yml
Image:*\/esxcli AND (CommandLine:*system\ * AND CommandLine:*account\ * AND CommandLine:*add\ *)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "Image:*\\/esxcli AND (CommandLine:*system\\ * AND CommandLine:*account\\ * AND CommandLine:*add\\ *)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
