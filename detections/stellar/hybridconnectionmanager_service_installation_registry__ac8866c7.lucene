// HybridConnectionManager Service Installation - Registry | T1608 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_hybridconnectionmgr_svc_installation.yml
TargetObject:*\\Services\\HybridConnectionManager* OR (EventType:SetValue AND Details:*Microsoft.HybridConnectionManager.Listener.exe*)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "TargetObject:*\\\\Services\\\\HybridConnectionManager* OR (EventType:SetValue AND Details:*Microsoft.HybridConnectionManager.Listener.exe*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
