// Suspicious Mount-DiskImage | T1553.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_susp_mount_diskimage.yml
ScriptBlockText:*Mount\-DiskImage\ * AND ScriptBlockText:*\-ImagePath\ *

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "ScriptBlockText:*Mount\\-DiskImage\\ * AND ScriptBlockText:*\\-ImagePath\\ *",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
