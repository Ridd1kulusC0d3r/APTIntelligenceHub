// Windows Binaries Write Suspicious Extensions | T1036 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_shell_write_susp_files_extensions.yml
(((Image:(*\\csrss.exe OR *\\lsass.exe OR *\\RuntimeBroker.exe OR *\\sihost.exe OR *\\smss.exe OR *\\wininit.exe OR *\\winlogon.exe)) AND (TargetFilename:(*.bat OR *.dll OR *.exe OR *.hta OR *.iso OR *.ps1 OR *.txt OR *.vbe OR *.vbs))) OR ((Image:(*\\dllhost.exe OR *\\rundll32.exe OR *\\svchost.exe)) AND (TargetFilename:(*.bat OR *.hta OR *.iso OR *.ps1 OR *.vbe OR *.vbs)))) AND (NOT ((Image:C\:\\Windows\\System32\\dllhost.exe AND (TargetFilename:*\:\\Users\\* AND TargetFilename:*\\AppData\\Local\\Temp\\__PSScriptPolicyTest_*) AND TargetFilename:*.ps1) OR (Image:C\:\\Windows\\system32\\svchost.exe AND (TargetFilename:*C\:\\Windows\\System32\\GroupPolicy\\DataStore\\* AND TargetFilename:*\\sysvol\\* AND TargetFilename:*\\Policies\\* AND TargetFilename:*\\Machine\\Scripts\\Startup\\*) AND (TargetFilename:(*.ps1 OR *.bat))) OR (Image:C\:\\Windows\\system32\\svchost.exe AND (TargetFilename:*C\:\\Program\ Files\\WindowsApps\\Clipchamp* AND TargetFilename:*.ps1*)) OR ((Image:(C\:\\Windows\\system32\\svchost.exe OR C\:\\Windows\\SysWOW64\\svchost.exe)) AND (TargetFilename:(C\:\\Program\ Files\\WindowsApps\\Microsoft.PowerShellPreview* OR C\:\\Program\ Files\ \(x86\)\\WindowsApps\\Microsoft.PowerShellPreview*)) AND TargetFilename:*.ps1)))

