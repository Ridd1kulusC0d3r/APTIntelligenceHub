// Winlogon Helper DLL | T1547.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_winlogon_helper_dll.yml
ScriptBlockText:*CurrentVersion\\Winlogon* AND (ScriptBlockText:(*Set\-ItemProperty* OR *New\-Item*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "ScriptBlockText:*CurrentVersion\\\\Winlogon* AND (ScriptBlockText:(*Set\\-ItemProperty* OR *New\\-Item*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
