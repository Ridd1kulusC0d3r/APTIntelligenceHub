// Antivirus - Password Dumper Signature | T1003, T1003.001, T1003.002, T1558 | https://github.com/SigmaHQ/sigma/blob/master/rules/category/antivirus/av_password_dumper.yml
Signature:PWS* OR (Signature:(*Certify* OR *DCSync* OR *Creddump* OR *DumpCreds* OR *DumpLsass* OR *DumpPert* OR *FormBook* OR *HTool\/WCE* OR *Kekeo* OR *Lazagne* OR *LsassDump* OR *Lummast* OR *Mimikatz* OR *MultiDump* OR *Multiverze* OR *Nanodump* OR *NativeDump* OR *Outflank* OR *PShlSpy* OR *PSWTool* OR *PWCrack* OR *PWDump* OR *PWS.* OR *PWSX* OR *pypykatz* OR *Rubeus* OR *SafetyKatz* OR *SecurityTool* OR *SharpChrome* OR *SharpDPAPI* OR *SharpDump* OR *SharpKatz* OR *SharpS.* OR *ShpKatz* OR *Steal* OR *TrickDump* OR *wsass*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "Signature:PWS* OR (Signature:(*Certify* OR *DCSync* OR *Creddump* OR *DumpCreds* OR *DumpLsass* OR *DumpPert* OR *FormBook* OR *HTool\\/WCE* OR *Kekeo* OR *Lazagne* OR *LsassDump* OR *Lummast* OR *Mimikatz* OR *MultiDump* OR *Multiverze* OR *Nanodump* OR *NativeDump* OR *Outflank* OR *PShlSpy* OR *PSWTool* OR *PWCrack* OR *PWDump* OR *PWS.* OR *PWSX* OR *pypykatz* OR *Rubeus* OR *SafetyKatz* OR *SecurityTool* OR *SharpChrome* OR *SharpDPAPI* OR *SharpDump* OR *SharpKatz* OR *SharpS.* OR *ShpKatz* OR *Steal* OR *TrickDump* OR *wsass*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
