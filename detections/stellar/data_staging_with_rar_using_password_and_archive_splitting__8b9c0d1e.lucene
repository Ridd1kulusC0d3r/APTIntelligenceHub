// Data Staging With RAR Using Password And Archive Splitting | T1560.001 | Hub
((Image:(*\\rar.exe OR *\\winrar.exe)) OR OriginalFileName:"Command line RAR") AND (CommandLine:(*\ \-hp* OR *\ \-p*)) AND CommandLine:*\ \-v*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "((Image:(*\\\\rar.exe OR *\\\\winrar.exe)) OR OriginalFileName:\"Command line RAR\") AND (CommandLine:(*\\ \\-hp* OR *\\ \\-p*)) AND CommandLine:*\\ \\-v*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
