// NTDS Exfiltration Filename Patterns | T1003.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_ntds_exfil_tools.yml
TargetFilename:(*\\All.cab OR *.ntds.cleartext)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "TargetFilename:(*\\\\All.cab OR *.ntds.cleartext)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
