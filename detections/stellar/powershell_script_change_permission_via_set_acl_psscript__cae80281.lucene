// PowerShell Script Change Permission Via Set-Acl - PsScript | T1222 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_set_acl.yml
ScriptBlockText:*Set\-Acl\ * AND ScriptBlockText:*\-AclObject\ * AND ScriptBlockText:*\-Path\ *

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "ScriptBlockText:*Set\\-Acl\\ * AND ScriptBlockText:*\\-AclObject\\ * AND ScriptBlockText:*\\-Path\\ *",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
