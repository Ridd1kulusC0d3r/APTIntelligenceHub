// Findstr GPP Passwords | T1552.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_findstr_gpp_passwords.yml
((Image:(*\\find.exe OR *\\findstr.exe)) OR (OriginalFileName:(FIND.EXE OR FINDSTR.EXE))) AND (CommandLine:*cpassword* AND CommandLine:*\\sysvol\\* AND CommandLine:*.xml*)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "((Image:(*\\\\find.exe OR *\\\\findstr.exe)) OR (OriginalFileName:(FIND.EXE OR FINDSTR.EXE))) AND (CommandLine:*cpassword* AND CommandLine:*\\\\sysvol\\\\* AND CommandLine:*.xml*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
