// PwnDrp Access | T1071.001, T1102.001, T1102.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/web/proxy_generic/proxy_pwndrop.yml
c-uri:*\/pwndrop\/*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "c-uri:*\\/pwndrop\\/*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
