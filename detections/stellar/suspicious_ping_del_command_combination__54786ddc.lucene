          "query_string": {
            "query": "CommandLine:(*\\ \\-n\\ * OR *\\ \\/n\\ * OR *\\ \u2013n\\ * OR *\\ \u2014n\\ * OR *\\ \u2015n\\ *) AND CommandLine:*Nul* AND (CommandLine:(*\\ \\-f\\ * OR *\\ \\/f\\ * OR *\\ \u2013f\\ * OR *\\ \u2014f\\ * OR *\\ \u2015f\\ *) OR CommandLine:(*\\ \\-q\\ * OR *\\ \\/q\\ * OR *\\ \u2013q\\ * OR *\\ \u2014q\\ * OR *\\ \u2015q\\ *)) AND (CommandLine:*ping* AND CommandLine:*del\\ *)",
            "analyze_wildcard": true
