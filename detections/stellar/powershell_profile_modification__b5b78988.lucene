// PowerShell Profile Modification | T1546.013 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_powershell_profile.yml
TargetFilename:(*\\Microsoft.PowerShell_profile.ps1 OR *\\PowerShell\\profile.ps1 OR *\\Program\ Files\\PowerShell\\7\-preview\\profile.ps1 OR *\\Program\ Files\\PowerShell\\7\\profile.ps1 OR *\\Windows\\System32\\WindowsPowerShell\\v1.0\\profile.ps1 OR *\\WindowsPowerShell\\profile.ps1)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "TargetFilename:(*\\\\Microsoft.PowerShell_profile.ps1 OR *\\\\PowerShell\\\\profile.ps1 OR *\\\\Program\\ Files\\\\PowerShell\\\\7\\-preview\\\\profile.ps1 OR *\\\\Program\\ Files\\\\PowerShell\\\\7\\\\profile.ps1 OR *\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\profile.ps1 OR *\\\\WindowsPowerShell\\\\profile.ps1)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
