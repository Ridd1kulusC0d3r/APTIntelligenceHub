// ESXi Syslog Configuration Change Via ESXCLI | T1059.012, T1685, T1690 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_esxcli_syslog_config_change.yml
Image:*\/esxcli AND (CommandLine:*system* AND CommandLine:*syslog* AND CommandLine:*config*) AND CommandLine:*\ set*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "Image:*\\/esxcli AND (CommandLine:*system* AND CommandLine:*syslog* AND CommandLine:*config*) AND CommandLine:*\\ set*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
