// Password Protected ZIP File Opened (Suspicious Filenames) | T1027, T1036, T1105 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_susp_opened_encrypted_zip_filename.yml
(EventID:5379 AND TargetName:*Microsoft_Windows_Shell_ZipFolder\:filename*) AND (TargetName:(*invoice* OR *new\ order* OR *rechnung* OR *factura* OR *delivery* OR *purchase* OR *order* OR *payment*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(EventID:5379 AND TargetName:*Microsoft_Windows_Shell_ZipFolder\\:filename*) AND (TargetName:(*invoice* OR *new\\ order* OR *rechnung* OR *factura* OR *delivery* OR *purchase* OR *order* OR *payment*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
