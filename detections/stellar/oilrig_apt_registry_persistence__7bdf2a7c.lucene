      "must": [
        {
          "query_string": {
            "query": "TargetObject:(*SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\UMe OR *SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\UT)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
