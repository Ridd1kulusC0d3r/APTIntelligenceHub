// Multifactor Authentication Denied | T1078.004, T1110, T1621 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/azure/signin_logs/azure_mfa_denies.yml
AuthenticationRequirement:multiFactorAuthentication AND Status:*MFA\ Denied*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "AuthenticationRequirement:multiFactorAuthentication AND Status:*MFA\\ Denied*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
