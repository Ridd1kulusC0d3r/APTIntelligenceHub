// Windows LAPS Credential Dump From Entra ID | T1098.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/azure/audit_logs/azure_auditlogs_laps_credential_dumping.yml
category:Device AND activityType:*Recover\ device\ local\ administrator\ password* AND additionalDetails.additionalInfo:*Successfully\ recovered\ local\ credential\ by\ device\ id*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "category:Device AND activityType:*Recover\\ device\\ local\\ administrator\\ password* AND additionalDetails.additionalInfo:*Successfully\\ recovered\\ local\\ credential\\ by\\ device\\ id*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
