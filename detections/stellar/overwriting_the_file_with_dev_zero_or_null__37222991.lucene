// Overwriting the File with Dev Zero or Null | T1485 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/execve/lnx_auditd_dd_delete_file.yml
type:EXECVE AND a0:*dd* AND (a1:(*if\=\/dev\/null* OR *if\=\/dev\/zero*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "type:EXECVE AND a0:*dd* AND (a1:(*if\\=\\/dev\\/null* OR *if\\=\\/dev\\/zero*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
