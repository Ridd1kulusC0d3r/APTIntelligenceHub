// Disable Or Stop Services | T1489, T1685 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_services_stop_and_disable.yml
((Image:(*\/service OR *\/systemctl OR *\/chkconfig)) AND (CommandLine:(*\ stop\ * OR *\ disable\ *))) AND (NOT ((Image:*\/systemctl AND (CommandLine:(*\-\-no\-reload\ disable\ snap\-snapd\-* OR *\ stop\ snap\-snapd\-*))) OR (Image:*\/systemctl AND ParentCommandLine:*tmp.ci\/preinst\ upgrade* AND (CommandLine:*\ stop\ * AND CommandLine:*ssh.*)) OR (ParentCommandLine:*\/dpkg\/info\/ubuntu\-pro\-client.prerm\ upgrade* AND Image:*\/systemctl))) AND (NOT (Image:*\/systemctl AND CommandLine:*snap.amazon\-ssm\-agent.amazon\-ssm\-agent.service))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "((Image:(*\\/service OR *\\/systemctl OR *\\/chkconfig)) AND (CommandLine:(*\\ stop\\ * OR *\\ disable\\ *))) AND (NOT ((Image:*\\/systemctl AND (CommandLine:(*\\-\\-no\\-reload\\ disable\\ snap\\-snapd\\-* OR *\\ stop\\ snap\\-snapd\\-*))) OR (Image:*\\/systemctl AND ParentCommandLine:*tmp.ci\\/preinst\\ upgrade* AND (CommandLine:*\\ stop\\ * AND CommandLine:*ssh.*)) OR (ParentCommandLine:*\\/dpkg\\/info\\/ubuntu\\-pro\\-client.prerm\\ upgrade* AND Image:*\\/systemctl))) AND (NOT (Image:*\\/systemctl AND CommandLine:*snap.amazon\\-ssm\\-agent.amazon\\-ssm\\-agent.service))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
