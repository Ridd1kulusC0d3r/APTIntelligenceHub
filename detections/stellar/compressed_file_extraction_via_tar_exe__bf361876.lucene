// Compressed File Extraction Via Tar.EXE | T1560, T1560.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_tar_extraction.yml
(Image:*\\tar.exe OR OriginalFileName:bsdtar) AND CommandLine:*\-x*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(Image:*\\\\tar.exe OR OriginalFileName:bsdtar) AND CommandLine:*\\-x*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
