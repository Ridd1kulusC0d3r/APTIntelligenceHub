          "query_string": {
            "query": "(eventType:policy.evaluate_sign_on AND target.displayName:\"Okta Admin Console\") AND (debugContext.debugData.behaviors:*POSITIVE* OR debugContext.debugData.logOnlySecurityData:*POSITIVE*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
