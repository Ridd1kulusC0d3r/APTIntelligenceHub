// HTTP Logging Disabled On IIS Server | T1505.004, T1685.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/iis-configuration/win_iis_logging_http_disabled.yml
EventID:29 AND Configuration:\/system.webServer\/httpLogging\/@dontLog AND NewValue:true

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "EventID:29 AND Configuration:\\/system.webServer\\/httpLogging\\/@dontLog AND NewValue:true",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
