// Suspicious Printer Driver Empty Manufacturer | T1574 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_susp_printer_driver.yml
((TargetObject:*\\Control\\Print\\Environments\\Windows\ x64\\Drivers* AND TargetObject:*\\Manufacturer*) AND Details:\(Empty\)) AND (NOT (TargetObject:*\\CutePDF\ Writer\ v4.0\\* OR (TargetObject:(*\\VNC\ Printer\ \(PS\)\\* OR *\\VNC\ Printer\ \(UD\)\\*)) OR TargetObject:*\\Version\-3\\PDF24\\*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "((TargetObject:*\\\\Control\\\\Print\\\\Environments\\\\Windows\\ x64\\\\Drivers* AND TargetObject:*\\\\Manufacturer*) AND Details:\\(Empty\\)) AND (NOT (TargetObject:*\\\\CutePDF\\ Writer\\ v4.0\\\\* OR (TargetObject:(*\\\\VNC\\ Printer\\ \\(PS\\)\\\\* OR *\\\\VNC\\ Printer\\ \\(UD\\)\\\\*)) OR TargetObject:*\\\\Version\\-3\\\\PDF24\\\\*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
