// System and Hardware Information Discovery | T1082 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/path/lnx_auditd_system_info_discovery2.yml
type:PATH AND (name:(\/sys\/class\/dmi\/id\/bios_version OR \/sys\/class\/dmi\/id\/product_name OR \/sys\/class\/dmi\/id\/chassis_vendor OR \/proc\/scsi\/scsi OR \/proc\/ide\/hd0\/model OR \/proc\/version OR \/etc\/*version OR \/etc\/*release OR \/etc\/issue))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "type:PATH AND (name:(\\/sys\\/class\\/dmi\\/id\\/bios_version OR \\/sys\\/class\\/dmi\\/id\\/product_name OR \\/sys\\/class\\/dmi\\/id\\/chassis_vendor OR \\/proc\\/scsi\\/scsi OR \\/proc\\/ide\\/hd0\\/model OR \\/proc\\/version OR \\/etc\\/*version OR \\/etc\\/*release OR \\/etc\\/issue))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
