// File Deletion | T1070.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_file_deletion.yml
Image:(*\/rm OR *\/shred OR *\/unlink)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "Image:(*\\/rm OR *\\/shred OR *\\/unlink)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
