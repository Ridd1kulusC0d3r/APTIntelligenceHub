// Masquerading as Linux Crond Process | T1036.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/execve/lnx_auditd_masquerading_crond.yml
type:execve AND a0:cp AND a1:\/bin\/sh AND a2:*\/crond

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "type:execve AND a0:cp AND a1:\\/bin\\/sh AND a2:*\\/crond",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
