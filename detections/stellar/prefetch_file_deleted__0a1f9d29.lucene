      "must": [
        {
          "query_string": {
            "query": "(TargetFilename:*\\:\\\\Windows\\\\Prefetch\\\\* AND TargetFilename:*.pf) AND (NOT (Image:*\\:\\\\windows\\\\system32\\\\svchost.exe AND (User:(*AUTHORI* OR *AUTORI*))))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
