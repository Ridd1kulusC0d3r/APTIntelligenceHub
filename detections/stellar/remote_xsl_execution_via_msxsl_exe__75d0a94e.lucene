// Remote XSL Execution Via Msxsl.EXE | T1220 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_msxsl_remote_execution.yml
Image:*\\msxsl.exe AND CommandLine:*http*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "Image:*\\\\msxsl.exe AND CommandLine:*http*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
