// Replace Desktop Wallpaper by Powershell | T1491.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_susp_wallpaper.yml
(ScriptBlockText:*Get\-ItemProperty* AND ScriptBlockText:*Registry\:\:* AND ScriptBlockText:*HKEY_CURRENT_USER\\Control\ Panel\\Desktop\\* AND ScriptBlockText:*WallPaper*) OR ScriptBlockText:*SystemParametersInfo\(20,0,*,3\)*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(ScriptBlockText:*Get\\-ItemProperty* AND ScriptBlockText:*Registry\\:\\:* AND ScriptBlockText:*HKEY_CURRENT_USER\\\\Control\\ Panel\\\\Desktop\\\\* AND ScriptBlockText:*WallPaper*) OR ScriptBlockText:*SystemParametersInfo\\(20,0,*,3\\)*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
