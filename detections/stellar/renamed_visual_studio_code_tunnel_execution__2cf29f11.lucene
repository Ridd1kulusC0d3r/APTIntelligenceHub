// Renamed Visual Studio Code Tunnel Execution | T1071.001, T1219 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_vscode_tunnel_renamed_execution.yml
((((NOT _exists_:OriginalFileName) AND CommandLine:*.exe\ tunnel) OR (CommandLine:*.exe\ tunnel* AND CommandLine:*\-\-accept\-server\-license\-terms*) OR (CommandLine:*tunnel\ * AND CommandLine:*service* AND CommandLine:*internal\-run* AND CommandLine:*tunnel\-service.log*)) AND (NOT (Image:(*\\code\-tunnel.exe OR *\\code.exe)))) OR ((ParentCommandLine:*\ tunnel AND Image:*\\cmd.exe AND (CommandLine:*\/d\ \/c\ * AND CommandLine:*\\servers\\Stable\-* AND CommandLine:*code\-server.cmd*)) AND (NOT (ParentImage:(*\\code\-tunnel.exe OR *\\code.exe))))

