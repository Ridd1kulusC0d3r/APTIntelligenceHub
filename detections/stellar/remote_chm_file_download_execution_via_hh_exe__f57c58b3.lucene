// Remote CHM File Download/Execution Via HH.EXE | T1218.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hh_chm_remote_download_or_execution.yml
(OriginalFileName:HH.exe OR Image:*\\hh.exe) AND (CommandLine:(*http\:\/\/* OR *https\:\/\/* OR *\\\\*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(OriginalFileName:HH.exe OR Image:*\\\\hh.exe) AND (CommandLine:(*http\\:\\/\\/* OR *https\\:\\/\\/* OR *\\\\\\\\*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
