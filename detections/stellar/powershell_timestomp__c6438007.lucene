// Powershell Timestomp | T1070.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_timestomp.yml
ScriptBlockText:(*.CreationTime\ \=* OR *.LastWriteTime\ \=* OR *.LastAccessTime\ \=* OR *\[IO.File\]\:\:SetCreationTime* OR *\[IO.File\]\:\:SetLastAccessTime* OR *\[IO.File\]\:\:SetLastWriteTime*)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "ScriptBlockText:(*.CreationTime\\ \\=* OR *.LastWriteTime\\ \\=* OR *.LastAccessTime\\ \\=* OR *\\[IO.File\\]\\:\\:SetCreationTime* OR *\\[IO.File\\]\\:\\:SetLastAccessTime* OR *\\[IO.File\\]\\:\\:SetLastWriteTime*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
