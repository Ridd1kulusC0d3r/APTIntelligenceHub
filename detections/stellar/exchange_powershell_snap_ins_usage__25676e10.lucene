// Exchange PowerShell Snap-Ins Usage | T1059.001, T1114 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_snapins_hafnium.yml
(((Image:(*\\powershell.exe OR *\\pwsh.exe)) OR (OriginalFileName:(PowerShell.EXE OR pwsh.dll))) AND CommandLine:*Add\-PSSnapin* AND (CommandLine:(*Microsoft.Exchange.Powershell.Snapin* OR *Microsoft.Exchange.Management.PowerShell.SnapIn*))) AND (NOT (ParentImage:C\:\\Windows\\System32\\msiexec.exe AND CommandLine:*$exserver\=Get\-ExchangeServer\ \(\[Environment\]\:\:MachineName\)\ \-ErrorVariable\ exerr\ 2\>\ $null*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(((Image:(*\\\\powershell.exe OR *\\\\pwsh.exe)) OR (OriginalFileName:(PowerShell.EXE OR pwsh.dll))) AND CommandLine:*Add\\-PSSnapin* AND (CommandLine:(*Microsoft.Exchange.Powershell.Snapin* OR *Microsoft.Exchange.Management.PowerShell.SnapIn*))) AND (NOT (ParentImage:C\\:\\\\Windows\\\\System32\\\\msiexec.exe AND CommandLine:*$exserver\\=Get\\-ExchangeServer\\ \\(\\[Environment\\]\\:\\:MachineName\\)\\ \\-ErrorVariable\\ exerr\\ 2\\>\\ $null*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
