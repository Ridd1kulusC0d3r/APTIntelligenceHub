      "must": [
        {
          "query_string": {
            "query": "TargetFilename:/\\\\Windows\\\\__1\\d{9}\\.\\d{1,7}$/ OR TargetFilename:/C:\\\\__1\\d{9}\\.\\d{1,7}$/ OR TargetFilename:/D:\\\\__1\\d{9}\\.\\d{1,7}$/",
