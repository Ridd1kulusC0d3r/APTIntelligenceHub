// Compressed File Creation Via Tar.EXE | T1560, T1560.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_tar_compression.yml
(Image:*\\tar.exe OR OriginalFileName:bsdtar) AND (CommandLine:(*\-c* OR *\-r* OR *\-u*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(Image:*\\\\tar.exe OR OriginalFileName:bsdtar) AND (CommandLine:(*\\-c* OR *\\-r* OR *\\-u*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
