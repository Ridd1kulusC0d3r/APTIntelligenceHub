// Suspicious Child Process Of Manage Engine ServiceDesk | T1102 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_java_manageengine_susp_child_process.yml
((ParentImage:*\\ManageEngine\\ServiceDesk\\* AND ParentImage:*\\java.exe*) AND (Image:(*\\AppVLP.exe OR *\\bash.exe OR *\\bitsadmin.exe OR *\\calc.exe OR *\\certutil.exe OR *\\cscript.exe OR *\\curl.exe OR *\\forfiles.exe OR *\\mftrace.exe OR *\\mshta.exe OR *\\net.exe OR *\\net1.exe OR *\\notepad.exe OR *\\powershell.exe OR *\\pwsh.exe OR *\\query.exe OR *\\reg.exe OR *\\schtasks.exe OR *\\scrcons.exe OR *\\sh.exe OR *\\systeminfo.exe OR *\\whoami.exe OR *\\wmic.exe OR *\\wscript.exe))) AND (NOT ((Image:(*\\net.exe OR *\\net1.exe)) AND CommandLine:*\ stop*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "((ParentImage:*\\\\ManageEngine\\\\ServiceDesk\\\\* AND ParentImage:*\\\\java.exe*) AND (Image:(*\\\\AppVLP.exe OR *\\\\bash.exe OR *\\\\bitsadmin.exe OR *\\\\calc.exe OR *\\\\certutil.exe OR *\\\\cscript.exe OR *\\\\curl.exe OR *\\\\forfiles.exe OR *\\\\mftrace.exe OR *\\\\mshta.exe OR *\\\\net.exe OR *\\\\net1.exe OR *\\\\notepad.exe OR *\\\\powershell.exe OR *\\\\pwsh.exe OR *\\\\query.exe OR *\\\\reg.exe OR *\\\\schtasks.exe OR *\\\\scrcons.exe OR *\\\\sh.exe OR *\\\\systeminfo.exe OR *\\\\whoami.exe OR *\\\\wmic.exe OR *\\\\wscript.exe))) AND (NOT ((Image:(*\\\\net.exe OR *\\\\net1.exe)) AND CommandLine:*\\ stop*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
