// File And SubFolder Enumeration Via Dir Command | T1217 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_cmd_dir_execution.yml
((Image:*\\cmd.exe OR OriginalFileName:Cmd.Exe) AND (CommandLine:(*\-s* OR *\/s* OR *–s* OR *—s* OR *―s*) AND CommandLine:*dir\ *)) AND (NOT CommandLine:*rmdir*)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "((Image:*\\\\cmd.exe OR OriginalFileName:Cmd.Exe) AND (CommandLine:(*\\-s* OR *\\/s* OR *\u2013s* OR *\u2014s* OR *\u2015s*) AND CommandLine:*dir\\ *)) AND (NOT CommandLine:*rmdir*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
