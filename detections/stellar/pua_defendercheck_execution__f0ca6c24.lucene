// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "Image:*\\\\DefenderCheck.exe OR Description:DefenderCheck",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
