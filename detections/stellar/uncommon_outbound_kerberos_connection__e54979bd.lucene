// Uncommon Outbound Kerberos Connection | T1550.003, T1558 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_susp_outbound_kerberos_connection.yml
(DestinationPort:88 AND Initiated:true) AND (NOT Image:C\:\\Windows\\System32\\lsass.exe) AND (NOT ((Image:("C\:\\Program Files \(x86\)\\Google\\Chrome\\Application\\chrome.exe" OR "C\:\\Program Files\\Google\\Chrome\\Application\\chrome.exe")) OR (Image:("C\:\\Program Files \(x86\)\\Mozilla Firefox\\firefox.exe" OR "C\:\\Program Files\\Mozilla Firefox\\firefox.exe")) OR Image:*\\tomcat\\bin\\tomcat8.exe OR (Image:("C\:\\Program Files\\Zscaler\\ZSATunnel\\ZSATunnel.exe" OR "C\:\\Program Files \(x86\)\\Zscaler\\ZSATunnel\\ZSATunnel.exe"))))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(DestinationPort:88 AND Initiated:true) AND (NOT Image:C\\:\\\\Windows\\\\System32\\\\lsass.exe) AND (NOT ((Image:(\"C\\:\\\\Program Files \\(x86\\)\\\\Google\\\\Chrome\\\\Application\\\\chrome.exe\" OR \"C\\:\\\\Program Files\\\\Google\\\\Chrome\\\\Application\\\\chrome.exe\")) OR (Image:(\"C\\:\\\\Program Files \\(x86\\)\\\\Mozilla Firefox\\\\firefox.exe\" OR \"C\\:\\\\Program Files\\\\Mozilla Firefox\\\\firefox.exe\")) OR Image:*\\\\tomcat\\\\bin\\\\tomcat8.exe OR (Image:(\"C\\:\\\\Program Files\\\\Zscaler\\\\ZSATunnel\\\\ZSATunnel.exe\" OR \"C\\:\\\\Program Files \\(x86\\)\\\\Zscaler\\\\ZSATunnel\\\\ZSATunnel.exe\"))))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
