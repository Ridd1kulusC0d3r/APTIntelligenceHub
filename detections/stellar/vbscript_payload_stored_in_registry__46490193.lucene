// VBScript Payload Stored in Registry | T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_vbs_payload_stored.yml
(TargetObject:*Software\\Microsoft\\Windows\\CurrentVersion* AND (Details:(*vbscript\:* OR *jscript\:* OR *mshtml,* OR *RunHTMLApplication* OR *Execute\(* OR *CreateObject* OR *window.close*))) AND (NOT (TargetObject:*Software\\Microsoft\\Windows\\CurrentVersion\\Run* OR (Image:*\\msiexec.exe AND TargetObject:*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Installer\\UserData\\* AND (Details:(*\\Microsoft.NET\\Primary\ Interop\ Assemblies\\Microsoft.mshtml.dll* OR *\<\\Microsoft.mshtml,fileVersion\=* OR *_mshtml_dll_* OR *\<\\Microsoft.mshtml,culture\=*)))))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(TargetObject:*Software\\\\Microsoft\\\\Windows\\\\CurrentVersion* AND (Details:(*vbscript\\:* OR *jscript\\:* OR *mshtml,* OR *RunHTMLApplication* OR *Execute\\(* OR *CreateObject* OR *window.close*))) AND (NOT (TargetObject:*Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run* OR (Image:*\\\\msiexec.exe AND TargetObject:*\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Installer\\\\UserData\\\\* AND (Details:(*\\\\Microsoft.NET\\\\Primary\\ Interop\\ Assemblies\\\\Microsoft.mshtml.dll* OR *\\<\\\\Microsoft.mshtml,fileVersion\\=* OR *_mshtml_dll_* OR *\\<\\\\Microsoft.mshtml,culture\\=*)))))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
