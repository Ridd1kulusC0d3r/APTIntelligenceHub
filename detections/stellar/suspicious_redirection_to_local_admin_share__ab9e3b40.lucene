// Suspicious Redirection to Local Admin Share | T1048 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_redirect_local_admin_share.yml
CommandLine:*\>* AND (CommandLine:(*\\\\127.0.0.1\\admin$\\* OR *\\\\localhost\\admin$\\*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "CommandLine:*\\>* AND (CommandLine:(*\\\\\\\\127.0.0.1\\\\admin$\\\\* OR *\\\\\\\\localhost\\\\admin$\\\\*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
