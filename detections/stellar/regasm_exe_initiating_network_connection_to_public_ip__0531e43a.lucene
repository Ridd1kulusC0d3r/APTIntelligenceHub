// RegAsm.EXE Initiating Network Connection To Public IP | T1218.009 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_regasm_network_activity.yml
(Initiated:true AND Image:*\\regasm.exe) AND (NOT (DestinationIp:127.0.0.0\/8 OR DestinationIp:10.0.0.0\/8 OR DestinationIp:172.16.0.0\/12 OR DestinationIp:192.168.0.0\/16 OR DestinationIp:169.254.0.0\/16 OR DestinationIp:\:\:1\/128 OR DestinationIp:fe80\:\:\/10 OR DestinationIp:fc00\:\:\/7))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(Initiated:true AND Image:*\\\\regasm.exe) AND (NOT (DestinationIp:127.0.0.0\\/8 OR DestinationIp:10.0.0.0\\/8 OR DestinationIp:172.16.0.0\\/12 OR DestinationIp:192.168.0.0\\/16 OR DestinationIp:169.254.0.0\\/16 OR DestinationIp:\\:\\:1\\/128 OR DestinationIp:fe80\\:\\:\\/10 OR DestinationIp:fc00\\:\\:\\/7))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
