// Automated Collection Bookmarks Using Get-ChildItem PowerShell | T1217 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_get_childitem_bookmarks.yml
ScriptBlockText:*Get\-ChildItem* AND ScriptBlockText:*\ \-Recurse\ * AND ScriptBlockText:*\ \-Path\ * AND ScriptBlockText:*\ \-Filter\ Bookmarks* AND ScriptBlockText:*\ \-ErrorAction\ SilentlyContinue* AND ScriptBlockText:*\ \-Force*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "ScriptBlockText:*Get\\-ChildItem* AND ScriptBlockText:*\\ \\-Recurse\\ * AND ScriptBlockText:*\\ \\-Path\\ * AND ScriptBlockText:*\\ \\-Filter\\ Bookmarks* AND ScriptBlockText:*\\ \\-ErrorAction\\ SilentlyContinue* AND ScriptBlockText:*\\ \\-Force*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
