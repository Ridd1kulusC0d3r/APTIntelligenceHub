          "query_string": {
            "query": "(Product:SQLite OR (Image:(*\\\\sqlite.exe OR *\\\\sqlite3.exe))) AND (CommandLine:(*cookies.sqlite* OR *places.sqlite*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
