// AWS IAM S3Browser LoginProfile Creation | T1059.009, T1078.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/aws/cloudtrail/aws_iam_s3browser_loginprofile_creation.yml
eventSource:iam.amazonaws.com AND (eventName:(GetLoginProfile OR CreateLoginProfile)) AND userAgent:*S3\ Browser*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "eventSource:iam.amazonaws.com AND (eventName:(GetLoginProfile OR CreateLoginProfile)) AND userAgent:*S3\\ Browser*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
