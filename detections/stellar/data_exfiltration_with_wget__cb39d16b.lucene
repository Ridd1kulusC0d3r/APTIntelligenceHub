// Data Exfiltration with Wget | T1048.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/execve/lnx_auditd_data_exfil_wget.yml
type:EXECVE AND a0:wget AND a1:\-\-post\-file\=*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "type:EXECVE AND a0:wget AND a1:\\-\\-post\\-file\\=*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
