// Potential WinAPI Calls Via PowerShell Scripts | T1059.001, T1106, T1620 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_win_api_susp_access.yml
(ScriptBlockText:*VirtualAlloc* AND ScriptBlockText:*OpenProcess* AND ScriptBlockText:*WriteProcessMemory* AND ScriptBlockText:*CreateRemoteThread*) OR (ScriptBlockText:*OpenProcessToken* AND ScriptBlockText:*LookupPrivilegeValue* AND ScriptBlockText:*AdjustTokenPrivileges*) OR (ScriptBlockText:*OpenProcessToken* AND ScriptBlockText:*DuplicateTokenEx* AND ScriptBlockText:*CloseHandle*) OR (ScriptBlockText:*WriteProcessMemory* AND ScriptBlockText:*VirtualAlloc* AND ScriptBlockText:*ReadProcessMemory* AND ScriptBlockText:*VirtualFree*) OR (ScriptBlockText:*VirtualAlloc* AND ScriptBlockText:*GetDelegateForFunctionPointer* AND ScriptBlockText:*Marshal.Copy*)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(ScriptBlockText:*VirtualAlloc* AND ScriptBlockText:*OpenProcess* AND ScriptBlockText:*WriteProcessMemory* AND ScriptBlockText:*CreateRemoteThread*) OR (ScriptBlockText:*OpenProcessToken* AND ScriptBlockText:*LookupPrivilegeValue* AND ScriptBlockText:*AdjustTokenPrivileges*) OR (ScriptBlockText:*OpenProcessToken* AND ScriptBlockText:*DuplicateTokenEx* AND ScriptBlockText:*CloseHandle*) OR (ScriptBlockText:*WriteProcessMemory* AND ScriptBlockText:*VirtualAlloc* AND ScriptBlockText:*ReadProcessMemory* AND ScriptBlockText:*VirtualFree*) OR (ScriptBlockText:*VirtualAlloc* AND ScriptBlockText:*GetDelegateForFunctionPointer* AND ScriptBlockText:*Marshal.Copy*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
