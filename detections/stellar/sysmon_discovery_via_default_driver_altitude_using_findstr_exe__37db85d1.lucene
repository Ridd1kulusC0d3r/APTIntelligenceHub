// Sysmon Discovery Via Default Driver Altitude Using Findstr.EXE | T1518.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_findstr_sysmon_discovery_via_default_altitude.yml
((Image:(*\\find.exe OR *\\findstr.exe)) OR (OriginalFileName:(FIND.EXE OR FINDSTR.EXE))) AND CommandLine:*\ 385201*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "((Image:(*\\\\find.exe OR *\\\\findstr.exe)) OR (OriginalFileName:(FIND.EXE OR FINDSTR.EXE))) AND CommandLine:*\\ 385201*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
