// DllUnregisterServer Function Call Via Msiexec.EXE | T1218.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_msiexec_dll.yml
((Image:*\\msiexec.exe OR OriginalFileName:msiexec.exe) AND (CommandLine:(*\ \-z\ * OR *\ \/z\ * OR *\ –z\ * OR *\ —z\ * OR *\ ―z\ *) AND CommandLine:*.dll*)) AND (NOT CommandLine:*\\MsiExec.exe\"\ \/Z\ \"C\:\\Windows\\CCM\\MsiHandler.dll\")

