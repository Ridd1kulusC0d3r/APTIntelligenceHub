      "must": [
        {
          "query_string": {
            "query": "(SourceImage:(*\\\\System32\\\\cscript.exe OR *\\\\System32\\\\wscript.exe OR *\\\\System32\\\\mshta.exe OR *\\\\winword.exe OR *\\\\excel.exe)) AND TargetImage:*\\\\SysWOW64\\\\* AND (NOT _exists_:StartModule)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
