// Potential Malicious Usage of CloudTrail System Manager | T1566, T1566.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/aws/cloudtrail/aws_cloudtrail_ssm_malicious_usage.yml
(eventName:SendCommand AND eventSource:ssm.amazonaws.com) AND (errorCode:Success OR (NOT _exists_:errorCode))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(eventName:SendCommand AND eventSource:ssm.amazonaws.com) AND (errorCode:Success OR (NOT _exists_:errorCode))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
