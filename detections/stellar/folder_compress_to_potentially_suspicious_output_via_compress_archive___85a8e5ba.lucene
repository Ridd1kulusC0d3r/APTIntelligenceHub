// Folder Compress To Potentially Suspicious Output Via Compress-Archive Cmdlet | T1074.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_zip_compress.yml
CommandLine:(*Compress\-Archive\ \-Path*\-DestinationPath\ $env\:TEMP* OR *Compress\-Archive\ \-Path*\-DestinationPath*\\AppData\\Local\\Temp\\* OR *Compress\-Archive\ \-Path*\-DestinationPath*\:\\Windows\\Temp\\*)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "CommandLine:(*Compress\\-Archive\\ \\-Path*\\-DestinationPath\\ $env\\:TEMP* OR *Compress\\-Archive\\ \\-Path*\\-DestinationPath*\\\\AppData\\\\Local\\\\Temp\\\\* OR *Compress\\-Archive\\ \\-Path*\\-DestinationPath*\\:\\\\Windows\\\\Temp\\\\*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
