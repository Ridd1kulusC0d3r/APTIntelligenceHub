          "query_string": {
            "query": "(ScriptBlockText:/\\w+`(\\w+|-|.)`[\\w+|\\s]/ OR ScriptBlockText:/\"(\\{\\d\\}){2,}\"\\s*-f/ OR ScriptBlockText:/(?i)\\$\\{`?e`?n`?v`?:`?p`?a`?t`?h`?\\}/) AND (NOT (ScriptBlockText:*$\\{env\\:path\\}* OR (ScriptBlockText:(*it\\ will\\ return\\ true\\ or\\ false\\ instead* OR *The\\ function\\ also\\ prevents\\ `Get\\-ItemProperty`\\ from\\ failing*)) OR (Path:C\\:\\\\Program\\ Files\\\\Microsoft\\\\Exchange\\ Server\\\\* AND Path:*\\\\bin\\\\servicecontrol.ps1 AND ScriptBlockText:*`r`n*)))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
