// Regedit as Trusted Installer | T1548 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_regedit_trustedinstaller.yml
Image:*\\regedit.exe AND (ParentImage:(*\\TrustedInstaller.exe OR *\\ProcessHacker.exe))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "Image:*\\\\regedit.exe AND (ParentImage:(*\\\\TrustedInstaller.exe OR *\\\\ProcessHacker.exe))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
