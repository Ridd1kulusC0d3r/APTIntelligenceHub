// Security Software Discovery Via Powershell Script | T1518.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_get_process_security_software_discovery.yml
(ScriptBlockText:(*get\-process\ \|\ \?* OR *get\-process\ \|\ where* OR *gps\ \|\ \?* OR *gps\ \|\ where*)) AND (ScriptBlockText:(*Company\ \-like* OR *Description\ \-like* OR *Name\ \-like* OR *Path\ \-like* OR *Product\ \-like*)) AND (ScriptBlockText:(*\*avira\** OR *\*carbonblack\** OR *\*cylance\** OR *\*defender\** OR *\*kaspersky\** OR *\*malware\** OR *\*sentinel\** OR *\*symantec\** OR *\*virus\**))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(ScriptBlockText:(*get\\-process\\ \\|\\ \\?* OR *get\\-process\\ \\|\\ where* OR *gps\\ \\|\\ \\?* OR *gps\\ \\|\\ where*)) AND (ScriptBlockText:(*Company\\ \\-like* OR *Description\\ \\-like* OR *Name\\ \\-like* OR *Path\\ \\-like* OR *Product\\ \\-like*)) AND (ScriptBlockText:(*\\*avira\\** OR *\\*carbonblack\\** OR *\\*cylance\\** OR *\\*defender\\** OR *\\*kaspersky\\** OR *\\*malware\\** OR *\\*sentinel\\** OR *\\*symantec\\** OR *\\*virus\\**))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
