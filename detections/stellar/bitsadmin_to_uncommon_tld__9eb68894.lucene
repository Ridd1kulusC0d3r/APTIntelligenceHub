        {
          "query_string": {
            "query": "c-useragent:Microsoft\\ BITS\\/* AND (NOT (cs-host:(*.com OR *.microsoft OR *.net OR *.org OR *.scdn.co OR *.sfx.ms)))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
