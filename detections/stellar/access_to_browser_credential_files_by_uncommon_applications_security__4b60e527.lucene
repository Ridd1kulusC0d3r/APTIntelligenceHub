      "must": [
        {
          "query_string": {
            "query": "(EventID:4663 AND ObjectType:File AND AccessMask:0x1) AND ((ObjectName:(*\\\\User\\ Data\\\\Default\\\\Login\\ Data* OR *\\\\User\\ Data\\\\Local\\ State* OR *\\\\User\\ Data\\\\Default\\\\Network\\\\Cookies*)) OR (FileName:(*\\\\cookies.sqlite OR *\\\\places.sqlite OR *release\\\\key3.db OR *release\\\\key4.db OR *release\\\\logins.json))) AND (NOT (ProcessName:System OR (ProcessName:(C\\:\\\\Program\\ Files\\ \\(x86\\)\\\\* OR C\\:\\\\Program\\ Files\\\\* OR C\\:\\\\Windows\\\\system32\\\\* OR C\\:\\\\Windows\\\\SysWOW64\\\\*)))) AND (NOT (ProcessName:C\\:\\\\ProgramData\\\\Microsoft\\\\Windows\\ Defender\\\\* AND (ProcessName:(*\\\\MpCopyAccelerator.exe OR *\\\\MsMpEng.exe))))",
            "analyze_wildcard": true
          }
