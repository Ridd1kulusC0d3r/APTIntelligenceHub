// Defrag Deactivation - Security | T1053 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2018/TA/Slingshot/win_security_apt_slingshot.yml
EventID:4701 AND TaskName:\\Microsoft\\Windows\\Defrag\\ScheduledDefrag

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "EventID:4701 AND TaskName:\\\\Microsoft\\\\Windows\\\\Defrag\\\\ScheduledDefrag",
            "analyze_wildcard": true
