// Mail Forwarding/Redirecting Activity In O365 | T1020, T1114.003, T1564.008 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/cloud/m365/audit/microsoft365_susp_email_forwarding_activity.yml
(Operation:*UpdateInboxRules* AND (OperationProperties:(*Forward* OR *Recipients*))) OR (Operation:*Set\-Mailbox* AND (Parameters:(*ForwardingSmtpAddress* OR *ForwardingAddress*))) OR ((Operation:(*New\-InboxRule* OR *Set\-InboxRule*)) AND (Parameters:(*ForwardAsAttachmentTo* OR *ForwardingAddress* OR *ForwardingSmtpAddress* OR *ForwardTo* OR *RedirectTo* OR *RedirectToRecipients*)))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(Operation:*UpdateInboxRules* AND (OperationProperties:(*Forward* OR *Recipients*))) OR (Operation:*Set\\-Mailbox* AND (Parameters:(*ForwardingSmtpAddress* OR *ForwardingAddress*))) OR ((Operation:(*New\\-InboxRule* OR *Set\\-InboxRule*)) AND (Parameters:(*ForwardAsAttachmentTo* OR *ForwardingAddress* OR *ForwardingSmtpAddress* OR *ForwardTo* OR *RedirectTo* OR *RedirectToRecipients*)))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
