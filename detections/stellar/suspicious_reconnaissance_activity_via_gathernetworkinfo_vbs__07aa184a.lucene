// Suspicious Reconnaissance Activity Via GatherNetworkInfo.VBS | T1059.005, T1615 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_gather_network_info_execution.yml
CommandLine:*gatherNetworkInfo.vbs* AND (NOT (Image:(*\\cscript.exe OR *\\wscript.exe)))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "CommandLine:*gatherNetworkInfo.vbs* AND (NOT (Image:(*\\\\cscript.exe OR *\\\\wscript.exe)))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
