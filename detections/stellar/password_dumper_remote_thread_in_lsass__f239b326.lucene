// Password Dumper Remote Thread in LSASS | T1003.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/create_remote_thread/create_remote_thread_win_susp_password_dumper_lsass.yml
TargetImage:*\\lsass.exe AND StartModule:""

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "TargetImage:*\\\\lsass.exe AND StartModule:\"\"",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
