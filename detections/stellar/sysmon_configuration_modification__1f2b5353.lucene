// Sysmon Configuration Modification | T1564 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/sysmon/sysmon_config_modification_status.yml
(State:Stopped OR *Sysmon\ config\ state\ changed*) AND (NOT State:Started)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(State:Stopped OR *Sysmon\\ config\\ state\\ changed*) AND (NOT State:Started)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
