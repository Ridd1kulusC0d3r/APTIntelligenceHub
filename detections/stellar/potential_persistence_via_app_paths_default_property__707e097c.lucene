// Potential Persistence Via App Paths Default Property | T1546.012 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_persistence_app_paths.yml
TargetObject:*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App\ Paths* AND (TargetObject:(*\(Default\) OR *Path)) AND (Details:(*\\Users\\Public* OR *\\AppData\\Local\\Temp\\* OR *\\Windows\\Temp\\* OR *\\Desktop\\* OR *\\Downloads\\* OR *%temp%* OR *%tmp%* OR *iex* OR *Invoke\-* OR *rundll32* OR *regsvr32* OR *mshta* OR *cscript* OR *wscript* OR *.bat* OR *.hta* OR *.dll* OR *.ps1*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "TargetObject:*\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\App\\ Paths* AND (TargetObject:(*\\(Default\\) OR *Path)) AND (Details:(*\\\\Users\\\\Public* OR *\\\\AppData\\\\Local\\\\Temp\\\\* OR *\\\\Windows\\\\Temp\\\\* OR *\\\\Desktop\\\\* OR *\\\\Downloads\\\\* OR *%temp%* OR *%tmp%* OR *iex* OR *Invoke\\-* OR *rundll32* OR *regsvr32* OR *mshta* OR *cscript* OR *wscript* OR *.bat* OR *.hta* OR *.dll* OR *.ps1*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
