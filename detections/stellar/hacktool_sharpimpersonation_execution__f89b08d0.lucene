// HackTool - SharpImpersonation Execution | T1134.001, T1134.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_sharp_impersonation.yml
(Image:*\\SharpImpersonation.exe OR OriginalFileName:SharpImpersonation.exe) OR ((CommandLine:*\ user\:* AND CommandLine:*\ binary\:*) OR (CommandLine:*\ user\:* AND CommandLine:*\ shellcode\:*) OR (CommandLine:(*\ technique\:CreateProcessAsUserW* OR *\ technique\:ImpersonateLoggedOnuser*)))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(Image:*\\\\SharpImpersonation.exe OR OriginalFileName:SharpImpersonation.exe) OR ((CommandLine:*\\ user\\:* AND CommandLine:*\\ binary\\:*) OR (CommandLine:*\\ user\\:* AND CommandLine:*\\ shellcode\\:*) OR (CommandLine:(*\\ technique\\:CreateProcessAsUserW* OR *\\ technique\\:ImpersonateLoggedOnuser*)))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
