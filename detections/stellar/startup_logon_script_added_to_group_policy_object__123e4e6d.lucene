// Startup/Logon Script Added to Group Policy Object | T1484.001, T1547 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_susp_group_policy_startup_script_added_to_gpo.yml
(EventID:(5136 OR 5145)) AND ((((AttributeLDAPDisplayName:(gPCMachineExtensionNames OR gPCUserExtensionNames)) AND AttributeValue:*42B5FAAE\-6536\-11D2\-AE5A\-0000F87571E3*) AND (AttributeValue:(*40B6664F\-4972\-11D1\-A7CA\-0000F87571E3* OR *40B66650\-4972\-11D1\-A7CA\-0000F87571E3*))) OR (ShareName:*\\SYSVOL AND (RelativeTargetName:(*\\scripts.ini OR *\\psscripts.ini)) AND AccessList:*%%4417*))

