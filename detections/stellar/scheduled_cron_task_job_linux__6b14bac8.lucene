// Scheduled Cron Task/Job - Linux | T1053.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_schedule_task_job_cron.yml
Image:*crontab AND CommandLine:*\/tmp\/*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "Image:*crontab AND CommandLine:*\\/tmp\\/*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
