// Service Installed With Binary In Unusual Path (svchost-hosted DLL) | T1543.003 | Hub
(TargetObject:*\\Services\\* AND TargetObject:*\\Parameters\\ServiceDll) AND (NOT (Details:(C\:\\Windows\\System32\\* OR %SystemRoot%\\System32\\* OR %systemroot%\\system32\\*)))

