// VolumeShadowCopy Symlink Creation Via Mklink | T1003.002, T1003.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_cmd_mklink_shadow_copies_access_symlink.yml
CommandLine:*mklink* AND CommandLine:*HarddiskVolumeShadowCopy*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "CommandLine:*mklink* AND CommandLine:*HarddiskVolumeShadowCopy*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
