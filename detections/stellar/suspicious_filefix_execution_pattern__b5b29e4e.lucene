// Suspicious FileFix Execution Pattern | T1204.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_filefix_execution_pattern.yml
((ParentImage:(*\\brave.exe OR *\\chrome.exe OR *\\firefox.exe OR *\\msedge.exe)) AND CommandLine:*#*) AND ((CommandLine:(*%comspec%* OR *bitsadmin* OR *certutil* OR *cmd* OR *cscript* OR *curl* OR *finger* OR *mshta* OR *powershell* OR *pwsh* OR *regsvr32* OR *rundll32* OR *schtasks* OR *wget* OR *wscript*)) OR (CommandLine:(*account* OR *anti\-bot* OR *botcheck* OR *captcha* OR *challenge* OR *confirmation* OR *fraud* OR *human* OR *identification* OR *identificator* OR *identity* OR *robot* OR *validation* OR *verification* OR *verify*)))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "((ParentImage:(*\\\\brave.exe OR *\\\\chrome.exe OR *\\\\firefox.exe OR *\\\\msedge.exe)) AND CommandLine:*#*) AND ((CommandLine:(*%comspec%* OR *bitsadmin* OR *certutil* OR *cmd* OR *cscript* OR *curl* OR *finger* OR *mshta* OR *powershell* OR *pwsh* OR *regsvr32* OR *rundll32* OR *schtasks* OR *wget* OR *wscript*)) OR (CommandLine:(*account* OR *anti\\-bot* OR *botcheck* OR *captcha* OR *challenge* OR *confirmation* OR *fraud* OR *human* OR *identification* OR *identificator* OR *identity* OR *robot* OR *validation* OR *verification* OR *verify*)))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
