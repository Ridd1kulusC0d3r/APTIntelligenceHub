// Detected Windows Software Discovery | T1518 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_reg_software_discovery.yml
Image:*\\reg.exe AND (CommandLine:*query* AND CommandLine:*\\software\\* AND CommandLine:*\/v* AND CommandLine:*svcversion*)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "Image:*\\\\reg.exe AND (CommandLine:*query* AND CommandLine:*\\\\software\\\\* AND CommandLine:*\\/v* AND CommandLine:*svcversion*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
