// Suspicious Scheduled Task Write to System32 Tasks | T1053 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_task_write.yml
TargetFilename:*\\Windows\\System32\\Tasks* AND (Image:(*\\AppData\\* OR *C\:\\PerfLogs* OR *\\Windows\\System32\\config\\systemprofile*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "TargetFilename:*\\\\Windows\\\\System32\\\\Tasks* AND (Image:(*\\\\AppData\\\\* OR *C\\:\\\\PerfLogs* OR *\\\\Windows\\\\System32\\\\config\\\\systemprofile*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
