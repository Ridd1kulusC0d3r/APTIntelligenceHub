// Powershell Detect Virtualization Environment | T1497.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_detect_vm_env.yml
(ScriptBlockText:(*Get\-WmiObject* OR *gwmi*)) AND (ScriptBlockText:(*MSAcpi_ThermalZoneTemperature* OR *Win32_ComputerSystem*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(ScriptBlockText:(*Get\\-WmiObject* OR *gwmi*)) AND (ScriptBlockText:(*MSAcpi_ThermalZoneTemperature* OR *Win32_ComputerSystem*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
