// ESXi VM List Discovery Via ESXCLI | T1007, T1033, T1059.012 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_esxcli_vm_discovery.yml
Image:*\/esxcli AND CommandLine:*vm\ process* AND CommandLine:*\ list

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "Image:*\\/esxcli AND CommandLine:*vm\\ process* AND CommandLine:*\\ list",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
