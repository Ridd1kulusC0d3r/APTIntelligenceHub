// Guest Account Enabled Via Sysadminctl | T1078, T1078.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_sysadminctl_enable_guest_account.yml
Image:*\/sysadminctl AND (CommandLine:*\ \-guestAccount* AND CommandLine:*\ on*)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "Image:*\\/sysadminctl AND (CommandLine:*\\ \\-guestAccount* AND CommandLine:*\\ on*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
