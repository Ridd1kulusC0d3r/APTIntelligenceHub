{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "ScriptBlockText:(*New\\-VM* OR *Set\\-VMFirmware* OR *Start\\-VM*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
