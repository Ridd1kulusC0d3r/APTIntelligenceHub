// AWS EC2 Startup Shell Script Change | T1059.001, T1059.003, T1059.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/aws/cloudtrail/aws_ec2_startup_script_change.yml
eventSource:ec2.amazonaws.com AND requestParameters.attribute:userData AND eventName:ModifyInstanceAttribute

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "eventSource:ec2.amazonaws.com AND requestParameters.attribute:userData AND eventName:ModifyInstanceAttribute",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
