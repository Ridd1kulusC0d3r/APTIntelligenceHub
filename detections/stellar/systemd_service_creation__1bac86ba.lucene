// Systemd Service Creation | T1543.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/path/lnx_auditd_systemd_service_creation.yml
(type:PATH AND nametype:CREATE) AND ((name:(\/usr\/lib\/systemd\/system\/* OR \/etc\/systemd\/system\/*)) OR name:*\/.config\/systemd\/user\/*)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(type:PATH AND nametype:CREATE) AND ((name:(\\/usr\\/lib\\/systemd\\/system\\/* OR \\/etc\\/systemd\\/system\\/*)) OR name:*\\/.config\\/systemd\\/user\\/*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
