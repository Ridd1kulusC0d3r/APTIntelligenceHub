// AWS STS GetSessionToken Misuse | T1548, T1550, T1550.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/aws/cloudtrail/aws_sts_getsessiontoken_misuse.yml
eventSource:sts.amazonaws.com AND eventName:GetSessionToken AND userIdentity.type:IAMUser

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "eventSource:sts.amazonaws.com AND eventName:GetSessionToken AND userIdentity.type:IAMUser",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
