// Potential Persistence Via PowerShell User Profile Using Add-Content | T1546.013 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_user_profile_tampering.yml
ScriptBlockText:*Add\-Content\ $profile* AND (ScriptBlockText:(*\-Value\ \"IEX\ * OR *\-Value\ \"Invoke\-Expression* OR *\-Value\ \"Invoke\-WebRequest* OR *\-Value\ \"Start\-Process* OR *\-Value\ 'IEX\ * OR *\-Value\ 'Invoke\-Expression* OR *\-Value\ 'Invoke\-WebRequest* OR *\-Value\ 'Start\-Process*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "ScriptBlockText:*Add\\-Content\\ $profile* AND (ScriptBlockText:(*\\-Value\\ \\\"IEX\\ * OR *\\-Value\\ \\\"Invoke\\-Expression* OR *\\-Value\\ \\\"Invoke\\-WebRequest* OR *\\-Value\\ \\\"Start\\-Process* OR *\\-Value\\ 'IEX\\ * OR *\\-Value\\ 'Invoke\\-Expression* OR *\\-Value\\ 'Invoke\\-WebRequest* OR *\\-Value\\ 'Start\\-Process*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
