// Bitbucket Full Data Export Triggered | T1213.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/bitbucket/audit/bitbucket_audit_full_data_export_triggered.yml
auditType.category:"Data pipeline" AND auditType.action:"Full data export triggered"

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "auditType.category:\"Data pipeline\" AND auditType.action:\"Full data export triggered\"",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
