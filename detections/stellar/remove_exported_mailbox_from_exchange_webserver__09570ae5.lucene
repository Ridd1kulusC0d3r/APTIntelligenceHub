// Remove Exported Mailbox from Exchange Webserver | T1070 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/msexchange/win_exchange_proxyshell_remove_mailbox_export.yml
*Remove\-MailboxExportRequest* AND *\ \-Identity\ * AND *\ \-Confirm\ \"False\"*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "*Remove\\-MailboxExportRequest* AND *\\ \\-Identity\\ * AND *\\ \\-Confirm\\ \\\"False\\\"*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
