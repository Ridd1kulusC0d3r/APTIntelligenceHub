// UAC Disabled | T1548.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_uac_disable.yml
TargetObject:*\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\EnableLUA* AND Details:"DWORD \(0x00000000\)"

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "TargetObject:*\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Policies\\\\System\\\\EnableLUA* AND Details:\"DWORD \\(0x00000000\\)\"",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
