// Github Self-Hosted Runner Execution | T1071, T1102.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_github_self_hosted_runner.yml
((Image:*\\Runner.Worker.exe OR OriginalFileName:Runner.Worker.dll) AND CommandLine:*spawnclient*) OR ((Image:*\\Runner.Listener.exe OR OriginalFileName:Runner.Listener.dll) AND (CommandLine:(*run* OR *configure*)))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "((Image:*\\\\Runner.Worker.exe OR OriginalFileName:Runner.Worker.dll) AND CommandLine:*spawnclient*) OR ((Image:*\\\\Runner.Listener.exe OR OriginalFileName:Runner.Listener.dll) AND (CommandLine:(*run* OR *configure*)))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
