// Automated Collection Command PowerShell | T1119 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_automated_collection.yml
(ScriptBlockText:(*.doc* OR *.docx* OR *.xls* OR *.xlsx* OR *.ppt* OR *.pptx* OR *.rtf* OR *.pdf* OR *.txt*)) AND (ScriptBlockText:*Get\-ChildItem* AND ScriptBlockText:*\ \-Recurse\ * AND ScriptBlockText:*\ \-Include\ *)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(ScriptBlockText:(*.doc* OR *.docx* OR *.xls* OR *.xlsx* OR *.ppt* OR *.pptx* OR *.rtf* OR *.pdf* OR *.txt*)) AND (ScriptBlockText:*Get\\-ChildItem* AND ScriptBlockText:*\\ \\-Recurse\\ * AND ScriptBlockText:*\\ \\-Include\\ *)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
