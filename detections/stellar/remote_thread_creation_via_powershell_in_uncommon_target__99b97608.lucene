// Remote Thread Creation Via PowerShell In Uncommon Target | T1059.001, T1218.011 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/create_remote_thread/create_remote_thread_win_powershell_susp_targets.yml
(SourceImage:(*\\powershell.exe OR *\\pwsh.exe)) AND (TargetImage:(*\\rundll32.exe OR *\\regsvr32.exe))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(SourceImage:(*\\\\powershell.exe OR *\\\\pwsh.exe)) AND (TargetImage:(*\\\\rundll32.exe OR *\\\\regsvr32.exe))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
