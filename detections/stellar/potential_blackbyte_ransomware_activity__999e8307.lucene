// Potential BlackByte Ransomware Activity | T1059.001, T1140, T1485, T1498 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2021/Malware/BlackByte/proc_creation_win_malware_blackbyte_ransomware.yml
(Image:C\:\\Users\\Public\\* AND CommandLine:*\ \-single\ *) OR (CommandLine:(*del\ C\:\\Windows\\System32\\Taskmgr.exe* OR *;Set\-Service\ \-StartupType\ Disabled\ $* OR *powershell\ \-command\ \"$x\ \=\[System.Text.Encoding\]\:\:Unicode.GetString\(\[System.Convert\]\:\:FromBase64String\(* OR *\ do\ start\ wordpad.exe\ \/p\ *))

