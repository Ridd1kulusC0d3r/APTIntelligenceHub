// Shell Open Registry Keys Manipulation | T1546.001, T1548.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_shell_open_keys_manipulation.yml
((EventType:SetValue AND TargetObject:*Classes\\ms\-settings\\shell\\open\\command\\SymbolicLinkValue AND Details:*\\Software\\Classes\\\{*) OR TargetObject:*Classes\\ms\-settings\\shell\\open\\command\\DelegateExecute OR (EventType:SetValue AND (TargetObject:(*Classes\\ms\-settings\\shell\\open\\command\\\(Default\) OR *Classes\\exefile\\shell\\open\\command\\\(Default\))))) AND (NOT (Details:\(Empty\) OR (Details:(\{4813071a\-41ad\-44a2\-9835\-886d2f63ca30\} OR \{A56A841F\-E974\-45C1\-8001\-7E3F8A085917\} OR \{4ED3A719\-CEA8\-4BD9\-910D\-E252F997AFC2\} OR \{BFEC0C93\-0B7D\-4F2C\-B09C\-AFFFC4BDAE78\}))))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "((EventType:SetValue AND TargetObject:*Classes\\\\ms\\-settings\\\\shell\\\\open\\\\command\\\\SymbolicLinkValue AND Details:*\\\\Software\\\\Classes\\\\\\{*) OR TargetObject:*Classes\\\\ms\\-settings\\\\shell\\\\open\\\\command\\\\DelegateExecute OR (EventType:SetValue AND (TargetObject:(*Classes\\\\ms\\-settings\\\\shell\\\\open\\\\command\\\\\\(Default\\) OR *Classes\\\\exefile\\\\shell\\\\open\\\\command\\\\\\(Default\\))))) AND (NOT (Details:\\(Empty\\) OR (Details:(\\{4813071a\\-41ad\\-44a2\\-9835\\-886d2f63ca30\\} OR \\{A56A841F\\-E974\\-45C1\\-8001\\-7E3F8A085917\\} OR \\{4ED3A719\\-CEA8\\-4BD9\\-910D\\-E252F997AFC2\\} OR \\{BFEC0C93\\-0B7D\\-4F2C\\-B09C\\-AFFFC4BDAE78\\}))))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
