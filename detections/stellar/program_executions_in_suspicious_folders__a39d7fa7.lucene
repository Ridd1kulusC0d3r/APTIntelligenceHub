// Program Executions in Suspicious Folders | T1584, T1587 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/syscall/lnx_auditd_susp_exe_folders.yml
type:SYSCALL AND (exe:(\/tmp\/* OR \/var\/www\/* OR \/home\/*\/public_html\/* OR \/usr\/local\/apache2\/* OR \/usr\/local\/httpd\/* OR \/var\/apache\/* OR \/srv\/www\/* OR \/home\/httpd\/html\/* OR \/srv\/http\/* OR \/usr\/share\/nginx\/html\/* OR \/var\/lib\/pgsql\/data\/* OR \/usr\/local\/mysql\/data\/* OR \/var\/lib\/mysql\/* OR \/var\/vsftpd\/* OR \/etc\/bind\/* OR \/var\/named\/*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "type:SYSCALL AND (exe:(\\/tmp\\/* OR \\/var\\/www\\/* OR \\/home\\/*\\/public_html\\/* OR \\/usr\\/local\\/apache2\\/* OR \\/usr\\/local\\/httpd\\/* OR \\/var\\/apache\\/* OR \\/srv\\/www\\/* OR \\/home\\/httpd\\/html\\/* OR \\/srv\\/http\\/* OR \\/usr\\/share\\/nginx\\/html\\/* OR \\/var\\/lib\\/pgsql\\/data\\/* OR \\/usr\\/local\\/mysql\\/data\\/* OR \\/var\\/lib\\/mysql\\/* OR \\/var\\/vsftpd\\/* OR \\/etc\\/bind\\/* OR \\/var\\/named\\/*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
