// Credential Dumping Tools Service Execution - System | T1003.001, T1003.002, T1003.004, T1003.005, T1003.006, T1569.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/service_control_manager/win_system_mal_creddumper.yml
Provider_Name:"Service Control Manager" AND EventID:7045 AND (ImagePath:(*cachedump* OR *dumpsvc* OR *fgexec* OR *gsecdump* OR *mimidrv* OR *pwdump* OR *servpw*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "Provider_Name:\"Service Control Manager\" AND EventID:7045 AND (ImagePath:(*cachedump* OR *dumpsvc* OR *fgexec* OR *gsecdump* OR *mimidrv* OR *pwdump* OR *servpw*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
