// Session Manager Autorun Keys Modification | T1546.009, T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_asep_reg_keys_modification_session_manager.yml
TargetObject:*\\System\\CurrentControlSet\\Control\\Session\ Manager* AND (TargetObject:(*\\SetupExecute* OR *\\S0InitialCommand* OR *\\KnownDlls* OR *\\Execute* OR *\\BootExecute* OR *\\AppCertDlls*)) AND (NOT Details:\(Empty\))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "TargetObject:*\\\\System\\\\CurrentControlSet\\\\Control\\\\Session\\ Manager* AND (TargetObject:(*\\\\SetupExecute* OR *\\\\S0InitialCommand* OR *\\\\KnownDlls* OR *\\\\Execute* OR *\\\\BootExecute* OR *\\\\AppCertDlls*)) AND (NOT Details:\\(Empty\\))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
