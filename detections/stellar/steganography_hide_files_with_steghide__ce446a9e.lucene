// Steganography Hide Files with Steghide | T1027.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/execve/lnx_auditd_steghide_embed_steganography.yml
type:EXECVE AND a0:steghide AND a1:embed AND (a2:(\-cf OR \-ef)) AND (a4:(\-cf OR \-ef))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "type:EXECVE AND a0:steghide AND a1:embed AND (a2:(\\-cf OR \\-ef)) AND (a4:(\\-cf OR \\-ef))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
