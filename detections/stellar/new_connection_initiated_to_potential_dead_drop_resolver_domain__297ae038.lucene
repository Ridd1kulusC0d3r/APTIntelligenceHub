// New Connection Initiated To Potential Dead Drop Resolver Domain | T1102, T1102.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_domain_dead_drop_resolvers.yml
(Initiated:true AND (DestinationHostname:(*.t.me OR *0x0.st OR *4shared.com OR *abuse.ch OR *anonfiles.com OR *bashupload.com OR *cdn.discordapp.com OR *chunk.io OR *cloudflare.com OR *ddns.net OR *discord.com OR *docs.google.com OR *drive.google.com OR *dropbox.com OR *dropmefiles.com OR *facebook.com OR *feeds.rapidfeeds.com OR *fotolog.com OR *ghostbin.co\/ OR *githubusercontent.com OR *gofile.io OR *hastebin.com OR *imgur.com OR *livejournal.com OR *mediafire.com OR *mega.co.nz OR *mega.nz OR *onedrive.com OR *pages.dev OR *paste.ee OR *pastebin.com OR *pastebin.pl OR *pastetext.net OR *pixeldrain.com OR *privatlab.com OR *privatlab.net OR *reddit.com OR *send.exploit.in OR *sendspace.com OR *steamcommunity.com OR *storage.googleapis.com OR *technet.microsoft.com OR *temp.sh OR *transfer.sh OR *trycloudflare.com OR *twitter.com OR *ufile.io OR *vimeo.com OR *w3spaces.com OR *wetransfer.com OR *workers.dev OR *x0.at OR *youtube.com))) AND (NOT ((Image:("C\:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR "C\:\\Program Files \(x86\)\\Google\\Chrome\\Application\\chrome.exe")) OR (Image:C\:\\Users\\* AND Image:*\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe) OR (Image:("C\:\\Program Files\\Mozilla Firefox\\firefox.exe" OR "C\:\\Program Files \(x86\)\\Mozilla Firefox\\firefox.exe")) OR (Image:C\:\\Users\\* AND Image:*\\AppData\\Local\\Mozilla\ Firefox\\firefox.exe) OR (Image:("C\:\\Program Files \(x86\)\\Internet Explorer\\iexplore.exe" OR "C\:\\Program Files\\Internet Explorer\\iexplore.exe")) OR (Image:C\:\\Program\ Files\ \(x86\)\\Microsoft\\EdgeWebView\\Application\\* OR Image:*\\WindowsApps\\MicrosoftEdge.exe OR (Image:("C\:\\Program Files \(x86\)\\Microsoft\\Edge\\Application\\msedge.exe" OR "C\:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((Image:(C\:\\Program\ Files\ \(x86\)\\Microsoft\\EdgeCore\\* OR C\:\\Program\ Files\\Microsoft\\EdgeCore\\*)) AND (Image:(*\\msedge.exe OR *\\msedgewebview2.exe))) OR ((Image:(*C\:\\Program\ Files\ \(x86\)\\Safari\\* OR *C\:\\Program\ Files\\Safari\\*)) AND Image:*\\safari.exe) OR ((Image:(*C\:\\Program\ Files\\Windows\ Defender\ Advanced\ Threat\ Protection\\* OR *C\:\\Program\ Files\\Windows\ Defender\\* OR *C\:\\ProgramData\\Microsoft\\Windows\ Defender\\Platform\\*)) AND (Image:(*\\MsMpEng.exe OR *\\MsSense.exe))) OR (Image:(*C\:\\Program\ Files\ \(x86\)\\PRTG\ Network\ Monitor\\PRTG\ Probe.exe OR *C\:\\Program\ Files\\PRTG\ Network\ Monitor\\PRTG\ Probe.exe)) OR (Image:C\:\\Program\ Files\\BraveSoftware\\* AND Image:*\\brave.exe) OR (Image:*\\AppData\\Local\\Maxthon\\* AND Image:*\\maxthon.exe) OR (Image:*\\AppData\\Local\\Programs\\Opera\\* AND Image:*\\opera.exe) OR ((Image:(C\:\\Program\ Files\\SeaMonkey\\* OR C\:\\Program\ Files\ \(x86\)\\SeaMonkey\\*)) AND Image:*\\seamonkey.exe) OR (Image:*\\AppData\\Local\\Vivaldi\\* AND Image:*\\vivaldi.exe) OR ((Image:(C\:\\Program\ Files\\Naver\\Naver\ Whale\\* OR C\:\\Program\ Files\ \(x86\)\\Naver\\Naver\ Whale\\*)) AND Image:*\\whale.exe) OR ((Image:(C\:\\Program\ Files\\Waterfox\\* OR C\:\\Program\ Files\ \(x86\)\\Waterfox\\*)) AND Image:*\\Waterfox.exe) OR (Image:*\\AppData\\Local\\Programs\\midori\-ng\\* AND Image:*\\Midori\ Next\ Generation.exe) OR ((Image:(C\:\\Program\ Files\\SlimBrowser\\* OR C\:\\Program\ Files\ \(x86\)\\SlimBrowser\\*)) AND Image:*\\slimbrowser.exe) OR (Image:*\\AppData\\Local\\Flock\\* AND Image:*\\Flock.exe) OR (Image:*\\AppData\\Local\\Phoebe\\* AND Image:*\\Phoebe.exe) OR ((Image:(C\:\\Program\ Files\\Falkon\\* OR C\:\\Program\ Files\ \(x86\)\\Falkon\\*)) AND Image:*\\falkon.exe) OR ((Image:(C\:\\Program\ Files\ \(x86\)\\QtWeb\\* OR C\:\\Program\ Files\\QtWeb\\*)) AND Image:*\\QtWeb.exe) OR ((Image:(C\:\\Program\ Files\ \(x86\)\\Avant\ Browser\\* OR C\:\\Program\ Files\\Avant\ Browser\\*)) AND Image:*\\avant.exe) OR ((Image:(C\:\\Program\ Files\ \(x86\)\\WindowsApps\\* OR C\:\\Program\ Files\\WindowsApps\\*)) AND Image:*\\WhatsApp.exe AND DestinationHostname:*facebook.com) OR (Image:*\\AppData\\Roaming\\Telegram\ Desktop\\* AND Image:*\\Telegram.exe AND DestinationHostname:*.t.me) OR (Image:*\\AppData\\Local\\Microsoft\\OneDrive\\* AND Image:*\\OneDrive.exe AND DestinationHostname:*onedrive.com) OR ((Image:(C\:\\Program\ Files\ \(x86\)\\Dropbox\\Client\\* OR C\:\\Program\ Files\\Dropbox\\Client\\*)) AND (Image:(*\\Dropbox.exe OR *\\DropboxInstaller.exe)) AND DestinationHostname:*dropbox.com) OR ((Image:(*\\MEGAsync.exe OR *\\MEGAsyncSetup32_*RC.exe OR *\\MEGAsyncSetup32.exe OR *\\MEGAsyncSetup64.exe OR *\\MEGAupdater.exe)) AND (DestinationHostname:(*mega.co.nz OR *mega.nz))) OR ((Image:(*C\:\\Program\ Files\\Google\\Drive\ File\ Stream\\* OR *C\:\\Program\ Files\ \(x86\)\\Google\\Drive\ File\ Stream\\*)) AND Image:*GoogleDriveFS.exe AND DestinationHostname:*drive.google.com) OR (Image:*\\AppData\\Local\\Discord\\* AND Image:*\\Discord.exe AND (DestinationHostname:(*discord.com OR *cdn.discordapp.com))) OR (NOT _exists_:Image) OR Image:""))

