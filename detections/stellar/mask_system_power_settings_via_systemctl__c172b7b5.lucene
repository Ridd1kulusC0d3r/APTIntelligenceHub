// Mask System Power Settings Via Systemctl | T1653 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_systemctl_mask_power_settings.yml
(Image:*\/systemctl AND CommandLine:*\ mask*) AND (CommandLine:(*suspend.target* OR *hibernate.target* OR *hybrid\-sleep.target*))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(Image:*\\/systemctl AND CommandLine:*\\ mask*) AND (CommandLine:(*suspend.target* OR *hibernate.target* OR *hybrid\\-sleep.target*))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
