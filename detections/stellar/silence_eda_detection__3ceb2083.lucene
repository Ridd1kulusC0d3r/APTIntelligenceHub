// Silence.EDA Detection | T1059.001, T1071.004, T1529, T1572 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_apt_silence_eda.yml
(ScriptBlockText:*System.Diagnostics.Process* AND ScriptBlockText:*Stop\-Computer* AND ScriptBlockText:*Restart\-Computer* AND ScriptBlockText:*Exception\ in\ execution* AND ScriptBlockText:*$cmdargs* AND ScriptBlockText:*Close\-Dnscat2Tunnel*) AND (ScriptBlockText:*set\ type\=$LookupType`nserver* AND ScriptBlockText:*$Command\ \|\ nslookup\ 2\>\&1\ \|\ Out\-String* AND ScriptBlockText:*New\-RandomDNSField* AND ScriptBlockText:*\[Convert\]\:\:ToString\($SYNOptions,\ 16\)* AND ScriptBlockText:*$Session.Dead\ \=\ $True* AND ScriptBlockText:*$Session\[\"Driver\"\]\ \-eq*)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(ScriptBlockText:*System.Diagnostics.Process* AND ScriptBlockText:*Stop\\-Computer* AND ScriptBlockText:*Restart\\-Computer* AND ScriptBlockText:*Exception\\ in\\ execution* AND ScriptBlockText:*$cmdargs* AND ScriptBlockText:*Close\\-Dnscat2Tunnel*) AND (ScriptBlockText:*set\\ type\\=$LookupType`nserver* AND ScriptBlockText:*$Command\\ \\|\\ nslookup\\ 2\\>\\&1\\ \\|\\ Out\\-String* AND ScriptBlockText:*New\\-RandomDNSField* AND ScriptBlockText:*\\[Convert\\]\\:\\:ToString\\($SYNOptions,\\ 16\\)* AND ScriptBlockText:*$Session.Dead\\ \\=\\ $True* AND ScriptBlockText:*$Session\\[\\\"Driver\\\"\\]\\ \\-eq*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
