// Copy From Or To Admin Share Or Sysvol Folder | T1021.002, T1039, T1048 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_copy_lateral_movement.yml
(CommandLine:(*\\\\*\\*$* OR *\\Sysvol\\*)) AND (((Image:(*\\robocopy.exe OR *\\xcopy.exe)) OR (OriginalFileName:(robocopy.exe OR XCOPY.EXE))) OR ((Image:*\\cmd.exe OR OriginalFileName:Cmd.Exe) AND CommandLine:*copy*) OR (((Image:(*\\powershell_ise.exe* OR *\\powershell.exe* OR *\\pwsh.exe*)) OR (OriginalFileName:(powershell_ise.exe OR PowerShell.EXE OR pwsh.dll))) AND (CommandLine:(*copy\-item* OR *copy\ * OR *cpi\ * OR *\ cp\ * OR *move\ * OR *\ move\-item* OR *\ mi\ * OR *\ mv\ *))))

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "(CommandLine:(*\\\\\\\\*\\\\*$* OR *\\\\Sysvol\\\\*)) AND (((Image:(*\\\\robocopy.exe OR *\\\\xcopy.exe)) OR (OriginalFileName:(robocopy.exe OR XCOPY.EXE))) OR ((Image:*\\\\cmd.exe OR OriginalFileName:Cmd.Exe) AND CommandLine:*copy*) OR (((Image:(*\\\\powershell_ise.exe* OR *\\\\powershell.exe* OR *\\\\pwsh.exe*)) OR (OriginalFileName:(powershell_ise.exe OR PowerShell.EXE OR pwsh.dll))) AND (CommandLine:(*copy\\-item* OR *copy\\ * OR *cpi\\ * OR *\\ cp\\ * OR *move\\ * OR *\\ move\\-item* OR *\\ mi\\ * OR *\\ mv\\ *))))",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
