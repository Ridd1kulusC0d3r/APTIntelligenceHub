// HackTool - Sliver C2 Implant Activity Pattern | T1059 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_sliver_c2_execution_pattern.yml
CommandLine:*\-NoExit\ \-Command\ \[Console\]\:\:OutputEncoding\=\[Text.UTF8Encoding\]\:\:UTF8*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "CommandLine:*\\-NoExit\\ \\-Command\\ \\[Console\\]\\:\\:OutputEncoding\\=\\[Text.UTF8Encoding\\]\\:\\:UTF8*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
