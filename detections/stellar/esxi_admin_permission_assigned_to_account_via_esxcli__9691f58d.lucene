// ESXi Admin Permission Assigned To Account Via ESXCLI | T1059.012, T1098 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_esxcli_permission_change_admin.yml
Image:*\/esxcli AND CommandLine:*system* AND (CommandLine:*\ permission\ * AND CommandLine:*\ set* AND CommandLine:*Admin*)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "Image:*\\/esxcli AND CommandLine:*system* AND (CommandLine:*\\ permission\\ * AND CommandLine:*\\ set* AND CommandLine:*Admin*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
