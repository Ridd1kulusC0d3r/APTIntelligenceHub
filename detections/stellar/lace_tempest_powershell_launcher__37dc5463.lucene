// Lace Tempest PowerShell Launcher | T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/TA/Lace-Tempest/posh_ps_apt_lace_tempest_malware_launcher.yml
ScriptBlockText:*\\SysAidServer\\tomcat\\webapps* AND ScriptBlockText:*Starting\ user.exe* AND ScriptBlockText:*\\usersfiles\\user.exe* AND ScriptBlockText:*Remove\-Item\ \-Force\ \"$wapps* AND ScriptBlockText:*\(Sophos\).*

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "ScriptBlockText:*\\\\SysAidServer\\\\tomcat\\\\webapps* AND ScriptBlockText:*Starting\\ user.exe* AND ScriptBlockText:*\\\\usersfiles\\\\user.exe* AND ScriptBlockText:*Remove\\-Item\\ \\-Force\\ \\\"$wapps* AND ScriptBlockText:*\\(Sophos\\).*",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
