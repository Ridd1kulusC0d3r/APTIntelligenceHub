// Change Default File Association To Executable Via Assoc | T1546.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_cmd_assoc_tamper_exe_file_association.yml
((Image:*\\cmd.exe OR OriginalFileName:Cmd.Exe) AND (CommandLine:*assoc\ * AND CommandLine:*exefile*)) AND (NOT CommandLine:*.exe\=exefile*)

// Stellar Cyber Query Builder (DSL):
{
  "query": {
    "bool": {
      "must": [
        {
          "query_string": {
            "query": "((Image:*\\\\cmd.exe OR OriginalFileName:Cmd.Exe) AND (CommandLine:*assoc\\ * AND CommandLine:*exefile*)) AND (NOT CommandLine:*.exe\\=exefile*)",
            "analyze_wildcard": true
          }
        }
      ]
    }
  }
}
