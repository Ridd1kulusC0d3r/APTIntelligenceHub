// Potential SMB Relay Attack Tool Execution | T1557.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_relay_attacks_tools.yml
any where ((process.executable.caseless like~ ("*PetitPotam*", "*RottenPotato*", "*HotPotato*", "*JuicyPotato*", "*\\just_dce_*", "*Juicy Potato*", "*\\temp\\rot.exe*", "*\\Potato.exe*", "*\\SpoolSample.exe*", "*\\Responder.exe*", "*\\smbrelayx*", "*\\ntlmrelayx*", "*\\LocalPotato*")) or (process.command_line like~ ("*Invoke-Tater*", "* smbrelay*", "* ntlmrelay*", "*cme smb *", "* /ntlm:NTLMhash *", "*Invoke-PetitPotam*", "*.exe -t * -p *")) or (process.command_line:"*.exe -c \"{*" and process.command_line:"*}\" -z")) and (not (process.executable.caseless like~ ("*HotPotatoes6*", "*HotPotatoes7*", "*HotPotatoes *")))
