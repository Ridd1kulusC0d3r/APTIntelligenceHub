// Mail Forwarding/Redirecting Activity In O365 | T1020, T1114.003, T1564.008 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/cloud/m365/audit/microsoft365_susp_email_forwarding_activity.yml
any where (Operation:"*UpdateInboxRules*" and (OperationProperties like~ ("*Forward*", "*Recipients*"))) or (Operation:"*Set-Mailbox*" and (Parameters like~ ("*ForwardingSmtpAddress*", "*ForwardingAddress*"))) or ((Operation like~ ("*New-InboxRule*", "*Set-InboxRule*")) and (Parameters like~ ("*ForwardAsAttachmentTo*", "*ForwardingAddress*", "*ForwardingSmtpAddress*", "*ForwardTo*", "*RedirectTo*", "*RedirectToRecipients*")))
