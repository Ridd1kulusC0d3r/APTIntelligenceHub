// MSHTA Execution with Suspicious File Extensions | T1059.007, T1140, T1218.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_mshta_susp_execution.yml
any where (process.executable.caseless:"*\\mshta.exe" or process.pe.original_file_name:"mshta.exe") and (process.command_line like~ ("*.7z*", "*.avi*", "*.bat*", "*.bmp*", "*.conf*", "*.csv*", "*.dll*", "*.doc*", "*.gif*", "*.gz*", "*.ini*", "*.jpe*", "*.jpg*", "*.json*", "*.lnk*", "*.log*", "*.mkv*", "*.mp3*", "*.mp4*", "*.pdf*", "*.png*", "*.ppt*", "*.rar*", "*.rtf*", "*.svg*", "*.tar*", "*.tmp*", "*.txt*", "*.xls*", "*.xml*", "*.yaml*", "*.yml*", "*.zip*", "*vbscript*"))
