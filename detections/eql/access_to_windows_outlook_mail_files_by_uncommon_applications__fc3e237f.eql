// Access To Windows Outlook Mail Files By Uncommon Applications | T1070.008 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/file/file_access/file_access_win_office_outlook_mail_credential.yml
any where (file.path like~ ("*\\AppData\\Local\\Comms\\Unistore\\data*", "*\\AppData\\Local\\Comms\\UnistoreDB\\store.vol")) and (not (process.executable.caseless:"System" or (process.executable.caseless like~ ("C:\\Program Files (x86)\\*", "C:\\Program Files\\*", "C:\\Windows\\system32\\*", "C:\\Windows\\SysWOW64\\*")))) and (not ((process.executable.caseless:"C:\\ProgramData\\Microsoft\\Windows Defender\\*" and (process.executable.caseless like~ ("*\\MpCopyAccelerator.exe", "*\\MsMpEng.exe"))) or (process.executable.caseless like~ ("*\\thor64.exe", "*\\thor.exe"))))
