// Potential Powershell ReverseShell Connection | T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_reverse_shell_connection.yml
any where ((process.pe.original_file_name like~ ("PowerShell.EXE", "pwsh.dll")) or (process.executable.caseless like~ ("*\\powershell.exe", "*\\pwsh.exe"))) and (process.command_line:"* Net.Sockets.TCPClient*" and process.command_line:"*.GetStream(*" and process.command_line:"*.Write(*")
