// HackTool - SharpUp PrivEsc Tool Execution | T1569.002, T1574.005, T1615 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_sharpup.yml
any where process.executable.caseless:"*\\SharpUp.exe" or process.pe.description:"SharpUp" or (process.command_line like~ ("*HijackablePaths*", "*UnquotedServicePath*", "*ProcessDLLHijack*", "*ModifiableServiceBinaries*", "*ModifiableScheduledTask*", "*DomainGPPPassword*", "*CachedGPPPassword*"))
