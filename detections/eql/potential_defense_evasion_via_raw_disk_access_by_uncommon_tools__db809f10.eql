// Potential Defense Evasion Via Raw Disk Access By Uncommon Tools | T1006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/raw_access_thread/raw_access_thread_susp_disk_access_using_uncommon_tools.yml
any where (not (file.path:"*floppy*" or (process.executable.caseless like~ ("C:\\$WINDOWS.~BT\\*", "C:\\Program Files (x86)\\*", "C:\\Program Files\\*", "C:\\Windows\\CCM\\*", "C:\\Windows\\explorer.exe*", "C:\\Windows\\servicing\\*", "C:\\Windows\\SoftwareDistribution\\*", "C:\\Windows\\System32\\*", "C:\\Windows\\SystemApps\\*", "C:\\Windows\\SysWOW64\\*", "C:\\Windows\\uus\\*", "C:\\Windows\\WinSxS\\*")) or (process.executable.caseless like~ ("Registry", "System")) or (process.executable.caseless:"C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*" and (process.executable.caseless like~ ("*\\MsMpEng.exe", "*\\MpDefenderCoreService.exe"))) or (process.executable.caseless:"C:\\Users\\*" and (process.executable.caseless:"*\\AppData\\*" and process.executable.caseless:"*\\Microsoft\\*")) or (process.executable.caseless:"C:\\Windows\\Temp\\*" and (process.executable.caseless like~ ("*\\Executables\\SSDUpdate.exe", "*\\HostMetadata\\NVMEHostmetadata.exe"))) or (?process.executable.caseless == null) or process.executable.caseless:"C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe" or process.executable.caseless:"C:\\$WinREAgent\\Scratch\\*")) and (not ((process.executable.caseless:"C:\\Users\\*" and process.executable.caseless:"*\\AppData\\Local\\GitHubDesktop\\app-*" and process.executable.caseless:"*\\resources\\app\\git\\mingw64\\bin\\git.exe") or (process.executable.caseless:"C:\\Windows\\Temp\\asgard2-agent\\*" and process.executable.caseless:"*\\thor.exe") or (process.executable.caseless:"C:\\Users\\*" and process.executable.caseless:"*\\AppData\\Local\\Keybase\\upd.exe*")))
