// Sofacy Trojan Loader Activity | T1059.003, T1218.011 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2018/TA/APT28/proc_creation_win_apt_sofacy.yml
any where ((process.executable.caseless:"*\\rundll32.exe" and (process.command_line like~ ("*%LOCALAPPDATA%*", "*\\AppData\\Local\\*"))) and (process.command_line:"*.dat\",*" or (process.command_line like~ ("*.dll #1", "*.dll\" #1", "*.dll\",#1")))) and (not process.command_line:"*\\AppData\\Local\\Temp\\*")
