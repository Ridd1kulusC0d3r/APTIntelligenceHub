// Possible PetitPotam Coerce Authentication Attempt | T1187 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_petitpotam_network_share.yml
any where winlog.channel:"Security" and (event.code:"5145" and winlog.event_data.ShareName:"\\\\*" and winlog.event_data.ShareName:"*\\IPC$" and winlog.event_data.RelativeTargetName:"lsarpc" and user.name:"ANONYMOUS LOGON")
