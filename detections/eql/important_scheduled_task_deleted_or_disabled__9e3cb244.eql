// Important Scheduled Task Deleted or Disabled | T1489 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/taskscheduler/win_taskscheduler_susp_schtasks_delete_or_disable.yml
any where winlog.channel:"Microsoft-Windows-TaskScheduler/Operational" and (((event.code like~ ("141", "142")) and (winlog.event_data.TaskName like~ ("*\\Windows\\SystemRestore\\SR*", "*\\Windows\\Windows Defender\\*", "*\\Windows\\BitLocker*", "*\\Windows\\WindowsBackup\\*", "*\\Windows\\WindowsUpdate\\*", "*\\Windows\\UpdateOrchestrator\\*", "*\\Windows\\ExploitGuard*"))) and (not (winlog.event_data.UserName like~ ("*AUTHORI*", "*AUTORI*"))))
