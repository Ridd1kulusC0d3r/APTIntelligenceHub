// Suspicious SYSTEM User Process Creation | T1003, T1027, T1134 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_system_user_anomaly.yml
any where (((winlog.event_data.IntegrityLevel like~ ("System", "S-1-16-16384")) and (user.name like~ ("*AUTHORI*", "*AUTORI*"))) and ((process.executable.caseless like~ ("*\\calc.exe", "*\\cscript.exe", "*\\forfiles.exe", "*\\hh.exe", "*\\mshta.exe", "*\\ping.exe", "*\\wscript.exe")) or process.command_line regex~ "net\\s+user\\s+" or (process.command_line like~ ("* -NoP *", "* -W Hidden *", "* -decode *", "* /decode *", "* /urlcache *", "* -urlcache *", "* -e* JAB*", "* -e* SUVYI*", "* -e* SQBFAFgA*", "* -e* aWV4I*", "* -e* IAB*", "* -e* PAA*", "* -e* aQBlAHgA*", "*vssadmin delete shadows*", "*reg SAVE HKLM*", "* -ma *", "*Microsoft\\Windows\\CurrentVersion\\Run*", "*.downloadstring(*", "*.downloadfile(*", "* /ticket:*", "*dpapi::*", "*event::clear*", "*event::drop*", "*id::modify*", "*kerberos::*", "*lsadump::*", "*misc::*", "*privilege::*", "*rpc::*", "*sekurlsa::*", "*sid::*", "*token::*", "*vault::cred*", "*vault::list*", "* p::d *", "*;iex(*", "*MiniDump*")))) and (not ((process.command_line:"*ping*" and process.command_line:"*127.0.0.1*" and process.command_line:"* -n *") or (process.executable.caseless:"*\\PING.EXE" and process.parent.command_line:"*\\DismFoDInstall.cmd*") or process.parent.executable.caseless:"*:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\*" or ((process.parent.executable.caseless like~ ("*:\\Program Files (x86)\\Java\\*", "*:\\Program Files\\Java\\*")) and process.parent.executable.caseless:"*\\bin\\javaws.exe" and (process.executable.caseless like~ ("*:\\Program Files (x86)\\Java\\*", "*:\\Program Files\\Java\\*")) and process.executable.caseless:"*\\bin\\jp2launcher.exe" and process.command_line:"* -ma *")))
