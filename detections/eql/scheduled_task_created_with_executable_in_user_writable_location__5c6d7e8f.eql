// Scheduled Task Created With Executable In User-Writable Location | T1053.005 | Hub
any where (process.executable.caseless:"*\\schtasks.exe" and process.command_line:"*/create*") and (process.command_line like~ ("*\\AppData\\*", "*\\ProgramData\\*", "*\\Users\\Public\\*", "*%APPDATA%*", "*%PROGRAMDATA%*"))
