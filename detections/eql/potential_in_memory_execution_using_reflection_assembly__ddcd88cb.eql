// Potential In-Memory Execution Using Reflection.Assembly | T1620 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_dotnet_assembly_from_file.yml
any where powershell.file.script_block_text:"*[Reflection.Assembly]::load*" and (not ((winlog.event_data.Path like~ ("C:\\Program Files (x86)\\Microsoft SQL Server\\*", "C:\\Program Files\\Microsoft SQL Server\\*")) and winlog.event_data.Path:"*\\Tools\\PowerShell\\Modules\\SQLPS\\SqlPsPostScript.ps1" and powershell.file.script_block_text:"*SQLSERVER: { Set-Location*"))
