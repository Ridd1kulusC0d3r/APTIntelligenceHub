// Potential Remote PowerShell Session Initiated | T1021.006, T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_susp_remote_powershell_session.yml
any where ((destination.port like~ (5985, 5986)) and network.direction:"true" and winlog.event_data.SourceIsIpv6:"false") and (not (((user.name like~ ("*NETWORK SERVICE*", "*NETZWERKDIENST*", "*SERVICIO DE RED*", "*SERVIZIO DI RETE*")) or (user.name:"*SERVICE R*" and user.name:"*SEAU*")) or ((source.ip like~ ("::1", "127.0.0.1")) and (destination.ip like~ ("::1", "127.0.0.1"))))) and (not (process.executable.caseless like~ ("C:\\Program Files\\Avast Software\\Avast\\AvastSvc.exe", "C:\\Program Files (x86)\\Avast Software\\Avast\\AvastSvc.exe")))
