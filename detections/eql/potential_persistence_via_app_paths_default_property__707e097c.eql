// Potential Persistence Via App Paths Default Property | T1546.012 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_persistence_app_paths.yml
any where registry.path:"*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths*" and (registry.path like~ ("*(Default)", "*Path")) and (winlog.event_data.Details like~ ("*\\Users\\Public*", "*\\AppData\\Local\\Temp\\*", "*\\Windows\\Temp\\*", "*\\Desktop\\*", "*\\Downloads\\*", "*%temp%*", "*%tmp%*", "*iex*", "*Invoke-*", "*rundll32*", "*regsvr32*", "*mshta*", "*cscript*", "*wscript*", "*.bat*", "*.hta*", "*.dll*", "*.ps1*"))
