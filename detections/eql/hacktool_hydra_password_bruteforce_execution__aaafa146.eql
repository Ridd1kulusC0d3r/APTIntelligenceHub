// HackTool - Hydra Password Bruteforce Execution | T1110, T1110.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_hydra.yml
any where (process.command_line:"*-u *" and process.command_line:"*-p *") and (process.command_line like~ ("*^USER^*", "*^PASS^*"))
