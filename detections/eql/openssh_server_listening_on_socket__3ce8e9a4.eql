// OpenSSH Server Listening On Socket | T1021.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/openssh/win_sshd_openssh_server_listening_on_socket.yml
any where winlog.channel:"OpenSSH/Operational" and (event.code:"4" and winlog.event_data.process:"sshd" and winlog.event_data.payload:"Server listening on *")
