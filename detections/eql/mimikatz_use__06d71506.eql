// Mimikatz Use | T1003.001, T1003.002, T1003.004, T1003.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/win_alert_mimikatz_keywords.yml
any where ("dpapi::masterkey" or "eo.oe.kiwi" or "event::clear" or "event::drop" or "gentilkiwi.com" or "kerberos::golden" or "kerberos::ptc" or "kerberos::ptt" or "kerberos::tgt" or "Kiwi Legit Printer" or "lsadump::" or "mimidrv.sys" or "\\mimilib.dll" or "misc::printnightmare" or "misc::shadowcopies" or "misc::skeleton" or "privilege::backup" or "privilege::debug" or "privilege::driver" or "sekurlsa::") and (not event.code:"15")
