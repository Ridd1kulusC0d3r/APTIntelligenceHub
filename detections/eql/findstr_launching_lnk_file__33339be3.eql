// Findstr Launching .lnk File | T1027.003, T1036, T1202 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_findstr_lnk.yml
any where ((process.executable.caseless like~ ("*\\find.exe", "*\\findstr.exe")) or (process.pe.original_file_name like~ ("FIND.EXE", "FINDSTR.EXE"))) and (process.command_line like~ ("*.lnk", "*.lnk\"", "*.lnk'"))
