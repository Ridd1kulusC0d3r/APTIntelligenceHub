// Potential Ryuk Ransomware Activity | T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/Malware/Ryuk/proc_creation_win_malware_ryuk.yml
any where (process.command_line:"*Microsoft\\Windows\\CurrentVersion\\Run*" and process.command_line:"*C:\\users\\Public\\*") or (process.command_line:"*del /s /f /q c:\\*" and process.command_line:"*\*.bac*" and process.command_line:"*\*.bak*" and process.command_line:"*\*.bkf*") or ((process.executable.caseless like~ ("*\\net.exe", "*\\net1.exe")) and (process.command_line:"* stop *" and process.command_line:"* /y*") and (process.command_line like~ ("*samss*", "*audioendpointbuilder*", "*unistoresvc_*", "*AcrSch2Svc*")))
