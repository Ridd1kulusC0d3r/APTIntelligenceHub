// Google Cloud Kubernetes Admission Controller | T1078, T1552, T1552.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/gcp/audit/gcp_kubernetes_admission_controller.yml
any where gcp.audit.method_name:"admissionregistration.k8s.io.v*" and (gcp.audit.method_name like~ ("*.mutatingwebhookconfigurations.*", "*.validatingwebhookconfigurations.*")) and (gcp.audit.method_name like~ ("*create", "*patch", "*replace"))
