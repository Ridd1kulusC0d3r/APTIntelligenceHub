// Visual Studio Code Tunnel Execution | T1071.001, T1219 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_vscode_tunnel_execution.yml
any where ((?process.pe.original_file_name == null) and process.command_line:"*.exe tunnel") or (process.command_line:"*.exe tunnel*" and process.command_line:"*--accept-server-license-terms*") or (process.parent.command_line:"* tunnel" and process.executable.caseless:"*\\cmd.exe" and (process.command_line:"*/d /c *" and process.command_line:"*\\servers\\Stable-*" and process.command_line:"*code-server.cmd*"))
