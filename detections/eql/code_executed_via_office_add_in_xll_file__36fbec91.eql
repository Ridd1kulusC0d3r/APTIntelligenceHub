// Code Executed Via Office Add-in XLL File | T1137.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_office_comobject_registerxll.yml
any where powershell.file.script_block_text:"*new-object *" and powershell.file.script_block_text:"*-ComObject *" and powershell.file.script_block_text:"*.application*" and powershell.file.script_block_text:"*.RegisterXLL*"
