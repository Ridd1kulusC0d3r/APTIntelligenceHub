// Suspicious Invoke-Item From Mount-DiskImage | T1553.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_run_from_mount_diskimage.yml
any where powershell.file.script_block_text:"*Mount-DiskImage *" and powershell.file.script_block_text:"*-ImagePath *" and powershell.file.script_block_text:"*Get-Volume*" and powershell.file.script_block_text:"*.DriveLetter*" and powershell.file.script_block_text:"*invoke-item *" and powershell.file.script_block_text:"*):\\*"
