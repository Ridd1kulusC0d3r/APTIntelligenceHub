// Rundll32 Registered COM Objects | T1546.015 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_rundll32_registered_com_objects.yml
any where (process.executable.caseless:"*\\rundll32.exe" or process.pe.original_file_name:"RUNDLL32.EXE") and ((process.command_line like~ ("*-sta *", "*-localserver *")) and (process.command_line:"*{*" and process.command_line:"*}*"))
