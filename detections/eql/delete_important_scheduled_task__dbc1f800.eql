// Delete Important Scheduled Task | T1489 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_schtasks_delete.yml
any where (process.executable.caseless:"*\\schtasks.exe" or process.pe.original_file_name:"schtasks.exe") and process.command_line like~ ("*-delete*", "*/delete*", "*–delete*", "*—delete*", "*―delete*") and (process.command_line like~ ("*\\Windows\\BitLocker*", "*\\Windows\\ExploitGuard*", "*\\Windows\\SystemRestore\\SR*", "*\\Windows\\UpdateOrchestrator\\*", "*\\Windows\\Windows Defender\\*", "*\\Windows\\WindowsBackup\\*", "*\\Windows\\WindowsUpdate\\*"))
