// Copy From Or To Admin Share Or Sysvol Folder | T1021.002, T1039, T1048 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_copy_lateral_movement.yml
any where (process.command_line like~ ("*\\\\*\\*$*", "*\\Sysvol\\*")) and (((process.executable.caseless like~ ("*\\robocopy.exe", "*\\xcopy.exe")) or (process.pe.original_file_name like~ ("robocopy.exe", "XCOPY.EXE"))) or ((process.executable.caseless:"*\\cmd.exe" or process.pe.original_file_name:"Cmd.Exe") and process.command_line:"*copy*") or (((process.executable.caseless like~ ("*\\powershell_ise.exe*", "*\\powershell.exe*", "*\\pwsh.exe*")) or (process.pe.original_file_name like~ ("powershell_ise.exe", "PowerShell.EXE", "pwsh.dll"))) and (process.command_line like~ ("*copy-item*", "*copy *", "*cpi *", "* cp *", "*move *", "* move-item*", "* mi *", "* mv *"))))
