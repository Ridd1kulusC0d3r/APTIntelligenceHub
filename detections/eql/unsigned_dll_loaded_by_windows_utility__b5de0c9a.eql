// Unsigned DLL Loaded by Windows Utility | T1218.010, T1218.011 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/image_load/image_load_susp_unsigned_dll.yml
any where (process.executable.caseless like~ ("*\\InstallUtil.exe", "*\\RegAsm.exe", "*\\RegSvcs.exe", "*\\regsvr32.exe", "*\\rundll32.exe")) and (not (file.code_signature.signed:"true" or (file.code_signature.status like~ ("errorChaining", "errorCode_endpoint", "errorExpired", "trusted", "Valid")) or (?file.code_signature.signed == null) or (file.code_signature.signed like~ ("", "-")) or (?file.code_signature.status == null) or (file.code_signature.status like~ ("", "-")) or ((process.executable.caseless like~ ("C:\\Windows\\SysWOW64\\rundll32.exe", "C:\\Windows\\System32\\rundll32.exe")) and file.path:"C:\\Windows\\Installer\\*" and (file.path like~ ("*.tmp-\\Microsoft.Deployment.WindowsInstaller.dll", "*.tmp-\\Avira.OE.Setup.CustomActions.dll"))) or ((process.executable.caseless like~ ("C:\\Windows\\SysWOW64\\*", "C:\\Windows\\System32\\*", "C:\\Windows\\Microsoft.NET\\Framework64*")) and process.executable.caseless:"*\\RegAsm.exe" and file.path:"*.dll" and file.path:"C:\\Windows\\assembly\\NativeImages*"))) and (not ((process.executable.caseless like~ ("C:\\Windows\\SysWOW64\\regsvr32.exe", "C:\\Windows\\System32\\regsvr32.exe")) and (file.path like~ ("C:\\Program Files (x86)\\K-Lite Codec Pack\\*", "C:\\Program Files\\K-Lite Codec Pack\\*"))))
