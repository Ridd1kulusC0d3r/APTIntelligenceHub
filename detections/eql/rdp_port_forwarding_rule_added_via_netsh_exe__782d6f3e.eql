// RDP Port Forwarding Rule Added Via Netsh.EXE | T1090 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_netsh_port_forwarding_3389.yml
any where (process.executable.caseless:"*\\netsh.exe" or process.pe.original_file_name:"netsh.exe") and (process.command_line:"* i*" and process.command_line:"* p*" and process.command_line:"*=3389*" and process.command_line:"* c*")
