// Shadow Copies Deletion Using Operating Systems Utilities | T1070, T1490 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_shadow_copies_deletion.yml
any where (((process.executable.caseless like~ ("*\\powershell.exe", "*\\pwsh.exe", "*\\wmic.exe", "*\\vssadmin.exe", "*\\diskshadow.exe")) or (process.pe.original_file_name like~ ("PowerShell.EXE", "pwsh.dll", "wmic.exe", "VSSADMIN.EXE", "diskshadow.exe"))) and (process.command_line:"*shadow*" and process.command_line:"*delete*")) or ((process.executable.caseless:"*\\wbadmin.exe" or process.pe.original_file_name:"WBADMIN.EXE") and (process.command_line:"*delete*" and process.command_line:"*catalog*" and process.command_line:"*quiet*")) or ((process.executable.caseless:"*\\vssadmin.exe" or process.pe.original_file_name:"VSSADMIN.EXE") and ((process.command_line:"*resize*" and process.command_line:"*shadowstorage*") and (process.command_line like~ ("*unbounded*", "*/MaxSize=*"))))
