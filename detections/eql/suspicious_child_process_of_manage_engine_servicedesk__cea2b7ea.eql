// Suspicious Child Process Of Manage Engine ServiceDesk | T1102 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_java_manageengine_susp_child_process.yml
any where ((process.parent.executable.caseless:"*\\ManageEngine\\ServiceDesk\\*" and process.parent.executable.caseless:"*\\java.exe*") and (process.executable.caseless like~ ("*\\AppVLP.exe", "*\\bash.exe", "*\\bitsadmin.exe", "*\\calc.exe", "*\\certutil.exe", "*\\cscript.exe", "*\\curl.exe", "*\\forfiles.exe", "*\\mftrace.exe", "*\\mshta.exe", "*\\net.exe", "*\\net1.exe", "*\\notepad.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\query.exe", "*\\reg.exe", "*\\schtasks.exe", "*\\scrcons.exe", "*\\sh.exe", "*\\systeminfo.exe", "*\\whoami.exe", "*\\wmic.exe", "*\\wscript.exe"))) and (not ((process.executable.caseless like~ ("*\\net.exe", "*\\net1.exe")) and process.command_line:"* stop*"))
