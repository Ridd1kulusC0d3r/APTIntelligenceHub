// Custom File Open Handler Executes PowerShell | T1202 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_custom_file_open_handler_powershell_execution.yml
any where registry.path:"*shell\\open\\command\\*" and (winlog.event_data.Details:"*powershell*" and winlog.event_data.Details:"*-command*")
