// Suspicious Invoke-WebRequest Execution | T1105 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_invoke_webrequest_download.yml
any where ((process.executable.caseless like~ ("*\\powershell_ise.exe", "*\\powershell.exe", "*\\pwsh.exe")) or (process.pe.original_file_name like~ ("powershell_ise.EXE", "PowerShell.EXE", "pwsh.dll"))) and (process.command_line like~ ("*curl *", "*Invoke-WebRequest*", "*iwr *", "*wget *")) and (process.command_line like~ ("* -ur*", "* -o*")) and (process.command_line like~ ("*\\AppData\\*", "*\\Desktop\\*", "*\\Temp\\*", "*\\Users\\Public\\*", "*%AppData%*", "*%Public%*", "*%Temp%*", "*%tmp%*", "*:\\Windows\\*"))
