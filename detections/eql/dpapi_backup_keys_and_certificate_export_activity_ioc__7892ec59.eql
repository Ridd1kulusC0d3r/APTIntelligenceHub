// DPAPI Backup Keys And Certificate Export Activity IOC | T1552.004, T1555 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_dpapi_backup_and_cert_export_ioc.yml
any where (file.path like~ ("*ntds_capi_*", "*ntds_legacy_*", "*ntds_unknown_*")) and (file.path like~ ("*.cer", "*.key", "*.pfx", "*.pvk"))
