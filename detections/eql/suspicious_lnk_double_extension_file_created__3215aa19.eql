// Suspicious LNK Double Extension File Created | T1036.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_lnk_double_extension.yml
any where (file.path:"*.lnk" and (file.path like~ ("*.doc.*", "*.docx.*", "*.jpg.*", "*.pdf.*", "*.ppt.*", "*.pptx.*", "*.xls.*", "*.xlsx.*"))) and (not file.path:"*\\AppData\\Roaming\\Microsoft\\Windows\\Recent\\*") and (not (((process.executable.caseless like~ ("*\\excel.exe", "*\\powerpnt.exe", "*\\winword.exe")) and file.path:"*\\AppData\\Roaming\\Microsoft\\Office\\Recent\\*") or (process.executable.caseless:"*\\excel.exe" and file.path:"*\\AppData\\Roaming\\Microsoft\\Excel*") or (process.executable.caseless:"*\\powerpnt.exe" and file.path:"*\\AppData\\Roaming\\Microsoft\\PowerPoint*") or (process.executable.caseless:"*\\winword.exe" and file.path:"*\\AppData\\Roaming\\Microsoft\\Word*")))
