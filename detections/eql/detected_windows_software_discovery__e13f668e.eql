// Detected Windows Software Discovery | T1518 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_reg_software_discovery.yml
any where process.executable.caseless:"*\\reg.exe" and (process.command_line:"*query*" and process.command_line:"*\\software\\*" and process.command_line:"*/v*" and process.command_line:"*svcversion*")
