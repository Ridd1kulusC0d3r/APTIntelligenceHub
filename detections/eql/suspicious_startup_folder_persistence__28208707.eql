// Suspicious Startup Folder Persistence | T1204.002, T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_startup_folder_persistence.yml
any where file.path:"*\\Windows\\Start Menu\\Programs\\Startup\\*" and (file.path like~ ("*.bat", "*.cmd", "*.dll", "*.hta", "*.jar", "*.js", "*.jse", "*.msi", "*.ps1", "*.psd1", "*.psm1", "*.scr", "*.url", "*.vba", "*.vbe", "*.vbs", "*.wsf"))
