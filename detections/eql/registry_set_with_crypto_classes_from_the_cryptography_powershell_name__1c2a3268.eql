// Registry Set With Crypto-Classes From The "Cryptography" PowerShell Namespace | T1027.010, T1059.001, T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/registry/registry_set/registry_set_powershell_crypto_namespace.yml
any where registry.path:"*\\Shell\\Open\\Command*" and (winlog.event_data.Details like~ ("*powershell*", "*pwsh*")) and winlog.event_data.Details:"*System.Security.Cryptography.*" and (winlog.event_data.Details like~ ("*.AesCryptoServiceProvider*", "*.DESCryptoServiceProvider*", "*.DSACryptoServiceProvider*", "*.RC2CryptoServiceProvider*", "*.Rijndael*", "*.RSACryptoServiceProvider*", "*.TripleDESCryptoServiceProvider*"))
