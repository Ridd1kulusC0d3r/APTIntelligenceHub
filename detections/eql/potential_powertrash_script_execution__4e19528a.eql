// Potential POWERTRASH Script Execution | T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/TA/FIN7/posh_ps_apt_fin7_powertrash_execution.yml
any where powershell.file.script_block_text:"*IO.Compression.DeflateStream*" and powershell.file.script_block_text:"*IO.MemoryStream*" and powershell.file.script_block_text:"*::FromBase64String*" and powershell.file.script_block_text:"*GetDelegateForFunctionPointer*" and powershell.file.script_block_text:"*.Invoke()*" and powershell.file.script_block_text:"*GlobalAssemblyCache*"
