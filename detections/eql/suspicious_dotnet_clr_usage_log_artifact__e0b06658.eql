// Suspicious DotNET CLR Usage Log Artifact | T1218 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_net_cli_artefact.yml
any where (file.path like~ ("*\\UsageLogs\\cmstp.exe.log", "*\\UsageLogs\\cscript.exe.log", "*\\UsageLogs\\mshta.exe.log", "*\\UsageLogs\\msxsl.exe.log", "*\\UsageLogs\\regsvr32.exe.log", "*\\UsageLogs\\rundll32.exe.log", "*\\UsageLogs\\svchost.exe.log", "*\\UsageLogs\\wscript.exe.log", "*\\UsageLogs\\wmic.exe.log")) and (not (process.parent.executable.caseless:"*\\MsiExec.exe" and process.parent.command_line:"* -Embedding*" and process.executable.caseless:"*\\rundll32.exe" and (winlog.event_data.CommandLine:"*Temp*" and winlog.event_data.CommandLine:"*zzzzInvokeManagedCustomActionOutOfProc*")))
