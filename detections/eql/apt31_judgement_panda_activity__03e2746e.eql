// APT31 Judgement Panda Activity | T1003.001, T1560.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/TA/APT31/proc_creation_win_apt_apt31_judgement_panda.yml
any where (process.command_line:"*ldifde*" and process.command_line:"*-f -n*" and process.command_line:"*eprod.ldf*") or ((process.command_line:"*copy \\\\*" and process.command_line:"*c$*") and (process.command_line like~ ("*\\aaaa\\procdump64.exe*", "*\\aaaa\\netsess.exe*", "*\\aaaa\\7za.exe*", "*\\c$\\aaaa\\*")))
