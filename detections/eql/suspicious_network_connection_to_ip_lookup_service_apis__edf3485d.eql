// Suspicious Network Connection to IP Lookup Service APIs | T1016 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_domain_external_ip_lookup.yml
any where ((destination.domain like~ ("www.ip.cn", "l2.io")) or (destination.domain like~ ("*api.2ip.ua*", "*api.bigdatacloud.net*", "*api.ipify.org*", "*bot.whatismyipaddress.com*", "*canireachthe.net*", "*checkip.amazonaws.com*", "*checkip.dyndns.org*", "*curlmyip.com*", "*db-ip.com*", "*edns.ip-api.com*", "*eth0.me*", "*freegeoip.app*", "*geoipy.com*", "*getip.pro*", "*icanhazip.com*", "*ident.me*", "*ifconfig.io*", "*ifconfig.me*", "*ip-api.com*", "*ip.360.cn*", "*ip.anysrc.net*", "*ip.taobao.com*", "*ip.tyk.nu*", "*ipaddressworld.com*", "*ipapi.co*", "*ipconfig.io*", "*ipecho.net*", "*ipinfo.io*", "*ipip.net*", "*ipof.in*", "*ipv4.icanhazip.com*", "*ipv4bot.whatismyipaddress.com*", "*ipv6-test.com*", "*ipwho.is*", "*jsonip.com*", "*myexternalip.com*", "*seeip.org*", "*wgetip.com*", "*whatismyip.akamai.com*", "*whois.pconline.com.cn*", "*wtfismyip.com*"))) and (not (process.executable.caseless:"*\\brave.exe" or (process.executable.caseless like~ ("C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe")) or (process.executable.caseless like~ ("C:\\Program Files\\Mozilla Firefox\\firefox.exe", "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe")) or (process.executable.caseless like~ ("C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe", "C:\\Program Files\\Internet Explorer\\iexplore.exe")) or process.executable.caseless:"*\\maxthon.exe" or (process.executable.caseless:"C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\*" or process.executable.caseless:"*\\WindowsApps\\MicrosoftEdge.exe" or (process.executable.caseless like~ ("C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe", "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) or ((process.executable.caseless like~ ("C:\\Program Files (x86)\\Microsoft\\EdgeCore\\*", "C:\\Program Files\\Microsoft\\EdgeCore\\*")) and (process.executable.caseless like~ ("*\\msedge.exe", "*\\msedgewebview2.exe"))) or process.executable.caseless:"*\\opera.exe" or process.executable.caseless:"*\\safari.exe" or process.executable.caseless:"*\\seamonkey.exe" or process.executable.caseless:"*\\vivaldi.exe" or process.executable.caseless:"*\\whale.exe"))
