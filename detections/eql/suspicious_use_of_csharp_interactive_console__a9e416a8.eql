// Suspicious Use of CSharp Interactive Console | T1127 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_csi_use_of_csharp_console.yml
any where process.executable.caseless:"*\\csi.exe" and (process.parent.executable.caseless like~ ("*\\powershell.exe", "*\\pwsh.exe", "*\\powershell_ise.exe")) and process.pe.original_file_name:"csi.exe"
