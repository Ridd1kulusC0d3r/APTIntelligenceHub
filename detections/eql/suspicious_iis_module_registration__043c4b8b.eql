// Suspicious IIS Module Registration | T1505.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_iis_susp_module_registration.yml
any where process.parent.executable.caseless:"*\\w3wp.exe" and (process.command_line:"*appcmd.exe add module*" or (process.command_line:"* system.enterpriseservices.internal.publish*" and process.executable.caseless:"*\\powershell.exe") or (process.command_line:"*gacutil*" and process.command_line:"* /I*"))
