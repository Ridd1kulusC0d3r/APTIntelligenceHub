// Unusual File Download from Direct IP Address | T1564.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/create_stream_hash/create_stream_hash_susp_ip_domains.yml
any where winlog.event_data.Contents regex~ "http[s]?:\/\/[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}" and (file.path like~ ("*.ps1:Zone*", "*.bat:Zone*", "*.exe:Zone*", "*.vbe:Zone*", "*.vbs:Zone*", "*.dll:Zone*", "*.one:Zone*", "*.cmd:Zone*", "*.hta:Zone*", "*.xll:Zone*", "*.lnk:Zone*"))
