// Allow Service Access Using Security Descriptor Tampering Via Sc.EXE | T1543.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_sc_sdset_allow_service_changes.yml
any where ((process.executable.caseless:"*\\sc.exe" or process.pe.original_file_name:"sc.exe") and (process.command_line:"*sdset*" and process.command_line:"*A;*") and (process.command_line like~ ("*;IU*", "*;SU*", "*;BA*", "*;SY*", "*;WD*"))) and (not process.parent.executable.caseless:"C:\\Hexnode\\Hexnode Agent\\Current\\HexnodeAgent.exe")
