// HackTool - Bloodhound/Sharphound Execution | T1059.001, T1069.001, T1069.002, T1087.001, T1087.002, T1482 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_bloodhound_sharphound.yml
any where (process.pe.product:"*SharpHound*" or process.pe.description:"*SharpHound*" or (process.pe.company like~ ("*SpecterOps*", "*evil corp*")) or (process.executable.caseless like~ ("*\\Bloodhound.exe*", "*\\SharpHound.exe*"))) or (process.command_line like~ ("* -CollectionMethod All *", "* --CollectionMethods Session *", "* --Loop --Loopduration *", "* --PortScanTimeout *", "*.exe -c All -d *", "*Invoke-Bloodhound*", "*Get-BloodHoundData*")) or (process.command_line:"* -JsonFolder *" and process.command_line:"* -ZipFileName *") or (process.command_line:"* DCOnly *" and process.command_line:"* --NoSaveCache *")
