// Potential Process Hollowing Activity | T1055.012 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_tampering/proc_tampering_susp_process_hollowing.yml
any where winlog.event_data.Type:"Image is replaced" and (not (process.executable.caseless like~ ("*:\\Program Files (x86)*", "*:\\Program Files\\*", "*:\\Windows\\System32\\wbem\\WMIADAP.exe*", "*:\\Windows\\SysWOW64\\wbem\\WMIADAP.exe*"))) and (not ((process.executable.caseless:"*\\AppData\\Local\\Programs\\Opera\\*" and process.executable.caseless:"*\\opera.exe") or process.executable.caseless:"*\\WindowsApps\\MicrosoftEdge.exe"))
