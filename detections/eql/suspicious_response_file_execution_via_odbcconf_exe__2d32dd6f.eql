// Suspicious Response File Execution Via Odbcconf.EXE | T1218.008 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_odbcconf_response_file_susp.yml
any where ((process.executable.caseless:"*\\odbcconf.exe" or process.pe.original_file_name:"odbcconf.exe") and process.command_line like~ ("* -f *", "* /f *", "* –f *", "* —f *", "* ―f *")) and (not (process.command_line:"*.rsp*" or (process.parent.executable.caseless:"C:\\Windows\\System32\\runonce.exe" and process.executable.caseless:"C:\\Windows\\System32\\odbcconf.exe" and process.command_line:"*.exe /E /F \"C:\\WINDOWS\\system32\\odbcconf.tmp\"*")))
