// Encoded PowerShell Spawned By Script Host | T1059.001, T1059.007 | Hub
any where (process.parent.executable.caseless like~ ("*\\wscript.exe", "*\\cscript.exe", "*\\mshta.exe")) and (process.executable.caseless:"*\\powershell.exe" and (process.command_line like~ ("* -enc*", "* -EncodedCommand*", "* -e *")))
