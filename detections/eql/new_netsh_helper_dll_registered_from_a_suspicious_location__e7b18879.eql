// New Netsh Helper DLL Registered From A Suspicious Location | T1546.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_netsh_help_dll_persistence_susp_location.yml
any where registry.path:"*\\SOFTWARE\\Microsoft\\NetSh*" and ((winlog.event_data.Details like~ ("*:\\Perflogs\\*", "*:\\Users\\Public\\*", "*:\\Windows\\Temp\\*", "*\\AppData\\Local\\Temp\\*", "*\\Temporary Internet*")) or ((winlog.event_data.Details:"*:\\Users\\*" and winlog.event_data.Details:"*\\Favorites\\*") or (winlog.event_data.Details:"*:\\Users\\*" and winlog.event_data.Details:"*\\Favourites\\*") or (winlog.event_data.Details:"*:\\Users\\*" and winlog.event_data.Details:"*\\Contacts\\*") or (winlog.event_data.Details:"*:\\Users\\*" and winlog.event_data.Details:"*\\Pictures\\*")))
