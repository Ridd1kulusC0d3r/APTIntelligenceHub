// Powershell DNSExfiltration | T1048 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_invoke_dnsexfiltration.yml
any where powershell.file.script_block_text:"*Invoke-DNSExfiltrator*" or (powershell.file.script_block_text:"* -i *" and powershell.file.script_block_text:"* -d *" and powershell.file.script_block_text:"* -p *" and powershell.file.script_block_text:"* -doh *" and powershell.file.script_block_text:"* -t *")
