// Use of W32tm as Timer | T1124 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_w32tm.yml
any where (process.executable.caseless:"*\\w32tm.exe" or process.pe.original_file_name:"w32time.dll") and (process.command_line:"*/stripchart*" and process.command_line:"*/computer:*" and process.command_line:"*/period:*" and process.command_line:"*/dataonly*" and process.command_line:"*/samples:*")
