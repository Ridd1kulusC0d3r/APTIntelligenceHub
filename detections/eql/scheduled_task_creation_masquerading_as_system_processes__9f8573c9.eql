// Scheduled Task Creation Masquerading as System Processes | T1036.004, T1036.005, T1053.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_schtasks_system_process.yml
any where (process.executable.caseless:"*\\schtasks.exe" or process.pe.original_file_name:"schtasks.exe") and (process.command_line like~ ("* -create *", "* /create *", "* –create *", "* —create *", "* ―create *") and (process.command_line like~ ("* audiodg*", "* conhost*", "* dwm.exe*", "* explorer*", "* lsass*", "* lsm*", "* mmc*", "* msiexec*", "* regsvr32*", "* rundll32*", "* services*", "* spoolsv*", "* svchost*", "* taskeng*", "* taskhost*", "* wininit*", "* winlogon*")))
