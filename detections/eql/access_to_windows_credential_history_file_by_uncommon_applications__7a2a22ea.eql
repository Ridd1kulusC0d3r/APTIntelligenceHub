// Access To Windows Credential History File By Uncommon Applications | T1555.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_access/file_access_win_susp_credhist.yml
any where file.path:"*\\Microsoft\\Protect\\CREDHIST" and (not ((process.executable.caseless like~ ("C:\\Program Files\\*", "C:\\Program Files (x86)\\*", "C:\\Windows\\system32\\*", "C:\\Windows\\SysWOW64\\*")) or process.executable.caseless:"C:\\Windows\\explorer.exe"))
