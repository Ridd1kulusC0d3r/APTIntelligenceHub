// Discovery of a System Time | T1124 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_remote_time_discovery.yml
any where ((process.executable.caseless like~ ("*\\net.exe", "*\\net1.exe")) and process.command_line:"*time*") or (process.executable.caseless:"*\\w32tm.exe" and process.command_line:"*tz*")
