// Suspicious Active Directory Database Snapshot Via ADExplorer | T1069.002, T1087.002, T1482 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_sysinternals_adexplorer_susp_execution.yml
any where ((process.executable.caseless like~ ("*\\ADExp.exe", "*\\ADExplorer.exe", "*\\ADExplorer64.exe", "*\\ADExplorer64a.exe")) or process.pe.original_file_name:"AdExp" or process.pe.description:"Active Directory Editor" or process.pe.product:"Sysinternals ADExplorer") and process.command_line:"*snapshot*" and (process.command_line like~ ("*\\Downloads\\*", "*\\Users\\Public\\*", "*\\AppData\\*", "*\\Windows\\Temp\\*"))
