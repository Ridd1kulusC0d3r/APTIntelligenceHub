// Access To Potentially Sensitive Sysvol Files By Uncommon Applications | T1552.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_access/file_access_win_susp_gpo_files.yml
any where (file.path:"\\*" and (file.path:"*\\sysvol\\*" and file.path:"*\\Policies\\*") and (file.path like~ ("*audit.csv", "*Files.xml", "*GptTmpl.inf", "*groups.xml", "*Registry.pol", "*Registry.xml", "*scheduledtasks.xml", "*scripts.ini", "*services.xml"))) and (not ((process.executable.caseless like~ ("C:\\Program Files (x86)\\*", "C:\\Program Files\\*", "C:\\Windows\\system32\\*", "C:\\Windows\\SysWOW64\\*")) or process.executable.caseless:"C:\\Windows\\explorer.exe"))
