// Potential WinAPI Calls Via PowerShell Scripts | T1059.001, T1106, T1620 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_win_api_susp_access.yml
any where (powershell.file.script_block_text:"*VirtualAlloc*" and powershell.file.script_block_text:"*OpenProcess*" and powershell.file.script_block_text:"*WriteProcessMemory*" and powershell.file.script_block_text:"*CreateRemoteThread*") or (powershell.file.script_block_text:"*OpenProcessToken*" and powershell.file.script_block_text:"*LookupPrivilegeValue*" and powershell.file.script_block_text:"*AdjustTokenPrivileges*") or (powershell.file.script_block_text:"*OpenProcessToken*" and powershell.file.script_block_text:"*DuplicateTokenEx*" and powershell.file.script_block_text:"*CloseHandle*") or (powershell.file.script_block_text:"*WriteProcessMemory*" and powershell.file.script_block_text:"*VirtualAlloc*" and powershell.file.script_block_text:"*ReadProcessMemory*" and powershell.file.script_block_text:"*VirtualFree*") or (powershell.file.script_block_text:"*VirtualAlloc*" and powershell.file.script_block_text:"*GetDelegateForFunctionPointer*" and powershell.file.script_block_text:"*Marshal.Copy*")
