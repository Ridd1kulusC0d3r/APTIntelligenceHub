// Suspicious Child Process Created as System | T1134.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_child_process_as_system_.yml
any where ((winlog.event_data.ParentUser like~ ("*AUTHORI*", "*AUTORI*")) and (winlog.event_data.ParentUser like~ ("*\\NETWORK SERVICE", "*\\LOCAL SERVICE")) and (user.name like~ ("*AUTHORI*", "*AUTORI*")) and (user.name like~ ("*\\SYSTEM", "*\\Système", "*\\СИСТЕМА")) and (winlog.event_data.IntegrityLevel like~ ("System", "S-1-16-16384"))) and (not (process.executable.caseless:"*\\rundll32.exe" and process.command_line:"*DavSetCookie*"))
