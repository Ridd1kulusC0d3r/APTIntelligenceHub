// HackTool - SharpDPAPI Execution | T1134.001, T1134.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_sharp_dpapi_execution.yml
any where (process.executable.caseless:"*\\SharpDPAPI.exe" or process.pe.original_file_name:"SharpDPAPI.exe") or ((process.command_line like~ ("* backupkey *", "* blob *", "* certificates *", "* credentials *", "* keepass *", "* masterkeys *", "* rdg *", "* vaults *")) and ((process.command_line:"* {*" and process.command_line:"*}:*") or (process.command_line like~ ("* /file:*", "* /machine*", "* /mkfile:*", "* /password:*", "* /pvk:*", "* /server:*", "* /target:*", "* /unprotect*"))))
