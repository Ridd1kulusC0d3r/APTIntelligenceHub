// Access To Windows DPAPI Master Keys By Uncommon Applications | T1555.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_access/file_access_win_susp_dpapi_master_key_access.yml
any where (file.path like~ ("*\\Microsoft\\Protect\\S-1-5-18\\*", "*\\Microsoft\\Protect\\S-1-5-21-*")) and (not ((process.executable.caseless like~ ("C:\\Program Files\\*", "C:\\Program Files (x86)\\*", "C:\\Windows\\system32\\*", "C:\\Windows\\SysWOW64\\*")) or process.executable.caseless:"C:\\Windows\\explorer.exe"))
