// Chmod Targeting Sensitive Directories | T1222.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_chmod_targeting_sensitive_directories.yml
any where (Image:"*/chmod" and (CommandLine like~ ("*/tmp/*", "*/.Library/*", "*/etc/*", "*/opt/*"))) and (not ((CommandLine:"*chmod --reference=/etc/shells*" and ParentCommandLine:"*/update-shells") or (CommandLine:"*/etc/*" and (ParentCommandLine:"*/var/lib/dpkg/info/*" and ParentCommandLine:"*.postinst configure*")) or CommandLine:"chmod 700 /tmp/apt-key-gpghome.*" or CommandLine:"chmod 755 /var/tmp/mkinitramfs*" or CommandLine:"chmod 0775 /etc/landscape/" or CommandLine:"chmod 644 /etc/apparmor.d/tunables/home.d/ubuntu"))
