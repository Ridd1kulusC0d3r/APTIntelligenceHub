// ADFS Database Named Pipe Connection By Uncommon Tool | T1005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/pipe_created/pipe_created_adfs_namedpipe_connection_uncommon_tool.yml
any where file.name:"\\MICROSOFT##WID\\tsql\\query" and (not (process.executable.caseless like~ ("*:\\Windows\\System32\\mmc.exe", "*:\\Windows\\system32\\svchost.exe", "*:\\Windows\\System32\\wsmprovhost.exe", "*:\\Windows\\SysWOW64\\mmc.exe", "*:\\Windows\\SysWOW64\\wsmprovhost.exe", "*:\\Windows\\WID\\Binn\\sqlwriter.exe", "*\\AzureADConnect.exe", "*\\Microsoft.Identity.Health.Adfs.PshSurrogate.exe", "*\\Microsoft.IdentityServer.ServiceHost.exe", "*\\Microsoft.Tri.Sensor.exe", "*\\sqlservr.exe", "*\\tssdis.exe")))
