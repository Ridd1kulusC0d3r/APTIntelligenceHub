// Console CodePage Lookup Via CHCP | T1614.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_chcp_codepage_lookup.yml
any where process.parent.executable.caseless:"*\\cmd.exe" and (process.parent.command_line like~ ("* -c *", "* /c *", "* –c *", "* —c *", "* ―c *") or process.parent.command_line like~ ("* -r *", "* /r *", "* –r *", "* —r *", "* ―r *") or process.parent.command_line like~ ("* -k *", "* /k *", "* –k *", "* —k *", "* ―k *")) and process.executable.caseless:"*\\chcp.com" and (process.command_line like~ ("*chcp", "*chcp ", "*chcp  "))
