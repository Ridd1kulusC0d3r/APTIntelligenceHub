// Suspicious NTLM Authentication on the Printer Spooler Service | T1212 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_rundll32_ntlmrelay.yml
any where (process.executable.caseless:"*\\rundll32.exe" or process.pe.original_file_name:"RUNDLL32.EXE") and ((process.command_line:"*C:\\windows\\system32\\davclnt.dll,DavSetCookie*" and process.command_line:"*http*") and (process.command_line like~ ("*spoolss*", "*srvsvc*", "*/print/pipe/*")))
