// Suspicious PowerShell WindowStyle Option | T1564.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_susp_windowstyle.yml
any where (powershell.file.script_block_text:"*powershell*" and powershell.file.script_block_text:"*WindowStyle*" and powershell.file.script_block_text:"*Hidden*") and (not (powershell.file.script_block_text:"*:\\Program Files\\Amazon\\WorkSpacesConfig\\Scripts\\*" and powershell.file.script_block_text:"*$PSScriptRoot\\Module\\WorkspaceScriptModule\\WorkspaceScriptModule*"))
