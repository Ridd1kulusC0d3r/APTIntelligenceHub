// PUA - Seatbelt Execution | T1083, T1087, T1526 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_pua_seatbelt.yml
any where (process.executable.caseless:"*\\Seatbelt.exe" or process.pe.original_file_name:"Seatbelt.exe" or process.pe.description:"Seatbelt" or (process.command_line like~ ("* DpapiMasterKeys*", "* InterestingProcesses*", "* InterestingFiles*", "* CertificateThumbprints*", "* ChromiumBookmarks*", "* ChromiumHistory*", "* ChromiumPresence*", "* CloudCredentials*", "* CredEnum*", "* CredGuard*", "* FirefoxHistory*", "* ProcessCreationEvents*"))) or ((process.command_line like~ ("* -group=misc*", "* -group=remote*", "* -group=chromium*", "* -group=slack*", "* -group=system*", "* -group=user*", "* -group=all*")) and process.command_line:"* -outputfile=*")
