// Suspicious Eventlog Clearing or Configuration Change Activity | T1685.001, T1685.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_eventlog_clear.yml
any where (((process.executable.caseless:"*\\wevtutil.exe" or process.pe.original_file_name:"wevtutil.exe") and (process.command_line like~ ("*clear-log *", "* cl *", "*set-log *", "* sl *", "*lfn:*"))) or ((process.executable.caseless like~ ("*\\powershell.exe", "*\\powershell_ise.exe", "*\\pwsh.exe")) and ((process.command_line like~ ("*Clear-EventLog *", "*Remove-EventLog *", "*Limit-EventLog *", "*Clear-WinEvent *")) or (process.command_line:"*Eventing.Reader.EventLogSession*" and process.command_line:"*ClearLog*") or (process.command_line:"*Diagnostics.EventLog*" and process.command_line:"*Clear*"))) or ((process.executable.caseless like~ ("*\\powershell.exe", "*\\powershell_ise.exe", "*\\pwsh.exe", "*\\wmic.exe")) and process.command_line:"*ClearEventLog*")) and (not ((process.parent.executable.caseless like~ ("C:\\Windows\\SysWOW64\\msiexec.exe", "C:\\Windows\\System32\\msiexec.exe")) and process.command_line:"* sl *"))
