// Potential Persistence Via Powershell Search Order Hijacking - Task | T1053.005, T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_schtasks_powershell_persistence.yml
any where process.parent.executable.caseless:"C:\\WINDOWS\\System32\\svchost.exe" and (process.parent.command_line:"*-k netsvcs*" and process.parent.command_line:"*-s Schedule*") and (process.command_line like~ ("* -windowstyle hidden", "* -w hidden", "* -ep bypass", "* -noni"))
