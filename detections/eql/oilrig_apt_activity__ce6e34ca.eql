// OilRig APT Activity | T1053.005, T1071.004, T1112, T1543.003 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2018/TA/OilRig/proc_creation_win_apt_oilrig_mar18.yml
any where (process.command_line:"*SC Scheduled Scan*" and process.command_line:"*\\microsoft\\Taskbar\\autoit3.exe*") or (process.executable.caseless:"*\\Windows\\Temp\\DB\\*" and process.executable.caseless:"*.exe") or (process.executable.caseless:"C:\\Windows\\system32\\Service.exe" and (process.command_line like~ ("*i*", "*u*"))) or (process.parent.executable.caseless:"*\\local\\microsoft\\Taskbar\\autoit3.exe" and (process.command_line:"*nslookup.exe*" and process.command_line:"*-q=TXT*"))
