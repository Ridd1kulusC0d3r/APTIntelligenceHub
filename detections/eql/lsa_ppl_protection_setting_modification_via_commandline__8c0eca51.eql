// LSA PPL Protection Setting Modification via CommandLine | T1689 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_lsa_ppl_protection_setting_modification_via_cli.yml
any where ((process.executable.caseless like~ ("*\\reg.exe", "*\\powershell.exe", "*\\pwsh.exe")) or (process.pe.original_file_name like~ ("reg.exe", "powershell.exe", "pwsh.dll"))) and ((process.command_line:"*ControlSet*" and process.command_line:"*\\Control\\Lsa*") and (process.command_line like~ ("*Set-ItemProperty*", "*New-ItemProperty*", "* add *"))) and (process.command_line like~ ("*IsPplAutoEnabled*", "*RunAsPPL*", "*RunAsPPLBoot*"))
