// Powershell Detect Virtualization Environment | T1497.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_detect_vm_env.yml
any where (powershell.file.script_block_text like~ ("*Get-WmiObject*", "*gwmi*")) and (powershell.file.script_block_text like~ ("*MSAcpi_ThermalZoneTemperature*", "*Win32_ComputerSystem*"))
