// Renamed ProcDump Execution | T1036.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_renamed_sysinternals_procdump.yml
any where (process.pe.original_file_name:"procdump" or ((process.command_line like~ ("* -ma *", "* /ma *", "* –ma *", "* —ma *", "* ―ma *") or process.command_line like~ ("* -mp *", "* /mp *", "* –mp *", "* —mp *", "* ―mp *")) and process.command_line like~ ("* -accepteula*", "* /accepteula*", "* –accepteula*", "* —accepteula*", "* ―accepteula*"))) and (not (process.executable.caseless like~ ("*\\procdump.exe", "*\\procdump64.exe", "*\\procdump64a.exe")))
