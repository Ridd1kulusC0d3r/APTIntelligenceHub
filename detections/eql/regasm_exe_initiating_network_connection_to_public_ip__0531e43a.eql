// RegAsm.EXE Initiating Network Connection To Public IP | T1218.009 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_regasm_network_activity.yml
any where (network.direction:"true" and process.executable.caseless:"*\\regasm.exe") and (not (cidrMatch(destination.ip, "127.0.0.0/8") or cidrMatch(destination.ip, "10.0.0.0/8") or cidrMatch(destination.ip, "172.16.0.0/12") or cidrMatch(destination.ip, "192.168.0.0/16") or cidrMatch(destination.ip, "169.254.0.0/16") or cidrMatch(destination.ip, "::1/128") or cidrMatch(destination.ip, "fe80::/10") or cidrMatch(destination.ip, "fc00::/7")))
