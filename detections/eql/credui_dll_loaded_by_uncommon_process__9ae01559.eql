// CredUI.DLL Loaded By Uncommon Process | T1056.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/image_load/image_load_dll_credui_uncommon_process_load.yml
any where ((file.path like~ ("*\\credui.dll", "*\\wincredui.dll")) or (file.pe.original_file_name like~ ("credui.dll", "wincredui.dll"))) and (not ((process.executable.caseless like~ ("C:\\Program Files (x86)\\*", "C:\\Program Files\\*", "C:\\Windows\\System32\\*", "C:\\Windows\\SysWOW64\\*", "C:\\Windows\\SystemApps\\*")) or (process.executable.caseless like~ ("C:\\Windows\\explorer.exe", "C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe", "C:\\Windows\\regedit.exe")))) and (not (process.executable.caseless:"*\\opera_autoupdate.exe" or (process.executable.caseless like~ ("*\\procexp64.exe", "*\\procexp64a.exe", "*\\procexp.exe")) or (process.executable.caseless:"C:\\Users\\*" and process.executable.caseless:"*\\AppData\\Local\\Microsoft\\Teams\\*" and process.executable.caseless:"*\\Teams.exe") or (process.executable.caseless:"C:\\Users\\*" and process.executable.caseless:"*\\AppData\\Local\\Microsoft\\OneDrive\\*")))
