// SQLite Firefox Profile Data DB Access | T1005, T1539 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_sqlite_firefox_gecko_profile_data.yml
any where (process.pe.product:"SQLite" or (process.executable.caseless like~ ("*\\sqlite.exe", "*\\sqlite3.exe"))) and (process.command_line like~ ("*cookies.sqlite*", "*places.sqlite*"))
