// WScript or CScript Dropper - File | T1059.005, T1059.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_cscript_wscript_dropper.yml
any where (process.executable.caseless like~ ("*\\wscript.exe", "*\\cscript.exe")) and (file.path like~ ("*:\\Perflogs\\*", "*:\\ProgramData\\*", "*:\\Temp\\*", "*:\\Tmp\\*", "*:\\Users\\*", "*:\\Windows\\Temp\\*", "*\\AppData\\Local\\Temp*", "*\\AppData\\Roaming\\Temp*", "*\\Start Menu\\Programs\\Startup\\*", "*\\Temporary Internet*")) and (file.path like~ ("*.js", "*.jse", "*.vba", "*.vbe", "*.vbs", "*.wsf", "*.wsh"))
