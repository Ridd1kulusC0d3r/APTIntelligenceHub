// GUI Input Capture - macOS | T1056.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_gui_input_capture.yml
any where Image:"*/osascript" and (CommandLine:"*-e*" and CommandLine:"*display*" and CommandLine:"*dialog*" and CommandLine:"*answer*") and (CommandLine like~ ("*admin*", "*administrator*", "*authenticate*", "*authentication*", "*credentials*", "*pass*", "*password*", "*unlock*"))
