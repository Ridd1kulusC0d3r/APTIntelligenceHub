// PUA - Advanced IP/Port Scanner Update Check | T1590 | https://github.com/SigmaHQ/sigma/blob/master/rules/web/proxy_generic/proxy_pua_advanced_ip_scanner_update_check.yml
any where c-uri:"*/checkupdate.php*" and (c-uri-query:"*lng=*" and c-uri-query:"*ver=*" and c-uri-query:"*beta=*" and c-uri-query:"*type=*" and c-uri-query:"*rmode=*" and c-uri-query:"*product=*")
