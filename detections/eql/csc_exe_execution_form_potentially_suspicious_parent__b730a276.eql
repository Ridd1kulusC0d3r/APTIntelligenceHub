// Csc.EXE Execution Form Potentially Suspicious Parent | T1027.004, T1059.005, T1059.007, T1218.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_csc_susp_parent.yml
any where (process.executable.caseless:"*\\csc.exe" or process.pe.original_file_name:"csc.exe") and ((process.parent.executable.caseless like~ ("*\\cscript.exe", "*\\excel.exe", "*\\mshta.exe", "*\\onenote.exe", "*\\outlook.exe", "*\\powerpnt.exe", "*\\winword.exe", "*\\wscript.exe")) or ((process.parent.executable.caseless like~ ("*\\powershell.exe", "*\\pwsh.exe")) and (process.parent.command_line like~ ("*-Encoded *", "*FromBase64String*"))) or (process.parent.command_line regex~ "(?:[Pp]rogram[Dd]ata|%(?:[Ll]ocal)?[Aa]pp[Dd]ata%|\\\\[Aa]pp[Dd]ata\\\\(?:[Ll]ocal(?:[Ll]ow)?|[Rr]oaming))\\\\[^\\\\]{1,256}$" or (process.parent.command_line like~ ("*:\\PerfLogs\\*", "*:\\Users\\Public\\*", "*:\\Windows\\Temp\\*", "*\\Temporary Internet*")) or (process.parent.command_line:"*:\\Users\\*" and process.parent.command_line:"*\\Favorites\\*") or (process.parent.command_line:"*:\\Users\\*" and process.parent.command_line:"*\\Favourites\\*") or (process.parent.command_line:"*:\\Users\\*" and process.parent.command_line:"*\\Contacts\\*") or (process.parent.command_line:"*:\\Users\\*" and process.parent.command_line:"*\\Pictures\\*"))) and (not ((process.parent.executable.caseless like~ ("C:\\Program Files (x86)\\*", "C:\\Program Files\\*")) or process.parent.executable.caseless:"C:\\Windows\\System32\\sdiagnhost.exe" or process.parent.executable.caseless:"C:\\Windows\\System32\\inetsrv\\w3wp.exe")) and (not (process.parent.executable.caseless:"C:\\ProgramData\\chocolatey\\choco.exe" or process.parent.command_line:"*\\ProgramData\\Microsoft\\Windows Defender Advanced Threat Protection*" or (process.parent.command_line like~ ("*JwB7ACIAZgBhAGkAbABlAGQAIgA6AHQAcgB1AGUALAAiAG0AcwBnACIAOgAiAEEAbgBzAGkAYgBsAGUAIAByAGUAcQB1AGkAcgBlAHMAIABQAG8AdwBlAHIAUwBoAGUAbABsACAAdgAzAC4AMAAgAG8AcgAgAG4AZQB3AGUAcgAiAH0AJw*", "*cAewAiAGYAYQBpAGwAZQBkACIAOgB0AHIAdQBlACwAIgBtAHMAZwAiADoAIgBBAG4AcwBpAGIAbABlACAAcgBlAHEAdQBpAHIAZQBzACAAUABvAHcAZQByAFMAaABlAGwAbAAgAHYAMwAuADAAIABvAHIAIABuAGUAdwBlAHIAIgB9ACcA*", "*nAHsAIgBmAGEAaQBsAGUAZAAiADoAdAByAHUAZQAsACIAbQBzAGcAIgA6ACIAQQBuAHMAaQBiAGwAZQAgAHIAZQBxAHUAaQByAGUAcwAgAFAAbwB3AGUAcgBTAGgAZQBsAGwAIAB2ADMALgAwACAAbwByACAAbgBlAHcAZQByACIAfQAnA*"))))
