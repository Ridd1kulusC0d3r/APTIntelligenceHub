// Potentially Suspicious Desktop Background Change Using Reg.EXE | T1112, T1491.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_reg_desktop_background_change.yml
any where ((process.executable.caseless:"*\\reg.exe" or process.pe.original_file_name:"reg.exe") and process.command_line:"*add*") and (process.command_line like~ ("*Control Panel\\Desktop*", "*CurrentVersion\\Policies\\ActiveDesktop*", "*CurrentVersion\\Policies\\System*")) and ((process.command_line:"*/v NoChangingWallpaper*" and process.command_line:"*/d 1*") or (process.command_line:"*/v Wallpaper*" and process.command_line:"*/t REG_SZ*") or (process.command_line:"*/v WallpaperStyle*" and process.command_line:"*/d 2*"))
