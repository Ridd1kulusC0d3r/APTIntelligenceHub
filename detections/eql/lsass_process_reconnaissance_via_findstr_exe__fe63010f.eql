// LSASS Process Reconnaissance Via Findstr.EXE | T1552.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_findstr_lsass.yml
any where (((process.executable.caseless like~ ("*\\find.exe", "*\\findstr.exe")) or (process.pe.original_file_name like~ ("FIND.EXE", "FINDSTR.EXE"))) and process.command_line:"*lsass*") or (process.command_line like~ ("* -i \"lsass*", "* /i \"lsass*", "* –i \"lsass*", "* —i \"lsass*", "* ―i \"lsass*") or process.command_line like~ ("* -i lsass.exe*", "* /i lsass.exe*", "* –i lsass.exe*", "* —i lsass.exe*", "* ―i lsass.exe*") or process.command_line like~ ("*findstr \"lsass*") or process.command_line like~ ("*findstr lsass*") or process.command_line like~ ("*findstr.exe \"lsass*") or process.command_line like~ ("*findstr.exe lsass*"))
