// Malicious Usage Of IMDS Credentials Outside Of AWS Infrastructure | T1078, T1078.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/aws/cloudtrail/aws_cloudtrail_imds_malicious_usage.yml
any where userIdentity.arn regex~ ".+:assumed-role\/aws:.+" and (not (eventSource:"ssm.amazonaws.com" or eventName:"RegisterManagedInstance" or sourceIPAddress:"AWS Internal"))
