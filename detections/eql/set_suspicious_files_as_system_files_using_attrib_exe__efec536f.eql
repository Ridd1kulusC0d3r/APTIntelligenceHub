// Set Suspicious Files as System Files Using Attrib.EXE | T1564.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_attrib_system_susp_paths.yml
any where ((process.executable.caseless:"*\\attrib.exe" or process.pe.original_file_name:"ATTRIB.EXE") and process.command_line:"* +s*" and (process.command_line like~ ("* %*", "*\\Users\\Public\\*", "*\\AppData\\Local\\*", "*\\ProgramData\\*", "*\\Downloads\\*", "*\\Windows\\Temp\\*")) and (process.command_line like~ ("*.bat*", "*.dll*", "*.exe*", "*.hta*", "*.ps1*", "*.vbe*", "*.vbs*"))) and (not (process.command_line:"*\\Windows\\TEMP\\*" and process.command_line:"*.exe*"))
