// Findstr GPP Passwords | T1552.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_findstr_gpp_passwords.yml
any where ((process.executable.caseless like~ ("*\\find.exe", "*\\findstr.exe")) or (process.pe.original_file_name like~ ("FIND.EXE", "FINDSTR.EXE"))) and (process.command_line:"*cpassword*" and process.command_line:"*\\sysvol\\*" and process.command_line:"*.xml*")
