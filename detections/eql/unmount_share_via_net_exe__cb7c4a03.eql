// Unmount Share Via Net.EXE | T1070.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_net_share_unmount.yml
any where ((process.executable.caseless like~ ("*\\net.exe", "*\\net1.exe")) or (process.pe.original_file_name like~ ("net.exe", "net1.exe"))) and (process.command_line:"*share*" and process.command_line:"*/delete*")
