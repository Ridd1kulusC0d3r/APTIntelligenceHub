// AWS SecurityHub Findings Evasion | T1685 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/aws/cloudtrail/aws_securityhub_finding_evasion.yml
any where eventSource:"securityhub.amazonaws.com" and (eventName like~ ("BatchUpdateFindings", "DeleteInsight", "UpdateFindings", "UpdateInsight"))
