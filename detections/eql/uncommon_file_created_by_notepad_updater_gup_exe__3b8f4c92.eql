// Uncommon File Created by Notepad++ Updater Gup.EXE | T1195.002, T1557 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_gup_uncommon_file_creation.yml
any where process.executable.caseless:"*\\gup.exe" and (not ((file.path like~ ("C:\\Program Files\\Notepad++\\*", "C:\\Program Files (x86)\\Notepad++\\*")) or (file.path:"C:\\Users\\*" and (file.path:"*\\AppData\\Local\\Temp\\*" and file.path:"*npp.*" and file.path:"*.Installer.*" and file.path:"*.exe*")) or (file.path:"C:\\Users\\*" and (file.path:"*\\AppData\\Local\\Temp\\*" and file.path:"*.zip*")) or file.path:"C:\\$Recycle.Bin\\S-1-5-21*" or ((file.path like~ ("*\\plugins\\JsonTools\\testfiles\\*", "*\\Notepad++\\plugins\\ComparePlugin\\*")) or (file.path:"*npp.*" and file.path:"*.portable.*" and file.path:"*\\plugins\\*"))))
