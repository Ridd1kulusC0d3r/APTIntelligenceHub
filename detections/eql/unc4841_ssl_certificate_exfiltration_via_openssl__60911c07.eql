// UNC4841 - SSL Certificate Exfiltration Via Openssl | T1140 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/TA/UNC4841-Barracuda-ESG-Zero-Day-Exploitation/proc_creation_lnx_apt_unc4841_openssl_connection.yml
any where Image:"*/openssl" and CommandLine regex~ "[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}" and (CommandLine:"*s_client*" and CommandLine:"*-quiet*" and CommandLine:"*-connect*") and (CommandLine like~ ("*:443*", "*:8080*"))
