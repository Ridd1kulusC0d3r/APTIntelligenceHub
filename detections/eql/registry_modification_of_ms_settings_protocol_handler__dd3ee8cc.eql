// Registry Modification of MS-settings Protocol Handler | T1112, T1546.001, T1548.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_registry_modification_of_ms_setting_protocol_handler.yml
any where (((process.executable.caseless:"*\\reg.exe" or process.pe.original_file_name:"reg.exe") and process.command_line:"*add*") or (((process.executable.caseless like~ ("*\\powershell.exe", "*\\pwsh.exe")) or (process.pe.original_file_name like~ ("powershell.exe", "pwsh.dll"))) and (process.command_line like~ ("*New-ItemProperty*", "*Set-ItemProperty*", "*ni *", "*sp *")))) and process.command_line:"*\\ms-settings\\shell\\open\\command*"
