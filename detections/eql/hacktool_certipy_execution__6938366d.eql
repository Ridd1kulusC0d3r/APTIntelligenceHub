// HackTool - Certipy Execution | T1649 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_certipy.yml
any where (process.executable.caseless:"*\\Certipy.exe" or process.pe.original_file_name:"Certipy.exe" or process.pe.description:"*Certipy*") or ((process.command_line like~ ("* account *", "* auth *", "* cert *", "* find *", "* forge *", "* ptt *", "* relay *", "* req *", "* shadow *", "* template *")) and (process.command_line like~ ("* -bloodhound*", "* -ca-pfx *", "* -dc-ip *", "* -kirbi*", "* -old-bloodhound*", "* -pfx *", "* -target*", "* -template*", "* -username *", "* -vulnerable*", "*auth -pfx*", "*shadow auto*", "*shadow list*")))
