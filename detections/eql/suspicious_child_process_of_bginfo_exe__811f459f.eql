// Suspicious Child Process Of BgInfo.EXE | T1059.005, T1202, T1218 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_bginfo_suspicious_child_process.yml
any where (process.parent.executable.caseless like~ ("*\\bginfo.exe", "*\\bginfo64.exe")) and ((process.executable.caseless like~ ("*\\calc.exe", "*\\cmd.exe", "*\\cscript.exe", "*\\mshta.exe", "*\\notepad.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\wscript.exe")) or (process.executable.caseless like~ ("*\\AppData\\Local\\*", "*\\AppData\\Roaming\\*", "*:\\Users\\Public\\*", "*:\\Temp\\*", "*:\\Windows\\Temp\\*", "*:\\PerfLogs\\*")))
