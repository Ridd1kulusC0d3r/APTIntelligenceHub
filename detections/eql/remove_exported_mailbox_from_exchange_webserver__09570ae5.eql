// Remove Exported Mailbox from Exchange Webserver | T1070 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/msexchange/win_exchange_proxyshell_remove_mailbox_export.yml
any where winlog.channel:"MSExchange Management" and ("Remove-MailboxExportRequest" and " -Identity " and " -Confirm \"False\"")
