// DNS Query to External Service Interaction Domains | T1190, T1595.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/dns/net_dns_external_service_interaction_domains.yml
any where ((query like~ ("*.burpcollaborator.net", "*.canarytokens.com", "*.ceye.io", "*.ddns.1443.eu.org", "*.ddns.bypass.eu.org", "*.ddns.xn--gg8h.eu.org", "*.digimg.store", "*.dns.su18.org", "*.dnshook.site", "*.dnslog.cn", "*.dnslog.ink", "*.gobygo.net", "*.instances.httpworkbench.com", "*.interact.sh", "*.log.dnslog.pp.ua", "*.log.dnslog.qzz.io", "*.log.dnslogs.dpdns.org", "*.log.javaweb.org", "*.log.nat.cloudns.ph", "*.oast.fun", "*.oast.live", "*.oast.me", "*.oast.online", "*.oast.pro", "*.oast.site", "*.oastify.com", "*.p8.lol", "*.requestbin.net", "*.requestrepo.com")) or query:"requestrepo.com") and (not query:"*polling.oastify.com*")
