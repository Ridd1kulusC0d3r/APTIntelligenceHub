// Privilege Escalation via Named Pipe Impersonation | T1021 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_priv_escalation_via_named_pipe.yml
any where ((process.executable.caseless like~ ("*\\cmd.exe", "*\\powershell.exe")) or (process.pe.original_file_name like~ ("Cmd.Exe", "PowerShell.EXE"))) and (process.command_line:"*echo*" and process.command_line:"*>*" and process.command_line:"*\\\\.\\pipe\\*")
