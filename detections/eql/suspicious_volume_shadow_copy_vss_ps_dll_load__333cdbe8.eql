// Suspicious Volume Shadow Copy VSS_PS.dll Load | T1490 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/image_load/image_load_dll_vss_ps_susp_load.yml
any where file.path:"*\\vss_ps.dll" and (not ((process.executable.caseless:"C:\\Windows\\*" and (process.executable.caseless like~ ("*\\clussvc.exe", "*\\dismhost.exe", "*\\dllhost.exe", "*\\inetsrv\\appcmd.exe", "*\\inetsrv\\iissetup.exe", "*\\msiexec.exe", "*\\rundll32.exe", "*\\searchindexer.exe", "*\\srtasks.exe", "*\\svchost.exe", "*\\System32\\SystemPropertiesAdvanced.exe", "*\\taskhostw.exe", "*\\thor.exe", "*\\thor64.exe", "*\\tiworker.exe", "*\\vssvc.exe", "*\\vssadmin.exe", "*\\WmiPrvSE.exe", "*\\wsmprovhost.exe"))) or (winlog.event_data.CommandLine:"C:\\$WinREAgent\\Scratch\\*" and winlog.event_data.CommandLine:"*\\dismhost.exe {*") or (?process.executable.caseless == null))) and (not (process.executable.caseless like~ ("C:\\Program Files\\*", "C:\\Program Files (x86)\\*")))
