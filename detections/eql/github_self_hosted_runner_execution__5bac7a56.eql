// Github Self-Hosted Runner Execution | T1071, T1102.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_github_self_hosted_runner.yml
any where ((process.executable.caseless:"*\\Runner.Worker.exe" or process.pe.original_file_name:"Runner.Worker.dll") and process.command_line:"*spawnclient*") or ((process.executable.caseless:"*\\Runner.Listener.exe" or process.pe.original_file_name:"Runner.Listener.dll") and (process.command_line like~ ("*run*", "*configure*")))
