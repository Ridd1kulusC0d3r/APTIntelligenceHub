// PUA - Rclone Execution | T1567.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_pua_rclone_execution.yml
any where (process.command_line:"*--config *" and process.command_line:"*--no-check-certificate *" and process.command_line:"* copy *") or ((process.executable.caseless:"*\\rclone.exe" or process.pe.description:"Rsync for cloud storage") and (process.command_line like~ ("*pass*", "*user*", "*copy*", "*sync*", "*config*", "*lsd*", "*remote*", "*ls*", "*mega*", "*pcloud*", "*ftp*", "*ignore-existing*", "*auto-confirm*", "*transfers*", "*multi-thread-streams*", "*no-check-certificate *")))
