// Suspicious Double Extension Files | T1036.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_double_extension.yml
any where (file.path regex~ "(?i)\\.(docx?|gif|jpe?g|mp3|mp4|pdf|png|pptx?|rtf|svg|txt|xlsx?)\\.(bat|exe|iso|rar|svg|vbe|vbs|zip)$" or (file.path like~ ("*.rar.exe", "*.zip.exe"))) and (not (file.path like~ ("*.svg.svg", "*.png.svg", "*.jpg.svg", "*.jpeg.svg"))) and (not file.path:"/usr/share/icons/*")
