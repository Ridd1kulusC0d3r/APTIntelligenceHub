// Potential Dridex Activity | T1033, T1055, T1135 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/Malware/Dridex/proc_creation_win_malware_dridex.yml
any where ((process.executable.caseless:"*\\svchost.exe" and (process.command_line:"*C:\\Users\\*" and process.command_line:"*\\Desktop\\*")) and (not process.parent.executable.caseless:"C:\\Windows\\System32\\*")) or ((process.parent.executable.caseless:"*\\excel.exe" and process.executable.caseless:"*\\regsvr32.exe" and (process.command_line like~ ("* -s *", "*\\AppData\\Local\\Temp\\*"))) and (not process.command_line:"*.dll*")) or (process.parent.executable.caseless:"*\\svchost.exe" and ((process.executable.caseless:"*\\whoami.exe" and process.command_line:"* /all*") or ((process.executable.caseless like~ ("*\\net.exe", "*\\net1.exe")) and process.command_line:"* view*")))
