// Uncommon File Created In Office Startup Folder | T1587.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_office_uncommon_file_startup.yml
any where (((file.path:"*\\Microsoft\\Word\\STARTUP*" or (file.path:"*\\Office*" and file.path:"*\\Program Files*" and file.path:"*\\STARTUP*")) and (not (file.path like~ ("*.docb", "*.docm", "*.docx", "*.dotm", "*.mdb", "*.mdw", "*.pdf", "*.wll", "*.wwl")))) or ((file.path:"*\\Microsoft\\Excel\\XLSTART*" or (file.path:"*\\Office*" and file.path:"*\\Program Files*" and file.path:"*\\XLSTART*")) and (not (file.path like~ ("*.xll", "*.xls", "*.xlsm", "*.xlsx", "*.xlt", "*.xltm", "*.xlw"))))) and (not ((process.executable.caseless:"*:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\*" and process.executable.caseless:"*\\OfficeClickToRun.exe") or ((process.executable.caseless like~ ("*:\\Program Files\\Microsoft Office\\*", "*:\\Program Files (x86)\\Microsoft Office\\*")) and (process.executable.caseless like~ ("*\\winword.exe", "*\\excel.exe")))))
