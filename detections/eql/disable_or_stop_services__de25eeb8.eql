// Disable Or Stop Services | T1489, T1685 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_services_stop_and_disable.yml
any where ((Image like~ ("*/service", "*/systemctl", "*/chkconfig")) and (CommandLine like~ ("* stop *", "* disable *"))) and (not ((Image:"*/systemctl" and (CommandLine like~ ("*--no-reload disable snap-snapd-*", "* stop snap-snapd-*"))) or (Image:"*/systemctl" and ParentCommandLine:"*tmp.ci/preinst upgrade*" and (CommandLine:"* stop *" and CommandLine:"*ssh.*")) or (ParentCommandLine:"*/dpkg/info/ubuntu-pro-client.prerm upgrade*" and Image:"*/systemctl"))) and (not (Image:"*/systemctl" and CommandLine:"*snap.amazon-ssm-agent.amazon-ssm-agent.service"))
