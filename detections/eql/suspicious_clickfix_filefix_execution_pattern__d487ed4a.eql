// Suspicious ClickFix/FileFix Execution Pattern | T1204.001, T1204.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_clickfix_filefix_execution.yml
any where (process.parent.executable.caseless:"*\\explorer.exe" and process.command_line:"*#*") and (process.command_line like~ ("*account*", "*anti-bot*", "*botcheck*", "*captcha*", "*challenge*", "*confirmation*", "*fraud*", "*human*", "*identification*", "*identificator*", "*identity*", "*robot*", "*validation*", "*verification*", "*verify*"))
