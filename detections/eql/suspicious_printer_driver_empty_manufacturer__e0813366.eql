// Suspicious Printer Driver Empty Manufacturer | T1574 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_susp_printer_driver.yml
any where ((registry.path:"*\\Control\\Print\\Environments\\Windows x64\\Drivers*" and registry.path:"*\\Manufacturer*") and winlog.event_data.Details:"(Empty)") and (not (registry.path:"*\\CutePDF Writer v4.0\\*" or (registry.path like~ ("*\\VNC Printer (PS)\\*", "*\\VNC Printer (UD)\\*")) or registry.path:"*\\Version-3\\PDF24\\*"))
