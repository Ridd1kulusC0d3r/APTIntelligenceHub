// Suspicious Velociraptor Child Process | T1219 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_velociraptor_child_process.yml
any where process.parent.executable.caseless:"*\\Velociraptor.exe" and ((process.command_line:"*code.exe*" and process.command_line:"*tunnel*" and process.command_line:"*--accept-server-license-terms*") or (process.command_line:"*msiexec*" and process.command_line:"*/i*" and process.command_line:"*http*") or ((process.executable.caseless like~ ("*\\powershell.exe", "*\\powershell_ise.exe", "*\\pwsh.exe")) and (process.command_line like~ ("*Invoke-WebRequest *", "*IWR *", "*.DownloadFile*", "*.DownloadString*"))))
