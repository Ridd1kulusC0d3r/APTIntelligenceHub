// Renamed Visual Studio Code Tunnel Execution | T1071.001, T1219 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_vscode_tunnel_renamed_execution.yml
any where ((((?process.pe.original_file_name == null) and process.command_line:"*.exe tunnel") or (process.command_line:"*.exe tunnel*" and process.command_line:"*--accept-server-license-terms*") or (process.command_line:"*tunnel *" and process.command_line:"*service*" and process.command_line:"*internal-run*" and process.command_line:"*tunnel-service.log*")) and (not (process.executable.caseless like~ ("*\\code-tunnel.exe", "*\\code.exe")))) or ((process.parent.command_line:"* tunnel" and process.executable.caseless:"*\\cmd.exe" and (process.command_line:"*/d /c *" and process.command_line:"*\\servers\\Stable-*" and process.command_line:"*code-server.cmd*")) and (not (process.parent.executable.caseless like~ ("*\\code-tunnel.exe", "*\\code.exe"))))
