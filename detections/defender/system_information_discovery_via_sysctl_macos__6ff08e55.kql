// System Information Discovery Via Sysctl - MacOS | T1082, T1497.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_sysctl_discovery.yml
DeviceProcessEvents
| where (FolderPath endswith "/sysctl" or ProcessCommandLine contains "sysctl") and (ProcessCommandLine contains "hw." or ProcessCommandLine contains "kern." or ProcessCommandLine contains "machdep.")
