// Data Staging With RAR Using Password And Archive Splitting | T1560.001 | Hub
DeviceProcessEvents
| where ((FolderPath endswith "\\rar.exe" or FolderPath endswith "\\winrar.exe") or ProcessVersionInfoOriginalFileName =~ "Command line RAR") and (ProcessCommandLine contains " -hp" or ProcessCommandLine contains " -p") and ProcessCommandLine contains " -v"
