// LiteLLM / TeamPCP Supply Chain Attack Indicators | T1195.002, T1543.002, T1560.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2026/TA/TeamPCP/proc_creation_lnx_teampcp_litellm_supply_chain_attack_indicators.yml
DeviceProcessEvents
| where (FolderPath contains "/python3" and (ProcessCommandLine contains "exec(base64.b64decode('aW1wb3J0" and ProcessCommandLine contains "kI2NF9TQ1JJUFQgPSAiYV")) or (FolderPath endswith "/tar" and (ProcessCommandLine contains "tpcp.tar.gz" and ProcessCommandLine contains "payload.enc" and ProcessCommandLine contains "session.key.enc")) or (FolderPath endswith "/curl" and (ProcessCommandLine contains "models.litellm.cloud" and ProcessCommandLine contains "X-Filename: tpcp.tar.gz")) or (InitiatingProcessFolderPath contains "/python3" and (ProcessCommandLine contains "systemctl" and ProcessCommandLine contains "--user" and ProcessCommandLine contains "sysmon"))
