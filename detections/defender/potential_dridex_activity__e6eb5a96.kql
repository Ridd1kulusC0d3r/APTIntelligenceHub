// Potential Dridex Activity | T1033, T1055, T1135 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/Malware/Dridex/proc_creation_win_malware_dridex.yml
DeviceProcessEvents
| where ((FolderPath endswith "\\svchost.exe" and (ProcessCommandLine contains "C:\\Users\\" and ProcessCommandLine contains "\\Desktop\\")) and (not(InitiatingProcessFolderPath startswith "C:\\Windows\\System32\\"))) or ((InitiatingProcessFolderPath endswith "\\excel.exe" and FolderPath endswith "\\regsvr32.exe" and (ProcessCommandLine contains " -s " or ProcessCommandLine contains "\\AppData\\Local\\Temp\\")) and (not(ProcessCommandLine contains ".dll"))) or (InitiatingProcessFolderPath endswith "\\svchost.exe" and ((FolderPath endswith "\\whoami.exe" and ProcessCommandLine contains " /all") or ((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") and ProcessCommandLine contains " view")))
