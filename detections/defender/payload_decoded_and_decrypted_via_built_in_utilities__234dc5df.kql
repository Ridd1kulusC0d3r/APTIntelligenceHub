// Payload Decoded and Decrypted via Built-in Utilities | T1059, T1140, T1204 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_payload_decoded_and_decrypted.yml
DeviceProcessEvents
| where FolderPath endswith "/openssl" and (ProcessCommandLine contains "/Volumes/" and ProcessCommandLine contains "enc" and ProcessCommandLine contains "-base64" and ProcessCommandLine contains " -d ")
