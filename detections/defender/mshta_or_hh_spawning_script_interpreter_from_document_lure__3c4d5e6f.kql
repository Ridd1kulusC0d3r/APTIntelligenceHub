// MSHTA Or HH Spawning Script Interpreter From Document Lure | T1218.001, T1218.005 | Hub
DeviceProcessEvents
| where (InitiatingProcessFolderPath endswith "\\mshta.exe" or InitiatingProcessFolderPath endswith "\\hh.exe") and (FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\cmd.exe" or FolderPath endswith "\\wscript.exe" or FolderPath endswith "\\cscript.exe" or FolderPath endswith "\\curl.exe")
