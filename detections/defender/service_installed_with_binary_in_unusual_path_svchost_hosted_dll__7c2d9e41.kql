// Service Installed With Binary In Unusual Path (svchost-hosted DLL) | T1543.003 | Hub
DeviceRegistryEvents
| where (RegistryKey endswith "\\Services*" and RegistryKey endswith "\\Parameters\\ServiceDll") and (not((RegistryValueData startswith "C:\\Windows\\System32\\" or RegistryValueData startswith "%SystemRoot%\\System32\\" or RegistryValueData startswith "%systemroot%\\system32\\")))
