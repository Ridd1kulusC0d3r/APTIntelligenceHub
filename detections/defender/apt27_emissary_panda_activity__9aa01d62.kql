// APT27 - Emissary Panda Activity | T1574.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2018/TA/APT27/proc_creation_win_apt_apt27_emissary_panda.yml
DeviceProcessEvents
| where (InitiatingProcessFolderPath endswith "\\sllauncher.exe" and FolderPath endswith "\\svchost.exe") or (InitiatingProcessFolderPath contains "\\AppData\\Roaming\\" and FolderPath endswith "\\svchost.exe" and ProcessCommandLine contains "-k")
