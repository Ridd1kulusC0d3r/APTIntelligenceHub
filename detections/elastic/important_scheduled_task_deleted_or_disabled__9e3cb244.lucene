// Important Scheduled Task Deleted or Disabled | T1489 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/taskscheduler/win_taskscheduler_susp_schtasks_delete_or_disable.yml
winlog.channel:Microsoft\-Windows\-TaskScheduler\/Operational AND (((event.code:(141 OR 142)) AND (winlog.event_data.TaskName:(*\\Windows\\SystemRestore\\SR* OR *\\Windows\\Windows\ Defender\\* OR *\\Windows\\BitLocker* OR *\\Windows\\WindowsBackup\\* OR *\\Windows\\WindowsUpdate\\* OR *\\Windows\\UpdateOrchestrator\\* OR *\\Windows\\ExploitGuard*))) AND (NOT (winlog.event_data.UserName:(*AUTHORI* OR *AUTORI*))))
