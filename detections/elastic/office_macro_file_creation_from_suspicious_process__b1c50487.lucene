// Office Macro File Creation From Suspicious Process | T1566.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_office_macro_files_from_susp_process.yml
((process.executable.caseless:(*\\cscript.exe OR *\\mshta.exe OR *\\regsvr32.exe OR *\\rundll32.exe OR *\\wscript.exe)) OR (process.parent.executable.caseless:(*\\cscript.exe OR *\\mshta.exe OR *\\regsvr32.exe OR *\\rundll32.exe OR *\\wscript.exe))) AND (file.path:(*.docm OR *.dotm OR *.xlsm OR *.xltm OR *.potm OR *.pptm))
