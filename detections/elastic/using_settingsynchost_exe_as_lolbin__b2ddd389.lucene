// Using SettingSyncHost.exe as LOLBin | T1574.008 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_lolbin_settingsynchost.yml
(NOT (process.executable.caseless:(C\:\\Windows\\System32\\* OR C\:\\Windows\\SysWOW64\\*))) AND (process.parent.command_line:*cmd.exe\ \/c* AND process.parent.command_line:*RoamDiag.cmd* AND process.parent.command_line:*\-outputpath*)
