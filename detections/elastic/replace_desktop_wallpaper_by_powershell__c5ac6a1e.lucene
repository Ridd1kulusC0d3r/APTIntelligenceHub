// Replace Desktop Wallpaper by Powershell | T1491.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_susp_wallpaper.yml
(powershell.file.script_block_text:*Get\-ItemProperty* AND powershell.file.script_block_text:*Registry\:\:* AND powershell.file.script_block_text:*HKEY_CURRENT_USER\\Control\ Panel\\Desktop\\* AND powershell.file.script_block_text:*WallPaper*) OR powershell.file.script_block_text:*SystemParametersInfo\(20,0,*,3\)*
