// Suspicious Invoke-WebRequest Execution | T1105 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_invoke_webrequest_download.yml
((process.executable.caseless:(*\\powershell_ise.exe OR *\\powershell.exe OR *\\pwsh.exe)) OR (process.pe.original_file_name:(powershell_ise.EXE OR PowerShell.EXE OR pwsh.dll))) AND (process.command_line:(*curl\ * OR *Invoke\-WebRequest* OR *iwr\ * OR *wget\ *)) AND (process.command_line:(*\ \-ur* OR *\ \-o*)) AND (process.command_line:(*\\AppData\\* OR *\\Desktop\\* OR *\\Temp\\* OR *\\Users\\Public\\* OR *%AppData%* OR *%Public%* OR *%Temp%* OR *%tmp%* OR *\:\\Windows\\*))
