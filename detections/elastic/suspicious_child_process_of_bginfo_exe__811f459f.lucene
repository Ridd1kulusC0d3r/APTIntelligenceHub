// Suspicious Child Process Of BgInfo.EXE | T1059.005, T1202, T1218 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_bginfo_suspicious_child_process.yml
(process.parent.executable.caseless:(*\\bginfo.exe OR *\\bginfo64.exe)) AND ((process.executable.caseless:(*\\calc.exe OR *\\cmd.exe OR *\\cscript.exe OR *\\mshta.exe OR *\\notepad.exe OR *\\powershell.exe OR *\\pwsh.exe OR *\\wscript.exe)) OR (process.executable.caseless:(*\\AppData\\Local\\* OR *\\AppData\\Roaming\\* OR *\:\\Users\\Public\\* OR *\:\\Temp\\* OR *\:\\Windows\\Temp\\* OR *\:\\PerfLogs\\*)))
