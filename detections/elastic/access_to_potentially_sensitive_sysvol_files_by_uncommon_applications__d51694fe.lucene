// Access To Potentially Sensitive Sysvol Files By Uncommon Applications | T1552.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_access/file_access_win_susp_gpo_files.yml
(file.path:\\* AND (file.path:*\\sysvol\\* AND file.path:*\\Policies\\*) AND (file.path:(*audit.csv OR *Files.xml OR *GptTmpl.inf OR *groups.xml OR *Registry.pol OR *Registry.xml OR *scheduledtasks.xml OR *scripts.ini OR *services.xml))) AND (NOT ((process.executable.caseless:(C\:\\Program\ Files\ \(x86\)\\* OR C\:\\Program\ Files\\* OR C\:\\Windows\\system32\\* OR C\:\\Windows\\SysWOW64\\*)) OR process.executable.caseless:C\:\\Windows\\explorer.exe))
