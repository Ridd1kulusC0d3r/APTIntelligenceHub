// Suspicious LNK Double Extension File Created | T1036.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_lnk_double_extension.yml
(file.path:*.lnk AND (file.path:(*.doc.* OR *.docx.* OR *.jpg.* OR *.pdf.* OR *.ppt.* OR *.pptx.* OR *.xls.* OR *.xlsx.*))) AND (NOT file.path:*\\AppData\\Roaming\\Microsoft\\Windows\\Recent\\*) AND (NOT (((process.executable.caseless:(*\\excel.exe OR *\\powerpnt.exe OR *\\winword.exe)) AND file.path:*\\AppData\\Roaming\\Microsoft\\Office\\Recent\\*) OR (process.executable.caseless:*\\excel.exe AND file.path:*\\AppData\\Roaming\\Microsoft\\Excel*) OR (process.executable.caseless:*\\powerpnt.exe AND file.path:*\\AppData\\Roaming\\Microsoft\\PowerPoint*) OR (process.executable.caseless:*\\winword.exe AND file.path:*\\AppData\\Roaming\\Microsoft\\Word*)))
