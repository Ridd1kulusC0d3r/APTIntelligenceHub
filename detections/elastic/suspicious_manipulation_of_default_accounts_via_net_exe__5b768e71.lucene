// Suspicious Manipulation Of Default Accounts Via Net.EXE | T1560.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_net_user_default_accounts_manipulation.yml
(((process.executable.caseless:(*\\net.exe OR *\\net1.exe)) OR (process.pe.original_file_name:(net.exe OR net1.exe))) AND process.command_line:*\ user\ * AND (process.command_line:(*\ Järjestelmänvalvoja\ * OR *\ Rendszergazda\ * OR *\ Администратор\ * OR *\ Administrateur\ * OR *\ Administrador\ * OR *\ Administratör\ * OR *\ Administrator\ * OR *\ guest\ * OR *\ DefaultAccount\ * OR *\ \"Järjestelmänvalvoja\"\ * OR *\ \"Rendszergazda\"\ * OR *\ \"Администратор\"\ * OR *\ \"Administrateur\"\ * OR *\ \"Administrador\"\ * OR *\ \"Administratör\"\ * OR *\ \"Administrator\"\ * OR *\ \"guest\"\ * OR *\ \"DefaultAccount\"\ * OR *\ 'Järjestelmänvalvoja'\ * OR *\ 'Rendszergazda'\ * OR *\ 'Администратор'\ * OR *\ 'Administrateur'\ * OR *\ 'Administrador'\ * OR *\ 'Administratör'\ * OR *\ 'Administrator'\ * OR *\ 'guest'\ * OR *\ 'DefaultAccount'\ *))) AND (NOT (process.command_line:*guest* AND process.command_line:*\/active\ no*))
