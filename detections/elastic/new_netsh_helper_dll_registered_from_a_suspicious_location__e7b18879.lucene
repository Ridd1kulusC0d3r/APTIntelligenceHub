// New Netsh Helper DLL Registered From A Suspicious Location | T1546.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_netsh_help_dll_persistence_susp_location.yml
registry.path:*\\SOFTWARE\\Microsoft\\NetSh* AND ((winlog.event_data.Details:(*\:\\Perflogs\\* OR *\:\\Users\\Public\\* OR *\:\\Windows\\Temp\\* OR *\\AppData\\Local\\Temp\\* OR *\\Temporary\ Internet*)) OR ((winlog.event_data.Details:*\:\\Users\\* AND winlog.event_data.Details:*\\Favorites\\*) OR (winlog.event_data.Details:*\:\\Users\\* AND winlog.event_data.Details:*\\Favourites\\*) OR (winlog.event_data.Details:*\:\\Users\\* AND winlog.event_data.Details:*\\Contacts\\*) OR (winlog.event_data.Details:*\:\\Users\\* AND winlog.event_data.Details:*\\Pictures\\*)))
