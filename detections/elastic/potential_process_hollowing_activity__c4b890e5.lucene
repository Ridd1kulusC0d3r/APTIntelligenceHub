// Potential Process Hollowing Activity | T1055.012 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_tampering/proc_tampering_susp_process_hollowing.yml
winlog.event_data.Type:"Image is replaced" AND (NOT (process.executable.caseless:(*\:\\Program\ Files\ \(x86\)* OR *\:\\Program\ Files\\* OR *\:\\Windows\\System32\\wbem\\WMIADAP.exe* OR *\:\\Windows\\SysWOW64\\wbem\\WMIADAP.exe*))) AND (NOT ((process.executable.caseless:*\\AppData\\Local\\Programs\\Opera\\* AND process.executable.caseless:*\\opera.exe) OR process.executable.caseless:*\\WindowsApps\\MicrosoftEdge.exe))
