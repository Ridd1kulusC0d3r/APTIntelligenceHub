// Suspicious Execution Of Renamed Sysinternals Tools - Registry | T1588.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_pua_sysinternals_renamed_execution_via_eula.yml
((registry.path:(*\\Active\ Directory\ Explorer* OR *\\Handle* OR *\\LiveKd* OR *\\ProcDump* OR *\\Process\ Explorer* OR *\\PsExec* OR *\\PsLoggedon* OR *\\PsLoglist* OR *\\PsPasswd* OR *\\PsPing* OR *\\PsService* OR *\\SDelete*)) AND registry.path:*\\EulaAccepted) AND (NOT (process.executable.caseless:(*\\ADExplorer.exe OR *\\ADExplorer64.exe OR *\\ADExplorer64a.exe OR *\\handle.exe OR *\\handle64.exe OR *\\handle64a.exe OR *\\livekd.exe OR *\\livekd64.exe OR *\\procdump.exe OR *\\procdump64.exe OR *\\procdump64a.exe OR *\\procexp.exe OR *\\procexp64.exe OR *\\procexp64a.exe OR *\\PsExec.exe OR *\\PsExec64.exe OR *\\PsExec64a.exe OR *\\PsLoggedon.exe OR *\\PsLoggedon64.exe OR *\\psloglist.exe OR *\\psloglist64.exe OR *\\psloglist64a.exe OR *\\pspasswd.exe OR *\\pspasswd64.exe OR *\\pspasswd64a.exe OR *\\PsPing.exe OR *\\PsPing64.exe OR *\\PsPing64a.exe OR *\\PsService.exe OR *\\PsService64.exe OR *\\PsService64a.exe OR *\\sdelete.exe)))
