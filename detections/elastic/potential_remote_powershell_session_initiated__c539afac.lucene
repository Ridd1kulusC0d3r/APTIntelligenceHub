// Potential Remote PowerShell Session Initiated | T1021.006, T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_susp_remote_powershell_session.yml
((destination.port:(5985 OR 5986)) AND network.direction:true AND winlog.event_data.SourceIsIpv6:false) AND (NOT (((user.name:(*NETWORK\ SERVICE* OR *NETZWERKDIENST* OR *SERVICIO\ DE\ RED* OR *SERVIZIO\ DI\ RETE*)) OR (user.name:*SERVICE\ R* AND user.name:*SEAU*)) OR ((source.ip:(\:\:1 OR 127.0.0.1)) AND (destination.ip:(\:\:1 OR 127.0.0.1))))) AND (NOT (process.executable.caseless:("C\:\\Program Files\\Avast Software\\Avast\\AvastSvc.exe" OR "C\:\\Program Files \(x86\)\\Avast Software\\Avast\\AvastSvc.exe")))
