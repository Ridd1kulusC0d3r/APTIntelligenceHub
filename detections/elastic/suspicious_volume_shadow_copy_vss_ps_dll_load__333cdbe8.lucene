// Suspicious Volume Shadow Copy VSS_PS.dll Load | T1490 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/image_load/image_load_dll_vss_ps_susp_load.yml
file.path:*\\vss_ps.dll AND (NOT ((process.executable.caseless:C\:\\Windows\\* AND (process.executable.caseless:(*\\clussvc.exe OR *\\dismhost.exe OR *\\dllhost.exe OR *\\inetsrv\\appcmd.exe OR *\\inetsrv\\iissetup.exe OR *\\msiexec.exe OR *\\rundll32.exe OR *\\searchindexer.exe OR *\\srtasks.exe OR *\\svchost.exe OR *\\System32\\SystemPropertiesAdvanced.exe OR *\\taskhostw.exe OR *\\thor.exe OR *\\thor64.exe OR *\\tiworker.exe OR *\\vssvc.exe OR *\\vssadmin.exe OR *\\WmiPrvSE.exe OR *\\wsmprovhost.exe))) OR (winlog.event_data.CommandLine:C\:\\$WinREAgent\\Scratch\\* AND winlog.event_data.CommandLine:*\\dismhost.exe\ \{*) OR (NOT _exists_:process.executable.caseless))) AND (NOT (process.executable.caseless:(C\:\\Program\ Files\\* OR C\:\\Program\ Files\ \(x86\)\\*)))
