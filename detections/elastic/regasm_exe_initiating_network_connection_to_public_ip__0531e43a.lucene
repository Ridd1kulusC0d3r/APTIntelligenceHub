// RegAsm.EXE Initiating Network Connection To Public IP | T1218.009 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_regasm_network_activity.yml
(network.direction:true AND process.executable.caseless:*\\regasm.exe) AND (NOT (destination.ip:127.0.0.0\/8 OR destination.ip:10.0.0.0\/8 OR destination.ip:172.16.0.0\/12 OR destination.ip:192.168.0.0\/16 OR destination.ip:169.254.0.0\/16 OR destination.ip:\:\:1\/128 OR destination.ip:fe80\:\:\/10 OR destination.ip:fc00\:\:\/7))
