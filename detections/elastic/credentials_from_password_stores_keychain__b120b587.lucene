// Credentials from Password Stores - Keychain | T1555.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_creds_from_keychain.yml
(Image:\/usr\/bin\/security AND (CommandLine:(*find\-certificate* OR *\ export\ *))) OR (CommandLine:(*\ dump\-keychain\ * OR *\ login\-keychain\ *))
