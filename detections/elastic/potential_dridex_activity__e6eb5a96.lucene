// Potential Dridex Activity | T1033, T1055, T1135 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/Malware/Dridex/proc_creation_win_malware_dridex.yml
((process.executable.caseless:*\\svchost.exe AND (process.command_line:*C\:\\Users\\* AND process.command_line:*\\Desktop\\*)) AND (NOT process.parent.executable.caseless:C\:\\Windows\\System32\\*)) OR ((process.parent.executable.caseless:*\\excel.exe AND process.executable.caseless:*\\regsvr32.exe AND (process.command_line:(*\ \-s\ * OR *\\AppData\\Local\\Temp\\*))) AND (NOT process.command_line:*.dll*)) OR (process.parent.executable.caseless:*\\svchost.exe AND ((process.executable.caseless:*\\whoami.exe AND process.command_line:*\ \/all*) OR ((process.executable.caseless:(*\\net.exe OR *\\net1.exe)) AND process.command_line:*\ view*)))
