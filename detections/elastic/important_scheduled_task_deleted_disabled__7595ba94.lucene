// Important Scheduled Task Deleted/Disabled | T1053.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_susp_scheduled_task_delete_or_disable.yml
winlog.channel:Security AND (((event.code:(4699 OR 4701)) AND (winlog.event_data.TaskName:(*\\Windows\\SystemRestore\\SR* OR *\\Windows\\Windows\ Defender\\* OR *\\Windows\\BitLocker* OR *\\Windows\\WindowsBackup\\* OR *\\Windows\\WindowsUpdate\\* OR *\\Windows\\UpdateOrchestrator\\Schedule* OR *\\Windows\\ExploitGuard*))) AND (NOT (event.code:4699 AND user.name:*$ AND winlog.event_data.TaskName:*\\Windows\\Windows\ Defender\\*)))
