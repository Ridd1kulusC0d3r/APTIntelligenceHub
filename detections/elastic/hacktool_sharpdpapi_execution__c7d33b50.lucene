// HackTool - SharpDPAPI Execution | T1134.001, T1134.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_sharp_dpapi_execution.yml
(process.executable.caseless:*\\SharpDPAPI.exe OR process.pe.original_file_name:SharpDPAPI.exe) OR ((process.command_line:(*\ backupkey\ * OR *\ blob\ * OR *\ certificates\ * OR *\ credentials\ * OR *\ keepass\ * OR *\ masterkeys\ * OR *\ rdg\ * OR *\ vaults\ *)) AND ((process.command_line:*\ \{* AND process.command_line:*\}\:*) OR (process.command_line:(*\ \/file\:* OR *\ \/machine* OR *\ \/mkfile\:* OR *\ \/password\:* OR *\ \/pvk\:* OR *\ \/server\:* OR *\ \/target\:* OR *\ \/unprotect*))))
