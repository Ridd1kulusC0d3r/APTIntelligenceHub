// CredUI.DLL Loaded By Uncommon Process | T1056.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/image_load/image_load_dll_credui_uncommon_process_load.yml
((file.path:(*\\credui.dll OR *\\wincredui.dll)) OR (file.pe.original_file_name:(credui.dll OR wincredui.dll))) AND (NOT ((process.executable.caseless:(C\:\\Program\ Files\ \(x86\)\\* OR C\:\\Program\ Files\\* OR C\:\\Windows\\System32\\* OR C\:\\Windows\\SysWOW64\\* OR C\:\\Windows\\SystemApps\\*)) OR (process.executable.caseless:(C\:\\Windows\\explorer.exe OR C\:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe OR C\:\\Windows\\regedit.exe)))) AND (NOT (process.executable.caseless:*\\opera_autoupdate.exe OR (process.executable.caseless:(*\\procexp64.exe OR *\\procexp64a.exe OR *\\procexp.exe)) OR (process.executable.caseless:C\:\\Users\\* AND process.executable.caseless:*\\AppData\\Local\\Microsoft\\Teams\\* AND process.executable.caseless:*\\Teams.exe) OR (process.executable.caseless:C\:\\Users\\* AND process.executable.caseless:*\\AppData\\Local\\Microsoft\\OneDrive\\*)))
