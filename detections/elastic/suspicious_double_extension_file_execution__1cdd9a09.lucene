// Suspicious Double Extension File Execution | T1566.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_double_extension.yml
(process.executable.caseless:(*\ \ \ \ \ \ .exe OR *______.exe OR *.doc.exe OR *.doc.js OR *.docx.exe OR *.docx.js OR *.gif.exe OR *.jpeg.exe OR *.jpg.exe OR *.mkv.exe OR *.mov.exe OR *.mp3.exe OR *.mp4.exe OR *.pdf.exe OR *.pdf.js OR *.png.exe OR *.ppt.exe OR *.ppt.js OR *.pptx.exe OR *.pptx.js OR *.rtf.exe OR *.rtf.js OR *.svg.exe OR *.txt.exe OR *.txt.js OR *.xls.exe OR *.xls.js OR *.xlsx.exe OR *.xlsx.js OR *⠀⠀⠀⠀⠀⠀.exe)) AND (process.command_line:(*\ \ \ \ \ \ .exe* OR *______.exe* OR *.doc.exe* OR *.doc.js* OR *.docx.exe* OR *.docx.js* OR *.gif.exe* OR *.jpeg.exe* OR *.jpg.exe* OR *.mkv.exe* OR *.mov.exe* OR *.mp3.exe* OR *.mp4.exe* OR *.pdf.exe* OR *.pdf.js* OR *.png.exe* OR *.ppt.exe* OR *.ppt.js* OR *.pptx.exe* OR *.pptx.js* OR *.rtf.exe* OR *.rtf.js* OR *.svg.exe* OR *.txt.exe* OR *.txt.js* OR *.xls.exe* OR *.xls.js* OR *.xlsx.exe* OR *.xlsx.js* OR *⠀⠀⠀⠀⠀⠀.exe*))
