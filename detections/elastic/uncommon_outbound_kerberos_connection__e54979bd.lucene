// Uncommon Outbound Kerberos Connection | T1550.003, T1558 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_susp_outbound_kerberos_connection.yml
(destination.port:88 AND network.direction:true) AND (NOT process.executable.caseless:C\:\\Windows\\System32\\lsass.exe) AND (NOT ((process.executable.caseless:("C\:\\Program Files \(x86\)\\Google\\Chrome\\Application\\chrome.exe" OR "C\:\\Program Files\\Google\\Chrome\\Application\\chrome.exe")) OR (process.executable.caseless:("C\:\\Program Files \(x86\)\\Mozilla Firefox\\firefox.exe" OR "C\:\\Program Files\\Mozilla Firefox\\firefox.exe")) OR process.executable.caseless:*\\tomcat\\bin\\tomcat8.exe OR (process.executable.caseless:("C\:\\Program Files\\Zscaler\\ZSATunnel\\ZSATunnel.exe" OR "C\:\\Program Files \(x86\)\\Zscaler\\ZSATunnel\\ZSATunnel.exe"))))
