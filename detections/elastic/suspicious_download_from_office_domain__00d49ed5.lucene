// Suspicious Download from Office Domain | T1105, T1608 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_download_office_domain.yml
((process.executable.caseless:(*\\curl.exe OR *\\wget.exe)) OR (process.command_line:(*Invoke\-WebRequest* OR *iwr\ * OR *curl\ * OR *wget\ * OR *Start\-BitsTransfer* OR *.DownloadFile\(* OR *.DownloadString\(*))) AND (process.command_line:(*https\:\/\/attachment.outlook.live.net\/owa\/* OR *https\:\/\/onenoteonlinesync.onenote.com\/onenoteonlinesync\/*))
