// Invoke-Obfuscation Via Use Rundll32 - System | T1027, T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/service_control_manager/win_system_invoke_obfuscation_via_use_rundll32_services.yml
winlog.channel:System AND (winlog.provider_name:"Service Control Manager" AND event.code:7045 AND (winlog.event_data.ImagePath:*\&\&* AND winlog.event_data.ImagePath:*rundll32* AND winlog.event_data.ImagePath:*shell32.dll* AND winlog.event_data.ImagePath:*shellexec_rundll*) AND (winlog.event_data.ImagePath:(*value* OR *invoke* OR *comspec* OR *iex*)))
