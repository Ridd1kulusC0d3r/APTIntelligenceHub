// Suspicious SYSTEM User Process Creation | T1003, T1027, T1134 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_system_user_anomaly.yml
(((winlog.event_data.IntegrityLevel:(System OR S\-1\-16\-16384)) AND (user.name:(*AUTHORI* OR *AUTORI*))) AND ((process.executable.caseless:(*\\calc.exe OR *\\cscript.exe OR *\\forfiles.exe OR *\\hh.exe OR *\\mshta.exe OR *\\ping.exe OR *\\wscript.exe)) OR process.command_line:/net\s+user\s+/ OR (process.command_line:(*\ \-NoP\ * OR *\ \-W\ Hidden\ * OR *\ \-decode\ * OR *\ \/decode\ * OR *\ \/urlcache\ * OR *\ \-urlcache\ * OR *\ \-e*\ JAB* OR *\ \-e*\ SUVYI* OR *\ \-e*\ SQBFAFgA* OR *\ \-e*\ aWV4I* OR *\ \-e*\ IAB* OR *\ \-e*\ PAA* OR *\ \-e*\ aQBlAHgA* OR *vssadmin\ delete\ shadows* OR *reg\ SAVE\ HKLM* OR *\ \-ma\ * OR *Microsoft\\Windows\\CurrentVersion\\Run* OR *.downloadstring\(* OR *.downloadfile\(* OR *\ \/ticket\:* OR *dpapi\:\:* OR *event\:\:clear* OR *event\:\:drop* OR *id\:\:modify* OR *kerberos\:\:* OR *lsadump\:\:* OR *misc\:\:* OR *privilege\:\:* OR *rpc\:\:* OR *sekurlsa\:\:* OR *sid\:\:* OR *token\:\:* OR *vault\:\:cred* OR *vault\:\:list* OR *\ p\:\:d\ * OR *;iex\(* OR *MiniDump*)))) AND (NOT ((process.command_line:*ping* AND process.command_line:*127.0.0.1* AND process.command_line:*\ \-n\ *) OR (process.executable.caseless:*\\PING.EXE AND process.parent.command_line:*\\DismFoDInstall.cmd*) OR process.parent.executable.caseless:*\:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\* OR ((process.parent.executable.caseless:(*\:\\Program\ Files\ \(x86\)\\Java\\* OR *\:\\Program\ Files\\Java\\*)) AND process.parent.executable.caseless:*\\bin\\javaws.exe AND (process.executable.caseless:(*\:\\Program\ Files\ \(x86\)\\Java\\* OR *\:\\Program\ Files\\Java\\*)) AND process.executable.caseless:*\\bin\\jp2launcher.exe AND process.command_line:*\ \-ma\ *)))
