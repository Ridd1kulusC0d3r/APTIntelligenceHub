// Exchange PowerShell Snap-Ins Usage | T1059.001, T1114 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_snapins_hafnium.yml
(((process.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe)) OR (process.pe.original_file_name:(PowerShell.EXE OR pwsh.dll))) AND process.command_line:*Add\-PSSnapin* AND (process.command_line:(*Microsoft.Exchange.Powershell.Snapin* OR *Microsoft.Exchange.Management.PowerShell.SnapIn*))) AND (NOT (process.parent.executable.caseless:C\:\\Windows\\System32\\msiexec.exe AND process.command_line:*$exserver\=Get\-ExchangeServer\ \(\[Environment\]\:\:MachineName\)\ \-ErrorVariable\ exerr\ 2\>\ $null*))
