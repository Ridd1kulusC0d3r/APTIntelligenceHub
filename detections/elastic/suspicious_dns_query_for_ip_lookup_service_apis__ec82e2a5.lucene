// Suspicious DNS Query for IP Lookup Service APIs | T1590 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/dns_query/dns_query_win_susp_external_ip_lookup.yml
((dns.question.name:(www.ip.cn OR l2.io)) OR (dns.question.name:(*api.2ip.ua* OR *api.bigdatacloud.net* OR *api.ipify.org* OR *bot.whatismyipaddress.com* OR *canireachthe.net* OR *checkip.amazonaws.com* OR *checkip.dyndns.org* OR *curlmyip.com* OR *db\-ip.com* OR *edns.ip\-api.com* OR *eth0.me* OR *freegeoip.app* OR *geoipy.com* OR *getip.pro* OR *icanhazip.com* OR *ident.me* OR *ifconfig.io* OR *ifconfig.me* OR *ip\-api.com* OR *ip.360.cn* OR *ip.anysrc.net* OR *ip.taobao.com* OR *ip.tyk.nu* OR *ipaddressworld.com* OR *ipapi.co* OR *ipconfig.io* OR *ipecho.net* OR *ipinfo.io* OR *ipip.net* OR *ipof.in* OR *ipv4.icanhazip.com* OR *ipv4bot.whatismyipaddress.com* OR *ipv6\-test.com* OR *ipwho.is* OR *jsonip.com* OR *myexternalip.com* OR *seeip.org* OR *wgetip.com* OR *whatismyip.akamai.com* OR *whois.pconline.com.cn* OR *wtfismyip.com*))) AND (NOT (process.executable.caseless:*\\brave.exe OR (process.executable.caseless:("C\:\\Program Files\\Google\\Chrome\\Application\\chrome.exe" OR "C\:\\Program Files \(x86\)\\Google\\Chrome\\Application\\chrome.exe")) OR (process.executable.caseless:("C\:\\Program Files\\Mozilla Firefox\\firefox.exe" OR "C\:\\Program Files \(x86\)\\Mozilla Firefox\\firefox.exe")) OR (process.executable.caseless:("C\:\\Program Files \(x86\)\\Internet Explorer\\iexplore.exe" OR "C\:\\Program Files\\Internet Explorer\\iexplore.exe")) OR process.executable.caseless:*\\maxthon.exe OR (process.executable.caseless:C\:\\Program\ Files\ \(x86\)\\Microsoft\\EdgeWebView\\Application\\* OR process.executable.caseless:*\\WindowsApps\\MicrosoftEdge.exe OR (process.executable.caseless:("C\:\\Program Files \(x86\)\\Microsoft\\Edge\\Application\\msedge.exe" OR "C\:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe"))) OR ((process.executable.caseless:(C\:\\Program\ Files\ \(x86\)\\Microsoft\\EdgeCore\\* OR C\:\\Program\ Files\\Microsoft\\EdgeCore\\*)) AND (process.executable.caseless:(*\\msedge.exe OR *\\msedgewebview2.exe))) OR process.executable.caseless:*\\opera.exe OR process.executable.caseless:*\\safari.exe OR process.executable.caseless:*\\seamonkey.exe OR process.executable.caseless:*\\vivaldi.exe OR process.executable.caseless:*\\whale.exe))
