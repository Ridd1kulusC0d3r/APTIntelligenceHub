// Access To Windows DPAPI Master Keys By Uncommon Applications | T1555.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_access/file_access_win_susp_dpapi_master_key_access.yml
(file.path:(*\\Microsoft\\Protect\\S\-1\-5\-18\\* OR *\\Microsoft\\Protect\\S\-1\-5\-21\-*)) AND (NOT ((process.executable.caseless:(C\:\\Program\ Files\\* OR C\:\\Program\ Files\ \(x86\)\\* OR C\:\\Windows\\system32\\* OR C\:\\Windows\\SysWOW64\\*)) OR process.executable.caseless:C\:\\Windows\\explorer.exe))
