// Potential Ryuk Ransomware Activity | T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/Malware/Ryuk/proc_creation_win_malware_ryuk.yml
(process.command_line:*Microsoft\\Windows\\CurrentVersion\\Run* AND process.command_line:*C\:\\users\\Public\\*) OR (process.command_line:*del\ \/s\ \/f\ \/q\ c\:\\* AND process.command_line:*\*.bac* AND process.command_line:*\*.bak* AND process.command_line:*\*.bkf*) OR ((process.executable.caseless:(*\\net.exe OR *\\net1.exe)) AND (process.command_line:*\ stop\ * AND process.command_line:*\ \/y*) AND (process.command_line:(*samss* OR *audioendpointbuilder* OR *unistoresvc_* OR *AcrSch2Svc*)))
