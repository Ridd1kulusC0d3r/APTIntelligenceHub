// Potential Persistence Via PowerShell User Profile Using Add-Content | T1546.013 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_user_profile_tampering.yml
powershell.file.script_block_text:*Add\-Content\ $profile* AND (powershell.file.script_block_text:(*\-Value\ \"IEX\ * OR *\-Value\ \"Invoke\-Expression* OR *\-Value\ \"Invoke\-WebRequest* OR *\-Value\ \"Start\-Process* OR *\-Value\ 'IEX\ * OR *\-Value\ 'Invoke\-Expression* OR *\-Value\ 'Invoke\-WebRequest* OR *\-Value\ 'Start\-Process*))
