// Suspicious Shim Database Patching Activity | T1546.011 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_persistence_shim_database_susp_application.yml
registry.path:*\\SOFTWARE\\Microsoft\\Windows\ NT\\CurrentVersion\\AppCompatFlags\\Custom\\* AND (registry.path:(*\\csrss.exe OR *\\dllhost.exe OR *\\explorer.exe OR *\\RuntimeBroker.exe OR *\\services.exe OR *\\sihost.exe OR *\\svchost.exe OR *\\taskhostw.exe OR *\\winlogon.exe OR *\\WmiPrvSe.exe))
