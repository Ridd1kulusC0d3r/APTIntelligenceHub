// Unusual File Download from Direct IP Address | T1564.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/create_stream_hash/create_stream_hash_susp_ip_domains.yml
winlog.event_data.Contents:/http[s]?:\/\/[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/ AND (file.path:(*.ps1\:Zone* OR *.bat\:Zone* OR *.exe\:Zone* OR *.vbe\:Zone* OR *.vbs\:Zone* OR *.dll\:Zone* OR *.one\:Zone* OR *.cmd\:Zone* OR *.hta\:Zone* OR *.xll\:Zone* OR *.lnk\:Zone*))
