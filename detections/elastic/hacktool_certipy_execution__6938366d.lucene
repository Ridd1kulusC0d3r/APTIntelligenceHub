// HackTool - Certipy Execution | T1649 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_certipy.yml
(process.executable.caseless:*\\Certipy.exe OR process.pe.original_file_name:Certipy.exe OR process.pe.description:*Certipy*) OR ((process.command_line:(*\ account\ * OR *\ auth\ * OR *\ cert\ * OR *\ find\ * OR *\ forge\ * OR *\ ptt\ * OR *\ relay\ * OR *\ req\ * OR *\ shadow\ * OR *\ template\ *)) AND (process.command_line:(*\ \-bloodhound* OR *\ \-ca\-pfx\ * OR *\ \-dc\-ip\ * OR *\ \-kirbi* OR *\ \-old\-bloodhound* OR *\ \-pfx\ * OR *\ \-target* OR *\ \-template* OR *\ \-username\ * OR *\ \-vulnerable* OR *auth\ \-pfx* OR *shadow\ auto* OR *shadow\ list*)))
