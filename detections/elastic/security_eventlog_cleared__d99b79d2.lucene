// Security Eventlog Cleared | T1685.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_audit_log_cleared.yml
winlog.channel:Security AND ((event.code:517 AND winlog.provider_name:Security) OR (event.code:1102 AND winlog.provider_name:Microsoft\-Windows\-Eventlog))
