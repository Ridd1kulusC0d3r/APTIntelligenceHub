// Suspicious Connection to Remote Account | T1110.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_susp_networkcredential.yml
powershell.file.script_block_text:(*System.DirectoryServices.Protocols.LdapDirectoryIdentifier* OR *System.Net.NetworkCredential* OR *System.DirectoryServices.Protocols.LdapConnection*)
