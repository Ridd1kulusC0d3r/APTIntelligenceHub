// User Added to Local Administrator Group | T1078, T1098 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_user_added_to_local_administrators.yml
winlog.channel:Security AND ((event.code:4732 AND (winlog.event_data.TargetUserName:Administr* OR winlog.event_data.TargetSid:S\-1\-5\-32\-544)) AND (NOT user.name:*$))
