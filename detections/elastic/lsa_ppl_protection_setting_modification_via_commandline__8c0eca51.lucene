// LSA PPL Protection Setting Modification via CommandLine | T1689 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_lsa_ppl_protection_setting_modification_via_cli.yml
((process.executable.caseless:(*\\reg.exe OR *\\powershell.exe OR *\\pwsh.exe)) OR (process.pe.original_file_name:(reg.exe OR powershell.exe OR pwsh.dll))) AND ((process.command_line:*ControlSet* AND process.command_line:*\\Control\\Lsa*) AND (process.command_line:(*Set\-ItemProperty* OR *New\-ItemProperty* OR *\ add\ *))) AND (process.command_line:(*IsPplAutoEnabled* OR *RunAsPPL* OR *RunAsPPLBoot*))
