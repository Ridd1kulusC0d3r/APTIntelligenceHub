// Suspicious Camera and Microphone Access | T1123, T1125 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_susp_mic_cam_access.yml
(registry.path:*\\Software\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore\\* AND registry.path:*\\NonPackaged*) AND (registry.path:(*microphone* OR *webcam*)) AND (registry.path:(*\:#Windows#Temp#* OR *\:#$Recycle.bin#* OR *\:#Temp#* OR *\:#Users#Public#* OR *\:#Users#Default#* OR *\:#Users#Desktop#*))
