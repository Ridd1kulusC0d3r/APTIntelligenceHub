// HTTP Logging Disabled On IIS Server | T1505.004, T1685.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/iis-configuration/win_iis_logging_http_disabled.yml
event.code:29 AND winlog.event_data.Configuration:\/system.webServer\/httpLogging\/@dontLog AND winlog.event_data.NewValue:true
