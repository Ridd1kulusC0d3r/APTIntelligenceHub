// Access To Browser Credential Files By Uncommon Applications - Security | T1555.003 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/builtin/security/win_security_file_access_browser_credential.yml
winlog.channel:Security AND ((event.code:4663 AND winlog.event_data.ObjectType:File AND winlog.event_data.AccessMask:0x1) AND ((winlog.event_data.ObjectName:(*\\User\ Data\\Default\\Login\ Data* OR *\\User\ Data\\Local\ State* OR *\\User\ Data\\Default\\Network\\Cookies*)) OR (file.path:(*\\cookies.sqlite OR *\\places.sqlite OR *release\\key3.db OR *release\\key4.db OR *release\\logins.json))) AND (NOT (process.executable.caseless:System OR (process.executable.caseless:(C\:\\Program\ Files\ \(x86\)\\* OR C\:\\Program\ Files\\* OR C\:\\Windows\\system32\\* OR C\:\\Windows\\SysWOW64\\*)))) AND (NOT (process.executable.caseless:C\:\\ProgramData\\Microsoft\\Windows\ Defender\\* AND (process.executable.caseless:(*\\MpCopyAccelerator.exe OR *\\MsMpEng.exe)))))
