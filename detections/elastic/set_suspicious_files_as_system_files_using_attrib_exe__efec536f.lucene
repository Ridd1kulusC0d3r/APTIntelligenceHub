// Set Suspicious Files as System Files Using Attrib.EXE | T1564.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_attrib_system_susp_paths.yml
((process.executable.caseless:*\\attrib.exe OR process.pe.original_file_name:ATTRIB.EXE) AND process.command_line:*\ \+s* AND (process.command_line:(*\ %* OR *\\Users\\Public\\* OR *\\AppData\\Local\\* OR *\\ProgramData\\* OR *\\Downloads\\* OR *\\Windows\\Temp\\*)) AND (process.command_line:(*.bat* OR *.dll* OR *.exe* OR *.hta* OR *.ps1* OR *.vbe* OR *.vbs*))) AND (NOT (process.command_line:*\\Windows\\TEMP\\* AND process.command_line:*.exe*))
