// Google Cloud Kubernetes Admission Controller | T1078, T1552, T1552.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/gcp/audit/gcp_kubernetes_admission_controller.yml
gcp.audit.method_name:admissionregistration.k8s.io.v* AND (gcp.audit.method_name:(*.mutatingwebhookconfigurations.* OR *.validatingwebhookconfigurations.*)) AND (gcp.audit.method_name:(*create OR *patch OR *replace))
