// Csc.EXE Execution Form Potentially Suspicious Parent | T1027.004, T1059.005, T1059.007, T1218.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_csc_susp_parent.yml
(process.executable.caseless:*\\csc.exe OR process.pe.original_file_name:csc.exe) AND ((process.parent.executable.caseless:(*\\cscript.exe OR *\\excel.exe OR *\\mshta.exe OR *\\onenote.exe OR *\\outlook.exe OR *\\powerpnt.exe OR *\\winword.exe OR *\\wscript.exe)) OR ((process.parent.executable.caseless:(*\\powershell.exe OR *\\pwsh.exe)) AND (process.parent.command_line:(*\-Encoded\ * OR *FromBase64String*))) OR (process.parent.command_line:/(?:[Pp]rogram[Dd]ata|%(?:[Ll]ocal)?[Aa]pp[Dd]ata%|\\[Aa]pp[Dd]ata\\(?:[Ll]ocal(?:[Ll]ow)?|[Rr]oaming))\\[^\\]{1,256}$/ OR (process.parent.command_line:(*\:\\PerfLogs\\* OR *\:\\Users\\Public\\* OR *\:\\Windows\\Temp\\* OR *\\Temporary\ Internet*)) OR (process.parent.command_line:*\:\\Users\\* AND process.parent.command_line:*\\Favorites\\*) OR (process.parent.command_line:*\:\\Users\\* AND process.parent.command_line:*\\Favourites\\*) OR (process.parent.command_line:*\:\\Users\\* AND process.parent.command_line:*\\Contacts\\*) OR (process.parent.command_line:*\:\\Users\\* AND process.parent.command_line:*\\Pictures\\*))) AND (NOT ((process.parent.executable.caseless:(C\:\\Program\ Files\ \(x86\)\\* OR C\:\\Program\ Files\\*)) OR process.parent.executable.caseless:C\:\\Windows\\System32\\sdiagnhost.exe OR process.parent.executable.caseless:C\:\\Windows\\System32\\inetsrv\\w3wp.exe)) AND (NOT (process.parent.executable.caseless:C\:\\ProgramData\\chocolatey\\choco.exe OR process.parent.command_line:*\\ProgramData\\Microsoft\\Windows\ Defender\ Advanced\ Threat\ Protection* OR (process.parent.command_line:(*JwB7ACIAZgBhAGkAbABlAGQAIgA6AHQAcgB1AGUALAAiAG0AcwBnACIAOgAiAEEAbgBzAGkAYgBsAGUAIAByAGUAcQB1AGkAcgBlAHMAIABQAG8AdwBlAHIAUwBoAGUAbABsACAAdgAzAC4AMAAgAG8AcgAgAG4AZQB3AGUAcgAiAH0AJw* OR *cAewAiAGYAYQBpAGwAZQBkACIAOgB0AHIAdQBlACwAIgBtAHMAZwAiADoAIgBBAG4AcwBpAGIAbABlACAAcgBlAHEAdQBpAHIAZQBzACAAUABvAHcAZQByAFMAaABlAGwAbAAgAHYAMwAuADAAIABvAHIAIABuAGUAdwBlAHIAIgB9ACcA* OR *nAHsAIgBmAGEAaQBsAGUAZAAiADoAdAByAHUAZQAsACIAbQBzAGcAIgA6ACIAQQBu