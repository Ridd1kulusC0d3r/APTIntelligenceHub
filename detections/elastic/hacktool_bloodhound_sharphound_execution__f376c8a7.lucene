// HackTool - Bloodhound/Sharphound Execution | T1059.001, T1069.001, T1069.002, T1087.001, T1087.002, T1482 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_bloodhound_sharphound.yml
(process.pe.product:*SharpHound* OR process.pe.description:*SharpHound* OR (process.pe.company:(*SpecterOps* OR *evil\ corp*)) OR (process.executable.caseless:(*\\Bloodhound.exe* OR *\\SharpHound.exe*))) OR (process.command_line:(*\ \-CollectionMethod\ All\ * OR *\ \-\-CollectionMethods\ Session\ * OR *\ \-\-Loop\ \-\-Loopduration\ * OR *\ \-\-PortScanTimeout\ * OR *.exe\ \-c\ All\ \-d\ * OR *Invoke\-Bloodhound* OR *Get\-BloodHoundData*)) OR (process.command_line:*\ \-JsonFolder\ * AND process.command_line:*\ \-ZipFileName\ *) OR (process.command_line:*\ DCOnly\ * AND process.command_line:*\ \-\-NoSaveCache\ *)
