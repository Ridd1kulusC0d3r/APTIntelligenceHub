-- Mail Forwarding/Redirecting Activity In O365 | T1020, T1114.003, T1564.008 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/cloud/m365/audit/microsoft365_susp_email_forwarding_activity.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=397 AND ((LOWER(UTF8(payload)) LIKE '%updateinboxrules%' AND (LOWER(UTF8(payload)) LIKE '%forward%' OR LOWER(UTF8(payload)) LIKE '%recipients%')) OR (LOWER(UTF8(payload)) LIKE '%set-mailbox%' AND (LOWER(UTF8(payload)) LIKE '%forwardingsmtpaddress%' OR LOWER(UTF8(payload)) LIKE '%forwardingaddress%')) OR ((LOWER(UTF8(payload)) LIKE '%new-inboxrule%' OR LOWER(UTF8(payload)) LIKE '%set-inboxrule%') AND (LOWER(UTF8(payload)) LIKE '%forwardasattachmentto%' OR LOWER(UTF8(payload)) LIKE '%forwardingaddress%' OR LOWER(UTF8(payload)) LIKE '%forwardingsmtpaddress%' OR LOWER(UTF8(payload)) LIKE '%forwardto%' OR LOWER(UTF8(payload)) LIKE '%redirectto%' OR LOWER(UTF8(payload)) LIKE '%redirecttorecipients%')))
