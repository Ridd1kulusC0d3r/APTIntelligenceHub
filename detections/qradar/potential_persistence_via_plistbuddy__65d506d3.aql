-- Potential Persistence Via PlistBuddy | T1543.001, T1543.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_persistence_via_plistbuddy.yml
SELECT * FROM events WHERE devicetype=102 AND (LOWER("Process Path") LIKE '%/plistbuddy' OR LOWER("Process Name") LIKE '%/plistbuddy') AND (LOWER(Command) LIKE '%runatload%' AND LOWER(Command) LIKE '%true%') AND (LOWER(Command) LIKE '%launchagents%' OR LOWER(Command) LIKE '%launchdaemons%')
