-- SQLite Chromium Profile Data DB Access | T1005, T1539, T1555.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_sqlite_chromium_profile_data.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER(UTF8(payload)) LIKE '%sqlite%' OR ((LOWER("Process Path") LIKE '%\sqlite.exe' OR LOWER("Process Path") LIKE '%\sqlite3.exe') OR (LOWER("Process Name") LIKE '%\sqlite.exe' OR LOWER("Process Name") LIKE '%\sqlite3.exe'))) AND (LOWER(Command) LIKE '%\user data\%' OR LOWER(Command) LIKE '%\opera software\%' OR LOWER(Command) LIKE '%\chromiumviewer\%') AND (LOWER(Command) LIKE '%login data%' OR LOWER(Command) LIKE '%cookies%' OR LOWER(Command) LIKE '%web data%' OR LOWER(Command) LIKE '%history%' OR LOWER(Command) LIKE '%bookmarks%')
