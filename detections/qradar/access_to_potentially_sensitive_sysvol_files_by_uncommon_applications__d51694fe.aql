-- Access To Potentially Sensitive Sysvol Files By Uncommon Applications | T1552.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_access/file_access_win_susp_gpo_files.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Filename) LIKE '\%' AND (LOWER(Filename) LIKE '%\sysvol\%' AND LOWER(Filename) LIKE '%\policies\%') AND (LOWER(Filename) LIKE '%audit.csv' OR LOWER(Filename) LIKE '%files.xml' OR LOWER(Filename) LIKE '%gpttmpl.inf' OR LOWER(Filename) LIKE '%groups.xml' OR LOWER(Filename) LIKE '%registry.pol' OR LOWER(Filename) LIKE '%registry.xml' OR LOWER(Filename) LIKE '%scheduledtasks.xml' OR LOWER(Filename) LIKE '%scripts.ini' OR LOWER(Filename) LIKE '%services.xml')) AND (NOT((((LOWER("Process Path") LIKE 'c:\program files (x86)\%' OR LOWER("Process Path") LIKE 'c:\program files\%' OR LOWER("Process Path") LIKE 'c:\windows\system32\%' OR LOWER("Process Path") LIKE 'c:\windows\syswow64\%') OR (LOWER("Process Name") LIKE 'c:\program files (x86)\%' OR LOWER("Process Name") LIKE 'c:\program files\%' OR LOWER("Process Name") LIKE 'c:\windows\system32\%' OR LOWER("Process Name") LIKE 'c:\windows\syswow64\%')) OR ("Process Path"='C:\Windows\explorer.exe' OR "Process Name"='C:\Windows\explorer.exe'))))
