-- OilRig APT Registry Persistence | T1053.005, T1071.004, T1112, T1543.003 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2018/TA/OilRig/registry_event_apt_oilrig_mar18.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Name") LIKE '%software\microsoft\windows\currentversion\ume' OR LOWER("Process Name") LIKE '%software\microsoft\windows\currentversion\ut') OR (LOWER("Target Process Name") LIKE '%software\microsoft\windows\currentversion\ume' OR LOWER("Target Process Name") LIKE '%software\microsoft\windows\currentversion\ut') OR (LOWER("Object Name") LIKE '%software\microsoft\windows\currentversion\ume' OR LOWER("Object Name") LIKE '%software\microsoft\windows\currentversion\ut'))
