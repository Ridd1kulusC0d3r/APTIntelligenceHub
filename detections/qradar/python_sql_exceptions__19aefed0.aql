-- Python SQL Exceptions | T1190 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/python/app_python_sql_exceptions.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%dataerror%' OR LOWER(UTF8(payload)) LIKE '%integrityerror%' OR LOWER(UTF8(payload)) LIKE '%programmingerror%' OR LOWER(UTF8(payload)) LIKE '%operationalerror%'
