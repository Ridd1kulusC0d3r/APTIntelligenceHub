-- ESXi Account Creation Via ESXCLI | T1059.012, T1136 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_esxcli_user_account_creation.yml
SELECT * FROM events WHERE devicetype=11 AND (LOWER("Process Path") LIKE '%/esxcli' OR LOWER("Process Name") LIKE '%/esxcli') AND (LOWER(Command) LIKE '%system %' AND LOWER(Command) LIKE '%account %' AND LOWER(Command) LIKE '%add %')
