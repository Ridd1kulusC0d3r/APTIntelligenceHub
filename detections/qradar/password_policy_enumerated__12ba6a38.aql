-- Password Policy Enumerated | T1201 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_password_policy_enumerated.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND "Event ID"=4661 AND "Rule Name" LIKE '%%%5392%' AND LOWER(UTF8(payload)) LIKE '%security account manager%'
