-- Modify Group Policy Settings - ScriptBlockLogging | T1484.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_modify_group_policy_settings.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER(Message) LIKE '%\software\policies\microsoft\windows\system%' AND (LOWER(Message) LIKE '%grouppolicyrefreshtimedc%' OR LOWER(Message) LIKE '%grouppolicyrefreshtimeoffsetdc%' OR LOWER(Message) LIKE '%grouppolicyrefreshtime%' OR LOWER(Message) LIKE '%grouppolicyrefreshtimeoffset%' OR LOWER(Message) LIKE '%enablesmartscreen%' OR LOWER(Message) LIKE '%shellsmartscreenlevel%')
