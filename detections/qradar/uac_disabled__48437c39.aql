-- UAC Disabled | T1548.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_uac_disable.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\microsoft\windows\currentversion\policies\system\enablelua%' OR LOWER("Target Process Name") LIKE '%\microsoft\windows\currentversion\policies\system\enablelua%' OR LOWER("Object Name") LIKE '%\microsoft\windows\currentversion\policies\system\enablelua%') AND LOWER(UTF8(payload)) LIKE '%dword (0x00000000)%'
