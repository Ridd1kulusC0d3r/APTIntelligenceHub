-- OpenCanary - HTTPPROXY Login Attempt | T1090 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/opencanary/opencanary_httpproxy_login_attempt.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%logtype%7001%'
