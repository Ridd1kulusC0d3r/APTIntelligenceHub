-- HackTool - CrackMapExec Execution | T1047, T1053, T1059.001, T1059.003, T1110, T1201 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_crackmapexec_execution.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\crackmapexec.exe' OR LOWER("Process Name") LIKE '%\crackmapexec.exe') OR LOWER(Command) LIKE '% -m pe_inject %' OR (LOWER(Command) LIKE '% --local-auth%' AND LOWER(Command) LIKE '% -u %' AND LOWER(Command) LIKE '% -x %') OR (LOWER(Command) LIKE '% --local-auth%' AND LOWER(Command) LIKE '% -u %' AND LOWER(Command) LIKE '% -p %' AND LOWER(Command) LIKE '% -h ''nthash''%') OR (LOWER(Command) LIKE '% mssql %' AND LOWER(Command) LIKE '% -u %' AND LOWER(Command) LIKE '% -p %' AND LOWER(Command) LIKE '% -m %' AND LOWER(Command) LIKE '% -d %') OR (LOWER(Command) LIKE '% smb %' AND LOWER(Command) LIKE '% -u %' AND LOWER(Command) LIKE '% -h %' AND LOWER(Command) LIKE '% -m %' AND LOWER(Command) LIKE '% -o %') OR (LOWER(Command) LIKE '% smb %' AND LOWER(Command) LIKE '% -u %' AND LOWER(Command) LIKE '% -p %' AND LOWER(Command) LIKE '% --local-auth%')) OR ((LOWER(Command) LIKE '% --local-auth%' AND LOWER(Command) LIKE '% -u %' AND LOWER(Command) LIKE '% -p %') AND (LOWER(Command) LIKE '% 10.%' AND LOWER(Command) LIKE '% 192.168.%' AND LOWER(Command) LIKE '%/24 %')))
