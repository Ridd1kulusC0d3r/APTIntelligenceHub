-- AD Object WriteDAC Access | T1222.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_ad_object_writedac_access.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND "Event ID"=4662 AND LOWER(UTF8(payload)) LIKE '%ds%' AND "Access Mask"='0x40000' AND ("Object Type" IN('19195a5b-6da0-11d0-afd3-00c04fd930c9', 'domainDNS'))
