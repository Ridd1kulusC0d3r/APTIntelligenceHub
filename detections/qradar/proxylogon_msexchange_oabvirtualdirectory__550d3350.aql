-- ProxyLogon MSExchange OabVirtualDirectory | T1587.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/msexchange/win_exchange_proxylogon_oabvirtualdir.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER(UTF8(payload)) LIKE '%oabvirtualdirectory%' AND LOWER(UTF8(payload)) LIKE '% -externalurl %') AND (LOWER(UTF8(payload)) LIKE '%eval(request%' OR LOWER(UTF8(payload)) LIKE '%http://f/<script%' OR LOWER(UTF8(payload)) LIKE '%"unsafe"};%' OR LOWER(UTF8(payload)) LIKE '%function page_load()%')
