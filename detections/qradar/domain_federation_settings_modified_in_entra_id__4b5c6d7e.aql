-- Domain Federation Settings Modified In Entra ID | T1484.002 | Hub | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%set domain authentication%' OR LOWER(UTF8(payload)) LIKE '%set federation settings on domain%' OR LOWER(UTF8(payload)) LIKE '%add unverified domain%'
