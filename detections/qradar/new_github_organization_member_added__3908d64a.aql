-- New Github Organization Member Added | T1136.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/github/audit/github_new_org_member.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%org.add_member%' OR LOWER(UTF8(payload)) LIKE '%org.invite_member%'
