-- Leviathan Registry Key Activity | T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2020/TA/Leviathan/registry_event_apt_leviathan.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\software\microsoft\windows\currentversion\run\ntkd%' OR LOWER("Target Process Name") LIKE '%\software\microsoft\windows\currentversion\run\ntkd%' OR LOWER("Object Name") LIKE '%\software\microsoft\windows\currentversion\run\ntkd%')
