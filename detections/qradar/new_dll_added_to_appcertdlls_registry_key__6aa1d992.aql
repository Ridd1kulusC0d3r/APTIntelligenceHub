-- New DLL Added to AppCertDlls Registry Key | T1546.009 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_new_dll_added_to_appcertdlls_registry_key.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (("Process Name"='HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\AppCertDlls' OR "Target Process Name"='HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\AppCertDlls' OR "Object Name"='HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\AppCertDlls') OR LOWER(UTF8(payload)) LIKE '%hklm\system\currentcontrolset\control\session manager\appcertdlls%')
