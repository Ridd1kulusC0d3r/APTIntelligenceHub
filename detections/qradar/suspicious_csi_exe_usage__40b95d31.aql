-- Suspicious Csi.exe Usage | T1072, T1218 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_csi_execution.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\csi.exe' OR LOWER("Process Path") LIKE '%\rcsi.exe') OR (LOWER("Process Name") LIKE '%\csi.exe' OR LOWER("Process Name") LIKE '%\rcsi.exe')) OR (Filename IN('csi.exe', 'rcsi.exe'))) AND LOWER(UTF8(payload)) LIKE '%microsoft corporation%'
