-- BloodHound Collection Files | T1059.001, T1069.001, T1069.002, T1087.001, T1087.002, T1482 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_bloodhound_collection.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Filename) LIKE '%bloodhound.zip' OR LOWER(Filename) LIKE '%_computers.json' OR LOWER(Filename) LIKE '%_containers.json' OR LOWER(Filename) LIKE '%_gpos.json' OR LOWER(Filename) LIKE '%_groups.json' OR LOWER(Filename) LIKE '%_ous.json' OR LOWER(Filename) LIKE '%_users.json') AND (NOT(((LOWER("Process Path") LIKE '%\svchost.exe' OR LOWER("Process Name") LIKE '%\svchost.exe') AND LOWER(Filename) LIKE 'c:\program files\windowsapps\microsoft.%' AND LOWER(Filename) LIKE '%\pocket_containers.json')))
