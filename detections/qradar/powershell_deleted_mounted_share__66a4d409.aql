-- PowerShell Deleted Mounted Share | T1070.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_susp_mounted_share_deletion.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Message) LIKE '%remove-smbshare%' OR LOWER(Message) LIKE '%remove-fileshare%') AND (NOT((LOWER(Message) LIKE '%fileshare.cdxml%' AND LOWER(Message) LIKE '%microsoft.powershell.core\export-modulemember%' AND LOWER(Message) LIKE '%root/microsoft/windows/storage/msft_fileshare%' AND LOWER(Message) LIKE '%objectmodelwrapper%' AND LOWER(Message) LIKE '%cmdletization.methodparameter%')))
