-- GUI Input Capture - macOS | T1056.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_gui_input_capture.yml
SELECT * FROM events WHERE devicetype=102 AND (LOWER("Process Path") LIKE '%/osascript' OR LOWER("Process Name") LIKE '%/osascript') AND (LOWER(Command) LIKE '%-e%' AND LOWER(Command) LIKE '%display%' AND LOWER(Command) LIKE '%dialog%' AND LOWER(Command) LIKE '%answer%') AND (LOWER(Command) LIKE '%admin%' OR LOWER(Command) LIKE '%administrator%' OR LOWER(Command) LIKE '%authenticate%' OR LOWER(Command) LIKE '%authentication%' OR LOWER(Command) LIKE '%credentials%' OR LOWER(Command) LIKE '%pass%' OR LOWER(Command) LIKE '%password%' OR LOWER(Command) LIKE '%unlock%')
