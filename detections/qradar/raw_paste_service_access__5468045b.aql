-- Raw Paste Service Access | T1071.001, T1102.001, T1102.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/web/proxy_generic/proxy_raw_paste_service_access.yml
SELECT * FROM events WHERE LOWER(URL) LIKE '%.paste.ee/r/%' OR LOWER(URL) LIKE '%.pastebin.com/raw/%' OR LOWER(URL) LIKE '%.hastebin.com/raw/%' OR LOWER(URL) LIKE '%.ghostbin.co/paste/%/raw/%' OR LOWER(URL) LIKE '%pastetext.net/%' OR LOWER(URL) LIKE '%pastebin.pl/%' OR LOWER(URL) LIKE '%paste.ee/%'
