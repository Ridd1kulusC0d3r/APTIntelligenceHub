-- PowerShell Profile Modification | T1546.013 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_powershell_profile.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Filename) LIKE '%\microsoft.powershell_profile.ps1' OR LOWER(Filename) LIKE '%\powershell\profile.ps1' OR LOWER(Filename) LIKE '%\program files\powershell\7-preview\profile.ps1' OR LOWER(Filename) LIKE '%\program files\powershell\7\profile.ps1' OR LOWER(Filename) LIKE '%\windows\system32\windowspowershell\v1.0\profile.ps1' OR LOWER(Filename) LIKE '%\windowspowershell\profile.ps1')
