-- PUA - PingCastle Execution From Potentially Suspicious Parent | T1595 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_pua_pingcastle_script_parent.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Parent Command") LIKE '%.bat%' OR LOWER("Parent Command") LIKE '%.chm%' OR LOWER("Parent Command") LIKE '%.cmd%' OR LOWER("Parent Command") LIKE '%.hta%' OR LOWER("Parent Command") LIKE '%.htm%' OR LOWER("Parent Command") LIKE '%.html%' OR LOWER("Parent Command") LIKE '%.js%' OR LOWER("Parent Command") LIKE '%.lnk%' OR LOWER("Parent Command") LIKE '%.ps1%' OR LOWER("Parent Command") LIKE '%.vbe%' OR LOWER("Parent Command") LIKE '%.vbs%' OR LOWER("Parent Command") LIKE '%.wsf%') OR (LOWER("Parent Command") LIKE '%:\perflogs\%' OR LOWER("Parent Command") LIKE '%:\temp\%' OR LOWER("Parent Command") LIKE '%:\users\public\%' OR LOWER("Parent Command") LIKE '%:\windows\temp\%' OR LOWER("Parent Command") LIKE '%\appdata\local\temp%' OR LOWER("Parent Command") LIKE '%\appdata\roaming\%' OR LOWER("Parent Command") LIKE '%\temporary internet%') OR ((LOWER("Parent Command") LIKE '%:\users\%' AND LOWER("Parent Command") LIKE '%\favorites\%') OR (LOWER("Parent Command") LIKE '%:\users\%' AND LOWER("Parent Command") LIKE '%\favourites\%') OR (LOWER("Parent Command") LIKE '%:\users\%' AND LOWER("Parent Command") LIKE '%\contacts\%'))) AND (LOWER("Parent Command") LIKE '%.bat%' OR LOWER("Parent Command") LIKE '%.chm%' OR LOWER("Parent Command") LIKE '%.cmd%' OR LOWER("Parent Command") LIKE '%.hta%' OR LOWER("Parent Command") LIKE '%.htm%' OR LOWER("Parent Command") LIKE '%.html%' OR LOWER("Parent Command") LIKE '%.js%' OR LOWER("Parent Command") LIKE '%.lnk%' OR LOWER("Parent Command") LIKE '%.ps1%' OR LOWER("Parent Command") LIKE '%.vbe%' OR LOWER("Parent Command") LIKE '%.vbs%' OR LOWER("Parent Command") LIKE '%.wsf%') AND ((LOWER("Process Path") LIKE '%\pingcastle.exe' OR LOWER("Process Name") LIKE '%\pingcastle.exe') OR Filename='PingCastle.exe' OR LOWER(UTF8(payload)) LIKE '%ping castle%' OR (LOWER(Command) LIKE '%--scanner aclcheck%' OR LOWER(Command) LIKE '%--scanner antivirus%' OR LOWER(Command) LIKE '%--scanner computerversion%' OR LOWER(Command) LIKE '%--scanner foreignusers%' OR LOWER(Command) LIKE '%--scanner laps_bitlocker%' OR LOWER(Command) LIKE '%--scanner localadmin%' OR LOWER(Command) LIKE '%--scanner nullsession%' OR LOWER(Command) LIKE '%--scanner nullsession-trust%' OR LOWER(Command) LIKE '%--scanner oxidbindings%' OR LOWER(Command) LIKE '%--scanner remote%' OR LOWER(Command) LIKE '%--scanner share%' OR LOWER(Command) LIKE '%--scanner smb%' OR LOWER(Command) LIKE '%--scanner smb3querynetwork%' OR LOWER(Command) LIKE '%--scanner spooler%' OR LOWER(Command) LIKE '%--scanner startup%' OR LOWER(Command) LIKE '%--scanner zerologon%') OR LOWER(Command) LIKE '%--no-enum-limit%' OR (LOWER(Command) LIKE '%--healthcheck%' AND LOWER(Command) LIKE '%--level full%') OR (LOWER(Command) LIKE '%--healthcheck%' AND LOWER(Command) LIKE '%--server %'))
