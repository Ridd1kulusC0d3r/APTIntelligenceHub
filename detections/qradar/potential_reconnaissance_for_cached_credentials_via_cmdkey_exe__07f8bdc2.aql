-- Potential Reconnaissance For Cached Credentials Via Cmdkey.EXE | T1003.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_cmdkey_recon.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\cmdkey.exe' OR LOWER("Process Name") LIKE '%\cmdkey.exe') OR Filename='cmdkey.exe') AND (LOWER(Command) LIKE '% -l%' OR LOWER(Command) LIKE '% /l%' OR LOWER(Command) LIKE '% –l%' OR LOWER(Command) LIKE '% —l%' OR LOWER(Command) LIKE '% ―l%')
