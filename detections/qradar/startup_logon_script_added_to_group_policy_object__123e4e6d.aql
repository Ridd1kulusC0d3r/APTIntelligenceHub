-- Startup/Logon Script Added to Group Policy Object | T1484.001, T1547 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_susp_group_policy_startup_script_added_to_gpo.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ("Event ID" IN('5136', '5145')) AND (((((Username IN('gPCMachineExtensionNames', 'gPCUserExtensionNames')) OR ("Account Name" IN('gPCMachineExtensionNames', 'gPCUserExtensionNames')) OR ("Distinguished Name" IN('gPCMachineExtensionNames', 'gPCUserExtensionNames'))) AND (LOWER("Attribute Old Value") LIKE '%42b5faae-6536-11d2-ae5a-0000f87571e3%' OR LOWER("Attribute New Value") LIKE '%42b5faae-6536-11d2-ae5a-0000f87571e3%')) AND ((LOWER("Attribute Old Value") LIKE '%40b6664f-4972-11d1-a7ca-0000f87571e3%' OR LOWER("Attribute Old Value") LIKE '%40b66650-4972-11d1-a7ca-0000f87571e3%') OR (LOWER("Attribute New Value") LIKE '%40b6664f-4972-11d1-a7ca-0000f87571e3%' OR LOWER("Attribute New Value") LIKE '%40b66650-4972-11d1-a7ca-0000f87571e3%'))) OR (LOWER("Share Name") LIKE '%\sysvol' AND (LOWER(UTF8(payload)) LIKE '%\scripts.ini%' OR LOWER(UTF8(payload)) LIKE '%\psscripts.ini%') AND "Rule Name" LIKE '%%%4417%'))
