-- Okta MFA Reset or Deactivated | T1556.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/identity/okta/okta_mfa_reset_or_deactivated.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=382 AND (LOWER(UTF8(payload)) LIKE '%user.mfa.factor.deactivate%' OR LOWER(UTF8(payload)) LIKE '%user.mfa.factor.reset_all%')
