-- Disabling Security Tools - Builtin | T1686 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/builtin/syslog/lnx_syslog_security_tools_disabling_syslog.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype IN(11, 12) AND (LOWER(UTF8(payload)) LIKE '%stopping iptables%' OR LOWER(UTF8(payload)) LIKE '%stopping ip6tables%' OR LOWER(UTF8(payload)) LIKE '%stopping firewalld%' OR LOWER(UTF8(payload)) LIKE '%stopping cbdaemon%' OR LOWER(UTF8(payload)) LIKE '%stopping falcon-sensor%')
