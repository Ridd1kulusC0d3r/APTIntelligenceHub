-- Forest Blizzard APT - Custom Protocol Handler DLL Registry Set | T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2024/TA/Forest-Blizzard/registry_set_apt_forest_blizzard_custom_protocol_handler_dll.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\clsid\{026cc6d7-34b2-33d5-b551-ca31eb6ce345}\server%' OR LOWER("Target Process Name") LIKE '%\clsid\{026cc6d7-34b2-33d5-b551-ca31eb6ce345}\server%' OR LOWER("Object Name") LIKE '%\clsid\{026cc6d7-34b2-33d5-b551-ca31eb6ce345}\server%') AND LOWER(UTF8(payload)) LIKE '%.dll%'
