-- Django Framework Exceptions | T1190 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/django/appframework_django_exceptions.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%suspiciousoperation%' OR LOWER(UTF8(payload)) LIKE '%disallowedhost%' OR LOWER(UTF8(payload)) LIKE '%disallowedmodeladminlookup%' OR LOWER(UTF8(payload)) LIKE '%disallowedmodeladmintofield%' OR LOWER(UTF8(payload)) LIKE '%disallowedredirect%' OR LOWER(UTF8(payload)) LIKE '%invalidsessionkey%' OR LOWER(UTF8(payload)) LIKE '%requestdatatoobig%' OR LOWER(UTF8(payload)) LIKE '%suspiciousfileoperation%' OR LOWER(UTF8(payload)) LIKE '%suspiciousmultipartform%' OR LOWER(UTF8(payload)) LIKE '%suspicioussession%' OR LOWER(UTF8(payload)) LIKE '%toomanyfieldssent%' OR LOWER(UTF8(payload)) LIKE '%permissiondenied%'
