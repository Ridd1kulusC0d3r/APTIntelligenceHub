-- Cisco Discovery | T1016, T1018, T1033, T1049, T1057, T1082, T1083, T1124, T1201 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/cisco/aaa/cisco_cli_discovery.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype IN(6, 143, 273, 274, 20, 23, 26, 30, 31, 419, 41, 429, 431, 179, 435, 437, 182, 183, 56, 316, 448, 194, 90, 94, 95, 113, 114, 115, 116, 117, 248, 250, 508) AND (LOWER(UTF8(payload)) LIKE '%dir%' OR LOWER(UTF8(payload)) LIKE '%show arp%' OR LOWER(UTF8(payload)) LIKE '%show cdp%' OR LOWER(UTF8(payload)) LIKE '%show clock%' OR LOWER(UTF8(payload)) LIKE '%show ip interface%' OR LOWER(UTF8(payload)) LIKE '%show ip route%' OR LOWER(UTF8(payload)) LIKE '%show ip sockets%' OR LOWER(UTF8(payload)) LIKE '%show processes%' OR LOWER(UTF8(payload)) LIKE '%show ssh%' OR LOWER(UTF8(payload)) LIKE '%show users%' OR LOWER(UTF8(payload)) LIKE '%show version%')
