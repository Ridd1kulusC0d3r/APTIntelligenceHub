-- Potential Pikabot Hollowing Activity | T1055.012 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/Malware/Pikabot/proc_creation_win_malware_pikabot_rundll32_hollowing.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Parent Process Path") LIKE '%\rundll32.exe' AND ((LOWER("Process Path") LIKE '%\searchfilterhost.exe' OR LOWER("Process Path") LIKE '%\searchprotocolhost.exe' OR LOWER("Process Path") LIKE '%\sndvol.exe' OR LOWER("Process Path") LIKE '%\wermgr.exe' OR LOWER("Process Path") LIKE '%\wwahost.exe') OR (LOWER("Process Name") LIKE '%\searchfilterhost.exe' OR LOWER("Process Name") LIKE '%\searchprotocolhost.exe' OR LOWER("Process Name") LIKE '%\sndvol.exe' OR LOWER("Process Name") LIKE '%\wermgr.exe' OR LOWER("Process Name") LIKE '%\wwahost.exe'))) AND (NOT(((LOWER("Process Path") LIKE '%\sndvol.exe' OR LOWER("Process Name") LIKE '%\sndvol.exe') AND LOWER("Parent Command") LIKE '%mmsys.cpl%')))
