-- Wmiexec Default Output File | T1047 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_wmiexec_default_filename.yml
SELECT * FROM events WHERE devicetype=12 AND (Filename MATCHES '\\Windows\\__1\d{9}\.\d{1,7}$' OR Filename MATCHES 'C:\\__1\d{9}\.\d{1,7}$' OR Filename MATCHES 'D:\\__1\d{9}\.\d{1,7}$')
