-- Web Server Process Spawning Shell Or Recon Commands (Webshell) | T1190, T1505.003 | Hub
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Parent Process Path") LIKE '%\w3wp.exe' OR LOWER("Parent Process Path") LIKE '%\tomcat.exe' OR LOWER("Parent Process Path") LIKE '%\tomcat8.exe' OR LOWER("Parent Process Path") LIKE '%\tomcat9.exe' OR LOWER("Parent Process Path") LIKE '%\java.exe' OR LOWER("Parent Process Path") LIKE '%\httpd.exe' OR LOWER("Parent Process Path") LIKE '%\nginx.exe' OR LOWER("Parent Process Path") LIKE '%\umworkerprocess.exe') AND ((LOWER("Process Path") LIKE '%\cmd.exe' OR LOWER("Process Path") LIKE '%\powershell.exe' OR LOWER("Process Path") LIKE '%\whoami.exe' OR LOWER("Process Path") LIKE '%\net.exe' OR LOWER("Process Path") LIKE '%\net1.exe' OR LOWER("Process Path") LIKE '%\nltest.exe' OR LOWER("Process Path") LIKE '%\certutil.exe' OR LOWER("Process Path") LIKE '%\rundll32.exe') OR (LOWER("Process Name") LIKE '%\cmd.exe' OR LOWER("Process Name") LIKE '%\powershell.exe' OR LOWER("Process Name") LIKE '%\whoami.exe' OR LOWER("Process Name") LIKE '%\net.exe' OR LOWER("Process Name") LIKE '%\net1.exe' OR LOWER("Process Name") LIKE '%\nltest.exe' OR LOWER("Process Name") LIKE '%\certutil.exe' OR LOWER("Process Name") LIKE '%\rundll32.exe'))
