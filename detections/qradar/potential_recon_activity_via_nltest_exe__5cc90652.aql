-- Potential Recon Activity Via Nltest.EXE | T1016, T1482 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_nltest_recon.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\nltest.exe' OR LOWER("Process Name") LIKE '%\nltest.exe') OR Filename='nltestrk.exe') AND ((LOWER(Command) LIKE '%server%' AND LOWER(Command) LIKE '%query%') OR (LOWER(Command) LIKE '%/user%' OR LOWER(Command) LIKE '%all_trusts%' OR LOWER(Command) LIKE '%dclist:%' OR LOWER(Command) LIKE '%dnsgetdc:%' OR LOWER(Command) LIKE '%domain_trusts%' OR LOWER(Command) LIKE '%dsgetdc:%' OR LOWER(Command) LIKE '%parentdomain%' OR LOWER(Command) LIKE '%trusted_domains%'))
