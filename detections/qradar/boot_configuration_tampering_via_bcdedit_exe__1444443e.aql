-- Boot Configuration Tampering Via Bcdedit.EXE | T1490 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_bcdedit_boot_conf_tamper.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\bcdedit.exe' OR LOWER("Process Name") LIKE '%\bcdedit.exe') OR Filename='bcdedit.exe') AND LOWER(Command) LIKE '%set%' AND ((LOWER(Command) LIKE '%bootstatuspolicy%' AND LOWER(Command) LIKE '%ignoreallfailures%') OR (LOWER(Command) LIKE '%recoveryenabled%' AND LOWER(Command) LIKE '%no%'))
