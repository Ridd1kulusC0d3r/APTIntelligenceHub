-- Registry Persistence Mechanisms in Recycle Bin | T1547 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_persistence_recycle_bin.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER(UTF8(payload)) LIKE '%renamekey%' AND LOWER(UTF8(payload)) LIKE '%\clsid\{645ff040-5081-101b-9f08-00aa002f954e}\shell\open%') OR (LOWER(UTF8(payload)) LIKE '%setvalue%' AND (LOWER("Process Name") LIKE '%\clsid\{645ff040-5081-101b-9f08-00aa002f954e}\shell\open\command\(default)%' OR LOWER("Target Process Name") LIKE '%\clsid\{645ff040-5081-101b-9f08-00aa002f954e}\shell\open\command\(default)%' OR LOWER("Object Name") LIKE '%\clsid\{645ff040-5081-101b-9f08-00aa002f954e}\shell\open\command\(default)%')))
