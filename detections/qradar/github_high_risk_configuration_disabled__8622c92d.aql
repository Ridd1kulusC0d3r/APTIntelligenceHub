-- Github High Risk Configuration Disabled | T1556 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/github/audit/github_disable_high_risk_configuration.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%business_advanced_security.disabled_for_new_repos%' OR LOWER(UTF8(payload)) LIKE '%business_advanced_security.disabled_for_new_user_namespace_repos%' OR LOWER(UTF8(payload)) LIKE '%business_advanced_security.disabled%' OR LOWER(UTF8(payload)) LIKE '%business_advanced_security.user_namespace_repos_disabled%' OR LOWER(UTF8(payload)) LIKE '%org.advanced_security_disabled_for_new_repos%' OR LOWER(UTF8(payload)) LIKE '%org.advanced_security_disabled_on_all_repos%' OR LOWER(UTF8(payload)) LIKE '%org.advanced_security_policy_selected_member_disabled%' OR LOWER(UTF8(payload)) LIKE '%org.disable_oauth_app_restrictions%' OR LOWER(UTF8(payload)) LIKE '%org.disable_two_factor_requirement%' OR LOWER(UTF8(payload)) LIKE '%repo.advanced_security_disabled%'
