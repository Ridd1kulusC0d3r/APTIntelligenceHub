-- PowerShell Set-Acl On Windows Folder - PsScript | T1222 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_set_acl_susp_location.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Message) LIKE '%set-acl %' AND LOWER(Message) LIKE '%-aclobject %') AND (LOWER(Message) LIKE '%-path "c:\windows%' OR LOWER(Message) LIKE '%-path "c:/windows%' OR LOWER(Message) LIKE '%-path ''c:\windows%' OR LOWER(Message) LIKE '%-path ''c:/windows%' OR LOWER(Message) LIKE '%-path c:\windows%' OR LOWER(Message) LIKE '%-path c:/windows%' OR LOWER(Message) LIKE '%-path $env:windir%' OR LOWER(Message) LIKE '%-path "$env:windir%' OR LOWER(Message) LIKE '%-path ''$env:windir%') AND (LOWER(Message) LIKE '%fullcontrol%' OR LOWER(Message) LIKE '%allow%')
