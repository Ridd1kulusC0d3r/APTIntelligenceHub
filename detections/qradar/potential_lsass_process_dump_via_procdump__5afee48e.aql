-- Potential LSASS Process Dump Via Procdump | T1003.001, T1036 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_sysinternals_procdump_lsass.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Command) LIKE '% -ma %' OR LOWER(Command) LIKE '% /ma %' OR LOWER(Command) LIKE '% –ma %' OR LOWER(Command) LIKE '% —ma %' OR LOWER(Command) LIKE '% ―ma %' OR LOWER(Command) LIKE '% -mm %' OR LOWER(Command) LIKE '% /mm %' OR LOWER(Command) LIKE '% –mm %' OR LOWER(Command) LIKE '% —mm %' OR LOWER(Command) LIKE '% ―mm %' OR LOWER(Command) LIKE '% -mp %' OR LOWER(Command) LIKE '% /mp %' OR LOWER(Command) LIKE '% –mp %' OR LOWER(Command) LIKE '% —mp %' OR LOWER(Command) LIKE '% ―mp %') AND (LOWER(Command) LIKE '% ls%' OR LOWER(Command) LIKE '% keyiso%' OR LOWER(Command) LIKE '% samss%')
