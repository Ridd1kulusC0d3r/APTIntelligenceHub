-- Potential In-Memory Execution Using Reflection.Assembly | T1620 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_dotnet_assembly_from_file.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER(Message) LIKE '%[reflection.assembly]::load%' AND (NOT(((LOWER("File Path") LIKE 'c:\program files (x86)\microsoft sql server\%' OR LOWER("File Path") LIKE 'c:\program files\microsoft sql server\%') AND LOWER("File Path") LIKE '%\tools\powershell\modules\sqlps\sqlpspostscript.ps1' AND LOWER(Message) LIKE '%sqlserver: { set-location%')))
