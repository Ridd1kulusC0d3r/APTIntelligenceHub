-- Sticky Key Like Backdoor Usage - Registry | T1546.008 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_stickykey_like_backdoor.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\sethc.exe\debugger' OR LOWER("Process Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\utilman.exe\debugger' OR LOWER("Process Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\osk.exe\debugger' OR LOWER("Process Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\magnify.exe\debugger' OR LOWER("Process Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\narrator.exe\debugger' OR LOWER("Process Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\displayswitch.exe\debugger' OR LOWER("Process Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\atbroker.exe\debugger' OR LOWER("Process Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\helppane.exe\debugger') OR (LOWER("Target Process Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\sethc.exe\debugger' OR LOWER("Target Process Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\utilman.exe\debugger' OR LOWER("Target Process Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\osk.exe\debugger' OR LOWER("Target Process Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\magnify.exe\debugger' OR LOWER("Target Process Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\narrator.exe\debugger' OR LOWER("Target Process Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\displayswitch.exe\debugger' OR LOWER("Target Process Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\atbroker.exe\debugger' OR LOWER("Target Process Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\helppane.exe\debugger') OR (LOWER("Object Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\sethc.exe\debugger' OR LOWER("Object Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\utilman.exe\debugger' OR LOWER("Object Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\osk.exe\debugger' OR LOWER("Object Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\magnify.exe\debugger' OR LOWER("Object Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\narrator.exe\debugger' OR LOWER("Object Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\displayswitch.exe\debugger' OR LOWER("Object Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\atbroker.exe\debugger' OR LOWER("Object Name") LIKE '%\software\microsoft\windows nt\currentversion\image file execution options\helppane.exe\debugger'))
