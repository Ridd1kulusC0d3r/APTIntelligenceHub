-- OilRig APT Schedule Task Persistence - System | T1053.005, T1071.004, T1112, T1543.003 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2018/TA/OilRig/win_system_apt_oilrig_mar18.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND LOWER(UTF8(payload)) LIKE '%service control manager%' AND "Event ID"=7045 AND ("Service Name" IN('SC Scheduled Scan', 'UpdatMachine'))
