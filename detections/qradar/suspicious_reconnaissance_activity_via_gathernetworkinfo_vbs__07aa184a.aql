-- Suspicious Reconnaissance Activity Via GatherNetworkInfo.VBS | T1059.005, T1615 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_gather_network_info_execution.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER(Command) LIKE '%gathernetworkinfo.vbs%' AND (NOT(((LOWER("Process Path") LIKE '%\cscript.exe' OR LOWER("Process Path") LIKE '%\wscript.exe') OR (LOWER("Process Name") LIKE '%\cscript.exe' OR LOWER("Process Name") LIKE '%\wscript.exe'))))
