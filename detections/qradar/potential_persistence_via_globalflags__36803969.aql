-- Potential Persistence Via GlobalFlags | T1546.012 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_persistence_globalflags.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Name") LIKE '%\microsoft\windows nt\currentversion\%' AND LOWER("Process Name") LIKE '%\image file execution options\%' AND LOWER("Process Name") LIKE '%\globalflag%') OR (LOWER("Target Process Name") LIKE '%\microsoft\windows nt\currentversion\%' AND LOWER("Target Process Name") LIKE '%\image file execution options\%' AND LOWER("Target Process Name") LIKE '%\globalflag%') OR (LOWER("Object Name") LIKE '%\microsoft\windows nt\currentversion\%' AND LOWER("Object Name") LIKE '%\image file execution options\%' AND LOWER("Object Name") LIKE '%\globalflag%')) OR (((LOWER("Process Name") LIKE '%\microsoft\windows nt\currentversion\%' AND LOWER("Process Name") LIKE '%\silentprocessexit\%') OR (LOWER("Target Process Name") LIKE '%\microsoft\windows nt\currentversion\%' AND LOWER("Target Process Name") LIKE '%\silentprocessexit\%') OR (LOWER("Object Name") LIKE '%\microsoft\windows nt\currentversion\%' AND LOWER("Object Name") LIKE '%\silentprocessexit\%')) AND ((LOWER("Process Name") LIKE '%\reportingmode%' OR LOWER("Process Name") LIKE '%\monitorprocess%') OR (LOWER("Target Process Name") LIKE '%\reportingmode%' OR LOWER("Target Process Name") LIKE '%\monitorprocess%') OR (LOWER("Object Name") LIKE '%\reportingmode%' OR LOWER("Object Name") LIKE '%\monitorprocess%'))))
