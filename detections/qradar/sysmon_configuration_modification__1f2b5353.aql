-- Sysmon Configuration Modification | T1564 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/sysmon/sysmon_config_modification_status.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER(UTF8(payload)) LIKE '%stopped%' OR LOWER(UTF8(payload)) LIKE '%sysmon config state changed%') AND (NOT(LOWER(UTF8(payload)) LIKE '%started%'))
