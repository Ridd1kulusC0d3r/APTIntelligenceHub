-- Suspicious File Characteristics Due to Missing Fields | T1059.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_file_characteristics.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER(UTF8(payload)) LIKE '%?%' AND LOWER(UTF8(payload)) LIKE '%?%') OR (LOWER(UTF8(payload)) LIKE '%?%' AND LOWER(UTF8(payload)) LIKE '%?%') OR (LOWER(UTF8(payload)) LIKE '%?%' AND LOWER(UTF8(payload)) LIKE '%?%')) AND (LOWER("Process Path") LIKE '%\downloads\%' OR LOWER("Process Name") LIKE '%\downloads\%')
