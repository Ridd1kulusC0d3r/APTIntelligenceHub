-- ShimCache Flush | T1112 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_rundll32_susp_shimcache_flush.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER(Command) LIKE '%rundll32%' AND LOWER(Command) LIKE '%apphelp.dll%') AND (LOWER(Command) LIKE '%shimflushcache%' OR LOWER(Command) LIKE '%#250%')) OR ((LOWER(Command) LIKE '%rundll32%' AND LOWER(Command) LIKE '%kernel32.dll%') AND (LOWER(Command) LIKE '%baseflushappcompatcache%' OR LOWER(Command) LIKE '%#46%')))
