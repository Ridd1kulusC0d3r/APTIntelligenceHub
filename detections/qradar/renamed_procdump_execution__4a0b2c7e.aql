-- Renamed ProcDump Execution | T1036.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_renamed_sysinternals_procdump.yml
SELECT * FROM events WHERE devicetype=12 AND (Filename='procdump' OR ((LOWER(Command) LIKE '% -ma %' OR LOWER(Command) LIKE '% /ma %' OR LOWER(Command) LIKE '% –ma %' OR LOWER(Command) LIKE '% —ma %' OR LOWER(Command) LIKE '% ―ma %' OR LOWER(Command) LIKE '% -mp %' OR LOWER(Command) LIKE '% /mp %' OR LOWER(Command) LIKE '% –mp %' OR LOWER(Command) LIKE '% —mp %' OR LOWER(Command) LIKE '% ―mp %') AND (LOWER(Command) LIKE '% -accepteula%' OR LOWER(Command) LIKE '% /accepteula%' OR LOWER(Command) LIKE '% –accepteula%' OR LOWER(Command) LIKE '% —accepteula%' OR LOWER(Command) LIKE '% ―accepteula%'))) AND (NOT(((LOWER("Process Path") LIKE '%\procdump.exe' OR LOWER("Process Path") LIKE '%\procdump64.exe' OR LOWER("Process Path") LIKE '%\procdump64a.exe') OR (LOWER("Process Name") LIKE '%\procdump.exe' OR LOWER("Process Name") LIKE '%\procdump64.exe' OR LOWER("Process Name") LIKE '%\procdump64a.exe'))))
