-- Okta User Account Locked Out | T1531 | https://github.com/SigmaHQ/sigma/blob/master/rules/identity/okta/okta_user_account_locked_out.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=382 AND LOWER(UTF8(payload)) LIKE '%max sign in attempts exceeded%'
