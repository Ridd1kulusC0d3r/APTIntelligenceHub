-- Password Protected ZIP File Opened (Suspicious Filenames) | T1027, T1036, T1105 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_susp_opened_encrypted_zip_filename.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ("Event ID"=5379 AND LOWER(UTF8(payload)) LIKE '%microsoft_windows_shell_zipfolder:filename%') AND (LOWER(UTF8(payload)) LIKE '%invoice%' OR LOWER(UTF8(payload)) LIKE '%new order%' OR LOWER(UTF8(payload)) LIKE '%rechnung%' OR LOWER(UTF8(payload)) LIKE '%factura%' OR LOWER(UTF8(payload)) LIKE '%delivery%' OR LOWER(UTF8(payload)) LIKE '%purchase%' OR LOWER(UTF8(payload)) LIKE '%order%' OR LOWER(UTF8(payload)) LIKE '%payment%')
