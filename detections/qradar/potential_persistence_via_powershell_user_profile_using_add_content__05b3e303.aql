-- Potential Persistence Via PowerShell User Profile Using Add-Content | T1546.013 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_user_profile_tampering.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER(Message) LIKE '%add-content $profile%' AND (LOWER(Message) LIKE '%-value "iex %' OR LOWER(Message) LIKE '%-value "invoke-expression%' OR LOWER(Message) LIKE '%-value "invoke-webrequest%' OR LOWER(Message) LIKE '%-value "start-process%' OR LOWER(Message) LIKE '%-value ''iex %' OR LOWER(Message) LIKE '%-value ''invoke-expression%' OR LOWER(Message) LIKE '%-value ''invoke-webrequest%' OR LOWER(Message) LIKE '%-value ''start-process%')
