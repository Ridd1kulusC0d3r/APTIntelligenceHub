-- FileFix - Command Evidence in TypedPaths | T1204.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_filefix_typedpath_commands.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Name") LIKE '%\software\microsoft\windows\currentversion\explorer\typedpaths\url1' OR LOWER("Target Process Name") LIKE '%\software\microsoft\windows\currentversion\explorer\typedpaths\url1' OR LOWER("Object Name") LIKE '%\software\microsoft\windows\currentversion\explorer\typedpaths\url1') AND (LOWER(UTF8(payload)) LIKE '%#%' AND LOWER(UTF8(payload)) LIKE '%http%')) AND ((LOWER(UTF8(payload)) LIKE '%account%' OR LOWER(UTF8(payload)) LIKE '%anti-bot%' OR LOWER(UTF8(payload)) LIKE '%botcheck%' OR LOWER(UTF8(payload)) LIKE '%captcha%' OR LOWER(UTF8(payload)) LIKE '%challenge%' OR LOWER(UTF8(payload)) LIKE '%confirmation%' OR LOWER(UTF8(payload)) LIKE '%fraud%' OR LOWER(UTF8(payload)) LIKE '%human%' OR LOWER(UTF8(payload)) LIKE '%identification%' OR LOWER(UTF8(payload)) LIKE '%identificator%' OR LOWER(UTF8(payload)) LIKE '%identity%' OR LOWER(UTF8(payload)) LIKE '%robot%' OR LOWER(UTF8(payload)) LIKE '%validation%' OR LOWER(UTF8(payload)) LIKE '%verification%' OR LOWER(UTF8(payload)) LIKE '%verify%') OR (LOWER(UTF8(payload)) LIKE '%%comspec%%' OR LOWER(UTF8(payload)) LIKE '%bitsadmin%' OR LOWER(UTF8(payload)) LIKE '%certutil%' OR LOWER(UTF8(payload)) LIKE '%cmd%' OR LOWER(UTF8(payload)) LIKE '%cscript%' OR LOWER(UTF8(payload)) LIKE '%curl%' OR LOWER(UTF8(payload)) LIKE '%finger%' OR LOWER(UTF8(payload)) LIKE '%mshta%' OR LOWER(UTF8(payload)) LIKE '%powershell%' OR LOWER(UTF8(payload)) LIKE '%pwsh%' OR LOWER(UTF8(payload)) LIKE '%regsvr32%' OR LOWER(UTF8(payload)) LIKE '%rundll32%' OR LOWER(UTF8(payload)) LIKE '%schtasks%' OR LOWER(UTF8(payload)) LIKE '%wget%' OR LOWER(UTF8(payload)) LIKE '%wscript%'))
