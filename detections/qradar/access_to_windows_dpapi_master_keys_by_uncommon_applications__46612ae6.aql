-- Access To Windows DPAPI Master Keys By Uncommon Applications | T1555.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_access/file_access_win_susp_dpapi_master_key_access.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Filename) LIKE '%\microsoft\protect\s-1-5-18\%' OR LOWER(Filename) LIKE '%\microsoft\protect\s-1-5-21-%') AND (NOT((((LOWER("Process Path") LIKE 'c:\program files\%' OR LOWER("Process Path") LIKE 'c:\program files (x86)\%' OR LOWER("Process Path") LIKE 'c:\windows\system32\%' OR LOWER("Process Path") LIKE 'c:\windows\syswow64\%') OR (LOWER("Process Name") LIKE 'c:\program files\%' OR LOWER("Process Name") LIKE 'c:\program files (x86)\%' OR LOWER("Process Name") LIKE 'c:\windows\system32\%' OR LOWER("Process Name") LIKE 'c:\windows\syswow64\%')) OR ("Process Path"='C:\Windows\explorer.exe' OR "Process Name"='C:\Windows\explorer.exe'))))
