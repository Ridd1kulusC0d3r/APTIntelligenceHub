-- Password Policy Discovery - Linux | T1201 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/lnx_auditd_password_policy_discovery.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND ((LOWER(UTF8(payload)) LIKE '%path%' AND (LOWER(UTF8(payload)) LIKE '%/etc/login.defs%' OR LOWER(UTF8(payload)) LIKE '%/etc/pam.d/auth%' OR LOWER(UTF8(payload)) LIKE '%/etc/pam.d/common-account%' OR LOWER(UTF8(payload)) LIKE '%/etc/pam.d/common-auth%' OR LOWER(UTF8(payload)) LIKE '%/etc/pam.d/common-password%' OR LOWER(UTF8(payload)) LIKE '%/etc/pam.d/system-auth%' OR LOWER(UTF8(payload)) LIKE '%/etc/security/pwquality.conf%')) OR (LOWER(UTF8(payload)) LIKE '%execve%' AND LOWER(Command) LIKE '%a0%chage%' AND (LOWER(Command) LIKE '%a1%--list%' OR LOWER(Command) LIKE '%-l%')) OR (LOWER(UTF8(payload)) LIKE '%execve%' AND LOWER(Command) LIKE '%a0%passwd%' AND (LOWER(Command) LIKE '%a1%-s%' OR LOWER(Command) LIKE '%--status%')))
