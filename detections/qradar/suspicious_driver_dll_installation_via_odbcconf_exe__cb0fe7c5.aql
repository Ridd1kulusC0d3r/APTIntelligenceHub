-- Suspicious Driver/DLL Installation Via Odbcconf.EXE | T1218.008 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_odbcconf_driver_install_susp.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\odbcconf.exe' OR LOWER("Process Name") LIKE '%\odbcconf.exe') OR Filename='odbcconf.exe') AND LOWER(Command) LIKE '%installdriver %') AND (NOT(LOWER(Command) LIKE '%.dll%'))
