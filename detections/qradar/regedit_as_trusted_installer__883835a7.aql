-- Regedit as Trusted Installer | T1548 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_regedit_trustedinstaller.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Path") LIKE '%\regedit.exe' OR LOWER("Process Name") LIKE '%\regedit.exe') AND (LOWER("Parent Process Path") LIKE '%\trustedinstaller.exe' OR LOWER("Parent Process Path") LIKE '%\processhacker.exe')
