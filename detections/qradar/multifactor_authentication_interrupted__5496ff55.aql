-- Multifactor Authentication Interrupted | T1078.004, T1110, T1621 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/azure/signin_logs/azure_mfa_interrupted.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE (LOWER(UTF8(payload)) LIKE '%resulttype%50074%' AND LOWER(UTF8(payload)) LIKE '%strong auth required%') OR (LOWER(UTF8(payload)) LIKE '%resulttype%500121%' AND LOWER(UTF8(payload)) LIKE '%authentication failed during strong authentication request%')
