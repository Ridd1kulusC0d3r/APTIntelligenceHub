-- Custom File Open Handler Executes PowerShell | T1202 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_custom_file_open_handler_powershell_execution.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%shell\open\command\%' OR LOWER("Target Process Name") LIKE '%shell\open\command\%' OR LOWER("Object Name") LIKE '%shell\open\command\%') AND (LOWER(UTF8(payload)) LIKE '%powershell%' AND LOWER(UTF8(payload)) LIKE '%-command%')
