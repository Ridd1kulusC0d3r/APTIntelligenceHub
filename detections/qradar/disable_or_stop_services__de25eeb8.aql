-- Disable Or Stop Services | T1489, T1685 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_services_stop_and_disable.yml
SELECT * FROM events WHERE devicetype=11 AND (((LOWER("Process Path") LIKE '%/service' OR LOWER("Process Path") LIKE '%/systemctl' OR LOWER("Process Path") LIKE '%/chkconfig') OR (LOWER("Process Name") LIKE '%/service' OR LOWER("Process Name") LIKE '%/systemctl' OR LOWER("Process Name") LIKE '%/chkconfig')) AND (LOWER(Command) LIKE '% stop %' OR LOWER(Command) LIKE '% disable %')) AND (NOT((((LOWER("Process Path") LIKE '%/systemctl' OR LOWER("Process Name") LIKE '%/systemctl') AND (LOWER(Command) LIKE '%--no-reload disable snap-snapd-%' OR LOWER(Command) LIKE '% stop snap-snapd-%')) OR ((LOWER("Process Path") LIKE '%/systemctl' OR LOWER("Process Name") LIKE '%/systemctl') AND LOWER("Parent Command") LIKE '%tmp.ci/preinst upgrade%' AND (LOWER(Command) LIKE '% stop %' AND LOWER(Command) LIKE '%ssh.%')) OR (LOWER("Parent Command") LIKE '%/dpkg/info/ubuntu-pro-client.prerm upgrade%' AND (LOWER("Process Path") LIKE '%/systemctl' OR LOWER("Process Name") LIKE '%/systemctl'))))) AND (NOT(((LOWER("Process Path") LIKE '%/systemctl' OR LOWER("Process Name") LIKE '%/systemctl') AND LOWER(Command) LIKE '%snap.amazon-ssm-agent.amazon-ssm-agent.service')))
