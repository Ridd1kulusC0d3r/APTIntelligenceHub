-- Potential Sidecar Injection Into Running Deployment | T1609 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/kubernetes/audit/kubernetes_audit_sidecar_injection.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%patch%' AND LOWER(UTF8(payload)) LIKE '%apps%' AND LOWER(UTF8(payload)) LIKE '%deployments%'
