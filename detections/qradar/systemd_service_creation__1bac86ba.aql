-- Systemd Service Creation | T1543.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/path/lnx_auditd_systemd_service_creation.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND (LOWER(UTF8(payload)) LIKE '%path%' AND LOWER(UTF8(payload)) LIKE '%create%') AND ((LOWER(UTF8(payload)) LIKE '%/usr/lib/systemd/system/%' OR LOWER(UTF8(payload)) LIKE '%/etc/systemd/system/%') OR LOWER(UTF8(payload)) LIKE '%/.config/systemd/user/%')
