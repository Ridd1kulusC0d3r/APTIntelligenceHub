-- VBScript Payload Stored in Registry | T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_vbs_payload_stored.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Name") LIKE '%software\microsoft\windows\currentversion%' OR LOWER("Target Process Name") LIKE '%software\microsoft\windows\currentversion%' OR LOWER("Object Name") LIKE '%software\microsoft\windows\currentversion%') AND (LOWER(UTF8(payload)) LIKE '%vbscript:%' OR LOWER(UTF8(payload)) LIKE '%jscript:%' OR LOWER(UTF8(payload)) LIKE '%mshtml,%' OR LOWER(UTF8(payload)) LIKE '%runhtmlapplication%' OR LOWER(UTF8(payload)) LIKE '%execute(%' OR LOWER(UTF8(payload)) LIKE '%createobject%' OR LOWER(UTF8(payload)) LIKE '%window.close%')) AND (NOT(((LOWER("Process Name") LIKE '%software\microsoft\windows\currentversion\run%' OR LOWER("Target Process Name") LIKE '%software\microsoft\windows\currentversion\run%' OR LOWER("Object Name") LIKE '%software\microsoft\windows\currentversion\run%') OR ((LOWER("Process Path") LIKE '%\msiexec.exe' OR LOWER("Process Name") LIKE '%\msiexec.exe') AND (LOWER("Process Name") LIKE '%\software\microsoft\windows\currentversion\installer\userdata\%' OR LOWER("Target Process Name") LIKE '%\software\microsoft\windows\currentversion\installer\userdata\%' OR LOWER("Object Name") LIKE '%\software\microsoft\windows\currentversion\installer\userdata\%') AND (LOWER(UTF8(payload)) LIKE '%\microsoft.net\primary interop assemblies\microsoft.mshtml.dll%' OR LOWER(UTF8(payload)) LIKE '%<\microsoft.mshtml,fileversion=%' OR LOWER(UTF8(payload)) LIKE '%_mshtml_dll_%' OR LOWER(UTF8(payload)) LIKE '%<\microsoft.mshtml,culture=%')))))
