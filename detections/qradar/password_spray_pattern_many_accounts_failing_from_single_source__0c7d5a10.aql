-- Password Spray Pattern - Many Accounts Failing From Single Source | T1110.003 | Hub | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%resulttype%50126%' OR LOWER(UTF8(payload)) LIKE '%resulttype%50053%'
