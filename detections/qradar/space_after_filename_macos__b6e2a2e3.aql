-- Space After Filename - macOS | T1036.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_space_after_filename.yml
SELECT * FROM events WHERE devicetype=102 AND (LOWER(Command) LIKE '% ' OR (LOWER("Process Path") LIKE '% ' OR LOWER("Process Name") LIKE '% '))
