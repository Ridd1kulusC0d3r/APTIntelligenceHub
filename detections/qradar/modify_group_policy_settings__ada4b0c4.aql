-- Modify Group Policy Settings | T1484.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_reg_modify_group_policy_settings.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\reg.exe' OR LOWER("Process Name") LIKE '%\reg.exe') OR Filename='reg.exe') AND LOWER(Command) LIKE '%\software\policies\microsoft\windows\system%' AND (LOWER(Command) LIKE '%grouppolicyrefreshtimedc%' OR LOWER(Command) LIKE '%grouppolicyrefreshtimeoffsetdc%' OR LOWER(Command) LIKE '%grouppolicyrefreshtime%' OR LOWER(Command) LIKE '%grouppolicyrefreshtimeoffset%' OR LOWER(Command) LIKE '%enablesmartscreen%' OR LOWER(Command) LIKE '%shellsmartscreenlevel%')
