-- Suspicious SYSTEM User Process Creation | T1003, T1027, T1134 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_system_user_anomaly.yml
SELECT * FROM events WHERE devicetype=12 AND (((("Integrity Level" IN('System', 'S-1-16-16384')) AND (LOWER(Username) LIKE '%authori%' OR LOWER(Username) LIKE '%autori%')) AND (((LOWER("Process Path") LIKE '%\calc.exe' OR LOWER("Process Path") LIKE '%\cscript.exe' OR LOWER("Process Path") LIKE '%\forfiles.exe' OR LOWER("Process Path") LIKE '%\hh.exe' OR LOWER("Process Path") LIKE '%\mshta.exe' OR LOWER("Process Path") LIKE '%\ping.exe' OR LOWER("Process Path") LIKE '%\wscript.exe') OR (LOWER("Process Name") LIKE '%\calc.exe' OR LOWER("Process Name") LIKE '%\cscript.exe' OR LOWER("Process Name") LIKE '%\forfiles.exe' OR LOWER("Process Name") LIKE '%\hh.exe' OR LOWER("Process Name") LIKE '%\mshta.exe' OR LOWER("Process Name") LIKE '%\ping.exe' OR LOWER("Process Name") LIKE '%\wscript.exe')) OR Command MATCHES 'net\s+user\s+' OR (LOWER(Command) LIKE '% -nop %' OR LOWER(Command) LIKE '% -w hidden %' OR LOWER(Command) LIKE '% -decode %' OR LOWER(Command) LIKE '% /decode %' OR LOWER(Command) LIKE '% /urlcache %' OR LOWER(Command) LIKE '% -urlcache %' OR LOWER(Command) LIKE '% -e% jab%' OR LOWER(Command) LIKE '% -e% suvyi%' OR LOWER(Command) LIKE '% -e% sqbfafga%' OR LOWER(Command) LIKE '% -e% awv4i%' OR LOWER(Command) LIKE '% -e% iab%' OR LOWER(Command) LIKE '% -e% paa%' OR LOWER(Command) LIKE '% -e% aqblahga%' OR LOWER(Command) LIKE '%vssadmin delete shadows%' OR LOWER(Command) LIKE '%reg save hklm%' OR LOWER(Command) LIKE '% -ma %' OR LOWER(Command) LIKE '%microsoft\windows\currentversion\run%' OR LOWER(Command) LIKE '%.downloadstring(%' OR LOWER(Command) LIKE '%.downloadfile(%' OR LOWER(Command) LIKE '% /ticket:%' OR LOWER(Command) LIKE '%dpapi::%' OR LOWER(Command) LIKE '%event::clear%' OR LOWER(Command) LIKE '%event::drop%' OR LOWER(Command) LIKE '%id::modify%' OR LOWER(Command) LIKE '%kerberos::%' OR LOWER(Command) LIKE '%lsadump::%' OR LOWER(Command) LIKE '%misc::%' OR LOWER(Command) LIKE '%privilege::%' OR LOWER(Command) LIKE '%rpc::%' OR LOWER(Command) LIKE '%sekurlsa::%' OR LOWER(Command) LIKE '%sid::%' OR LOWER(Command) LIKE '%token::%' OR LOWER(Command) LIKE '%vault::cred%' OR LOWER(Command) LIKE '%vault::list%' OR LOWER(Command) LIKE '% p::d %' OR LOWER(Command) LIKE '%;iex(%' OR LOWER(Command) LIKE '%minidump%'))) AND (NOT(((LOWER(Command) LIKE '%ping%' AND LOWER(Command) LIKE '%127.0.0.1%' AND LOWER(Command) LIKE '% -n %') OR ((LOWER("Process Path") LIKE '%\ping.exe' OR LOWER("Process Name") LIKE '%\ping.exe') AND LOWER("Parent Command") LIKE '%\dismfodinstall.cmd%') OR LOWER("Parent Process Path") LIKE '%:\packages\plugins\microsoft.guestconfiguration.configurationforwindows\%' OR ((LOWER("Parent Process Path") LIKE '%:\program files (x86)\java\%' OR LOWER("Parent Process Path") LIKE '%:\program files\java\%') AND LOWER("Parent Process Path") LIKE '%\bin\javaws.exe' AND ((LOWER("Process Path") LIKE '%:\program files (x86)\java\%' OR LOWER("Process Path") LIKE '%:\program files\java\%') OR (LOWER("Process Name") LIKE '%:\program files (x86)\java\%' OR LOWER("Process Name") LIKE '%:\program files\java\%')) AND (LOWER("Process Path") LIKE '%\bin\jp2launcher.exe' OR LOWER("Process Name") LIKE '%\bin\jp2launcher.exe') AND LOWER(Command) LIKE '% -ma %')))))
