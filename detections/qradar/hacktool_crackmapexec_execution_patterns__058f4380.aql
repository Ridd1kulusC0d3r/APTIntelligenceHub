-- HackTool - CrackMapExec Execution Patterns | T1047, T1053, T1059.001, T1059.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_crackmapexec_execution_patterns.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Command) LIKE '%cmd.exe /q /c % 1> \\%\%\% 2>&1%' OR LOWER(Command) LIKE '%cmd.exe /c % > \\%\%\% 2>&1%' OR LOWER(Command) LIKE '%cmd.exe /c % > %\temp\% 2>&1%' OR LOWER(Command) LIKE '%powershell.exe -exec bypass -noni -nop -w 1 -c "%' OR LOWER(Command) LIKE '%powershell.exe -noni -nop -w 1 -enc %')
