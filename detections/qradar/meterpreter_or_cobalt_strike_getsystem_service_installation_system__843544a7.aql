-- Meterpreter or Cobalt Strike Getsystem Service Installation - System | T1134.001, T1134.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/service_control_manager/win_system_meterpreter_or_cobaltstrike_getsystem_service_installation.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER(UTF8(payload)) LIKE '%service control manager%' AND "Event ID"=7045) AND (((LOWER("Process Path") LIKE '%/c%' AND LOWER("Process Path") LIKE '%echo%' AND LOWER("Process Path") LIKE '%\pipe\%') AND (LOWER("Process Path") LIKE '%cmd%' OR LOWER("Process Path") LIKE '%%comspec%%')) OR (LOWER("Process Path") LIKE '%rundll32%' AND LOWER("Process Path") LIKE '%.dll,a%' AND LOWER("Process Path") LIKE '%/p:%') OR LOWER("Process Path") LIKE '\\127.0.0.1\admin$\%')
