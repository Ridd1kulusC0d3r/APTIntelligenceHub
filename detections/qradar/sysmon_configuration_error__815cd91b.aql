-- Sysmon Configuration Error | T1564 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/sysmon/sysmon_config_modification_error.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER(UTF8(payload)) LIKE '%failed to open service configuration with error%' OR LOWER(UTF8(payload)) LIKE '%failed to connect to the driver to update configuration%') AND (NOT(((LOWER(UTF8(payload)) LIKE '%failed to open service configuration with error%' AND LOWER(UTF8(payload)) LIKE '%last error: the media is write protected.%') OR (LOWER(UTF8(payload)) LIKE '%failed to open service configuration with error%' AND LOWER(UTF8(payload)) LIKE '%last error: média protégé en écriture.%') OR (LOWER(UTF8(payload)) LIKE '%failed to open service configuration with error 19%' OR LOWER(UTF8(payload)) LIKE '%failed to open service configuration with error 93%'))))
