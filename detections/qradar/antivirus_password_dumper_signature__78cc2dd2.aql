-- Antivirus - Password Dumper Signature | T1003, T1003.001, T1003.002, T1558 | https://github.com/SigmaHQ/sigma/blob/master/rules/category/antivirus/av_password_dumper.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%pws%' OR (LOWER(UTF8(payload)) LIKE '%certify%' OR LOWER(UTF8(payload)) LIKE '%dcsync%' OR LOWER(UTF8(payload)) LIKE '%creddump%' OR LOWER(UTF8(payload)) LIKE '%dumpcreds%' OR LOWER(UTF8(payload)) LIKE '%dumplsass%' OR LOWER(UTF8(payload)) LIKE '%dumppert%' OR LOWER(UTF8(payload)) LIKE '%formbook%' OR LOWER(UTF8(payload)) LIKE '%htool/wce%' OR LOWER(UTF8(payload)) LIKE '%kekeo%' OR LOWER(UTF8(payload)) LIKE '%lazagne%' OR LOWER(UTF8(payload)) LIKE '%lsassdump%' OR LOWER(UTF8(payload)) LIKE '%lummast%' OR LOWER(UTF8(payload)) LIKE '%mimikatz%' OR LOWER(UTF8(payload)) LIKE '%multidump%' OR LOWER(UTF8(payload)) LIKE '%multiverze%' OR LOWER(UTF8(payload)) LIKE '%nanodump%' OR LOWER(UTF8(payload)) LIKE '%nativedump%' OR LOWER(UTF8(payload)) LIKE '%outflank%' OR LOWER(UTF8(payload)) LIKE '%pshlspy%' OR LOWER(UTF8(payload)) LIKE '%pswtool%' OR LOWER(UTF8(payload)) LIKE '%pwcrack%' OR LOWER(UTF8(payload)) LIKE '%pwdump%' OR LOWER(UTF8(payload)) LIKE '%pws.%' OR LOWER(UTF8(payload)) LIKE '%pwsx%' OR LOWER(UTF8(payload)) LIKE '%pypykatz%' OR LOWER(UTF8(payload)) LIKE '%rubeus%' OR LOWER(UTF8(payload)) LIKE '%safetykatz%' OR LOWER(UTF8(payload)) LIKE '%securitytool%' OR LOWER(UTF8(payload)) LIKE '%sharpchrome%' OR LOWER(UTF8(payload)) LIKE '%sharpdpapi%' OR LOWER(UTF8(payload)) LIKE '%sharpdump%' OR LOWER(UTF8(payload)) LIKE '%sharpkatz%' OR LOWER(UTF8(payload)) LIKE '%sharps.%' OR LOWER(UTF8(payload)) LIKE '%shpkatz%' OR LOWER(UTF8(payload)) LIKE '%steal%' OR LOWER(UTF8(payload)) LIKE '%trickdump%' OR LOWER(UTF8(payload)) LIKE '%wsass%')
