-- Shell Open Registry Keys Manipulation | T1546.001, T1548.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_shell_open_keys_manipulation.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER(UTF8(payload)) LIKE '%setvalue%' AND (LOWER("Process Name") LIKE '%classes\ms-settings\shell\open\command\symboliclinkvalue' OR LOWER("Target Process Name") LIKE '%classes\ms-settings\shell\open\command\symboliclinkvalue' OR LOWER("Object Name") LIKE '%classes\ms-settings\shell\open\command\symboliclinkvalue') AND LOWER(UTF8(payload)) LIKE '%\software\classes\{%') OR (LOWER("Process Name") LIKE '%classes\ms-settings\shell\open\command\delegateexecute' OR LOWER("Target Process Name") LIKE '%classes\ms-settings\shell\open\command\delegateexecute' OR LOWER("Object Name") LIKE '%classes\ms-settings\shell\open\command\delegateexecute') OR (LOWER(UTF8(payload)) LIKE '%setvalue%' AND ((LOWER("Process Name") LIKE '%classes\ms-settings\shell\open\command\(default)' OR LOWER("Process Name") LIKE '%classes\exefile\shell\open\command\(default)') OR (LOWER("Target Process Name") LIKE '%classes\ms-settings\shell\open\command\(default)' OR LOWER("Target Process Name") LIKE '%classes\exefile\shell\open\command\(default)') OR (LOWER("Object Name") LIKE '%classes\ms-settings\shell\open\command\(default)' OR LOWER("Object Name") LIKE '%classes\exefile\shell\open\command\(default)')))) AND (NOT((LOWER(UTF8(payload)) LIKE '%(empty)%' OR (LOWER(UTF8(payload)) LIKE '%{4813071a-41ad-44a2-9835-886d2f63ca30}%' OR LOWER(UTF8(payload)) LIKE '%{a56a841f-e974-45c1-8001-7e3f8a085917}%' OR LOWER(UTF8(payload)) LIKE '%{4ed3a719-cea8-4bd9-910d-e252f997afc2}%' OR LOWER(UTF8(payload)) LIKE '%{bfec0c93-0b7d-4f2c-b09c-afffc4bdae78}%'))))
