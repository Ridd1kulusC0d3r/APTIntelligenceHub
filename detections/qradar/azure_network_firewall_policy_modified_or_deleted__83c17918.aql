-- Azure Network Firewall Policy Modified or Deleted | T1686.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/azure/activity_logs/azure_network_firewall_policy_modified_or_deleted.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%microsoft.network/firewallpolicies/write%' OR LOWER(UTF8(payload)) LIKE '%microsoft.network/firewallpolicies/join/action%' OR LOWER(UTF8(payload)) LIKE '%microsoft.network/firewallpolicies/certificates/action%' OR LOWER(UTF8(payload)) LIKE '%microsoft.network/firewallpolicies/delete%'
