-- Local Account Created And Added To Administrators Via Net Command | T1136.001 | Hub
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\net.exe' OR LOWER("Process Path") LIKE '%\net1.exe') OR (LOWER("Process Name") LIKE '%\net.exe' OR LOWER("Process Name") LIKE '%\net1.exe')) AND (LOWER(Command) LIKE '%localgroup%' AND LOWER(Command) LIKE '%admin%' AND LOWER(Command) LIKE '%/add%')
