-- Diamond Sleet APT Scheduled Task Creation | T1053.005 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/TA/Diamond-Sleet/win_security_apt_diamond_sleet_scheduled_task.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND "Event ID"=4698 AND "Task Name"='\Windows TeamCity Settings User Interface' AND LOWER(UTF8(payload)) LIKE '%utynkfkxhizrx3kj%'
