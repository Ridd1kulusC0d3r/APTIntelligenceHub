-- HackTool - PCHunter Execution | T1007, T1012, T1057, T1082, T1083 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_pchunter.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\pchunter64.exe' OR LOWER("Process Path") LIKE '%\pchunter32.exe') OR (LOWER("Process Name") LIKE '%\pchunter64.exe' OR LOWER("Process Name") LIKE '%\pchunter32.exe')) OR (Filename='PCHunter.exe' OR LOWER(UTF8(payload)) LIKE '%epoolsoft windows information view tools%') OR (LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%sha1=5f1cbc3d99558307bc1250d084fa968521482025%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%md5=987b65cd9b9f4e9a1afd8f8b48cf64a7%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%sha256=2b214bddaab130c274de6204af6dba5aeec7433da99aa950022fa306421a6d32%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=444d210cea1ff8112f256a4997eed7ff%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%sha1=3fb89787cb97d902780da080545584d97fb1c2eb%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%md5=228dd0c2e6287547e26ffbd973a40f14%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%sha256=55f041bf4e78e9bfa6d4ee68be40e496ce3a1353e1ca4306598589e19802522c%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=0479f44df47cfa2ef1ccc4416a538663%'))
