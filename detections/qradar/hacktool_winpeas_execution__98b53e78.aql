-- HackTool - winPEAS Execution | T1046, T1082, T1087 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_winpeas.yml
SELECT * FROM events WHERE devicetype=12 AND ((Filename='winPEAS.exe' OR ((LOWER("Process Path") LIKE '%\winpeasany_ofs.exe' OR LOWER("Process Path") LIKE '%\winpeasany.exe' OR LOWER("Process Path") LIKE '%\winpeasx64_ofs.exe' OR LOWER("Process Path") LIKE '%\winpeasx64.exe' OR LOWER("Process Path") LIKE '%\winpeasx86_ofs.exe' OR LOWER("Process Path") LIKE '%\winpeasx86.exe') OR (LOWER("Process Name") LIKE '%\winpeasany_ofs.exe' OR LOWER("Process Name") LIKE '%\winpeasany.exe' OR LOWER("Process Name") LIKE '%\winpeasx64_ofs.exe' OR LOWER("Process Name") LIKE '%\winpeasx64.exe' OR LOWER("Process Name") LIKE '%\winpeasx86_ofs.exe' OR LOWER("Process Name") LIKE '%\winpeasx86.exe'))) OR (LOWER(Command) LIKE '% applicationsinfo%' OR LOWER(Command) LIKE '% browserinfo%' OR LOWER(Command) LIKE '% eventsinfo%' OR LOWER(Command) LIKE '% fileanalysis%' OR LOWER(Command) LIKE '% filesinfo%' OR LOWER(Command) LIKE '% processinfo%' OR LOWER(Command) LIKE '% servicesinfo%' OR LOWER(Command) LIKE '% windowscreds%') OR LOWER(Command) LIKE '%https://github.com/carlospolop/peass-ng/releases/latest/download/%' OR (LOWER("Parent Command") LIKE '% -linpeas' OR LOWER(Command) LIKE '% -linpeas'))
