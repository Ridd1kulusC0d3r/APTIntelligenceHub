-- Disable Administrative Share Creation at Startup | T1070.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_disable_administrative_share.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\services\lanmanserver\parameters\%' OR LOWER("Target Process Name") LIKE '%\services\lanmanserver\parameters\%' OR LOWER("Object Name") LIKE '%\services\lanmanserver\parameters\%') AND ((LOWER("Process Name") LIKE '%\autosharewks' OR LOWER("Process Name") LIKE '%\autoshareserver') OR (LOWER("Target Process Name") LIKE '%\autosharewks' OR LOWER("Target Process Name") LIKE '%\autoshareserver') OR (LOWER("Object Name") LIKE '%\autosharewks' OR LOWER("Object Name") LIKE '%\autoshareserver')) AND LOWER(UTF8(payload)) LIKE '%dword (0x00000000)%'
