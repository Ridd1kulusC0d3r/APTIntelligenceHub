-- APT40 Dropbox Tool User Agent | T1071.001, T1567.002 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/TA/APT40/proxy_apt_apt40_dropbox_tool_ua.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE "User Agent"='Mozilla/5.0 (Windows NT 6.1; WOW64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/36.0.1985.143 Safari/537.36' AND LOWER(UTF8(payload)) LIKE '%api.dropbox.com%'
