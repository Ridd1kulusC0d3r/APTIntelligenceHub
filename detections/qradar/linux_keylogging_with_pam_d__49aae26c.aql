-- Linux Keylogging with Pam.d | T1003, T1056.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/lnx_auditd_keylogging_with_pam_d.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND ((LOWER(UTF8(payload)) LIKE '%path%' AND (LOWER(UTF8(payload)) LIKE '%/etc/pam.d/system-auth%' OR LOWER(UTF8(payload)) LIKE '%/etc/pam.d/password-auth%')) OR (LOWER(UTF8(payload)) LIKE '%tty%' OR LOWER(UTF8(payload)) LIKE '%user_tty%'))
