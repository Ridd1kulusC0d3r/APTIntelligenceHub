-- Diagnostic Library Sdiageng.DLL Loaded By Msdt.EXE | T1202 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/image_load/image_load_dll_sdiageng_load_by_msdt.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Path") LIKE '%\msdt.exe' OR LOWER("Process Name") LIKE '%\msdt.exe') AND LOWER(CONCAT('file directory', '/', filename)) LIKE '%\sdiageng.dll'
