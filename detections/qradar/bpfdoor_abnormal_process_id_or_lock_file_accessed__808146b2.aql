-- BPFDoor Abnormal Process ID or Lock File Accessed | T1059, T1106 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/path/lnx_auditd_bpfdoor_file_accessed.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND LOWER(UTF8(payload)) LIKE '%path%' AND (LOWER(UTF8(payload)) LIKE '%/var/run/aepmonend.pid%' OR LOWER(UTF8(payload)) LIKE '%/var/run/auditd.lock%' OR LOWER(UTF8(payload)) LIKE '%/var/run/cma.lock%' OR LOWER(UTF8(payload)) LIKE '%/var/run/console-kit.pid%' OR LOWER(UTF8(payload)) LIKE '%/var/run/consolekit.pid%' OR LOWER(UTF8(payload)) LIKE '%/var/run/daemon.pid%' OR LOWER(UTF8(payload)) LIKE '%/var/run/hald-addon.pid%' OR LOWER(UTF8(payload)) LIKE '%/var/run/hald-smartd.pid%' OR LOWER(UTF8(payload)) LIKE '%/var/run/haldrund.pid%' OR LOWER(UTF8(payload)) LIKE '%/var/run/hp-health.pid%' OR LOWER(UTF8(payload)) LIKE '%/var/run/hpasmlit.lock%' OR LOWER(UTF8(payload)) LIKE '%/var/run/hpasmlited.pid%' OR LOWER(UTF8(payload)) LIKE '%/var/run/kdevrund.pid%' OR LOWER(UTF8(payload)) LIKE '%/var/run/lldpad.lock%' OR LOWER(UTF8(payload)) LIKE '%/var/run/mcelog.pid%' OR LOWER(UTF8(payload)) LIKE '%/var/run/system.pid%' OR LOWER(UTF8(payload)) LIKE '%/var/run/uvp-srv.pid%' OR LOWER(UTF8(payload)) LIKE '%/var/run/vmtoolagt.pid%' OR LOWER(UTF8(payload)) LIKE '%/var/run/xinetd.lock%')
