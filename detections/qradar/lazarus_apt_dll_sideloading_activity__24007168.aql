-- Lazarus APT DLL Sideloading Activity | T1574.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/TA/Lazarus/image_load_apt_lazarus_side_load_activity.yml
SELECT * FROM events WHERE devicetype=12 AND ((("Process Path"='C:\ProgramShared\PresentationHost.exe' OR "Process Name"='C:\ProgramShared\PresentationHost.exe') AND LOWER(CONCAT('file directory', '/', filename)) LIKE '%:\programshared\mscoree.dll') OR (("Process Path"='C:\ProgramData\Adobe\colorcpl.exe' OR "Process Name"='C:\ProgramData\Adobe\colorcpl.exe') AND CONCAT('file directory', '/', filename)='C:\ProgramData\Adobe\colorui.dll') OR (("Process Path"='C:\ProgramData\Oracle\Java\fixmapi.exe' OR "Process Name"='C:\ProgramData\Oracle\Java\fixmapi.exe') AND CONCAT('file directory', '/', filename)='C:\ProgramData\Oracle\Java\mapistub.dll') OR (("Process Path"='C:\ProgramData\Adobe\ARM\tabcal.exe' OR "Process Name"='C:\ProgramData\Adobe\ARM\tabcal.exe') AND CONCAT('file directory', '/', filename)='C:\ProgramData\Adobe\ARM\HID.dll'))
