-- Uncommon Extension Shim Database Installation Via Sdbinst.EXE | T1546.011 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_sdbinst_susp_extension.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\sdbinst.exe' OR LOWER("Process Name") LIKE '%\sdbinst.exe') OR Filename='sdbinst.exe') AND (NOT((LOWER(Command) LIKE '%.sdb%' OR ((LOWER(Command) LIKE '% -c' OR LOWER(Command) LIKE '% -f' OR LOWER(Command) LIKE '% -mm' OR LOWER(Command) LIKE '% -t') OR LOWER(Command) LIKE '% -m -bg%') OR Command IS NULL OR Command='')))
