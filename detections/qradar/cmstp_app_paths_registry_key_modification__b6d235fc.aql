-- CMSTP App Paths Registry Key Modification | T1218.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_cmstp_execution_by_registry.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%software\microsoft\windows\currentversion\app paths\cmmgr32.exe\%' OR LOWER("Target Process Name") LIKE '%software\microsoft\windows\currentversion\app paths\cmmgr32.exe\%' OR LOWER("Object Name") LIKE '%software\microsoft\windows\currentversion\app paths\cmmgr32.exe\%') AND (NOT((((LOWER("Process Name") LIKE '%software\microsoft\windows\currentversion\app paths\cmmgr32.exe\cmstpextensiondll' OR LOWER("Target Process Name") LIKE '%software\microsoft\windows\currentversion\app paths\cmmgr32.exe\cmstpextensiondll' OR LOWER("Object Name") LIKE '%software\microsoft\windows\currentversion\app paths\cmmgr32.exe\cmstpextensiondll') AND (LOWER(UTF8(payload)) LIKE '%c:\windows\system32\cmcfg32.dll%' OR LOWER(UTF8(payload)) LIKE '%c:\windows\syswow64\cmcfg32.dll%')) OR LOWER(UTF8(payload)) LIKE '%(empty)%')))
