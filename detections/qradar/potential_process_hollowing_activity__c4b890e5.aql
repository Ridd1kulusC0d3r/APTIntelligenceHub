-- Potential Process Hollowing Activity | T1055.012 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_tampering/proc_tampering_susp_process_hollowing.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND LOWER(UTF8(payload)) LIKE '%image is replaced%' AND (NOT(((LOWER("Process Path") LIKE '%:\program files (x86)%' OR LOWER("Process Path") LIKE '%:\program files\%' OR LOWER("Process Path") LIKE '%:\windows\system32\wbem\wmiadap.exe%' OR LOWER("Process Path") LIKE '%:\windows\syswow64\wbem\wmiadap.exe%') OR (LOWER("Process Name") LIKE '%:\program files (x86)%' OR LOWER("Process Name") LIKE '%:\program files\%' OR LOWER("Process Name") LIKE '%:\windows\system32\wbem\wmiadap.exe%' OR LOWER("Process Name") LIKE '%:\windows\syswow64\wbem\wmiadap.exe%')))) AND (NOT((((LOWER("Process Path") LIKE '%\appdata\local\programs\opera\%' OR LOWER("Process Name") LIKE '%\appdata\local\programs\opera\%') AND (LOWER("Process Path") LIKE '%\opera.exe' OR LOWER("Process Name") LIKE '%\opera.exe')) OR (LOWER("Process Path") LIKE '%\windowsapps\microsoftedge.exe' OR LOWER("Process Name") LIKE '%\windowsapps\microsoftedge.exe'))))
