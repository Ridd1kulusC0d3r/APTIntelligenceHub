-- HackTool - WinPwn Execution | T1046, T1082, T1106, T1518, T1548.002, T1552.001, T1555, T1555.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_winpwn.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Command) LIKE '%offline_winpwn%' OR LOWER(Command) LIKE '%winpwn %' OR LOWER(Command) LIKE '%winpwn.exe%' OR LOWER(Command) LIKE '%winpwn.ps1%')
