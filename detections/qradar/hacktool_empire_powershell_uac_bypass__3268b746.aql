-- HackTool - Empire PowerShell UAC Bypass | T1548.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_empire_powershell_uac_bypass.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Command) LIKE '% -nop -noni -w hidden -c $x=$((gp hkcu:software\microsoft\windows update).update)%' OR LOWER(Command) LIKE '% -nop -noni -c $x=$((gp hkcu:software\microsoft\windows update).update);%')
