-- Uncommon File Created In Office Startup Folder | T1587.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_office_uncommon_file_startup.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER(Filename) LIKE '%\microsoft\word\startup%' OR (LOWER(Filename) LIKE '%\office%' AND LOWER(Filename) LIKE '%\program files%' AND LOWER(Filename) LIKE '%\startup%')) AND (NOT((LOWER(Filename) LIKE '%.docb' OR LOWER(Filename) LIKE '%.docm' OR LOWER(Filename) LIKE '%.docx' OR LOWER(Filename) LIKE '%.dotm' OR LOWER(Filename) LIKE '%.mdb' OR LOWER(Filename) LIKE '%.mdw' OR LOWER(Filename) LIKE '%.pdf' OR LOWER(Filename) LIKE '%.wll' OR LOWER(Filename) LIKE '%.wwl')))) OR ((LOWER(Filename) LIKE '%\microsoft\excel\xlstart%' OR (LOWER(Filename) LIKE '%\office%' AND LOWER(Filename) LIKE '%\program files%' AND LOWER(Filename) LIKE '%\xlstart%')) AND (NOT((LOWER(Filename) LIKE '%.xll' OR LOWER(Filename) LIKE '%.xls' OR LOWER(Filename) LIKE '%.xlsm' OR LOWER(Filename) LIKE '%.xlsx' OR LOWER(Filename) LIKE '%.xlt' OR LOWER(Filename) LIKE '%.xltm' OR LOWER(Filename) LIKE '%.xlw'))))) AND (NOT((((LOWER("Process Path") LIKE '%:\program files\common files\microsoft shared\clicktorun\%' OR LOWER("Process Name") LIKE '%:\program files\common files\microsoft shared\clicktorun\%') AND (LOWER("Process Path") LIKE '%\officeclicktorun.exe' OR LOWER("Process Name") LIKE '%\officeclicktorun.exe')) OR (((LOWER("Process Path") LIKE '%:\program files\microsoft office\%' OR LOWER("Process Path") LIKE '%:\program files (x86)\microsoft office\%') OR (LOWER("Process Name") LIKE '%:\program files\microsoft office\%' OR LOWER("Process Name") LIKE '%:\program files (x86)\microsoft office\%')) AND ((LOWER("Process Path") LIKE '%\winword.exe' OR LOWER("Process Path") LIKE '%\excel.exe') OR (LOWER("Process Name") LIKE '%\winword.exe' OR LOWER("Process Name") LIKE '%\excel.exe'))))))
