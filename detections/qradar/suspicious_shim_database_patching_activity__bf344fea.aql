-- Suspicious Shim Database Patching Activity | T1546.011 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_persistence_shim_database_susp_application.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\software\microsoft\windows nt\currentversion\appcompatflags\custom\%' OR LOWER("Target Process Name") LIKE '%\software\microsoft\windows nt\currentversion\appcompatflags\custom\%' OR LOWER("Object Name") LIKE '%\software\microsoft\windows nt\currentversion\appcompatflags\custom\%') AND ((LOWER("Process Name") LIKE '%\csrss.exe' OR LOWER("Process Name") LIKE '%\dllhost.exe' OR LOWER("Process Name") LIKE '%\explorer.exe' OR LOWER("Process Name") LIKE '%\runtimebroker.exe' OR LOWER("Process Name") LIKE '%\services.exe' OR LOWER("Process Name") LIKE '%\sihost.exe' OR LOWER("Process Name") LIKE '%\svchost.exe' OR LOWER("Process Name") LIKE '%\taskhostw.exe' OR LOWER("Process Name") LIKE '%\winlogon.exe' OR LOWER("Process Name") LIKE '%\wmiprvse.exe') OR (LOWER("Target Process Name") LIKE '%\csrss.exe' OR LOWER("Target Process Name") LIKE '%\dllhost.exe' OR LOWER("Target Process Name") LIKE '%\explorer.exe' OR LOWER("Target Process Name") LIKE '%\runtimebroker.exe' OR LOWER("Target Process Name") LIKE '%\services.exe' OR LOWER("Target Process Name") LIKE '%\sihost.exe' OR LOWER("Target Process Name") LIKE '%\svchost.exe' OR LOWER("Target Process Name") LIKE '%\taskhostw.exe' OR LOWER("Target Process Name") LIKE '%\winlogon.exe' OR LOWER("Target Process Name") LIKE '%\wmiprvse.exe') OR (LOWER("Object Name") LIKE '%\csrss.exe' OR LOWER("Object Name") LIKE '%\dllhost.exe' OR LOWER("Object Name") LIKE '%\explorer.exe' OR LOWER("Object Name") LIKE '%\runtimebroker.exe' OR LOWER("Object Name") LIKE '%\services.exe' OR LOWER("Object Name") LIKE '%\sihost.exe' OR LOWER("Object Name") LIKE '%\svchost.exe' OR LOWER("Object Name") LIKE '%\taskhostw.exe' OR LOWER("Object Name") LIKE '%\winlogon.exe' OR LOWER("Object Name") LIKE '%\wmiprvse.exe'))
