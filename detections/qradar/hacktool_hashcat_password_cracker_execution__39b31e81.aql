-- HackTool - Hashcat Password Cracker Execution | T1110.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_hashcat.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\hashcat.exe' OR LOWER("Process Name") LIKE '%\hashcat.exe') OR (LOWER(Command) LIKE '%-a %' AND LOWER(Command) LIKE '%-m 1000 %' AND LOWER(Command) LIKE '%-r %'))
