-- Python Path Configuration File Creation - Linux | T1059.006 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/linux/file/file_event/file_event_lnx_python_path_configuration_files.yml
SELECT * FROM events WHERE devicetype=11 AND Filename MATCHES '(?i)/lib/python3\.([5-9]|[0-9]{2})/site-packages/' AND LOWER(Filename) LIKE '%.pth'
