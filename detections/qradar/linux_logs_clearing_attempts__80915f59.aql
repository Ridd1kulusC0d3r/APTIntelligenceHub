-- Linux Logs Clearing Attempts | T1685.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_clear_logs.yml
SELECT * FROM events WHERE devicetype=11 AND (((LOWER("Process Path") LIKE '%/rm' OR LOWER("Process Path") LIKE '%/rmdir' OR LOWER("Process Path") LIKE '%/shred' OR LOWER("Process Path") LIKE '%/unlink') OR (LOWER("Process Name") LIKE '%/rm' OR LOWER("Process Name") LIKE '%/rmdir' OR LOWER("Process Name") LIKE '%/shred' OR LOWER("Process Name") LIKE '%/unlink')) AND (LOWER(Command) LIKE '%/var/log%' OR LOWER(Command) LIKE '%/var/spool/mail%')) AND (NOT((((LOWER("Process Path") LIKE '%/rm' OR LOWER("Process Name") LIKE '%/rm') AND LOWER(Command) LIKE 'rm -f /var/log/sysstat/%') OR ((LOWER("Process Path") LIKE '%/rm' OR LOWER("Process Name") LIKE '%/rm') AND LOWER(Command) LIKE 'rm -f -- /var/log//dmesg%'))))
