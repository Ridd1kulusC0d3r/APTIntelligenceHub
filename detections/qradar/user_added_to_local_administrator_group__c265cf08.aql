-- User Added to Local Administrator Group | T1078, T1098 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_user_added_to_local_administrators.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ("Event ID"=4732 AND (LOWER("Target Username") LIKE 'administr%' OR LOWER(UTF8(payload)) LIKE '%s-1-5-32-544%')) AND (NOT(LOWER(UTF8(payload)) LIKE '%$%'))
