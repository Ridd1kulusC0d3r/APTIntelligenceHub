-- Suspicious Explorer Process with Whitespace Padding - ClickFix/FileFix | T1027.010, T1204.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_clickfix_filefix_whitespace_padding.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Parent Process Path") LIKE '%\explorer.exe' AND LOWER(Command) LIKE '%#%') AND (LOWER(Command) LIKE '%            %' OR LOWER(Command) LIKE '%            %' OR LOWER(Command) LIKE '%            %' OR LOWER(Command) LIKE '%            %' OR LOWER(Command) LIKE '%            %' OR LOWER(Command) LIKE '%            %' OR LOWER(Command) LIKE '%            %' OR LOWER(Command) LIKE '%            %' OR LOWER(Command) LIKE '%            %' OR LOWER(Command) LIKE '%            %' OR LOWER(Command) LIKE '%            %' OR LOWER(Command) LIKE '%            %' OR LOWER(Command) LIKE '%            %')
