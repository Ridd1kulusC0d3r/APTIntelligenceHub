-- LSASS Process Reconnaissance Via Findstr.EXE | T1552.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_findstr_lsass.yml
SELECT * FROM events WHERE devicetype=12 AND (((((LOWER("Process Path") LIKE '%\find.exe' OR LOWER("Process Path") LIKE '%\findstr.exe') OR (LOWER("Process Name") LIKE '%\find.exe' OR LOWER("Process Name") LIKE '%\findstr.exe')) OR (Filename IN('FIND.EXE', 'FINDSTR.EXE'))) AND LOWER(Command) LIKE '%lsass%') OR (LOWER(Command) LIKE '% -i "lsass%' OR LOWER(Command) LIKE '% /i "lsass%' OR LOWER(Command) LIKE '% –i "lsass%' OR LOWER(Command) LIKE '% —i "lsass%' OR LOWER(Command) LIKE '% ―i "lsass%' OR LOWER(Command) LIKE '% -i lsass.exe%' OR LOWER(Command) LIKE '% /i lsass.exe%' OR LOWER(Command) LIKE '% –i lsass.exe%' OR LOWER(Command) LIKE '% —i lsass.exe%' OR LOWER(Command) LIKE '% ―i lsass.exe%' OR LOWER(Command) LIKE '%findstr "lsass%' OR LOWER(Command) LIKE '%findstr lsass%' OR LOWER(Command) LIKE '%findstr.exe "lsass%' OR LOWER(Command) LIKE '%findstr.exe lsass%'))
