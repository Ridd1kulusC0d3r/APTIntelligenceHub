-- HackTool - Rubeus Execution | T1003, T1550.003, T1558.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_rubeus.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\rubeus.exe' OR LOWER("Process Name") LIKE '%\rubeus.exe') OR Filename='Rubeus.exe' OR LOWER(UTF8(payload)) LIKE '%rubeus%' OR (LOWER(Command) LIKE '%asreproast %' OR LOWER(Command) LIKE '%dump /service:krbtgt %' OR LOWER(Command) LIKE '%dump /luid:0x%' OR LOWER(Command) LIKE '%kerberoast %' OR LOWER(Command) LIKE '%createnetonly /program:%' OR LOWER(Command) LIKE '%ptt /ticket:%' OR LOWER(Command) LIKE '%/impersonateuser:%' OR LOWER(Command) LIKE '%renew /ticket:%' OR LOWER(Command) LIKE '%asktgt /user:%' OR LOWER(Command) LIKE '%harvest /interval:%' OR LOWER(Command) LIKE '%s4u /user:%' OR LOWER(Command) LIKE '%s4u /ticket:%' OR LOWER(Command) LIKE '%hash /password:%' OR LOWER(Command) LIKE '%golden /aes256:%' OR LOWER(Command) LIKE '%silver /user:%'))
