-- Potential PetitPotam Attack Via EFS RPC Calls | T1187, T1557.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/zeek/zeek_dce_rpc_potential_petit_potam_efs_rpc_call.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%efs%'
