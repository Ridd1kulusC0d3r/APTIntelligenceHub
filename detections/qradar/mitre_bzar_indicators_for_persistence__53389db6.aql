-- MITRE BZAR Indicators for Persistence | T1547.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/zeek/zeek_dce_rpc_mitre_bzar_persistence.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE (LOWER(UTF8(payload)) LIKE '%spoolss%' AND LOWER(UTF8(payload)) LIKE '%rpcaddmonitor%') OR (LOWER(UTF8(payload)) LIKE '%spoolss%' AND LOWER(UTF8(payload)) LIKE '%rpcaddprintprocessor%') OR (LOWER(UTF8(payload)) LIKE '%iremotewinspool%' AND LOWER(UTF8(payload)) LIKE '%rpcasyncaddmonitor%') OR (LOWER(UTF8(payload)) LIKE '%iremotewinspool%' AND LOWER(UTF8(payload)) LIKE '%rpcasyncaddprintprocessor%') OR (LOWER(UTF8(payload)) LIKE '%iseclogon%' AND LOWER(UTF8(payload)) LIKE '%seclcreateprocesswithlogonw%') OR (LOWER(UTF8(payload)) LIKE '%iseclogon%' AND LOWER(UTF8(payload)) LIKE '%seclcreateprocesswithlogonexw%')
