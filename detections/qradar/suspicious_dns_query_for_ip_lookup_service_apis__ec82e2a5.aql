-- Suspicious DNS Query for IP Lookup Service APIs | T1590 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/dns_query/dns_query_win_susp_external_ip_lookup.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER(UTF8(payload)) LIKE '%www.ip.cn%' OR LOWER(UTF8(payload)) LIKE '%l2.io%') OR (LOWER(UTF8(payload)) LIKE '%api.2ip.ua%' OR LOWER(UTF8(payload)) LIKE '%api.bigdatacloud.net%' OR LOWER(UTF8(payload)) LIKE '%api.ipify.org%' OR LOWER(UTF8(payload)) LIKE '%bot.whatismyipaddress.com%' OR LOWER(UTF8(payload)) LIKE '%canireachthe.net%' OR LOWER(UTF8(payload)) LIKE '%checkip.amazonaws.com%' OR LOWER(UTF8(payload)) LIKE '%checkip.dyndns.org%' OR LOWER(UTF8(payload)) LIKE '%curlmyip.com%' OR LOWER(UTF8(payload)) LIKE '%db-ip.com%' OR LOWER(UTF8(payload)) LIKE '%edns.ip-api.com%' OR LOWER(UTF8(payload)) LIKE '%eth0.me%' OR LOWER(UTF8(payload)) LIKE '%freegeoip.app%' OR LOWER(UTF8(payload)) LIKE '%geoipy.com%' OR LOWER(UTF8(payload)) LIKE '%getip.pro%' OR LOWER(UTF8(payload)) LIKE '%icanhazip.com%' OR LOWER(UTF8(payload)) LIKE '%ident.me%' OR LOWER(UTF8(payload)) LIKE '%ifconfig.io%' OR LOWER(UTF8(payload)) LIKE '%ifconfig.me%' OR LOWER(UTF8(payload)) LIKE '%ip-api.com%' OR LOWER(UTF8(payload)) LIKE '%ip.360.cn%' OR LOWER(UTF8(payload)) LIKE '%ip.anysrc.net%' OR LOWER(UTF8(payload)) LIKE '%ip.taobao.com%' OR LOWER(UTF8(payload)) LIKE '%ip.tyk.nu%' OR LOWER(UTF8(payload)) LIKE '%ipaddressworld.com%' OR LOWER(UTF8(payload)) LIKE '%ipapi.co%' OR LOWER(UTF8(payload)) LIKE '%ipconfig.io%' OR LOWER(UTF8(payload)) LIKE '%ipecho.net%' OR LOWER(UTF8(payload)) LIKE '%ipinfo.io%' OR LOWER(UTF8(payload)) LIKE '%ipip.net%' OR LOWER(UTF8(payload)) LIKE '%ipof.in%' OR LOWER(UTF8(payload)) LIKE '%ipv4.icanhazip.com%' OR LOWER(UTF8(payload)) LIKE '%ipv4bot.whatismyipaddress.com%' OR LOWER(UTF8(payload)) LIKE '%ipv6-test.com%' OR LOWER(UTF8(payload)) LIKE '%ipwho.is%' OR LOWER(UTF8(payload)) LIKE '%jsonip.com%' OR LOWER(UTF8(payload)) LIKE '%myexternalip.com%' OR LOWER(UTF8(payload)) LIKE '%seeip.org%' OR LOWER(UTF8(payload)) LIKE '%wgetip.com%' OR LOWER(UTF8(payload)) LIKE '%whatismyip.akamai.com%' OR LOWER(UTF8(payload)) LIKE '%whois.pconline.com.cn%' OR LOWER(UTF8(payload)) LIKE '%wtfismyip.com%')) AND (NOT(((LOWER("Process Path") LIKE '%\brave.exe' OR LOWER("Process Name") LIKE '%\brave.exe') OR (("Process Path" IN('C:\Program Files\Google\Chrome\Application\chrome.exe', 'C:\Program Files (x86)\Google\Chrome\Application\chrome.exe')) OR ("Process Name" IN('C:\Program Files\Google\Chrome\Application\chrome.exe', 'C:\Program Files (x86)\Google\Chrome\Application\chrome.exe'))) OR (("Process Path" IN('C:\Program Files\Mozilla Firefox\firefox.exe', 'C:\Program Files (x86)\Mozilla Firefox\firefox.exe')) OR ("Process Name" IN('C:\Program Files\Mozilla Firefox\firefox.exe', 'C:\Program Files (x86)\Mozilla Firefox\firefox.exe'))) OR (("Process Path" IN('C:\Program Files (x86)\Internet Explorer\iexplore.exe', 'C:\Program Files\Internet Explorer\iexplore.exe')) OR ("Process Name" IN('C:\Program Files (x86)\Internet Explorer\iexplore.exe', 'C:\Program Files\Internet Explorer\iexplore.exe'))) OR (LOWER("Process Path") LIKE '%\maxthon.exe' OR LOWER("Process Name") LIKE '%\maxthon.exe') OR ((LOWER("Process Path") LIKE 'c:\program files (x86)\microsoft\edgewebview\application\%' OR LOWER("Process Name") LIKE 'c:\program files (x86)\microsoft\edgewebview\application\%') OR (LOWER("Process Path") LIKE '%\windowsapps\microsoftedge.exe' OR LOWER("Process Name") LIKE '%\windowsapps\microsoftedge.exe') OR (("Process Path" IN('C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe', 'C:\Program Files\Microsoft\Edge\Application\msedge.exe')) OR ("Process Name" IN('C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe', 'C:\Program Files\Microsoft\Edge\Application\msedge.exe')))) OR (((LOWER("Process Path") LIKE 'c:\program files (x86)\microsoft\edgecore\%' OR LOWER("Process Path") LIKE 'c:\program files\microsoft\edgecore\%') OR (LOWER("Process Name") LIKE 'c:\program files (x86)\microsoft\edgecore\%' OR LOWER("Process Name") LIKE 'c:\program files\microsoft\edgecore\%')) AND ((LOWER("Process Path") LIKE '%\msedge.exe' OR LOWER("Process Path") LIKE '%\msedgewebview2.exe') OR (LOWER("Process Name") LIKE '%\msedge.exe' OR LOWER("Process Name") LIKE '%\msedgewebview2.exe'))) OR (LOWER("Process Path") LIKE '%\opera.exe' OR LOWER("Process Name") LIKE '%\opera.exe') OR (LOWER("Process Path") LIKE '%\safari.exe' OR LOWER("Process Name") LIKE '%\safari.exe') OR (LOWER("Process Path") LIKE '%\seamonkey.exe' OR LOWER("Process Name") LIKE '%\seamonkey.exe') OR (LOWER("Process Path") LIKE '%\vivaldi.exe' OR LOWER("Process Name") LIKE '%\vivaldi.exe') OR (LOWER("Process Path") LIKE '%\whale.exe' OR LOWER("Process Name") LIKE '%\whale.exe'))))
