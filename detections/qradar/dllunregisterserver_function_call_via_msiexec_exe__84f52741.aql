-- DllUnregisterServer Function Call Via Msiexec.EXE | T1218.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_msiexec_dll.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\msiexec.exe' OR LOWER("Process Name") LIKE '%\msiexec.exe') OR Filename='msiexec.exe') AND ((LOWER(Command) LIKE '% -z %' OR LOWER(Command) LIKE '% /z %' OR LOWER(Command) LIKE '% –z %' OR LOWER(Command) LIKE '% —z %' OR LOWER(Command) LIKE '% ―z %') AND LOWER(Command) LIKE '%.dll%')) AND (NOT(LOWER(Command) LIKE '%\msiexec.exe" /z "c:\windows\ccm\msihandler.dll"'))
