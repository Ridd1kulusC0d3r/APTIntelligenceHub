-- Turla Group Lateral Movement | T1021.002, T1059, T1083, T1135 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2014/TA/Turla/proc_creation_win_apt_turla_commands_critical.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Command) LIKE 'net use \\%domaincontroller%\c$ "p@ssw0rd" %' OR LOWER(Command) LIKE 'dir c:\%.doc% /s' OR LOWER(Command) LIKE 'dir %temp%\%.exe')
