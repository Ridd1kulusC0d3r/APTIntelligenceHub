-- File Deletion | T1070.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_file_deletion.yml
SELECT * FROM events WHERE devicetype=11 AND ((LOWER("Process Path") LIKE '%/rm' OR LOWER("Process Path") LIKE '%/shred' OR LOWER("Process Path") LIKE '%/unlink') OR (LOWER("Process Name") LIKE '%/rm' OR LOWER("Process Name") LIKE '%/shred' OR LOWER("Process Name") LIKE '%/unlink'))
