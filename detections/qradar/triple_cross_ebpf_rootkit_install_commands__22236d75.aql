-- Triple Cross eBPF Rootkit Install Commands | T1014 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_triple_cross_rootkit_install.yml
SELECT * FROM events WHERE devicetype=11 AND (LOWER("Process Path") LIKE '%/sudo' OR LOWER("Process Name") LIKE '%/sudo') AND (LOWER(Command) LIKE '% tc %' AND LOWER(Command) LIKE '% enp0s3 %') AND (LOWER(Command) LIKE '% qdisc %' OR LOWER(Command) LIKE '% filter %')
