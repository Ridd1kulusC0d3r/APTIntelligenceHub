-- Suspicious History File Operations | T1552.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_susp_histfile_operations.yml
SELECT * FROM events WHERE devicetype=102 AND (LOWER(Command) LIKE '%.bash_history%' OR LOWER(Command) LIKE '%.zsh_history%' OR LOWER(Command) LIKE '%.zhistory%' OR LOWER(Command) LIKE '%.history%' OR LOWER(Command) LIKE '%.sh_history%' OR LOWER(Command) LIKE '%fish_history%')
