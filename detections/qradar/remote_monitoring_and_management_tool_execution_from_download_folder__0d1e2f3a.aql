-- Remote Monitoring And Management Tool Execution From Download Folder | T1219 | Hub | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%ateraagent%' OR LOWER("Process Path") LIKE '%screenconnect%' OR LOWER("Process Path") LIKE '%simplehelp%' OR LOWER("Process Path") LIKE '%anydesk%' OR LOWER("Process Path") LIKE '%syncro%' OR LOWER("Process Path") LIKE '%netbird%') OR (LOWER("Process Name") LIKE '%ateraagent%' OR LOWER("Process Name") LIKE '%screenconnect%' OR LOWER("Process Name") LIKE '%simplehelp%' OR LOWER("Process Name") LIKE '%anydesk%' OR LOWER("Process Name") LIKE '%syncro%' OR LOWER("Process Name") LIKE '%netbird%')) OR (LOWER(UTF8(payload)) LIKE '%atera%' OR LOWER(UTF8(payload)) LIKE '%screenconnect%' OR LOWER(UTF8(payload)) LIKE '%simplehelp%' OR LOWER(UTF8(payload)) LIKE '%anydesk%')) AND ((LOWER("Process Path") LIKE '%\downloads\%' OR LOWER("Process Path") LIKE '%\appdata\local\temp\%') OR (LOWER("Process Name") LIKE '%\downloads\%' OR LOWER("Process Name") LIKE '%\appdata\local\temp\%'))
