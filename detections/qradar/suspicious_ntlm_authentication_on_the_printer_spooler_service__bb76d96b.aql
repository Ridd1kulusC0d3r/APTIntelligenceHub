-- Suspicious NTLM Authentication on the Printer Spooler Service | T1212 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_rundll32_ntlmrelay.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\rundll32.exe' OR LOWER("Process Name") LIKE '%\rundll32.exe') OR Filename='RUNDLL32.EXE') AND ((LOWER(Command) LIKE '%c:\windows\system32\davclnt.dll,davsetcookie%' AND LOWER(Command) LIKE '%http%') AND (LOWER(Command) LIKE '%spoolss%' OR LOWER(Command) LIKE '%srvsvc%' OR LOWER(Command) LIKE '%/print/pipe/%'))
