-- Detected Windows Software Discovery | T1518 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_reg_software_discovery.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Path") LIKE '%\reg.exe' OR LOWER("Process Name") LIKE '%\reg.exe') AND (LOWER(Command) LIKE '%query%' AND LOWER(Command) LIKE '%\software\%' AND LOWER(Command) LIKE '%/v%' AND LOWER(Command) LIKE '%svcversion%')
