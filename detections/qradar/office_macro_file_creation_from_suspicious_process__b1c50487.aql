-- Office Macro File Creation From Suspicious Process | T1566.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_office_macro_files_from_susp_process.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\cscript.exe' OR LOWER("Process Path") LIKE '%\mshta.exe' OR LOWER("Process Path") LIKE '%\regsvr32.exe' OR LOWER("Process Path") LIKE '%\rundll32.exe' OR LOWER("Process Path") LIKE '%\wscript.exe') OR (LOWER("Process Name") LIKE '%\cscript.exe' OR LOWER("Process Name") LIKE '%\mshta.exe' OR LOWER("Process Name") LIKE '%\regsvr32.exe' OR LOWER("Process Name") LIKE '%\rundll32.exe' OR LOWER("Process Name") LIKE '%\wscript.exe')) OR (LOWER("Parent Process Path") LIKE '%\cscript.exe' OR LOWER("Parent Process Path") LIKE '%\mshta.exe' OR LOWER("Parent Process Path") LIKE '%\regsvr32.exe' OR LOWER("Parent Process Path") LIKE '%\rundll32.exe' OR LOWER("Parent Process Path") LIKE '%\wscript.exe')) AND (LOWER(Filename) LIKE '%.docm' OR LOWER(Filename) LIKE '%.dotm' OR LOWER(Filename) LIKE '%.xlsm' OR LOWER(Filename) LIKE '%.xltm' OR LOWER(Filename) LIKE '%.potm' OR LOWER(Filename) LIKE '%.pptm')
