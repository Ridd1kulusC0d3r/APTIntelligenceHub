-- Data Staging With RAR Using Password And Archive Splitting | T1560.001 | Hub
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\rar.exe' OR LOWER("Process Path") LIKE '%\winrar.exe') OR (LOWER("Process Name") LIKE '%\rar.exe' OR LOWER("Process Name") LIKE '%\winrar.exe')) OR Filename='Command line RAR') AND (LOWER(Command) LIKE '% -hp%' OR LOWER(Command) LIKE '% -p%') AND LOWER(Command) LIKE '% -v%'
