-- Visual Studio Code Tunnel Execution | T1071.001, T1219 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_vscode_tunnel_execution.yml
SELECT * FROM events WHERE devicetype=12 AND ((Filename IS NULL AND LOWER(Command) LIKE '%.exe tunnel') OR (LOWER(Command) LIKE '%.exe tunnel%' AND LOWER(Command) LIKE '%--accept-server-license-terms%') OR (LOWER("Parent Command") LIKE '% tunnel' AND (LOWER("Process Path") LIKE '%\cmd.exe' OR LOWER("Process Name") LIKE '%\cmd.exe') AND (LOWER(Command) LIKE '%/d /c %' AND LOWER(Command) LIKE '%\servers\stable-%' AND LOWER(Command) LIKE '%code-server.cmd%')))
