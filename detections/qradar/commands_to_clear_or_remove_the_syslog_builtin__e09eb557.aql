-- Commands to Clear or Remove the Syslog - Builtin | T1565.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/builtin/lnx_clear_syslog.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND (LOWER(UTF8(payload)) LIKE '%rm /var/log/syslog%' OR LOWER(UTF8(payload)) LIKE '%rm -r /var/log/syslog%' OR LOWER(UTF8(payload)) LIKE '%rm -f /var/log/syslog%' OR LOWER(UTF8(payload)) LIKE '%rm -rf /var/log/syslog%' OR LOWER(UTF8(payload)) LIKE '%mv /var/log/syslog%' OR LOWER(UTF8(payload)) LIKE '% >/var/log/syslog%' OR LOWER(UTF8(payload)) LIKE '% > /var/log/syslog%') AND (NOT(LOWER(UTF8(payload)) LIKE '%/syslog.%'))
