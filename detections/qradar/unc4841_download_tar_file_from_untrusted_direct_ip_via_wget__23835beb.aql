-- UNC4841 - Download Tar File From Untrusted Direct IP Via Wget | T1140 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/TA/UNC4841-Barracuda-ESG-Zero-Day-Exploitation/proc_creation_lnx_apt_unc4841_wget_download_tar_files_direct_ip.yml
SELECT * FROM events WHERE devicetype=11 AND ((LOWER("Process Path") LIKE '%/wget' OR LOWER("Process Name") LIKE '%/wget') AND Command MATCHES 'https://[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' AND LOWER(Command) LIKE '%--no-check-certificate%' AND LOWER(Command) LIKE '%.tar') AND (NOT((LOWER(Command) LIKE '%https://10.%' OR LOWER(Command) LIKE '%https://192.168.%' OR LOWER(Command) LIKE '%https://172.16.%' OR LOWER(Command) LIKE '%https://172.17.%' OR LOWER(Command) LIKE '%https://172.18.%' OR LOWER(Command) LIKE '%https://172.19.%' OR LOWER(Command) LIKE '%https://172.20.%' OR LOWER(Command) LIKE '%https://172.21.%' OR LOWER(Command) LIKE '%https://172.22.%' OR LOWER(Command) LIKE '%https://172.23.%' OR LOWER(Command) LIKE '%https://172.24.%' OR LOWER(Command) LIKE '%https://172.25.%' OR LOWER(Command) LIKE '%https://172.26.%' OR LOWER(Command) LIKE '%https://172.27.%' OR LOWER(Command) LIKE '%https://172.28.%' OR LOWER(Command) LIKE '%https://172.29.%' OR LOWER(Command) LIKE '%https://172.30.%' OR LOWER(Command) LIKE '%https://172.31.%' OR LOWER(Command) LIKE '%https://127.%' OR LOWER(Command) LIKE '%https://169.254.%')))
