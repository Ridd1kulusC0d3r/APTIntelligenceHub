-- Shell Execution GCC  - Linux | T1083 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_gcc_shell_execution.yml
SELECT * FROM events WHERE devicetype=11 AND (((LOWER("Process Path") LIKE '%/c89' OR LOWER("Process Path") LIKE '%/c99' OR LOWER("Process Path") LIKE '%/gcc') OR (LOWER("Process Name") LIKE '%/c89' OR LOWER("Process Name") LIKE '%/c99' OR LOWER("Process Name") LIKE '%/gcc')) AND LOWER(Command) LIKE '%-wrapper%') AND (LOWER(Command) LIKE '%/bin/bash,-s%' OR LOWER(Command) LIKE '%/bin/dash,-s%' OR LOWER(Command) LIKE '%/bin/fish,-s%' OR LOWER(Command) LIKE '%/bin/sh,-s%' OR LOWER(Command) LIKE '%/bin/zsh,-s%')
