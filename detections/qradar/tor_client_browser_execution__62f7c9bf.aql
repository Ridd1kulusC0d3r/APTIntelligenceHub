-- Tor Client/Browser Execution | T1090.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_browsers_tor_execution.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER(UTF8(payload)) LIKE '%tor browser%' OR LOWER(UTF8(payload)) LIKE '%tor browser%' OR ((LOWER("Process Path") LIKE '%\tor.exe' OR LOWER("Process Path") LIKE '%\tor browser\browser\firefox.exe') OR (LOWER("Process Name") LIKE '%\tor.exe' OR LOWER("Process Name") LIKE '%\tor browser\browser\firefox.exe')))
