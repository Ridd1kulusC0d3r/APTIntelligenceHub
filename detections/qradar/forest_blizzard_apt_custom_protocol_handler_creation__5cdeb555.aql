-- Forest Blizzard APT - Custom Protocol Handler Creation | T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2024/TA/Forest-Blizzard/registry_set_apt_forest_blizzard_custom_protocol_handler.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\protocols\handler\rogue\clsid%' OR LOWER("Target Process Name") LIKE '%\protocols\handler\rogue\clsid%' OR LOWER("Object Name") LIKE '%\protocols\handler\rogue\clsid%') AND LOWER(UTF8(payload)) LIKE '%{026cc6d7-34b2-33d5-b551-ca31eb6ce345}%'
