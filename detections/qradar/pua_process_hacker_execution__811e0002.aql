-- PUA - Process Hacker Execution | T1543, T1564, T1622 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_pua_process_hacker.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\processhacker_%' OR LOWER("Process Name") LIKE '%\processhacker_%') OR (LOWER("Process Path") LIKE '%\processhacker.exe' OR LOWER("Process Name") LIKE '%\processhacker.exe') OR (Filename IN('ProcessHacker.exe', 'Process Hacker')) OR LOWER(UTF8(payload)) LIKE '%process hacker%' OR LOWER(UTF8(payload)) LIKE '%process hacker%' OR (LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%md5=68f9b52895f4d34e74112f3129b3b00d%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%md5=b365af317ae730a67c936f21432b9c71%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%sha1=a0bdfac3ce1880b32ff9b696458327ce352e3b1d%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%sha1=c5e2018bf7c0f314fed4fd7fe7e69fa2e648359e%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%sha256=d4a0fe56316a2c45b9ba9ac1005363309a3edc7acf9e4df64d326a0ff273e80f%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%sha256=bd2c2cf0631d881ed382817afcce2b093f4e412ffb170a719e2762f250abfea4%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=3695333c60dedecdcaff1590409aa462%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=04de0ad9c37eb7bd52043d2ecac958df%'))
