-- New Netsh Helper DLL Registered From A Suspicious Location | T1546.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_netsh_help_dll_persistence_susp_location.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\software\microsoft\netsh%' OR LOWER("Target Process Name") LIKE '%\software\microsoft\netsh%' OR LOWER("Object Name") LIKE '%\software\microsoft\netsh%') AND ((LOWER(UTF8(payload)) LIKE '%:\perflogs*%' OR LOWER(UTF8(payload)) LIKE '%:\users\public\%' OR LOWER(UTF8(payload)) LIKE '%:\windows\temp\%' OR LOWER(UTF8(payload)) LIKE '%\appdata\local\temp\%' OR LOWER(UTF8(payload)) LIKE '%\temporary internet%') OR ((LOWER(UTF8(payload)) LIKE '%:\users*%' AND LOWER(UTF8(payload)) LIKE '%\favorites\%') OR (LOWER(UTF8(payload)) LIKE '%:\users*%' AND LOWER(UTF8(payload)) LIKE '%\favourites\%') OR (LOWER(UTF8(payload)) LIKE '%:\users*%' AND LOWER(UTF8(payload)) LIKE '%\contacts\%') OR (LOWER(UTF8(payload)) LIKE '%:\users*%' AND LOWER(UTF8(payload)) LIKE '%\pictures\%')))
