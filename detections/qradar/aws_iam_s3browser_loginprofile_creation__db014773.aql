-- AWS IAM S3Browser LoginProfile Creation | T1059.009, T1078.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/aws/cloudtrail/aws_iam_s3browser_loginprofile_creation.yml
SELECT * FROM events WHERE devicetype IN(516, 519, 456, 460, 501, 502, 507, 440, 347) AND (QIDNAME(qid) IN('GetLoginProfile', 'CreateLoginProfile')) AND LOWER("User Agent") LIKE '%s3 browser%'
