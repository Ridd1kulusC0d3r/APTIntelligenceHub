-- Moriya Rootkit - System | T1543.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/service_control_manager/win_system_moriya_rootkit.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND LOWER(UTF8(payload)) LIKE '%service control manager%' AND "Event ID"=7045 AND "Service Name"='ZzNetSvc'
