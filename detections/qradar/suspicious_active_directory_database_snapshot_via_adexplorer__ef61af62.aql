-- Suspicious Active Directory Database Snapshot Via ADExplorer | T1069.002, T1087.002, T1482 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_sysinternals_adexplorer_susp_execution.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\adexp.exe' OR LOWER("Process Path") LIKE '%\adexplorer.exe' OR LOWER("Process Path") LIKE '%\adexplorer64.exe' OR LOWER("Process Path") LIKE '%\adexplorer64a.exe') OR (LOWER("Process Name") LIKE '%\adexp.exe' OR LOWER("Process Name") LIKE '%\adexplorer.exe' OR LOWER("Process Name") LIKE '%\adexplorer64.exe' OR LOWER("Process Name") LIKE '%\adexplorer64a.exe')) OR Filename='AdExp' OR LOWER(UTF8(payload)) LIKE '%active directory editor%' OR LOWER(UTF8(payload)) LIKE '%sysinternals adexplorer%') AND LOWER(Command) LIKE '%snapshot%' AND (LOWER(Command) LIKE '%\downloads\%' OR LOWER(Command) LIKE '%\users\public\%' OR LOWER(Command) LIKE '%\appdata\%' OR LOWER(Command) LIKE '%\windows\temp\%')
