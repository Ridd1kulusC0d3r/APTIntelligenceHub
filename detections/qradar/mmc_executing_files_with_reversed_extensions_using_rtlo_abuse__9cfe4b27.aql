-- MMC Executing Files with Reversed Extensions Using RTLO Abuse | T1036.002, T1204.002, T1218.014 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_mmc_rlo_abuse_pattern.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\mmc.exe' OR LOWER("Process Name") LIKE '%\mmc.exe') OR Filename='MMC.exe') AND (LOWER(Command) LIKE '%cod.msc%' OR LOWER(Command) LIKE '%fdp.msc%' OR LOWER(Command) LIKE '%ftr.msc%' OR LOWER(Command) LIKE '%lmth.msc%' OR LOWER(Command) LIKE '%slx.msc%' OR LOWER(Command) LIKE '%tdo.msc%' OR LOWER(Command) LIKE '%xcod.msc%' OR LOWER(Command) LIKE '%xslx.msc%' OR LOWER(Command) LIKE '%xtpp.msc%')
