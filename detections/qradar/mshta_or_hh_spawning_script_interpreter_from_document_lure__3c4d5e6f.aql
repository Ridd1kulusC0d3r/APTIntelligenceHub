-- MSHTA Or HH Spawning Script Interpreter From Document Lure | T1218.001, T1218.005 | Hub
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Parent Process Path") LIKE '%\mshta.exe' OR LOWER("Parent Process Path") LIKE '%\hh.exe') AND ((LOWER("Process Path") LIKE '%\powershell.exe' OR LOWER("Process Path") LIKE '%\cmd.exe' OR LOWER("Process Path") LIKE '%\wscript.exe' OR LOWER("Process Path") LIKE '%\cscript.exe' OR LOWER("Process Path") LIKE '%\curl.exe') OR (LOWER("Process Name") LIKE '%\powershell.exe' OR LOWER("Process Name") LIKE '%\cmd.exe' OR LOWER("Process Name") LIKE '%\wscript.exe' OR LOWER("Process Name") LIKE '%\cscript.exe' OR LOWER("Process Name") LIKE '%\curl.exe'))
