-- Cisco Sniffing | T1040 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/cisco/aaa/cisco_cli_net_sniff.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype IN(6, 143, 273, 274, 20, 23, 26, 30, 31, 419, 41, 429, 431, 179, 435, 437, 182, 183, 56, 316, 448, 194, 90, 94, 95, 113, 114, 115, 116, 117, 248, 250, 508) AND (LOWER(UTF8(payload)) LIKE '%monitor capture point%' OR LOWER(UTF8(payload)) LIKE '%set span%' OR LOWER(UTF8(payload)) LIKE '%set rspan%')
