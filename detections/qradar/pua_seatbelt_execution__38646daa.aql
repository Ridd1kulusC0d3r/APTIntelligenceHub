-- PUA - Seatbelt Execution | T1083, T1087, T1526 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_pua_seatbelt.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\seatbelt.exe' OR LOWER("Process Name") LIKE '%\seatbelt.exe') OR Filename='Seatbelt.exe' OR LOWER(UTF8(payload)) LIKE '%seatbelt%' OR (LOWER(Command) LIKE '% dpapimasterkeys%' OR LOWER(Command) LIKE '% interestingprocesses%' OR LOWER(Command) LIKE '% interestingfiles%' OR LOWER(Command) LIKE '% certificatethumbprints%' OR LOWER(Command) LIKE '% chromiumbookmarks%' OR LOWER(Command) LIKE '% chromiumhistory%' OR LOWER(Command) LIKE '% chromiumpresence%' OR LOWER(Command) LIKE '% cloudcredentials%' OR LOWER(Command) LIKE '% credenum%' OR LOWER(Command) LIKE '% credguard%' OR LOWER(Command) LIKE '% firefoxhistory%' OR LOWER(Command) LIKE '% processcreationevents%')) OR ((LOWER(Command) LIKE '% -group=misc%' OR LOWER(Command) LIKE '% -group=remote%' OR LOWER(Command) LIKE '% -group=chromium%' OR LOWER(Command) LIKE '% -group=slack%' OR LOWER(Command) LIKE '% -group=system%' OR LOWER(Command) LIKE '% -group=user%' OR LOWER(Command) LIKE '% -group=all%') AND LOWER(Command) LIKE '% -outputfile=%'))
