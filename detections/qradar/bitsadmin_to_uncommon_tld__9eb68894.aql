-- Bitsadmin to Uncommon TLD | T1071.001, T1197 | https://github.com/SigmaHQ/sigma/blob/master/rules/web/proxy_generic/proxy_ua_bitsadmin_susp_tld.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER("User Agent") LIKE 'microsoft bits/%' AND (NOT((LOWER(UTF8(payload)) LIKE '%.com%' OR LOWER(UTF8(payload)) LIKE '%.microsoft%' OR LOWER(UTF8(payload)) LIKE '%.net%' OR LOWER(UTF8(payload)) LIKE '%.org%' OR LOWER(UTF8(payload)) LIKE '%.scdn.co%' OR LOWER(UTF8(payload)) LIKE '%.sfx.ms%')))
