-- PUA - Rclone Execution | T1567.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_pua_rclone_execution.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER(Command) LIKE '%--config %' AND LOWER(Command) LIKE '%--no-check-certificate %' AND LOWER(Command) LIKE '% copy %') OR (((LOWER("Process Path") LIKE '%\rclone.exe' OR LOWER("Process Name") LIKE '%\rclone.exe') OR LOWER(UTF8(payload)) LIKE '%rsync for cloud storage%') AND (LOWER(Command) LIKE '%pass%' OR LOWER(Command) LIKE '%user%' OR LOWER(Command) LIKE '%copy%' OR LOWER(Command) LIKE '%sync%' OR LOWER(Command) LIKE '%config%' OR LOWER(Command) LIKE '%lsd%' OR LOWER(Command) LIKE '%remote%' OR LOWER(Command) LIKE '%ls%' OR LOWER(Command) LIKE '%mega%' OR LOWER(Command) LIKE '%pcloud%' OR LOWER(Command) LIKE '%ftp%' OR LOWER(Command) LIKE '%ignore-existing%' OR LOWER(Command) LIKE '%auto-confirm%' OR LOWER(Command) LIKE '%transfers%' OR LOWER(Command) LIKE '%multi-thread-streams%' OR LOWER(Command) LIKE '%no-check-certificate %')))
