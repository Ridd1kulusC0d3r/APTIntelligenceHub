-- Gatekeeper Bypass via Xattr | T1553.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_xattr_gatekeeper_bypass.yml
SELECT * FROM events WHERE devicetype=102 AND (LOWER("Process Path") LIKE '%/xattr' OR LOWER("Process Name") LIKE '%/xattr') AND (LOWER(Command) LIKE '%-d%' AND LOWER(Command) LIKE '%com.apple.quarantine%')
