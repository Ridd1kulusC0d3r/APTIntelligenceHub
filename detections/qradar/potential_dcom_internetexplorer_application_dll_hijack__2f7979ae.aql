-- Potential DCOM InternetExplorer.Application DLL Hijack | T1021.002, T1021.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_dcom_iertutil_dll_hijack.yml
SELECT * FROM events WHERE devicetype=12 AND ("Process Path"='System' OR "Process Name"='System') AND LOWER(Filename) LIKE '%\internet explorer\iertutil.dll'
