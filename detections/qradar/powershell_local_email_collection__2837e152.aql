-- Powershell Local Email Collection | T1114.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_susp_mail_acces.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Message) LIKE '%get-inbox.ps1%' OR LOWER(Message) LIKE '%microsoft.office.interop.outlook%' OR LOWER(Message) LIKE '%microsoft.office.interop.outlook.oldefaultfolders%' OR LOWER(Message) LIKE '%-comobject outlook.application%')
