-- Suspicious Printer Driver Empty Manufacturer | T1574 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_susp_printer_driver.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Name") LIKE '%\control\print\environments\windows x64\drivers%' AND LOWER("Process Name") LIKE '%\manufacturer%') OR (LOWER("Target Process Name") LIKE '%\control\print\environments\windows x64\drivers%' AND LOWER("Target Process Name") LIKE '%\manufacturer%') OR (LOWER("Object Name") LIKE '%\control\print\environments\windows x64\drivers%' AND LOWER("Object Name") LIKE '%\manufacturer%')) AND LOWER(UTF8(payload)) LIKE '%(empty)%') AND (NOT(((LOWER("Process Name") LIKE '%\cutepdf writer v4.0\%' OR LOWER("Target Process Name") LIKE '%\cutepdf writer v4.0\%' OR LOWER("Object Name") LIKE '%\cutepdf writer v4.0\%') OR ((LOWER("Process Name") LIKE '%\vnc printer (ps)\%' OR LOWER("Process Name") LIKE '%\vnc printer (ud)\%') OR (LOWER("Target Process Name") LIKE '%\vnc printer (ps)\%' OR LOWER("Target Process Name") LIKE '%\vnc printer (ud)\%') OR (LOWER("Object Name") LIKE '%\vnc printer (ps)\%' OR LOWER("Object Name") LIKE '%\vnc printer (ud)\%')) OR (LOWER("Process Name") LIKE '%\version-3\pdf24\%' OR LOWER("Target Process Name") LIKE '%\version-3\pdf24\%' OR LOWER("Object Name") LIKE '%\version-3\pdf24\%'))))
