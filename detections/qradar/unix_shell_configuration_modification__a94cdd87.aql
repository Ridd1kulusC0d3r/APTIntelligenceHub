-- Unix Shell Configuration Modification | T1546.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/path/lnx_auditd_unix_shell_configuration_modification.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND LOWER(UTF8(payload)) LIKE '%path%' AND (LOWER(UTF8(payload)) LIKE '%/etc/shells%' OR LOWER(UTF8(payload)) LIKE '%/etc/profile%' OR LOWER(UTF8(payload)) LIKE '%/etc/profile.d/%' OR LOWER(UTF8(payload)) LIKE '%/etc/bash.bashrc%' OR LOWER(UTF8(payload)) LIKE '%/etc/bashrc%' OR LOWER(UTF8(payload)) LIKE '%/etc/zsh/zprofile%' OR LOWER(UTF8(payload)) LIKE '%/etc/zsh/zshrc%' OR LOWER(UTF8(payload)) LIKE '%/etc/zsh/zlogin%' OR LOWER(UTF8(payload)) LIKE '%/etc/zsh/zlogout%' OR LOWER(UTF8(payload)) LIKE '%/etc/csh.cshrc%' OR LOWER(UTF8(payload)) LIKE '%/etc/csh.login%' OR LOWER(UTF8(payload)) LIKE '%/root/.bashrc%' OR LOWER(UTF8(payload)) LIKE '%/root/.bash_profile%' OR LOWER(UTF8(payload)) LIKE '%/root/.profile%' OR LOWER(UTF8(payload)) LIKE '%/root/.zshrc%' OR LOWER(UTF8(payload)) LIKE '%/root/.zprofile%' OR LOWER(UTF8(payload)) LIKE '%/home/%/.bashrc%' OR LOWER(UTF8(payload)) LIKE '%/home/%/.zshrc%' OR LOWER(UTF8(payload)) LIKE '%/home/%/.bash_profile%' OR LOWER(UTF8(payload)) LIKE '%/home/%/.zprofile%' OR LOWER(UTF8(payload)) LIKE '%/home/%/.profile%' OR LOWER(UTF8(payload)) LIKE '%/home/%/.bash_login%' OR LOWER(UTF8(payload)) LIKE '%/home/%/.bash_logout%' OR LOWER(UTF8(payload)) LIKE '%/home/%/.zlogin%' OR LOWER(UTF8(payload)) LIKE '%/home/%/.zlogout%')
