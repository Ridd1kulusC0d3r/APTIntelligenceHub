-- Registry Modification of MS-settings Protocol Handler | T1112, T1546.001, T1548.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_registry_modification_of_ms_setting_protocol_handler.yml
SELECT * FROM events WHERE devicetype=12 AND ((((LOWER("Process Path") LIKE '%\reg.exe' OR LOWER("Process Name") LIKE '%\reg.exe') OR Filename='reg.exe') AND LOWER(Command) LIKE '%add%') OR ((((LOWER("Process Path") LIKE '%\powershell.exe' OR LOWER("Process Path") LIKE '%\pwsh.exe') OR (LOWER("Process Name") LIKE '%\powershell.exe' OR LOWER("Process Name") LIKE '%\pwsh.exe')) OR (Filename IN('powershell.exe', 'pwsh.dll'))) AND (LOWER(Command) LIKE '%new-itemproperty%' OR LOWER(Command) LIKE '%set-itemproperty%' OR LOWER(Command) LIKE '%ni %' OR LOWER(Command) LIKE '%sp %'))) AND LOWER(Command) LIKE '%\ms-settings\shell\open\command%'
