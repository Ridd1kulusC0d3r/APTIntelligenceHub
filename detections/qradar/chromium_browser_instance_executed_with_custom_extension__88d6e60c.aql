-- Chromium Browser Instance Executed With Custom Extension | T1176.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_browsers_chromium_load_extension.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\brave.exe' OR LOWER("Process Path") LIKE '%\chrome.exe' OR LOWER("Process Path") LIKE '%\msedge.exe' OR LOWER("Process Path") LIKE '%\opera.exe' OR LOWER("Process Path") LIKE '%\vivaldi.exe') OR (LOWER("Process Name") LIKE '%\brave.exe' OR LOWER("Process Name") LIKE '%\chrome.exe' OR LOWER("Process Name") LIKE '%\msedge.exe' OR LOWER("Process Name") LIKE '%\opera.exe' OR LOWER("Process Name") LIKE '%\vivaldi.exe')) AND LOWER(Command) LIKE '%--load-extension=%'
