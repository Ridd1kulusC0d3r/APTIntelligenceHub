-- Failed Code Integrity Checks | T1027.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_codeintegrity_check_failure.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ("Event ID" IN('5038', '6281')) AND (NOT(((LOWER(UTF8(payload)) LIKE '%\csfalconserviceuninstalltool_%' OR LOWER(UTF8(payload)) LIKE '%\program files\crowdstrike\%' OR LOWER(UTF8(payload)) LIKE '%\system32\drivers\crowdstrike\%' OR LOWER(UTF8(payload)) LIKE '%\windows\system32\scriptcontrol64_%') OR LOWER(UTF8(payload)) LIKE '%\program files\sophos*%')))
