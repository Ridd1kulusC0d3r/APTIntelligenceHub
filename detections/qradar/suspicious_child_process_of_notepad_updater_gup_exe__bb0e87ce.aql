-- Suspicious Child Process of Notepad++ Updater - GUP.Exe | T1195.002, T1557 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_gup_susp_child_process.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER("Parent Process Path") LIKE '%\gup.exe' AND (((LOWER("Process Path") LIKE '%\cmd.exe' OR LOWER("Process Path") LIKE '%\powershell.exe' OR LOWER("Process Path") LIKE '%\pwsh.exe' OR LOWER("Process Path") LIKE '%\cscript.exe' OR LOWER("Process Path") LIKE '%\wscript.exe' OR LOWER("Process Path") LIKE '%\mshta.exe') OR (LOWER("Process Name") LIKE '%\cmd.exe' OR LOWER("Process Name") LIKE '%\powershell.exe' OR LOWER("Process Name") LIKE '%\pwsh.exe' OR LOWER("Process Name") LIKE '%\cscript.exe' OR LOWER("Process Name") LIKE '%\wscript.exe' OR LOWER("Process Name") LIKE '%\mshta.exe')) OR (LOWER(Command) LIKE '%bitsadmin%' OR LOWER(Command) LIKE '%certutil%' OR LOWER(Command) LIKE '%curl%' OR LOWER(Command) LIKE '%finger%' OR LOWER(Command) LIKE '%forfiles%' OR LOWER(Command) LIKE '%regsvr32%' OR LOWER(Command) LIKE '%rundll32%' OR LOWER(Command) LIKE '%wget%'))
