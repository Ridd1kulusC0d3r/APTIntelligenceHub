-- Rundll32 Registered COM Objects | T1546.015 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_rundll32_registered_com_objects.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\rundll32.exe' OR LOWER("Process Name") LIKE '%\rundll32.exe') OR Filename='RUNDLL32.EXE') AND ((LOWER(Command) LIKE '%-sta %' OR LOWER(Command) LIKE '%-localserver %') AND (LOWER(Command) LIKE '%{%' AND LOWER(Command) LIKE '%}%'))
