-- Outlook Macro Execution Without Warning Setting Enabled | T1008, T1137, T1546 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_office_outlook_enable_macro_execution.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\outlook\security\level' OR LOWER("Target Process Name") LIKE '%\outlook\security\level' OR LOWER("Object Name") LIKE '%\outlook\security\level') AND LOWER(UTF8(payload)) LIKE '%0x00000001%'
