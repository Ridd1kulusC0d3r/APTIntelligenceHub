-- Session Manager Autorun Keys Modification | T1546.009, T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_asep_reg_keys_modification_session_manager.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\system\currentcontrolset\control\session manager%' OR LOWER("Target Process Name") LIKE '%\system\currentcontrolset\control\session manager%' OR LOWER("Object Name") LIKE '%\system\currentcontrolset\control\session manager%') AND ((LOWER("Process Name") LIKE '%\setupexecute%' OR LOWER("Process Name") LIKE '%\s0initialcommand%' OR LOWER("Process Name") LIKE '%\knowndlls%' OR LOWER("Process Name") LIKE '%\execute%' OR LOWER("Process Name") LIKE '%\bootexecute%' OR LOWER("Process Name") LIKE '%\appcertdlls%') OR (LOWER("Target Process Name") LIKE '%\setupexecute%' OR LOWER("Target Process Name") LIKE '%\s0initialcommand%' OR LOWER("Target Process Name") LIKE '%\knowndlls%' OR LOWER("Target Process Name") LIKE '%\execute%' OR LOWER("Target Process Name") LIKE '%\bootexecute%' OR LOWER("Target Process Name") LIKE '%\appcertdlls%') OR (LOWER("Object Name") LIKE '%\setupexecute%' OR LOWER("Object Name") LIKE '%\s0initialcommand%' OR LOWER("Object Name") LIKE '%\knowndlls%' OR LOWER("Object Name") LIKE '%\execute%' OR LOWER("Object Name") LIKE '%\bootexecute%' OR LOWER("Object Name") LIKE '%\appcertdlls%')) AND (NOT(LOWER(UTF8(payload)) LIKE '%(empty)%'))
