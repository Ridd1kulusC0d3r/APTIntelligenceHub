-- Root Certificate Installed From Susp Locations | T1553.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_import_cert_susp_locations.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Command) LIKE '%import-certificate%' AND LOWER(Command) LIKE '% -filepath %' AND LOWER(Command) LIKE '%cert:\localmachine\root%') AND (LOWER(Command) LIKE '%\appdata\local\temp\%' OR LOWER(Command) LIKE '%:\windows\temp\%' OR LOWER(Command) LIKE '%\desktop\%' OR LOWER(Command) LIKE '%\downloads\%' OR LOWER(Command) LIKE '%\perflogs\%' OR LOWER(Command) LIKE '%:\users\public\%')
