-- Cred Dump Tools Dropped Files | T1003.001, T1003.002, T1003.003, T1003.004, T1003.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_cred_dump_tools_dropped_files.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER(Filename) LIKE '%\fgdump-log%' OR LOWER(Filename) LIKE '%\kirbi%' OR LOWER(Filename) LIKE '%\pwdump%' OR LOWER(Filename) LIKE '%\pwhashes%' OR LOWER(Filename) LIKE '%\wce_ccache%' OR LOWER(Filename) LIKE '%\wce_krbtkts%') OR (LOWER(Filename) LIKE '%\cachedump.exe' OR LOWER(Filename) LIKE '%\cachedump64.exe' OR LOWER(Filename) LIKE '%\dumpext.dll' OR LOWER(Filename) LIKE '%\dumpsvc.exe' OR LOWER(Filename) LIKE '%\dumpy.exe' OR LOWER(Filename) LIKE '%\fgexec.exe' OR LOWER(Filename) LIKE '%\lsremora.dll' OR LOWER(Filename) LIKE '%\lsremora64.dll' OR LOWER(Filename) LIKE '%\ntds.out' OR LOWER(Filename) LIKE '%\procdump.exe' OR LOWER(Filename) LIKE '%\procdump64.exe' OR LOWER(Filename) LIKE '%\procdump64a.exe' OR LOWER(Filename) LIKE '%\pstgdump.exe' OR LOWER(Filename) LIKE '%\pwdump.exe' OR LOWER(Filename) LIKE '%\sam.out' OR LOWER(Filename) LIKE '%\security.out' OR LOWER(Filename) LIKE '%\servpw.exe' OR LOWER(Filename) LIKE '%\servpw64.exe' OR LOWER(Filename) LIKE '%\system.out' OR LOWER(Filename) LIKE '%\test.pwd' OR LOWER(Filename) LIKE '%\wceaux.dll'))
