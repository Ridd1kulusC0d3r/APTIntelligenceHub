-- Automated Collection Command PowerShell | T1119 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_automated_collection.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Message) LIKE '%.doc%' OR LOWER(Message) LIKE '%.docx%' OR LOWER(Message) LIKE '%.xls%' OR LOWER(Message) LIKE '%.xlsx%' OR LOWER(Message) LIKE '%.ppt%' OR LOWER(Message) LIKE '%.pptx%' OR LOWER(Message) LIKE '%.rtf%' OR LOWER(Message) LIKE '%.pdf%' OR LOWER(Message) LIKE '%.txt%') AND (LOWER(Message) LIKE '%get-childitem%' AND LOWER(Message) LIKE '% -recurse %' AND LOWER(Message) LIKE '% -include %')
