-- Cisco Clear Logs | T1070.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/cisco/aaa/cisco_cli_clear_logs.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype IN(6, 143, 273, 274, 20, 23, 26, 30, 31, 419, 41, 429, 431, 179, 435, 437, 182, 183, 56, 316, 448, 194, 90, 94, 95, 113, 114, 115, 116, 117, 248, 250, 508) AND (LOWER(UTF8(payload)) LIKE '%clear logging%' OR LOWER(UTF8(payload)) LIKE '%clear archive%')
