-- Diamond Sleet APT Scheduled Task Creation - Registry | T1685 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/TA/Diamond-Sleet/registry_event_apt_diamond_sleet_scheduled_task.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Name") LIKE '%\software\microsoft\windows nt\currentversion\schedule\taskcache\tree\%' AND LOWER("Process Name") LIKE '%windows teamcity settings user interface%') OR (LOWER("Target Process Name") LIKE '%\software\microsoft\windows nt\currentversion\schedule\taskcache\tree\%' AND LOWER("Target Process Name") LIKE '%windows teamcity settings user interface%') OR (LOWER("Object Name") LIKE '%\software\microsoft\windows nt\currentversion\schedule\taskcache\tree\%' AND LOWER("Object Name") LIKE '%windows teamcity settings user interface%'))
