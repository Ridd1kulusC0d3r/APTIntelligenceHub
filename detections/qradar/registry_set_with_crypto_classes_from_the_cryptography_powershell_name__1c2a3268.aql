-- Registry Set With Crypto-Classes From The "Cryptography" PowerShell Namespace | T1027.010, T1059.001, T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/registry/registry_set/registry_set_powershell_crypto_namespace.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\shell\open\command%' OR LOWER("Target Process Name") LIKE '%\shell\open\command%' OR LOWER("Object Name") LIKE '%\shell\open\command%') AND (LOWER(UTF8(payload)) LIKE '%powershell%' OR LOWER(UTF8(payload)) LIKE '%pwsh%') AND LOWER(UTF8(payload)) LIKE '%system.security.cryptography.%' AND (LOWER(UTF8(payload)) LIKE '%.aescryptoserviceprovider%' OR LOWER(UTF8(payload)) LIKE '%.descryptoserviceprovider%' OR LOWER(UTF8(payload)) LIKE '%.dsacryptoserviceprovider%' OR LOWER(UTF8(payload)) LIKE '%.rc2cryptoserviceprovider%' OR LOWER(UTF8(payload)) LIKE '%.rijndael%' OR LOWER(UTF8(payload)) LIKE '%.rsacryptoserviceprovider%' OR LOWER(UTF8(payload)) LIKE '%.tripledescryptoserviceprovider%')
