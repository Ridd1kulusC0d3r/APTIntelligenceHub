-- PowerShell Logging Disabled Via Registry Key Tampering | T1112, T1564.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_powershell_logging_disabled.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Name") LIKE '%\microsoft\windows\powershell\%' OR LOWER("Process Name") LIKE '%\microsoft\powershellcore\%') OR (LOWER("Target Process Name") LIKE '%\microsoft\windows\powershell\%' OR LOWER("Target Process Name") LIKE '%\microsoft\powershellcore\%') OR (LOWER("Object Name") LIKE '%\microsoft\windows\powershell\%' OR LOWER("Object Name") LIKE '%\microsoft\powershellcore\%')) AND ((LOWER("Process Name") LIKE '%\modulelogging\enablemodulelogging' OR LOWER("Process Name") LIKE '%\scriptblocklogging\enablescriptblocklogging' OR LOWER("Process Name") LIKE '%\scriptblocklogging\enablescriptblockinvocationlogging' OR LOWER("Process Name") LIKE '%\transcription\enabletranscripting' OR LOWER("Process Name") LIKE '%\transcription\enableinvocationheader' OR LOWER("Process Name") LIKE '%\enablescripts') OR (LOWER("Target Process Name") LIKE '%\modulelogging\enablemodulelogging' OR LOWER("Target Process Name") LIKE '%\scriptblocklogging\enablescriptblocklogging' OR LOWER("Target Process Name") LIKE '%\scriptblocklogging\enablescriptblockinvocationlogging' OR LOWER("Target Process Name") LIKE '%\transcription\enabletranscripting' OR LOWER("Target Process Name") LIKE '%\transcription\enableinvocationheader' OR LOWER("Target Process Name") LIKE '%\enablescripts') OR (LOWER("Object Name") LIKE '%\modulelogging\enablemodulelogging' OR LOWER("Object Name") LIKE '%\scriptblocklogging\enablescriptblocklogging' OR LOWER("Object Name") LIKE '%\scriptblocklogging\enablescriptblockinvocationlogging' OR LOWER("Object Name") LIKE '%\transcription\enabletranscripting' OR LOWER("Object Name") LIKE '%\transcription\enableinvocationheader' OR LOWER("Object Name") LIKE '%\enablescripts')) AND LOWER(UTF8(payload)) LIKE '%dword (0x00000000)%'
