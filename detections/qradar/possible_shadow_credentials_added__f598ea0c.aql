-- Possible Shadow Credentials Added | T1556 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_susp_possible_shadow_credentials_added.yml
SELECT * FROM events WHERE devicetype=12 AND "Event ID"=5136 AND (Username='msDS-KeyCredentialLink' OR "Account Name"='msDS-KeyCredentialLink' OR "Distinguished Name"='msDS-KeyCredentialLink')
