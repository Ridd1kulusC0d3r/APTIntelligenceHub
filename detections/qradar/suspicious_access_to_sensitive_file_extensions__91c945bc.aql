-- Suspicious Access to Sensitive File Extensions | T1039 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_susp_raccess_sensitive_fext.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND "Event ID"=5145 AND (LOWER(UTF8(payload)) LIKE '%.bak%' OR LOWER(UTF8(payload)) LIKE '%.dmp%' OR LOWER(UTF8(payload)) LIKE '%.edb%' OR LOWER(UTF8(payload)) LIKE '%.kirbi%' OR LOWER(UTF8(payload)) LIKE '%.msg%' OR LOWER(UTF8(payload)) LIKE '%.nsf%' OR LOWER(UTF8(payload)) LIKE '%.nst%' OR LOWER(UTF8(payload)) LIKE '%.oab%' OR LOWER(UTF8(payload)) LIKE '%.ost%' OR LOWER(UTF8(payload)) LIKE '%.pst%' OR LOWER(UTF8(payload)) LIKE '%.rdp%')
