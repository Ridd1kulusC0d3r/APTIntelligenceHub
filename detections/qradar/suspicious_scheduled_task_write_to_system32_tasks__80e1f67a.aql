-- Suspicious Scheduled Task Write to System32 Tasks | T1053 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_task_write.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER(Filename) LIKE '%\windows\system32\tasks%' AND ((LOWER("Process Path") LIKE '%\appdata\%' OR LOWER("Process Path") LIKE '%c:\perflogs%' OR LOWER("Process Path") LIKE '%\windows\system32\config\systemprofile%') OR (LOWER("Process Name") LIKE '%\appdata\%' OR LOWER("Process Name") LIKE '%c:\perflogs%' OR LOWER("Process Name") LIKE '%\windows\system32\config\systemprofile%'))
