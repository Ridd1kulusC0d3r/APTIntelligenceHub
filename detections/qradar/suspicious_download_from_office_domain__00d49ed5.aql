-- Suspicious Download from Office Domain | T1105, T1608 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_download_office_domain.yml
SELECT * FROM events WHERE devicetype=12 AND ((((LOWER("Process Path") LIKE '%\curl.exe' OR LOWER("Process Path") LIKE '%\wget.exe') OR (LOWER("Process Name") LIKE '%\curl.exe' OR LOWER("Process Name") LIKE '%\wget.exe')) OR (LOWER(Command) LIKE '%invoke-webrequest%' OR LOWER(Command) LIKE '%iwr %' OR LOWER(Command) LIKE '%curl %' OR LOWER(Command) LIKE '%wget %' OR LOWER(Command) LIKE '%start-bitstransfer%' OR LOWER(Command) LIKE '%.downloadfile(%' OR LOWER(Command) LIKE '%.downloadstring(%')) AND (LOWER(Command) LIKE '%https://attachment.outlook.live.net/owa/%' OR LOWER(Command) LIKE '%https://onenoteonlinesync.onenote.com/onenoteonlinesync/%'))
