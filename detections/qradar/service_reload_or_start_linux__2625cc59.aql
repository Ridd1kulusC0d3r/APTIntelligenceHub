-- Service Reload or Start - Linux | T1543.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/execve/lnx_auditd_susp_service_reload_or_restart.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND LOWER(UTF8(payload)) LIKE '%execve%' AND (LOWER(Command) LIKE '%a0%systemctl%' OR LOWER(Command) LIKE '%service%') AND (LOWER(Command) LIKE '%a1%reload%' OR LOWER(Command) LIKE '%start%')
