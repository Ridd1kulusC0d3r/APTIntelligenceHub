-- HackTool - NoFilter Execution | T1134, T1134.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_hktl_nofilter.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (("Event ID"=5447 AND LOWER(UTF8(payload)) LIKE '%ronpolicy%') OR ("Event ID"=5449 AND LOWER(UTF8(payload)) LIKE '%ronpolicy%'))
