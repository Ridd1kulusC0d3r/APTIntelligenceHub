-- Antivirus - Hacktool Signature | T1204 | https://github.com/SigmaHQ/sigma/blob/master/rules/category/antivirus/av_hacktool.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE (LOWER(UTF8(payload)) LIKE '%atk/%' OR LOWER(UTF8(payload)) LIKE '%exploit.script.cve%' OR LOWER(UTF8(payload)) LIKE '%hktl%' OR LOWER(UTF8(payload)) LIKE '%htool%' OR LOWER(UTF8(payload)) LIKE '%pws.%' OR LOWER(UTF8(payload)) LIKE '%pwsx%' OR LOWER(UTF8(payload)) LIKE '%securitytool%') OR (LOWER(UTF8(payload)) LIKE '%adfind%' OR LOWER(UTF8(payload)) LIKE '%bloodh%' OR LOWER(UTF8(payload)) LIKE '%bloodyad%' OR LOWER(UTF8(payload)) LIKE '%brutel%' OR LOWER(UTF8(payload)) LIKE '%bruter%' OR LOWER(UTF8(payload)) LIKE '%cobalt%' OR LOWER(UTF8(payload)) LIKE '%cobeacon%' OR LOWER(UTF8(payload)) LIKE '%cometer%' OR LOWER(UTF8(payload)) LIKE '%dumpcreds%' OR LOWER(UTF8(payload)) LIKE '%edrfreeze%' OR LOWER(UTF8(payload)) LIKE '%fastreverseproxy%' OR LOWER(UTF8(payload)) LIKE '%hacktool%' OR LOWER(UTF8(payload)) LIKE '%havoc%' OR LOWER(UTF8(payload)) LIKE '%impacket%' OR LOWER(UTF8(payload)) LIKE '%keylogger%' OR LOWER(UTF8(payload)) LIKE '%koadic%' OR LOWER(UTF8(payload)) LIKE '%mimikatz%' OR LOWER(UTF8(payload)) LIKE '%nighthawk%' OR LOWER(UTF8(payload)) LIKE '%pentestpowershell%' OR LOWER(UTF8(payload)) LIKE '%potato%' OR LOWER(UTF8(payload)) LIKE '%powersploit%' OR LOWER(UTF8(payload)) LIKE '%powerssh%' OR LOWER(UTF8(payload)) LIKE '%pshlspy%' OR LOWER(UTF8(payload)) LIKE '%pswtool%' OR LOWER(UTF8(payload)) LIKE '%pwcrack%' OR LOWER(UTF8(payload)) LIKE '%pwdump%' OR LOWER(UTF8(payload)) LIKE '%responder%' OR LOWER(UTF8(payload)) LIKE '%rozena%' OR LOWER(UTF8(payload)) LIKE '%rusthound%' OR LOWER(UTF8(payload)) LIKE '%sbelt%' OR LOWER(UTF8(payload)) LIKE '%seatbelt%' OR LOWER(UTF8(payload)) LIKE '%securitytool%' OR LOWER(UTF8(payload)) LIKE '%sharpdump%' OR LOWER(UTF8(payload)) LIKE '%sharphound%' OR LOWER(UTF8(payload)) LIKE '%shellcode%' OR LOWER(UTF8(payload)) LIKE '%sliver%' OR LOWER(UTF8(payload)) LIKE '%snaffler%' OR LOWER(UTF8(payload)) LIKE '%soaphound%' OR LOWER(UTF8(payload)) LIKE '%splinter%' OR LOWER(UTF8(payload)) LIKE '%stowaway%' OR LOWER(UTF8(payload)) LIKE '%swrort%' OR LOWER(UTF8(payload)) LIKE '%trojan.hound%' OR LOWER(UTF8(payload)) LIKE '%turtleloader%' OR LOWER(UTF8(payload)) LIKE '%undefend%' OR LOWER(UTF8(payload)) LIKE '%undfnd%')
