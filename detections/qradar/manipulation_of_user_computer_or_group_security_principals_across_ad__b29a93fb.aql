-- Manipulation of User Computer or Group Security Principals Across AD | T1136.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_directoryservices_accountmanagement.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER(Message) LIKE '%system.directoryservices.accountmanagement%'
