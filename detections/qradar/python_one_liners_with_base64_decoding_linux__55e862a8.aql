-- Python One-Liners with Base64 Decoding - Linux | T1027.010, T1059.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_python_base64_encoded_execution.yml
SELECT * FROM events WHERE devicetype=11 AND (LOWER("Process Path") LIKE '%/python%' OR LOWER("Process Name") LIKE '%/python%') AND ((LOWER(Command) LIKE '%import%' AND LOWER(Command) LIKE '%base64%' AND LOWER(Command) LIKE '% -c%') AND (LOWER(Command) LIKE '%.decode%' OR LOWER(Command) LIKE '%b16decode%' OR LOWER(Command) LIKE '%b32decode%' OR LOWER(Command) LIKE '%b32hexdecode%' OR LOWER(Command) LIKE '%b64decode%' OR LOWER(Command) LIKE '%b85decode%' OR LOWER(Command) LIKE '%z85decode%'))
