-- Loading of Kernel Module via Insmod | T1547.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/syscall/lnx_auditd_load_module_insmod.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND LOWER(UTF8(payload)) LIKE '%syscall%' AND LOWER(UTF8(payload)) LIKE '%insmod%' AND LOWER(UTF8(payload)) LIKE '%/usr/bin/kmod%'
