-- Meterpreter or Cobalt Strike Getsystem Service Installation - Security | T1134.001, T1134.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_meterpreter_or_cobaltstrike_getsystem_service_install.yml
SELECT * FROM events WHERE devicetype=12 AND "Event ID"=4697 AND (((LOWER("Service Filename") LIKE '%/c%' AND LOWER("Service Filename") LIKE '%echo%' AND LOWER("Service Filename") LIKE '%\pipe\%') AND (LOWER("Service Filename") LIKE '%cmd%' OR LOWER("Service Filename") LIKE '%%comspec%%')) OR (LOWER("Service Filename") LIKE '%rundll32%' AND LOWER("Service Filename") LIKE '%.dll,a%' AND LOWER("Service Filename") LIKE '%/p:%') OR LOWER("Service Filename") LIKE '\\127.0.0.1\admin$\%')
