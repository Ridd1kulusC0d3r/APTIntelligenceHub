-- Persistence Via Sticky Key Backdoor | T1546.008 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_cmd_sticky_keys_replace.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER(Command) LIKE '%copy %' AND LOWER(Command) LIKE '%/y %' AND LOWER(Command) LIKE '%c:\windows\system32\cmd.exe c:\windows\system32\sethc.exe%'
