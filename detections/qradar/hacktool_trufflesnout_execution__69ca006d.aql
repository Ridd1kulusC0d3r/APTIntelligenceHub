-- HackTool - TruffleSnout Execution | T1482 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_trufflesnout.yml
SELECT * FROM events WHERE devicetype=12 AND (Filename='TruffleSnout.exe' OR (LOWER("Process Path") LIKE '%\trufflesnout.exe' OR LOWER("Process Name") LIKE '%\trufflesnout.exe'))
