-- ADFS Database Named Pipe Connection By Uncommon Tool | T1005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/pipe_created/pipe_created_adfs_namedpipe_connection_uncommon_tool.yml
SELECT * FROM events WHERE devicetype=12 AND "Pipe Name"='\MICROSOFT##WID\tsql\query' AND (NOT(((LOWER("Process Path") LIKE '%:\windows\system32\mmc.exe' OR LOWER("Process Path") LIKE '%:\windows\system32\svchost.exe' OR LOWER("Process Path") LIKE '%:\windows\system32\wsmprovhost.exe' OR LOWER("Process Path") LIKE '%:\windows\syswow64\mmc.exe' OR LOWER("Process Path") LIKE '%:\windows\syswow64\wsmprovhost.exe' OR LOWER("Process Path") LIKE '%:\windows\wid\binn\sqlwriter.exe' OR LOWER("Process Path") LIKE '%\azureadconnect.exe' OR LOWER("Process Path") LIKE '%\microsoft.identity.health.adfs.pshsurrogate.exe' OR LOWER("Process Path") LIKE '%\microsoft.identityserver.servicehost.exe' OR LOWER("Process Path") LIKE '%\microsoft.tri.sensor.exe' OR LOWER("Process Path") LIKE '%\sqlservr.exe' OR LOWER("Process Path") LIKE '%\tssdis.exe') OR (LOWER("Process Name") LIKE '%:\windows\system32\mmc.exe' OR LOWER("Process Name") LIKE '%:\windows\system32\svchost.exe' OR LOWER("Process Name") LIKE '%:\windows\system32\wsmprovhost.exe' OR LOWER("Process Name") LIKE '%:\windows\syswow64\mmc.exe' OR LOWER("Process Name") LIKE '%:\windows\syswow64\wsmprovhost.exe' OR LOWER("Process Name") LIKE '%:\windows\wid\binn\sqlwriter.exe' OR LOWER("Process Name") LIKE '%\azureadconnect.exe' OR LOWER("Process Name") LIKE '%\microsoft.identity.health.adfs.pshsurrogate.exe' OR LOWER("Process Name") LIKE '%\microsoft.identityserver.servicehost.exe' OR LOWER("Process Name") LIKE '%\microsoft.tri.sensor.exe' OR LOWER("Process Name") LIKE '%\sqlservr.exe' OR LOWER("Process Name") LIKE '%\tssdis.exe'))))
