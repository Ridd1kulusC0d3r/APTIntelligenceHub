-- ESXi Syslog Configuration Change Via ESXCLI | T1059.012, T1685, T1690 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_esxcli_syslog_config_change.yml
SELECT * FROM events WHERE devicetype=11 AND (LOWER("Process Path") LIKE '%/esxcli' OR LOWER("Process Name") LIKE '%/esxcli') AND (LOWER(Command) LIKE '%system%' AND LOWER(Command) LIKE '%syslog%' AND LOWER(Command) LIKE '%config%') AND LOWER(Command) LIKE '% set%'
