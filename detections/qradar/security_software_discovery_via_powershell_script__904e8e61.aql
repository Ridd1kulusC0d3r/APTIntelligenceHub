-- Security Software Discovery Via Powershell Script | T1518.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_get_process_security_software_discovery.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Message) LIKE '%get-process | ?%' OR LOWER(Message) LIKE '%get-process | where%' OR LOWER(Message) LIKE '%gps | ?%' OR LOWER(Message) LIKE '%gps | where%') AND (LOWER(Message) LIKE '%company -like%' OR LOWER(Message) LIKE '%description -like%' OR LOWER(Message) LIKE '%name -like%' OR LOWER(Message) LIKE '%path -like%' OR LOWER(Message) LIKE '%product -like%') AND (LOWER(Message) LIKE '%*avira*%' OR LOWER(Message) LIKE '%*carbonblack*%' OR LOWER(Message) LIKE '%*cylance*%' OR LOWER(Message) LIKE '%*defender*%' OR LOWER(Message) LIKE '%*kaspersky*%' OR LOWER(Message) LIKE '%*malware*%' OR LOWER(Message) LIKE '%*sentinel*%' OR LOWER(Message) LIKE '%*symantec*%' OR LOWER(Message) LIKE '%*virus*%')
