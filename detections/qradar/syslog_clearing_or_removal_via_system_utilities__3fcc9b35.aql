-- Syslog Clearing or Removal Via System Utilities | T1685.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_clear_syslog.yml
SELECT * FROM events WHERE devicetype=11 AND ((LOWER(Command) LIKE '%/var/log/syslog%' AND (((LOWER("Process Path") LIKE '%/rm' OR LOWER("Process Name") LIKE '%/rm') AND (LOWER(Command) LIKE '% -r %' OR LOWER(Command) LIKE '% -f %' OR LOWER(Command) LIKE '% -rf %' OR LOWER(Command) LIKE '%/var/log/syslog%')) OR (LOWER("Process Path") LIKE '%/unlink' OR LOWER("Process Name") LIKE '%/unlink') OR (LOWER("Process Path") LIKE '%/mv' OR LOWER("Process Name") LIKE '%/mv') OR ((LOWER("Process Path") LIKE '%/truncate' OR LOWER("Process Name") LIKE '%/truncate') AND (LOWER(Command) LIKE '%0 %' AND LOWER(Command) LIKE '%/var/log/syslog%') AND (LOWER(Command) LIKE '%-s %' OR LOWER(Command) LIKE '%-c %' OR LOWER(Command) LIKE '%--size%')) OR ((LOWER("Process Path") LIKE '%/ln' OR LOWER("Process Name") LIKE '%/ln') AND (LOWER(Command) LIKE '%/dev/null %' AND LOWER(Command) LIKE '%/var/log/syslog%') AND (LOWER(Command) LIKE '%-sf %' OR LOWER(Command) LIKE '%-sfn %' OR LOWER(Command) LIKE '%-sft %')) OR ((LOWER("Process Path") LIKE '%/cp' OR LOWER("Process Name") LIKE '%/cp') AND LOWER(Command) LIKE '%/dev/null%') OR ((LOWER("Process Path") LIKE '%/shred' OR LOWER("Process Name") LIKE '%/shred') AND LOWER(Command) LIKE '%-u %'))) OR ((LOWER(Command) LIKE '% > /var/log/syslog%' OR LOWER(Command) LIKE '% >/var/log/syslog%' OR LOWER(Command) LIKE '% >| /var/log/syslog%' OR LOWER(Command) LIKE '%: > /var/log/syslog%' OR LOWER(Command) LIKE '%:> /var/log/syslog%' OR LOWER(Command) LIKE '%:>/var/log/syslog%' OR LOWER(Command) LIKE '%>|/var/log/syslog%') OR (LOWER(Command) LIKE '%journalctl --vacuum%' OR LOWER(Command) LIKE '%journalctl --rotate%')))
