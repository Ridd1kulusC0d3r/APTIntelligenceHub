-- ESXi Network Configuration Discovery Via ESXCLI | T1007, T1033, T1059.012 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_esxcli_network_discovery.yml
SELECT * FROM events WHERE devicetype=11 AND ((LOWER("Process Path") LIKE '%/esxcli' OR LOWER("Process Name") LIKE '%/esxcli') AND LOWER(Command) LIKE '%network%') AND (LOWER(Command) LIKE '% get%' OR LOWER(Command) LIKE '% list%')
