-- Potential Persistence Via Shim Database In Uncommon Location | T1546.011 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_persistence_shim_database_uncommon_location.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Name") LIKE '%\software\microsoft\windows nt\currentversion\appcompatflags\installedsdb\%' AND LOWER("Process Name") LIKE '%\databasepath%') OR (LOWER("Target Process Name") LIKE '%\software\microsoft\windows nt\currentversion\appcompatflags\installedsdb\%' AND LOWER("Target Process Name") LIKE '%\databasepath%') OR (LOWER("Object Name") LIKE '%\software\microsoft\windows nt\currentversion\appcompatflags\installedsdb\%' AND LOWER("Object Name") LIKE '%\databasepath%')) AND (NOT(LOWER(UTF8(payload)) LIKE '%:\windows\apppatch\custom%'))
