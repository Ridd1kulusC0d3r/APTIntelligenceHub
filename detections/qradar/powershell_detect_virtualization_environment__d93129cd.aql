-- Powershell Detect Virtualization Environment | T1497.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_detect_vm_env.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Message) LIKE '%get-wmiobject%' OR LOWER(Message) LIKE '%gwmi%') AND (LOWER(Message) LIKE '%msacpi_thermalzonetemperature%' OR LOWER(Message) LIKE '%win32_computersystem%')
