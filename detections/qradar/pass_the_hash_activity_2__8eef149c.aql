-- Pass the Hash Activity 2 | T1550.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/account_management/win_security_pass_the_hash_2.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (("Event ID"=4624 AND LOWER(UTF8(payload)) LIKE '%s-1-0-0%' AND "Logon Type"=3 AND LOWER(UTF8(payload)) LIKE '%ntlmssp%' AND LOWER(UTF8(payload)) LIKE '%keylength%0%') OR ("Event ID"=4624 AND "Logon Type"=9 AND LOWER(UTF8(payload)) LIKE '%seclogo%')) AND (NOT("Target Username"='ANONYMOUS LOGON'))
