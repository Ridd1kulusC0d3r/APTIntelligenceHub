-- Program Executions in Suspicious Folders | T1584, T1587 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/syscall/lnx_auditd_susp_exe_folders.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND LOWER(UTF8(payload)) LIKE '%syscall%' AND (LOWER(UTF8(payload)) LIKE '%/tmp/%' OR LOWER(UTF8(payload)) LIKE '%/var/www/%' OR LOWER(UTF8(payload)) LIKE '%/home/%/public_html/%' OR LOWER(UTF8(payload)) LIKE '%/usr/local/apache2/%' OR LOWER(UTF8(payload)) LIKE '%/usr/local/httpd/%' OR LOWER(UTF8(payload)) LIKE '%/var/apache/%' OR LOWER(UTF8(payload)) LIKE '%/srv/www/%' OR LOWER(UTF8(payload)) LIKE '%/home/httpd/html/%' OR LOWER(UTF8(payload)) LIKE '%/srv/http/%' OR LOWER(UTF8(payload)) LIKE '%/usr/share/nginx/html/%' OR LOWER(UTF8(payload)) LIKE '%/var/lib/pgsql/data/%' OR LOWER(UTF8(payload)) LIKE '%/usr/local/mysql/data/%' OR LOWER(UTF8(payload)) LIKE '%/var/lib/mysql/%' OR LOWER(UTF8(payload)) LIKE '%/var/vsftpd/%' OR LOWER(UTF8(payload)) LIKE '%/etc/bind/%' OR LOWER(UTF8(payload)) LIKE '%/var/named/%')
