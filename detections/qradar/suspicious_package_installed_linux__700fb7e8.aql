-- Suspicious Package Installed - Linux | T1553.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_install_suspicious_packages.yml
SELECT * FROM events WHERE devicetype=11 AND ((((LOWER("Process Path") LIKE '%/apt' OR LOWER("Process Path") LIKE '%/apt-get') OR (LOWER("Process Name") LIKE '%/apt' OR LOWER("Process Name") LIKE '%/apt-get')) AND LOWER(Command) LIKE '%install%') OR ((LOWER("Process Path") LIKE '%/yum' OR LOWER("Process Name") LIKE '%/yum') AND (LOWER(Command) LIKE '%localinstall%' OR LOWER(Command) LIKE '%install%')) OR ((LOWER("Process Path") LIKE '%/rpm' OR LOWER("Process Name") LIKE '%/rpm') AND LOWER(Command) LIKE '%-i%') OR ((LOWER("Process Path") LIKE '%/dpkg' OR LOWER("Process Name") LIKE '%/dpkg') AND (LOWER(Command) LIKE '%--install%' OR LOWER(Command) LIKE '%-i%'))) AND (LOWER(Command) LIKE '%nmap%' OR LOWER(Command) LIKE '% nc%' OR LOWER(Command) LIKE '%netcat%' OR LOWER(Command) LIKE '%wireshark%' OR LOWER(Command) LIKE '%tshark%' OR LOWER(Command) LIKE '%openconnect%' OR LOWER(Command) LIKE '%proxychains%' OR LOWER(Command) LIKE '%socat%')
