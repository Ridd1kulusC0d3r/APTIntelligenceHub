-- Directory Service Restore Mode(DSRM) Registry Value Tampering | T1556 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_dsrm_tampering.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\control\lsa\dsrmadminlogonbehavior' OR LOWER("Target Process Name") LIKE '%\control\lsa\dsrmadminlogonbehavior' OR LOWER("Object Name") LIKE '%\control\lsa\dsrmadminlogonbehavior') AND (NOT(LOWER(UTF8(payload)) LIKE '%dword (0x00000000)%'))
