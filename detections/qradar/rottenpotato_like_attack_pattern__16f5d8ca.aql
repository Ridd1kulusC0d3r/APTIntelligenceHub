-- RottenPotato Like Attack Pattern | T1557.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/account_management/win_security_susp_rottenpotato.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND "Event ID"=4624 AND "Logon Type"=3 AND "Target Username"='ANONYMOUS LOGON' AND LOWER(UTF8(payload)) LIKE '%-%' AND (LOWER(UTF8(payload)) LIKE '%127.0.0.1%' OR LOWER(UTF8(payload)) LIKE '%::1%')
