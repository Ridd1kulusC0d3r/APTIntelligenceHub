-- HackTool - SharpUp PrivEsc Tool Execution | T1569.002, T1574.005, T1615 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_sharpup.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\sharpup.exe' OR LOWER("Process Name") LIKE '%\sharpup.exe') OR LOWER(UTF8(payload)) LIKE '%sharpup%' OR (LOWER(Command) LIKE '%hijackablepaths%' OR LOWER(Command) LIKE '%unquotedservicepath%' OR LOWER(Command) LIKE '%processdllhijack%' OR LOWER(Command) LIKE '%modifiableservicebinaries%' OR LOWER(Command) LIKE '%modifiablescheduledtask%' OR LOWER(Command) LIKE '%domaingpppassword%' OR LOWER(Command) LIKE '%cachedgpppassword%'))
