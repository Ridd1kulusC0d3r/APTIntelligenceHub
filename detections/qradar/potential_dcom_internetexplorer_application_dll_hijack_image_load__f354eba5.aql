-- Potential DCOM InternetExplorer.Application DLL Hijack - Image Load | T1021.002, T1021.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/image_load/image_load_iexplore_dcom_iertutil_dll_hijack.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Path") LIKE '%\internet explorer\iexplore.exe' OR LOWER("Process Name") LIKE '%\internet explorer\iexplore.exe') AND LOWER(CONCAT('file directory', '/', filename)) LIKE '%\internet explorer\iertutil.dll'
