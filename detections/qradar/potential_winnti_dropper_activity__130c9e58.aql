-- Potential Winnti Dropper Activity | T1027 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_redmimicry_winnti_filedrop.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Filename) LIKE '%\gthread-3.6.dll' OR LOWER(Filename) LIKE '%\sigcmm-2.4.dll' OR LOWER(Filename) LIKE '%\windows\temp\tmp.bat')
