-- Writing Of Malicious Files To The Fonts Folder | T1059, T1211 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_hiding_malware_in_fonts_folder.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Command) LIKE '%echo%' OR LOWER(Command) LIKE '%copy%' OR LOWER(Command) LIKE '%type%' OR LOWER(Command) LIKE '%file createnew%' OR LOWER(Command) LIKE '%cacls%') AND LOWER(Command) LIKE '%c:\windows\fonts\%' AND (LOWER(Command) LIKE '%.sh%' OR LOWER(Command) LIKE '%.exe%' OR LOWER(Command) LIKE '%.dll%' OR LOWER(Command) LIKE '%.bin%' OR LOWER(Command) LIKE '%.bat%' OR LOWER(Command) LIKE '%.cmd%' OR LOWER(Command) LIKE '%.js%' OR LOWER(Command) LIKE '%.msh%' OR LOWER(Command) LIKE '%.reg%' OR LOWER(Command) LIKE '%.scr%' OR LOWER(Command) LIKE '%.ps%' OR LOWER(Command) LIKE '%.vb%' OR LOWER(Command) LIKE '%.jar%' OR LOWER(Command) LIKE '%.pl%' OR LOWER(Command) LIKE '%.inf%' OR LOWER(Command) LIKE '%.cpl%' OR LOWER(Command) LIKE '%.hta%' OR LOWER(Command) LIKE '%.msi%' OR LOWER(Command) LIKE '%.vbs%')
