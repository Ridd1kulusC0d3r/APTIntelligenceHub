-- DNS TOR Proxies | T1048 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/zeek/zeek_dns_torproxy.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%.hiddenservice.net%' OR LOWER(UTF8(payload)) LIKE '%.onion.ca%' OR LOWER(UTF8(payload)) LIKE '%.onion.cab%' OR LOWER(UTF8(payload)) LIKE '%.onion.casa%' OR LOWER(UTF8(payload)) LIKE '%.onion.city%' OR LOWER(UTF8(payload)) LIKE '%.onion.direct%' OR LOWER(UTF8(payload)) LIKE '%.onion.dog%' OR LOWER(UTF8(payload)) LIKE '%.onion.glass%' OR LOWER(UTF8(payload)) LIKE '%.onion.gq%' OR LOWER(UTF8(payload)) LIKE '%.onion.guide%' OR LOWER(UTF8(payload)) LIKE '%.onion.in.net%' OR LOWER(UTF8(payload)) LIKE '%.onion.ink%' OR LOWER(UTF8(payload)) LIKE '%.onion.it%' OR LOWER(UTF8(payload)) LIKE '%.onion.link%' OR LOWER(UTF8(payload)) LIKE '%.onion.lt%' OR LOWER(UTF8(payload)) LIKE '%.onion.lu%' OR LOWER(UTF8(payload)) LIKE '%.onion.ly%' OR LOWER(UTF8(payload)) LIKE '%.onion.mn%' OR LOWER(UTF8(payload)) LIKE '%.onion.network%' OR LOWER(UTF8(payload)) LIKE '%.onion.nu%' OR LOWER(UTF8(payload)) LIKE '%.onion.pet%' OR LOWER(UTF8(payload)) LIKE '%.onion.plus%' OR LOWER(UTF8(payload)) LIKE '%.onion.pt%' OR LOWER(UTF8(payload)) LIKE '%.onion.pw%' OR LOWER(UTF8(payload)) LIKE '%.onion.rip%' OR LOWER(UTF8(payload)) LIKE '%.onion.sh%' OR LOWER(UTF8(payload)) LIKE '%.onion.si%' OR LOWER(UTF8(payload)) LIKE '%.onion.to%' OR LOWER(UTF8(payload)) LIKE '%.onion.top%' OR LOWER(UTF8(payload)) LIKE '%.onion.ws%' OR LOWER(UTF8(payload)) LIKE '%.onion%' OR LOWER(UTF8(payload)) LIKE '%.s1.tor-gateways.de%' OR LOWER(UTF8(payload)) LIKE '%.s2.tor-gateways.de%' OR LOWER(UTF8(payload)) LIKE '%.s3.tor-gateways.de%' OR LOWER(UTF8(payload)) LIKE '%.s4.tor-gateways.de%' OR LOWER(UTF8(payload)) LIKE '%.s5.tor-gateways.de%' OR LOWER(UTF8(payload)) LIKE '%.t2w.pw%' OR LOWER(UTF8(payload)) LIKE '%.tor2web.ae.org%' OR LOWER(UTF8(payload)) LIKE '%.tor2web.blutmagie.de%' OR LOWER(UTF8(payload)) LIKE '%.tor2web.com%' OR LOWER(UTF8(payload)) LIKE '%.tor2web.fi%' OR LOWER(UTF8(payload)) LIKE '%.tor2web.io%' OR LOWER(UTF8(payload)) LIKE '%.tor2web.org%' OR LOWER(UTF8(payload)) LIKE '%.tor2web.xyz%' OR LOWER(UTF8(payload)) LIKE '%.torlink.co%'
