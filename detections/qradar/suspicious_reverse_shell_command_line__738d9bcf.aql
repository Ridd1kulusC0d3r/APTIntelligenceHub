-- Suspicious Reverse Shell Command Line | T1059.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/builtin/lnx_shell_susp_rev_shells.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND (LOWER(UTF8(payload)) LIKE '%begin {s = "/inet/tcp/0/%' OR LOWER(UTF8(payload)) LIKE '%bash -i >& /dev/tcp/%' OR LOWER(UTF8(payload)) LIKE '%bash -i >& /dev/udp/%' OR LOWER(UTF8(payload)) LIKE '%sh -i >$ /dev/udp/%' OR LOWER(UTF8(payload)) LIKE '%sh -i >$ /dev/tcp/%' OR LOWER(UTF8(payload)) LIKE '%&& while read line 0<&5; do%' OR LOWER(UTF8(payload)) LIKE '%/bin/bash -c exec 5<>/dev/tcp/%' OR LOWER(UTF8(payload)) LIKE '%/bin/bash -c exec 5<>/dev/udp/%' OR LOWER(UTF8(payload)) LIKE '%nc -e /bin/sh %' OR LOWER(UTF8(payload)) LIKE '%/bin/sh | nc%' OR LOWER(UTF8(payload)) LIKE '%rm -f backpipe; mknod /tmp/backpipe p && nc %' OR LOWER(UTF8(payload)) LIKE '%;socket(s,pf_inet,sock_stream,getprotobyname("tcp"));if(connect(s,sockaddr_in($p,inet_aton($i))))%' OR LOWER(UTF8(payload)) LIKE '%;stdin->fdopen($c,r);$~->fdopen($c,w);system$_ while<>;%' OR LOWER(UTF8(payload)) LIKE '%/bin/sh -i <&3 >&3 2>&3%' OR LOWER(UTF8(payload)) LIKE '%uname -a; w; id; /bin/bash -i%' OR LOWER(UTF8(payload)) LIKE '%$sendbyte = ([text.encoding]::ascii).getbytes($sendback2); $stream.write($sendbyte,0,$sendbyte.length); $stream.flush()};%' OR LOWER(UTF8(payload)) LIKE '%;os.dup2(s.fileno(),0);os.dup2(s.fileno(),1);os.dup2(s.fileno(),2);os.putenv(''histfile'',''/dev/null'');%' OR LOWER(UTF8(payload)) LIKE '%.to_i;exec sprintf("/bin/sh -i <&%d >&%d 2>&%d",f,f,f)%' OR LOWER(UTF8(payload)) LIKE '%;while(cmd=c.gets);io.popen(cmd,"r"){|io|c.print%' OR LOWER(UTF8(payload)) LIKE '%socat exec:''bash -li'',pty,stderr,setsid,sigint,sane tcp:%' OR LOWER(UTF8(payload)) LIKE '%rm -f /tmp/p; mknod /tmp/p p &&%' OR LOWER(UTF8(payload)) LIKE '% | /bin/bash | telnet %' OR LOWER(UTF8(payload)) LIKE '%,echo=0,raw tcp-listen:%' OR LOWER(UTF8(payload)) LIKE '%nc -lvvp %' OR LOWER(UTF8(payload)) LIKE '%xterm -display 1%')
