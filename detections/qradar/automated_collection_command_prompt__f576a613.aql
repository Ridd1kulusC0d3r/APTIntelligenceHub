-- Automated Collection Command Prompt | T1119, T1552.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_automated_collection.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Command) LIKE '%.doc%' OR LOWER(Command) LIKE '%.docx%' OR LOWER(Command) LIKE '%.xls%' OR LOWER(Command) LIKE '%.xlsx%' OR LOWER(Command) LIKE '%.ppt%' OR LOWER(Command) LIKE '%.pptx%' OR LOWER(Command) LIKE '%.rtf%' OR LOWER(Command) LIKE '%.pdf%' OR LOWER(Command) LIKE '%.txt%') AND ((LOWER(Command) LIKE '%dir %' AND LOWER(Command) LIKE '% /b %' AND LOWER(Command) LIKE '% /s %') OR (Filename='FINDSTR.EXE' AND (LOWER(Command) LIKE '% /e %' OR LOWER(Command) LIKE '% /si %')))
