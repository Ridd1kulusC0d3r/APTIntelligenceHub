-- Suspicious Child Process Created as System | T1134.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_child_process_as_system_.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER(UTF8(payload)) LIKE '%authori%' OR LOWER(UTF8(payload)) LIKE '%autori%') AND (LOWER(UTF8(payload)) LIKE '%\network service%' OR LOWER(UTF8(payload)) LIKE '%\local service%') AND (LOWER(Username) LIKE '%authori%' OR LOWER(Username) LIKE '%autori%') AND (LOWER(Username) LIKE '%\system' OR LOWER(Username) LIKE '%\système' OR LOWER(Username) LIKE '%\система') AND ("Integrity Level" IN('System', 'S-1-16-16384'))) AND (NOT(((LOWER("Process Path") LIKE '%\rundll32.exe' OR LOWER("Process Name") LIKE '%\rundll32.exe') AND LOWER(Command) LIKE '%davsetcookie%')))
