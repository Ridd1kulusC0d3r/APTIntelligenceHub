-- HackTool - Mimikatz Execution | T1003.001, T1003.002, T1003.004, T1003.005, T1003.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_mimikatz_command_line.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER(Command) LIKE '%dumpcreds%' OR LOWER(Command) LIKE '%mimikatz%') OR (LOWER(Command) LIKE '%::aadcookie%' OR LOWER(Command) LIKE '%::detours%' OR LOWER(Command) LIKE '%::memssp%' OR LOWER(Command) LIKE '%::mflt%' OR LOWER(Command) LIKE '%::ncroutemon%' OR LOWER(Command) LIKE '%::ngcsign%' OR LOWER(Command) LIKE '%::printnightmare%' OR LOWER(Command) LIKE '%::skeleton%' OR LOWER(Command) LIKE '%::preshutdown%' OR LOWER(Command) LIKE '%::mstsc%' OR LOWER(Command) LIKE '%::multirdp%') OR (LOWER(Command) LIKE '%rpc::%' OR LOWER(Command) LIKE '%token::%' OR LOWER(Command) LIKE '%crypto::%' OR LOWER(Command) LIKE '%dpapi::%' OR LOWER(Command) LIKE '%sekurlsa::%' OR LOWER(Command) LIKE '%kerberos::%' OR LOWER(Command) LIKE '%lsadump::%' OR LOWER(Command) LIKE '%privilege::%' OR LOWER(Command) LIKE '%process::%' OR LOWER(Command) LIKE '%vault::%'))
