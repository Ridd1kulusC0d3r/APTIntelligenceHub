-- Antivirus - Web Shell Detection Signature | T1505.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/category/antivirus/av_webshell.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE (LOWER(UTF8(payload)) LIKE '%asp.%' OR LOWER(UTF8(payload)) LIKE '%iis/backdoor%' OR LOWER(UTF8(payload)) LIKE '%java/backdoor%' OR LOWER(UTF8(payload)) LIKE '%jsp.%' OR LOWER(UTF8(payload)) LIKE '%perl.%' OR LOWER(UTF8(payload)) LIKE '%php.%' OR LOWER(UTF8(payload)) LIKE '%troj/asp%' OR LOWER(UTF8(payload)) LIKE '%troj/jsp%' OR LOWER(UTF8(payload)) LIKE '%troj/php%' OR LOWER(UTF8(payload)) LIKE '%vbs/uxor%') OR (LOWER(UTF8(payload)) LIKE '%asp_%' OR LOWER(UTF8(payload)) LIKE '%asp:%' OR LOWER(UTF8(payload)) LIKE '%asp.agent%' OR LOWER(UTF8(payload)) LIKE '%asp/%' OR LOWER(UTF8(payload)) LIKE '%aspdoor%' OR LOWER(UTF8(payload)) LIKE '%aspxspy%' OR LOWER(UTF8(payload)) LIKE '%backdoor.asp%' OR LOWER(UTF8(payload)) LIKE '%backdoor.java%' OR LOWER(UTF8(payload)) LIKE '%backdoor.jsp%' OR LOWER(UTF8(payload)) LIKE '%backdoor.php%' OR LOWER(UTF8(payload)) LIKE '%backdoor.vbs%' OR LOWER(UTF8(payload)) LIKE '%backdoor/asp%' OR LOWER(UTF8(payload)) LIKE '%backdoor/java%' OR LOWER(UTF8(payload)) LIKE '%backdoor/jsp%' OR LOWER(UTF8(payload)) LIKE '%backdoor/php%' OR LOWER(UTF8(payload)) LIKE '%backdoor/vbs%' OR LOWER(UTF8(payload)) LIKE '%c99shell%' OR LOWER(UTF8(payload)) LIKE '%chopper%' OR LOWER(UTF8(payload)) LIKE '%filebrowser%' OR LOWER(UTF8(payload)) LIKE '%jsp_%' OR LOWER(UTF8(payload)) LIKE '%jsp:%' OR LOWER(UTF8(payload)) LIKE '%jsp.agent%' OR LOWER(UTF8(payload)) LIKE '%jsp/%' OR LOWER(UTF8(payload)) LIKE '%perl:%' OR LOWER(UTF8(payload)) LIKE '%perl/%' OR LOWER(UTF8(payload)) LIKE '%php_%' OR LOWER(UTF8(payload)) LIKE '%php:%' OR LOWER(UTF8(payload)) LIKE '%php.agent%' OR LOWER(UTF8(payload)) LIKE '%php/%' OR LOWER(UTF8(payload)) LIKE '%phpshell%' OR LOWER(UTF8(payload)) LIKE '%pshlspy%' OR LOWER(UTF8(payload)) LIKE '%sinochoper%' OR LOWER(UTF8(payload)) LIKE '%trojan.asp%' OR LOWER(UTF8(payload)) LIKE '%trojan.jsp%' OR LOWER(UTF8(payload)) LIKE '%trojan.php%' OR LOWER(UTF8(payload)) LIKE '%trojan.vbs%' OR LOWER(UTF8(payload)) LIKE '%vbs.agent%' OR LOWER(UTF8(payload)) LIKE '%vbs/agent%' OR LOWER(UTF8(payload)) LIKE '%webshell%')
