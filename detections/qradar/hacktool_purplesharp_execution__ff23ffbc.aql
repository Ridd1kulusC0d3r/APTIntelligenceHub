-- HackTool - PurpleSharp Execution | T1587 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_purplesharp_indicators.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\purplesharp%' OR LOWER("Process Name") LIKE '%\purplesharp%') OR Filename='PurpleSharp.exe') OR (LOWER(Command) LIKE '%xyz123456.exe%' OR LOWER(Command) LIKE '%purplesharp%'))
