-- HybridConnectionManager Service Installation | T1554 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_hybridconnectionmgr_svc_installation.yml
SELECT * FROM events WHERE devicetype=12 AND "Event ID"=4697 AND "Service Name"='HybridConnectionManager' AND LOWER("Service Filename") LIKE '%hybridconnectionmanager%'
