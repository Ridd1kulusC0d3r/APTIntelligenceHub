-- Suspicious LNK Double Extension File Created | T1036.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_lnk_double_extension.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Filename) LIKE '%.lnk' AND (LOWER(Filename) LIKE '%.doc.%' OR LOWER(Filename) LIKE '%.docx.%' OR LOWER(Filename) LIKE '%.jpg.%' OR LOWER(Filename) LIKE '%.pdf.%' OR LOWER(Filename) LIKE '%.ppt.%' OR LOWER(Filename) LIKE '%.pptx.%' OR LOWER(Filename) LIKE '%.xls.%' OR LOWER(Filename) LIKE '%.xlsx.%')) AND (NOT(LOWER(Filename) LIKE '%\appdata\roaming\microsoft\windows\recent\%')) AND (NOT(((((LOWER("Process Path") LIKE '%\excel.exe' OR LOWER("Process Path") LIKE '%\powerpnt.exe' OR LOWER("Process Path") LIKE '%\winword.exe') OR (LOWER("Process Name") LIKE '%\excel.exe' OR LOWER("Process Name") LIKE '%\powerpnt.exe' OR LOWER("Process Name") LIKE '%\winword.exe')) AND LOWER(Filename) LIKE '%\appdata\roaming\microsoft\office\recent\%') OR ((LOWER("Process Path") LIKE '%\excel.exe' OR LOWER("Process Name") LIKE '%\excel.exe') AND LOWER(Filename) LIKE '%\appdata\roaming\microsoft\excel%') OR ((LOWER("Process Path") LIKE '%\powerpnt.exe' OR LOWER("Process Name") LIKE '%\powerpnt.exe') AND LOWER(Filename) LIKE '%\appdata\roaming\microsoft\powerpoint%') OR ((LOWER("Process Path") LIKE '%\winword.exe' OR LOWER("Process Name") LIKE '%\winword.exe') AND LOWER(Filename) LIKE '%\appdata\roaming\microsoft\word%'))))
