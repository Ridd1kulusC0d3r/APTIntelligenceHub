-- Github Self Hosted Runner Changes Detected | T1078.004, T1213.003, T1526 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/github/audit/github_self_hosted_runner_changes_detected.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%org.remove_self_hosted_runner%' OR LOWER(UTF8(payload)) LIKE '%org.runner_group_created%' OR LOWER(UTF8(payload)) LIKE '%org.runner_group_removed%' OR LOWER(UTF8(payload)) LIKE '%org.runner_group_runner_removed%' OR LOWER(UTF8(payload)) LIKE '%org.runner_group_runners_added%' OR LOWER(UTF8(payload)) LIKE '%org.runner_group_runners_updated%' OR LOWER(UTF8(payload)) LIKE '%org.runner_group_updated%' OR LOWER(UTF8(payload)) LIKE '%repo.register_self_hosted_runner%' OR LOWER(UTF8(payload)) LIKE '%repo.remove_self_hosted_runner%'
