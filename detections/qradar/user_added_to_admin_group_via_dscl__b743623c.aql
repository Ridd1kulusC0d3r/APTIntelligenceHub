-- User Added To Admin Group Via Dscl | T1078.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_dscl_add_user_to_admin_group.yml
SELECT * FROM events WHERE devicetype=102 AND (LOWER("Process Path") LIKE '%/dscl' OR LOWER("Process Name") LIKE '%/dscl') AND (LOWER(Command) LIKE '% -append %' AND LOWER(Command) LIKE '% /groups/admin %' AND LOWER(Command) LIKE '% groupmembership %')
