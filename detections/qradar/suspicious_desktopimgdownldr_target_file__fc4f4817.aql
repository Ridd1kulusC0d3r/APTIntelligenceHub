-- Suspicious Desktopimgdownldr Target File | T1105 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_desktopimgdownldr_file.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\svchost.exe' OR LOWER("Process Name") LIKE '%\svchost.exe') AND LOWER(Filename) LIKE '%\personalization\lockscreenimage\%') AND (NOT(LOWER(Filename) LIKE '%c:\windows\%')) AND (NOT((LOWER(Filename) LIKE '%.jpg%' OR LOWER(Filename) LIKE '%.jpeg%' OR LOWER(Filename) LIKE '%.png%')))
