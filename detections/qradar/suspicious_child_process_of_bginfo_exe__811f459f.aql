-- Suspicious Child Process Of BgInfo.EXE | T1059.005, T1202, T1218 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_bginfo_suspicious_child_process.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Parent Process Path") LIKE '%\bginfo.exe' OR LOWER("Parent Process Path") LIKE '%\bginfo64.exe') AND (((LOWER("Process Path") LIKE '%\calc.exe' OR LOWER("Process Path") LIKE '%\cmd.exe' OR LOWER("Process Path") LIKE '%\cscript.exe' OR LOWER("Process Path") LIKE '%\mshta.exe' OR LOWER("Process Path") LIKE '%\notepad.exe' OR LOWER("Process Path") LIKE '%\powershell.exe' OR LOWER("Process Path") LIKE '%\pwsh.exe' OR LOWER("Process Path") LIKE '%\wscript.exe') OR (LOWER("Process Name") LIKE '%\calc.exe' OR LOWER("Process Name") LIKE '%\cmd.exe' OR LOWER("Process Name") LIKE '%\cscript.exe' OR LOWER("Process Name") LIKE '%\mshta.exe' OR LOWER("Process Name") LIKE '%\notepad.exe' OR LOWER("Process Name") LIKE '%\powershell.exe' OR LOWER("Process Name") LIKE '%\pwsh.exe' OR LOWER("Process Name") LIKE '%\wscript.exe')) OR ((LOWER("Process Path") LIKE '%\appdata\local\%' OR LOWER("Process Path") LIKE '%\appdata\roaming\%' OR LOWER("Process Path") LIKE '%:\users\public\%' OR LOWER("Process Path") LIKE '%:\temp\%' OR LOWER("Process Path") LIKE '%:\windows\temp\%' OR LOWER("Process Path") LIKE '%:\perflogs\%') OR (LOWER("Process Name") LIKE '%\appdata\local\%' OR LOWER("Process Name") LIKE '%\appdata\roaming\%' OR LOWER("Process Name") LIKE '%:\users\public\%' OR LOWER("Process Name") LIKE '%:\temp\%' OR LOWER("Process Name") LIKE '%:\windows\temp\%' OR LOWER("Process Name") LIKE '%:\perflogs\%')))
