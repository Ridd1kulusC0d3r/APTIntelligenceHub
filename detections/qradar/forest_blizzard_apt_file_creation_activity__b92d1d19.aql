-- Forest Blizzard APT - File Creation Activity | T1685.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2024/TA/Forest-Blizzard/file_event_win_apt_forest_blizzard_activity.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER(Filename) LIKE 'c:\programdata\microsoft\v%' OR LOWER(Filename) LIKE 'c:\programdata\adobe\v%' OR LOWER(Filename) LIKE 'c:\programdata\comms\v%' OR LOWER(Filename) LIKE 'c:\programdata\intel\v%' OR LOWER(Filename) LIKE 'c:\programdata\kaspersky lab\v%' OR LOWER(Filename) LIKE 'c:\programdata\bitdefender\v%' OR LOWER(Filename) LIKE 'c:\programdata\eset\v%' OR LOWER(Filename) LIKE 'c:\programdata\nvidia\v%' OR LOWER(Filename) LIKE 'c:\programdata\ubisoft\v%' OR LOWER(Filename) LIKE 'c:\programdata\steam\v%') AND (LOWER(Filename) LIKE '%\prnms003.inf_%' OR LOWER(Filename) LIKE '%\prnms009.inf_%')) OR (LOWER(Filename) LIKE 'c:\programdata\%' AND ((LOWER(Filename) LIKE '%.save' OR LOWER(Filename) LIKE '%\doit.bat' OR LOWER(Filename) LIKE '%\execute.bat' OR LOWER(Filename) LIKE '%\servtask.bat') OR (LOWER(Filename) LIKE '%\wayzgoose%' AND LOWER(Filename) LIKE '%.dll'))))
