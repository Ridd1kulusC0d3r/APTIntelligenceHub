-- Potential Ransomware Activity Using LegalNotice Message | T1491.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_legalnotice_susp_message.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Name") LIKE '%\software\microsoft\windows\currentversion\policies\system\legalnoticecaption%' OR LOWER("Process Name") LIKE '%\software\microsoft\windows\currentversion\policies\system\legalnoticetext%') OR (LOWER("Target Process Name") LIKE '%\software\microsoft\windows\currentversion\policies\system\legalnoticecaption%' OR LOWER("Target Process Name") LIKE '%\software\microsoft\windows\currentversion\policies\system\legalnoticetext%') OR (LOWER("Object Name") LIKE '%\software\microsoft\windows\currentversion\policies\system\legalnoticecaption%' OR LOWER("Object Name") LIKE '%\software\microsoft\windows\currentversion\policies\system\legalnoticetext%')) AND (LOWER(UTF8(payload)) LIKE '%encrypted%' OR LOWER(UTF8(payload)) LIKE '%unlock-password%' OR LOWER(UTF8(payload)) LIKE '%paying%')
