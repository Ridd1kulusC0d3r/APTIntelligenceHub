-- Communication To Ngrok Tunneling Service - Linux | T1090, T1102, T1567, T1568.002, T1572 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/network_connection/net_connection_lnx_ngrok_tunnel.yml
SELECT * FROM events WHERE devicetype=11 AND (LOWER("Destination Hostname") LIKE '%tunnel.us.ngrok.com%' OR LOWER("Destination Hostname") LIKE '%tunnel.eu.ngrok.com%' OR LOWER("Destination Hostname") LIKE '%tunnel.ap.ngrok.com%' OR LOWER("Destination Hostname") LIKE '%tunnel.au.ngrok.com%' OR LOWER("Destination Hostname") LIKE '%tunnel.sa.ngrok.com%' OR LOWER("Destination Hostname") LIKE '%tunnel.jp.ngrok.com%' OR LOWER("Destination Hostname") LIKE '%tunnel.in.ngrok.com%')
