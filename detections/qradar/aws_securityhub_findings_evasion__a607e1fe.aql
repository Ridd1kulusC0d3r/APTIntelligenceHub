-- AWS SecurityHub Findings Evasion | T1685 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/aws/cloudtrail/aws_securityhub_finding_evasion.yml
SELECT * FROM events WHERE devicetype IN(516, 519, 456, 460, 501, 502, 507, 440, 347) AND QIDNAME(qid) IN('BatchUpdateFindings', 'DeleteInsight', 'UpdateFindings', 'UpdateInsight')
