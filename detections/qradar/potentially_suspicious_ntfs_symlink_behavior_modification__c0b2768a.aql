-- Potentially Suspicious NTFS Symlink Behavior Modification | T1059, T1222.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_fsutil_symlinkevaluation.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\cmd.exe' OR LOWER("Process Path") LIKE '%\powershell.exe' OR LOWER("Process Path") LIKE '%\pwsh.exe') OR (LOWER("Process Name") LIKE '%\cmd.exe' OR LOWER("Process Name") LIKE '%\powershell.exe' OR LOWER("Process Name") LIKE '%\pwsh.exe')) OR (Filename IN('Cmd.Exe', 'PowerShell.EXE', 'pwsh.dll'))) AND (LOWER(Command) LIKE '%fsutil%' AND LOWER(Command) LIKE '%behavior%' AND LOWER(Command) LIKE '%set%' AND LOWER(Command) LIKE '%symlinkevaluation%') AND (LOWER(Command) LIKE '%r2l:1%' OR LOWER(Command) LIKE '%r2r:1%' OR LOWER(Command) LIKE '%l2l:1%')
