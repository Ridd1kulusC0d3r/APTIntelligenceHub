-- Suspicious FromBase64String Usage On Gzip Archive - Ps Script | T1132.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_frombase64string_archive.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER(Message) LIKE '%frombase64string%' AND LOWER(Message) LIKE '%memorystream%' AND LOWER(Message) LIKE '%h4si%'
