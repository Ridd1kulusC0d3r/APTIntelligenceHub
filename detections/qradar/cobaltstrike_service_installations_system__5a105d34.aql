-- CobaltStrike Service Installations - System | T1021.002, T1543.003, T1569.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/service_control_manager/win_system_cobaltstrike_service_installs.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER(UTF8(payload)) LIKE '%service control manager%' AND "Event ID"=7045) AND ((LOWER("Process Path") LIKE '%admin$%' AND LOWER("Process Path") LIKE '%.exe%') OR (LOWER("Process Path") LIKE '%%comspec%%' AND LOWER("Process Path") LIKE '%start%' AND LOWER("Process Path") LIKE '%powershell%') OR LOWER("Process Path") LIKE '%powershell -nop -w hidden -encodedcommand%' OR LOWER("Process Path") LIKE '%suvyichozxctt2jqzwn0ie5ldc5xzwjjbgllbnqplkrvd25sb2fku3ryaw5nkcdodhrwoi8vmti3ljaumc4xo%' OR LOWER("Process Path") LIKE '%lfwcaotmv3lu9iamvjdcbozxquv2viy2xpzw50ks5eb3dubg9hzfn0cmluzygnahr0cdovlzeyny4wljaumt%' OR LOWER("Process Path") LIKE '%jrvggke5ldy1pymply3qgtmv0lldlymnsawvudckurg93bmxvywrtdhjpbmcoj2h0dha6ly8xmjcumc4wlje6%')
