-- Scheduled Task/Job At | T1053.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_at_command.yml
SELECT * FROM events WHERE devicetype=11 AND ((LOWER("Process Path") LIKE '%/at' OR LOWER("Process Path") LIKE '%/atd') OR (LOWER("Process Name") LIKE '%/at' OR LOWER("Process Name") LIKE '%/atd'))
