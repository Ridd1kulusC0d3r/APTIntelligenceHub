-- Office Application Spawning Script Interpreter Or LOLBin | T1204.002, T1221 | Hub
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Parent Process Path") LIKE '%\winword.exe' OR LOWER("Parent Process Path") LIKE '%\excel.exe' OR LOWER("Parent Process Path") LIKE '%\powerpnt.exe') AND ((LOWER("Process Path") LIKE '%\wscript.exe' OR LOWER("Process Path") LIKE '%\cscript.exe' OR LOWER("Process Path") LIKE '%\mshta.exe' OR LOWER("Process Path") LIKE '%\powershell.exe' OR LOWER("Process Path") LIKE '%\cmd.exe') OR (LOWER("Process Name") LIKE '%\wscript.exe' OR LOWER("Process Name") LIKE '%\cscript.exe' OR LOWER("Process Name") LIKE '%\mshta.exe' OR LOWER("Process Name") LIKE '%\powershell.exe' OR LOWER("Process Name") LIKE '%\cmd.exe'))
