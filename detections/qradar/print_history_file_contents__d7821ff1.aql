-- Print History File Contents | T1592.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_susp_history_recon.yml
SELECT * FROM events WHERE devicetype=11 AND ((LOWER("Process Path") LIKE '%/cat' OR LOWER("Process Path") LIKE '%/head' OR LOWER("Process Path") LIKE '%/tail' OR LOWER("Process Path") LIKE '%/more') OR (LOWER("Process Name") LIKE '%/cat' OR LOWER("Process Name") LIKE '%/head' OR LOWER("Process Name") LIKE '%/tail' OR LOWER("Process Name") LIKE '%/more')) AND ((LOWER(Command) LIKE '%/.bash_history%' OR LOWER(Command) LIKE '%/.zsh_history%') OR (LOWER(Command) LIKE '%_history' OR LOWER(Command) LIKE '%.history' OR LOWER(Command) LIKE '%zhistory'))
