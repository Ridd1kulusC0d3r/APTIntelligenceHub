-- Startup Item File Created - MacOS | T1037.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/file_event/file_event_macos_susp_startup_item_created.yml
SELECT * FROM events WHERE devicetype=102 AND (LOWER(Filename) LIKE '/library/startupitems/%' OR LOWER(Filename) LIKE '/system/library/startupitems%') AND LOWER(Filename) LIKE '%.plist'
