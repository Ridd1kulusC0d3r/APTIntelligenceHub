-- RemoteFXvGPUDisablement Abuse Via AtomicTestHarnesses | T1218 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_remotefxvgpudisablement_abuse.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Command) LIKE '%invoke-athremotefxvgpudisablementcommand%' OR LOWER(Command) LIKE '%invoke-athremotefxvgpudisableme%')
