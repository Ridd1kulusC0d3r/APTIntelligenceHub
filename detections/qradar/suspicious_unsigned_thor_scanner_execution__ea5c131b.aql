-- Suspicious Unsigned Thor Scanner Execution | T1574.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/image_load/image_load_thor_unsigned_execution.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\thor.exe' OR LOWER("Process Path") LIKE '%\thor64.exe') OR (LOWER("Process Name") LIKE '%\thor.exe' OR LOWER("Process Name") LIKE '%\thor64.exe')) AND (LOWER(CONCAT('file directory', '/', filename)) LIKE '%\thor.exe' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\thor64.exe')) AND (NOT((Signed='true' AND LOWER(UTF8(payload)) LIKE '%valid%' AND LOWER(UTF8(payload)) LIKE '%nextron systems gmbh%')))
