-- Symlink Etc Passwd | T1204.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/builtin/lnx_symlink_etc_passwd.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND (LOWER(UTF8(payload)) LIKE '%ln -s -f /etc/passwd%' OR LOWER(UTF8(payload)) LIKE '%ln -s /etc/passwd%')
