-- Possible Coin Miner CPU Priority Param | T1068 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/execve/lnx_auditd_coinminer.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND (LOWER(Command) LIKE '%a1%--cpu-priority%' OR LOWER(Command) LIKE '%a2%--cpu-priority%' OR LOWER(Command) LIKE '%a3%--cpu-priority%' OR LOWER(Command) LIKE '%a4%--cpu-priority%' OR LOWER(Command) LIKE '%a5%--cpu-priority%' OR LOWER(UTF8(payload)) LIKE '%--cpu-priority%' OR LOWER(UTF8(payload)) LIKE '%--cpu-priority%')
