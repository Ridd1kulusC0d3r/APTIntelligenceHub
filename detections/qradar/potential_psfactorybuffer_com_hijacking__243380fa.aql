-- Potential PSFactoryBuffer COM Hijacking | T1546.015 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_persistence_comhijack_psfactorybuffer.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\clsid\{c90250f3-4d7d-4991-9b69-a5c5bc1c2ae6}\inprocserver32\(default)' OR LOWER("Target Process Name") LIKE '%\clsid\{c90250f3-4d7d-4991-9b69-a5c5bc1c2ae6}\inprocserver32\(default)' OR LOWER("Object Name") LIKE '%\clsid\{c90250f3-4d7d-4991-9b69-a5c5bc1c2ae6}\inprocserver32\(default)') AND (NOT((LOWER(UTF8(payload)) LIKE '%%windir%\system32\actxprxy.dll%' OR LOWER(UTF8(payload)) LIKE '%c:\windows\system32\actxprxy.dll%')))
