-- Potential Persistence Via Outlook Form | T1137.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_office_outlook_newform.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Path") LIKE '%\outlook.exe' OR LOWER("Process Name") LIKE '%\outlook.exe') AND (LOWER(Filename) LIKE '%\appdata\local\microsoft\forms\ipm%' OR LOWER(Filename) LIKE '%\local settings\application data\microsoft\forms%')
