-- HackTool - Inveigh Execution Artefacts | T1219.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_hktl_inveigh_artefacts.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Filename) LIKE '%\inveigh-log.txt' OR LOWER(Filename) LIKE '%\inveigh-cleartext.txt' OR LOWER(Filename) LIKE '%\inveigh-ntlmv1users.txt' OR LOWER(Filename) LIKE '%\inveigh-ntlmv2users.txt' OR LOWER(Filename) LIKE '%\inveigh-ntlmv1.txt' OR LOWER(Filename) LIKE '%\inveigh-ntlmv2.txt' OR LOWER(Filename) LIKE '%\inveigh-forminput.txt' OR LOWER(Filename) LIKE '%\inveigh.dll' OR LOWER(Filename) LIKE '%\inveigh.exe' OR LOWER(Filename) LIKE '%\inveigh.ps1' OR LOWER(Filename) LIKE '%\inveigh-relay.ps1')
