-- Launch Agent/Daemon Execution Via Launchctl | T1543.001, T1543.004, T1569.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_launchctl_execution.yml
SELECT * FROM events WHERE devicetype=102 AND (LOWER("Process Path") LIKE '%/launchctl' OR LOWER("Process Name") LIKE '%/launchctl') AND (LOWER(Command) LIKE '%submit%' OR LOWER(Command) LIKE '%load%' OR LOWER(Command) LIKE '%start%')
