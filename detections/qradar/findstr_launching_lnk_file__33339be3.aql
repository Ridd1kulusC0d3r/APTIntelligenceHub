-- Findstr Launching .lnk File | T1027.003, T1036, T1202 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_findstr_lnk.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\find.exe' OR LOWER("Process Path") LIKE '%\findstr.exe') OR (LOWER("Process Name") LIKE '%\find.exe' OR LOWER("Process Name") LIKE '%\findstr.exe')) OR (Filename IN('FIND.EXE', 'FINDSTR.EXE'))) AND (LOWER(Command) LIKE '%.lnk' OR LOWER(Command) LIKE '%.lnk"' OR LOWER(Command) LIKE '%.lnk''')
