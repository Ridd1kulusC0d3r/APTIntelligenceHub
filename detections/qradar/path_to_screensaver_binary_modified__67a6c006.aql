-- Path To Screensaver Binary Modified | T1546.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_modify_screensaver_binary_path.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\control panel\desktop\scrnsave.exe' OR LOWER("Target Process Name") LIKE '%\control panel\desktop\scrnsave.exe' OR LOWER("Object Name") LIKE '%\control panel\desktop\scrnsave.exe') AND (NOT(((LOWER("Process Path") LIKE '%\rundll32.exe' OR LOWER("Process Path") LIKE '%\explorer.exe') OR (LOWER("Process Name") LIKE '%\rundll32.exe' OR LOWER("Process Name") LIKE '%\explorer.exe'))))
