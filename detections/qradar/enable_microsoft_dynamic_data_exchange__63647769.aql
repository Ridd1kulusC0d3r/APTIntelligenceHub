-- Enable Microsoft Dynamic Data Exchange | T1559.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_office_enable_dde.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Name") LIKE '%\word\security\allowdde' OR LOWER("Target Process Name") LIKE '%\word\security\allowdde' OR LOWER("Object Name") LIKE '%\word\security\allowdde') AND (LOWER(UTF8(payload)) LIKE '%dword (0x00000001)%' OR LOWER(UTF8(payload)) LIKE '%dword (0x00000002)%')) OR (((LOWER("Process Name") LIKE '%\excel\security\disableddeserverlaunch' OR LOWER("Process Name") LIKE '%\excel\security\disableddeserverlookup') OR (LOWER("Target Process Name") LIKE '%\excel\security\disableddeserverlaunch' OR LOWER("Target Process Name") LIKE '%\excel\security\disableddeserverlookup') OR (LOWER("Object Name") LIKE '%\excel\security\disableddeserverlaunch' OR LOWER("Object Name") LIKE '%\excel\security\disableddeserverlookup')) AND LOWER(UTF8(payload)) LIKE '%dword (0x00000000)%'))
