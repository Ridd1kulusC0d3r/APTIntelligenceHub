-- Google Cloud Kubernetes Admission Controller | T1078, T1552, T1552.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/gcp/audit/gcp_kubernetes_admission_controller.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype IN(449, 442, 461, 455) AND LOWER(UTF8(payload)) LIKE '%admissionregistration.k8s.io.v%' AND (LOWER(UTF8(payload)) LIKE '%.mutatingwebhookconfigurations.%' OR LOWER(UTF8(payload)) LIKE '%.validatingwebhookconfigurations.%') AND (LOWER(UTF8(payload)) LIKE '%create%' OR LOWER(UTF8(payload)) LIKE '%patch%' OR LOWER(UTF8(payload)) LIKE '%replace%')
