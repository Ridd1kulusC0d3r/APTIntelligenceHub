-- Fsutil Drive Enumeration | T1120 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_fsutil_drive_enumeration.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\fsutil.exe' OR LOWER("Process Name") LIKE '%\fsutil.exe') OR Filename='fsutil.exe') AND LOWER(Command) LIKE '%drives%'
