-- Remote Thread Creation Via PowerShell In Uncommon Target | T1059.001, T1218.011 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/create_remote_thread/create_remote_thread_win_powershell_susp_targets.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Source Process Path") LIKE '%\powershell.exe' OR LOWER("Source Process Path") LIKE '%\pwsh.exe') AND (LOWER("Target Process Path") LIKE '%\rundll32.exe' OR LOWER("Target Process Path") LIKE '%\regsvr32.exe')
