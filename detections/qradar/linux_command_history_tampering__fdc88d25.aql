-- Linux Command History Tampering | T1070.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/builtin/lnx_shell_clear_cmd_history.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND (LOWER(UTF8(payload)) LIKE '%cat /dev/null >%sh_history%' OR LOWER(UTF8(payload)) LIKE '%cat /dev/zero >%sh_history%' OR LOWER(UTF8(payload)) LIKE '%chattr +i%sh_history%' OR LOWER(UTF8(payload)) LIKE '%echo "" >%sh_history%' OR LOWER(UTF8(payload)) LIKE '%empty_bash_history%' OR LOWER(UTF8(payload)) LIKE '%export histfilesize=0%' OR LOWER(UTF8(payload)) LIKE '%history -c%' OR LOWER(UTF8(payload)) LIKE '%history -w%' OR LOWER(UTF8(payload)) LIKE '%ln -sf /dev/null %sh_history%' OR LOWER(UTF8(payload)) LIKE '%ln -sf /dev/zero %sh_history%' OR LOWER(UTF8(payload)) LIKE '%rm %sh_history%' OR LOWER(UTF8(payload)) LIKE '%shopt -ou history%' OR LOWER(UTF8(payload)) LIKE '%shopt -uo history%' OR LOWER(UTF8(payload)) LIKE '%shred %sh_history%' OR LOWER(UTF8(payload)) LIKE '%truncate -s0 %sh_history%')
