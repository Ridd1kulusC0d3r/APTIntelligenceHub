-- Suspicious Ping/Del Command Combination | T1070.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_cmd_ping_del_combined_execution.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Command) LIKE '% -n %' OR LOWER(Command) LIKE '% /n %' OR LOWER(Command) LIKE '% –n %' OR LOWER(Command) LIKE '% —n %' OR LOWER(Command) LIKE '% ―n %') AND LOWER(Command) LIKE '%nul%' AND (LOWER(Command) LIKE '% -f %' OR LOWER(Command) LIKE '% /f %' OR LOWER(Command) LIKE '% –f %' OR LOWER(Command) LIKE '% —f %' OR LOWER(Command) LIKE '% ―f %' OR LOWER(Command) LIKE '% -q %' OR LOWER(Command) LIKE '% /q %' OR LOWER(Command) LIKE '% –q %' OR LOWER(Command) LIKE '% —q %' OR LOWER(Command) LIKE '% ―q %') AND (LOWER(Command) LIKE '%ping%' AND LOWER(Command) LIKE '%del %')
