-- Tunneling Tool Execution | T1041, T1071.001, T1572 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/process_creation/proc_creation_win_susp_exfil_and_tunneling_tool_execution.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\httptunnel.exe' OR LOWER("Process Path") LIKE '%\plink.exe' OR LOWER("Process Path") LIKE '%\socat.exe' OR LOWER("Process Path") LIKE '%\stunnel.exe') OR (LOWER("Process Name") LIKE '%\httptunnel.exe' OR LOWER("Process Name") LIKE '%\plink.exe' OR LOWER("Process Name") LIKE '%\socat.exe' OR LOWER("Process Name") LIKE '%\stunnel.exe'))
