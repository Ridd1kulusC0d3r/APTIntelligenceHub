-- HackTool - Bloodhound/Sharphound Execution | T1059.001, T1069.001, T1069.002, T1087.001, T1087.002, T1482 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_bloodhound_sharphound.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER(UTF8(payload)) LIKE '%sharphound%' OR LOWER(UTF8(payload)) LIKE '%sharphound%' OR (LOWER(UTF8(payload)) LIKE '%specterops%' OR LOWER(UTF8(payload)) LIKE '%evil corp%') OR ((LOWER("Process Path") LIKE '%\bloodhound.exe%' OR LOWER("Process Path") LIKE '%\sharphound.exe%') OR (LOWER("Process Name") LIKE '%\bloodhound.exe%' OR LOWER("Process Name") LIKE '%\sharphound.exe%'))) OR (LOWER(Command) LIKE '% -collectionmethod all %' OR LOWER(Command) LIKE '% --collectionmethods session %' OR LOWER(Command) LIKE '% --loop --loopduration %' OR LOWER(Command) LIKE '% --portscantimeout %' OR LOWER(Command) LIKE '%.exe -c all -d %' OR LOWER(Command) LIKE '%invoke-bloodhound%' OR LOWER(Command) LIKE '%get-bloodhounddata%') OR (LOWER(Command) LIKE '% -jsonfolder %' AND LOWER(Command) LIKE '% -zipfilename %') OR (LOWER(Command) LIKE '% dconly %' AND LOWER(Command) LIKE '% --nosavecache %'))
