-- Windows Pcap Drivers | T1040 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_pcap_drivers.yml
SELECT * FROM events WHERE devicetype=12 AND "Event ID"=4697 AND (LOWER("Service Filename") LIKE '%pcap%' OR LOWER("Service Filename") LIKE '%npcap%' OR LOWER("Service Filename") LIKE '%npf%' OR LOWER("Service Filename") LIKE '%nm3%' OR LOWER("Service Filename") LIKE '%ndiscap%' OR LOWER("Service Filename") LIKE '%nmnt%' OR LOWER("Service Filename") LIKE '%windivert%' OR LOWER("Service Filename") LIKE '%usbpcap%' OR LOWER("Service Filename") LIKE '%pktmon%')
