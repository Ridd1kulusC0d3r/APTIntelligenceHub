-- Bitbucket User Permissions Export Attempt | T1082, T1213, T1591.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/bitbucket/audit/bitbucket_audit_user_permissions_export_attempt_detected.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%users and groups%' AND (LOWER(UTF8(payload)) LIKE '%user details export failed%' OR LOWER(UTF8(payload)) LIKE '%user details export started%' OR LOWER(UTF8(payload)) LIKE '%user details exported%')
