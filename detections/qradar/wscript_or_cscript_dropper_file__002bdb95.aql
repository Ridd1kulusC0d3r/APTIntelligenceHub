-- WScript or CScript Dropper - File | T1059.005, T1059.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_cscript_wscript_dropper.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\wscript.exe' OR LOWER("Process Path") LIKE '%\cscript.exe') OR (LOWER("Process Name") LIKE '%\wscript.exe' OR LOWER("Process Name") LIKE '%\cscript.exe')) AND (LOWER(Filename) LIKE '%:\perflogs\%' OR LOWER(Filename) LIKE '%:\programdata\%' OR LOWER(Filename) LIKE '%:\temp\%' OR LOWER(Filename) LIKE '%:\tmp\%' OR LOWER(Filename) LIKE '%:\users\%' OR LOWER(Filename) LIKE '%:\windows\temp\%' OR LOWER(Filename) LIKE '%\appdata\local\temp%' OR LOWER(Filename) LIKE '%\appdata\roaming\temp%' OR LOWER(Filename) LIKE '%\start menu\programs\startup\%' OR LOWER(Filename) LIKE '%\temporary internet%') AND (LOWER(Filename) LIKE '%.js' OR LOWER(Filename) LIKE '%.jse' OR LOWER(Filename) LIKE '%.vba' OR LOWER(Filename) LIKE '%.vbe' OR LOWER(Filename) LIKE '%.vbs' OR LOWER(Filename) LIKE '%.wsf' OR LOWER(Filename) LIKE '%.wsh')
