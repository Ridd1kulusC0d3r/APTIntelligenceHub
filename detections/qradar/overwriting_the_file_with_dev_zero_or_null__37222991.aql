-- Overwriting the File with Dev Zero or Null | T1485 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/execve/lnx_auditd_dd_delete_file.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND LOWER(UTF8(payload)) LIKE '%execve%' AND LOWER(Command) LIKE '%a0%dd%' AND (LOWER(Command) LIKE '%a1%if=/dev/null%' OR LOWER(Command) LIKE '%if=/dev/zero%')
