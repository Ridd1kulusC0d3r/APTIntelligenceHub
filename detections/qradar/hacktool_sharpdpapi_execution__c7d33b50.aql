-- HackTool - SharpDPAPI Execution | T1134.001, T1134.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_sharp_dpapi_execution.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\sharpdpapi.exe' OR LOWER("Process Name") LIKE '%\sharpdpapi.exe') OR Filename='SharpDPAPI.exe') OR ((LOWER(Command) LIKE '% backupkey %' OR LOWER(Command) LIKE '% blob %' OR LOWER(Command) LIKE '% certificates %' OR LOWER(Command) LIKE '% credentials %' OR LOWER(Command) LIKE '% keepass %' OR LOWER(Command) LIKE '% masterkeys %' OR LOWER(Command) LIKE '% rdg %' OR LOWER(Command) LIKE '% vaults %') AND ((LOWER(Command) LIKE '% {%' AND LOWER(Command) LIKE '%}:%') OR (LOWER(Command) LIKE '% /file:%' OR LOWER(Command) LIKE '% /machine%' OR LOWER(Command) LIKE '% /mkfile:%' OR LOWER(Command) LIKE '% /password:%' OR LOWER(Command) LIKE '% /pvk:%' OR LOWER(Command) LIKE '% /server:%' OR LOWER(Command) LIKE '% /target:%' OR LOWER(Command) LIKE '% /unprotect%'))))
