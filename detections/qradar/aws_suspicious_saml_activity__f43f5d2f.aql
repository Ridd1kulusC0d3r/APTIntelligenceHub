-- AWS Suspicious SAML Activity | T1078, T1548, T1550, T1550.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/aws/cloudtrail/aws_susp_saml_activity.yml
SELECT * FROM events WHERE devicetype IN(516, 519, 456, 460, 501, 502, 507, 440, 347) AND QIDNAME(qid) IN('AssumeRoleWithSAML', 'UpdateSAMLProvider')
