-- Cross Site Scripting Strings | T1189 | https://github.com/SigmaHQ/sigma/blob/master/rules/web/webserver_generic/web_xss_in_access_logs.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE Method='GET' AND (LOWER(UTF8(payload)) LIKE '%=<script>%' OR LOWER(UTF8(payload)) LIKE '%=%3cscript%3e%' OR LOWER(UTF8(payload)) LIKE '%=%253cscript%253e%' OR LOWER(UTF8(payload)) LIKE '%<iframe %' OR LOWER(UTF8(payload)) LIKE '%%3ciframe %' OR LOWER(UTF8(payload)) LIKE '%<svg %' OR LOWER(UTF8(payload)) LIKE '%%3csvg %' OR LOWER(UTF8(payload)) LIKE '%document.cookie%' OR LOWER(UTF8(payload)) LIKE '%document.domain%' OR LOWER(UTF8(payload)) LIKE '% onerror=%' OR LOWER(UTF8(payload)) LIKE '% onresize=%' OR LOWER(UTF8(payload)) LIKE '% onload="%' OR LOWER(UTF8(payload)) LIKE '%onmouseover=%' OR LOWER(UTF8(payload)) LIKE '%${alert%' OR LOWER(UTF8(payload)) LIKE '%javascript:alert%' OR LOWER(UTF8(payload)) LIKE '%javascript%3aalert%') AND (NOT(LOWER(UTF8(payload)) LIKE '%sc-status%404%'))
