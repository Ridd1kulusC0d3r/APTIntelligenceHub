-- Lazarus Group Activity | T1059 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2020/TA/Lazarus/proc_creation_win_apt_lazarus_group_activity.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER(Command) LIKE '%reg.exe save hklm\sam %temp%\~reg_sam.save%' OR LOWER(Command) LIKE '%1q2w3e4r@#$@#$@#$%' OR LOWER(Command) LIKE '% -hp1q2w3e4 %' OR LOWER(Command) LIKE '%.dat data03 10000 -p %') OR (LOWER(Command) LIKE '%netstat -aon | find %' AND LOWER(Command) LIKE '%esta%' AND LOWER(Command) LIKE '% > %temp%\~%') OR (LOWER(Command) LIKE '%.255 10 c:\programdata\ibm\%' AND LOWER(Command) LIKE '%.dat%') OR ((LOWER(Command) LIKE '% /c %' AND LOWER(Command) LIKE '% -p 0x%') AND (LOWER(Command) LIKE '%c:\programdata\%' OR LOWER(Command) LIKE '%c:\recycler\%')) OR ((LOWER(Command) LIKE '%rundll32 %' AND LOWER(Command) LIKE '%c:\programdata\%') AND (LOWER(Command) LIKE '%.bin,%' OR LOWER(Command) LIKE '%.tmp,%' OR LOWER(Command) LIKE '%.dat,%' OR LOWER(Command) LIKE '%.io,%' OR LOWER(Command) LIKE '%.ini,%' OR LOWER(Command) LIKE '%.db,%')))
