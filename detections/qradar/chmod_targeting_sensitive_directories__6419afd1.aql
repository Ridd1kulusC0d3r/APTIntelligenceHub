-- Chmod Targeting Sensitive Directories | T1222.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_chmod_targeting_sensitive_directories.yml
SELECT * FROM events WHERE devicetype=11 AND ((LOWER("Process Path") LIKE '%/chmod' OR LOWER("Process Name") LIKE '%/chmod') AND (LOWER(Command) LIKE '%/tmp/%' OR LOWER(Command) LIKE '%/.library/%' OR LOWER(Command) LIKE '%/etc/%' OR LOWER(Command) LIKE '%/opt/%')) AND (NOT(((LOWER(Command) LIKE '%chmod --reference=/etc/shells%' AND LOWER("Parent Command") LIKE '%/update-shells') OR (LOWER(Command) LIKE '%/etc/%' AND (LOWER("Parent Command") LIKE '%/var/lib/dpkg/info/%' AND LOWER("Parent Command") LIKE '%.postinst configure%')) OR LOWER(Command) LIKE 'chmod 700 /tmp/apt-key-gpghome.%' OR LOWER(Command) LIKE 'chmod 755 /var/tmp/mkinitramfs%' OR Command='chmod 0775 /etc/landscape/' OR Command='chmod 644 /etc/apparmor.d/tunables/home.d/ubuntu')))
