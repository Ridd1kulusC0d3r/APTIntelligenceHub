-- Suspicious Velociraptor Child Process | T1219 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_velociraptor_child_process.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER("Parent Process Path") LIKE '%\velociraptor.exe' AND ((LOWER(Command) LIKE '%code.exe%' AND LOWER(Command) LIKE '%tunnel%' AND LOWER(Command) LIKE '%--accept-server-license-terms%') OR (LOWER(Command) LIKE '%msiexec%' AND LOWER(Command) LIKE '%/i%' AND LOWER(Command) LIKE '%http%') OR (((LOWER("Process Path") LIKE '%\powershell.exe' OR LOWER("Process Path") LIKE '%\powershell_ise.exe' OR LOWER("Process Path") LIKE '%\pwsh.exe') OR (LOWER("Process Name") LIKE '%\powershell.exe' OR LOWER("Process Name") LIKE '%\powershell_ise.exe' OR LOWER("Process Name") LIKE '%\pwsh.exe')) AND (LOWER(Command) LIKE '%invoke-webrequest %' OR LOWER(Command) LIKE '%iwr %' OR LOWER(Command) LIKE '%.downloadfile%' OR LOWER(Command) LIKE '%.downloadstring%')))
