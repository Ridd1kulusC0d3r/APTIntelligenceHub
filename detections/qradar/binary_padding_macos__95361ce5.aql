-- Binary Padding - MacOS | T1027.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_binary_padding.yml
SELECT * FROM events WHERE devicetype=102 AND (((LOWER("Process Path") LIKE '%/truncate' OR LOWER("Process Name") LIKE '%/truncate') AND LOWER(Command) LIKE '%-s +%') OR ((LOWER("Process Path") LIKE '%/dd' OR LOWER("Process Name") LIKE '%/dd') AND (LOWER(Command) LIKE '%if=/dev/zero%' OR LOWER(Command) LIKE '%if=/dev/random%' OR LOWER(Command) LIKE '%if=/dev/urandom%')))
