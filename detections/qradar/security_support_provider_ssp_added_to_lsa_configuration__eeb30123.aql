-- Security Support Provider (SSP) Added to LSA Configuration | T1547.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_ssp_added_lsa_config.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Name") LIKE '%\control\lsa\security packages' OR LOWER("Process Name") LIKE '%\control\lsa\osconfig\security packages') OR (LOWER("Target Process Name") LIKE '%\control\lsa\security packages' OR LOWER("Target Process Name") LIKE '%\control\lsa\osconfig\security packages') OR (LOWER("Object Name") LIKE '%\control\lsa\security packages' OR LOWER("Object Name") LIKE '%\control\lsa\osconfig\security packages')) AND (NOT(((("Process Path" IN('C:\Windows\system32\msiexec.exe', 'C:\Windows\syswow64\MsiExec.exe')) OR ("Process Name" IN('C:\Windows\system32\msiexec.exe', 'C:\Windows\syswow64\MsiExec.exe'))) OR ("Process Path" IS NULL OR "Process Name" IS NULL))))
