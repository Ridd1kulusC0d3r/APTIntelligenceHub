-- Unusual File Modification by dns.exe | T1133 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_change/file_change_win_unusual_modification_by_dns_exe.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Path") LIKE '%\dns.exe' OR LOWER("Process Name") LIKE '%\dns.exe') AND (NOT(LOWER(Filename) LIKE '%\dns.log'))
