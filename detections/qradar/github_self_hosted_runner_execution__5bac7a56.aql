-- Github Self-Hosted Runner Execution | T1071, T1102.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_github_self_hosted_runner.yml
SELECT * FROM events WHERE devicetype=12 AND ((((LOWER("Process Path") LIKE '%\runner.worker.exe' OR LOWER("Process Name") LIKE '%\runner.worker.exe') OR Filename='Runner.Worker.dll') AND LOWER(Command) LIKE '%spawnclient%') OR (((LOWER("Process Path") LIKE '%\runner.listener.exe' OR LOWER("Process Name") LIKE '%\runner.listener.exe') OR Filename='Runner.Listener.dll') AND (LOWER(Command) LIKE '%run%' OR LOWER(Command) LIKE '%configure%')))
