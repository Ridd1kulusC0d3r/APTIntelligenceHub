-- Network Connection Initiated By Regsvr32.EXE | T1218.010, T1559.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_regsvr32_network_activity.yml
SELECT * FROM events WHERE devicetype=12 AND Initiated='true' AND (LOWER("Process Path") LIKE '%\regsvr32.exe' OR LOWER("Process Name") LIKE '%\regsvr32.exe')
