-- Important Windows Eventlog Cleared | T1685.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/microsoft_windows_eventlog/win_system_susp_eventlog_cleared.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND "Event ID"=104 AND LOWER(UTF8(payload)) LIKE '%microsoft-windows-eventlog%' AND (LOWER(UTF8(payload)) LIKE '%microsoft-windows-powershell/operational%' OR LOWER(UTF8(payload)) LIKE '%microsoft-windows-sysmon/operational%' OR LOWER(UTF8(payload)) LIKE '%powershellcore/operational%' OR LOWER(UTF8(payload)) LIKE '%security%' OR LOWER(UTF8(payload)) LIKE '%system%' OR LOWER(UTF8(payload)) LIKE '%windows powershell%')
