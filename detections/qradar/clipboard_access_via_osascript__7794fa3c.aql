-- Clipboard Access Via OSAScript | T1059.002, T1115 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_clipboard_access_via_osascript.yml
SELECT * FROM events WHERE devicetype=102 AND ((LOWER("Process Path") LIKE '%/osascript' OR LOWER("Process Name") LIKE '%/osascript') AND (LOWER(Command) LIKE '% -e %' AND LOWER(Command) LIKE '%clipboard%')) AND (NOT((LOWER("Parent Process Path") LIKE '%opencode' AND (LOWER(Command) LIKE '%osascript%' AND LOWER(Command) LIKE '% -e %' AND LOWER(Command) LIKE '%set imagedata to the clipboard%' AND LOWER(Command) LIKE '%set fileref%'))))
