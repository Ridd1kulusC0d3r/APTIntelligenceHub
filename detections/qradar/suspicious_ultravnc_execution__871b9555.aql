-- Suspicious UltraVNC Execution | T1021.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_ultravnc_susp_execution.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER(Command) LIKE '%-autoreconnect %' AND LOWER(Command) LIKE '%-connect %' AND LOWER(Command) LIKE '%-id:%'
