-- Server Side Template Injection Strings | T1221 | https://github.com/SigmaHQ/sigma/blob/master/rules/web/webserver_generic/web_ssti_in_access_logs.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE Method='GET' AND (LOWER(UTF8(payload)) LIKE '%={{%' OR LOWER(UTF8(payload)) LIKE '%=%7b%7b%' OR LOWER(UTF8(payload)) LIKE '%=${%' OR LOWER(UTF8(payload)) LIKE '%=$%7b%' OR LOWER(UTF8(payload)) LIKE '%=<%=%' OR LOWER(UTF8(payload)) LIKE '%=%3c%25=%' OR LOWER(UTF8(payload)) LIKE '%=@(%' OR LOWER(UTF8(payload)) LIKE '%freemarker.template.utility.execute%' OR LOWER(UTF8(payload)) LIKE '%.getclass().forname(''javax.script.scriptenginemanager'')%' OR LOWER(UTF8(payload)) LIKE '%t(org.apache.commons.io.ioutils)%') AND (NOT(LOWER(UTF8(payload)) LIKE '%sc-status%404%'))
