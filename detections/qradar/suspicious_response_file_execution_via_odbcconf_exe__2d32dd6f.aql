-- Suspicious Response File Execution Via Odbcconf.EXE | T1218.008 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_odbcconf_response_file_susp.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\odbcconf.exe' OR LOWER("Process Name") LIKE '%\odbcconf.exe') OR Filename='odbcconf.exe') AND (LOWER(Command) LIKE '% -f %' OR LOWER(Command) LIKE '% /f %' OR LOWER(Command) LIKE '% –f %' OR LOWER(Command) LIKE '% —f %' OR LOWER(Command) LIKE '% ―f %')) AND (NOT((LOWER(Command) LIKE '%.rsp%' OR ("Parent Process Path"='C:\Windows\System32\runonce.exe' AND ("Process Path"='C:\Windows\System32\odbcconf.exe' OR "Process Name"='C:\Windows\System32\odbcconf.exe') AND LOWER(Command) LIKE '%.exe /e /f "c:\windows\system32\odbcconf.tmp"%'))))
