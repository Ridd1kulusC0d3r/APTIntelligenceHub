-- Set Suspicious Files as System Files Using Attrib.EXE | T1564.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_attrib_system_susp_paths.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\attrib.exe' OR LOWER("Process Name") LIKE '%\attrib.exe') OR Filename='ATTRIB.EXE') AND LOWER(Command) LIKE '% +s%' AND (LOWER(Command) LIKE '% %%' OR LOWER(Command) LIKE '%\users\public\%' OR LOWER(Command) LIKE '%\appdata\local\%' OR LOWER(Command) LIKE '%\programdata\%' OR LOWER(Command) LIKE '%\downloads\%' OR LOWER(Command) LIKE '%\windows\temp\%') AND (LOWER(Command) LIKE '%.bat%' OR LOWER(Command) LIKE '%.dll%' OR LOWER(Command) LIKE '%.exe%' OR LOWER(Command) LIKE '%.hta%' OR LOWER(Command) LIKE '%.ps1%' OR LOWER(Command) LIKE '%.vbe%' OR LOWER(Command) LIKE '%.vbs%')) AND (NOT((LOWER(Command) LIKE '%\windows\temp\%' AND LOWER(Command) LIKE '%.exe%')))
