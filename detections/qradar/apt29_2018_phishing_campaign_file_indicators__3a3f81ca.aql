-- APT29 2018 Phishing Campaign File Indicators | T1218.011 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2018/TA/APT29-CozyBear/file_event_win_apt_cozy_bear_phishing_campaign_indicators.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Filename) LIKE '%ds7002.lnk%' OR LOWER(Filename) LIKE '%ds7002.pdf%' OR LOWER(Filename) LIKE '%ds7002.zip%')
