-- Potentially Suspicious Azure Front Door Connection | T1090.004, T1102.002 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/network_connection/net_connection_win_susp_azurefd_connection.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER("Destination Hostname") LIKE '%azurefd.net%' AND (NOT((((LOWER("Process Path") LIKE '%brave.exe' OR LOWER("Process Path") LIKE '%chrome.exe' OR LOWER("Process Path") LIKE '%chromium.exe' OR LOWER("Process Path") LIKE '%firefox.exe' OR LOWER("Process Path") LIKE '%msedge.exe' OR LOWER("Process Path") LIKE '%msedgewebview2.exe' OR LOWER("Process Path") LIKE '%opera.exe' OR LOWER("Process Path") LIKE '%vivaldi.exe') OR (LOWER("Process Name") LIKE '%brave.exe' OR LOWER("Process Name") LIKE '%chrome.exe' OR LOWER("Process Name") LIKE '%chromium.exe' OR LOWER("Process Name") LIKE '%firefox.exe' OR LOWER("Process Name") LIKE '%msedge.exe' OR LOWER("Process Name") LIKE '%msedgewebview2.exe' OR LOWER("Process Name") LIKE '%opera.exe' OR LOWER("Process Name") LIKE '%vivaldi.exe')) OR (LOWER("Process Path") LIKE '%searchapp.exe' OR LOWER("Process Name") LIKE '%searchapp.exe') OR (LOWER("Destination Hostname") LIKE '%afdxtest.z01.azurefd.net%' OR LOWER("Destination Hostname") LIKE '%fp-afd.azurefd.net%' OR LOWER("Destination Hostname") LIKE '%fp-afdx-bpdee4gtg6frejfd.z01.azurefd.net%' OR LOWER("Destination Hostname") LIKE '%roxy.azurefd.net%' OR LOWER("Destination Hostname") LIKE '%powershellinfraartifacts-gkhedzdeaghdezhr.z01.azurefd.net%' OR LOWER("Destination Hostname") LIKE '%storage-explorer-publishing-feapcgfgbzc2cjek.b01.azurefd.net%' OR LOWER("Destination Hostname") LIKE '%graph.azurefd.net%'))))
