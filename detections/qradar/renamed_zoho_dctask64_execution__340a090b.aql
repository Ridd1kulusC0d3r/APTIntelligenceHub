-- Renamed ZOHO Dctask64 Execution | T1036, T1055.001, T1202, T1218 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_renamed_dctask64.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=6834b1b94e49701d77ccb3c0895e1afd%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=1bb6f93b129f398c7c4a76bb97450bba%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=faa2ac19875fade461c8d89dcf2710a3%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=f1039ced4b91572ab7847d26032e6bbf%') AND (NOT((LOWER("Process Path") LIKE '%\dctask64.exe' OR LOWER("Process Name") LIKE '%\dctask64.exe')))
