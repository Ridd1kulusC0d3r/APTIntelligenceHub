-- Azure Kubernetes Admission Controller | T1078, T1552, T1552.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/azure/activity_logs/azure_kubernetes_admission_controller.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE (LOWER(UTF8(payload)) LIKE '%microsoft.kubernetes/connectedclusters/admissionregistration.k8s.io%' OR LOWER(UTF8(payload)) LIKE '%microsoft.containerservice/managedclusters/admissionregistration.k8s.io%') AND (LOWER(UTF8(payload)) LIKE '%/mutatingwebhookconfigurations/write%' OR LOWER(UTF8(payload)) LIKE '%/validatingwebhookconfigurations/write%')
