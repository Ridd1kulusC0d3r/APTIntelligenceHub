-- System Information Discovery | T1082 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_system_info_discovery.yml
SELECT * FROM events WHERE devicetype=11 AND ((LOWER("Process Path") LIKE '%/uname' OR LOWER("Process Path") LIKE '%/hostname' OR LOWER("Process Path") LIKE '%/uptime' OR LOWER("Process Path") LIKE '%/lspci' OR LOWER("Process Path") LIKE '%/dmidecode' OR LOWER("Process Path") LIKE '%/lscpu' OR LOWER("Process Path") LIKE '%/lsmod') OR (LOWER("Process Name") LIKE '%/uname' OR LOWER("Process Name") LIKE '%/hostname' OR LOWER("Process Name") LIKE '%/uptime' OR LOWER("Process Name") LIKE '%/lspci' OR LOWER("Process Name") LIKE '%/dmidecode' OR LOWER("Process Name") LIKE '%/lscpu' OR LOWER("Process Name") LIKE '%/lsmod'))
