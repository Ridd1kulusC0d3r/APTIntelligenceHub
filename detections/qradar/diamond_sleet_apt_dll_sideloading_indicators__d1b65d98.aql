-- Diamond Sleet APT DLL Sideloading Indicators | T1574.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/TA/Diamond-Sleet/image_load_apt_diamond_sleet_side_load.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%:\programdata\clip.exe' OR LOWER("Process Name") LIKE '%:\programdata\clip.exe') AND LOWER(CONCAT('file directory', '/', filename)) LIKE '%:\programdata\version.dll') OR ((LOWER("Process Path") LIKE '%:\programdata\wsmprovhost.exe' OR LOWER("Process Name") LIKE '%:\programdata\wsmprovhost.exe') AND LOWER(CONCAT('file directory', '/', filename)) LIKE '%:\programdata\dsrole.dll'))
