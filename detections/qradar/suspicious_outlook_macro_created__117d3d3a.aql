-- Suspicious Outlook Macro Created | T1008, T1137, T1546 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_office_outlook_susp_macro_creation.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER(Filename) LIKE '%\microsoft\outlook\vbaproject.otm' AND (NOT((LOWER("Process Path") LIKE '%\outlook.exe' OR LOWER("Process Name") LIKE '%\outlook.exe')))
