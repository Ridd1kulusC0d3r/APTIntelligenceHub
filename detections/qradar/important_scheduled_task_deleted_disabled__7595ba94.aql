-- Important Scheduled Task Deleted/Disabled | T1053.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_susp_scheduled_task_delete_or_disable.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (("Event ID" IN('4699', '4701')) AND (LOWER("Task Name") LIKE '%\windows\systemrestore\sr%' OR LOWER("Task Name") LIKE '%\windows\windows defender\%' OR LOWER("Task Name") LIKE '%\windows\bitlocker%' OR LOWER("Task Name") LIKE '%\windows\windowsbackup\%' OR LOWER("Task Name") LIKE '%\windows\windowsupdate\%' OR LOWER("Task Name") LIKE '%\windows\updateorchestrator\schedule%' OR LOWER("Task Name") LIKE '%\windows\exploitguard%')) AND (NOT(("Event ID"=4699 AND LOWER(UTF8(payload)) LIKE '%$%' AND LOWER("Task Name") LIKE '%\windows\windows defender\%')))
