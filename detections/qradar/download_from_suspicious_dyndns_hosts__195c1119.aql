-- Download from Suspicious Dyndns Hosts | T1105, T1568 | https://github.com/SigmaHQ/sigma/blob/master/rules/web/proxy_generic/proxy_download_susp_dyndns.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE (LOWER(URL) LIKE '%exe%' OR LOWER(URL) LIKE '%vbs%' OR LOWER(URL) LIKE '%bat%' OR LOWER(URL) LIKE '%rar%' OR LOWER(URL) LIKE '%ps1%' OR LOWER(URL) LIKE '%doc%' OR LOWER(URL) LIKE '%docm%' OR LOWER(URL) LIKE '%xls%' OR LOWER(URL) LIKE '%xlsm%' OR LOWER(URL) LIKE '%pptm%' OR LOWER(URL) LIKE '%rtf%' OR LOWER(URL) LIKE '%hta%' OR LOWER(URL) LIKE '%dll%' OR LOWER(URL) LIKE '%ws%' OR LOWER(URL) LIKE '%wsf%' OR LOWER(URL) LIKE '%sct%' OR LOWER(URL) LIKE '%zip%') AND (LOWER(UTF8(payload)) LIKE '%.hopto.org%' OR LOWER(UTF8(payload)) LIKE '%.no-ip.org%' OR LOWER(UTF8(payload)) LIKE '%.no-ip.info%' OR LOWER(UTF8(payload)) LIKE '%.no-ip.biz%' OR LOWER(UTF8(payload)) LIKE '%.no-ip.com%' OR LOWER(UTF8(payload)) LIKE '%.noip.com%' OR LOWER(UTF8(payload)) LIKE '%.ddns.name%' OR LOWER(UTF8(payload)) LIKE '%.myftp.org%' OR LOWER(UTF8(payload)) LIKE '%.myftp.biz%' OR LOWER(UTF8(payload)) LIKE '%.serveblog.net%' OR LOWER(UTF8(payload)) LIKE '%.servebeer.com%' OR LOWER(UTF8(payload)) LIKE '%.servemp3.com%' OR LOWER(UTF8(payload)) LIKE '%.serveftp.com%' OR LOWER(UTF8(payload)) LIKE '%.servequake.com%' OR LOWER(UTF8(payload)) LIKE '%.servehalflife.com%' OR LOWER(UTF8(payload)) LIKE '%.servehttp.com%' OR LOWER(UTF8(payload)) LIKE '%.servegame.com%' OR LOWER(UTF8(payload)) LIKE '%.servepics.com%' OR LOWER(UTF8(payload)) LIKE '%.myvnc.com%' OR LOWER(UTF8(payload)) LIKE '%.ignorelist.com%' OR LOWER(UTF8(payload)) LIKE '%.jkub.com%' OR LOWER(UTF8(payload)) LIKE '%.dlinkddns.com%' OR LOWER(UTF8(payload)) LIKE '%.jumpingcrab.com%' OR LOWER(UTF8(payload)) LIKE '%.ddns.info%' OR LOWER(UTF8(payload)) LIKE '%.mooo.com%' OR LOWER(UTF8(payload)) LIKE '%.dns-dns.com%' OR LOWER(UTF8(payload)) LIKE '%.strangled.net%' OR LOWER(UTF8(payload)) LIKE '%.adultdns.net%' OR LOWER(UTF8(payload)) LIKE '%.craftx.biz%' OR LOWER(UTF8(payload)) LIKE '%.ddns01.com%' OR LOWER(UTF8(payload)) LIKE '%.dns53.biz%' OR LOWER(UTF8(payload)) LIKE '%.dnsapi.info%' OR LOWER(UTF8(payload)) LIKE '%.dnsd.info%' OR LOWER(UTF8(payload)) LIKE '%.dnsdynamic.com%' OR LOWER(UTF8(payload)) LIKE '%.dnsdynamic.net%' OR LOWER(UTF8(payload)) LIKE '%.dnsget.org%' OR LOWER(UTF8(payload)) LIKE '%.fe100.net%' OR LOWER(UTF8(payload)) LIKE '%.flashserv.net%' OR LOWER(UTF8(payload)) LIKE '%.ftp21.net%' OR LOWER(UTF8(payload)) LIKE '%.http01.com%' OR LOWER(UTF8(payload)) LIKE '%.http80.info%' OR LOWER(UTF8(payload)) LIKE '%.https443.com%' OR LOWER(UTF8(payload)) LIKE '%.imap01.com%' OR LOWER(UTF8(payload)) LIKE '%.kadm5.com%' OR LOWER(UTF8(payload)) LIKE '%.mysq1.net%' OR LOWER(UTF8(payload)) LIKE '%.ns360.info%' OR LOWER(UTF8(payload)) LIKE '%.ntdll.net%' OR LOWER(UTF8(payload)) LIKE '%.ole32.com%' OR LOWER(UTF8(payload)) LIKE '%.proxy8080.com%' OR LOWER(UTF8(payload)) LIKE '%.sql01.com%' OR LOWER(UTF8(payload)) LIKE '%.ssh01.com%' OR LOWER(UTF8(payload)) LIKE '%.ssh22.net%' OR LOWER(UTF8(payload)) LIKE '%.tempors.com%' OR LOWER(UTF8(payload)) LIKE '%.tftpd.net%' OR LOWER(UTF8(payload)) LIKE '%.ttl60.com%' OR LOWER(UTF8(payload)) LIKE '%.ttl60.org%' OR LOWER(UTF8(payload)) LIKE '%.user32.com%' OR LOWER(UTF8(payload)) LIKE '%.voip01.com%' OR LOWER(UTF8(payload)) LIKE '%.wow64.net%' OR LOWER(UTF8(payload)) LIKE '%.x64.me%' OR LOWER(UTF8(payload)) LIKE '%.xns01.com%' OR LOWER(UTF8(payload)) LIKE '%.dyndns.org%' OR LOWER(UTF8(payload)) LIKE '%.dyndns.info%' OR LOWER(UTF8(payload)) LIKE '%.dyndns.tv%' OR LOWER(UTF8(payload)) LIKE '%.dyndns-at-home.com%' OR LOWER(UTF8(payload)) LIKE '%.dnsomatic.com%' OR LOWER(UTF8(payload)) LIKE '%.zapto.org%' OR LOWER(UTF8(payload)) LIKE '%.webhop.net%' OR LOWER(UTF8(payload)) LIKE '%.25u.com%' OR LOWER(UTF8(payload)) LIKE '%.slyip.net%')
