-- Winlogon Helper DLL | T1547.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_winlogon_helper_dll.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER(Message) LIKE '%currentversion\winlogon%' AND (LOWER(Message) LIKE '%set-itemproperty%' OR LOWER(Message) LIKE '%new-item%')
