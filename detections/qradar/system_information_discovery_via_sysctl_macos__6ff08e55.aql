-- System Information Discovery Via Sysctl - MacOS | T1082, T1497.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_sysctl_discovery.yml
SELECT * FROM events WHERE devicetype=102 AND ((LOWER("Process Path") LIKE '%/sysctl' OR LOWER("Process Name") LIKE '%/sysctl') OR LOWER(Command) LIKE '%sysctl%') AND (LOWER(Command) LIKE '%hw.%' OR LOWER(Command) LIKE '%kern.%' OR LOWER(Command) LIKE '%machdep.%')
