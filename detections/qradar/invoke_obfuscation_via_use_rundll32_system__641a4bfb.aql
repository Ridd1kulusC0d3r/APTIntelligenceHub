-- Invoke-Obfuscation Via Use Rundll32 - System | T1027, T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/service_control_manager/win_system_invoke_obfuscation_via_use_rundll32_services.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND LOWER(UTF8(payload)) LIKE '%service control manager%' AND "Event ID"=7045 AND (LOWER("Process Path") LIKE '%&&%' AND LOWER("Process Path") LIKE '%rundll32%' AND LOWER("Process Path") LIKE '%shell32.dll%' AND LOWER("Process Path") LIKE '%shellexec_rundll%') AND (LOWER("Process Path") LIKE '%value%' OR LOWER("Process Path") LIKE '%invoke%' OR LOWER("Process Path") LIKE '%comspec%' OR LOWER("Process Path") LIKE '%iex%')
