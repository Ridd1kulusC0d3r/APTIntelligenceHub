-- Okta Identity Provider Created | T1098.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/identity/okta/okta_identity_provider_created.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=382 AND LOWER(UTF8(payload)) LIKE '%system.idp.lifecycle.create%'
