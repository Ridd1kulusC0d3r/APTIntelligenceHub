-- Github Fork Private Repositories Setting Enabled/Cleared | T1020, T1537 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/github/audit/github_fork_private_repos_enabled_or_cleared.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%private_repository_forking.clear%' OR LOWER(UTF8(payload)) LIKE '%private_repository_forking.enable%'
