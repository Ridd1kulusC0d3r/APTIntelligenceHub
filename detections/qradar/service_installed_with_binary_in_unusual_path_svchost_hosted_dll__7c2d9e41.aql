-- Service Installed With Binary In Unusual Path (svchost-hosted DLL) | T1543.003 | Hub | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Name") LIKE '%\services\%' OR LOWER("Target Process Name") LIKE '%\services\%' OR LOWER("Object Name") LIKE '%\services\%') AND (LOWER("Process Name") LIKE '%\parameters\servicedll' OR LOWER("Target Process Name") LIKE '%\parameters\servicedll' OR LOWER("Object Name") LIKE '%\parameters\servicedll')) AND (NOT((LOWER(UTF8(payload)) LIKE '%c:\windows\system32*%' OR LOWER(UTF8(payload)) LIKE '%%systemroot%\system32\%' OR LOWER(UTF8(payload)) LIKE '%%systemroot%\system32\%')))
