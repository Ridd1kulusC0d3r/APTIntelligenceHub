-- Antivirus - Ransomware Signature | T1486 | https://github.com/SigmaHQ/sigma/blob/master/rules/category/antivirus/av_ransomware.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%babuk%' OR LOWER(UTF8(payload)) LIKE '%babyk%' OR LOWER(UTF8(payload)) LIKE '%blackworm%' OR LOWER(UTF8(payload)) LIKE '%chaos%' OR LOWER(UTF8(payload)) LIKE '%cobra%' OR LOWER(UTF8(payload)) LIKE '%conticrypt%' OR LOWER(UTF8(payload)) LIKE '%crypter%' OR LOWER(UTF8(payload)) LIKE '%cryptes%' OR LOWER(UTF8(payload)) LIKE '%cryptor%' OR LOWER(UTF8(payload)) LIKE '%cylancrypt%' OR LOWER(UTF8(payload)) LIKE '%delshad%' OR LOWER(UTF8(payload)) LIKE '%destructor%' OR LOWER(UTF8(payload)) LIKE '%filecoder%' OR LOWER(UTF8(payload)) LIKE '%gandcrab%' OR LOWER(UTF8(payload)) LIKE '%grandcrab%' OR LOWER(UTF8(payload)) LIKE '%haperlock%' OR LOWER(UTF8(payload)) LIKE '%hiddentear%' OR LOWER(UTF8(payload)) LIKE '%hydracrypt%' OR LOWER(UTF8(payload)) LIKE '%krypt%' OR LOWER(UTF8(payload)) LIKE '%lockbit%' OR LOWER(UTF8(payload)) LIKE '%locker%' OR LOWER(UTF8(payload)) LIKE '%mallox%' OR LOWER(UTF8(payload)) LIKE '%medusa%' OR LOWER(UTF8(payload)) LIKE '%phobos%' OR LOWER(UTF8(payload)) LIKE '%ransom%' OR LOWER(UTF8(payload)) LIKE '%rook%' OR LOWER(UTF8(payload)) LIKE '%ryuk%' OR LOWER(UTF8(payload)) LIKE '%ryzerlo%' OR LOWER(UTF8(payload)) LIKE '%stopcrypt%' OR LOWER(UTF8(payload)) LIKE '%tescrypt%' OR LOWER(UTF8(payload)) LIKE '%teslacrypt%' OR LOWER(UTF8(payload)) LIKE '%wannacry%' OR LOWER(UTF8(payload)) LIKE '%xorist%'
