-- Activity from Infrequent Country | T1573 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/m365/threat_management/microsoft365_activity_from_infrequent_country.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype IN(443, 397) AND QIDNAME(qid)='Activity from infrequent country' AND LOWER(UTF8(payload)) LIKE '%success%'
