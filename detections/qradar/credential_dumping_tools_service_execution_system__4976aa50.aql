-- Credential Dumping Tools Service Execution - System | T1003.001, T1003.002, T1003.004, T1003.005, T1003.006, T1569.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/service_control_manager/win_system_mal_creddumper.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND LOWER(UTF8(payload)) LIKE '%service control manager%' AND "Event ID"=7045 AND (LOWER("Process Path") LIKE '%cachedump%' OR LOWER("Process Path") LIKE '%dumpsvc%' OR LOWER("Process Path") LIKE '%fgexec%' OR LOWER("Process Path") LIKE '%gsecdump%' OR LOWER("Process Path") LIKE '%mimidrv%' OR LOWER("Process Path") LIKE '%pwdump%' OR LOWER("Process Path") LIKE '%servpw%')
