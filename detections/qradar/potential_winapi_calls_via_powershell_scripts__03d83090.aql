-- Potential WinAPI Calls Via PowerShell Scripts | T1059.001, T1106, T1620 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_win_api_susp_access.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER(Message) LIKE '%virtualalloc%' AND LOWER(Message) LIKE '%openprocess%' AND LOWER(Message) LIKE '%writeprocessmemory%' AND LOWER(Message) LIKE '%createremotethread%') OR (LOWER(Message) LIKE '%openprocesstoken%' AND LOWER(Message) LIKE '%lookupprivilegevalue%' AND LOWER(Message) LIKE '%adjusttokenprivileges%') OR (LOWER(Message) LIKE '%openprocesstoken%' AND LOWER(Message) LIKE '%duplicatetokenex%' AND LOWER(Message) LIKE '%closehandle%') OR (LOWER(Message) LIKE '%writeprocessmemory%' AND LOWER(Message) LIKE '%virtualalloc%' AND LOWER(Message) LIKE '%readprocessmemory%' AND LOWER(Message) LIKE '%virtualfree%') OR (LOWER(Message) LIKE '%virtualalloc%' AND LOWER(Message) LIKE '%getdelegateforfunctionpointer%' AND LOWER(Message) LIKE '%marshal.copy%'))
