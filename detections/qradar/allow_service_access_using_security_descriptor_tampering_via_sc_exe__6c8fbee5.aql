-- Allow Service Access Using Security Descriptor Tampering Via Sc.EXE | T1543.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_sc_sdset_allow_service_changes.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\sc.exe' OR LOWER("Process Name") LIKE '%\sc.exe') OR Filename='sc.exe') AND (LOWER(Command) LIKE '%sdset%' AND LOWER(Command) LIKE '%a;%') AND (LOWER(Command) LIKE '%;iu%' OR LOWER(Command) LIKE '%;su%' OR LOWER(Command) LIKE '%;ba%' OR LOWER(Command) LIKE '%;sy%' OR LOWER(Command) LIKE '%;wd%')) AND (NOT("Parent Process Path"='C:\Hexnode\Hexnode Agent\Current\HexnodeAgent.exe'))
