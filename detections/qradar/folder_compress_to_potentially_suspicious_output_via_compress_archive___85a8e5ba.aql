-- Folder Compress To Potentially Suspicious Output Via Compress-Archive Cmdlet | T1074.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_zip_compress.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Command) LIKE '%compress-archive -path%-destinationpath $env:temp%' OR LOWER(Command) LIKE '%compress-archive -path%-destinationpath%\appdata\local\temp\%' OR LOWER(Command) LIKE '%compress-archive -path%-destinationpath%:\windows\temp\%')
