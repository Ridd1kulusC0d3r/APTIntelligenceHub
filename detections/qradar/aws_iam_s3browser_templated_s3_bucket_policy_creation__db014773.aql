-- AWS IAM S3Browser Templated S3 Bucket Policy Creation | T1059.009, T1078.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/aws/cloudtrail/aws_iam_s3browser_templated_s3_bucket_policy_creation.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype IN(516, 519, 456, 460, 501, 502, 507, 440, 347) AND QIDNAME(qid)='PutUserPolicy' AND LOWER("User Agent") LIKE '%s3 browser%' AND (LOWER(UTF8(payload)) LIKE '%"arn:aws:s3:::<your-bucket-name>/%"%' AND LOWER(UTF8(payload)) LIKE '%"s3:getobject"%' AND LOWER(UTF8(payload)) LIKE '%"allow"%')
