-- New DLL Added to AppInit_DLLs Registry Key | T1546.010 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_new_dll_added_to_appinit_dlls_registry_key.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Name") LIKE '%\software\microsoft\windows nt\currentversion\windows\appinit_dlls' OR LOWER("Process Name") LIKE '%\software\wow6432node\microsoft\windows nt\currentversion\windows\appinit_dlls') OR (LOWER("Target Process Name") LIKE '%\software\microsoft\windows nt\currentversion\windows\appinit_dlls' OR LOWER("Target Process Name") LIKE '%\software\wow6432node\microsoft\windows nt\currentversion\windows\appinit_dlls') OR (LOWER("Object Name") LIKE '%\software\microsoft\windows nt\currentversion\windows\appinit_dlls' OR LOWER("Object Name") LIKE '%\software\wow6432node\microsoft\windows nt\currentversion\windows\appinit_dlls')) OR (LOWER(UTF8(payload)) LIKE '%\software\microsoft\windows nt\currentversion\windows\appinit_dlls%' OR LOWER(UTF8(payload)) LIKE '%\software\wow6432node\microsoft\windows nt\currentversion\windows\appinit_dlls%')) AND (NOT(LOWER(UTF8(payload)) LIKE '%(empty)%'))
