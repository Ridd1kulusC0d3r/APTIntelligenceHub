-- Cisco File Deletion | T1070.004, T1561.001, T1561.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/cisco/aaa/cisco_cli_file_deletion.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype IN(6, 143, 273, 274, 20, 23, 26, 30, 31, 419, 41, 429, 431, 179, 435, 437, 182, 183, 56, 316, 448, 194, 90, 94, 95, 113, 114, 115, 116, 117, 248, 250, 508) AND (LOWER(UTF8(payload)) LIKE '%erase%' OR LOWER(UTF8(payload)) LIKE '%delete%' OR LOWER(UTF8(payload)) LIKE '%format%')
