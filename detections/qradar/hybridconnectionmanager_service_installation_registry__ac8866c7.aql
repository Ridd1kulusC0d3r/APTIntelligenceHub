-- HybridConnectionManager Service Installation - Registry | T1608 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_hybridconnectionmgr_svc_installation.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Name") LIKE '%\services\hybridconnectionmanager%' OR LOWER("Target Process Name") LIKE '%\services\hybridconnectionmanager%' OR LOWER("Object Name") LIKE '%\services\hybridconnectionmanager%') OR (LOWER(UTF8(payload)) LIKE '%setvalue%' AND LOWER(UTF8(payload)) LIKE '%microsoft.hybridconnectionmanager.listener.exe%'))
