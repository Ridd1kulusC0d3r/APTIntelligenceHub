-- Cisco Stage Data | T1074, T1105, T1560.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/cisco/aaa/cisco_cli_moving_data.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype IN(6, 143, 273, 274, 20, 23, 26, 30, 31, 419, 41, 429, 431, 179, 435, 437, 182, 183, 56, 316, 448, 194, 90, 94, 95, 113, 114, 115, 116, 117, 248, 250, 508) AND (LOWER(UTF8(payload)) LIKE '%tftp%' OR LOWER(UTF8(payload)) LIKE '%rcp%' OR LOWER(UTF8(payload)) LIKE '%puts%' OR LOWER(UTF8(payload)) LIKE '%copy%' OR LOWER(UTF8(payload)) LIKE '%configure replace%' OR LOWER(UTF8(payload)) LIKE '%archive tar%')
