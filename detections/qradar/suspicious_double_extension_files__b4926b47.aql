-- Suspicious Double Extension Files | T1036.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_double_extension.yml
SELECT * FROM events WHERE devicetype=12 AND (Filename MATCHES '(?i)\.(docx?|gif|jpe?g|mp3|mp4|pdf|png|pptx?|rtf|svg|txt|xlsx?)\.(bat|exe|iso|rar|svg|vbe|vbs|zip)$' OR (LOWER(Filename) LIKE '%.rar.exe' OR LOWER(Filename) LIKE '%.zip.exe')) AND (NOT((LOWER(Filename) LIKE '%.svg.svg' OR LOWER(Filename) LIKE '%.png.svg' OR LOWER(Filename) LIKE '%.jpg.svg' OR LOWER(Filename) LIKE '%.jpeg.svg'))) AND (NOT(LOWER(Filename) LIKE '/usr/share/icons/%'))
