-- EvilNum APT Golden Chickens Deployment Via OCX Files | T1218.011 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2020/TA/Evilnum/proc_creation_win_apt_evilnum_jul20.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER(Command) LIKE '%regsvr32%' AND LOWER(Command) LIKE '%/s%' AND LOWER(Command) LIKE '%/i%' AND LOWER(Command) LIKE '%\appdata\roaming\%' AND LOWER(Command) LIKE '%.ocx%'
