-- Google Cloud Re-identifies Sensitive Information | T1565 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/gcp/audit/gcp_dlp_re_identifies_sensitive_information.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype IN(449, 442, 461, 455) AND LOWER(UTF8(payload)) LIKE '%projects.content.reidentify%'
