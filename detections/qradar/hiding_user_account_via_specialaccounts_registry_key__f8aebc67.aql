-- Hiding User Account Via SpecialAccounts Registry Key | T1564.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_special_accounts.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\software\microsoft\windows nt\currentversion\winlogon\specialaccounts\userlist%' OR LOWER("Target Process Name") LIKE '%\software\microsoft\windows nt\currentversion\winlogon\specialaccounts\userlist%' OR LOWER("Object Name") LIKE '%\software\microsoft\windows nt\currentversion\winlogon\specialaccounts\userlist%') AND LOWER(UTF8(payload)) LIKE '%dword (0x00000000)%'
