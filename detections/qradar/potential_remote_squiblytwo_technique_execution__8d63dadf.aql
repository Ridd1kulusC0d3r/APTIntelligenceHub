-- Potential Remote SquiblyTwo Technique Execution | T1047, T1059.005, T1059.007, T1220 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_wmic_squiblytwo_bypass.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\wmic.exe' OR LOWER("Process Name") LIKE '%\wmic.exe') OR Filename='wmic.exe' OR (LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=1b1a3f43bf37b5bfe60751f2ee2f326e%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=37777a96245a3c74eb217308f3546f4c%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=9d87c9d67ce724033c0b40cc4ca1b206%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=b12619881d79c3acadf45e752a58554a%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=16a48c3cabf98a9dc1bf02c07fe1ea00%')) AND ((LOWER(Command) LIKE '%-format:%' OR LOWER(Command) LIKE '%/format:%' OR LOWER(Command) LIKE '%–format:%' OR LOWER(Command) LIKE '%—format:%' OR LOWER(Command) LIKE '%―format:%') AND (LOWER(Command) LIKE '%://%' OR LOWER(Command) LIKE '%\\%'))
