-- Remote CHM File Download/Execution Via HH.EXE | T1218.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hh_chm_remote_download_or_execution.yml
SELECT * FROM events WHERE devicetype=12 AND (Filename='HH.exe' OR (LOWER("Process Path") LIKE '%\hh.exe' OR LOWER("Process Name") LIKE '%\hh.exe')) AND (LOWER(Command) LIKE '%http://%' OR LOWER(Command) LIKE '%https://%' OR LOWER(Command) LIKE '%\\%')
