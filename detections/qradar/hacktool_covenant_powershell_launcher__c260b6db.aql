-- HackTool - Covenant PowerShell Launcher | T1059.001, T1564.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_covenant.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER(Command) LIKE '%-sta%' AND LOWER(Command) LIKE '%-nop%' AND LOWER(Command) LIKE '%-window%' AND LOWER(Command) LIKE '%hidden%') AND (LOWER(Command) LIKE '%-command%' OR LOWER(Command) LIKE '%-encodedcommand%')) OR (LOWER(Command) LIKE '%sv o (new-object io.memorysteam);sv d %' OR LOWER(Command) LIKE '%mshta file.hta%' OR LOWER(Command) LIKE '%grunthttp%' OR LOWER(Command) LIKE '%-encodedcommand cwb2acaabwaga%'))
