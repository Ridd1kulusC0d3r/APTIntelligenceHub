-- DLL Load via LSASS | T1547.008 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_susp_lsass_dll_load.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Name") LIKE '%\currentcontrolset\services\ntds\directoryserviceextpt%' OR LOWER("Process Name") LIKE '%\currentcontrolset\services\ntds\lsadbextpt%') OR (LOWER("Target Process Name") LIKE '%\currentcontrolset\services\ntds\directoryserviceextpt%' OR LOWER("Target Process Name") LIKE '%\currentcontrolset\services\ntds\lsadbextpt%') OR (LOWER("Object Name") LIKE '%\currentcontrolset\services\ntds\directoryserviceextpt%' OR LOWER("Object Name") LIKE '%\currentcontrolset\services\ntds\lsadbextpt%')) AND (NOT((("Process Path"='C:\Windows\system32\lsass.exe' OR "Process Name"='C:\Windows\system32\lsass.exe') AND (LOWER(UTF8(payload)) LIKE '%%%systemroot%%\system32\ntdsa.dll%' OR LOWER(UTF8(payload)) LIKE '%%%systemroot%%\system32\lsadb.dll%'))))
