-- Disabling Multi Factor Authentication | T1556.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/m365/audit/microsoft365_disabling_mfa.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=397 AND LOWER(UTF8(payload)) LIKE '%disable strong authentication.%'
