-- PwnKit Local Privilege Escalation | T1548.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2021/Exploits/CVE-2021-4034/lnx_auth_exploit_cve_2021_4034_pwnkit_lpe.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype IN(11, 12) AND LOWER(UTF8(payload)) LIKE '%pkexec%' AND LOWER(UTF8(payload)) LIKE '%the value for environment variable xauthority contains suspicious content%' AND LOWER(UTF8(payload)) LIKE '%[user=root] [tty=/dev/pts/0]%'
