-- Potential Persistence Via Microsoft Office Add-In | T1137.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_office_addin_persistence.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER(Filename) LIKE '%\microsoft\word\startup\%' AND LOWER(Filename) LIKE '%.wll') OR (LOWER(Filename) LIKE '%\microsoft\excel\startup\%' AND LOWER(Filename) LIKE '%.xll') OR (LOWER(Filename) LIKE '%microsoft\excel\xlstart\%' AND LOWER(Filename) LIKE '%.xlam') OR (LOWER(Filename) LIKE '%\microsoft\addins\%' AND (LOWER(Filename) LIKE '%.xlam' OR LOWER(Filename) LIKE '%.xla' OR LOWER(Filename) LIKE '%.ppam')))
