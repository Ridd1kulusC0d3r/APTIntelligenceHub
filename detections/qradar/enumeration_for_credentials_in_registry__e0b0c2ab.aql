-- Enumeration for Credentials in Registry | T1552.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_reg_enumeration_for_credentials_in_registry.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\reg.exe' OR LOWER("Process Name") LIKE '%\reg.exe') AND (LOWER(Command) LIKE '% query %' AND LOWER(Command) LIKE '%/t %' AND LOWER(Command) LIKE '%reg_sz%' AND LOWER(Command) LIKE '%/s%')) AND ((LOWER(Command) LIKE '%/f %' AND LOWER(Command) LIKE '%hklm%') OR (LOWER(Command) LIKE '%/f %' AND LOWER(Command) LIKE '%hkcu%') OR LOWER(Command) LIKE '%hkcu\software\simontatham\putty\sessions%')
