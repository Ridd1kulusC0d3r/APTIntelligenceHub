-- Potential Persistence Via Excel Add-in - Registry | T1137.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_persistence_xll.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%software\microsoft\office\%' OR LOWER("Target Process Name") LIKE '%software\microsoft\office\%' OR LOWER("Object Name") LIKE '%software\microsoft\office\%') AND (LOWER("Process Name") LIKE '%\excel\options' OR LOWER("Target Process Name") LIKE '%\excel\options' OR LOWER("Object Name") LIKE '%\excel\options') AND LOWER(UTF8(payload)) LIKE '%/r %' AND LOWER(UTF8(payload)) LIKE '%.xll%'
