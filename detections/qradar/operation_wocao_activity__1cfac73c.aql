-- Operation Wocao Activity | T1012, T1027, T1036.004, T1053.005, T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/TA/Operation-Wocao/proc_creation_win_apt_wocao.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Command) LIKE '%checkadmin.exe 127.0.0.1 -all%' OR LOWER(Command) LIKE '%netsh advfirewall firewall add rule name=powershell dir=in%' OR LOWER(Command) LIKE '%cmd /c powershell.exe -ep bypass -file c:\s.ps1%' OR LOWER(Command) LIKE '%/tn win32times /f%' OR LOWER(Command) LIKE '%create win32times binpath=%' OR LOWER(Command) LIKE '%\c$\windows\system32\devmgr.dll%' OR LOWER(Command) LIKE '% -exec bypass -enc jgag%' OR LOWER(Command) LIKE '%type %keepass\keepass.config.xml%' OR LOWER(Command) LIKE '%iie.exe iie.txt%' OR LOWER(Command) LIKE '%reg query hkey_current_user\software\%\putty\sessions\%')
