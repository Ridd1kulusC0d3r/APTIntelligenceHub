-- Console CodePage Lookup Via CHCP | T1614.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_chcp_codepage_lookup.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER("Parent Process Path") LIKE '%\cmd.exe' AND (LOWER("Parent Command") LIKE '% -c %' OR LOWER("Parent Command") LIKE '% /c %' OR LOWER("Parent Command") LIKE '% –c %' OR LOWER("Parent Command") LIKE '% —c %' OR LOWER("Parent Command") LIKE '% ―c %' OR LOWER("Parent Command") LIKE '% -r %' OR LOWER("Parent Command") LIKE '% /r %' OR LOWER("Parent Command") LIKE '% –r %' OR LOWER("Parent Command") LIKE '% —r %' OR LOWER("Parent Command") LIKE '% ―r %' OR LOWER("Parent Command") LIKE '% -k %' OR LOWER("Parent Command") LIKE '% /k %' OR LOWER("Parent Command") LIKE '% –k %' OR LOWER("Parent Command") LIKE '% —k %' OR LOWER("Parent Command") LIKE '% ―k %') AND (LOWER("Process Path") LIKE '%\chcp.com' OR LOWER("Process Name") LIKE '%\chcp.com') AND (LOWER(Command) LIKE '%chcp' OR LOWER(Command) LIKE '%chcp ' OR LOWER(Command) LIKE '%chcp  ')
