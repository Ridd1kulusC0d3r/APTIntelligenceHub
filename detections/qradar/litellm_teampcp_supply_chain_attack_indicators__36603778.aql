-- LiteLLM / TeamPCP Supply Chain Attack Indicators | T1195.002, T1543.002, T1560.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2026/TA/TeamPCP/proc_creation_lnx_teampcp_litellm_supply_chain_attack_indicators.yml
SELECT * FROM events WHERE devicetype=11 AND (((LOWER("Process Path") LIKE '%/python3%' OR LOWER("Process Name") LIKE '%/python3%') AND (LOWER(Command) LIKE '%exec(base64.b64decode(''aw1wb3j0%' AND LOWER(Command) LIKE '%ki2nf9tq1jjufqgpsaiyv%')) OR ((LOWER("Process Path") LIKE '%/tar' OR LOWER("Process Name") LIKE '%/tar') AND (LOWER(Command) LIKE '%tpcp.tar.gz%' AND LOWER(Command) LIKE '%payload.enc%' AND LOWER(Command) LIKE '%session.key.enc%')) OR ((LOWER("Process Path") LIKE '%/curl' OR LOWER("Process Name") LIKE '%/curl') AND (LOWER(Command) LIKE '%models.litellm.cloud%' AND LOWER(Command) LIKE '%x-filename: tpcp.tar.gz%')) OR (LOWER("Parent Process Path") LIKE '%/python3%' AND (LOWER(Command) LIKE '%systemctl%' AND LOWER(Command) LIKE '%--user%' AND LOWER(Command) LIKE '%sysmon%')))
