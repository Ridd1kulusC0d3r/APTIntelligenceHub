-- Cobalt Strike DNS Beaconing | T1071.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/dns/net_dns_mal_cobaltstrike.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE (LOWER(UTF8(payload)) LIKE '%aaa.stage.%' OR LOWER(UTF8(payload)) LIKE '%post.1%') OR LOWER(UTF8(payload)) LIKE '%.stage.123456.%'
