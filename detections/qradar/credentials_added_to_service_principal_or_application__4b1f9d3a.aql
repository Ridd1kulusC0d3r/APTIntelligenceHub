-- Credentials Added To Service Principal Or Application | T1098.001 | Hub | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%add service principal credentials%' OR LOWER(UTF8(payload)) LIKE '%update application - certificates and secrets management%'
