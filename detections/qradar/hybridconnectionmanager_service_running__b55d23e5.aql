-- HybridConnectionManager Service Running | T1554 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/servicebus/win_hybridconnectionmgr_svc_running.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ("Event ID" IN('40300', '40301', '40302')) AND (LOWER(UTF8(payload)) LIKE '%hybridconnection%' OR LOWER(UTF8(payload)) LIKE '%sb://%' OR LOWER(UTF8(payload)) LIKE '%servicebus.windows.net%' OR LOWER(UTF8(payload)) LIKE '%hybridconnectionmanage%')
