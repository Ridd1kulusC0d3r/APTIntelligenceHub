-- Silence.EDA Detection | T1059.001, T1071.004, T1529, T1572 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_apt_silence_eda.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Message) LIKE '%system.diagnostics.process%' AND LOWER(Message) LIKE '%stop-computer%' AND LOWER(Message) LIKE '%restart-computer%' AND LOWER(Message) LIKE '%exception in execution%' AND LOWER(Message) LIKE '%$cmdargs%' AND LOWER(Message) LIKE '%close-dnscat2tunnel%') AND (LOWER(Message) LIKE '%set type=$lookuptype`nserver%' AND LOWER(Message) LIKE '%$command | nslookup 2>&1 | out-string%' AND LOWER(Message) LIKE '%new-randomdnsfield%' AND LOWER(Message) LIKE '%[convert]::tostring($synoptions, 16)%' AND LOWER(Message) LIKE '%$session.dead = $true%' AND LOWER(Message) LIKE '%$session["driver"] -eq%')
