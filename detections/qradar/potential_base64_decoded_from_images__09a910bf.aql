-- Potential Base64 Decoded From Images | T1140 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_tail_base64_decode_from_image.yml
SELECT * FROM events WHERE devicetype=102 AND (LOWER("Process Path") LIKE '%/bash' OR LOWER("Process Name") LIKE '%/bash') AND (LOWER(Command) LIKE '%tail%' AND LOWER(Command) LIKE '%-c%') AND (LOWER(Command) LIKE '%base64%' AND LOWER(Command) LIKE '%-d%' AND LOWER(Command) LIKE '%>%') AND (LOWER(Command) LIKE '%.avif%' OR LOWER(Command) LIKE '%.gif%' OR LOWER(Command) LIKE '%.jfif%' OR LOWER(Command) LIKE '%.jpeg%' OR LOWER(Command) LIKE '%.jpg%' OR LOWER(Command) LIKE '%.pjp%' OR LOWER(Command) LIKE '%.pjpeg%' OR LOWER(Command) LIKE '%.png%' OR LOWER(Command) LIKE '%.svg%' OR LOWER(Command) LIKE '%.webp%')
