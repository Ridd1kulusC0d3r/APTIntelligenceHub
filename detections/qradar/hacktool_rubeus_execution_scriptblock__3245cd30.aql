-- HackTool - Rubeus Execution - ScriptBlock | T1003, T1550.003, T1558.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_hktl_rubeus.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Message) LIKE '%asreproast %' OR LOWER(Message) LIKE '%dump /service:krbtgt %' OR LOWER(Message) LIKE '%dump /luid:0x%' OR LOWER(Message) LIKE '%kerberoast %' OR LOWER(Message) LIKE '%createnetonly /program:%' OR LOWER(Message) LIKE '%ptt /ticket:%' OR LOWER(Message) LIKE '%/impersonateuser:%' OR LOWER(Message) LIKE '%renew /ticket:%' OR LOWER(Message) LIKE '%asktgt /user:%' OR LOWER(Message) LIKE '%harvest /interval:%' OR LOWER(Message) LIKE '%s4u /user:%' OR LOWER(Message) LIKE '%s4u /ticket:%' OR LOWER(Message) LIKE '%hash /password:%' OR LOWER(Message) LIKE '%golden /aes256:%' OR LOWER(Message) LIKE '%silver /user:%')
