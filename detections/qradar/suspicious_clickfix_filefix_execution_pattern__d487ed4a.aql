-- Suspicious ClickFix/FileFix Execution Pattern | T1204.001, T1204.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_clickfix_filefix_execution.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Parent Process Path") LIKE '%\explorer.exe' AND LOWER(Command) LIKE '%#%') AND (LOWER(Command) LIKE '%account%' OR LOWER(Command) LIKE '%anti-bot%' OR LOWER(Command) LIKE '%botcheck%' OR LOWER(Command) LIKE '%captcha%' OR LOWER(Command) LIKE '%challenge%' OR LOWER(Command) LIKE '%confirmation%' OR LOWER(Command) LIKE '%fraud%' OR LOWER(Command) LIKE '%human%' OR LOWER(Command) LIKE '%identification%' OR LOWER(Command) LIKE '%identificator%' OR LOWER(Command) LIKE '%identity%' OR LOWER(Command) LIKE '%robot%' OR LOWER(Command) LIKE '%validation%' OR LOWER(Command) LIKE '%verification%' OR LOWER(Command) LIKE '%verify%')
