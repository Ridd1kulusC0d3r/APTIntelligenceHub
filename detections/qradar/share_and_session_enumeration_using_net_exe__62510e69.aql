-- Share And Session Enumeration Using Net.EXE | T1018 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_net_view_share_and_sessions_enum.yml
SELECT * FROM events WHERE devicetype=12 AND ((((LOWER("Process Path") LIKE '%\net.exe' OR LOWER("Process Path") LIKE '%\net1.exe') OR (LOWER("Process Name") LIKE '%\net.exe' OR LOWER("Process Name") LIKE '%\net1.exe')) OR (Filename IN('net.exe', 'net1.exe'))) AND LOWER(Command) LIKE '%view%') AND (NOT(LOWER(Command) LIKE '%\\%'))
