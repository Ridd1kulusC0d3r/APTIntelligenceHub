-- Remote Thread Creation In Uncommon Target Image | T1055.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/create_remote_thread/create_remote_thread_win_susp_uncommon_target_image.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Target Process Path") LIKE '%\calc.exe' OR LOWER("Target Process Path") LIKE '%\calculator.exe' OR LOWER("Target Process Path") LIKE '%\mspaint.exe' OR LOWER("Target Process Path") LIKE '%\notepad.exe' OR LOWER("Target Process Path") LIKE '%\ping.exe' OR LOWER("Target Process Path") LIKE '%\sethc.exe' OR LOWER("Target Process Path") LIKE '%\spoolsv.exe' OR LOWER("Target Process Path") LIKE '%\wordpad.exe' OR LOWER("Target Process Path") LIKE '%\write.exe') AND (NOT(("Source Process Path"='C:\Windows\System32\csrss.exe' OR (("Source Process Path" IN('C:\Windows\System32\explorer.exe', 'C:\Windows\System32\OpenWith.exe')) AND "Target Process Path"='C:\Windows\System32\notepad.exe') OR ("Source Process Path"='C:\Windows\System32\AtBroker.exe' AND "Target Process Path"='C:\Windows\System32\Sethc.exe')))) AND (NOT((LOWER(UTF8(payload)) LIKE '%etwpnotificationthread%' OR LOWER("Source Process Path") LIKE '%unknown process%' OR ("Source Process Path"='C:\Program Files\VMware\VMware Tools\vmtoolsd.exe' AND LOWER(UTF8(payload)) LIKE '%getcommandlinew%' AND ("Target Process Path" IN('C:\Windows\System32\notepad.exe', 'C:\Windows\System32\spoolsv.exe'))) OR ("Source Process Path"='C:\Program Files\Xerox\XeroxPrintExperience\CommonFiles\XeroxPrintJobEventManagerService.exe' AND LOWER(UTF8(payload)) LIKE '%loadlibraryw%' AND "Target Process Path"='C:\Windows\System32\spoolsv.exe'))))
