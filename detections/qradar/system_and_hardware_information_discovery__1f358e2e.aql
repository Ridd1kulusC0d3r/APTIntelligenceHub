-- System and Hardware Information Discovery | T1082 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/path/lnx_auditd_system_info_discovery2.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND LOWER(UTF8(payload)) LIKE '%path%' AND (LOWER(UTF8(payload)) LIKE '%/sys/class/dmi/id/bios_version%' OR LOWER(UTF8(payload)) LIKE '%/sys/class/dmi/id/product_name%' OR LOWER(UTF8(payload)) LIKE '%/sys/class/dmi/id/chassis_vendor%' OR LOWER(UTF8(payload)) LIKE '%/proc/scsi/scsi%' OR LOWER(UTF8(payload)) LIKE '%/proc/ide/hd0/model%' OR LOWER(UTF8(payload)) LIKE '%/proc/version%' OR LOWER(UTF8(payload)) LIKE '%/etc/%version%' OR LOWER(UTF8(payload)) LIKE '%/etc/%release%' OR LOWER(UTF8(payload)) LIKE '%/etc/issue%')
