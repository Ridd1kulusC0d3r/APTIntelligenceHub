-- Potential BlackByte Ransomware Activity | T1059.001, T1140, T1485, T1498 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2021/Malware/BlackByte/proc_creation_win_malware_blackbyte_ransomware.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE 'c:\users\public\%' OR LOWER("Process Name") LIKE 'c:\users\public\%') AND LOWER(Command) LIKE '% -single %') OR (LOWER(Command) LIKE '%del c:\windows\system32\taskmgr.exe%' OR LOWER(Command) LIKE '%;set-service -startuptype disabled $%' OR LOWER(Command) LIKE '%powershell -command "$x =[system.text.encoding]::unicode.getstring([system.convert]::frombase64string(%' OR LOWER(Command) LIKE '% do start wordpad.exe /p %'))
