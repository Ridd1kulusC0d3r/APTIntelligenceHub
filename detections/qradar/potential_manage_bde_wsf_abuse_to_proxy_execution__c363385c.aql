-- Potential Manage-bde.wsf Abuse To Proxy Execution | T1216 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_lolbin_manage_bde.yml
SELECT * FROM events WHERE devicetype=12 AND ((((LOWER("Process Path") LIKE '%\wscript.exe' OR LOWER("Process Name") LIKE '%\wscript.exe') OR Filename='wscript.exe') AND LOWER(Command) LIKE '%manage-bde.wsf%') OR (((LOWER("Parent Process Path") LIKE '%\cscript.exe' OR LOWER("Parent Process Path") LIKE '%\wscript.exe') AND LOWER("Parent Command") LIKE '%manage-bde.wsf%') AND (NOT((LOWER("Process Path") LIKE '%\cmd.exe' OR LOWER("Process Name") LIKE '%\cmd.exe')))))
