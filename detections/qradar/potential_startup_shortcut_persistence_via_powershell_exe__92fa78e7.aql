-- Potential Startup Shortcut Persistence Via PowerShell.EXE | T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_powershell_startup_shortcuts.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\powershell.exe' OR LOWER("Process Path") LIKE '%\pwsh.exe') OR (LOWER("Process Name") LIKE '%\powershell.exe' OR LOWER("Process Name") LIKE '%\pwsh.exe')) AND LOWER(Filename) LIKE '%\start menu\programs\startup\%' AND LOWER(Filename) LIKE '%.lnk'
