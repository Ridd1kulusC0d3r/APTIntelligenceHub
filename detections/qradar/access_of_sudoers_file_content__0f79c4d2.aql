-- Access of Sudoers File Content | T1592.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_susp_process_reading_sudoers.yml
SELECT * FROM events WHERE devicetype=11 AND ((LOWER("Process Path") LIKE '%/cat' OR LOWER("Process Path") LIKE '%/ed' OR LOWER("Process Path") LIKE '%/egrep' OR LOWER("Process Path") LIKE '%/emacs' OR LOWER("Process Path") LIKE '%/fgrep' OR LOWER("Process Path") LIKE '%/grep' OR LOWER("Process Path") LIKE '%/head' OR LOWER("Process Path") LIKE '%/less' OR LOWER("Process Path") LIKE '%/more' OR LOWER("Process Path") LIKE '%/nano' OR LOWER("Process Path") LIKE '%/tail') OR (LOWER("Process Name") LIKE '%/cat' OR LOWER("Process Name") LIKE '%/ed' OR LOWER("Process Name") LIKE '%/egrep' OR LOWER("Process Name") LIKE '%/emacs' OR LOWER("Process Name") LIKE '%/fgrep' OR LOWER("Process Name") LIKE '%/grep' OR LOWER("Process Name") LIKE '%/head' OR LOWER("Process Name") LIKE '%/less' OR LOWER("Process Name") LIKE '%/more' OR LOWER("Process Name") LIKE '%/nano' OR LOWER("Process Name") LIKE '%/tail')) AND LOWER(Command) LIKE '% /etc/sudoers%'
