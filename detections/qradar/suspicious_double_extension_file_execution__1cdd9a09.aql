-- Suspicious Double Extension File Execution | T1566.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_double_extension.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%      .exe' OR LOWER("Process Path") LIKE '%______.exe' OR LOWER("Process Path") LIKE '%.doc.exe' OR LOWER("Process Path") LIKE '%.doc.js' OR LOWER("Process Path") LIKE '%.docx.exe' OR LOWER("Process Path") LIKE '%.docx.js' OR LOWER("Process Path") LIKE '%.gif.exe' OR LOWER("Process Path") LIKE '%.jpeg.exe' OR LOWER("Process Path") LIKE '%.jpg.exe' OR LOWER("Process Path") LIKE '%.mkv.exe' OR LOWER("Process Path") LIKE '%.mov.exe' OR LOWER("Process Path") LIKE '%.mp3.exe' OR LOWER("Process Path") LIKE '%.mp4.exe' OR LOWER("Process Path") LIKE '%.pdf.exe' OR LOWER("Process Path") LIKE '%.pdf.js' OR LOWER("Process Path") LIKE '%.png.exe' OR LOWER("Process Path") LIKE '%.ppt.exe' OR LOWER("Process Path") LIKE '%.ppt.js' OR LOWER("Process Path") LIKE '%.pptx.exe' OR LOWER("Process Path") LIKE '%.pptx.js' OR LOWER("Process Path") LIKE '%.rtf.exe' OR LOWER("Process Path") LIKE '%.rtf.js' OR LOWER("Process Path") LIKE '%.svg.exe' OR LOWER("Process Path") LIKE '%.txt.exe' OR LOWER("Process Path") LIKE '%.txt.js' OR LOWER("Process Path") LIKE '%.xls.exe' OR LOWER("Process Path") LIKE '%.xls.js' OR LOWER("Process Path") LIKE '%.xlsx.exe' OR LOWER("Process Path") LIKE '%.xlsx.js' OR LOWER("Process Path") LIKE '%⠀⠀⠀⠀⠀⠀.exe') OR (LOWER("Process Name") LIKE '%      .exe' OR LOWER("Process Name") LIKE '%______.exe' OR LOWER("Process Name") LIKE '%.doc.exe' OR LOWER("Process Name") LIKE '%.doc.js' OR LOWER("Process Name") LIKE '%.docx.exe' OR LOWER("Process Name") LIKE '%.docx.js' OR LOWER("Process Name") LIKE '%.gif.exe' OR LOWER("Process Name") LIKE '%.jpeg.exe' OR LOWER("Process Name") LIKE '%.jpg.exe' OR LOWER("Process Name") LIKE '%.mkv.exe' OR LOWER("Process Name") LIKE '%.mov.exe' OR LOWER("Process Name") LIKE '%.mp3.exe' OR LOWER("Process Name") LIKE '%.mp4.exe' OR LOWER("Process Name") LIKE '%.pdf.exe' OR LOWER("Process Name") LIKE '%.pdf.js' OR LOWER("Process Name") LIKE '%.png.exe' OR LOWER("Process Name") LIKE '%.ppt.exe' OR LOWER("Process Name") LIKE '%.ppt.js' OR LOWER("Process Name") LIKE '%.pptx.exe' OR LOWER("Process Name") LIKE '%.pptx.js' OR LOWER("Process Name") LIKE '%.rtf.exe' OR LOWER("Process Name") LIKE '%.rtf.js' OR LOWER("Process Name") LIKE '%.svg.exe' OR LOWER("Process Name") LIKE '%.txt.exe' OR LOWER("Process Name") LIKE '%.txt.js' OR LOWER("Process Name") LIKE '%.xls.exe' OR LOWER("Process Name") LIKE '%.xls.js' OR LOWER("Process Name") LIKE '%.xlsx.exe' OR LOWER("Process Name") LIKE '%.xlsx.js' OR LOWER("Process Name") LIKE '%⠀⠀⠀⠀⠀⠀.exe')) AND (LOWER(Command) LIKE '%      .exe%' OR LOWER(Command) LIKE '%______.exe%' OR LOWER(Command) LIKE '%.doc.exe%' OR LOWER(Command) LIKE '%.doc.js%' OR LOWER(Command) LIKE '%.docx.exe%' OR LOWER(Command) LIKE '%.docx.js%' OR LOWER(Command) LIKE '%.gif.exe%' OR LOWER(Command) LIKE '%.jpeg.exe%' OR LOWER(Command) LIKE '%.jpg.exe%' OR LOWER(Command) LIKE '%.mkv.exe%' OR LOWER(Command) LIKE '%.mov.exe%' OR LOWER(Command) LIKE '%.mp3.exe%' OR LOWER(Command) LIKE '%.mp4.exe%' OR LOWER(Command) LIKE '%.pdf.exe%' OR LOWER(Command) LIKE '%.pdf.js%' OR LOWER(Command) LIKE '%.png.exe%' OR LOWER(Command) LIKE '%.ppt.exe%' OR LOWER(Command) LIKE '%.ppt.js%' OR LOWER(Command) LIKE '%.pptx.exe%' OR LOWER(Command) LIKE '%.pptx.js%' OR LOWER(Command) LIKE '%.rtf.exe%' OR LOWER(Command) LIKE '%.rtf.js%' OR LOWER(Command) LIKE '%.svg.exe%' OR LOWER(Command) LIKE '%.txt.exe%' OR LOWER(Command) LIKE '%.txt.js%' OR LOWER(Command) LIKE '%.xls.exe%' OR LOWER(Command) LIKE '%.xls.js%' OR LOWER(Command) LIKE '%.xlsx.exe%' OR LOWER(Command) LIKE '%.xlsx.js%' OR LOWER(Command) LIKE '%⠀⠀⠀⠀⠀⠀.exe%')
