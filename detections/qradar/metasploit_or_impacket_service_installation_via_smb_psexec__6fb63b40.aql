-- Metasploit Or Impacket Service Installation Via SMB PsExec | T1021.002, T1569.002, T1570 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_metasploit_or_impacket_smb_psexec_service_install.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ("Event ID"=4697 AND "Service Filename" MATCHES '^%systemroot%\\[a-zA-Z]{8}\.exe$' AND "Service Name" MATCHES '(^[a-zA-Z]{4}$)|(^[a-zA-Z]{8}$)|(^[a-zA-Z]{16}$)' AND LOWER(UTF8(payload)) LIKE '%servicestarttype%3%' AND LOWER(UTF8(payload)) LIKE '%0x10%') AND (NOT("Service Name"='PSEXESVC'))
