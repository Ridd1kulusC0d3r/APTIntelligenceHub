-- WMI Backdoor Exchange Transport Agent | T1546.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_wmi_backdoor_exchange_transport_agent.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER("Parent Process Path") LIKE '%\edgetransport.exe' AND (NOT((("Process Path"='C:\Windows\System32\conhost.exe' OR "Process Name"='C:\Windows\System32\conhost.exe') OR ((LOWER("Process Path") LIKE 'c:\program files\microsoft\exchange server\%' OR LOWER("Process Name") LIKE 'c:\program files\microsoft\exchange server\%') AND (LOWER("Process Path") LIKE '%\bin\oleconverter.exe' OR LOWER("Process Name") LIKE '%\bin\oleconverter.exe')))))
