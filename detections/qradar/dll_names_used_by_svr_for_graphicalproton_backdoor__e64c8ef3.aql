-- DLL Names Used By SVR For GraphicalProton Backdoor | T1574.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/TA/Cozy-Bear/image_load_apt_cozy_bear_graphical_proton_dlls.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(CONCAT('file directory', '/', filename)) LIKE '%\aclnumsinverthost.dll' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\addressresourcesspec.dll' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\blendmonitorstringbuild.dll' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\childpaletteconnected.dll' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\deregisterseekusers.dll' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\handlefrequencyall.dll' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\hardswapcolor.dll' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\lengthinmemoryactivate.dll' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\modebitmapnumericanimate.dll' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\modefoldersignmove.dll' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\parametersnamespopup.dll' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\performancecaptionapi.dll' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\scrollbarhandleget.dll' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\unregisterancestorappendauto.dll' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\wowicmpremovereg.dll')
