-- Potentially Suspicious Desktop Background Change Using Reg.EXE | T1112, T1491.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_reg_desktop_background_change.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\reg.exe' OR LOWER("Process Name") LIKE '%\reg.exe') OR Filename='reg.exe') AND LOWER(Command) LIKE '%add%') AND (LOWER(Command) LIKE '%control panel\desktop%' OR LOWER(Command) LIKE '%currentversion\policies\activedesktop%' OR LOWER(Command) LIKE '%currentversion\policies\system%') AND ((LOWER(Command) LIKE '%/v nochangingwallpaper%' AND LOWER(Command) LIKE '%/d 1%') OR (LOWER(Command) LIKE '%/v wallpaper%' AND LOWER(Command) LIKE '%/t reg_sz%') OR (LOWER(Command) LIKE '%/v wallpaperstyle%' AND LOWER(Command) LIKE '%/d 2%'))
