-- Signed Binary Loading DLL From User-Writable Path (Side-Loading) | T1574.002 | Hub
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\appdata\%' OR LOWER("Process Path") LIKE '%\programdata\%' OR LOWER("Process Path") LIKE '%\users\public\%') OR (LOWER("Process Name") LIKE '%\appdata\%' OR LOWER("Process Name") LIKE '%\programdata\%' OR LOWER("Process Name") LIKE '%\users\public\%')) AND (LOWER(CONCAT('file directory', '/', filename)) LIKE '%\appdata\%' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\programdata\%' OR LOWER(CONCAT('file directory', '/', filename)) LIKE '%\users\public\%')) AND Signed='false'
