-- Mailbox Export to Exchange Webserver | T1505.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/msexchange/win_exchange_proxyshell_mailbox_export.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (((LOWER(UTF8(payload)) LIKE '%new-mailboxexportrequest%' AND LOWER(UTF8(payload)) LIKE '% -mailbox %') AND (LOWER(UTF8(payload)) LIKE '%-filepath "\%' OR LOWER(UTF8(payload)) LIKE '%.aspx%')) OR (LOWER(UTF8(payload)) LIKE '%new-managementroleassignment%' AND LOWER(UTF8(payload)) LIKE '% -role "mailbox import export"%' AND LOWER(UTF8(payload)) LIKE '% -user %'))
