-- Windows LAPS Credential Dump From Entra ID | T1098.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/azure/audit_logs/azure_auditlogs_laps_credential_dumping.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%device%' AND LOWER(UTF8(payload)) LIKE '%recover device local administrator password%' AND LOWER(UTF8(payload)) LIKE '%successfully recovered local credential by device id%'
