-- Suspicious Cobalt Strike DNS Beaconing - DNS Client | T1071.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/dns_client/win_dns_client_mal_cobaltstrike.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND "Event ID"=3008 AND ((LOWER(UTF8(payload)) LIKE '%aaa.stage.%' OR LOWER(UTF8(payload)) LIKE '%post.1%') OR LOWER(UTF8(payload)) LIKE '%.stage.123456.%')
