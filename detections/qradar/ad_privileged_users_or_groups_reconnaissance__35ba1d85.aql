-- AD Privileged Users or Groups Reconnaissance | T1087.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_account_discovery.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ("Event ID"=4661 AND ("Object Type" IN('SAM_USER', 'SAM_GROUP'))) AND ((LOWER("Object Name") LIKE '%-512' OR LOWER("Object Name") LIKE '%-502' OR LOWER("Object Name") LIKE '%-500' OR LOWER("Object Name") LIKE '%-505' OR LOWER("Object Name") LIKE '%-519' OR LOWER("Object Name") LIKE '%-520' OR LOWER("Object Name") LIKE '%-544' OR LOWER("Object Name") LIKE '%-551' OR LOWER("Object Name") LIKE '%-555') OR LOWER("Object Name") LIKE '%admin%') AND (NOT(LOWER(UTF8(payload)) LIKE '%$%'))
