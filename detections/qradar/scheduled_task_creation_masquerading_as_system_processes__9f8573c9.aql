-- Scheduled Task Creation Masquerading as System Processes | T1036.004, T1036.005, T1053.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_schtasks_system_process.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\schtasks.exe' OR LOWER("Process Name") LIKE '%\schtasks.exe') OR Filename='schtasks.exe') AND ((LOWER(Command) LIKE '% -create %' OR LOWER(Command) LIKE '% /create %' OR LOWER(Command) LIKE '% –create %' OR LOWER(Command) LIKE '% —create %' OR LOWER(Command) LIKE '% ―create %') AND (LOWER(Command) LIKE '% audiodg%' OR LOWER(Command) LIKE '% conhost%' OR LOWER(Command) LIKE '% dwm.exe%' OR LOWER(Command) LIKE '% explorer%' OR LOWER(Command) LIKE '% lsass%' OR LOWER(Command) LIKE '% lsm%' OR LOWER(Command) LIKE '% mmc%' OR LOWER(Command) LIKE '% msiexec%' OR LOWER(Command) LIKE '% regsvr32%' OR LOWER(Command) LIKE '% rundll32%' OR LOWER(Command) LIKE '% services%' OR LOWER(Command) LIKE '% spoolsv%' OR LOWER(Command) LIKE '% svchost%' OR LOWER(Command) LIKE '% taskeng%' OR LOWER(Command) LIKE '% taskhost%' OR LOWER(Command) LIKE '% wininit%' OR LOWER(Command) LIKE '% winlogon%'))
