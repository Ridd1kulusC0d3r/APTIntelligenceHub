-- Cisco Modify Configuration | T1053, T1490, T1505, T1565.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/cisco/aaa/cisco_cli_modify_config.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype IN(6, 143, 273, 274, 20, 23, 26, 30, 31, 419, 41, 429, 431, 179, 435, 437, 182, 183, 56, 316, 448, 194, 90, 94, 95, 113, 114, 115, 116, 117, 248, 250, 508) AND (LOWER(UTF8(payload)) LIKE '%ip http server%' OR LOWER(UTF8(payload)) LIKE '%ip https server%' OR LOWER(UTF8(payload)) LIKE '%kron policy-list%' OR LOWER(UTF8(payload)) LIKE '%kron occurrence%' OR LOWER(UTF8(payload)) LIKE '%policy-list%' OR LOWER(UTF8(payload)) LIKE '%access-list%' OR LOWER(UTF8(payload)) LIKE '%ip access-group%' OR LOWER(UTF8(payload)) LIKE '%archive maximum%' OR LOWER(UTF8(payload)) LIKE '%ntp server%')
