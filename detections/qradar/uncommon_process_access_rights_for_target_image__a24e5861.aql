-- Uncommon Process Access Rights For Target Image | T1055.011 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_access/proc_access_win_susp_all_access_uncommon_target.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Target Process Path") LIKE '%\calc.exe' OR LOWER("Target Process Path") LIKE '%\calculator.exe' OR LOWER("Target Process Path") LIKE '%\mspaint.exe' OR LOWER("Target Process Path") LIKE '%\notepad.exe' OR LOWER("Target Process Path") LIKE '%\ping.exe' OR LOWER("Target Process Path") LIKE '%\wordpad.exe' OR LOWER("Target Process Path") LIKE '%\write.exe') AND "Granted Access"='0x1FFFFF'
