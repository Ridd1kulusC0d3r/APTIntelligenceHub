-- Potential File Extension Spoofing Using Right-to-Left Override | T1036.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_right_to_left_override_extension_spoofing.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Filename) LIKE '%\u202e%' OR LOWER(Filename) LIKE '%[u+202e]%' OR LOWER(Filename) LIKE '%‮%') AND (LOWER(Filename) LIKE '%3pm.%' OR LOWER(Filename) LIKE '%4pm.%' OR LOWER(Filename) LIKE '%cod.%' OR LOWER(Filename) LIKE '%fdp.%' OR LOWER(Filename) LIKE '%ftr.%' OR LOWER(Filename) LIKE '%gepj.%' OR LOWER(Filename) LIKE '%gnp.%' OR LOWER(Filename) LIKE '%gpj.%' OR LOWER(Filename) LIKE '%ism.%' OR LOWER(Filename) LIKE '%lmth.%' OR LOWER(Filename) LIKE '%nls.%' OR LOWER(Filename) LIKE '%piz.%' OR LOWER(Filename) LIKE '%slx.%' OR LOWER(Filename) LIKE '%tdo.%' OR LOWER(Filename) LIKE '%vsc.%' OR LOWER(Filename) LIKE '%vwm.%' OR LOWER(Filename) LIKE '%xcod.%' OR LOWER(Filename) LIKE '%xslx.%' OR LOWER(Filename) LIKE '%xtpp.%')
