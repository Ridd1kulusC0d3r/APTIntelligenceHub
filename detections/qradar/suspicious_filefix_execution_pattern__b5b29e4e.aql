-- Suspicious FileFix Execution Pattern | T1204.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_filefix_execution_pattern.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Parent Process Path") LIKE '%\brave.exe' OR LOWER("Parent Process Path") LIKE '%\chrome.exe' OR LOWER("Parent Process Path") LIKE '%\firefox.exe' OR LOWER("Parent Process Path") LIKE '%\msedge.exe') AND LOWER(Command) LIKE '%#%') AND ((LOWER(Command) LIKE '%%comspec%%' OR LOWER(Command) LIKE '%bitsadmin%' OR LOWER(Command) LIKE '%certutil%' OR LOWER(Command) LIKE '%cmd%' OR LOWER(Command) LIKE '%cscript%' OR LOWER(Command) LIKE '%curl%' OR LOWER(Command) LIKE '%finger%' OR LOWER(Command) LIKE '%mshta%' OR LOWER(Command) LIKE '%powershell%' OR LOWER(Command) LIKE '%pwsh%' OR LOWER(Command) LIKE '%regsvr32%' OR LOWER(Command) LIKE '%rundll32%' OR LOWER(Command) LIKE '%schtasks%' OR LOWER(Command) LIKE '%wget%' OR LOWER(Command) LIKE '%wscript%') OR (LOWER(Command) LIKE '%account%' OR LOWER(Command) LIKE '%anti-bot%' OR LOWER(Command) LIKE '%botcheck%' OR LOWER(Command) LIKE '%captcha%' OR LOWER(Command) LIKE '%challenge%' OR LOWER(Command) LIKE '%confirmation%' OR LOWER(Command) LIKE '%fraud%' OR LOWER(Command) LIKE '%human%' OR LOWER(Command) LIKE '%identification%' OR LOWER(Command) LIKE '%identificator%' OR LOWER(Command) LIKE '%identity%' OR LOWER(Command) LIKE '%robot%' OR LOWER(Command) LIKE '%validation%' OR LOWER(Command) LIKE '%verification%' OR LOWER(Command) LIKE '%verify%'))
