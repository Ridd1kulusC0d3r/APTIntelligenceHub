-- Windows Network Access Suspicious desktop.ini Action | T1547.009 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_net_share_obj_susp_desktop_ini.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND "Event ID"=5145 AND "Object Type"='File' AND LOWER(UTF8(payload)) LIKE '%\desktop.ini%' AND (LOWER("Rule Name") LIKE '%writedata%' OR LOWER("Rule Name") LIKE '%delete%' OR LOWER("Rule Name") LIKE '%writedac%' OR LOWER("Rule Name") LIKE '%appenddata%' OR LOWER("Rule Name") LIKE '%addsubdirectory%')
