-- Mustang Panda Dropper | T1587.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/TA/MustangPanda/proc_creation_win_apt_mustangpanda.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER(Command) LIKE '%temp\wtask.exe /create%' OR LOWER(Command) LIKE '%%windir:~-3,1%%public:~-9,1%%' OR LOWER(Command) LIKE '%/tn "security script %' OR LOWER(Command) LIKE '%%windir:~-1,1%%') OR (LOWER(Command) LIKE '%/e:vbscript%' AND LOWER(Command) LIKE '%c:\users\%' AND LOWER(Command) LIKE '%.txt%' AND LOWER(Command) LIKE '%/f%')) OR (LOWER("Process Path") LIKE '%temp\winwsh.exe' OR LOWER("Process Name") LIKE '%temp\winwsh.exe'))
