-- Potentially Suspicious Execution Of Regasm/Regsvcs From Uncommon Location | T1218.009 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_regasm_regsvcs_uncommon_location_execution.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\regsvcs.exe' OR LOWER("Process Path") LIKE '%\regasm.exe') OR (LOWER("Process Name") LIKE '%\regsvcs.exe' OR LOWER("Process Name") LIKE '%\regasm.exe')) OR (Filename IN('RegSvcs.exe', 'RegAsm.exe'))) AND (LOWER(Command) LIKE '%\appdata\local\temp\%' OR LOWER(Command) LIKE '%\microsoft\windows\start menu\programs\startup\%' OR LOWER(Command) LIKE '%\perflogs\%' OR LOWER(Command) LIKE '%\users\public\%' OR LOWER(Command) LIKE '%\windows\temp\%')
