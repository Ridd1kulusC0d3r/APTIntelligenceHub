-- Potential Registry Persistence Attempt Via Windows Telemetry | T1053.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_telemetry_persistence.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Name") LIKE '%\software\microsoft\windows nt\currentversion\appcompatflags\telemetrycontroller\%' OR LOWER("Target Process Name") LIKE '%\software\microsoft\windows nt\currentversion\appcompatflags\telemetrycontroller\%' OR LOWER("Object Name") LIKE '%\software\microsoft\windows nt\currentversion\appcompatflags\telemetrycontroller\%') AND (LOWER("Process Name") LIKE '%\command' OR LOWER("Target Process Name") LIKE '%\command' OR LOWER("Object Name") LIKE '%\command') AND (LOWER(UTF8(payload)) LIKE '%.bat%' OR LOWER(UTF8(payload)) LIKE '%.bin%' OR LOWER(UTF8(payload)) LIKE '%.cmd%' OR LOWER(UTF8(payload)) LIKE '%.dat%' OR LOWER(UTF8(payload)) LIKE '%.dll%' OR LOWER(UTF8(payload)) LIKE '%.exe%' OR LOWER(UTF8(payload)) LIKE '%.hta%' OR LOWER(UTF8(payload)) LIKE '%.jar%' OR LOWER(UTF8(payload)) LIKE '%.js%' OR LOWER(UTF8(payload)) LIKE '%.msi%' OR LOWER(UTF8(payload)) LIKE '%.ps%' OR LOWER(UTF8(payload)) LIKE '%.sh%' OR LOWER(UTF8(payload)) LIKE '%.vb%')) AND (NOT((LOWER(UTF8(payload)) LIKE '%\system32\compattelrunner.exe%' OR LOWER(UTF8(payload)) LIKE '%\system32\devicecensus.exe%')))
