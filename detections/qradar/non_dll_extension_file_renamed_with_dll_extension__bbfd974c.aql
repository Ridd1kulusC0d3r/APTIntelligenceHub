-- Non-DLL Extension File Renamed With DLL Extension | T1036.008 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/file/file_rename/file_rename_win_non_dll_to_dll_ext.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER(Filename) LIKE '%.dll' AND (NOT((LOWER(filename) LIKE '%.dll' OR LOWER(filename) LIKE '%.tmp' OR filename='' OR filename IS NULL OR ((LOWER("Process Path") LIKE '%:\windows\winsxs\%' OR LOWER("Process Name") LIKE '%:\windows\winsxs\%') AND (LOWER("Process Path") LIKE '%\tiworker.exe' OR LOWER("Process Name") LIKE '%\tiworker.exe')) OR ((LOWER("Process Path") LIKE '%:\windows\system32\wuauclt.exe' OR LOWER("Process Name") LIKE '%:\windows\system32\wuauclt.exe') OR LOWER(Filename) LIKE '%:\$windows.~bt\sources\%') OR ((LOWER("Process Path") LIKE '%:\program files (x86)\%' OR LOWER("Process Path") LIKE '%:\program files\%') OR (LOWER("Process Name") LIKE '%:\program files (x86)\%' OR LOWER("Process Name") LIKE '%:\program files\%'))))) AND (NOT(LOWER(filename) LIKE '%\squirreltemp\temp%'))
