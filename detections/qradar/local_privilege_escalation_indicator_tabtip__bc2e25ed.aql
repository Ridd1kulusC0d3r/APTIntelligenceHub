-- Local Privilege Escalation Indicator TabTip | T1557.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/microsoft_windows_distributed_com/win_system_lpe_indicators_tabtip.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND LOWER(UTF8(payload)) LIKE '%microsoft-windows-distributedcom%' AND "Event ID"=10001 AND LOWER(UTF8(payload)) LIKE '%c:\program files\common files\microsoft shared\ink\tabtip.exe%' AND LOWER(UTF8(payload)) LIKE '%param2%2147943140%' AND LOWER(UTF8(payload)) LIKE '%{054aae20-4bea-4347-8a35-64a533254a9d}%'
