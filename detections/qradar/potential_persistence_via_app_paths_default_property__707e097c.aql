-- Potential Persistence Via App Paths Default Property | T1546.012 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_persistence_app_paths.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\software\microsoft\windows\currentversion\app paths%' OR LOWER("Target Process Name") LIKE '%\software\microsoft\windows\currentversion\app paths%' OR LOWER("Object Name") LIKE '%\software\microsoft\windows\currentversion\app paths%') AND ((LOWER("Process Name") LIKE '%(default)' OR LOWER("Process Name") LIKE '%path') OR (LOWER("Target Process Name") LIKE '%(default)' OR LOWER("Target Process Name") LIKE '%path') OR (LOWER("Object Name") LIKE '%(default)' OR LOWER("Object Name") LIKE '%path')) AND (LOWER(UTF8(payload)) LIKE '%\users\public%' OR LOWER(UTF8(payload)) LIKE '%\appdata\local\temp\%' OR LOWER(UTF8(payload)) LIKE '%\windows\temp\%' OR LOWER(UTF8(payload)) LIKE '%\desktop\%' OR LOWER(UTF8(payload)) LIKE '%\downloads\%' OR LOWER(UTF8(payload)) LIKE '%%temp%%' OR LOWER(UTF8(payload)) LIKE '%%tmp%%' OR LOWER(UTF8(payload)) LIKE '%iex%' OR LOWER(UTF8(payload)) LIKE '%invoke-%' OR LOWER(UTF8(payload)) LIKE '%rundll32%' OR LOWER(UTF8(payload)) LIKE '%regsvr32%' OR LOWER(UTF8(payload)) LIKE '%mshta%' OR LOWER(UTF8(payload)) LIKE '%cscript%' OR LOWER(UTF8(payload)) LIKE '%wscript%' OR LOWER(UTF8(payload)) LIKE '%.bat%' OR LOWER(UTF8(payload)) LIKE '%.hta%' OR LOWER(UTF8(payload)) LIKE '%.dll%' OR LOWER(UTF8(payload)) LIKE '%.ps1%')
