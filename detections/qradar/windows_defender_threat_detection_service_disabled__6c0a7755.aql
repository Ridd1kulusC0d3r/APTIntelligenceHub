-- Windows Defender Threat Detection Service Disabled | T1685 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/service_control_manager/win_system_defender_disabled.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND "Event ID"=7036 AND LOWER(UTF8(payload)) LIKE '%service control manager%' AND (LOWER(UTF8(payload)) LIKE '%windows defender antivirus service%' OR LOWER(UTF8(payload)) LIKE '%service antivirus microsoft defender%') AND (LOWER(UTF8(payload)) LIKE '%stopped%' OR LOWER(UTF8(payload)) LIKE '%arrêté%')
