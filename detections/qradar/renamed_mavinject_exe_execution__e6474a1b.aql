-- Renamed Mavinject.EXE Execution | T1055.001, T1218.013 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_renamed_mavinject.yml
SELECT * FROM events WHERE devicetype=12 AND (Filename IN('mavinject32.exe', 'mavinject64.exe')) AND (NOT(((LOWER("Process Path") LIKE '%\mavinject32.exe' OR LOWER("Process Path") LIKE '%\mavinject64.exe') OR (LOWER("Process Name") LIKE '%\mavinject32.exe' OR LOWER("Process Name") LIKE '%\mavinject64.exe'))))
