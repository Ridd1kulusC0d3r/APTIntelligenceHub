-- Remote Registry Lateral Movement | T1112 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/rpc_firewall/rpc_firewall_remote_registry_lateral_movement.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%rpcfw%' AND "Event ID"=3 AND "Source Interface UUID"='338cd001-2244-31f1-aaaa-900038001003' AND (LOWER(UTF8(payload)) LIKE '%opnum%6%' OR LOWER(UTF8(payload)) LIKE '%opnum%7%' OR LOWER(UTF8(payload)) LIKE '%opnum%8%' OR LOWER(UTF8(payload)) LIKE '%opnum%13%' OR LOWER(UTF8(payload)) LIKE '%opnum%18%' OR LOWER(UTF8(payload)) LIKE '%opnum%19%' OR LOWER(UTF8(payload)) LIKE '%opnum%21%' OR LOWER(UTF8(payload)) LIKE '%opnum%22%' OR LOWER(UTF8(payload)) LIKE '%opnum%23%' OR LOWER(UTF8(payload)) LIKE '%opnum%35%')
