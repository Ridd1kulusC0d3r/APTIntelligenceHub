-- Sysmon Discovery Via Default Driver Altitude Using Findstr.EXE | T1518.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_findstr_sysmon_discovery_via_default_altitude.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\find.exe' OR LOWER("Process Path") LIKE '%\findstr.exe') OR (LOWER("Process Name") LIKE '%\find.exe' OR LOWER("Process Name") LIKE '%\findstr.exe')) OR (Filename IN('FIND.EXE', 'FINDSTR.EXE'))) AND LOWER(Command) LIKE '% 385201%'
