-- GALLIUM Artefacts - Builtin | T1071 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2020/TA/GALLIUM/win_dns_analytic_apt_gallium.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND "Event ID"=257 AND (LOWER(UTF8(payload)) LIKE '%asyspy256.ddns.net%' OR LOWER(UTF8(payload)) LIKE '%hotkillmail9sddcc.ddns.net%' OR LOWER(UTF8(payload)) LIKE '%rosaf112.ddns.net%' OR LOWER(UTF8(payload)) LIKE '%cvdfhjh1231.myftp.biz%' OR LOWER(UTF8(payload)) LIKE '%sz2016rose.ddns.net%' OR LOWER(UTF8(payload)) LIKE '%dffwescwer4325.myftp.biz%' OR LOWER(UTF8(payload)) LIKE '%cvdfhjh1231.ddns.net%')
