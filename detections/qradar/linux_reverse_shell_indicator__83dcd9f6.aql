-- Linux Reverse Shell Indicator | T1059.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/network_connection/net_connection_lnx_back_connect_shell_dev.yml
SELECT * FROM events WHERE devicetype=11 AND (LOWER("Process Path") LIKE '%/bin/bash' OR LOWER("Process Name") LIKE '%/bin/bash') AND (NOT((destinationip IN('127.0.0.1', '0.0.0.0'))))
