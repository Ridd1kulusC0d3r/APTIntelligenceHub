-- Encoded PowerShell Spawned By Script Host | T1059.001, T1059.007 | Hub
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Parent Process Path") LIKE '%\wscript.exe' OR LOWER("Parent Process Path") LIKE '%\cscript.exe' OR LOWER("Parent Process Path") LIKE '%\mshta.exe') AND ((LOWER("Process Path") LIKE '%\powershell.exe' OR LOWER("Process Name") LIKE '%\powershell.exe') AND (LOWER(Command) LIKE '% -enc%' OR LOWER(Command) LIKE '% -encodedcommand%' OR LOWER(Command) LIKE '% -e %'))
