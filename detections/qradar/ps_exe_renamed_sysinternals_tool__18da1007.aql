-- Ps.exe Renamed SysInternals Tool | T1036.003 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2017/TA/Dragonfly/proc_creation_win_apt_ta17_293a_ps.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER(Command) LIKE '%ps.exe -accepteula%' AND LOWER(Command) LIKE '%-s cmd /c netstat%'
