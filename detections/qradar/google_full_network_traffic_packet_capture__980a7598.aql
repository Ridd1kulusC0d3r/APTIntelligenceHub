-- Google Full Network Traffic Packet Capture | T1074 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/gcp/audit/gcp_full_network_traffic_packet_capture.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype IN(449, 442, 461, 455) AND (LOWER(UTF8(payload)) LIKE '%v%.compute.packetmirrorings.get%' OR LOWER(UTF8(payload)) LIKE '%v%.compute.packetmirrorings.delete%' OR LOWER(UTF8(payload)) LIKE '%v%.compute.packetmirrorings.insert%' OR LOWER(UTF8(payload)) LIKE '%v%.compute.packetmirrorings.patch%' OR LOWER(UTF8(payload)) LIKE '%v%.compute.packetmirrorings.list%' OR LOWER(UTF8(payload)) LIKE '%v%.compute.packetmirrorings.aggregatedlist%')
