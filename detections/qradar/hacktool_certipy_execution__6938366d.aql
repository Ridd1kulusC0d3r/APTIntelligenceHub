-- HackTool - Certipy Execution | T1649 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_certipy.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\certipy.exe' OR LOWER("Process Name") LIKE '%\certipy.exe') OR Filename='Certipy.exe' OR LOWER(UTF8(payload)) LIKE '%certipy%') OR ((LOWER(Command) LIKE '% account %' OR LOWER(Command) LIKE '% auth %' OR LOWER(Command) LIKE '% cert %' OR LOWER(Command) LIKE '% find %' OR LOWER(Command) LIKE '% forge %' OR LOWER(Command) LIKE '% ptt %' OR LOWER(Command) LIKE '% relay %' OR LOWER(Command) LIKE '% req %' OR LOWER(Command) LIKE '% shadow %' OR LOWER(Command) LIKE '% template %') AND (LOWER(Command) LIKE '% -bloodhound%' OR LOWER(Command) LIKE '% -ca-pfx %' OR LOWER(Command) LIKE '% -dc-ip %' OR LOWER(Command) LIKE '% -kirbi%' OR LOWER(Command) LIKE '% -old-bloodhound%' OR LOWER(Command) LIKE '% -pfx %' OR LOWER(Command) LIKE '% -target%' OR LOWER(Command) LIKE '% -template%' OR LOWER(Command) LIKE '% -username %' OR LOWER(Command) LIKE '% -vulnerable%' OR LOWER(Command) LIKE '%auth -pfx%' OR LOWER(Command) LIKE '%shadow auto%' OR LOWER(Command) LIKE '%shadow list%')))
