-- LSA PPL Protection Setting Modification via CommandLine | T1689 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_lsa_ppl_protection_setting_modification_via_cli.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\reg.exe' OR LOWER("Process Path") LIKE '%\powershell.exe' OR LOWER("Process Path") LIKE '%\pwsh.exe') OR (LOWER("Process Name") LIKE '%\reg.exe' OR LOWER("Process Name") LIKE '%\powershell.exe' OR LOWER("Process Name") LIKE '%\pwsh.exe')) OR (Filename IN('reg.exe', 'powershell.exe', 'pwsh.dll'))) AND ((LOWER(Command) LIKE '%controlset%' AND LOWER(Command) LIKE '%\control\lsa%') AND (LOWER(Command) LIKE '%set-itemproperty%' OR LOWER(Command) LIKE '%new-itemproperty%' OR LOWER(Command) LIKE '% add %')) AND (LOWER(Command) LIKE '%ispplautoenabled%' OR LOWER(Command) LIKE '%runasppl%' OR LOWER(Command) LIKE '%runaspplboot%')
