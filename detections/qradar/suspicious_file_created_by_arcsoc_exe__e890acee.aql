-- Suspicious File Created by ArcSOC.exe | T1105, T1127, T1133 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_arcsoc_susp_file_created.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Path") LIKE '%\arcsoc.exe' OR LOWER("Process Name") LIKE '%\arcsoc.exe') AND (LOWER(Filename) LIKE '%.ahk' OR LOWER(Filename) LIKE '%.aspx' OR LOWER(Filename) LIKE '%.au3' OR LOWER(Filename) LIKE '%.bat' OR LOWER(Filename) LIKE '%.cmd' OR LOWER(Filename) LIKE '%.dll' OR LOWER(Filename) LIKE '%.exe' OR LOWER(Filename) LIKE '%.hta' OR LOWER(Filename) LIKE '%.js' OR LOWER(Filename) LIKE '%.ps1' OR LOWER(Filename) LIKE '%.py' OR LOWER(Filename) LIKE '%.vbe' OR LOWER(Filename) LIKE '%.vbs' OR LOWER(Filename) LIKE '%.wsf')
