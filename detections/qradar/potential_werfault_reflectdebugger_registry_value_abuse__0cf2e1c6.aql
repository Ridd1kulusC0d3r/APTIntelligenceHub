-- Potential WerFault ReflectDebugger Registry Value Abuse | T1036.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_persistence_reflectdebugger.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\microsoft\windows\windows error reporting\hangs\reflectdebugger' OR LOWER("Target Process Name") LIKE '%\microsoft\windows\windows error reporting\hangs\reflectdebugger' OR LOWER("Object Name") LIKE '%\microsoft\windows\windows error reporting\hangs\reflectdebugger')
