-- HackTool - PPID Spoofing SelectMyParent Tool Execution | T1134.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_selectmyparent.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\selectmyparent.exe' OR LOWER("Process Name") LIKE '%\selectmyparent.exe') OR (LOWER(Command) LIKE '%ppid-spoof%' OR LOWER(Command) LIKE '%ppid_spoof%' OR LOWER(Command) LIKE '%spoof-ppid%' OR LOWER(Command) LIKE '%spoof_ppid%' OR LOWER(Command) LIKE '%ppidspoof%' OR LOWER(Command) LIKE '%spoofppid%' OR LOWER(Command) LIKE '%spoofedppid%' OR LOWER(Command) LIKE '% -spawnto %') OR (LOWER(Filename) LIKE '%ppid-spoof%' OR LOWER(Filename) LIKE '%ppid_spoof%' OR LOWER(Filename) LIKE '%spoof-ppid%' OR LOWER(Filename) LIKE '%spoof_ppid%' OR LOWER(Filename) LIKE '%ppidspoof%' OR LOWER(Filename) LIKE '%spoofppid%' OR LOWER(Filename) LIKE '%spoofedppid%') OR LOWER(UTF8(payload)) LIKE '%selectmyparent%' OR (LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=04d974875bd225f00902b4cad9af3fbc%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=a782af154c9e743ddf3f3eb2b8f3d16e%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=89059503d7fbf470e68f7e63313da3ad%' OR LOWER(CONCAT('MD5=', 'MD5 Hash ', 'SHA1=', 'SHA1 Hash ', 'SHA256=', 'SHA256 Hash ', 'IMPHASH=', 'IMP HASH')) LIKE '%imphash=ca28337632625c8281ab8a130b3d6bad%'))
