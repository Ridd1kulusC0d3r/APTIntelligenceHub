-- Monero Crypto Coin Mining Pool Lookup | T1496, T1567 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/dns/net_dns_pua_cryptocoin_mining_xmr.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%pool.minexmr.com%' OR LOWER(UTF8(payload)) LIKE '%fr.minexmr.com%' OR LOWER(UTF8(payload)) LIKE '%de.minexmr.com%' OR LOWER(UTF8(payload)) LIKE '%sg.minexmr.com%' OR LOWER(UTF8(payload)) LIKE '%ca.minexmr.com%' OR LOWER(UTF8(payload)) LIKE '%us-west.minexmr.com%' OR LOWER(UTF8(payload)) LIKE '%pool.supportxmr.com%' OR LOWER(UTF8(payload)) LIKE '%mine.c3pool.com%' OR LOWER(UTF8(payload)) LIKE '%xmr-eu1.nanopool.org%' OR LOWER(UTF8(payload)) LIKE '%xmr-eu2.nanopool.org%' OR LOWER(UTF8(payload)) LIKE '%xmr-us-east1.nanopool.org%' OR LOWER(UTF8(payload)) LIKE '%xmr-us-west1.nanopool.org%' OR LOWER(UTF8(payload)) LIKE '%xmr-asia1.nanopool.org%' OR LOWER(UTF8(payload)) LIKE '%xmr-jp1.nanopool.org%' OR LOWER(UTF8(payload)) LIKE '%xmr-au1.nanopool.org%' OR LOWER(UTF8(payload)) LIKE '%xmr.2miners.com%' OR LOWER(UTF8(payload)) LIKE '%xmr.hashcity.org%' OR LOWER(UTF8(payload)) LIKE '%xmr.f2pool.com%' OR LOWER(UTF8(payload)) LIKE '%xmrpool.eu%' OR LOWER(UTF8(payload)) LIKE '%pool.hashvault.pro%'
