-- Suspicious Execution Of Renamed Sysinternals Tools - Registry | T1588.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_pua_sysinternals_renamed_execution_via_eula.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Name") LIKE '%\active directory explorer%' OR LOWER("Process Name") LIKE '%\handle%' OR LOWER("Process Name") LIKE '%\livekd%' OR LOWER("Process Name") LIKE '%\procdump%' OR LOWER("Process Name") LIKE '%\process explorer%' OR LOWER("Process Name") LIKE '%\psexec%' OR LOWER("Process Name") LIKE '%\psloggedon%' OR LOWER("Process Name") LIKE '%\psloglist%' OR LOWER("Process Name") LIKE '%\pspasswd%' OR LOWER("Process Name") LIKE '%\psping%' OR LOWER("Process Name") LIKE '%\psservice%' OR LOWER("Process Name") LIKE '%\sdelete%') OR (LOWER("Target Process Name") LIKE '%\active directory explorer%' OR LOWER("Target Process Name") LIKE '%\handle%' OR LOWER("Target Process Name") LIKE '%\livekd%' OR LOWER("Target Process Name") LIKE '%\procdump%' OR LOWER("Target Process Name") LIKE '%\process explorer%' OR LOWER("Target Process Name") LIKE '%\psexec%' OR LOWER("Target Process Name") LIKE '%\psloggedon%' OR LOWER("Target Process Name") LIKE '%\psloglist%' OR LOWER("Target Process Name") LIKE '%\pspasswd%' OR LOWER("Target Process Name") LIKE '%\psping%' OR LOWER("Target Process Name") LIKE '%\psservice%' OR LOWER("Target Process Name") LIKE '%\sdelete%') OR (LOWER("Object Name") LIKE '%\active directory explorer%' OR LOWER("Object Name") LIKE '%\handle%' OR LOWER("Object Name") LIKE '%\livekd%' OR LOWER("Object Name") LIKE '%\procdump%' OR LOWER("Object Name") LIKE '%\process explorer%' OR LOWER("Object Name") LIKE '%\psexec%' OR LOWER("Object Name") LIKE '%\psloggedon%' OR LOWER("Object Name") LIKE '%\psloglist%' OR LOWER("Object Name") LIKE '%\pspasswd%' OR LOWER("Object Name") LIKE '%\psping%' OR LOWER("Object Name") LIKE '%\psservice%' OR LOWER("Object Name") LIKE '%\sdelete%')) AND (LOWER("Process Name") LIKE '%\eulaaccepted' OR LOWER("Target Process Name") LIKE '%\eulaaccepted' OR LOWER("Object Name") LIKE '%\eulaaccepted')) AND (NOT(((LOWER("Process Path") LIKE '%\adexplorer.exe' OR LOWER("Process Path") LIKE '%\adexplorer64.exe' OR LOWER("Process Path") LIKE '%\adexplorer64a.exe' OR LOWER("Process Path") LIKE '%\handle.exe' OR LOWER("Process Path") LIKE '%\handle64.exe' OR LOWER("Process Path") LIKE '%\handle64a.exe' OR LOWER("Process Path") LIKE '%\livekd.exe' OR LOWER("Process Path") LIKE '%\livekd64.exe' OR LOWER("Process Path") LIKE '%\procdump.exe' OR LOWER("Process Path") LIKE '%\procdump64.exe' OR LOWER("Process Path") LIKE '%\procdump64a.exe' OR LOWER("Process Path") LIKE '%\procexp.exe' OR LOWER("Process Path") LIKE '%\procexp64.exe' OR LOWER("Process Path") LIKE '%\procexp64a.exe' OR LOWER("Process Path") LIKE '%\psexec.exe' OR LOWER("Process Path") LIKE '%\psexec64.exe' OR LOWER("Process Path") LIKE '%\psexec64a.exe' OR LOWER("Process Path") LIKE '%\psloggedon.exe' OR LOWER("Process Path") LIKE '%\psloggedon64.exe' OR LOWER("Process Path") LIKE '%\psloglist.exe' OR LOWER("Process Path") LIKE '%\psloglist64.exe' OR LOWER("Process Path") LIKE '%\psloglist64a.exe' OR LOWER("Process Path") LIKE '%\pspasswd.exe' OR LOWER("Process Path") LIKE '%\pspasswd64.exe' OR LOWER("Process Path") LIKE '%\pspasswd64a.exe' OR LOWER("Process Path") LIKE '%\psping.exe' OR LOWER("Process Path") LIKE '%\psping64.exe' OR LOWER("Process Path") LIKE '%\psping64a.exe' OR LOWER("Process Path") LIKE '%\psservice.exe' OR LOWER("Process Path") LIKE '%\psservice64.exe' OR LOWER("Process Path") LIKE '%\psservice64a.exe' OR LOWER("Process Path") LIKE '%\sdelete.exe') OR (LOWER("Process Name") LIKE '%\adexplorer.exe' OR LOWER("Process Name") LIKE '%\adexplorer64.exe' OR LOWER("Process Name") LIKE '%\adexplorer64a.exe' OR LOWER("Process Name") LIKE '%\handle.exe' OR LOWER("Process Name") LIKE '%\handle64.exe' OR LOWER("Process Name") LIKE '%\handle64a.exe' OR LOWER("Process Name") LIKE '%\livekd.exe' OR LOWER("Process Name") LIKE '%\livekd64.exe' OR LOWER("Process Name") LIKE '%\procdump.exe' OR LOWER("Process Name") LIKE '%\procdump64.exe' OR LOWER("Process Name") LIKE '%\procdump64a.exe' OR LOWER("Process Name") LIKE '%\procexp.exe' OR LOWER("Process Name") LIKE '%\procexp64.exe' OR LOWER("Process Name") LIKE '%\procexp64a.exe' OR LOWER("Process Name") LIKE '%\psexec.exe' OR LOWER("Process Name") LIKE '%\psexec64.exe' OR LOWER("Process Name") LIKE '%\psexec64a.exe' OR LOWER("Process Name") LIKE '%\psloggedon.exe' OR LOWER("Process Name") LIKE '%\psloggedon64.exe' OR LOWER("Process Name") LIKE '%\psloglist.exe' OR LOWER("Process Name") LIKE '%\psloglist64.exe' OR LOWER("Process Name") LIKE '%\psloglist64a.exe' OR LOWER("Process Name") LIKE '%\pspasswd.exe' OR LOWER("Process Name") LIKE '%\pspasswd64.exe' OR LOWER("Process Name") LIKE '%\pspasswd64a.exe' OR LOWER("Process Name") LIKE '%\psping.exe' OR LOWER("Process Name") LIKE '%\psping64.exe' OR LOWER("Process Name") LIKE '%\psping64a.exe' OR LOWER("Process Name") LIKE '%\psservice.exe' OR LOWER("Process Name") LIKE '%\psservice64.exe' OR LOWER("Process Name") LIKE '%\psservice64a.exe' OR LOWER("Process Name") LIKE '%\sdelete.exe'))))
