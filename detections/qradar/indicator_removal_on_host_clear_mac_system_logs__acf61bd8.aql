-- Indicator Removal on Host - Clear Mac System Logs | T1685.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_clear_system_logs.yml
SELECT * FROM events WHERE devicetype=102 AND ((LOWER("Process Path") LIKE '%/rm' OR LOWER("Process Path") LIKE '%/unlink' OR LOWER("Process Path") LIKE '%/shred') OR (LOWER("Process Name") LIKE '%/rm' OR LOWER("Process Name") LIKE '%/unlink' OR LOWER("Process Name") LIKE '%/shred')) AND (LOWER(Command) LIKE '%/var/log%' OR (LOWER(Command) LIKE '%/users/%' AND LOWER(Command) LIKE '%/library/logs/%'))
