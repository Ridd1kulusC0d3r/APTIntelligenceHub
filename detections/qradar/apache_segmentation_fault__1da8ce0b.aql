-- Apache Segmentation Fault | T1499.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/web/product/apache/web_apache_segfault.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=10 AND LOWER(UTF8(payload)) LIKE '%exit signal segmentation fault%'
