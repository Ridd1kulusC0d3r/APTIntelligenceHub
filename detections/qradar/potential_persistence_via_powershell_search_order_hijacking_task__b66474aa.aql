-- Potential Persistence Via Powershell Search Order Hijacking - Task | T1053.005, T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_schtasks_powershell_persistence.yml
SELECT * FROM events WHERE devicetype=12 AND "Parent Process Path"='C:\WINDOWS\System32\svchost.exe' AND (LOWER("Parent Command") LIKE '%-k netsvcs%' AND LOWER("Parent Command") LIKE '%-s schedule%') AND (LOWER(Command) LIKE '% -windowstyle hidden' OR LOWER(Command) LIKE '% -w hidden' OR LOWER(Command) LIKE '% -ep bypass' OR LOWER(Command) LIKE '% -noni')
