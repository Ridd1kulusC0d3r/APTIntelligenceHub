-- Delete Important Scheduled Task | T1489 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_schtasks_delete.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\schtasks.exe' OR LOWER("Process Name") LIKE '%\schtasks.exe') OR Filename='schtasks.exe') AND (LOWER(Command) LIKE '%-delete%' OR LOWER(Command) LIKE '%/delete%' OR LOWER(Command) LIKE '%–delete%' OR LOWER(Command) LIKE '%—delete%' OR LOWER(Command) LIKE '%―delete%') AND (LOWER(Command) LIKE '%\windows\bitlocker%' OR LOWER(Command) LIKE '%\windows\exploitguard%' OR LOWER(Command) LIKE '%\windows\systemrestore\sr%' OR LOWER(Command) LIKE '%\windows\updateorchestrator\%' OR LOWER(Command) LIKE '%\windows\windows defender\%' OR LOWER(Command) LIKE '%\windows\windowsbackup\%' OR LOWER(Command) LIKE '%\windows\windowsupdate\%')
