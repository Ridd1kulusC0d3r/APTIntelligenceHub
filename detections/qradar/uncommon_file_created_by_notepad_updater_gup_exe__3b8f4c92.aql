-- Uncommon File Created by Notepad++ Updater Gup.EXE | T1195.002, T1557 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_gup_uncommon_file_creation.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Path") LIKE '%\gup.exe' OR LOWER("Process Name") LIKE '%\gup.exe') AND (NOT(((LOWER(Filename) LIKE 'c:\program files\notepad++\%' OR LOWER(Filename) LIKE 'c:\program files (x86)\notepad++\%') OR (LOWER(Filename) LIKE 'c:\users\%' AND (LOWER(Filename) LIKE '%\appdata\local\temp\%' AND LOWER(Filename) LIKE '%npp.%' AND LOWER(Filename) LIKE '%.installer.%' AND LOWER(Filename) LIKE '%.exe%')) OR (LOWER(Filename) LIKE 'c:\users\%' AND (LOWER(Filename) LIKE '%\appdata\local\temp\%' AND LOWER(Filename) LIKE '%.zip%')) OR LOWER(Filename) LIKE 'c:\$recycle.bin\s-1-5-21%' OR ((LOWER(Filename) LIKE '%\plugins\jsontools\testfiles\%' OR LOWER(Filename) LIKE '%\notepad++\plugins\compareplugin\%') OR (LOWER(Filename) LIKE '%npp.%' AND LOWER(Filename) LIKE '%.portable.%' AND LOWER(Filename) LIKE '%\plugins\%')))))
