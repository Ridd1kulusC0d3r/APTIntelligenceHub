-- Kubernetes Admission Controller Modification | T1078, T1552, T1552.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/kubernetes/audit/kubernetes_audit_change_admission_controller.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%admissionregistration.k8s.io%' AND (LOWER(UTF8(payload)) LIKE '%mutatingwebhookconfigurations%' OR LOWER(UTF8(payload)) LIKE '%validatingwebhookconfigurations%') AND (LOWER(UTF8(payload)) LIKE '%create%' OR LOWER(UTF8(payload)) LIKE '%delete%' OR LOWER(UTF8(payload)) LIKE '%patch%' OR LOWER(UTF8(payload)) LIKE '%replace%' OR LOWER(UTF8(payload)) LIKE '%update%')
