-- Mimikatz Use | T1003.001, T1003.002, T1003.004, T1003.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/win_alert_mimikatz_keywords.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER(UTF8(payload)) LIKE '%dpapi::masterkey%' OR LOWER(UTF8(payload)) LIKE '%eo.oe.kiwi%' OR LOWER(UTF8(payload)) LIKE '%event::clear%' OR LOWER(UTF8(payload)) LIKE '%event::drop%' OR LOWER(UTF8(payload)) LIKE '%gentilkiwi.com%' OR LOWER(UTF8(payload)) LIKE '%kerberos::golden%' OR LOWER(UTF8(payload)) LIKE '%kerberos::ptc%' OR LOWER(UTF8(payload)) LIKE '%kerberos::ptt%' OR LOWER(UTF8(payload)) LIKE '%kerberos::tgt%' OR LOWER(UTF8(payload)) LIKE '%kiwi legit printer%' OR LOWER(UTF8(payload)) LIKE '%lsadump::%' OR LOWER(UTF8(payload)) LIKE '%mimidrv.sys%' OR LOWER(UTF8(payload)) LIKE '%\mimilib.dll%' OR LOWER(UTF8(payload)) LIKE '%misc::printnightmare%' OR LOWER(UTF8(payload)) LIKE '%misc::shadowcopies%' OR LOWER(UTF8(payload)) LIKE '%misc::skeleton%' OR LOWER(UTF8(payload)) LIKE '%privilege::backup%' OR LOWER(UTF8(payload)) LIKE '%privilege::debug%' OR LOWER(UTF8(payload)) LIKE '%privilege::driver%' OR LOWER(UTF8(payload)) LIKE '%sekurlsa::%') AND (NOT("Event ID"=15))
