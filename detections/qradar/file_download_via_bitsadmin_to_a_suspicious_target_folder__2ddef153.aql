-- File Download Via Bitsadmin To A Suspicious Target Folder | T1036.003, T1105, T1197 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_bitsadmin_download_susp_targetfolder.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\bitsadmin.exe' OR LOWER("Process Name") LIKE '%\bitsadmin.exe') OR Filename='bitsadmin.exe') AND (LOWER(Command) LIKE '% /transfer %' OR LOWER(Command) LIKE '% /create %' OR LOWER(Command) LIKE '% /addfile %') AND (LOWER(Command) LIKE '%:\perflogs%' OR LOWER(Command) LIKE '%:\programdata\%' OR LOWER(Command) LIKE '%:\temp\%' OR LOWER(Command) LIKE '%:\users\public\%' OR LOWER(Command) LIKE '%:\windows\%' OR LOWER(Command) LIKE '%\$recycle.bin\%' OR LOWER(Command) LIKE '%\appdata\local\%' OR LOWER(Command) LIKE '%\appdata\roaming\%' OR LOWER(Command) LIKE '%\contacts\%' OR LOWER(Command) LIKE '%\desktop\%' OR LOWER(Command) LIKE '%\favorites\%' OR LOWER(Command) LIKE '%\favourites\%' OR LOWER(Command) LIKE '%\inetpub\wwwroot\%' OR LOWER(Command) LIKE '%\music\%' OR LOWER(Command) LIKE '%\pictures\%' OR LOWER(Command) LIKE '%\start menu\programs\startup\%' OR LOWER(Command) LIKE '%\users\default\%' OR LOWER(Command) LIKE '%\videos\%' OR LOWER(Command) LIKE '%%programdata%%' OR LOWER(Command) LIKE '%%public%%' OR LOWER(Command) LIKE '%%temp%%' OR LOWER(Command) LIKE '%%tmp%%')
