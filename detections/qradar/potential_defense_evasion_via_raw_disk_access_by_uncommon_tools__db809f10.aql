-- Potential Defense Evasion Via Raw Disk Access By Uncommon Tools | T1006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/raw_access_thread/raw_access_thread_susp_disk_access_using_uncommon_tools.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (NOT((LOWER(UTF8(payload)) LIKE '%floppy%' OR ((LOWER("Process Path") LIKE 'c:\$windows.~bt\%' OR LOWER("Process Path") LIKE 'c:\program files (x86)\%' OR LOWER("Process Path") LIKE 'c:\program files\%' OR LOWER("Process Path") LIKE 'c:\windows\ccm\%' OR LOWER("Process Path") LIKE 'c:\windows\explorer.exe%' OR LOWER("Process Path") LIKE 'c:\windows\servicing\%' OR LOWER("Process Path") LIKE 'c:\windows\softwaredistribution\%' OR LOWER("Process Path") LIKE 'c:\windows\system32\%' OR LOWER("Process Path") LIKE 'c:\windows\systemapps\%' OR LOWER("Process Path") LIKE 'c:\windows\syswow64\%' OR LOWER("Process Path") LIKE 'c:\windows\uus\%' OR LOWER("Process Path") LIKE 'c:\windows\winsxs\%') OR (LOWER("Process Name") LIKE 'c:\$windows.~bt\%' OR LOWER("Process Name") LIKE 'c:\program files (x86)\%' OR LOWER("Process Name") LIKE 'c:\program files\%' OR LOWER("Process Name") LIKE 'c:\windows\ccm\%' OR LOWER("Process Name") LIKE 'c:\windows\explorer.exe%' OR LOWER("Process Name") LIKE 'c:\windows\servicing\%' OR LOWER("Process Name") LIKE 'c:\windows\softwaredistribution\%' OR LOWER("Process Name") LIKE 'c:\windows\system32\%' OR LOWER("Process Name") LIKE 'c:\windows\systemapps\%' OR LOWER("Process Name") LIKE 'c:\windows\syswow64\%' OR LOWER("Process Name") LIKE 'c:\windows\uus\%' OR LOWER("Process Name") LIKE 'c:\windows\winsxs\%')) OR (("Process Path" IN('Registry', 'System')) OR ("Process Name" IN('Registry', 'System'))) OR ((LOWER("Process Path") LIKE 'c:\programdata\microsoft\windows defender\platform\%' OR LOWER("Process Name") LIKE 'c:\programdata\microsoft\windows defender\platform\%') AND ((LOWER("Process Path") LIKE '%\msmpeng.exe' OR LOWER("Process Path") LIKE '%\mpdefendercoreservice.exe') OR (LOWER("Process Name") LIKE '%\msmpeng.exe' OR LOWER("Process Name") LIKE '%\mpdefendercoreservice.exe'))) OR ((LOWER("Process Path") LIKE 'c:\users\%' OR LOWER("Process Name") LIKE 'c:\users\%') AND ((LOWER("Process Path") LIKE '%\appdata\%' AND LOWER("Process Path") LIKE '%\microsoft\%') OR (LOWER("Process Name") LIKE '%\appdata\%' AND LOWER("Process Name") LIKE '%\microsoft\%'))) OR ((LOWER("Process Path") LIKE 'c:\windows\temp\%' OR LOWER("Process Name") LIKE 'c:\windows\temp\%') AND ((LOWER("Process Path") LIKE '%\executables\ssdupdate.exe' OR LOWER("Process Path") LIKE '%\hostmetadata\nvmehostmetadata.exe') OR (LOWER("Process Name") LIKE '%\executables\ssdupdate.exe' OR LOWER("Process Name") LIKE '%\hostmetadata\nvmehostmetadata.exe'))) OR ("Process Path" IS NULL OR "Process Name" IS NULL) OR ("Process Path"='C:\Windows\ImmersiveControlPanel\SystemSettings.exe' OR "Process Name"='C:\Windows\ImmersiveControlPanel\SystemSettings.exe') OR (LOWER("Process Path") LIKE 'c:\$winreagent\scratch\%' OR LOWER("Process Name") LIKE 'c:\$winreagent\scratch\%')))) AND (NOT((((LOWER("Process Path") LIKE 'c:\users\%' OR LOWER("Process Name") LIKE 'c:\users\%') AND (LOWER("Process Path") LIKE '%\appdata\local\githubdesktop\app-%' OR LOWER("Process Name") LIKE '%\appdata\local\githubdesktop\app-%') AND (LOWER("Process Path") LIKE '%\resources\app\git\mingw64\bin\git.exe' OR LOWER("Process Name") LIKE '%\resources\app\git\mingw64\bin\git.exe')) OR ((LOWER("Process Path") LIKE 'c:\windows\temp\asgard2-agent\%' OR LOWER("Process Name") LIKE 'c:\windows\temp\asgard2-agent\%') AND (LOWER("Process Path") LIKE '%\thor.exe' OR LOWER("Process Name") LIKE '%\thor.exe')) OR ((LOWER("Process Path") LIKE 'c:\users\%' OR LOWER("Process Name") LIKE 'c:\users\%') AND (LOWER("Process Path") LIKE '%\appdata\local\keybase\upd.exe%' OR LOWER("Process Name") LIKE '%\appdata\local\keybase\upd.exe%')))))
