-- HackTool - SharpImpersonation Execution | T1134.001, T1134.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_sharp_impersonation.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\sharpimpersonation.exe' OR LOWER("Process Name") LIKE '%\sharpimpersonation.exe') OR Filename='SharpImpersonation.exe') OR ((LOWER(Command) LIKE '% user:%' AND LOWER(Command) LIKE '% binary:%') OR (LOWER(Command) LIKE '% user:%' AND LOWER(Command) LIKE '% shellcode:%') OR (LOWER(Command) LIKE '% technique:createprocessasuserw%' OR LOWER(Command) LIKE '% technique:impersonateloggedonuser%')))
