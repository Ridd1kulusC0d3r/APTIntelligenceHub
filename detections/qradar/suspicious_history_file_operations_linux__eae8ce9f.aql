-- Suspicious History File Operations - Linux | T1552.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/execve/lnx_auditd_susp_histfile_operations.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND LOWER(UTF8(payload)) LIKE '%execve%' AND (LOWER(UTF8(payload)) LIKE '%.bash_history%' OR LOWER(UTF8(payload)) LIKE '%.zsh_history%' OR LOWER(UTF8(payload)) LIKE '%.zhistory%' OR LOWER(UTF8(payload)) LIKE '%.history%' OR LOWER(UTF8(payload)) LIKE '%.sh_history%' OR LOWER(UTF8(payload)) LIKE '%fish_history%')
