-- Access To Windows Outlook Mail Files By Uncommon Applications | T1070.008 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/file/file_access/file_access_win_office_outlook_mail_credential.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER(Filename) LIKE '%\appdata\local\comms\unistore\data%' OR LOWER(Filename) LIKE '%\appdata\local\comms\unistoredb\store.vol') AND (NOT((("Process Path"='System' OR "Process Name"='System') OR ((LOWER("Process Path") LIKE 'c:\program files (x86)\%' OR LOWER("Process Path") LIKE 'c:\program files\%' OR LOWER("Process Path") LIKE 'c:\windows\system32\%' OR LOWER("Process Path") LIKE 'c:\windows\syswow64\%') OR (LOWER("Process Name") LIKE 'c:\program files (x86)\%' OR LOWER("Process Name") LIKE 'c:\program files\%' OR LOWER("Process Name") LIKE 'c:\windows\system32\%' OR LOWER("Process Name") LIKE 'c:\windows\syswow64\%'))))) AND (NOT((((LOWER("Process Path") LIKE 'c:\programdata\microsoft\windows defender\%' OR LOWER("Process Name") LIKE 'c:\programdata\microsoft\windows defender\%') AND ((LOWER("Process Path") LIKE '%\mpcopyaccelerator.exe' OR LOWER("Process Path") LIKE '%\msmpeng.exe') OR (LOWER("Process Name") LIKE '%\mpcopyaccelerator.exe' OR LOWER("Process Name") LIKE '%\msmpeng.exe'))) OR ((LOWER("Process Path") LIKE '%\thor64.exe' OR LOWER("Process Path") LIKE '%\thor.exe') OR (LOWER("Process Name") LIKE '%\thor64.exe' OR LOWER("Process Name") LIKE '%\thor.exe')))))
