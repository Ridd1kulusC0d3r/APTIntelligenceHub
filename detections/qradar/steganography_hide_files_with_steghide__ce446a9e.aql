-- Steganography Hide Files with Steghide | T1027.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/execve/lnx_auditd_steghide_embed_steganography.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND LOWER(UTF8(payload)) LIKE '%execve%' AND LOWER(Command) LIKE '%a0%steghide%' AND LOWER(Command) LIKE '%a1%embed%' AND (LOWER(Command) LIKE '%a2%-cf%' OR LOWER(Command) LIKE '%-ef%') AND (LOWER(Command) LIKE '%a4%-cf%' OR LOWER(Command) LIKE '%-ef%')
