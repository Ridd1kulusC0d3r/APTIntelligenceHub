-- Port Forwarding Activity Via SSH.EXE | T1021.001, T1021.004, T1572 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_ssh_port_forward.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Path") LIKE '%\ssh.exe' OR LOWER("Process Name") LIKE '%\ssh.exe') AND (LOWER(Command) LIKE '% -r %' OR LOWER(Command) LIKE '% /r %' OR LOWER(Command) LIKE '% –r %' OR LOWER(Command) LIKE '% —r %' OR LOWER(Command) LIKE '% ―r %')
