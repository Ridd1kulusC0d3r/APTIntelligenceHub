-- DNS Query for Anonfiles.com Domain - DNS Client | T1567.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/dns_client/win_dns_client_anonymfiles_com.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND "Event ID"=3008 AND LOWER(UTF8(payload)) LIKE '%.anonfiles.com%'
