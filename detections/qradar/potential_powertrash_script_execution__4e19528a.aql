-- Potential POWERTRASH Script Execution | T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/TA/FIN7/posh_ps_apt_fin7_powertrash_execution.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER(Message) LIKE '%io.compression.deflatestream%' AND LOWER(Message) LIKE '%io.memorystream%' AND LOWER(Message) LIKE '%::frombase64string%' AND LOWER(Message) LIKE '%getdelegateforfunctionpointer%' AND LOWER(Message) LIKE '%.invoke()%' AND LOWER(Message) LIKE '%globalassemblycache%'
