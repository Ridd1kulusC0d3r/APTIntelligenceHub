-- Potential Russian APT Credential Theft Activity | T1003.003, T1552.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/TA/Bear-APT-Activity/proc_creation_win_apt_bear_activity_gtr19.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER(Command) LIKE '%xcopy /s /e /c /q /h \\%' AND LOWER(Command) LIKE '%\sysvol\%') OR (LOWER(Command) LIKE '%adexplorer -snapshot "" c:\users\%' AND LOWER(Command) LIKE '%\downloads\%' AND LOWER(Command) LIKE '%.snp%'))
