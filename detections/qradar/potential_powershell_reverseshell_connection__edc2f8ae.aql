-- Potential Powershell ReverseShell Connection | T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_reverse_shell_connection.yml
SELECT * FROM events WHERE devicetype=12 AND ((Filename IN('PowerShell.EXE', 'pwsh.dll')) OR ((LOWER("Process Path") LIKE '%\powershell.exe' OR LOWER("Process Path") LIKE '%\pwsh.exe') OR (LOWER("Process Name") LIKE '%\powershell.exe' OR LOWER("Process Name") LIKE '%\pwsh.exe'))) AND (LOWER(Command) LIKE '% net.sockets.tcpclient%' AND LOWER(Command) LIKE '%.getstream(%' AND LOWER(Command) LIKE '%.write(%')
