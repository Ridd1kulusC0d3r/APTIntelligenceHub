-- Ruby on Rails Framework Exceptions | T1190 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/ruby/appframework_ruby_on_rails_exceptions.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%actioncontroller::invalidauthenticitytoken%' OR LOWER(UTF8(payload)) LIKE '%actioncontroller::invalidcrossoriginrequest%' OR LOWER(UTF8(payload)) LIKE '%actioncontroller::methodnotallowed%' OR LOWER(UTF8(payload)) LIKE '%actioncontroller::badrequest%' OR LOWER(UTF8(payload)) LIKE '%actioncontroller::parametermissing%'
