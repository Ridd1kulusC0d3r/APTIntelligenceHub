-- MSHTA Execution with Suspicious File Extensions | T1059.007, T1140, T1218.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_mshta_susp_execution.yml
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Path") LIKE '%\mshta.exe' OR LOWER("Process Name") LIKE '%\mshta.exe') OR Filename='mshta.exe') AND (LOWER(Command) LIKE '%.7z%' OR LOWER(Command) LIKE '%.avi%' OR LOWER(Command) LIKE '%.bat%' OR LOWER(Command) LIKE '%.bmp%' OR LOWER(Command) LIKE '%.conf%' OR LOWER(Command) LIKE '%.csv%' OR LOWER(Command) LIKE '%.dll%' OR LOWER(Command) LIKE '%.doc%' OR LOWER(Command) LIKE '%.gif%' OR LOWER(Command) LIKE '%.gz%' OR LOWER(Command) LIKE '%.ini%' OR LOWER(Command) LIKE '%.jpe%' OR LOWER(Command) LIKE '%.jpg%' OR LOWER(Command) LIKE '%.json%' OR LOWER(Command) LIKE '%.lnk%' OR LOWER(Command) LIKE '%.log%' OR LOWER(Command) LIKE '%.mkv%' OR LOWER(Command) LIKE '%.mp3%' OR LOWER(Command) LIKE '%.mp4%' OR LOWER(Command) LIKE '%.pdf%' OR LOWER(Command) LIKE '%.png%' OR LOWER(Command) LIKE '%.ppt%' OR LOWER(Command) LIKE '%.rar%' OR LOWER(Command) LIKE '%.rtf%' OR LOWER(Command) LIKE '%.svg%' OR LOWER(Command) LIKE '%.tar%' OR LOWER(Command) LIKE '%.tmp%' OR LOWER(Command) LIKE '%.txt%' OR LOWER(Command) LIKE '%.xls%' OR LOWER(Command) LIKE '%.xml%' OR LOWER(Command) LIKE '%.yaml%' OR LOWER(Command) LIKE '%.yml%' OR LOWER(Command) LIKE '%.zip%' OR LOWER(Command) LIKE '%vbscript%')
