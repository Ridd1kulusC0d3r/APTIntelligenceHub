-- Potential Persistence Via Netsh Helper DLL | T1546.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_netsh_helper_dll_persistence.yml
SELECT * FROM events WHERE devicetype=12 AND (Filename='netsh.exe' OR (LOWER("Process Path") LIKE '%\netsh.exe' OR LOWER("Process Name") LIKE '%\netsh.exe')) AND (LOWER(Command) LIKE '%add%' AND LOWER(Command) LIKE '%helper%')
