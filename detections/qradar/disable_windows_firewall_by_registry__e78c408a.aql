-- Disable Windows Firewall by Registry | T1686.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_disable_windows_firewall.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND ((LOWER("Process Name") LIKE '%\software\policies\microsoft\windowsfirewall\standardprofile\enablefirewall' OR LOWER("Process Name") LIKE '%\software\policies\microsoft\windowsfirewall\domainprofile\enablefirewall') OR (LOWER("Target Process Name") LIKE '%\software\policies\microsoft\windowsfirewall\standardprofile\enablefirewall' OR LOWER("Target Process Name") LIKE '%\software\policies\microsoft\windowsfirewall\domainprofile\enablefirewall') OR (LOWER("Object Name") LIKE '%\software\policies\microsoft\windowsfirewall\standardprofile\enablefirewall' OR LOWER("Object Name") LIKE '%\software\policies\microsoft\windowsfirewall\domainprofile\enablefirewall')) AND LOWER(UTF8(payload)) LIKE '%dword (0x00000000)%'
