-- File Explorer Folder Opened Using Explorer Folder Shortcut Via Shell | T1135 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_explorer_folder_shortcut_via_shell_binary.yml
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Parent Process Path") LIKE '%\cmd.exe' OR LOWER("Parent Process Path") LIKE '%\powershell.exe' OR LOWER("Parent Process Path") LIKE '%\pwsh.exe') AND (LOWER("Process Path") LIKE '%\explorer.exe' OR LOWER("Process Name") LIKE '%\explorer.exe') AND LOWER(Command) LIKE '%shell:mycomputerfolder%'
