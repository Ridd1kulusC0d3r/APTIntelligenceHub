-- Suspicious LDAP-Attributes Used | T1001.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_susp_ldap_dataexchange.yml
SELECT * FROM events WHERE devicetype=12 AND "Event ID"=5136 AND ("Attribute Old Value" LIKE '%' OR "Attribute New Value" LIKE '%') AND ((Username IN('primaryInternationalISDNNumber', 'otherFacsimileTelephoneNumber', 'primaryTelexNumber')) OR ("Account Name" IN('primaryInternationalISDNNumber', 'otherFacsimileTelephoneNumber', 'primaryTelexNumber')) OR ("Distinguished Name" IN('primaryInternationalISDNNumber', 'otherFacsimileTelephoneNumber', 'primaryTelexNumber')))
