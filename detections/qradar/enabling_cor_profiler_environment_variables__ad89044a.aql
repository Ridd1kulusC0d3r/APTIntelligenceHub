-- Enabling COR Profiler Environment Variables | T1574.012 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_enabling_cor_profiler_env_variables.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Name") LIKE '%\cor_enable_profiling' OR LOWER("Process Name") LIKE '%\cor_profiler' OR LOWER("Process Name") LIKE '%\coreclr_enable_profiling') OR (LOWER("Target Process Name") LIKE '%\cor_enable_profiling' OR LOWER("Target Process Name") LIKE '%\cor_profiler' OR LOWER("Target Process Name") LIKE '%\coreclr_enable_profiling') OR (LOWER("Object Name") LIKE '%\cor_enable_profiling' OR LOWER("Object Name") LIKE '%\cor_profiler' OR LOWER("Object Name") LIKE '%\coreclr_enable_profiling')) OR (LOWER("Process Name") LIKE '%\coreclr_profiler_path%' OR LOWER("Target Process Name") LIKE '%\coreclr_profiler_path%' OR LOWER("Object Name") LIKE '%\coreclr_profiler_path%'))
