-- File Time Attribute Change - Linux | T1070.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/execve/lnx_auditd_change_file_time_attr.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=11 AND LOWER(UTF8(payload)) LIKE '%execve%' AND LOWER(UTF8(payload)) LIKE '%touch%' AND (LOWER(UTF8(payload)) LIKE '%-t%' OR LOWER(UTF8(payload)) LIKE '%-acmr%' OR LOWER(UTF8(payload)) LIKE '%-d%' OR LOWER(UTF8(payload)) LIKE '%-r%')
