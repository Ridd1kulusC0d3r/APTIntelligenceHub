-- Remote Access Tool - Anydesk Execution From Suspicious Folder | T1219.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_remote_access_tools_anydesk_susp_exec.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\anydesk.exe' OR LOWER("Process Path") LIKE '%\anydeskmsi.exe') OR (LOWER("Process Name") LIKE '%\anydesk.exe' OR LOWER("Process Name") LIKE '%\anydeskmsi.exe')) OR LOWER(UTF8(payload)) LIKE '%anydesk%' OR LOWER(UTF8(payload)) LIKE '%anydesk%' OR LOWER(UTF8(payload)) LIKE '%anydesk software gmbh%') AND (NOT(((LOWER("Process Path") LIKE '%\appdata\%' OR LOWER("Process Path") LIKE '%program files (x86)\anydesk%' OR LOWER("Process Path") LIKE '%program files\anydesk%') OR (LOWER("Process Name") LIKE '%\appdata\%' OR LOWER("Process Name") LIKE '%program files (x86)\anydesk%' OR LOWER("Process Name") LIKE '%program files\anydesk%'))))
