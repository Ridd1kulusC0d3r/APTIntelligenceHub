-- Access To Browser Credential Files By Uncommon Applications - Security | T1555.003 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/builtin/security/win_security_file_access_browser_credential.yml
SELECT * FROM events WHERE devicetype=12 AND ("Event ID"=4663 AND "Object Type"='File' AND "Access Mask"='0x1') AND ((LOWER("Object Name") LIKE '%\user data\default\login data%' OR LOWER("Object Name") LIKE '%\user data\local state%' OR LOWER("Object Name") LIKE '%\user data\default\network\cookies%') OR (LOWER(Filename) LIKE '%\cookies.sqlite' OR LOWER(Filename) LIKE '%\places.sqlite' OR LOWER(Filename) LIKE '%release\key3.db' OR LOWER(Filename) LIKE '%release\key4.db' OR LOWER(Filename) LIKE '%release\logins.json')) AND (NOT(("Process Name"='System' OR (LOWER("Process Name") LIKE 'c:\program files (x86)\%' OR LOWER("Process Name") LIKE 'c:\program files\%' OR LOWER("Process Name") LIKE 'c:\windows\system32\%' OR LOWER("Process Name") LIKE 'c:\windows\syswow64\%')))) AND (NOT((LOWER("Process Name") LIKE 'c:\programdata\microsoft\windows defender\%' AND (LOWER("Process Name") LIKE '%\mpcopyaccelerator.exe' OR LOWER("Process Name") LIKE '%\msmpeng.exe'))))
