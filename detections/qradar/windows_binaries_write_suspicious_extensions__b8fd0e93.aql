-- Windows Binaries Write Suspicious Extensions | T1036 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_shell_write_susp_files_extensions.yml
SELECT * FROM events WHERE devicetype=12 AND ((((LOWER("Process Path") LIKE '%\csrss.exe' OR LOWER("Process Path") LIKE '%\lsass.exe' OR LOWER("Process Path") LIKE '%\runtimebroker.exe' OR LOWER("Process Path") LIKE '%\sihost.exe' OR LOWER("Process Path") LIKE '%\smss.exe' OR LOWER("Process Path") LIKE '%\wininit.exe' OR LOWER("Process Path") LIKE '%\winlogon.exe') OR (LOWER("Process Name") LIKE '%\csrss.exe' OR LOWER("Process Name") LIKE '%\lsass.exe' OR LOWER("Process Name") LIKE '%\runtimebroker.exe' OR LOWER("Process Name") LIKE '%\sihost.exe' OR LOWER("Process Name") LIKE '%\smss.exe' OR LOWER("Process Name") LIKE '%\wininit.exe' OR LOWER("Process Name") LIKE '%\winlogon.exe')) AND (LOWER(Filename) LIKE '%.bat' OR LOWER(Filename) LIKE '%.dll' OR LOWER(Filename) LIKE '%.exe' OR LOWER(Filename) LIKE '%.hta' OR LOWER(Filename) LIKE '%.iso' OR LOWER(Filename) LIKE '%.ps1' OR LOWER(Filename) LIKE '%.txt' OR LOWER(Filename) LIKE '%.vbe' OR LOWER(Filename) LIKE '%.vbs')) OR (((LOWER("Process Path") LIKE '%\dllhost.exe' OR LOWER("Process Path") LIKE '%\rundll32.exe' OR LOWER("Process Path") LIKE '%\svchost.exe') OR (LOWER("Process Name") LIKE '%\dllhost.exe' OR LOWER("Process Name") LIKE '%\rundll32.exe' OR LOWER("Process Name") LIKE '%\svchost.exe')) AND (LOWER(Filename) LIKE '%.bat' OR LOWER(Filename) LIKE '%.hta' OR LOWER(Filename) LIKE '%.iso' OR LOWER(Filename) LIKE '%.ps1' OR LOWER(Filename) LIKE '%.vbe' OR LOWER(Filename) LIKE '%.vbs'))) AND (NOT(((("Process Path"='C:\Windows\System32\dllhost.exe' OR "Process Name"='C:\Windows\System32\dllhost.exe') AND (LOWER(Filename) LIKE '%:\users\%' AND LOWER(Filename) LIKE '%\appdata\local\temp\__psscriptpolicytest_%') AND LOWER(Filename) LIKE '%.ps1') OR (("Process Path"='C:\Windows\system32\svchost.exe' OR "Process Name"='C:\Windows\system32\svchost.exe') AND (LOWER(Filename) LIKE '%c:\windows\system32\grouppolicy\datastore\%' AND LOWER(Filename) LIKE '%\sysvol\%' AND LOWER(Filename) LIKE '%\policies\%' AND LOWER(Filename) LIKE '%\machine\scripts\startup\%') AND (LOWER(Filename) LIKE '%.ps1' OR LOWER(Filename) LIKE '%.bat')) OR (("Process Path"='C:\Windows\system32\svchost.exe' OR "Process Name"='C:\Windows\system32\svchost.exe') AND (LOWER(Filename) LIKE '%c:\program files\windowsapps\clipchamp%' AND LOWER(Filename) LIKE '%.ps1%')) OR ((("Process Path" IN('C:\Windows\system32\svchost.exe', 'C:\Windows\SysWOW64\svchost.exe')) OR ("Process Name" IN('C:\Windows\system32\svchost.exe', 'C:\Windows\SysWOW64\svchost.exe'))) AND (LOWER(Filename) LIKE 'c:\program files\windowsapps\microsoft.powershellpreview%' OR LOWER(Filename) LIKE 'c:\program files (x86)\windowsapps\microsoft.powershellpreview%') AND LOWER(Filename) LIKE '%.ps1'))))
