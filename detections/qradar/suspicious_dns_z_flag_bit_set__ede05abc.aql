-- Suspicious DNS Z Flag Bit Set | T1095, T1571 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/zeek/zeek_dns_susp_zbit_flag.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE (NOT(LOWER(UTF8(payload)) LIKE '%z%0%')) AND LOWER(UTF8(payload)) LIKE '%.%' AND (NOT(((LOWER(UTF8(payload)) LIKE '%.arpa%' OR LOWER(UTF8(payload)) LIKE '%.local%' OR LOWER(UTF8(payload)) LIKE '%.ultradns.net%' OR LOWER(UTF8(payload)) LIKE '%.twtrdns.net%' OR LOWER(UTF8(payload)) LIKE '%.azuredns-prd.info%' OR LOWER(UTF8(payload)) LIKE '%.azure-dns.com%' OR LOWER(UTF8(payload)) LIKE '%.azuredns-ff.info%' OR LOWER(UTF8(payload)) LIKE '%.azuredns-ff.org%' OR LOWER(UTF8(payload)) LIKE '%.azuregov-dns.org%') OR (LOWER(UTF8(payload)) LIKE '%ns%' OR LOWER(UTF8(payload)) LIKE '%mx%') OR LOWER(UTF8(payload)) LIKE '%\x00%' OR (LOWER(UTF8(payload)) LIKE '%id.resp_p%137%' OR LOWER(UTF8(payload)) LIKE '%id.resp_p%138%' OR LOWER(UTF8(payload)) LIKE '%id.resp_p%139%'))))
