-- Remote Schedule Task Lateral Movement via ATSvc | T1053, T1053.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/rpc_firewall/rpc_firewall_atsvc_lateral_movement.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE LOWER(UTF8(payload)) LIKE '%rpcfw%' AND "Event ID"=3 AND "Source Interface UUID"='1ff70682-0a51-30e8-076d-740be8cee98b' AND (LOWER(UTF8(payload)) LIKE '%opnum%0%' OR LOWER(UTF8(payload)) LIKE '%opnum%1%')
