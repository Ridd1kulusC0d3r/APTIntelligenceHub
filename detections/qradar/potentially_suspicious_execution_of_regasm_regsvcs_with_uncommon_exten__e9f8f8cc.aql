-- Potentially Suspicious Execution Of Regasm/Regsvcs With Uncommon Extension | T1218.009 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_regasm_regsvcs_uncommon_extension_execution.yml
SELECT * FROM events WHERE devicetype=12 AND (((LOWER("Process Path") LIKE '%\regsvcs.exe' OR LOWER("Process Path") LIKE '%\regasm.exe') OR (LOWER("Process Name") LIKE '%\regsvcs.exe' OR LOWER("Process Name") LIKE '%\regasm.exe')) OR (Filename IN('RegSvcs.exe', 'RegAsm.exe'))) AND (LOWER(Command) LIKE '%.dat%' OR LOWER(Command) LIKE '%.gif%' OR LOWER(Command) LIKE '%.jpeg%' OR LOWER(Command) LIKE '%.jpg%' OR LOWER(Command) LIKE '%.png%' OR LOWER(Command) LIKE '%.txt%')
