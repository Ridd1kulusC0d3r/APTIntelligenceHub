-- OMIGOD HTTP No Authentication RCE - CVE-2021-38647 | T1021.006, T1068, T1190, T1203, T1210 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2021/Exploits/CVE-2021-38647/zeek_http_exploit_cve_2021_38647_omigod_no_auth_rce.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE (LOWER(UTF8(payload)) LIKE '%status_code%200%' AND LOWER(URL) LIKE '%/wsman%' AND Method='POST') AND (NOT(LOWER(UTF8(payload)) LIKE '%authorization%')) AND (NOT(LOWER(UTF8(payload)) LIKE '%request_body_len%0%'))
