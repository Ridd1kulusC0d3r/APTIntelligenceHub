-- Control Panel Items | T1218.002, T1546 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_control_panel_item.yml
SELECT * FROM events WHERE devicetype=12 AND ((((LOWER("Process Path") LIKE '%\reg.exe' OR LOWER("Process Name") LIKE '%\reg.exe') OR Filename='reg.exe') AND (LOWER(Command) LIKE '%add%' AND LOWER(Command) LIKE '%currentversion\control panel\cpls%')) OR (LOWER(Command) LIKE '%.cpl' AND (NOT(((LOWER(Command) LIKE '%\system32\%' OR LOWER(Command) LIKE '%%system%%' OR LOWER(Command) LIKE '%|c:\windows\system32|%') OR (LOWER(Command) LIKE '%regsvr32 %' AND LOWER(Command) LIKE '% /s %' AND LOWER(Command) LIKE '%igfxcpl.cpl%'))))))
