-- Suspicious Startup Folder Persistence | T1204.002, T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_startup_folder_persistence.yml
SELECT * FROM events WHERE devicetype=12 AND LOWER(Filename) LIKE '%\windows\start menu\programs\startup\%' AND (LOWER(Filename) LIKE '%.bat' OR LOWER(Filename) LIKE '%.cmd' OR LOWER(Filename) LIKE '%.dll' OR LOWER(Filename) LIKE '%.hta' OR LOWER(Filename) LIKE '%.jar' OR LOWER(Filename) LIKE '%.js' OR LOWER(Filename) LIKE '%.jse' OR LOWER(Filename) LIKE '%.msi' OR LOWER(Filename) LIKE '%.ps1' OR LOWER(Filename) LIKE '%.psd1' OR LOWER(Filename) LIKE '%.psm1' OR LOWER(Filename) LIKE '%.scr' OR LOWER(Filename) LIKE '%.url' OR LOWER(Filename) LIKE '%.vba' OR LOWER(Filename) LIKE '%.vbe' OR LOWER(Filename) LIKE '%.vbs' OR LOWER(Filename) LIKE '%.wsf')
