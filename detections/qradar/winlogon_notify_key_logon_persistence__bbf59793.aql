-- Winlogon Notify Key Logon Persistence | T1547.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_winlogon_notify_key.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER("Process Name") LIKE '%\software\microsoft\windows nt\currentversion\winlogon\notify\logon' OR LOWER("Target Process Name") LIKE '%\software\microsoft\windows nt\currentversion\winlogon\notify\logon' OR LOWER("Object Name") LIKE '%\software\microsoft\windows nt\currentversion\winlogon\notify\logon') AND LOWER(UTF8(payload)) LIKE '%.dll%'
