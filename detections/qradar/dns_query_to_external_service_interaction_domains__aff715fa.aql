-- DNS Query to External Service Interaction Domains | T1190, T1595.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/dns/net_dns_external_service_interaction_domains.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE ((LOWER(UTF8(payload)) LIKE '%.burpcollaborator.net%' OR LOWER(UTF8(payload)) LIKE '%.canarytokens.com%' OR LOWER(UTF8(payload)) LIKE '%.ceye.io%' OR LOWER(UTF8(payload)) LIKE '%.ddns.1443.eu.org%' OR LOWER(UTF8(payload)) LIKE '%.ddns.bypass.eu.org%' OR LOWER(UTF8(payload)) LIKE '%.ddns.xn--gg8h.eu.org%' OR LOWER(UTF8(payload)) LIKE '%.digimg.store%' OR LOWER(UTF8(payload)) LIKE '%.dns.su18.org%' OR LOWER(UTF8(payload)) LIKE '%.dnshook.site%' OR LOWER(UTF8(payload)) LIKE '%.dnslog.cn%' OR LOWER(UTF8(payload)) LIKE '%.dnslog.ink%' OR LOWER(UTF8(payload)) LIKE '%.gobygo.net%' OR LOWER(UTF8(payload)) LIKE '%.instances.httpworkbench.com%' OR LOWER(UTF8(payload)) LIKE '%.interact.sh%' OR LOWER(UTF8(payload)) LIKE '%.log.dnslog.pp.ua%' OR LOWER(UTF8(payload)) LIKE '%.log.dnslog.qzz.io%' OR LOWER(UTF8(payload)) LIKE '%.log.dnslogs.dpdns.org%' OR LOWER(UTF8(payload)) LIKE '%.log.javaweb.org%' OR LOWER(UTF8(payload)) LIKE '%.log.nat.cloudns.ph%' OR LOWER(UTF8(payload)) LIKE '%.oast.fun%' OR LOWER(UTF8(payload)) LIKE '%.oast.live%' OR LOWER(UTF8(payload)) LIKE '%.oast.me%' OR LOWER(UTF8(payload)) LIKE '%.oast.online%' OR LOWER(UTF8(payload)) LIKE '%.oast.pro%' OR LOWER(UTF8(payload)) LIKE '%.oast.site%' OR LOWER(UTF8(payload)) LIKE '%.oastify.com%' OR LOWER(UTF8(payload)) LIKE '%.p8.lol%' OR LOWER(UTF8(payload)) LIKE '%.requestbin.net%' OR LOWER(UTF8(payload)) LIKE '%.requestrepo.com%') OR LOWER(UTF8(payload)) LIKE '%requestrepo.com%') AND (NOT(LOWER(UTF8(payload)) LIKE '%polling.oastify.com%'))
