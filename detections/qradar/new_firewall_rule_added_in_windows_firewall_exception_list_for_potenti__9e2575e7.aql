-- New Firewall Rule Added In Windows Firewall Exception List For Potential Suspicious Application | T1686.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/firewall_as/win_firewall_as_add_rule_susp_folder.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (("Event ID" IN('2004', '2071', '2097')) AND (LOWER(UTF8(payload)) LIKE '%:\perflogs*%' OR LOWER(UTF8(payload)) LIKE '%:\temp\%' OR LOWER(UTF8(payload)) LIKE '%:\tmp\%' OR LOWER(UTF8(payload)) LIKE '%:\users\public\%' OR LOWER(UTF8(payload)) LIKE '%:\windows\tasks\%' OR LOWER(UTF8(payload)) LIKE '%:\windows\temp\%' OR LOWER(UTF8(payload)) LIKE '%\appdata\local\temp\%')) AND (NOT(LOWER(UTF8(payload)) LIKE '%action%2%'))
