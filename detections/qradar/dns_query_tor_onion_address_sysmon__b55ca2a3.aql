-- DNS Query Tor .Onion Address - Sysmon | T1090.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/dns_query/dns_query_win_tor_onion_domain_query.yml | NOTA: fallback QRadarAQL_payload_pipeline: campos sem propriedade DSM mapeada são buscados em UTF8(payload) – custo maior, crie custom properties
SELECT * FROM events WHERE devicetype=12 AND (LOWER(UTF8(payload)) LIKE '%.hiddenservice.net%' OR LOWER(UTF8(payload)) LIKE '%.onion.ca%' OR LOWER(UTF8(payload)) LIKE '%.onion.cab%' OR LOWER(UTF8(payload)) LIKE '%.onion.casa%' OR LOWER(UTF8(payload)) LIKE '%.onion.city%' OR LOWER(UTF8(payload)) LIKE '%.onion.direct%' OR LOWER(UTF8(payload)) LIKE '%.onion.dog%' OR LOWER(UTF8(payload)) LIKE '%.onion.glass%' OR LOWER(UTF8(payload)) LIKE '%.onion.gq%' OR LOWER(UTF8(payload)) LIKE '%.onion.ink%' OR LOWER(UTF8(payload)) LIKE '%.onion.it%' OR LOWER(UTF8(payload)) LIKE '%.onion.link%' OR LOWER(UTF8(payload)) LIKE '%.onion.lt%' OR LOWER(UTF8(payload)) LIKE '%.onion.lu%' OR LOWER(UTF8(payload)) LIKE '%.onion.nu%' OR LOWER(UTF8(payload)) LIKE '%.onion.pet%' OR LOWER(UTF8(payload)) LIKE '%.onion.plus%' OR LOWER(UTF8(payload)) LIKE '%.onion.rip%' OR LOWER(UTF8(payload)) LIKE '%.onion.sh%' OR LOWER(UTF8(payload)) LIKE '%.onion.to%' OR LOWER(UTF8(payload)) LIKE '%.onion.top%' OR LOWER(UTF8(payload)) LIKE '%.onion%' OR LOWER(UTF8(payload)) LIKE '%.s1.tor-gateways.de%' OR LOWER(UTF8(payload)) LIKE '%.s2.tor-gateways.de%' OR LOWER(UTF8(payload)) LIKE '%.s3.tor-gateways.de%' OR LOWER(UTF8(payload)) LIKE '%.s4.tor-gateways.de%' OR LOWER(UTF8(payload)) LIKE '%.s5.tor-gateways.de%' OR LOWER(UTF8(payload)) LIKE '%.t2w.pw%' OR LOWER(UTF8(payload)) LIKE '%.tor2web.ae.org%' OR LOWER(UTF8(payload)) LIKE '%.tor2web.blutmagie.de%' OR LOWER(UTF8(payload)) LIKE '%.tor2web.com%' OR LOWER(UTF8(payload)) LIKE '%.tor2web.fi%' OR LOWER(UTF8(payload)) LIKE '%.tor2web.io%' OR LOWER(UTF8(payload)) LIKE '%.tor2web.org%' OR LOWER(UTF8(payload)) LIKE '%.tor2web.xyz%' OR LOWER(UTF8(payload)) LIKE '%.torlink.co%')
