// Suspicious Package Installed - Linux | T1553.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_install_suspicious_packages.yml
from * metadata _id, _index, _version | where ((ends_with(Image, "/apt") or ends_with(Image, "/apt-get")) and CommandLine like "*install*" or ends_with(Image, "/yum") and (CommandLine like "*localinstall*" or CommandLine like "*install*") or ends_with(Image, "/rpm") and CommandLine like "*-i*" or ends_with(Image, "/dpkg") and (CommandLine like "*--install*" or CommandLine like "*-i*")) and (CommandLine like "*nmap*" or CommandLine like "* nc*" or CommandLine like "*netcat*" or CommandLine like "*wireshark*" or CommandLine like "*tshark*" or CommandLine like "*openconnect*" or CommandLine like "*proxychains*" or CommandLine like "*socat*")
