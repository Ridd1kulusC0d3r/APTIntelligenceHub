// Launch-VsDevShell.PS1 Proxy Execution | T1216.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_lolbin_launch_vsdevshell.yml
from * metadata _id, _index, _version | where process.command_line like "*Launch-VsDevShell.ps1*" and (process.command_line like "*VsWherePath *" or process.command_line like "*VsInstallationPath *")
