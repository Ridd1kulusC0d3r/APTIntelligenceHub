// Suspicious Invoke-WebRequest Execution | T1105 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_invoke_webrequest_download.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\powershell_ise.exe") or ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\pwsh.exe") or process.pe.original_file_name in ("powershell_ise.EXE", "PowerShell.EXE", "pwsh.dll")) and (process.command_line like "*curl *" or process.command_line like "*Invoke-WebRequest*" or process.command_line like "*iwr *" or process.command_line like "*wget *") and (process.command_line like "* -ur*" or process.command_line like "* -o*") and (process.command_line like "*\\AppData\\*" or process.command_line like "*\\Desktop\\*" or process.command_line like "*\\Temp\\*" or process.command_line like "*\\Users\\Public\\*" or process.command_line like "*%AppData%*" or process.command_line like "*%Public%*" or process.command_line like "*%Temp%*" or process.command_line like "*%tmp%*" or process.command_line like "*:\\Windows\\*")
