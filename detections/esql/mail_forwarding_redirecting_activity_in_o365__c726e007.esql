// Mail Forwarding/Redirecting Activity In O365 | T1020, T1114.003, T1564.008 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/cloud/m365/audit/microsoft365_susp_email_forwarding_activity.yml
from * metadata _id, _index, _version | where Operation like "*UpdateInboxRules*" and (OperationProperties like "*Forward*" or OperationProperties like "*Recipients*") or Operation like "*Set-Mailbox*" and (Parameters like "*ForwardingSmtpAddress*" or Parameters like "*ForwardingAddress*") or (Operation like "*New-InboxRule*" or Operation like "*Set-InboxRule*") and (Parameters like "*ForwardAsAttachmentTo*" or Parameters like "*ForwardingAddress*" or Parameters like "*ForwardingSmtpAddress*" or Parameters like "*ForwardTo*" or Parameters like "*RedirectTo*" or Parameters like "*RedirectToRecipients*")
