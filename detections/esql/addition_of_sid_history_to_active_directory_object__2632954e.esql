// Addition of SID History to Active Directory Object | T1134.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_susp_add_sid_history.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and (event.code in ("4765", "4766") or event.code=="4738" and not (winlog.event_data.SidHistory in ("-", "%%1793")) and not winlog.event_data.SidHistory is null)
