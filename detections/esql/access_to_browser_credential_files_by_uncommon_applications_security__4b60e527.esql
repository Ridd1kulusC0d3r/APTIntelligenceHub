// Access To Browser Credential Files By Uncommon Applications - Security | T1555.003 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/builtin/security/win_security_file_access_browser_credential.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="4663" and winlog.event_data.ObjectType=="File" and winlog.event_data.AccessMask=="0x1" and (winlog.event_data.ObjectName like "*\\User Data\\Default\\Login Data*" or winlog.event_data.ObjectName like "*\\User Data\\Local State*" or winlog.event_data.ObjectName like "*\\User Data\\Default\\Network\\Cookies*" or ends_with(file.path, "\\cookies.sqlite") or ends_with(file.path, "\\places.sqlite") or ends_with(file.path, "release\\key3.db") or ends_with(file.path, "release\\key4.db") or ends_with(file.path, "release\\logins.json")) and not (process.executable.caseless=="System" or starts_with(process.executable.caseless, "C:\\Program Files (x86)\\") or starts_with(process.executable.caseless, "C:\\Program Files\\") or starts_with(process.executable.caseless, "C:\\Windows\\system32\\") or starts_with(process.executable.caseless, "C:\\Windows\\SysWOW64\\")) and not (starts_with(process.executable.caseless, "C:\\ProgramData\\Microsoft\\Windows Defender\\") and (ends_with(process.executable.caseless, "\\MpCopyAccelerator.exe") or ends_with(process.executable.caseless, "\\MsMpEng.exe")))
