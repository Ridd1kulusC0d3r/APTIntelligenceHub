// HackTool - SharpUp PrivEsc Tool Execution | T1569.002, T1574.005, T1615 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_sharpup.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\SharpUp.exe") or process.pe.description=="SharpUp" or process.command_line like "*HijackablePaths*" or process.command_line like "*UnquotedServicePath*" or process.command_line like "*ProcessDLLHijack*" or process.command_line like "*ModifiableServiceBinaries*" or process.command_line like "*ModifiableScheduledTask*" or process.command_line like "*DomainGPPPassword*" or process.command_line like "*CachedGPPPassword*"
