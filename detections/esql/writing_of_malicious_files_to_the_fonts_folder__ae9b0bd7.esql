// Writing Of Malicious Files To The Fonts Folder | T1059, T1211 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_hiding_malware_in_fonts_folder.yml
from * metadata _id, _index, _version | where (process.command_line like "*echo*" or process.command_line like "*copy*" or process.command_line like "*type*" or process.command_line like "*file createnew*" or process.command_line like "*cacls*") and process.command_line like "*C:\\Windows\\Fonts\\*" and (process.command_line like "*.sh*" or process.command_line like "*.exe*" or process.command_line like "*.dll*" or process.command_line like "*.bin*" or process.command_line like "*.bat*" or process.command_line like "*.cmd*" or process.command_line like "*.js*" or process.command_line like "*.msh*" or process.command_line like "*.reg*" or process.command_line like "*.scr*" or process.command_line like "*.ps*" or process.command_line like "*.vb*" or process.command_line like "*.jar*" or process.command_line like "*.pl*" or process.command_line like "*.inf*" or process.command_line like "*.cpl*" or process.command_line like "*.hta*" or process.command_line like "*.msi*" or process.command_line like "*.vbs*")
