// Browser Started with Remote Debugging | T1185 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_browsers_remote_debugging.yml
from * metadata _id, _index, _version | where process.command_line like "* --remote-debugging-*" or ends_with(process.executable.caseless, "\\firefox.exe") and process.command_line like "* -start-debugger-server*"
