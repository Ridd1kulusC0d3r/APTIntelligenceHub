// AD Privileged Users or Groups Reconnaissance | T1087.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_account_discovery.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="4661" and (winlog.event_data.ObjectType in ("SAM_USER", "SAM_GROUP")) and (ends_with(winlog.event_data.ObjectName, "-512") or ends_with(winlog.event_data.ObjectName, "-502") or ends_with(winlog.event_data.ObjectName, "-500") or ends_with(winlog.event_data.ObjectName, "-505") or ends_with(winlog.event_data.ObjectName, "-519") or ends_with(winlog.event_data.ObjectName, "-520") or ends_with(winlog.event_data.ObjectName, "-544") or ends_with(winlog.event_data.ObjectName, "-551") or ends_with(winlog.event_data.ObjectName, "-555") or winlog.event_data.ObjectName like "*admin*") and not ends_with(user.name, "$")
