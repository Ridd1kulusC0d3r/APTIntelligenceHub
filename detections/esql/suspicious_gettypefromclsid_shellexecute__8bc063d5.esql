// Suspicious GetTypeFromCLSID ShellExecute | T1546.015 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_susp_gettypefromclsid.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*::GetTypeFromCLSID(*" and powershell.file.script_block_text like "*.ShellExecute(*"
