// Suspicious Reconnaissance Activity Via GatherNetworkInfo.VBS | T1059.005, T1615 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_gather_network_info_execution.yml
from * metadata _id, _index, _version | where process.command_line like "*gatherNetworkInfo.vbs*" and not (ends_with(process.executable.caseless, "\\cscript.exe") or ends_with(process.executable.caseless, "\\wscript.exe"))
