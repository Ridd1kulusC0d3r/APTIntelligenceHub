// Suspicious Volume Shadow Copy VSS_PS.dll Load | T1490 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/image_load/image_load_dll_vss_ps_susp_load.yml
from * metadata _id, _index, _version | where ends_with(file.path, "\\vss_ps.dll") and not (starts_with(process.executable.caseless, "C:\\Windows\\") and (ends_with(process.executable.caseless, "\\clussvc.exe") or ends_with(process.executable.caseless, "\\dismhost.exe") or ends_with(process.executable.caseless, "\\dllhost.exe") or ends_with(process.executable.caseless, "\\inetsrv\\appcmd.exe") or ends_with(process.executable.caseless, "\\inetsrv\\iissetup.exe") or ends_with(process.executable.caseless, "\\msiexec.exe") or ends_with(process.executable.caseless, "\\rundll32.exe") or ends_with(process.executable.caseless, "\\searchindexer.exe") or ends_with(process.executable.caseless, "\\srtasks.exe") or ends_with(process.executable.caseless, "\\svchost.exe") or ends_with(process.executable.caseless, "\\System32\\SystemPropertiesAdvanced.exe") or ends_with(process.executable.caseless, "\\taskhostw.exe") or ends_with(process.executable.caseless, "\\thor.exe") or ends_with(process.executable.caseless, "\\thor64.exe") or ends_with(process.executable.caseless, "\\tiworker.exe") or ends_with(process.executable.caseless, "\\vssvc.exe") or ends_with(process.executable.caseless, "\\vssadmin.exe") or ends_with(process.executable.caseless, "\\WmiPrvSE.exe") or ends_with(process.executable.caseless, "\\wsmprovhost.exe")) or starts_with(winlog.event_data.CommandLine, "C:\\$WinREAgent\\Scratch\\") and winlog.event_data.CommandLine like "*\\dismhost.exe {*" or process.executable.caseless is null) and not (starts_with(process.executable.caseless, "C:\\Program Files\\") or starts_with(process.executable.caseless, "C:\\Program Files (x86)\\"))
