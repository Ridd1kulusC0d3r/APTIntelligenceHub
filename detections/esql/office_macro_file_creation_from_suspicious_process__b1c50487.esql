// Office Macro File Creation From Suspicious Process | T1566.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_office_macro_files_from_susp_process.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\cscript.exe") or ends_with(process.executable.caseless, "\\mshta.exe") or ends_with(process.executable.caseless, "\\regsvr32.exe") or ends_with(process.executable.caseless, "\\rundll32.exe") or ends_with(process.executable.caseless, "\\wscript.exe") or ends_with(process.parent.executable.caseless, "\\cscript.exe") or ends_with(process.parent.executable.caseless, "\\mshta.exe") or ends_with(process.parent.executable.caseless, "\\regsvr32.exe") or ends_with(process.parent.executable.caseless, "\\rundll32.exe") or ends_with(process.parent.executable.caseless, "\\wscript.exe")) and (ends_with(file.path, ".docm") or ends_with(file.path, ".dotm") or ends_with(file.path, ".xlsm") or ends_with(file.path, ".xltm") or ends_with(file.path, ".potm") or ends_with(file.path, ".pptm"))
