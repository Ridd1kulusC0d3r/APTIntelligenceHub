// Potential Pikabot Hollowing Activity | T1055.012 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/Malware/Pikabot/proc_creation_win_malware_pikabot_rundll32_hollowing.yml
from * metadata _id, _index, _version | where ends_with(process.parent.executable.caseless, "\\rundll32.exe") and (ends_with(process.executable.caseless, "\\SearchFilterHost.exe") or ends_with(process.executable.caseless, "\\SearchProtocolHost.exe") or ends_with(process.executable.caseless, "\\sndvol.exe") or ends_with(process.executable.caseless, "\\wermgr.exe") or ends_with(process.executable.caseless, "\\wwahost.exe")) and not (ends_with(process.executable.caseless, "\\sndvol.exe") and process.parent.command_line like "*mmsys.cpl*")
