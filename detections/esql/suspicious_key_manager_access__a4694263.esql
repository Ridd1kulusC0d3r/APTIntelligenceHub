// Suspicious Key Manager Access | T1555.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_rundll32_keymgr.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\rundll32.exe") or process.pe.original_file_name=="RUNDLL32.EXE") and process.command_line like "*keymgr*" and process.command_line like "*KRShowKeyMgr*"
