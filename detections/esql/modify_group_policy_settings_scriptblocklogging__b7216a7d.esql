// Modify Group Policy Settings - ScriptBlockLogging | T1484.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_modify_group_policy_settings.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*\\SOFTWARE\\Policies\\Microsoft\\Windows\\System*" and (powershell.file.script_block_text like "*GroupPolicyRefreshTimeDC*" or powershell.file.script_block_text like "*GroupPolicyRefreshTimeOffsetDC*" or powershell.file.script_block_text like "*GroupPolicyRefreshTime*" or powershell.file.script_block_text like "*GroupPolicyRefreshTimeOffset*" or powershell.file.script_block_text like "*EnableSmartScreen*" or powershell.file.script_block_text like "*ShellSmartScreenLevel*")
