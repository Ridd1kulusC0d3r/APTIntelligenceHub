// PowerShell Logging Disabled Via Registry Key Tampering | T1112, T1564.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_powershell_logging_disabled.yml
from * metadata _id, _index, _version | where (registry.path like "*\\Microsoft\\Windows\\PowerShell\\*" or registry.path like "*\\Microsoft\\PowerShellCore\\*") and (ends_with(registry.path, "\\ModuleLogging\\EnableModuleLogging") or ends_with(registry.path, "\\ScriptBlockLogging\\EnableScriptBlockLogging") or ends_with(registry.path, "\\ScriptBlockLogging\\EnableScriptBlockInvocationLogging") or ends_with(registry.path, "\\Transcription\\EnableTranscripting") or ends_with(registry.path, "\\Transcription\\EnableInvocationHeader") or ends_with(registry.path, "\\EnableScripts")) and winlog.event_data.Details=="DWORD (0x00000000)"
