// Windows Pcap Drivers | T1040 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_pcap_drivers.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="4697" and (winlog.event_data.ServiceFileName like "*pcap*" or winlog.event_data.ServiceFileName like "*npcap*" or winlog.event_data.ServiceFileName like "*npf*" or winlog.event_data.ServiceFileName like "*nm3*" or winlog.event_data.ServiceFileName like "*ndiscap*" or winlog.event_data.ServiceFileName like "*nmnt*" or winlog.event_data.ServiceFileName like "*windivert*" or winlog.event_data.ServiceFileName like "*USBPcap*" or winlog.event_data.ServiceFileName like "*pktmon*")
