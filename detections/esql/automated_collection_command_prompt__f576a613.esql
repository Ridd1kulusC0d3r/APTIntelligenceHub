// Automated Collection Command Prompt | T1119, T1552.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_automated_collection.yml
from * metadata _id, _index, _version | where (process.command_line like "*.doc*" or process.command_line like "*.docx*" or process.command_line like "*.xls*" or process.command_line like "*.xlsx*" or process.command_line like "*.ppt*" or process.command_line like "*.pptx*" or process.command_line like "*.rtf*" or process.command_line like "*.pdf*" or process.command_line like "*.txt*") and (process.command_line like "*dir *" and process.command_line like "* /b *" and process.command_line like "* /s *" or process.pe.original_file_name=="FINDSTR.EXE" and (process.command_line like "* /e *" or process.command_line like "* /si *"))
