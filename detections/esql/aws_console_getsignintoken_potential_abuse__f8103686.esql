// AWS Console GetSigninToken Potential Abuse | T1021.007, T1550.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/aws/cloudtrail/aws_console_getsignintoken.yml
from * metadata _id, _index, _version | where eventSource=="signin.amazonaws.com" and eventName=="GetSigninToken" and not userAgent like "*Jersey/${project.version}*"
