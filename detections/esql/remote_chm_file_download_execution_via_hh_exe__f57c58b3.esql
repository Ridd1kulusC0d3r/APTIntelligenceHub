// Remote CHM File Download/Execution Via HH.EXE | T1218.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hh_chm_remote_download_or_execution.yml
from * metadata _id, _index, _version | where (process.pe.original_file_name=="HH.exe" or ends_with(process.executable.caseless, "\\hh.exe")) and (process.command_line like "*http://*" or process.command_line like "*https://*" or process.command_line like "*\\\\*")
