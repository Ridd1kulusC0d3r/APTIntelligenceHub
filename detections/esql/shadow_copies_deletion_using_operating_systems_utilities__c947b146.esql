// Shadow Copies Deletion Using Operating Systems Utilities | T1070, T1490 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_shadow_copies_deletion.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\pwsh.exe") or ends_with(process.executable.caseless, "\\wmic.exe") or ends_with(process.executable.caseless, "\\vssadmin.exe") or ends_with(process.executable.caseless, "\\diskshadow.exe") or process.pe.original_file_name in ("PowerShell.EXE", "pwsh.dll", "wmic.exe", "VSSADMIN.EXE", "diskshadow.exe")) and process.command_line like "*shadow*" and process.command_line like "*delete*" or (ends_with(process.executable.caseless, "\\wbadmin.exe") or process.pe.original_file_name=="WBADMIN.EXE") and process.command_line like "*delete*" and process.command_line like "*catalog*" and process.command_line like "*quiet*" or (ends_with(process.executable.caseless, "\\vssadmin.exe") or process.pe.original_file_name=="VSSADMIN.EXE") and process.command_line like "*resize*" and process.command_line like "*shadowstorage*" and (process.command_line like "*unbounded*" or process.command_line like "*/MaxSize=*")
