// PUA - Rclone Execution | T1567.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_pua_rclone_execution.yml
from * metadata _id, _index, _version | where process.command_line like "*--config *" and process.command_line like "*--no-check-certificate *" and process.command_line like "* copy *" or (ends_with(process.executable.caseless, "\\rclone.exe") or process.pe.description=="Rsync for cloud storage") and (process.command_line like "*pass*" or process.command_line like "*user*" or process.command_line like "*copy*" or process.command_line like "*sync*" or process.command_line like "*config*" or process.command_line like "*lsd*" or process.command_line like "*remote*" or process.command_line like "*ls*" or process.command_line like "*mega*" or process.command_line like "*pcloud*" or process.command_line like "*ftp*" or process.command_line like "*ignore-existing*" or process.command_line like "*auto-confirm*" or process.command_line like "*transfers*" or process.command_line like "*multi-thread-streams*" or process.command_line like "*no-check-certificate *")
