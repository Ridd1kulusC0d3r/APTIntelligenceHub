// Suspicious Shim Database Patching Activity | T1546.011 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_persistence_shim_database_susp_application.yml
from * metadata _id, _index, _version | where registry.path like "*\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\Custom\\*" and (ends_with(registry.path, "\\csrss.exe") or ends_with(registry.path, "\\dllhost.exe") or ends_with(registry.path, "\\explorer.exe") or ends_with(registry.path, "\\RuntimeBroker.exe") or ends_with(registry.path, "\\services.exe") or ends_with(registry.path, "\\sihost.exe") or ends_with(registry.path, "\\svchost.exe") or ends_with(registry.path, "\\taskhostw.exe") or ends_with(registry.path, "\\winlogon.exe") or ends_with(registry.path, "\\WmiPrvSe.exe"))
