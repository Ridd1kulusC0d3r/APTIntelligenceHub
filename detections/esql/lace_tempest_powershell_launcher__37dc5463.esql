// Lace Tempest PowerShell Launcher | T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/TA/Lace-Tempest/posh_ps_apt_lace_tempest_malware_launcher.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*\\SysAidServer\\tomcat\\webapps*" and powershell.file.script_block_text like "*Starting user.exe*" and powershell.file.script_block_text like "*\\usersfiles\\user.exe*" and powershell.file.script_block_text like "*Remove-Item -Force \"$wapps*" and powershell.file.script_block_text like "*(Sophos).*"
