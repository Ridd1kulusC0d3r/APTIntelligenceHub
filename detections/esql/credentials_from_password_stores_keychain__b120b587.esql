// Credentials from Password Stores - Keychain | T1555.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_creds_from_keychain.yml
from * metadata _id, _index, _version | where Image=="/usr/bin/security" and (CommandLine like "*find-certificate*" or CommandLine like "* export *") or CommandLine like "* dump-keychain *" or CommandLine like "* login-keychain *"
