// Potential Persistence Via PowerShell User Profile Using Add-Content | T1546.013 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_user_profile_tampering.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*Add-Content $profile*" and (powershell.file.script_block_text like "*-Value \"IEX *" or powershell.file.script_block_text like "*-Value \"Invoke-Expression*" or powershell.file.script_block_text like "*-Value \"Invoke-WebRequest*" or powershell.file.script_block_text like "*-Value \"Start-Process*" or powershell.file.script_block_text like "*-Value 'IEX *" or powershell.file.script_block_text like "*-Value 'Invoke-Expression*" or powershell.file.script_block_text like "*-Value 'Invoke-WebRequest*" or powershell.file.script_block_text like "*-Value 'Start-Process*")
