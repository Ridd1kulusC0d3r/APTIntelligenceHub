// Suspicious Double Extension File Execution | T1566.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_double_extension.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "      .exe") or ends_with(process.executable.caseless, "______.exe") or ends_with(process.executable.caseless, ".doc.exe") or ends_with(process.executable.caseless, ".doc.js") or ends_with(process.executable.caseless, ".docx.exe") or ends_with(process.executable.caseless, ".docx.js") or ends_with(process.executable.caseless, ".gif.exe") or ends_with(process.executable.caseless, ".jpeg.exe") or ends_with(process.executable.caseless, ".jpg.exe") or ends_with(process.executable.caseless, ".mkv.exe") or ends_with(process.executable.caseless, ".mov.exe") or ends_with(process.executable.caseless, ".mp3.exe") or ends_with(process.executable.caseless, ".mp4.exe") or ends_with(process.executable.caseless, ".pdf.exe") or ends_with(process.executable.caseless, ".pdf.js") or ends_with(process.executable.caseless, ".png.exe") or ends_with(process.executable.caseless, ".ppt.exe") or ends_with(process.executable.caseless, ".ppt.js") or ends_with(process.executable.caseless, ".pptx.exe") or ends_with(process.executable.caseless, ".pptx.js") or ends_with(process.executable.caseless, ".rtf.exe") or ends_with(process.executable.caseless, ".rtf.js") or ends_with(process.executable.caseless, ".svg.exe") or ends_with(process.executable.caseless, ".txt.exe") or ends_with(process.executable.caseless, ".txt.js") or ends_with(process.executable.caseless, ".xls.exe") or ends_with(process.executable.caseless, ".xls.js") or ends_with(process.executable.caseless, ".xlsx.exe") or ends_with(process.executable.caseless, ".xlsx.js") or ends_with(process.executable.caseless, "⠀⠀⠀⠀⠀⠀.exe")) and (process.command_line like "*      .exe*" or process.command_line like "*______.exe*" or process.command_line like "*.doc.exe*" or process.command_line like "*.doc.js*" or process.command_line like "*.docx.exe*" or process.command_line like "*.docx.js*" or process.command_line like "*.gif.exe*" or process.command_line like "*.jpeg.exe*" or process.command_line like "*.jpg.exe*" or process.command_line like "*.mkv.exe*" or process.command_line like "*.mov.exe*" or process.command_line like "*.mp3.exe*" or process.command_line like "*.mp4.exe*" or process.command_line like "*.pdf.exe*" or process.command_line like "*.pdf.js*" or process.command_line like "*.png.exe*" or process.command_line like "*.ppt.exe*" or process.command_line like "*.ppt.js*" or process.command_line like "*.pptx.exe*" or process.command_line like "*.pptx.js*" or process.command_line like "*.rtf.exe*" or process.command_line like "*.rtf.js*" or process.command_line like "*.svg.exe*" or process.command_line like "*.txt.exe*" or process.command_line like "*.txt.js*" or process.command_line like "*.xls.exe*" or process.command_line like "*.xls.js*" or process.command_line like "*.xlsx.exe*" or process.command_line like "*.xlsx.js*" or process.command_line like "*⠀⠀⠀⠀⠀⠀.exe*")
