// Lace Tempest PowerShell Evidence Eraser | T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/TA/Lace-Tempest/posh_ps_apt_lace_tempest_eraser_script.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*cleanLL*" and powershell.file.script_block_text like "*usersfiles.war*" and powershell.file.script_block_text like "*Remove-Item -Path \"$tomcat_dir*" and powershell.file.script_block_text like "*SysAidServer*" and powershell.file.script_block_text like "*sleep *" and powershell.file.script_block_text like "*while(1)*"
