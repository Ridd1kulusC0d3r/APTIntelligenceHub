// Renamed BOINC Client Execution | T1553 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_renamed_boinc.yml
from * metadata _id, _index, _version | where process.pe.original_file_name=="BOINC.exe" and not ends_with(process.executable.caseless, "\\BOINC.exe")
