// SharpHound Recon Account Discovery | T1087 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/rpc_firewall/rpc_firewall_sharphound_recon_account.yml
from * metadata _id, _index, _version | where EventLog=="RPCFW" and EventID==3 and InterfaceUuid=="6bffd098-a112-3610-9833-46c3f87e345a" and OpNum==2
