// Potential Reconnaissance For Cached Credentials Via Cmdkey.EXE | T1003.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_cmdkey_recon.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\cmdkey.exe") or process.pe.original_file_name=="cmdkey.exe") and (process.command_line like "* -l*" or process.command_line like "* /l*" or process.command_line like "* –l*" or process.command_line like "* —l*" or process.command_line like "* ―l*")
