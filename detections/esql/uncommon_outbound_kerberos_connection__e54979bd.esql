// Uncommon Outbound Kerberos Connection | T1550.003, T1558 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_susp_outbound_kerberos_connection.yml
from * metadata _id, _index, _version | where destination.port==88 and network.direction=="true" and not process.executable.caseless=="C:\\Windows\\System32\\lsass.exe" and not (process.executable.caseless in ("C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe", "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe") or process.executable.caseless in ("C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe", "C:\\Program Files\\Mozilla Firefox\\firefox.exe") or ends_with(process.executable.caseless, "\\tomcat\\bin\\tomcat8.exe") or process.executable.caseless in ("C:\\Program Files\\Zscaler\\ZSATunnel\\ZSATunnel.exe", "C:\\Program Files (x86)\\Zscaler\\ZSATunnel\\ZSATunnel.exe"))
