// Security Software Discovery Via Powershell Script | T1518.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_get_process_security_software_discovery.yml
from * metadata _id, _index, _version | where (powershell.file.script_block_text like "*get-process | \?*" or powershell.file.script_block_text like "*get-process | where*" or powershell.file.script_block_text like "*gps | \?*" or powershell.file.script_block_text like "*gps | where*") and (powershell.file.script_block_text like "*Company -like*" or powershell.file.script_block_text like "*Description -like*" or powershell.file.script_block_text like "*Name -like*" or powershell.file.script_block_text like "*Path -like*" or powershell.file.script_block_text like "*Product -like*") and (powershell.file.script_block_text like "*\*avira\**" or powershell.file.script_block_text like "*\*carbonblack\**" or powershell.file.script_block_text like "*\*cylance\**" or powershell.file.script_block_text like "*\*defender\**" or powershell.file.script_block_text like "*\*kaspersky\**" or powershell.file.script_block_text like "*\*malware\**" or powershell.file.script_block_text like "*\*sentinel\**" or powershell.file.script_block_text like "*\*symantec\**" or powershell.file.script_block_text like "*\*virus\**")
