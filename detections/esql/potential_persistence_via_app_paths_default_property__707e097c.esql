// Potential Persistence Via App Paths Default Property | T1546.012 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_persistence_app_paths.yml
from * metadata _id, _index, _version | where registry.path like "*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths*" and (ends_with(registry.path, "(Default)") or ends_with(registry.path, "Path")) and (winlog.event_data.Details like "*\\Users\\Public*" or winlog.event_data.Details like "*\\AppData\\Local\\Temp\\*" or winlog.event_data.Details like "*\\Windows\\Temp\\*" or winlog.event_data.Details like "*\\Desktop\\*" or winlog.event_data.Details like "*\\Downloads\\*" or winlog.event_data.Details like "*%temp%*" or winlog.event_data.Details like "*%tmp%*" or winlog.event_data.Details like "*iex*" or winlog.event_data.Details like "*Invoke-*" or winlog.event_data.Details like "*rundll32*" or winlog.event_data.Details like "*regsvr32*" or winlog.event_data.Details like "*mshta*" or winlog.event_data.Details like "*cscript*" or winlog.event_data.Details like "*wscript*" or winlog.event_data.Details like "*.bat*" or winlog.event_data.Details like "*.hta*" or winlog.event_data.Details like "*.dll*" or winlog.event_data.Details like "*.ps1*")
