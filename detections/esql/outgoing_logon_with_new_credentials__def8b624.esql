// Outgoing Logon with New Credentials | T1550 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/account_management/win_security_susp_logon_newcredentials.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="4624" and winlog.event_data.LogonType=="9"
