// Suspicious Child Process Created as System | T1134.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_child_process_as_system_.yml
from * metadata _id, _index, _version | where (winlog.event_data.ParentUser like "*AUTHORI*" or winlog.event_data.ParentUser like "*AUTORI*") and (ends_with(winlog.event_data.ParentUser, "\\NETWORK SERVICE") or ends_with(winlog.event_data.ParentUser, "\\LOCAL SERVICE")) and (user.name like "*AUTHORI*" or user.name like "*AUTORI*") and (ends_with(user.name, "\\SYSTEM") or ends_with(user.name, "\\Système") or ends_with(user.name, "\\СИСТЕМА")) and (winlog.event_data.IntegrityLevel in ("System", "S-1-16-16384")) and not (ends_with(process.executable.caseless, "\\rundll32.exe") and process.command_line like "*DavSetCookie*")
