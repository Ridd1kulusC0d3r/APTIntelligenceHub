// HackTool - Impersonate Execution | T1134.001, T1134.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_impersonate.yml
from * metadata _id, _index, _version | where process.command_line like "*impersonate.exe*" and (process.command_line like "* list *" or process.command_line like "* exec *" or process.command_line like "* adduser *") or winlog.event_data.Hashes like "*MD5=9520714AB576B0ED01D1513691377D01*" or winlog.event_data.Hashes like "*SHA256=E81CC96E2118DC4FBFE5BAD1604E0AC7681960143E2101E1A024D52264BB0A8A*" or winlog.event_data.Hashes like "*IMPHASH=0A358FFC1697B7A07D0E817AC740DF62*"
