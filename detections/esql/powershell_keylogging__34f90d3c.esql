// Powershell Keylogging | T1056.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_keylogging.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*Get-Keystrokes*" or powershell.file.script_block_text like "*Get-ProcAddress user32.dll GetAsyncKeyState*" and powershell.file.script_block_text like "*Get-ProcAddress user32.dll GetForegroundWindow*"
