// DNS Query Tor .Onion Address - Sysmon | T1090.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/dns_query/dns_query_win_tor_onion_domain_query.yml
from * metadata _id, _index, _version | where ends_with(dns.question.name, ".hiddenservice.net") or ends_with(dns.question.name, ".onion.ca") or ends_with(dns.question.name, ".onion.cab") or ends_with(dns.question.name, ".onion.casa") or ends_with(dns.question.name, ".onion.city") or ends_with(dns.question.name, ".onion.direct") or ends_with(dns.question.name, ".onion.dog") or ends_with(dns.question.name, ".onion.glass") or ends_with(dns.question.name, ".onion.gq") or ends_with(dns.question.name, ".onion.ink") or ends_with(dns.question.name, ".onion.it") or ends_with(dns.question.name, ".onion.link") or ends_with(dns.question.name, ".onion.lt") or ends_with(dns.question.name, ".onion.lu") or ends_with(dns.question.name, ".onion.nu") or ends_with(dns.question.name, ".onion.pet") or ends_with(dns.question.name, ".onion.plus") or ends_with(dns.question.name, ".onion.rip") or ends_with(dns.question.name, ".onion.sh") or ends_with(dns.question.name, ".onion.to") or ends_with(dns.question.name, ".onion.top") or ends_with(dns.question.name, ".onion") or ends_with(dns.question.name, ".s1.tor-gateways.de") or ends_with(dns.question.name, ".s2.tor-gateways.de") or ends_with(dns.question.name, ".s3.tor-gateways.de") or ends_with(dns.question.name, ".s4.tor-gateways.de") or ends_with(dns.question.name, ".s5.tor-gateways.de") or ends_with(dns.question.name, ".t2w.pw") or ends_with(dns.question.name, ".tor2web.ae.org") or ends_with(dns.question.name, ".tor2web.blutmagie.de") or ends_with(dns.question.name, ".tor2web.com") or ends_with(dns.question.name, ".tor2web.fi") or ends_with(dns.question.name, ".tor2web.io") or ends_with(dns.question.name, ".tor2web.org") or ends_with(dns.question.name, ".tor2web.xyz") or ends_with(dns.question.name, ".torlink.co")
