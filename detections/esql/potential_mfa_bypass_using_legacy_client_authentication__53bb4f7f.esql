// Potential MFA Bypass Using Legacy Client Authentication | T1078.004, T1110 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/azure/signin_logs/azure_ad_suspicious_signin_bypassing_mfa.yml
from * metadata _id, _index, _version | where Status=="Success" and (userAgent like "*BAV2ROPC*" or userAgent like "*CBAinPROD*" or userAgent like "*CBAinTAR*")
