// Potential Persistence Via GlobalFlags | T1546.012 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_persistence_globalflags.yml
from * metadata _id, _index, _version | where registry.path like "*\\Microsoft\\Windows NT\\CurrentVersion\\*" and registry.path like "*\\Image File Execution Options\\*" and registry.path like "*\\GlobalFlag*" or registry.path like "*\\Microsoft\\Windows NT\\CurrentVersion\\*" and registry.path like "*\\SilentProcessExit\\*" and (registry.path like "*\\ReportingMode*" or registry.path like "*\\MonitorProcess*")
