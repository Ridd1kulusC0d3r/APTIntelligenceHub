// HybridConnectionManager Service Installation - Registry | T1608 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_hybridconnectionmgr_svc_installation.yml
from * metadata _id, _index, _version | where registry.path like "*\\Services\\HybridConnectionManager*" or winlog.event_data.EventType=="SetValue" and winlog.event_data.Details like "*Microsoft.HybridConnectionManager.Listener.exe*"
