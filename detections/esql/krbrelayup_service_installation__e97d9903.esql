// KrbRelayUp Service Installation | T1543 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/service_control_manager/win_system_krbrelayup_service_installation.yml
from * metadata _id, _index, _version | where winlog.channel=="System" and event.code=="7045" and winlog.event_data.ServiceName=="KrbSCM"
