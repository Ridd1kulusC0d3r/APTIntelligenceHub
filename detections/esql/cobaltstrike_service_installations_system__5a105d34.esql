// CobaltStrike Service Installations - System | T1021.002, T1543.003, T1569.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/service_control_manager/win_system_cobaltstrike_service_installs.yml
from * metadata _id, _index, _version | where winlog.channel=="System" and winlog.provider_name=="Service Control Manager" and event.code=="7045" and (winlog.event_data.ImagePath like "*ADMIN$*" and winlog.event_data.ImagePath like "*.exe*" or winlog.event_data.ImagePath like "*%COMSPEC%*" and winlog.event_data.ImagePath like "*start*" and winlog.event_data.ImagePath like "*powershell*" or winlog.event_data.ImagePath like "*powershell -nop -w hidden -encodedcommand*" or winlog.event_data.ImagePath like "*SUVYIChOZXctT2JqZWN0IE5ldC5XZWJjbGllbnQpLkRvd25sb2FkU3RyaW5nKCdodHRwOi8vMTI3LjAuMC4xO*" or winlog.event_data.ImagePath like "*lFWCAoTmV3LU9iamVjdCBOZXQuV2ViY2xpZW50KS5Eb3dubG9hZFN0cmluZygnaHR0cDovLzEyNy4wLjAuMT*" or winlog.event_data.ImagePath like "*JRVggKE5ldy1PYmplY3QgTmV0LldlYmNsaWVudCkuRG93bmxvYWRTdHJpbmcoJ2h0dHA6Ly8xMjcuMC4wLjE6*")
