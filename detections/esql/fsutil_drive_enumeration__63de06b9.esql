// Fsutil Drive Enumeration | T1120 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_fsutil_drive_enumeration.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\fsutil.exe") or process.pe.original_file_name=="fsutil.exe") and process.command_line like "*drives*"
