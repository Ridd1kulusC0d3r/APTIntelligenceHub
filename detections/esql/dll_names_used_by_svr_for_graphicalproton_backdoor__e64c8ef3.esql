// DLL Names Used By SVR For GraphicalProton Backdoor | T1574.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/TA/Cozy-Bear/image_load_apt_cozy_bear_graphical_proton_dlls.yml
from * metadata _id, _index, _version | where ends_with(file.path, "\\AclNumsInvertHost.dll") or ends_with(file.path, "\\AddressResourcesSpec.dll") or ends_with(file.path, "\\BlendMonitorStringBuild.dll") or ends_with(file.path, "\\ChildPaletteConnected.dll") or ends_with(file.path, "\\DeregisterSeekUsers.dll") or ends_with(file.path, "\\HandleFrequencyAll.dll") or ends_with(file.path, "\\HardSwapColor.dll") or ends_with(file.path, "\\LengthInMemoryActivate.dll") or ends_with(file.path, "\\ModeBitmapNumericAnimate.dll") or ends_with(file.path, "\\ModeFolderSignMove.dll") or ends_with(file.path, "\\ParametersNamesPopup.dll") or ends_with(file.path, "\\PerformanceCaptionApi.dll") or ends_with(file.path, "\\ScrollbarHandleGet.dll") or ends_with(file.path, "\\UnregisterAncestorAppendAuto.dll") or ends_with(file.path, "\\WowIcmpRemoveReg.dll")
