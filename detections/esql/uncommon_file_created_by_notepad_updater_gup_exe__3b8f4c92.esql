// Uncommon File Created by Notepad++ Updater Gup.EXE | T1195.002, T1557 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_gup_uncommon_file_creation.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\gup.exe") and not (starts_with(file.path, "C:\\Program Files\\Notepad++\\") or starts_with(file.path, "C:\\Program Files (x86)\\Notepad++\\") or starts_with(file.path, "C:\\Users\\") and file.path like "*\\AppData\\Local\\Temp\\*" and file.path like "*npp.*" and file.path like "*.Installer.*" and file.path like "*.exe*" or starts_with(file.path, "C:\\Users\\") and file.path like "*\\AppData\\Local\\Temp\\*" and file.path like "*.zip*" or starts_with(file.path, "C:\\$Recycle.Bin\\S-1-5-21") or file.path like "*\\plugins\\JsonTools\\testfiles\\*" or file.path like "*\\Notepad++\\plugins\\ComparePlugin\\*" or file.path like "*npp.*" and file.path like "*.portable.*" and file.path like "*\\plugins\\*")
