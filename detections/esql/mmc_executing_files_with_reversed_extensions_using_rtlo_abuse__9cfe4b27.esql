// MMC Executing Files with Reversed Extensions Using RTLO Abuse | T1036.002, T1204.002, T1218.014 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_mmc_rlo_abuse_pattern.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\mmc.exe") or process.pe.original_file_name=="MMC.exe") and (process.command_line like "*cod.msc*" or process.command_line like "*fdp.msc*" or process.command_line like "*ftr.msc*" or process.command_line like "*lmth.msc*" or process.command_line like "*slx.msc*" or process.command_line like "*tdo.msc*" or process.command_line like "*xcod.msc*" or process.command_line like "*xslx.msc*" or process.command_line like "*xtpp.msc*")
