// PUA - PingCastle Execution From Potentially Suspicious Parent | T1595 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_pua_pingcastle_script_parent.yml
from * metadata _id, _index, _version | where (process.parent.command_line like "*.bat*" or process.parent.command_line like "*.chm*" or process.parent.command_line like "*.cmd*" or process.parent.command_line like "*.hta*" or process.parent.command_line like "*.htm*" or process.parent.command_line like "*.html*" or process.parent.command_line like "*.js*" or process.parent.command_line like "*.lnk*" or process.parent.command_line like "*.ps1*" or process.parent.command_line like "*.vbe*" or process.parent.command_line like "*.vbs*" or process.parent.command_line like "*.wsf*" or process.parent.command_line like "*:\\Perflogs\\*" or process.parent.command_line like "*:\\Temp\\*" or process.parent.command_line like "*:\\Users\\Public\\*" or process.parent.command_line like "*:\\Windows\\Temp\\*" or process.parent.command_line like "*\\AppData\\Local\\Temp*" or process.parent.command_line like "*\\AppData\\Roaming\\*" or process.parent.command_line like "*\\Temporary Internet*" or process.parent.command_line like "*:\\Users\\*" and process.parent.command_line like "*\\Favorites\\*" or process.parent.command_line like "*:\\Users\\*" and process.parent.command_line like "*\\Favourites\\*" or process.parent.command_line like "*:\\Users\\*" and process.parent.command_line like "*\\Contacts\\*") and (process.parent.command_line like "*.bat*" or process.parent.command_line like "*.chm*" or process.parent.command_line like "*.cmd*" or process.parent.command_line like "*.hta*" or process.parent.command_line like "*.htm*" or process.parent.command_line like "*.html*" or process.parent.command_line like "*.js*" or process.parent.command_line like "*.lnk*" or process.parent.command_line like "*.ps1*" or process.parent.command_line like "*.vbe*" or process.parent.command_line like "*.vbs*" or process.parent.command_line like "*.wsf*") and (ends_with(process.executable.caseless, "\\PingCastle.exe") or process.pe.original_file_name=="PingCastle.exe" or process.pe.product=="Ping Castle" or process.command_line like "*--scanner aclcheck*" or process.command_line like "*--scanner antivirus*" or process.command_line like "*--scanner computerversion*" or process.command_line like "*--scanner foreignusers*" or process.command_line like "*--scanner laps_bitlocker*" or process.command_line like "*--scanner localadmin*" or process.command_line like "*--scanner nullsession*" or process.command_line like "*--scanner nullsession-trust*" or process.command_line like "*--scanner oxidbindings*" or process.command_line like "*--scanner remote*" or process.command_line like "*--scanner share*" or process.command_line like "*--scanner smb*" or process.command_line like "*--scanner smb3querynetwork*" or process.command_line like "*--scanner spooler*" or process.command_line like "*--scanner startup*" or process.command_line like "*--scanner zerologon*" or process.command_line like "*--no-enum-limit*" or process.command_line like "*--healthcheck*" and process.command_line like "*--level Full*" or process.command_line like "*--healthcheck*" and process.command_line like "*--server *")
