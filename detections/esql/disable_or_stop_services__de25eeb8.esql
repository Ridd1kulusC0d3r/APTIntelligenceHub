// Disable Or Stop Services | T1489, T1685 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_services_stop_and_disable.yml
from * metadata _id, _index, _version | where (ends_with(Image, "/service") or ends_with(Image, "/systemctl") or ends_with(Image, "/chkconfig")) and (CommandLine like "* stop *" or CommandLine like "* disable *") and not (ends_with(Image, "/systemctl") and (CommandLine like "*--no-reload disable snap-snapd-*" or CommandLine like "* stop snap-snapd-*") or ends_with(Image, "/systemctl") and ParentCommandLine like "*tmp.ci/preinst upgrade*" and CommandLine like "* stop *" and CommandLine like "*ssh.*" or ParentCommandLine like "*/dpkg/info/ubuntu-pro-client.prerm upgrade*" and ends_with(Image, "/systemctl")) and not (ends_with(Image, "/systemctl") and ends_with(CommandLine, "snap.amazon-ssm-agent.amazon-ssm-agent.service"))
