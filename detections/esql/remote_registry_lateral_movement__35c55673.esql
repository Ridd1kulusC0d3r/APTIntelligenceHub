// Remote Registry Lateral Movement | T1112 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/rpc_firewall/rpc_firewall_remote_registry_lateral_movement.yml
from * metadata _id, _index, _version | where EventLog=="RPCFW" and EventID==3 and InterfaceUuid=="338cd001-2244-31f1-aaaa-900038001003" and (OpNum in (6, 7, 8, 13, 18, 19, 21, 22, 23, 35))
