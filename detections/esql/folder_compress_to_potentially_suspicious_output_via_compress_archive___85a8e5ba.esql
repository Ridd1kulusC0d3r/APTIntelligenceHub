// Folder Compress To Potentially Suspicious Output Via Compress-Archive Cmdlet | T1074.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_zip_compress.yml
from * metadata _id, _index, _version | where process.command_line like "*Compress-Archive -Path*-DestinationPath $env:TEMP*" or process.command_line like "*Compress-Archive -Path*-DestinationPath*\\AppData\\Local\\Temp\\*" or process.command_line like "*Compress-Archive -Path*-DestinationPath*:\\Windows\\Temp\\*"
