// PUA - Crassus Execution | T1590.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_pua_crassus.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\Crassus.exe") or process.pe.original_file_name=="Crassus.exe" or process.pe.description like "*Crassus*"
