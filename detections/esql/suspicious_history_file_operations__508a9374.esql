// Suspicious History File Operations | T1552.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_susp_histfile_operations.yml
from * metadata _id, _index, _version | where CommandLine like "*.bash_history*" or CommandLine like "*.zsh_history*" or CommandLine like "*.zhistory*" or CommandLine like "*.history*" or CommandLine like "*.sh_history*" or CommandLine like "*fish_history*"
