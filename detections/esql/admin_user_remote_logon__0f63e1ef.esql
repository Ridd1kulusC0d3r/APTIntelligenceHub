// Admin User Remote Logon | T1078.001, T1078.002, T1078.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/account_management/win_security_admin_rdp_login.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="4624" and winlog.event_data.LogonType=="10" and winlog.event_data.AuthenticationPackageName=="Negotiate" and starts_with(winlog.event_data.TargetUserName, "Admin")
