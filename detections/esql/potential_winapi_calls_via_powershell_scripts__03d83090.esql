// Potential WinAPI Calls Via PowerShell Scripts | T1059.001, T1106, T1620 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_win_api_susp_access.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*VirtualAlloc*" and powershell.file.script_block_text like "*OpenProcess*" and powershell.file.script_block_text like "*WriteProcessMemory*" and powershell.file.script_block_text like "*CreateRemoteThread*" or powershell.file.script_block_text like "*OpenProcessToken*" and powershell.file.script_block_text like "*LookupPrivilegeValue*" and powershell.file.script_block_text like "*AdjustTokenPrivileges*" or powershell.file.script_block_text like "*OpenProcessToken*" and powershell.file.script_block_text like "*DuplicateTokenEx*" and powershell.file.script_block_text like "*CloseHandle*" or powershell.file.script_block_text like "*WriteProcessMemory*" and powershell.file.script_block_text like "*VirtualAlloc*" and powershell.file.script_block_text like "*ReadProcessMemory*" and powershell.file.script_block_text like "*VirtualFree*" or powershell.file.script_block_text like "*VirtualAlloc*" and powershell.file.script_block_text like "*GetDelegateForFunctionPointer*" and powershell.file.script_block_text like "*Marshal.Copy*"
