// Suspicious Download from Office Domain | T1105, T1608 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_download_office_domain.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\curl.exe") or ends_with(process.executable.caseless, "\\wget.exe") or process.command_line like "*Invoke-WebRequest*" or process.command_line like "*iwr *" or process.command_line like "*curl *" or process.command_line like "*wget *" or process.command_line like "*Start-BitsTransfer*" or process.command_line like "*.DownloadFile(*" or process.command_line like "*.DownloadString(*") and (process.command_line like "*https://attachment.outlook.live.net/owa/*" or process.command_line like "*https://onenoteonlinesync.onenote.com/onenoteonlinesync/*")
