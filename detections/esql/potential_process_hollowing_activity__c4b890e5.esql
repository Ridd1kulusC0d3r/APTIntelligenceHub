// Potential Process Hollowing Activity | T1055.012 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_tampering/proc_tampering_susp_process_hollowing.yml
from * metadata _id, _index, _version | where winlog.event_data.Type=="Image is replaced" and not (process.executable.caseless like "*:\\Program Files (x86)*" or process.executable.caseless like "*:\\Program Files\\*" or process.executable.caseless like "*:\\Windows\\System32\\wbem\\WMIADAP.exe*" or process.executable.caseless like "*:\\Windows\\SysWOW64\\wbem\\WMIADAP.exe*") and not (process.executable.caseless like "*\\AppData\\Local\\Programs\\Opera\\*" and ends_with(process.executable.caseless, "\\opera.exe") or ends_with(process.executable.caseless, "\\WindowsApps\\MicrosoftEdge.exe"))
