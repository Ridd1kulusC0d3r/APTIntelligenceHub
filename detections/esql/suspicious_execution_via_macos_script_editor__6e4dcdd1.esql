// Suspicious Execution via macOS Script Editor | T1059, T1059.002, T1204, T1204.001, T1553, T1566, T1566.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_susp_execution_macos_script_editor.yml
from * metadata _id, _index, _version | where ends_with(ParentImage, "/Script Editor") and (ends_with(Image, "/curl") or ends_with(Image, "/bash") or ends_with(Image, "/sh") or ends_with(Image, "/zsh") or ends_with(Image, "/dash") or ends_with(Image, "/fish") or ends_with(Image, "/osascript") or ends_with(Image, "/mktemp") or ends_with(Image, "/chmod") or ends_with(Image, "/php") or ends_with(Image, "/nohup") or ends_with(Image, "/openssl") or ends_with(Image, "/plutil") or ends_with(Image, "/PlistBuddy") or ends_with(Image, "/xattr") or ends_with(Image, "/sqlite") or ends_with(Image, "/funzip") or ends_with(Image, "/popen") or Image like "*python*" or Image like "*perl*")
