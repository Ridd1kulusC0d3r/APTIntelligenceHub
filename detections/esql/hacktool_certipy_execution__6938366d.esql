// HackTool - Certipy Execution | T1649 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_certipy.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\Certipy.exe") or process.pe.original_file_name=="Certipy.exe" or process.pe.description like "*Certipy*" or (process.command_line like "* account *" or process.command_line like "* auth *" or process.command_line like "* cert *" or process.command_line like "* find *" or process.command_line like "* forge *" or process.command_line like "* ptt *" or process.command_line like "* relay *" or process.command_line like "* req *" or process.command_line like "* shadow *" or process.command_line like "* template *") and (process.command_line like "* -bloodhound*" or process.command_line like "* -ca-pfx *" or process.command_line like "* -dc-ip *" or process.command_line like "* -kirbi*" or process.command_line like "* -old-bloodhound*" or process.command_line like "* -pfx *" or process.command_line like "* -target*" or process.command_line like "* -template*" or process.command_line like "* -username *" or process.command_line like "* -vulnerable*" or process.command_line like "*auth -pfx*" or process.command_line like "*shadow auto*" or process.command_line like "*shadow list*")
