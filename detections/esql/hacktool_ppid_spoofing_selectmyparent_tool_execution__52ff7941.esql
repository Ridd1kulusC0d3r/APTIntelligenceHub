// HackTool - PPID Spoofing SelectMyParent Tool Execution | T1134.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_selectmyparent.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\SelectMyParent.exe") or process.command_line like "*PPID-spoof*" or process.command_line like "*ppid_spoof*" or process.command_line like "*spoof-ppid*" or process.command_line like "*spoof_ppid*" or process.command_line like "*ppidspoof*" or process.command_line like "*spoofppid*" or process.command_line like "*spoofedppid*" or process.command_line like "* -spawnto *" or process.pe.original_file_name like "*PPID-spoof*" or process.pe.original_file_name like "*ppid_spoof*" or process.pe.original_file_name like "*spoof-ppid*" or process.pe.original_file_name like "*spoof_ppid*" or process.pe.original_file_name like "*ppidspoof*" or process.pe.original_file_name like "*spoofppid*" or process.pe.original_file_name like "*spoofedppid*" or process.pe.description=="SelectMyParent" or winlog.event_data.Hashes like "*IMPHASH=04D974875BD225F00902B4CAD9AF3FBC*" or winlog.event_data.Hashes like "*IMPHASH=A782AF154C9E743DDF3F3EB2B8F3D16E*" or winlog.event_data.Hashes like "*IMPHASH=89059503D7FBF470E68F7E63313DA3AD*" or winlog.event_data.Hashes like "*IMPHASH=CA28337632625C8281AB8A130B3D6BAD*"
