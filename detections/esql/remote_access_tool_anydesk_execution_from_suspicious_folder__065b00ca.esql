// Remote Access Tool - Anydesk Execution From Suspicious Folder | T1219.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_remote_access_tools_anydesk_susp_exec.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\AnyDesk.exe") or ends_with(process.executable.caseless, "\\AnyDeskMSI.exe") or process.pe.description=="AnyDesk" or process.pe.product=="AnyDesk" or process.pe.company=="AnyDesk Software GmbH") and not (process.executable.caseless like "*\\AppData\\*" or process.executable.caseless like "*Program Files (x86)\\AnyDesk*" or process.executable.caseless like "*Program Files\\AnyDesk*")
