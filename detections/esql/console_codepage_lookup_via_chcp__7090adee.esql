// Console CodePage Lookup Via CHCP | T1614.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_chcp_codepage_lookup.yml
from * metadata _id, _index, _version | where ends_with(process.parent.executable.caseless, "\\cmd.exe") and (process.parent.command_line like "* -c *" or process.parent.command_line like "* /c *" or process.parent.command_line like "* –c *" or process.parent.command_line like "* —c *" or process.parent.command_line like "* ―c *" or process.parent.command_line like "* -r *" or process.parent.command_line like "* /r *" or process.parent.command_line like "* –r *" or process.parent.command_line like "* —r *" or process.parent.command_line like "* ―r *" or process.parent.command_line like "* -k *" or process.parent.command_line like "* /k *" or process.parent.command_line like "* –k *" or process.parent.command_line like "* —k *" or process.parent.command_line like "* ―k *") and ends_with(process.executable.caseless, "\\chcp.com") and (ends_with(process.command_line, "chcp") or ends_with(process.command_line, "chcp ") or ends_with(process.command_line, "chcp  "))
