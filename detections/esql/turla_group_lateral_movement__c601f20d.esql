// Turla Group Lateral Movement | T1021.002, T1059, T1083, T1135 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2014/TA/Turla/proc_creation_win_apt_turla_commands_critical.yml
from * metadata _id, _index, _version | where starts_with(process.command_line, "net use \\\\%DomainController%\\C$ \"P@ssw0rd\" ") or process.command_line like "dir c:\\*.doc* /s" or process.command_line like "dir %TEMP%\\*.exe"
