// Disable Windows Firewall by Registry | T1686.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_disable_windows_firewall.yml
from * metadata _id, _index, _version | where (ends_with(registry.path, "\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\StandardProfile\\EnableFirewall") or ends_with(registry.path, "\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\DomainProfile\\EnableFirewall")) and winlog.event_data.Details=="DWORD (0x00000000)"
