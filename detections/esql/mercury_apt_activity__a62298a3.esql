// MERCURY APT Activity | T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2022/TA/MERCURY/proc_creation_win_apt_mercury.yml
from * metadata _id, _index, _version | where process.command_line like "*-exec bypass -w 1 -enc*" and process.command_line like "*UwB0AGEAcgB0AC0ASgBvAGIAIAAtAFMAYwByAGkAcAB0AEIAbABvAGMAawAgAHsAKABzAGEAcABzACAAKAAiAHAA*"
