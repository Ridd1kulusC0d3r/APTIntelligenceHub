// Forest Blizzard APT - File Creation Activity | T1685.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2024/TA/Forest-Blizzard/file_event_win_apt_forest_blizzard_activity.yml
from * metadata _id, _index, _version | where (starts_with(file.path, "C:\\ProgramData\\Microsoft\\v") or starts_with(file.path, "C:\\ProgramData\\Adobe\\v") or starts_with(file.path, "C:\\ProgramData\\Comms\\v") or starts_with(file.path, "C:\\ProgramData\\Intel\\v") or starts_with(file.path, "C:\\ProgramData\\Kaspersky Lab\\v") or starts_with(file.path, "C:\\ProgramData\\Bitdefender\\v") or starts_with(file.path, "C:\\ProgramData\\ESET\\v") or starts_with(file.path, "C:\\ProgramData\\NVIDIA\\v") or starts_with(file.path, "C:\\ProgramData\\UbiSoft\\v") or starts_with(file.path, "C:\\ProgramData\\Steam\\v")) and (file.path like "*\\prnms003.inf_*" or file.path like "*\\prnms009.inf_*") or starts_with(file.path, "C:\\ProgramData\\") and (ends_with(file.path, ".save") or ends_with(file.path, "\\doit.bat") or ends_with(file.path, "\\execute.bat") or ends_with(file.path, "\\servtask.bat") or file.path like "*\\wayzgoose*" and ends_with(file.path, ".dll"))
