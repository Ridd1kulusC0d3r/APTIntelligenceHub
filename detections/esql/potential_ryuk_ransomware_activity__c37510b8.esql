// Potential Ryuk Ransomware Activity | T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/Malware/Ryuk/proc_creation_win_malware_ryuk.yml
from * metadata _id, _index, _version | where process.command_line like "*Microsoft\\Windows\\CurrentVersion\\Run*" and process.command_line like "*C:\\users\\Public\\*" or process.command_line like "*del /s /f /q c:\\*" and process.command_line like "*\*.bac*" and process.command_line like "*\*.bak*" and process.command_line like "*\*.bkf*" or (ends_with(process.executable.caseless, "\\net.exe") or ends_with(process.executable.caseless, "\\net1.exe")) and process.command_line like "* stop *" and process.command_line like "* /y*" and (process.command_line like "*samss*" or process.command_line like "*audioendpointbuilder*" or process.command_line like "*unistoresvc_*" or process.command_line like "*AcrSch2Svc*")
