// ADFS Database Named Pipe Connection By Uncommon Tool | T1005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/pipe_created/pipe_created_adfs_namedpipe_connection_uncommon_tool.yml
from * metadata _id, _index, _version | where file.name=="\\MICROSOFT##WID\\tsql\\query" and not (ends_with(process.executable.caseless, ":\\Windows\\System32\\mmc.exe") or ends_with(process.executable.caseless, ":\\Windows\\system32\\svchost.exe") or ends_with(process.executable.caseless, ":\\Windows\\System32\\wsmprovhost.exe") or ends_with(process.executable.caseless, ":\\Windows\\SysWOW64\\mmc.exe") or ends_with(process.executable.caseless, ":\\Windows\\SysWOW64\\wsmprovhost.exe") or ends_with(process.executable.caseless, ":\\Windows\\WID\\Binn\\sqlwriter.exe") or ends_with(process.executable.caseless, "\\AzureADConnect.exe") or ends_with(process.executable.caseless, "\\Microsoft.Identity.Health.Adfs.PshSurrogate.exe") or ends_with(process.executable.caseless, "\\Microsoft.IdentityServer.ServiceHost.exe") or ends_with(process.executable.caseless, "\\Microsoft.Tri.Sensor.exe") or ends_with(process.executable.caseless, "\\sqlservr.exe") or ends_with(process.executable.caseless, "\\tssdis.exe"))
