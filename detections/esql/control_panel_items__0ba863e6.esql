// Control Panel Items | T1218.002, T1546 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_control_panel_item.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\reg.exe") or process.pe.original_file_name=="reg.exe") and process.command_line like "*add*" and process.command_line like "*CurrentVersion\\Control Panel\\CPLs*" or ends_with(process.command_line, ".cpl") and not (process.command_line like "*\\System32\\*" or process.command_line like "*%System%*" or process.command_line like "*|C:\\Windows\\system32|*" or process.command_line like "*regsvr32 *" and process.command_line like "* /s *" and process.command_line like "*igfxCPL.cpl*")
