// Renamed Visual Studio Code Tunnel Execution | T1071.001, T1219 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_vscode_tunnel_renamed_execution.yml
from * metadata _id, _index, _version | where (process.pe.original_file_name is null and ends_with(process.command_line, ".exe tunnel") or process.command_line like "*.exe tunnel*" and process.command_line like "*--accept-server-license-terms*" or process.command_line like "*tunnel *" and process.command_line like "*service*" and process.command_line like "*internal-run*" and process.command_line like "*tunnel-service.log*") and not (ends_with(process.executable.caseless, "\\code-tunnel.exe") or ends_with(process.executable.caseless, "\\code.exe")) or ends_with(process.parent.command_line, " tunnel") and ends_with(process.executable.caseless, "\\cmd.exe") and process.command_line like "*/d /c *" and process.command_line like "*\\servers\\Stable-*" and process.command_line like "*code-server.cmd*" and not (ends_with(process.parent.executable.caseless, "\\code-tunnel.exe") or ends_with(process.parent.executable.caseless, "\\code.exe"))
