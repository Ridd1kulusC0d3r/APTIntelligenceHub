// Session Manager Autorun Keys Modification | T1546.009, T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_asep_reg_keys_modification_session_manager.yml
from * metadata _id, _index, _version | where registry.path like "*\\System\\CurrentControlSet\\Control\\Session Manager*" and (registry.path like "*\\SetupExecute*" or registry.path like "*\\S0InitialCommand*" or registry.path like "*\\KnownDlls*" or registry.path like "*\\Execute*" or registry.path like "*\\BootExecute*" or registry.path like "*\\AppCertDlls*") and not winlog.event_data.Details=="(Empty)"
