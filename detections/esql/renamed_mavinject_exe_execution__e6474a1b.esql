// Renamed Mavinject.EXE Execution | T1055.001, T1218.013 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_renamed_mavinject.yml
from * metadata _id, _index, _version | where (process.pe.original_file_name in ("mavinject32.exe", "mavinject64.exe")) and not (ends_with(process.executable.caseless, "\\mavinject32.exe") or ends_with(process.executable.caseless, "\\mavinject64.exe"))
