// HackTool - Credential Dumping Tools Named Pipe Created | T1003.001, T1003.002, T1003.004, T1003.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/pipe_created/pipe_created_hktl_generic_cred_dump_tools_pipes.yml
from * metadata _id, _index, _version | where file.name like "*\\cachedump*" or file.name like "*\\lsadump*" or file.name like "*\\wceservicepipe*"
