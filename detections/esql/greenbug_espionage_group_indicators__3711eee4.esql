// Greenbug Espionage Group Indicators | T1036.005, T1059.001, T1105 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2020/TA/Greenbug/proc_creation_win_apt_greenbug_may20.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, ":\\ProgramData\\adobe\\Adobe.exe") or ends_with(process.executable.caseless, ":\\ProgramData\\oracle\\local.exe") or ends_with(process.executable.caseless, "\\revshell.exe") or ends_with(process.executable.caseless, "\\infopagesbackup\\ncat.exe") or ends_with(process.executable.caseless, ":\\ProgramData\\comms\\comms.exe") or process.command_line like "*-ExecutionPolicy Bypass -File*" and process.command_line like "*\\msf.ps1*" or process.command_line like "*infopagesbackup*" and process.command_line like "*\\ncat*" and process.command_line like "*-e cmd.exe*" or process.command_line like "*system.Data.SqlClient.SqlDataAdapter($cmd); [void]$da.fill*" or process.command_line like "*-nop -w hidden -c $k=new-object*" or process.command_line like "*[Net.CredentialCache]::DefaultCredentials;IEX *" or process.command_line like "* -nop -w hidden -c $m=new-object net.webclient;$m*" or process.command_line like "*-noninteractive -executionpolicy bypass whoami*" or process.command_line like "*-noninteractive -executionpolicy bypass netstat -a*" or process.command_line like "*L3NlcnZlcj1*"
