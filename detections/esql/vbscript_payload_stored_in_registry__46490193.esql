// VBScript Payload Stored in Registry | T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_vbs_payload_stored.yml
from * metadata _id, _index, _version | where registry.path like "*Software\\Microsoft\\Windows\\CurrentVersion*" and (winlog.event_data.Details like "*vbscript:*" or winlog.event_data.Details like "*jscript:*" or winlog.event_data.Details like "*mshtml,*" or winlog.event_data.Details like "*RunHTMLApplication*" or winlog.event_data.Details like "*Execute(*" or winlog.event_data.Details like "*CreateObject*" or winlog.event_data.Details like "*window.close*") and not (registry.path like "*Software\\Microsoft\\Windows\\CurrentVersion\\Run*" or ends_with(process.executable.caseless, "\\msiexec.exe") and registry.path like "*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Installer\\UserData\\*" and (winlog.event_data.Details like "*\\Microsoft.NET\\Primary Interop Assemblies\\Microsoft.mshtml.dll*" or winlog.event_data.Details like "*<\\Microsoft.mshtml,fileVersion=*" or winlog.event_data.Details like "*_mshtml_dll_*" or winlog.event_data.Details like "*<\\Microsoft.mshtml,culture=*"))
