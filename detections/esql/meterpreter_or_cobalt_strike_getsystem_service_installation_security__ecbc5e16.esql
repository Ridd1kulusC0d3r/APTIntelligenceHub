// Meterpreter or Cobalt Strike Getsystem Service Installation - Security | T1134.001, T1134.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_meterpreter_or_cobaltstrike_getsystem_service_install.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="4697" and (winlog.event_data.ServiceFileName like "*/c*" and winlog.event_data.ServiceFileName like "*echo*" and winlog.event_data.ServiceFileName like "*\\pipe\\*" and (winlog.event_data.ServiceFileName like "*cmd*" or winlog.event_data.ServiceFileName like "*%COMSPEC%*") or winlog.event_data.ServiceFileName like "*rundll32*" and winlog.event_data.ServiceFileName like "*.dll,a*" and winlog.event_data.ServiceFileName like "*/p:*" or starts_with(winlog.event_data.ServiceFileName, "\\\\127.0.0.1\\ADMIN$\\"))
