// Successful Account Login Via WMI | T1047 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/account_management/win_security_susp_wmi_login.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="4624" and ends_with(process.executable.caseless, "\\WmiPrvSE.exe")
