// Lazarus APT DLL Sideloading Activity | T1574.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/TA/Lazarus/image_load_apt_lazarus_side_load_activity.yml
from * metadata _id, _index, _version | where process.executable.caseless=="C:\\ProgramShared\\PresentationHost.exe" and ends_with(file.path, ":\\ProgramShared\\mscoree.dll") or process.executable.caseless=="C:\\ProgramData\\Adobe\\colorcpl.exe" and file.path=="C:\\ProgramData\\Adobe\\colorui.dll" or process.executable.caseless=="C:\\ProgramData\\Oracle\\Java\\fixmapi.exe" and file.path=="C:\\ProgramData\\Oracle\\Java\\mapistub.dll" or process.executable.caseless=="C:\\ProgramData\\Adobe\\ARM\\tabcal.exe" and file.path=="C:\\ProgramData\\Adobe\\ARM\\HID.dll"
