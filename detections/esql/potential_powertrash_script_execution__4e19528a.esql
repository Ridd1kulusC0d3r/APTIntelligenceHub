// Potential POWERTRASH Script Execution | T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/TA/FIN7/posh_ps_apt_fin7_powertrash_execution.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*IO.Compression.DeflateStream*" and powershell.file.script_block_text like "*IO.MemoryStream*" and powershell.file.script_block_text like "*::FromBase64String*" and powershell.file.script_block_text like "*GetDelegateForFunctionPointer*" and powershell.file.script_block_text like "*.Invoke()*" and powershell.file.script_block_text like "*GlobalAssemblyCache*"
