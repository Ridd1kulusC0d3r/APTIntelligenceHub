// Suspicious Double Extension Files | T1036.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_double_extension.yml
from * metadata _id, _index, _version | where (file.path rlike "(?i)\\.(docx?|gif|jpe?g|mp3|mp4|pdf|png|pptx?|rtf|svg|txt|xlsx?)\\.(bat|exe|iso|rar|svg|vbe|vbs|zip)$" or ends_with(file.path, ".rar.exe") or ends_with(file.path, ".zip.exe")) and not (ends_with(file.path, ".svg.svg") or ends_with(file.path, ".png.svg") or ends_with(file.path, ".jpg.svg") or ends_with(file.path, ".jpeg.svg")) and not starts_with(file.path, "/usr/share/icons/")
