// HackTool - CrackMapExec PowerShell Obfuscation | T1027.005, T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_crackmapexec_powershell_obfuscation.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\pwsh.exe") or process.pe.original_file_name in ("PowerShell.EXE", "pwsh.dll")) and (process.command_line like "*join*split*" or process.command_line like "*( $ShellId[1]+$ShellId[13]+'x')*" or process.command_line like "*( $PSHome[*]+$PSHOME[*]+*" or process.command_line like "*( $env:Public[13]+$env:Public[5]+'x')*" or process.command_line like "*( $env:ComSpec[4,*,25]-Join'')*" or process.command_line like "*[1,3]+'x'-Join'')*")
