// Data Staging With RAR Using Password And Archive Splitting | T1560.001 | Hub
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\rar.exe") or ends_with(process.executable.caseless, "\\winrar.exe") or process.pe.original_file_name=="Command line RAR") and (process.command_line like "* -hp*" or process.command_line like "* -p*") and process.command_line like "* -v*"
