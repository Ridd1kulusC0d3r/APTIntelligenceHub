// Monero Crypto Coin Mining Pool Lookup | T1496, T1567 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/dns/net_dns_pua_cryptocoin_mining_xmr.yml
from * metadata _id, _index, _version | where query like "*pool.minexmr.com*" or query like "*fr.minexmr.com*" or query like "*de.minexmr.com*" or query like "*sg.minexmr.com*" or query like "*ca.minexmr.com*" or query like "*us-west.minexmr.com*" or query like "*pool.supportxmr.com*" or query like "*mine.c3pool.com*" or query like "*xmr-eu1.nanopool.org*" or query like "*xmr-eu2.nanopool.org*" or query like "*xmr-us-east1.nanopool.org*" or query like "*xmr-us-west1.nanopool.org*" or query like "*xmr-asia1.nanopool.org*" or query like "*xmr-jp1.nanopool.org*" or query like "*xmr-au1.nanopool.org*" or query like "*xmr.2miners.com*" or query like "*xmr.hashcity.org*" or query like "*xmr.f2pool.com*" or query like "*xmrpool.eu*" or query like "*pool.hashvault.pro*"
