// Pass the Hash Activity 2 | T1550.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/account_management/win_security_pass_the_hash_2.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and (event.code=="4624" and user.id=="S-1-0-0" and winlog.event_data.LogonType=="3" and winlog.event_data.LogonProcessName=="NtLmSsp" and winlog.event_data.KeyLength=="0" or event.code=="4624" and winlog.event_data.LogonType=="9" and winlog.event_data.LogonProcessName=="seclogo") and not winlog.event_data.TargetUserName=="ANONYMOUS LOGON"
