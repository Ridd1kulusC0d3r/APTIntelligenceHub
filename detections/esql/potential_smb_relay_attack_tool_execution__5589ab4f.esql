// Potential SMB Relay Attack Tool Execution | T1557.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_relay_attacks_tools.yml
from * metadata _id, _index, _version | where (process.executable.caseless like "*PetitPotam*" or process.executable.caseless like "*RottenPotato*" or process.executable.caseless like "*HotPotato*" or process.executable.caseless like "*JuicyPotato*" or process.executable.caseless like "*\\just_dce_*" or process.executable.caseless like "*Juicy Potato*" or process.executable.caseless like "*\\temp\\rot.exe*" or process.executable.caseless like "*\\Potato.exe*" or process.executable.caseless like "*\\SpoolSample.exe*" or process.executable.caseless like "*\\Responder.exe*" or process.executable.caseless like "*\\smbrelayx*" or process.executable.caseless like "*\\ntlmrelayx*" or process.executable.caseless like "*\\LocalPotato*" or process.command_line like "*Invoke-Tater*" or process.command_line like "* smbrelay*" or process.command_line like "* ntlmrelay*" or process.command_line like "*cme smb *" or process.command_line like "* /ntlm:NTLMhash *" or process.command_line like "*Invoke-PetitPotam*" or process.command_line like "*.exe -t * -p *" or process.command_line like "*.exe -c \"{*" and ends_with(process.command_line, "}\" -z")) and not (process.executable.caseless like "*HotPotatoes6*" or process.executable.caseless like "*HotPotatoes7*" or process.executable.caseless like "*HotPotatoes *")
