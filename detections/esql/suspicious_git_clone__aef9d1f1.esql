// Suspicious Git Clone | T1593.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_git_susp_clone.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\git.exe") or ends_with(process.executable.caseless, "\\git-remote-https.exe") or process.pe.original_file_name=="git.exe") and (process.command_line like "* clone *" or process.command_line like "*git-remote-https *") and (process.command_line like "*exploit*" or process.command_line like "*Vulns*" or process.command_line like "*vulnerability*" or process.command_line like "*RemoteCodeExecution*" or process.command_line like "*Invoke-*" or process.command_line like "*CVE-*" or process.command_line like "*poc-*" or process.command_line like "*ProofOfConcept*" or process.command_line like "*proxyshell*" or process.command_line like "*log4shell*" or process.command_line like "*eternalblue*" or process.command_line like "*eternal-blue*" or process.command_line like "*MS17-*")
