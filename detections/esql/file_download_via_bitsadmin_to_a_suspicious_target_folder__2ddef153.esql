// File Download Via Bitsadmin To A Suspicious Target Folder | T1036.003, T1105, T1197 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_bitsadmin_download_susp_targetfolder.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\bitsadmin.exe") or process.pe.original_file_name=="bitsadmin.exe") and (process.command_line like "* /transfer *" or process.command_line like "* /create *" or process.command_line like "* /addfile *") and (process.command_line like "*:\\Perflogs*" or process.command_line like "*:\\ProgramData\\*" or process.command_line like "*:\\Temp\\*" or process.command_line like "*:\\Users\\Public\\*" or process.command_line like "*:\\Windows\\*" or process.command_line like "*\\$Recycle.Bin\\*" or process.command_line like "*\\AppData\\Local\\*" or process.command_line like "*\\AppData\\Roaming\\*" or process.command_line like "*\\Contacts\\*" or process.command_line like "*\\Desktop\\*" or process.command_line like "*\\Favorites\\*" or process.command_line like "*\\Favourites\\*" or process.command_line like "*\\inetpub\\wwwroot\\*" or process.command_line like "*\\Music\\*" or process.command_line like "*\\Pictures\\*" or process.command_line like "*\\Start Menu\\Programs\\Startup\\*" or process.command_line like "*\\Users\\Default\\*" or process.command_line like "*\\Videos\\*" or process.command_line like "*%ProgramData%*" or process.command_line like "*%public%*" or process.command_line like "*%temp%*" or process.command_line like "*%tmp%*")
