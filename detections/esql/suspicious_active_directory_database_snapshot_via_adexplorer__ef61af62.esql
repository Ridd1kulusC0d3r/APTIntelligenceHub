// Suspicious Active Directory Database Snapshot Via ADExplorer | T1069.002, T1087.002, T1482 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_sysinternals_adexplorer_susp_execution.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\ADExp.exe") or ends_with(process.executable.caseless, "\\ADExplorer.exe") or ends_with(process.executable.caseless, "\\ADExplorer64.exe") or ends_with(process.executable.caseless, "\\ADExplorer64a.exe") or process.pe.original_file_name=="AdExp" or process.pe.description=="Active Directory Editor" or process.pe.product=="Sysinternals ADExplorer") and process.command_line like "*snapshot*" and (process.command_line like "*\\Downloads\\*" or process.command_line like "*\\Users\\Public\\*" or process.command_line like "*\\AppData\\*" or process.command_line like "*\\Windows\\Temp\\*")
