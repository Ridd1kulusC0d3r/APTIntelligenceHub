// Suspicious PowerShell WindowStyle Option | T1564.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_susp_windowstyle.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*powershell*" and powershell.file.script_block_text like "*WindowStyle*" and powershell.file.script_block_text like "*Hidden*" and not (powershell.file.script_block_text like "*:\\Program Files\\Amazon\\WorkSpacesConfig\\Scripts\\*" and powershell.file.script_block_text like "*$PSScriptRoot\\Module\\WorkspaceScriptModule\\WorkspaceScriptModule*")
