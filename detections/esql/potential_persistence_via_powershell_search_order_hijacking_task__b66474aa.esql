// Potential Persistence Via Powershell Search Order Hijacking - Task | T1053.005, T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_schtasks_powershell_persistence.yml
from * metadata _id, _index, _version | where process.parent.executable.caseless=="C:\\WINDOWS\\System32\\svchost.exe" and process.parent.command_line like "*-k netsvcs*" and process.parent.command_line like "*-s Schedule*" and (ends_with(process.command_line, " -windowstyle hidden") or ends_with(process.command_line, " -w hidden") or ends_with(process.command_line, " -ep bypass") or ends_with(process.command_line, " -noni"))
