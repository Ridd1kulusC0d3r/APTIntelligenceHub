// Sticky Key Like Backdoor Execution | T1546.008 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_cmd_sticky_key_like_backdoor_execution.yml
from * metadata _id, _index, _version | where ends_with(process.parent.executable.caseless, "\\winlogon.exe") and (ends_with(process.executable.caseless, "\\cmd.exe") or ends_with(process.executable.caseless, "\\cscript.exe") or ends_with(process.executable.caseless, "\\mshta.exe") or ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\pwsh.exe") or ends_with(process.executable.caseless, "\\regsvr32.exe") or ends_with(process.executable.caseless, "\\rundll32.exe") or ends_with(process.executable.caseless, "\\wscript.exe") or ends_with(process.executable.caseless, "\\wt.exe")) and (process.command_line like "*sethc.exe*" or process.command_line like "*utilman.exe*" or process.command_line like "*osk.exe*" or process.command_line like "*Magnify.exe*" or process.command_line like "*Narrator.exe*" or process.command_line like "*DisplaySwitch.exe*")
