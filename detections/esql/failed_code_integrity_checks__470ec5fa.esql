// Failed Code Integrity Checks | T1027.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_codeintegrity_check_failure.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and (event.code in ("5038", "6281")) and not (winlog.event_data.param1 like "*\\CSFalconServiceUninstallTool_*" or winlog.event_data.param1 like "*\\Program Files\\CrowdStrike\\*" or winlog.event_data.param1 like "*\\System32\\drivers\\CrowdStrike\\*" or winlog.event_data.param1 like "*\\Windows\\System32\\ScriptControl64_*" or winlog.event_data.param1 like "*\\Program Files\\Sophos\\*")
