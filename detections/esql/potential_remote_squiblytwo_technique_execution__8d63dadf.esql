// Potential Remote SquiblyTwo Technique Execution | T1047, T1059.005, T1059.007, T1220 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_wmic_squiblytwo_bypass.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\wmic.exe") or process.pe.original_file_name=="wmic.exe" or winlog.event_data.Hashes like "*IMPHASH=1B1A3F43BF37B5BFE60751F2EE2F326E*" or winlog.event_data.Hashes like "*IMPHASH=37777A96245A3C74EB217308F3546F4C*" or winlog.event_data.Hashes like "*IMPHASH=9D87C9D67CE724033C0B40CC4CA1B206*" or winlog.event_data.Hashes like "*IMPHASH=B12619881D79C3ACADF45E752A58554A*" or winlog.event_data.Hashes like "*IMPHASH=16A48C3CABF98A9DC1BF02C07FE1EA00*") and (process.command_line like "*-format:*" or process.command_line like "*/format:*" or process.command_line like "*–format:*" or process.command_line like "*—format:*" or process.command_line like "*―format:*") and (process.command_line like "*://*" or process.command_line like "*\\\\*")
