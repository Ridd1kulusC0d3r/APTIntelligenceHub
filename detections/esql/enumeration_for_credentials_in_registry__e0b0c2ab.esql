// Enumeration for Credentials in Registry | T1552.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_reg_enumeration_for_credentials_in_registry.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\reg.exe") and process.command_line like "* query *" and process.command_line like "*/t *" and process.command_line like "*REG_SZ*" and process.command_line like "*/s*" and (process.command_line like "*/f *" and process.command_line like "*HKLM*" or process.command_line like "*/f *" and process.command_line like "*HKCU*" or process.command_line like "*HKCU\\Software\\SimonTatham\\PuTTY\\Sessions*")
