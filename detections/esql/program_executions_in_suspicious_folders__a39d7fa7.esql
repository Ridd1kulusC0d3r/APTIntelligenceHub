// Program Executions in Suspicious Folders | T1584, T1587 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/syscall/lnx_auditd_susp_exe_folders.yml
from * metadata _id, _index, _version | where type=="SYSCALL" and (starts_with(exe, "/tmp/") or starts_with(exe, "/var/www/") or exe like "/home/*/public_html/*" or starts_with(exe, "/usr/local/apache2/") or starts_with(exe, "/usr/local/httpd/") or starts_with(exe, "/var/apache/") or starts_with(exe, "/srv/www/") or starts_with(exe, "/home/httpd/html/") or starts_with(exe, "/srv/http/") or starts_with(exe, "/usr/share/nginx/html/") or starts_with(exe, "/var/lib/pgsql/data/") or starts_with(exe, "/usr/local/mysql/data/") or starts_with(exe, "/var/lib/mysql/") or starts_with(exe, "/var/vsftpd/") or starts_with(exe, "/etc/bind/") or starts_with(exe, "/var/named/"))
