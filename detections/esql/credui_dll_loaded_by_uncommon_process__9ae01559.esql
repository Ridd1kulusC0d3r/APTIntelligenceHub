// CredUI.DLL Loaded By Uncommon Process | T1056.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/image_load/image_load_dll_credui_uncommon_process_load.yml
from * metadata _id, _index, _version | where (ends_with(file.path, "\\credui.dll") or ends_with(file.path, "\\wincredui.dll") or file.pe.original_file_name in ("credui.dll", "wincredui.dll")) and not (starts_with(process.executable.caseless, "C:\\Program Files (x86)\\") or starts_with(process.executable.caseless, "C:\\Program Files\\") or starts_with(process.executable.caseless, "C:\\Windows\\System32\\") or starts_with(process.executable.caseless, "C:\\Windows\\SysWOW64\\") or starts_with(process.executable.caseless, "C:\\Windows\\SystemApps\\") or process.executable.caseless in ("C:\\Windows\\explorer.exe", "C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe", "C:\\Windows\\regedit.exe")) and not (ends_with(process.executable.caseless, "\\opera_autoupdate.exe") or ends_with(process.executable.caseless, "\\procexp64.exe") or ends_with(process.executable.caseless, "\\procexp64a.exe") or ends_with(process.executable.caseless, "\\procexp.exe") or starts_with(process.executable.caseless, "C:\\Users\\") and process.executable.caseless like "*\\AppData\\Local\\Microsoft\\Teams\\*" and ends_with(process.executable.caseless, "\\Teams.exe") or starts_with(process.executable.caseless, "C:\\Users\\") and process.executable.caseless like "*\\AppData\\Local\\Microsoft\\OneDrive\\*")
