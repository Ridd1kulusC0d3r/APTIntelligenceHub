// External Remote SMB Logon from Public IP | T1078, T1110, T1133 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/account_management/win_security_successful_external_remote_smb_login.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="4624" and winlog.event_data.LogonType=="3" and not (cidr_match(source.ip, "::1/128") or cidr_match(source.ip, "10.0.0.0/8") or cidr_match(source.ip, "127.0.0.0/8") or cidr_match(source.ip, "172.16.0.0/12") or cidr_match(source.ip, "192.168.0.0/16") or cidr_match(source.ip, "169.254.0.0/16") or cidr_match(source.ip, "fc00::/7") or cidr_match(source.ip, "fe80::/10") or source.ip is null or source.ip in ("-", ""))
