// TAIDOOR RAT DLL Load | T1055.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2020/TA/TAIDOOR-RAT/proc_creation_win_apt_taidoor.yml
from * metadata _id, _index, _version | where process.command_line like "*dll,MyStart*" or process.command_line like "*dll MyStart*" or ends_with(process.command_line, " MyStart") and process.command_line like "*rundll32.exe*"
