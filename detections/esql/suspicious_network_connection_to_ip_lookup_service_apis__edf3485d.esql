// Suspicious Network Connection to IP Lookup Service APIs | T1016 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_domain_external_ip_lookup.yml
from * metadata _id, _index, _version | where (destination.domain in ("www.ip.cn", "l2.io") or destination.domain like "*api.2ip.ua*" or destination.domain like "*api.bigdatacloud.net*" or destination.domain like "*api.ipify.org*" or destination.domain like "*bot.whatismyipaddress.com*" or destination.domain like "*canireachthe.net*" or destination.domain like "*checkip.amazonaws.com*" or destination.domain like "*checkip.dyndns.org*" or destination.domain like "*curlmyip.com*" or destination.domain like "*db-ip.com*" or destination.domain like "*edns.ip-api.com*" or destination.domain like "*eth0.me*" or destination.domain like "*freegeoip.app*" or destination.domain like "*geoipy.com*" or destination.domain like "*getip.pro*" or destination.domain like "*icanhazip.com*" or destination.domain like "*ident.me*" or destination.domain like "*ifconfig.io*" or destination.domain like "*ifconfig.me*" or destination.domain like "*ip-api.com*" or destination.domain like "*ip.360.cn*" or destination.domain like "*ip.anysrc.net*" or destination.domain like "*ip.taobao.com*" or destination.domain like "*ip.tyk.nu*" or destination.domain like "*ipaddressworld.com*" or destination.domain like "*ipapi.co*" or destination.domain like "*ipconfig.io*" or destination.domain like "*ipecho.net*" or destination.domain like "*ipinfo.io*" or destination.domain like "*ipip.net*" or destination.domain like "*ipof.in*" or destination.domain like "*ipv4.icanhazip.com*" or destination.domain like "*ipv4bot.whatismyipaddress.com*" or destination.domain like "*ipv6-test.com*" or destination.domain like "*ipwho.is*" or destination.domain like "*jsonip.com*" or destination.domain like "*myexternalip.com*" or destination.domain like "*seeip.org*" or destination.domain like "*wgetip.com*" or destination.domain like "*whatismyip.akamai.com*" or destination.domain like "*whois.pconline.com.cn*" or destination.domain like "*wtfismyip.com*") and not (ends_with(process.executable.caseless, "\\brave.exe") or process.executable.caseless in ("C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe") or process.executable.caseless in ("C:\\Program Files\\Mozilla Firefox\\firefox.exe", "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe") or process.executable.caseless in ("C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe", "C:\\Program Files\\Internet Explorer\\iexplore.exe") or ends_with(process.executable.caseless, "\\maxthon.exe") or starts_with(process.executable.caseless, "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or ends_with(process.executable.caseless, "\\WindowsApps\\MicrosoftEdge.exe") or process.executable.caseless in ("C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe", "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe") or (starts_with(process.executable.caseless, "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\") or starts_with(process.executable.caseless, "C:\\Program Files\\Microsoft\\EdgeCore\\")) and (ends_with(process.executable.caseless, "\\msedge.exe") or ends_with(process.executable.caseless, "\\msedgewebview2.exe")) or ends_with(process.executable.caseless, "\\opera.exe") or ends_with(process.executable.caseless, "\\safari.exe") or ends_with(process.executable.caseless, "\\seamonkey.exe") or ends_with(process.executable.caseless, "\\vivaldi.exe") or ends_with(process.executable.caseless, "\\whale.exe"))
