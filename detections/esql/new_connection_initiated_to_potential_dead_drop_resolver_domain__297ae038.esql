// New Connection Initiated To Potential Dead Drop Resolver Domain | T1102, T1102.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_domain_dead_drop_resolvers.yml
from * metadata _id, _index, _version | where network.direction=="true" and (ends_with(destination.domain, ".t.me") or ends_with(destination.domain, "0x0.st") or ends_with(destination.domain, "4shared.com") or ends_with(destination.domain, "abuse.ch") or ends_with(destination.domain, "anonfiles.com") or ends_with(destination.domain, "bashupload.com") or ends_with(destination.domain, "cdn.discordapp.com") or ends_with(destination.domain, "chunk.io") or ends_with(destination.domain, "cloudflare.com") or ends_with(destination.domain, "ddns.net") or ends_with(destination.domain, "discord.com") or ends_with(destination.domain, "docs.google.com") or ends_with(destination.domain, "drive.google.com") or ends_with(destination.domain, "dropbox.com") or ends_with(destination.domain, "dropmefiles.com") or ends_with(destination.domain, "facebook.com") or ends_with(destination.domain, "feeds.rapidfeeds.com") or ends_with(destination.domain, "fotolog.com") or ends_with(destination.domain, "ghostbin.co/") or ends_with(destination.domain, "githubusercontent.com") or ends_with(destination.domain, "gofile.io") or ends_with(destination.domain, "hastebin.com") or ends_with(destination.domain, "imgur.com") or ends_with(destination.domain, "livejournal.com") or ends_with(destination.domain, "mediafire.com") or ends_with(destination.domain, "mega.co.nz") or ends_with(destination.domain, "mega.nz") or ends_with(destination.domain, "onedrive.com") or ends_with(destination.domain, "pages.dev") or ends_with(destination.domain, "paste.ee") or ends_with(destination.domain, "pastebin.com") or ends_with(destination.domain, "pastebin.pl") or ends_with(destination.domain, "pastetext.net") or ends_with(destination.domain, "pixeldrain.com") or ends_with(destination.domain, "privatlab.com") or ends_with(destination.domain, "privatlab.net") or ends_with(destination.domain, "reddit.com") or ends_with(destination.domain, "send.exploit.in") or ends_with(destination.domain, "sendspace.com") or ends_with(destination.domain, "steamcommunity.com") or ends_with(destination.domain, "storage.googleapis.com") or ends_with(destination.domain, "technet.microsoft.com") or ends_with(destination.domain, "temp.sh") or ends_with(destination.domain, "transfer.sh") or ends_with(destination.domain, "trycloudflare.com") or ends_with(destination.domain, "twitter.com") or ends_with(destination.domain, "ufile.io") or ends_with(destination.domain, "vimeo.com") or ends_with(destination.domain, "w3spaces.com") or ends_with(destination.domain, "wetransfer.com") or ends_with(destination.domain, "workers.dev") or ends_with(destination.domain, "x0.at") or ends_with(destination.domain, "youtube.com")) and not (process.executable.caseless in ("C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe") or starts_with(process.executable.caseless, "C:\\Users\\") and ends_with(process.executable.caseless, "\\AppData\\Local\\Google\\Chrome\\Application\\chrome.exe") or process.executable.caseless in ("C:\\Program Files\\Mozilla Firefox\\firefox.exe", "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe") or starts_with(process.executable.caseless, "C:\\Users\\") and ends_with(process.executable.caseless, "\\AppData\\Local\\Mozilla Firefox\\firefox.exe") or process.executable.caseless in ("C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe", "C:\\Program Files\\Internet Explorer\\iexplore.exe") or starts_with(process.executable.caseless, "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or ends_with(process.executable.caseless, "\\WindowsApps\\MicrosoftEdge.exe") or process.executable.caseless in ("C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe", "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe") or (starts_with(process.executable.caseless, "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\") or starts_with(process.executable.caseless, "C:\\Program Files\\Microsoft\\EdgeCore\\")) and (ends_with(process.executable.caseless, "\\msedge.exe") or ends_with(process.executable.caseless, "\\msedgewebview2.exe")) or (process.executable.caseless like "*C:\\Program Files (x86)\\Safari\\*" or process.executable.caseless like "*C:\\Program Files\\Safari\\*") and ends_with(process.executable.caseless, "\\safari.exe") or (process.executable.caseless like "*C:\\Program Files\\Windows Defender Advanced Threat Protection\\*" or process.executable.caseless like "*C:\\Program Files\\Windows Defender\\*" or process.executable.caseless like "*C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*") and (ends_with(process.executable.caseless, "\\MsMpEng.exe") or ends_with(process.executable.caseless, "\\MsSense.exe")) or ends_with(process.executable.caseless, "C:\\Program Files (x86)\\PRTG Network Monitor\\PRTG Probe.exe") or ends_with(process.executable.caseless, "C:\\Program Files\\PRTG Network Monitor\\PRTG Probe.exe") or starts_with(process.executable.caseless, "C:\\Program Files\\BraveSoftware\\") and ends_with(process.executable.caseless, "\\brave.exe") or process.executable.caseless like "*\\AppData\\Local\\Maxthon\\*" and ends_with(process.executable.caseless, "\\maxthon.exe") or process.executable.caseless like "*\\AppData\\Local\\Programs\\Opera\\*" and ends_with(process.executable.caseless, "\\opera.exe") or (starts_with(process.executable.caseless, "C:\\Program Files\\SeaMonkey\\") or starts_with(process.executable.caseless, "C:\\Program Files (x86)\\SeaMonkey\\")) and ends_with(process.executable.caseless, "\\seamonkey.exe") or process.executable.caseless like "*\\AppData\\Local\\Vivaldi\\*" and ends_with(process.executable.caseless, "\\vivaldi.exe") or (starts_with(process.executable.caseless, "C:\\Program Files\\Naver\\Naver Whale\\") or starts_with(process.executable.caseless, "C:\\Program Files (x86)\\Naver\\Naver Whale\\")) and ends_with(process.executable.caseless, "\\whale.exe") or (starts_with(process.executable.caseless, "C:\\Program Files\\Waterfox\\") or starts_with(process.executable.caseless, "C:\\Program Files (x86)\\Waterfox\\")) and ends_with(process.executable.caseless, "\\Waterfox.exe") or process.executable.caseless like "*\\AppData\\Local\\Programs\\midori-ng\\*" and ends_with(process.executable.caseless, "\\Midori Next Generation.exe") or (starts_with(process.executable.caseless, "C:\\Program Files\\SlimBrowser\\") or starts_with(process.executable.caseless, "C:\\Program Files (x86)\\SlimBrowser\\")) and ends_with(process.executable.caseless, "\\slimbrowser.exe") or process.executable.caseless like "*\\AppData\\Local\\Flock\\*" and ends_with(process.executable.caseless, "\\Flock.exe") or process.executable.caseless like "*\\AppData\\Local\\Phoebe\\*" and ends_with(process.executable.caseless, "\\Phoebe.exe") or (starts_with(process.executable.caseless, "C:\\Program Files\\Falkon\\") or starts_with(process.executable.caseless, "C:\\Program Files (x86)\\Falkon\\")) and ends_with(process.executable.caseless, "\\falkon.exe") or (starts_with(process.executable.caseless, "C:\\Program Files (x86)\\QtWeb\\") or starts_with(process.executable.caseless, "C:\\Program Files\\QtWeb\\")) and ends_with(process.executable.caseless, "\\QtWeb.exe") or (starts_with(process.executable.caseless, "C:\\Program Files (x86)\\Avant Browser\\") or starts_with(process.executable.caseless, "C:\\Program Files\\Avant Browser\\")) and ends_with(process.executable.caseless, "\\avant.exe") or (starts_with(process.executable.caseless, "C:\\Program Files (x86)\\WindowsApps\\") or starts_with(process.executable.caseless, "C:\\Program Files\\WindowsApps\\")) and ends_with(process.executable.caseless, "\\WhatsApp.exe") and ends_with(destination.domain, "facebook.com") or process.executable.caseless like "*\\AppData\\Roaming\\Telegram Desktop\\*" and ends_with(process.executable.caseless, "\\Telegram.exe") and ends_with(destination.domain, ".t.me") or process.executable.caseless like "*\\AppData\\Local\\Microsoft\\OneDrive\\*" and ends_with(process.executable.caseless, "\\OneDrive.exe") and ends_with(destination.domain, "onedrive.com") or (starts_with(process.executable.caseless, "C:\\Program Files (x86)\\Dropbox\\Client\\") or starts_with(process.executable.caseless, "C:\\Program Files\\Dropbox\\Client\\")) and (ends_with(process.executable.caseless, "\\Dropbox.exe") or ends_with(process.executable.caseless, "\\DropboxInstaller.exe")) and ends_with(destination.domain, "dropbox.com") or (ends_with(process.executable.caseless, "\\MEGAsync.exe") or process.executable.caseless like "*\\MEGAsyncSetup32_*RC.exe" or ends_with(process.executable.caseless, "\\MEGAsyncSetup32.exe") or ends_with(process.executable.caseless, "\\MEGAsyncSetup64.exe") or ends_with(process.executable.caseless, "\\MEGAupdater.exe")) and (ends_with(destination.domain, "mega.co.nz") or ends_with(destination.domain, "mega.nz")) or (process.executable.caseless like "*C:\\Program Files\\Google\\Drive File Stream\\*" or process.executable.caseless like "*C:\\Program Files (x86)\\Google\\Drive File Stream\\*") and ends_with(process.executable.caseless, "GoogleDriveFS.exe") and ends_with(destination.domain, "drive.google.com") or process.executable.caseless like "*\\AppData\\Local\\Discord\\*" and ends_with(process.executable.caseless, "\\Discord.exe") and (ends_with(destination.domain, "discord.com") or ends_with(destination.domain, "cdn.discordapp.com")) or process.executable.caseless is null or process.executable.caseless=="")
