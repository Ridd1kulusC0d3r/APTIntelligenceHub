// HackTool - CrackMapExec Execution Patterns | T1047, T1053, T1059.001, T1059.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_crackmapexec_execution_patterns.yml
from * metadata _id, _index, _version | where process.command_line like "*cmd.exe /Q /c * 1> \\\\*\\*\\* 2>&1*" or process.command_line like "*cmd.exe /C * > \\\\*\\*\\* 2>&1*" or process.command_line like "*cmd.exe /C * > *\\Temp\\* 2>&1*" or process.command_line like "*powershell.exe -exec bypass -noni -nop -w 1 -C \"*" or process.command_line like "*powershell.exe -noni -nop -w 1 -enc *"
