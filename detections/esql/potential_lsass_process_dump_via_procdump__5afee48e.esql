// Potential LSASS Process Dump Via Procdump | T1003.001, T1036 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_sysinternals_procdump_lsass.yml
from * metadata _id, _index, _version | where (process.command_line like "* -ma *" or process.command_line like "* /ma *" or process.command_line like "* –ma *" or process.command_line like "* —ma *" or process.command_line like "* ―ma *" or process.command_line like "* -mm *" or process.command_line like "* /mm *" or process.command_line like "* –mm *" or process.command_line like "* —mm *" or process.command_line like "* ―mm *" or process.command_line like "* -mp *" or process.command_line like "* /mp *" or process.command_line like "* –mp *" or process.command_line like "* —mp *" or process.command_line like "* ―mp *") and (process.command_line like "* ls*" or process.command_line like "* keyiso*" or process.command_line like "* samss*")
