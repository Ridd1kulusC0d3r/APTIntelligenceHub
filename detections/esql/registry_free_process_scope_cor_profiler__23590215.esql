// Registry-Free Process Scope COR_PROFILER | T1574.012 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_cor_profiler.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*$env:COR_ENABLE_PROFILING*" and powershell.file.script_block_text like "*$env:COR_PROFILER*" and powershell.file.script_block_text like "*$env:COR_PROFILER_PATH*"
