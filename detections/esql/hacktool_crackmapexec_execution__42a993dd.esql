// HackTool - CrackMapExec Execution | T1047, T1053, T1059.001, T1059.003, T1110, T1201 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_crackmapexec_execution.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\crackmapexec.exe") or process.command_line like "* -M pe_inject *" or process.command_line like "* --local-auth*" and process.command_line like "* -u *" and process.command_line like "* -x *" or process.command_line like "* --local-auth*" and process.command_line like "* -u *" and process.command_line like "* -p *" and process.command_line like "* -H 'NTHASH'*" or process.command_line like "* mssql *" and process.command_line like "* -u *" and process.command_line like "* -p *" and process.command_line like "* -M *" and process.command_line like "* -d *" or process.command_line like "* smb *" and process.command_line like "* -u *" and process.command_line like "* -H *" and process.command_line like "* -M *" and process.command_line like "* -o *" or process.command_line like "* smb *" and process.command_line like "* -u *" and process.command_line like "* -p *" and process.command_line like "* --local-auth*" or process.command_line like "* --local-auth*" and process.command_line like "* -u *" and process.command_line like "* -p *" and process.command_line like "* 10.*" and process.command_line like "* 192.168.*" and process.command_line like "*/24 *"
