// Suspicious Unblock-File | T1553.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_susp_unblock_file.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*Unblock-File *" and powershell.file.script_block_text like "*-Path *"
