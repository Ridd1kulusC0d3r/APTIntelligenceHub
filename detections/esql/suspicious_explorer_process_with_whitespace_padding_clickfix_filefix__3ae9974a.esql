// Suspicious Explorer Process with Whitespace Padding - ClickFix/FileFix | T1027.010, T1204.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_clickfix_filefix_whitespace_padding.yml
from * metadata _id, _index, _version | where ends_with(process.parent.executable.caseless, "\\explorer.exe") and process.command_line like "*#*" and (process.command_line like "*            *" or process.command_line like "*            *" or process.command_line like "*            *" or process.command_line like "*            *" or process.command_line like "*            *" or process.command_line like "*            *" or process.command_line like "*            *" or process.command_line like "*            *" or process.command_line like "*            *" or process.command_line like "*            *" or process.command_line like "*            *" or process.command_line like "*            *" or process.command_line like "*            *")
