// Raw Paste Service Access | T1071.001, T1102.001, T1102.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/web/proxy_generic/proxy_raw_paste_service_access.yml
from * metadata _id, _index, _version | where `c-uri` like "*.paste.ee/r/*" or `c-uri` like "*.pastebin.com/raw/*" or `c-uri` like "*.hastebin.com/raw/*" or `c-uri` like "*.ghostbin.co/paste/*/raw/*" or `c-uri` like "*pastetext.net/*" or `c-uri` like "*pastebin.pl/*" or `c-uri` like "*paste.ee/*"
