// Sudo Privilege Escalation CVE-2019-14287 - Builtin | T1068, T1548.003 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/Exploits/CVE-2019-14287/lnx_sudo_exploit_cve_2019_14287.yml
from * metadata _id, _index, _version | where starts_with(USER, "#-") or USER like "#*4294967295"
