// OilRig APT Schedule Task Persistence - System | T1053.005, T1071.004, T1112, T1543.003 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2018/TA/OilRig/win_system_apt_oilrig_mar18.yml
from * metadata _id, _index, _version | where winlog.channel=="System" and winlog.provider_name=="Service Control Manager" and event.code=="7045" and (winlog.event_data.ServiceName in ("SC Scheduled Scan", "UpdatMachine"))
