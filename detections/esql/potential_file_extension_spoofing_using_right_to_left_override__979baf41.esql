// Potential File Extension Spoofing Using Right-to-Left Override | T1036.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_right_to_left_override_extension_spoofing.yml
from * metadata _id, _index, _version | where (file.path like "*\\u202e*" or file.path like "*[U+202E]*" or file.path like "*‮*") and (file.path like "*3pm.*" or file.path like "*4pm.*" or file.path like "*cod.*" or file.path like "*fdp.*" or file.path like "*ftr.*" or file.path like "*gepj.*" or file.path like "*gnp.*" or file.path like "*gpj.*" or file.path like "*ism.*" or file.path like "*lmth.*" or file.path like "*nls.*" or file.path like "*piz.*" or file.path like "*slx.*" or file.path like "*tdo.*" or file.path like "*vsc.*" or file.path like "*vwm.*" or file.path like "*xcod.*" or file.path like "*xslx.*" or file.path like "*xtpp.*")
