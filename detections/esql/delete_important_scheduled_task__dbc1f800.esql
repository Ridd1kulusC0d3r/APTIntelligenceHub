// Delete Important Scheduled Task | T1489 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_schtasks_delete.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\schtasks.exe") or process.pe.original_file_name=="schtasks.exe") and (process.command_line like "*-delete*" or process.command_line like "*/delete*" or process.command_line like "*–delete*" or process.command_line like "*—delete*" or process.command_line like "*―delete*") and (process.command_line like "*\\Windows\\BitLocker*" or process.command_line like "*\\Windows\\ExploitGuard*" or process.command_line like "*\\Windows\\SystemRestore\\SR*" or process.command_line like "*\\Windows\\UpdateOrchestrator\\*" or process.command_line like "*\\Windows\\Windows Defender\\*" or process.command_line like "*\\Windows\\WindowsBackup\\*" or process.command_line like "*\\Windows\\WindowsUpdate\\*")
