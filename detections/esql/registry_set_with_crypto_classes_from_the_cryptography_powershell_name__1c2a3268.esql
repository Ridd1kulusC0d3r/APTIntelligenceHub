// Registry Set With Crypto-Classes From The "Cryptography" PowerShell Namespace | T1027.010, T1059.001, T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/registry/registry_set/registry_set_powershell_crypto_namespace.yml
from * metadata _id, _index, _version | where registry.path like "*\\Shell\\Open\\Command*" and (winlog.event_data.Details like "*powershell*" or winlog.event_data.Details like "*pwsh*") and winlog.event_data.Details like "*System.Security.Cryptography.*" and (winlog.event_data.Details like "*.AesCryptoServiceProvider*" or winlog.event_data.Details like "*.DESCryptoServiceProvider*" or winlog.event_data.Details like "*.DSACryptoServiceProvider*" or winlog.event_data.Details like "*.RC2CryptoServiceProvider*" or winlog.event_data.Details like "*.Rijndael*" or winlog.event_data.Details like "*.RSACryptoServiceProvider*" or winlog.event_data.Details like "*.TripleDESCryptoServiceProvider*")
