// DllUnregisterServer Function Call Via Msiexec.EXE | T1218.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_msiexec_dll.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\msiexec.exe") or process.pe.original_file_name=="msiexec.exe") and (process.command_line like "* -z *" or process.command_line like "* /z *" or process.command_line like "* –z *" or process.command_line like "* —z *" or process.command_line like "* ―z *") and process.command_line like "*.dll*" and not ends_with(process.command_line, "\\MsiExec.exe\" /Z \"C:\\Windows\\CCM\\MsiHandler.dll\"")
