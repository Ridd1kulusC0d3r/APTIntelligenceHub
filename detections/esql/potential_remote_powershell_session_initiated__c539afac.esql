// Potential Remote PowerShell Session Initiated | T1021.006, T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_susp_remote_powershell_session.yml
from * metadata _id, _index, _version | where (destination.port in (5985, 5986)) and network.direction=="true" and winlog.event_data.SourceIsIpv6=="false" and not (user.name like "*NETWORK SERVICE*" or user.name like "*NETZWERKDIENST*" or user.name like "*SERVICIO DE RED*" or user.name like "*SERVIZIO DI RETE*" or user.name like "*SERVICE R*" and user.name like "*SEAU*" or (source.ip in ("::1", "127.0.0.1")) and (destination.ip in ("::1", "127.0.0.1"))) and not (process.executable.caseless in ("C:\\Program Files\\Avast Software\\Avast\\AvastSvc.exe", "C:\\Program Files (x86)\\Avast Software\\Avast\\AvastSvc.exe"))
