// Suspicious Eventlog Clearing or Configuration Change Activity | T1685.001, T1685.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_eventlog_clear.yml
from * metadata _id, _index, _version | where ((ends_with(process.executable.caseless, "\\wevtutil.exe") or process.pe.original_file_name=="wevtutil.exe") and (process.command_line like "*clear-log *" or process.command_line like "* cl *" or process.command_line like "*set-log *" or process.command_line like "* sl *" or process.command_line like "*lfn:*") or (ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\powershell_ise.exe") or ends_with(process.executable.caseless, "\\pwsh.exe")) and (process.command_line like "*Clear-EventLog *" or process.command_line like "*Remove-EventLog *" or process.command_line like "*Limit-EventLog *" or process.command_line like "*Clear-WinEvent *" or process.command_line like "*Eventing.Reader.EventLogSession*" and process.command_line like "*ClearLog*" or process.command_line like "*Diagnostics.EventLog*" and process.command_line like "*Clear*") or (ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\powershell_ise.exe") or ends_with(process.executable.caseless, "\\pwsh.exe") or ends_with(process.executable.caseless, "\\wmic.exe")) and process.command_line like "*ClearEventLog*") and not ((process.parent.executable.caseless in ("C:\\Windows\\SysWOW64\\msiexec.exe", "C:\\Windows\\System32\\msiexec.exe")) and process.command_line like "* sl *")
