// Root Certificate Installed From Susp Locations | T1553.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_import_cert_susp_locations.yml
from * metadata _id, _index, _version | where process.command_line like "*Import-Certificate*" and process.command_line like "* -FilePath *" and process.command_line like "*Cert:\\LocalMachine\\Root*" and (process.command_line like "*\\AppData\\Local\\Temp\\*" or process.command_line like "*:\\Windows\\TEMP\\*" or process.command_line like "*\\Desktop\\*" or process.command_line like "*\\Downloads\\*" or process.command_line like "*\\Perflogs\\*" or process.command_line like "*:\\Users\\Public\\*")
