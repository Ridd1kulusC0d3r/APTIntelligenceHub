// Uncommon Process Access Rights For Target Image | T1055.011 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_access/proc_access_win_susp_all_access_uncommon_target.yml
from * metadata _id, _index, _version | where (ends_with(winlog.event_data.TargetImage, "\\calc.exe") or ends_with(winlog.event_data.TargetImage, "\\calculator.exe") or ends_with(winlog.event_data.TargetImage, "\\mspaint.exe") or ends_with(winlog.event_data.TargetImage, "\\notepad.exe") or ends_with(winlog.event_data.TargetImage, "\\ping.exe") or ends_with(winlog.event_data.TargetImage, "\\wordpad.exe") or ends_with(winlog.event_data.TargetImage, "\\write.exe")) and winlog.event_data.GrantedAccess=="0x1FFFFF"
