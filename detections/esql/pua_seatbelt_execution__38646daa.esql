// PUA - Seatbelt Execution | T1083, T1087, T1526 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_pua_seatbelt.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\Seatbelt.exe") or process.pe.original_file_name=="Seatbelt.exe" or process.pe.description=="Seatbelt" or process.command_line like "* DpapiMasterKeys*" or process.command_line like "* InterestingProcesses*" or process.command_line like "* InterestingFiles*" or process.command_line like "* CertificateThumbprints*" or process.command_line like "* ChromiumBookmarks*" or process.command_line like "* ChromiumHistory*" or process.command_line like "* ChromiumPresence*" or process.command_line like "* CloudCredentials*" or process.command_line like "* CredEnum*" or process.command_line like "* CredGuard*" or process.command_line like "* FirefoxHistory*" or process.command_line like "* ProcessCreationEvents*" or (process.command_line like "* -group=misc*" or process.command_line like "* -group=remote*" or process.command_line like "* -group=chromium*" or process.command_line like "* -group=slack*" or process.command_line like "* -group=system*" or process.command_line like "* -group=user*" or process.command_line like "* -group=all*") and process.command_line like "* -outputfile=*"
