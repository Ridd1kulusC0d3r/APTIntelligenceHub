// Potential EmpireMonkey Activity | T1218.010 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/TA/EmpireMonkey/proc_creation_win_apt_empiremonkey.yml
from * metadata _id, _index, _version | where process.command_line like "*/e:jscript*" and process.command_line like "*\\Local\\Temp\\Errors.bat*"
