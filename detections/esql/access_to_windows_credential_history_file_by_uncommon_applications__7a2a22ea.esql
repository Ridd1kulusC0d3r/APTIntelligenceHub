// Access To Windows Credential History File By Uncommon Applications | T1555.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_access/file_access_win_susp_credhist.yml
from * metadata _id, _index, _version | where ends_with(file.path, "\\Microsoft\\Protect\\CREDHIST") and not (starts_with(process.executable.caseless, "C:\\Program Files\\") or starts_with(process.executable.caseless, "C:\\Program Files (x86)\\") or starts_with(process.executable.caseless, "C:\\Windows\\system32\\") or starts_with(process.executable.caseless, "C:\\Windows\\SysWOW64\\") or process.executable.caseless=="C:\\Windows\\explorer.exe")
