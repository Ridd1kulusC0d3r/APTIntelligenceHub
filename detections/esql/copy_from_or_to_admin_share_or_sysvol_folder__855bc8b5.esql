// Copy From Or To Admin Share Or Sysvol Folder | T1021.002, T1039, T1048 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_copy_lateral_movement.yml
from * metadata _id, _index, _version | where (process.command_line like "*\\\\*\\*$*" or process.command_line like "*\\Sysvol\\*") and (ends_with(process.executable.caseless, "\\robocopy.exe") or ends_with(process.executable.caseless, "\\xcopy.exe") or process.pe.original_file_name in ("robocopy.exe", "XCOPY.EXE") or (ends_with(process.executable.caseless, "\\cmd.exe") or process.pe.original_file_name=="Cmd.Exe") and process.command_line like "*copy*" or (process.executable.caseless like "*\\powershell_ise.exe*" or process.executable.caseless like "*\\powershell.exe*" or process.executable.caseless like "*\\pwsh.exe*" or process.pe.original_file_name in ("powershell_ise.exe", "PowerShell.EXE", "pwsh.dll")) and (process.command_line like "*copy-item*" or process.command_line like "*copy *" or process.command_line like "*cpi *" or process.command_line like "* cp *" or process.command_line like "*move *" or process.command_line like "* move-item*" or process.command_line like "* mi *" or process.command_line like "* mv *"))
