// Startup/Logon Script Added to Group Policy Object | T1484.001, T1547 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_susp_group_policy_startup_script_added_to_gpo.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and (event.code in ("5136", "5145")) and ((winlog.event_data.AttributeLDAPDisplayName in ("gPCMachineExtensionNames", "gPCUserExtensionNames")) and winlog.event_data.AttributeValue like "*42B5FAAE-6536-11D2-AE5A-0000F87571E3*" and (winlog.event_data.AttributeValue like "*40B6664F-4972-11D1-A7CA-0000F87571E3*" or winlog.event_data.AttributeValue like "*40B66650-4972-11D1-A7CA-0000F87571E3*") or ends_with(winlog.event_data.ShareName, "\\SYSVOL") and (ends_with(winlog.event_data.RelativeTargetName, "\\scripts.ini") or ends_with(winlog.event_data.RelativeTargetName, "\\psscripts.ini")) and winlog.event_data.AccessList like "*%%4417*")
