// HackTool - PCHunter Execution | T1007, T1012, T1057, T1082, T1083 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_pchunter.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\PCHunter64.exe") or ends_with(process.executable.caseless, "\\PCHunter32.exe") or process.pe.original_file_name=="PCHunter.exe" or process.pe.description=="Epoolsoft Windows Information View Tools" or winlog.event_data.Hashes like "*SHA1=5F1CBC3D99558307BC1250D084FA968521482025*" or winlog.event_data.Hashes like "*MD5=987B65CD9B9F4E9A1AFD8F8B48CF64A7*" or winlog.event_data.Hashes like "*SHA256=2B214BDDAAB130C274DE6204AF6DBA5AEEC7433DA99AA950022FA306421A6D32*" or winlog.event_data.Hashes like "*IMPHASH=444D210CEA1FF8112F256A4997EED7FF*" or winlog.event_data.Hashes like "*SHA1=3FB89787CB97D902780DA080545584D97FB1C2EB*" or winlog.event_data.Hashes like "*MD5=228DD0C2E6287547E26FFBD973A40F14*" or winlog.event_data.Hashes like "*SHA256=55F041BF4E78E9BFA6D4EE68BE40E496CE3A1353E1CA4306598589E19802522C*" or winlog.event_data.Hashes like "*IMPHASH=0479F44DF47CFA2EF1CCC4416A538663*"
