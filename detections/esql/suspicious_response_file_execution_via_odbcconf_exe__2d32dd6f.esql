// Suspicious Response File Execution Via Odbcconf.EXE | T1218.008 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_odbcconf_response_file_susp.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\odbcconf.exe") or process.pe.original_file_name=="odbcconf.exe") and (process.command_line like "* -f *" or process.command_line like "* /f *" or process.command_line like "* –f *" or process.command_line like "* —f *" or process.command_line like "* ―f *") and not (process.command_line like "*.rsp*" or process.parent.executable.caseless=="C:\\Windows\\System32\\runonce.exe" and process.executable.caseless=="C:\\Windows\\System32\\odbcconf.exe" and process.command_line like "*.exe /E /F \"C:\\WINDOWS\\system32\\odbcconf.tmp\"*")
