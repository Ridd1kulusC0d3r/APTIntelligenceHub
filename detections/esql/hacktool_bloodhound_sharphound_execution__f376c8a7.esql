// HackTool - Bloodhound/Sharphound Execution | T1059.001, T1069.001, T1069.002, T1087.001, T1087.002, T1482 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_bloodhound_sharphound.yml
from * metadata _id, _index, _version | where process.pe.product like "*SharpHound*" or process.pe.description like "*SharpHound*" or process.pe.company like "*SpecterOps*" or process.pe.company like "*evil corp*" or process.executable.caseless like "*\\Bloodhound.exe*" or process.executable.caseless like "*\\SharpHound.exe*" or process.command_line like "* -CollectionMethod All *" or process.command_line like "* --CollectionMethods Session *" or process.command_line like "* --Loop --Loopduration *" or process.command_line like "* --PortScanTimeout *" or process.command_line like "*.exe -c All -d *" or process.command_line like "*Invoke-Bloodhound*" or process.command_line like "*Get-BloodHoundData*" or process.command_line like "* -JsonFolder *" and process.command_line like "* -ZipFileName *" or process.command_line like "* DCOnly *" and process.command_line like "* --NoSaveCache *"
