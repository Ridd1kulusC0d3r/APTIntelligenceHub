// Publicly Accessible RDP Service | T1021.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/zeek/zeek_rdp_public_listener.yml
from * metadata _id, _index, _version | where not (cidr_match(id.orig_h, "::1/128") or cidr_match(id.orig_h, "10.0.0.0/8") or cidr_match(id.orig_h, "127.0.0.0/8") or cidr_match(id.orig_h, "172.16.0.0/12") or cidr_match(id.orig_h, "192.168.0.0/16") or cidr_match(id.orig_h, "169.254.0.0/16") or cidr_match(id.orig_h, "2620:83:8000::/48") or cidr_match(id.orig_h, "fc00::/7") or cidr_match(id.orig_h, "fe80::/10"))
