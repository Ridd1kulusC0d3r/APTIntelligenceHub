// HackTool - Mimikatz Execution | T1003.001, T1003.002, T1003.004, T1003.005, T1003.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_mimikatz_command_line.yml
from * metadata _id, _index, _version | where process.command_line like "*DumpCreds*" or process.command_line like "*mimikatz*" or process.command_line like "*::aadcookie*" or process.command_line like "*::detours*" or process.command_line like "*::memssp*" or process.command_line like "*::mflt*" or process.command_line like "*::ncroutemon*" or process.command_line like "*::ngcsign*" or process.command_line like "*::printnightmare*" or process.command_line like "*::skeleton*" or process.command_line like "*::preshutdown*" or process.command_line like "*::mstsc*" or process.command_line like "*::multirdp*" or process.command_line like "*rpc::*" or process.command_line like "*token::*" or process.command_line like "*crypto::*" or process.command_line like "*dpapi::*" or process.command_line like "*sekurlsa::*" or process.command_line like "*kerberos::*" or process.command_line like "*lsadump::*" or process.command_line like "*privilege::*" or process.command_line like "*process::*" or process.command_line like "*vault::*"
