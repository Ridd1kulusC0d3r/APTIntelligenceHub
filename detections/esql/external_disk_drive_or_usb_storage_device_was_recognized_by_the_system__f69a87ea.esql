// External Disk Drive Or USB Storage Device Was Recognized By The System | T1091, T1200 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_external_device.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="6416" and (winlog.event_data.ClassName=="DiskDrive" or winlog.event_data.DeviceDescription=="USB Mass Storage Device")
