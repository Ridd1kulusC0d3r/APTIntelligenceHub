// Set Suspicious Files as System Files Using Attrib.EXE | T1564.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_attrib_system_susp_paths.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\attrib.exe") or process.pe.original_file_name=="ATTRIB.EXE") and process.command_line like "* +s*" and (process.command_line like "* %*" or process.command_line like "*\\Users\\Public\\*" or process.command_line like "*\\AppData\\Local\\*" or process.command_line like "*\\ProgramData\\*" or process.command_line like "*\\Downloads\\*" or process.command_line like "*\\Windows\\Temp\\*") and (process.command_line like "*.bat*" or process.command_line like "*.dll*" or process.command_line like "*.exe*" or process.command_line like "*.hta*" or process.command_line like "*.ps1*" or process.command_line like "*.vbe*" or process.command_line like "*.vbs*") and not (process.command_line like "*\\Windows\\TEMP\\*" and process.command_line like "*.exe*")
