// Unix Shell Configuration Modification | T1546.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/path/lnx_auditd_unix_shell_configuration_modification.yml
from * metadata _id, _index, _version | where type=="PATH" and (name=="/etc/shells" or name=="/etc/profile" or starts_with(name, "/etc/profile.d/") or name=="/etc/bash.bashrc" or name=="/etc/bashrc" or name=="/etc/zsh/zprofile" or name=="/etc/zsh/zshrc" or name=="/etc/zsh/zlogin" or name=="/etc/zsh/zlogout" or name=="/etc/csh.cshrc" or name=="/etc/csh.login" or name=="/root/.bashrc" or name=="/root/.bash_profile" or name=="/root/.profile" or name=="/root/.zshrc" or name=="/root/.zprofile" or name like "/home/*/.bashrc" or name like "/home/*/.zshrc" or name like "/home/*/.bash_profile" or name like "/home/*/.zprofile" or name like "/home/*/.profile" or name like "/home/*/.bash_login" or name like "/home/*/.bash_logout" or name like "/home/*/.zlogin" or name like "/home/*/.zlogout")
