// PUA - Netcat Suspicious Execution | T1095 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_pua_netcat.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\nc.exe") or ends_with(process.executable.caseless, "\\ncat.exe") or ends_with(process.executable.caseless, "\\netcat.exe") or process.command_line like "* -lvp *" or process.command_line like "* -lvnp*" or process.command_line like "* -l -v -p *" or process.command_line like "* -lv -p *" or process.command_line like "* -l --proxy-type http *" or process.command_line like "* -vnl --exec *" or process.command_line like "* -vnl -e *" or process.command_line like "* --lua-exec *" or process.command_line like "* --sh-exec *"
