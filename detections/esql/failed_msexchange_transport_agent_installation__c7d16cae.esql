// Failed MSExchange Transport Agent Installation | T1505.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/msexchange/win_exchange_transportagent_failed.yml
from * metadata _id, _index, _version | where winlog.channel=="MSExchange Management" and event.code=="6" and winlog.event_data.Data like "*Install-TransportAgent*"
