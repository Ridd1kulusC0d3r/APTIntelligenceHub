// Csc.EXE Execution Form Potentially Suspicious Parent | T1027.004, T1059.005, T1059.007, T1218.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_csc_susp_parent.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\csc.exe") or process.pe.original_file_name=="csc.exe") and (ends_with(process.parent.executable.caseless, "\\cscript.exe") or ends_with(process.parent.executable.caseless, "\\excel.exe") or ends_with(process.parent.executable.caseless, "\\mshta.exe") or ends_with(process.parent.executable.caseless, "\\onenote.exe") or ends_with(process.parent.executable.caseless, "\\outlook.exe") or ends_with(process.parent.executable.caseless, "\\powerpnt.exe") or ends_with(process.parent.executable.caseless, "\\winword.exe") or ends_with(process.parent.executable.caseless, "\\wscript.exe") or (ends_with(process.parent.executable.caseless, "\\powershell.exe") or ends_with(process.parent.executable.caseless, "\\pwsh.exe")) and (process.parent.command_line like "*-Encoded *" or process.parent.command_line like "*FromBase64String*") or process.parent.command_line rlike "(?:[Pp]rogram[Dd]ata|%(?:[Ll]ocal)?[Aa]pp[Dd]ata%|\\\\[Aa]pp[Dd]ata\\\\(?:[Ll]ocal(?:[Ll]ow)?|[Rr]oaming))\\\\[^\\\\]{1,256}$" or process.parent.command_line like "*:\\PerfLogs\\*" or process.parent.command_line like "*:\\Users\\Public\\*" or process.parent.command_line like "*:\\Windows\\Temp\\*" or process.parent.command_line like "*\\Temporary Internet*" or process.parent.command_line like "*:\\Users\\*" and process.parent.command_line like "*\\Favorites\\*" or process.parent.command_line like "*:\\Users\\*" and process.parent.command_line like "*\\Favourites\\*" or process.parent.command_line like "*:\\Users\\*" and process.parent.command_line like "*\\Contacts\\*" or process.parent.command_line like "*:\\Users\\*" and process.parent.command_line like "*\\Pictures\\*") and not (starts_with(process.parent.executable.caseless, "C:\\Program Files (x86)\\") or starts_with(process.parent.executable.caseless, "C:\\Program Files\\") or process.parent.executable.caseless=="C:\\Windows\\System32\\sdiagnhost.exe" or process.parent.executable.caseless=="C:\\Windows\\System32\\inetsrv\\w3wp.exe") and not (process.parent.executable.caseless=="C:\\ProgramData\\chocolatey\\choco.exe" or process.parent.command_line like "*\\ProgramData\\Microsoft\\Windows Defender Advanced Threat Protection*" or process.parent.command_line like "*JwB7ACIAZgBhAGkAbABlAGQAIgA6AHQAcgB1AGUALAAiAG0AcwBnACIAOgAiAEEAbgBzAGkAYgBsAGUAIAByAGUAcQB1AGkAcgBlAHMAIABQAG8AdwBlAHIAUwBoAGUAbABsACAAdgAzAC4AMAAgAG8AcgAgAG4AZQB3AGUAcgAiAH0AJw*" or process.parent.command_line like "*cAewAiAGYAYQBpAGwAZQBkACIAOgB0AHIAdQBlACwAIgBtAHMAZwAiADoAIgBBAG4AcwBpAGIAbABlACAAcgBlAHEAdQBpAHIAZQBzACAAUABvAHcAZQByAFMAaABlAGwAbAAgAHYAMwAuADAAIABvAHIAIABuAGUAdwBlAHIAIgB9ACcA*" or process.parent.command_line like "*nAHsAIgBmAGEAaQBsAGUAZAAiADoAdAByAHUAZQAsACIAbQBzAGcAIgA6ACIAQQBuAHMAaQBiAGwAZQAgAHIAZQBxAHUAaQByAGUAcwAgAFAAbwB3AGUAcgBTAGgAZQBsAGwAIAB2ADMALgAwACAAbwByACAAbgBlAHcAZQByACIAfQAnA*")
