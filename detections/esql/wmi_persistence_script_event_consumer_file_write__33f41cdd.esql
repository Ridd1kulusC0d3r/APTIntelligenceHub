// WMI Persistence - Script Event Consumer File Write | T1546.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_wmi_persistence_script_event_consumer_write.yml
from * metadata _id, _index, _version | where process.executable.caseless=="C:\\WINDOWS\\system32\\wbem\\scrcons.exe"
