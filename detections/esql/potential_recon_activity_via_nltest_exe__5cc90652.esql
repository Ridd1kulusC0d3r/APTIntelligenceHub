// Potential Recon Activity Via Nltest.EXE | T1016, T1482 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_nltest_recon.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\nltest.exe") or process.pe.original_file_name=="nltestrk.exe") and (process.command_line like "*server*" and process.command_line like "*query*" or process.command_line like "*/user*" or process.command_line like "*all_trusts*" or process.command_line like "*dclist:*" or process.command_line like "*dnsgetdc:*" or process.command_line like "*domain_trusts*" or process.command_line like "*dsgetdc:*" or process.command_line like "*parentdomain*" or process.command_line like "*trusted_domains*")
