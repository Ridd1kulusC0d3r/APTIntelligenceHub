// AWS CloudTrail Important Change | T1685.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/aws/cloudtrail/aws_cloudtrail_disable_logging.yml
from * metadata _id, _index, _version | where eventSource=="cloudtrail.amazonaws.com" and (eventName in ("StopLogging", "UpdateTrail", "DeleteTrail"))
