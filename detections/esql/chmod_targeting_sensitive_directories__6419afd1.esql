// Chmod Targeting Sensitive Directories | T1222.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_chmod_targeting_sensitive_directories.yml
from * metadata _id, _index, _version | where ends_with(Image, "/chmod") and (CommandLine like "*/tmp/*" or CommandLine like "*/.Library/*" or CommandLine like "*/etc/*" or CommandLine like "*/opt/*") and not (CommandLine like "*chmod --reference=/etc/shells*" and ends_with(ParentCommandLine, "/update-shells") or CommandLine like "*/etc/*" and ParentCommandLine like "*/var/lib/dpkg/info/*" and ParentCommandLine like "*.postinst configure*" or starts_with(CommandLine, "chmod 700 /tmp/apt-key-gpghome.") or starts_with(CommandLine, "chmod 755 /var/tmp/mkinitramfs") or CommandLine=="chmod 0775 /etc/landscape/" or CommandLine=="chmod 644 /etc/apparmor.d/tunables/home.d/ubuntu")
