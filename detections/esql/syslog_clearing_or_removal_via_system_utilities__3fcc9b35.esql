// Syslog Clearing or Removal Via System Utilities | T1685.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_clear_syslog.yml
from * metadata _id, _index, _version | where CommandLine like "*/var/log/syslog*" and (ends_with(Image, "/rm") and (CommandLine like "* -r *" or CommandLine like "* -f *" or CommandLine like "* -rf *" or CommandLine like "*/var/log/syslog*") or ends_with(Image, "/unlink") or ends_with(Image, "/mv") or ends_with(Image, "/truncate") and CommandLine like "*0 *" and CommandLine like "*/var/log/syslog*" and (CommandLine like "*-s *" or CommandLine like "*-c *" or CommandLine like "*--size*") or ends_with(Image, "/ln") and CommandLine like "*/dev/null *" and CommandLine like "*/var/log/syslog*" and (CommandLine like "*-sf *" or CommandLine like "*-sfn *" or CommandLine like "*-sfT *") or ends_with(Image, "/cp") and CommandLine like "*/dev/null*" or ends_with(Image, "/shred") and CommandLine like "*-u *") or CommandLine like "* > /var/log/syslog*" or CommandLine like "* >/var/log/syslog*" or CommandLine like "* >| /var/log/syslog*" or CommandLine like "*: > /var/log/syslog*" or CommandLine like "*:> /var/log/syslog*" or CommandLine like "*:>/var/log/syslog*" or CommandLine like "*>|/var/log/syslog*" or CommandLine like "*journalctl --vacuum*" or CommandLine like "*journalctl --rotate*"
