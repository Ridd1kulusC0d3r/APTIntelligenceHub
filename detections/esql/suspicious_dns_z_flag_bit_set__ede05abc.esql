// Suspicious DNS Z Flag Bit Set | T1095, T1571 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/zeek/zeek_dns_susp_zbit_flag.yml
from * metadata _id, _index, _version | where not Z==0 and query like "*.*" and not (ends_with(query, ".arpa") or ends_with(query, ".local") or ends_with(query, ".ultradns.net") or ends_with(query, ".twtrdns.net") or ends_with(query, ".azuredns-prd.info") or ends_with(query, ".azure-dns.com") or ends_with(query, ".azuredns-ff.info") or ends_with(query, ".azuredns-ff.org") or ends_with(query, ".azuregov-dns.org") or qtype_name in ("ns", "mx") or ends_with(answers, "\\x00") or id.resp_p in (137, 138, 139))
