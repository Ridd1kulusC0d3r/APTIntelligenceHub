// Query Tor Onion Address - DNS Client | T1090.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/dns_client/win_dns_client_tor_onion.yml
from * metadata _id, _index, _version | where winlog.channel=="Microsoft-Windows-DNS Client Events/Operational" and event.code=="3008" and (ends_with(dns.question.name, ".hiddenservice.net") or ends_with(dns.question.name, ".onion.ca") or ends_with(dns.question.name, ".onion.cab") or ends_with(dns.question.name, ".onion.casa") or ends_with(dns.question.name, ".onion.city") or ends_with(dns.question.name, ".onion.direct") or ends_with(dns.question.name, ".onion.dog") or ends_with(dns.question.name, ".onion.glass") or ends_with(dns.question.name, ".onion.gq") or ends_with(dns.question.name, ".onion.guide") or ends_with(dns.question.name, ".onion.in.net") or ends_with(dns.question.name, ".onion.ink") or ends_with(dns.question.name, ".onion.it") or ends_with(dns.question.name, ".onion.link") or ends_with(dns.question.name, ".onion.lt") or ends_with(dns.question.name, ".onion.lu") or ends_with(dns.question.name, ".onion.ly") or ends_with(dns.question.name, ".onion.mn") or ends_with(dns.question.name, ".onion.network") or ends_with(dns.question.name, ".onion.nu") or ends_with(dns.question.name, ".onion.pet") or ends_with(dns.question.name, ".onion.plus") or ends_with(dns.question.name, ".onion.pt") or ends_with(dns.question.name, ".onion.pw") or ends_with(dns.question.name, ".onion.rip") or ends_with(dns.question.name, ".onion.sh") or ends_with(dns.question.name, ".onion.si") or ends_with(dns.question.name, ".onion.to") or ends_with(dns.question.name, ".onion.top") or ends_with(dns.question.name, ".onion.ws") or ends_with(dns.question.name, ".onion") or ends_with(dns.question.name, ".s1.tor-gateways.de") or ends_with(dns.question.name, ".s2.tor-gateways.de") or ends_with(dns.question.name, ".s3.tor-gateways.de") or ends_with(dns.question.name, ".s4.tor-gateways.de") or ends_with(dns.question.name, ".s5.tor-gateways.de") or ends_with(dns.question.name, ".t2w.pw") or ends_with(dns.question.name, ".tor2web.ae.org") or ends_with(dns.question.name, ".tor2web.blutmagie.de") or ends_with(dns.question.name, ".tor2web.com") or ends_with(dns.question.name, ".tor2web.fi") or ends_with(dns.question.name, ".tor2web.io") or ends_with(dns.question.name, ".tor2web.org") or ends_with(dns.question.name, ".tor2web.xyz") or ends_with(dns.question.name, ".torlink.co"))
