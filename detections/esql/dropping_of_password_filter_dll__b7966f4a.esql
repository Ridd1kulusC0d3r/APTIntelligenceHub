// Dropping Of Password Filter DLL | T1556.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_reg_credential_access_via_password_filter.yml
from * metadata _id, _index, _version | where process.command_line like "*HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa*" and process.command_line like "*scecli\\0*" and process.command_line like "*reg add*"
