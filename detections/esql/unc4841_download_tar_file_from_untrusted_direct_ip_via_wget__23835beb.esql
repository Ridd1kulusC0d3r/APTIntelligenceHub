// UNC4841 - Download Tar File From Untrusted Direct IP Via Wget | T1140 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2023/TA/UNC4841-Barracuda-ESG-Zero-Day-Exploitation/proc_creation_lnx_apt_unc4841_wget_download_tar_files_direct_ip.yml
from * metadata _id, _index, _version | where ends_with(Image, "/wget") and CommandLine rlike "https://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}" and CommandLine like "*--no-check-certificate*" and ends_with(CommandLine, ".tar") and not (CommandLine like "*https://10.*" or CommandLine like "*https://192.168.*" or CommandLine like "*https://172.16.*" or CommandLine like "*https://172.17.*" or CommandLine like "*https://172.18.*" or CommandLine like "*https://172.19.*" or CommandLine like "*https://172.20.*" or CommandLine like "*https://172.21.*" or CommandLine like "*https://172.22.*" or CommandLine like "*https://172.23.*" or CommandLine like "*https://172.24.*" or CommandLine like "*https://172.25.*" or CommandLine like "*https://172.26.*" or CommandLine like "*https://172.27.*" or CommandLine like "*https://172.28.*" or CommandLine like "*https://172.29.*" or CommandLine like "*https://172.30.*" or CommandLine like "*https://172.31.*" or CommandLine like "*https://127.*" or CommandLine like "*https://169.254.*")
