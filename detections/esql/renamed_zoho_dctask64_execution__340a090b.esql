// Renamed ZOHO Dctask64 Execution | T1036, T1055.001, T1202, T1218 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_renamed_dctask64.yml
from * metadata _id, _index, _version | where (winlog.event_data.Hashes like "*IMPHASH=6834B1B94E49701D77CCB3C0895E1AFD*" or winlog.event_data.Hashes like "*IMPHASH=1BB6F93B129F398C7C4A76BB97450BBA*" or winlog.event_data.Hashes like "*IMPHASH=FAA2AC19875FADE461C8D89DCF2710A3*" or winlog.event_data.Hashes like "*IMPHASH=F1039CED4B91572AB7847D26032E6BBF*") and not ends_with(process.executable.caseless, "\\dctask64.exe")
