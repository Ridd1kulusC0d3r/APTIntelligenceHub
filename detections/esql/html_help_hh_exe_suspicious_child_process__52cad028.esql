// HTML Help HH.EXE Suspicious Child Process | T1047, T1059.001, T1059.003, T1059.005, T1059.007, T1218, T1218.001, T1218.010, T1218.011, T1566, T1566.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hh_html_help_susp_child_process.yml
from * metadata _id, _index, _version | where ends_with(process.parent.executable.caseless, "\\hh.exe") and (ends_with(process.executable.caseless, "\\CertReq.exe") or ends_with(process.executable.caseless, "\\CertUtil.exe") or ends_with(process.executable.caseless, "\\cmd.exe") or ends_with(process.executable.caseless, "\\cscript.exe") or ends_with(process.executable.caseless, "\\installutil.exe") or ends_with(process.executable.caseless, "\\MSbuild.exe") or ends_with(process.executable.caseless, "\\MSHTA.EXE") or ends_with(process.executable.caseless, "\\msiexec.exe") or ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\pwsh.exe") or ends_with(process.executable.caseless, "\\regsvr32.exe") or ends_with(process.executable.caseless, "\\rundll32.exe") or ends_with(process.executable.caseless, "\\schtasks.exe") or ends_with(process.executable.caseless, "\\wmic.exe") or ends_with(process.executable.caseless, "\\wscript.exe"))
