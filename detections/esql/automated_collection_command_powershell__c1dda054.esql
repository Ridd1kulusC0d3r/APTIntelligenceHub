// Automated Collection Command PowerShell | T1119 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_automated_collection.yml
from * metadata _id, _index, _version | where (powershell.file.script_block_text like "*.doc*" or powershell.file.script_block_text like "*.docx*" or powershell.file.script_block_text like "*.xls*" or powershell.file.script_block_text like "*.xlsx*" or powershell.file.script_block_text like "*.ppt*" or powershell.file.script_block_text like "*.pptx*" or powershell.file.script_block_text like "*.rtf*" or powershell.file.script_block_text like "*.pdf*" or powershell.file.script_block_text like "*.txt*") and powershell.file.script_block_text like "*Get-ChildItem*" and powershell.file.script_block_text like "* -Recurse *" and powershell.file.script_block_text like "* -Include *"
