// Compressed File Creation Via Tar.EXE | T1560, T1560.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_tar_compression.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\tar.exe") or process.pe.original_file_name=="bsdtar") and (process.command_line like "*-c*" or process.command_line like "*-r*" or process.command_line like "*-u*")
