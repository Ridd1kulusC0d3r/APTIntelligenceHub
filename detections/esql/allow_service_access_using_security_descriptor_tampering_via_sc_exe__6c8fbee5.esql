// Allow Service Access Using Security Descriptor Tampering Via Sc.EXE | T1543.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_sc_sdset_allow_service_changes.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\sc.exe") or process.pe.original_file_name=="sc.exe") and process.command_line like "*sdset*" and process.command_line like "*A;*" and (process.command_line like "*;IU*" or process.command_line like "*;SU*" or process.command_line like "*;BA*" or process.command_line like "*;SY*" or process.command_line like "*;WD*") and not process.parent.executable.caseless=="C:\\Hexnode\\Hexnode Agent\\Current\\HexnodeAgent.exe"
