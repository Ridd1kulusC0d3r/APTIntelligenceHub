// Activity from Infrequent Country | T1573 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/m365/threat_management/microsoft365_activity_from_infrequent_country.yml
from * metadata _id, _index, _version | where eventSource=="SecurityComplianceCenter" and eventName=="Activity from infrequent country" and status=="success"
