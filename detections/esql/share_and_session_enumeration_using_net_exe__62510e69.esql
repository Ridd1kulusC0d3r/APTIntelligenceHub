// Share And Session Enumeration Using Net.EXE | T1018 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_net_view_share_and_sessions_enum.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\net.exe") or ends_with(process.executable.caseless, "\\net1.exe") or process.pe.original_file_name in ("net.exe", "net1.exe")) and process.command_line like "*view*" and not process.command_line like "*\\\\*"
