// LSA PPL Protection Setting Modification via CommandLine | T1689 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_lsa_ppl_protection_setting_modification_via_cli.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\reg.exe") or ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\pwsh.exe") or process.pe.original_file_name in ("reg.exe", "powershell.exe", "pwsh.dll")) and process.command_line like "*ControlSet*" and process.command_line like "*\\Control\\Lsa*" and (process.command_line like "*Set-ItemProperty*" or process.command_line like "*New-ItemProperty*" or process.command_line like "* add *") and (process.command_line like "*IsPplAutoEnabled*" or process.command_line like "*RunAsPPL*" or process.command_line like "*RunAsPPLBoot*")
