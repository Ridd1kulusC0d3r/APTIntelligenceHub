// Boot Configuration Tampering Via Bcdedit.EXE | T1490 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_bcdedit_boot_conf_tamper.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\bcdedit.exe") or process.pe.original_file_name=="bcdedit.exe") and process.command_line like "*set*" and (process.command_line like "*bootstatuspolicy*" and process.command_line like "*ignoreallfailures*" or process.command_line like "*recoveryenabled*" and process.command_line like "*no*")
