// WScript or CScript Dropper - File | T1059.005, T1059.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_cscript_wscript_dropper.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\wscript.exe") or ends_with(process.executable.caseless, "\\cscript.exe")) and (file.path like "*:\\Perflogs\\*" or file.path like "*:\\ProgramData\\*" or file.path like "*:\\Temp\\*" or file.path like "*:\\Tmp\\*" or file.path like "*:\\Users\\*" or file.path like "*:\\Windows\\Temp\\*" or file.path like "*\\AppData\\Local\\Temp*" or file.path like "*\\AppData\\Roaming\\Temp*" or file.path like "*\\Start Menu\\Programs\\Startup\\*" or file.path like "*\\Temporary Internet*") and (ends_with(file.path, ".js") or ends_with(file.path, ".jse") or ends_with(file.path, ".vba") or ends_with(file.path, ".vbe") or ends_with(file.path, ".vbs") or ends_with(file.path, ".wsf") or ends_with(file.path, ".wsh"))
