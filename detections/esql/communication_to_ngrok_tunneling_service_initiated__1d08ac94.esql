// Communication To Ngrok Tunneling Service Initiated | T1090, T1102, T1567, T1568.002, T1572 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_domain_ngrok_tunnel.yml
from * metadata _id, _index, _version | where destination.domain like "*tunnel.us.ngrok.com*" or destination.domain like "*tunnel.eu.ngrok.com*" or destination.domain like "*tunnel.ap.ngrok.com*" or destination.domain like "*tunnel.au.ngrok.com*" or destination.domain like "*tunnel.sa.ngrok.com*" or destination.domain like "*tunnel.jp.ngrok.com*" or destination.domain like "*tunnel.in.ngrok.com*"
