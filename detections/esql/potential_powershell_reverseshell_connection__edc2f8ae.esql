// Potential Powershell ReverseShell Connection | T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_reverse_shell_connection.yml
from * metadata _id, _index, _version | where (process.pe.original_file_name in ("PowerShell.EXE", "pwsh.dll") or ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\pwsh.exe")) and process.command_line like "* Net.Sockets.TCPClient*" and process.command_line like "*.GetStream(*" and process.command_line like "*.Write(*"
