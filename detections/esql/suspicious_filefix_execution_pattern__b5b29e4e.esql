// Suspicious FileFix Execution Pattern | T1204.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_filefix_execution_pattern.yml
from * metadata _id, _index, _version | where (ends_with(process.parent.executable.caseless, "\\brave.exe") or ends_with(process.parent.executable.caseless, "\\chrome.exe") or ends_with(process.parent.executable.caseless, "\\firefox.exe") or ends_with(process.parent.executable.caseless, "\\msedge.exe")) and process.command_line like "*#*" and (process.command_line like "*%comspec%*" or process.command_line like "*bitsadmin*" or process.command_line like "*certutil*" or process.command_line like "*cmd*" or process.command_line like "*cscript*" or process.command_line like "*curl*" or process.command_line like "*finger*" or process.command_line like "*mshta*" or process.command_line like "*powershell*" or process.command_line like "*pwsh*" or process.command_line like "*regsvr32*" or process.command_line like "*rundll32*" or process.command_line like "*schtasks*" or process.command_line like "*wget*" or process.command_line like "*wscript*" or process.command_line like "*account*" or process.command_line like "*anti-bot*" or process.command_line like "*botcheck*" or process.command_line like "*captcha*" or process.command_line like "*challenge*" or process.command_line like "*confirmation*" or process.command_line like "*fraud*" or process.command_line like "*human*" or process.command_line like "*identification*" or process.command_line like "*identificator*" or process.command_line like "*identity*" or process.command_line like "*robot*" or process.command_line like "*validation*" or process.command_line like "*verification*" or process.command_line like "*verify*")
