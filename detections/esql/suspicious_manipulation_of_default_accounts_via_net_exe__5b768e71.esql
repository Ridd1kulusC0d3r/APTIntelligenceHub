// Suspicious Manipulation Of Default Accounts Via Net.EXE | T1560.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_net_user_default_accounts_manipulation.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\net.exe") or ends_with(process.executable.caseless, "\\net1.exe") or process.pe.original_file_name in ("net.exe", "net1.exe")) and process.command_line like "* user *" and (process.command_line like "* Järjestelmänvalvoja *" or process.command_line like "* Rendszergazda *" or process.command_line like "* Администратор *" or process.command_line like "* Administrateur *" or process.command_line like "* Administrador *" or process.command_line like "* Administratör *" or process.command_line like "* Administrator *" or process.command_line like "* guest *" or process.command_line like "* DefaultAccount *" or process.command_line like "* \"Järjestelmänvalvoja\" *" or process.command_line like "* \"Rendszergazda\" *" or process.command_line like "* \"Администратор\" *" or process.command_line like "* \"Administrateur\" *" or process.command_line like "* \"Administrador\" *" or process.command_line like "* \"Administratör\" *" or process.command_line like "* \"Administrator\" *" or process.command_line like "* \"guest\" *" or process.command_line like "* \"DefaultAccount\" *" or process.command_line like "* 'Järjestelmänvalvoja' *" or process.command_line like "* 'Rendszergazda' *" or process.command_line like "* 'Администратор' *" or process.command_line like "* 'Administrateur' *" or process.command_line like "* 'Administrador' *" or process.command_line like "* 'Administratör' *" or process.command_line like "* 'Administrator' *" or process.command_line like "* 'guest' *" or process.command_line like "* 'DefaultAccount' *") and not (process.command_line like "*guest*" and process.command_line like "*/active no*")
