// BloodHound Collection Files | T1059.001, T1069.001, T1069.002, T1087.001, T1087.002, T1482 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_bloodhound_collection.yml
from * metadata _id, _index, _version | where (ends_with(file.path, "BloodHound.zip") or ends_with(file.path, "_computers.json") or ends_with(file.path, "_containers.json") or ends_with(file.path, "_gpos.json") or ends_with(file.path, "_groups.json") or ends_with(file.path, "_ous.json") or ends_with(file.path, "_users.json")) and not (ends_with(process.executable.caseless, "\\svchost.exe") and starts_with(file.path, "C:\\Program Files\\WindowsApps\\Microsoft.") and ends_with(file.path, "\\pocket_containers.json"))
