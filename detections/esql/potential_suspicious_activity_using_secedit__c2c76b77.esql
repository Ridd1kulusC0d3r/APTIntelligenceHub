// Potential Suspicious Activity Using SeCEdit | T1082, T1505.005, T1546.007, T1546.008, T1547.001, T1547.002, T1547.010, T1547.014, T1556.002, T1557, T1564.002, T1574.007, T1685, T1685.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_secedit_execution.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\secedit.exe") or process.pe.original_file_name=="SeCEdit") and (process.command_line like "*/export*" and process.command_line like "*/cfg*" or process.command_line like "*/configure*" and process.command_line like "*/db*")
