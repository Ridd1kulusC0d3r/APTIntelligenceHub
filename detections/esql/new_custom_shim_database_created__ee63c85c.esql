// New Custom Shim Database Created | T1547.009 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_creation_new_shim_database.yml
from * metadata _id, _index, _version | where file.path like "*:\\Windows\\apppatch\\Custom\\*" or file.path like "*:\\Windows\\apppatch\\CustomSDB\\*"
