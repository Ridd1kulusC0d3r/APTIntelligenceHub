// New Firewall Rule Added In Windows Firewall Exception List For Potential Suspicious Application | T1686.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/firewall_as/win_firewall_as_add_rule_susp_folder.yml
from * metadata _id, _index, _version | where winlog.channel=="Microsoft-Windows-Windows Firewall With Advanced Security/Firewall" and (event.code in ("2004", "2071", "2097")) and (winlog.event_data.ApplicationPath like "*:\\PerfLogs\\*" or winlog.event_data.ApplicationPath like "*:\\Temp\\*" or winlog.event_data.ApplicationPath like "*:\\Tmp\\*" or winlog.event_data.ApplicationPath like "*:\\Users\\Public\\*" or winlog.event_data.ApplicationPath like "*:\\Windows\\Tasks\\*" or winlog.event_data.ApplicationPath like "*:\\Windows\\Temp\\*" or winlog.event_data.ApplicationPath like "*\\AppData\\Local\\Temp\\*") and not winlog.event_data.Action=="2"
