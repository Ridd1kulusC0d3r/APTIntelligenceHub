// HackTool - WinPwn Execution | T1046, T1082, T1106, T1518, T1548.002, T1552.001, T1555, T1555.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_winpwn.yml
from * metadata _id, _index, _version | where process.command_line like "*Offline_Winpwn*" or process.command_line like "*WinPwn *" or process.command_line like "*WinPwn.exe*" or process.command_line like "*WinPwn.ps1*"
