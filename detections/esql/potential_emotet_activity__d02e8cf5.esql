// Potential Emotet Activity | T1027, T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/Malware/Emotet/proc_creation_win_malware_emotet.yml
from * metadata _id, _index, _version | where (process.command_line like "* -e* PAA*" or process.command_line like "*JABlAG4AdgA6AHUAcwBlAHIAcAByAG8AZgBpAGwAZQ*" or process.command_line like "*QAZQBuAHYAOgB1AHMAZQByAHAAcgBvAGYAaQBsAGUA*" or process.command_line like "*kAGUAbgB2ADoAdQBzAGUAcgBwAHIAbwBmAGkAbABlA*" or process.command_line like "*IgAoACcAKgAnACkAOwAkA*" or process.command_line like "*IAKAAnACoAJwApADsAJA*" or process.command_line like "*iACgAJwAqACcAKQA7ACQA*" or process.command_line like "*JABGAGwAeAByAGgAYwBmAGQ*" or process.command_line like "*PQAkAGUAbgB2ADoAdABlAG0AcAArACgA*" or process.command_line like "*0AJABlAG4AdgA6AHQAZQBtAHAAKwAoA*" or process.command_line like "*9ACQAZQBuAHYAOgB0AGUAbQBwACsAKA*") and not (process.command_line like "*fAAgAEMAbwBuAHYAZQByAHQAVABvAC0ASgBzAG8AbgAgAC0ARQByAHIAbwByAEEAYwB0AGkAbwBuACAAUwBpAGwAZQBuAHQAbAB5AEMAbwBuAHQAaQBuAHUAZQ*" or process.command_line like "*wAIABDAG8AbgB2AGUAcgB0AFQAbwAtAEoAcwBvAG4AIAAtAEUAcgByAG8AcgBBAGMAdABpAG8AbgAgAFMAaQBsAGUAbgB0AGwAeQBDAG8AbgB0AGkAbgB1AGUA*" or process.command_line like "*8ACAAQwBvAG4AdgBlAHIAdABUAG8ALQBKAHMAbwBuACAALQBFAHIAcgBvAHIAQQBjAHQAaQBvAG4AIABTAGkAbABlAG4AdABsAHkAQwBvAG4AdABpAG4AdQBlA*")
