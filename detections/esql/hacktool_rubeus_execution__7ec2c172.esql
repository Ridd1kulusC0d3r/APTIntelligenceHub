// HackTool - Rubeus Execution | T1003, T1550.003, T1558.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_rubeus.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\Rubeus.exe") or process.pe.original_file_name=="Rubeus.exe" or process.pe.description=="Rubeus" or process.command_line like "*asreproast *" or process.command_line like "*dump /service:krbtgt *" or process.command_line like "*dump /luid:0x*" or process.command_line like "*kerberoast *" or process.command_line like "*createnetonly /program:*" or process.command_line like "*ptt /ticket:*" or process.command_line like "*/impersonateuser:*" or process.command_line like "*renew /ticket:*" or process.command_line like "*asktgt /user:*" or process.command_line like "*harvest /interval:*" or process.command_line like "*s4u /user:*" or process.command_line like "*s4u /ticket:*" or process.command_line like "*hash /password:*" or process.command_line like "*golden /aes256:*" or process.command_line like "*silver /user:*"
