// Operation Wocao Activity | T1012, T1027, T1036.004, T1053.005, T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/TA/Operation-Wocao/proc_creation_win_apt_wocao.yml
from * metadata _id, _index, _version | where process.command_line like "*checkadmin.exe 127.0.0.1 -all*" or process.command_line like "*netsh advfirewall firewall add rule name=powershell dir=in*" or process.command_line like "*cmd /c powershell.exe -ep bypass -file c:\\s.ps1*" or process.command_line like "*/tn win32times /f*" or process.command_line like "*create win32times binPath=*" or process.command_line like "*\\c$\\windows\\system32\\devmgr.dll*" or process.command_line like "* -exec bypass -enc JgAg*" or process.command_line like "*type *keepass\\KeePass.config.xml*" or process.command_line like "*iie.exe iie.txt*" or process.command_line like "*reg query HKEY_CURRENT_USER\\Software\\*\\PuTTY\\Sessions\\*"
