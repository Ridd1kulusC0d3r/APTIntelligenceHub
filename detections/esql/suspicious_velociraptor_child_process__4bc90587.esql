// Suspicious Velociraptor Child Process | T1219 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_velociraptor_child_process.yml
from * metadata _id, _index, _version | where ends_with(process.parent.executable.caseless, "\\Velociraptor.exe") and (process.command_line like "*code.exe*" and process.command_line like "*tunnel*" and process.command_line like "*--accept-server-license-terms*" or process.command_line like "*msiexec*" and process.command_line like "*/i*" and process.command_line like "*http*" or (ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\powershell_ise.exe") or ends_with(process.executable.caseless, "\\pwsh.exe")) and (process.command_line like "*Invoke-WebRequest *" or process.command_line like "*IWR *" or process.command_line like "*.DownloadFile*" or process.command_line like "*.DownloadString*"))
