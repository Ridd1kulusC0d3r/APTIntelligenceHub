// Uncommon File Created In Office Startup Folder | T1587.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_office_uncommon_file_startup.yml
from * metadata _id, _index, _version | where ((file.path like "*\\Microsoft\\Word\\STARTUP*" or file.path like "*\\Office*" and file.path like "*\\Program Files*" and file.path like "*\\STARTUP*") and not (ends_with(file.path, ".docb") or ends_with(file.path, ".docm") or ends_with(file.path, ".docx") or ends_with(file.path, ".dotm") or ends_with(file.path, ".mdb") or ends_with(file.path, ".mdw") or ends_with(file.path, ".pdf") or ends_with(file.path, ".wll") or ends_with(file.path, ".wwl")) or (file.path like "*\\Microsoft\\Excel\\XLSTART*" or file.path like "*\\Office*" and file.path like "*\\Program Files*" and file.path like "*\\XLSTART*") and not (ends_with(file.path, ".xll") or ends_with(file.path, ".xls") or ends_with(file.path, ".xlsm") or ends_with(file.path, ".xlsx") or ends_with(file.path, ".xlt") or ends_with(file.path, ".xltm") or ends_with(file.path, ".xlw"))) and not (process.executable.caseless like "*:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\*" and ends_with(process.executable.caseless, "\\OfficeClickToRun.exe") or (process.executable.caseless like "*:\\Program Files\\Microsoft Office\\*" or process.executable.caseless like "*:\\Program Files (x86)\\Microsoft Office\\*") and (ends_with(process.executable.caseless, "\\winword.exe") or ends_with(process.executable.caseless, "\\excel.exe")))
