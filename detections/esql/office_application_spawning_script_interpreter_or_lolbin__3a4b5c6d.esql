// Office Application Spawning Script Interpreter Or LOLBin | T1204.002, T1221 | Hub
from * metadata _id, _index, _version | where (ends_with(process.parent.executable.caseless, "\\WINWORD.EXE") or ends_with(process.parent.executable.caseless, "\\EXCEL.EXE") or ends_with(process.parent.executable.caseless, "\\POWERPNT.EXE")) and (ends_with(process.executable.caseless, "\\wscript.exe") or ends_with(process.executable.caseless, "\\cscript.exe") or ends_with(process.executable.caseless, "\\mshta.exe") or ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\cmd.exe"))
