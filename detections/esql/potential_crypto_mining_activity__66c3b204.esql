// Potential Crypto Mining Activity | T1496 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_crypto_mining_monero.yml
from * metadata _id, _index, _version | where (process.command_line like "* --cpu-priority=*" or process.command_line like "*--donate-level=0*" or process.command_line like "* -o pool.*" or process.command_line like "* --nicehash*" or process.command_line like "* --algo=rx/0 *" or process.command_line like "*stratum+tcp://*" or process.command_line like "*stratum+udp://*" or process.command_line like "*LS1kb25hdGUtbGV2ZWw9*" or process.command_line like "*0tZG9uYXRlLWxldmVsP*" or process.command_line like "*tLWRvbmF0ZS1sZXZlbD*" or process.command_line like "*c3RyYXR1bSt0Y3A6Ly*" or process.command_line like "*N0cmF0dW0rdGNwOi8v*" or process.command_line like "*zdHJhdHVtK3RjcDovL*" or process.command_line like "*c3RyYXR1bSt1ZHA6Ly*" or process.command_line like "*N0cmF0dW0rdWRwOi8v*" or process.command_line like "*zdHJhdHVtK3VkcDovL*") and not (process.command_line like "* pool.c *" or process.command_line like "* pool.o *" or process.command_line like "*gcc -*")
