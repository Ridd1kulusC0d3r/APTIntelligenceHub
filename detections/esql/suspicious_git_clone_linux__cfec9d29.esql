// Suspicious Git Clone - Linux | T1593.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_susp_git_clone.yml
from * metadata _id, _index, _version | where ends_with(Image, "/git") and CommandLine like "* clone *" and (CommandLine like "*exploit*" or CommandLine like "*Vulns*" or CommandLine like "*vulnerability*" or CommandLine like "*RCE*" or CommandLine like "*RemoteCodeExecution*" or CommandLine like "*Invoke-*" or CommandLine like "*CVE-*" or CommandLine like "*poc-*" or CommandLine like "*ProofOfConcept*" or CommandLine like "*proxyshell*" or CommandLine like "*log4shell*" or CommandLine like "*eternalblue*" or CommandLine like "*eternal-blue*" or CommandLine like "*MS17-*")
