// Potentially Suspicious NTFS Symlink Behavior Modification | T1059, T1222.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_fsutil_symlinkevaluation.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\cmd.exe") or ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\pwsh.exe") or process.pe.original_file_name in ("Cmd.Exe", "PowerShell.EXE", "pwsh.dll")) and process.command_line like "*fsutil*" and process.command_line like "*behavior*" and process.command_line like "*set*" and process.command_line like "*SymlinkEvaluation*" and (process.command_line like "*R2L:1*" or process.command_line like "*R2R:1*" or process.command_line like "*L2L:1*")
