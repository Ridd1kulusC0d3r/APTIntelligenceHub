// Suspicious DotNET CLR Usage Log Artifact | T1218 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_net_cli_artefact.yml
from * metadata _id, _index, _version | where (ends_with(file.path, "\\UsageLogs\\cmstp.exe.log") or ends_with(file.path, "\\UsageLogs\\cscript.exe.log") or ends_with(file.path, "\\UsageLogs\\mshta.exe.log") or ends_with(file.path, "\\UsageLogs\\msxsl.exe.log") or ends_with(file.path, "\\UsageLogs\\regsvr32.exe.log") or ends_with(file.path, "\\UsageLogs\\rundll32.exe.log") or ends_with(file.path, "\\UsageLogs\\svchost.exe.log") or ends_with(file.path, "\\UsageLogs\\wscript.exe.log") or ends_with(file.path, "\\UsageLogs\\wmic.exe.log")) and not (ends_with(process.parent.executable.caseless, "\\MsiExec.exe") and process.parent.command_line like "* -Embedding*" and ends_with(process.executable.caseless, "\\rundll32.exe") and winlog.event_data.CommandLine like "*Temp*" and winlog.event_data.CommandLine like "*zzzzInvokeManagedCustomActionOutOfProc*")
