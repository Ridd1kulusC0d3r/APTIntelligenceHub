// File Explorer Folder Opened Using Explorer Folder Shortcut Via Shell | T1135 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_explorer_folder_shortcut_via_shell_binary.yml
from * metadata _id, _index, _version | where (ends_with(process.parent.executable.caseless, "\\cmd.exe") or ends_with(process.parent.executable.caseless, "\\powershell.exe") or ends_with(process.parent.executable.caseless, "\\pwsh.exe")) and ends_with(process.executable.caseless, "\\explorer.exe") and process.command_line like "*shell:mycomputerfolder*"
