// HackTool - TruffleSnout Execution | T1482 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_trufflesnout.yml
from * metadata _id, _index, _version | where process.pe.original_file_name=="TruffleSnout.exe" or ends_with(process.executable.caseless, "\\TruffleSnout.exe")
