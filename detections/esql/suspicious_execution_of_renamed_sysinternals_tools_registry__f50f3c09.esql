// Suspicious Execution Of Renamed Sysinternals Tools - Registry | T1588.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_pua_sysinternals_renamed_execution_via_eula.yml
from * metadata _id, _index, _version | where (registry.path like "*\\Active Directory Explorer*" or registry.path like "*\\Handle*" or registry.path like "*\\LiveKd*" or registry.path like "*\\ProcDump*" or registry.path like "*\\Process Explorer*" or registry.path like "*\\PsExec*" or registry.path like "*\\PsLoggedon*" or registry.path like "*\\PsLoglist*" or registry.path like "*\\PsPasswd*" or registry.path like "*\\PsPing*" or registry.path like "*\\PsService*" or registry.path like "*\\SDelete*") and ends_with(registry.path, "\\EulaAccepted") and not (ends_with(process.executable.caseless, "\\ADExplorer.exe") or ends_with(process.executable.caseless, "\\ADExplorer64.exe") or ends_with(process.executable.caseless, "\\ADExplorer64a.exe") or ends_with(process.executable.caseless, "\\handle.exe") or ends_with(process.executable.caseless, "\\handle64.exe") or ends_with(process.executable.caseless, "\\handle64a.exe") or ends_with(process.executable.caseless, "\\livekd.exe") or ends_with(process.executable.caseless, "\\livekd64.exe") or ends_with(process.executable.caseless, "\\procdump.exe") or ends_with(process.executable.caseless, "\\procdump64.exe") or ends_with(process.executable.caseless, "\\procdump64a.exe") or ends_with(process.executable.caseless, "\\procexp.exe") or ends_with(process.executable.caseless, "\\procexp64.exe") or ends_with(process.executable.caseless, "\\procexp64a.exe") or ends_with(process.executable.caseless, "\\PsExec.exe") or ends_with(process.executable.caseless, "\\PsExec64.exe") or ends_with(process.executable.caseless, "\\PsExec64a.exe") or ends_with(process.executable.caseless, "\\PsLoggedon.exe") or ends_with(process.executable.caseless, "\\PsLoggedon64.exe") or ends_with(process.executable.caseless, "\\psloglist.exe") or ends_with(process.executable.caseless, "\\psloglist64.exe") or ends_with(process.executable.caseless, "\\psloglist64a.exe") or ends_with(process.executable.caseless, "\\pspasswd.exe") or ends_with(process.executable.caseless, "\\pspasswd64.exe") or ends_with(process.executable.caseless, "\\pspasswd64a.exe") or ends_with(process.executable.caseless, "\\PsPing.exe") or ends_with(process.executable.caseless, "\\PsPing64.exe") or ends_with(process.executable.caseless, "\\PsPing64a.exe") or ends_with(process.executable.caseless, "\\PsService.exe") or ends_with(process.executable.caseless, "\\PsService64.exe") or ends_with(process.executable.caseless, "\\PsService64a.exe") or ends_with(process.executable.caseless, "\\sdelete.exe"))
