// Sysmon Configuration Error | T1564 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/sysmon/sysmon_config_modification_error.yml
from * metadata _id, _index, _version | where (winlog.event_data.Description like "*Failed to open service configuration with error*" or winlog.event_data.Description like "*Failed to connect to the driver to update configuration*") and not (winlog.event_data.Description like "*Failed to open service configuration with error*" and winlog.event_data.Description like "*Last error: The media is write protected.*" or winlog.event_data.Description like "*Failed to open service configuration with error*" and winlog.event_data.Description like "*Last error: Média protégé en écriture.*" or winlog.event_data.Description like "*Failed to open service configuration with error 19*" or winlog.event_data.Description like "*Failed to open service configuration with error 93*")
