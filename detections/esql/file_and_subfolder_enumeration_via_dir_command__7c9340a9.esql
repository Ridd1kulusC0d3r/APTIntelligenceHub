// File And SubFolder Enumeration Via Dir Command | T1217 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_cmd_dir_execution.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\cmd.exe") or process.pe.original_file_name=="Cmd.Exe") and (process.command_line like "*-s*" or process.command_line like "*/s*" or process.command_line like "*–s*" or process.command_line like "*—s*" or process.command_line like "*―s*") and process.command_line like "*dir *" and not process.command_line like "*rmdir*"
