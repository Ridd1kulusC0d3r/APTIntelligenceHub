// Potential In-Memory Execution Using Reflection.Assembly | T1620 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_dotnet_assembly_from_file.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*[Reflection.Assembly]::load*" and not ((starts_with(winlog.event_data.Path, "C:\\Program Files (x86)\\Microsoft SQL Server\\") or starts_with(winlog.event_data.Path, "C:\\Program Files\\Microsoft SQL Server\\")) and ends_with(winlog.event_data.Path, "\\Tools\\PowerShell\\Modules\\SQLPS\\SqlPsPostScript.ps1") and powershell.file.script_block_text like "*SQLSERVER: { Set-Location*")
