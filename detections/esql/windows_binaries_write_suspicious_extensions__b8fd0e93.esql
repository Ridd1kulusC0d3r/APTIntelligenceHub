// Windows Binaries Write Suspicious Extensions | T1036 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_shell_write_susp_files_extensions.yml
from * metadata _id, _index, _version | where ((ends_with(process.executable.caseless, "\\csrss.exe") or ends_with(process.executable.caseless, "\\lsass.exe") or ends_with(process.executable.caseless, "\\RuntimeBroker.exe") or ends_with(process.executable.caseless, "\\sihost.exe") or ends_with(process.executable.caseless, "\\smss.exe") or ends_with(process.executable.caseless, "\\wininit.exe") or ends_with(process.executable.caseless, "\\winlogon.exe")) and (ends_with(file.path, ".bat") or ends_with(file.path, ".dll") or ends_with(file.path, ".exe") or ends_with(file.path, ".hta") or ends_with(file.path, ".iso") or ends_with(file.path, ".ps1") or ends_with(file.path, ".txt") or ends_with(file.path, ".vbe") or ends_with(file.path, ".vbs")) or (ends_with(process.executable.caseless, "\\dllhost.exe") or ends_with(process.executable.caseless, "\\rundll32.exe") or ends_with(process.executable.caseless, "\\svchost.exe")) and (ends_with(file.path, ".bat") or ends_with(file.path, ".hta") or ends_with(file.path, ".iso") or ends_with(file.path, ".ps1") or ends_with(file.path, ".vbe") or ends_with(file.path, ".vbs"))) and not (process.executable.caseless=="C:\\Windows\\System32\\dllhost.exe" and file.path like "*:\\Users\\*" and file.path like "*\\AppData\\Local\\Temp\\__PSScriptPolicyTest_*" and ends_with(file.path, ".ps1") or process.executable.caseless=="C:\\Windows\\system32\\svchost.exe" and file.path like "*C:\\Windows\\System32\\GroupPolicy\\DataStore\\*" and file.path like "*\\sysvol\\*" and file.path like "*\\Policies\\*" and file.path like "*\\Machine\\Scripts\\Startup\\*" and (ends_with(file.path, ".ps1") or ends_with(file.path, ".bat")) or process.executable.caseless=="C:\\Windows\\system32\\svchost.exe" and file.path like "*C:\\Program Files\\WindowsApps\\Clipchamp*" and file.path like "*.ps1*" or (process.executable.caseless in ("C:\\Windows\\system32\\svchost.exe", "C:\\Windows\\SysWOW64\\svchost.exe")) and (starts_with(file.path, "C:\\Program Files\\WindowsApps\\Microsoft.PowerShellPreview") or starts_with(file.path, "C:\\Program Files (x86)\\WindowsApps\\Microsoft.PowerShellPreview")) and ends_with(file.path, ".ps1"))
