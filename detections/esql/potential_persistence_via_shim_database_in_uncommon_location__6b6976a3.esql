// Potential Persistence Via Shim Database In Uncommon Location | T1546.011 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_persistence_shim_database_uncommon_location.yml
from * metadata _id, _index, _version | where registry.path like "*\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\InstalledSDB\\*" and registry.path like "*\\DatabasePath*" and not winlog.event_data.Details like "*:\\Windows\\AppPatch\\Custom*"
