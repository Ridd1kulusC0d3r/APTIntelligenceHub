// Steganography Unzip Hidden Information From Picture File | T1027.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/auditd/execve/lnx_auditd_unzip_hidden_zip_files_steganography.yml
from * metadata _id, _index, _version | where type=="EXECVE" and a0=="unzip" and (ends_with(a1, ".jpg") or ends_with(a1, ".png"))
