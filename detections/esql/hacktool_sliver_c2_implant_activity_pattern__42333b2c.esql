// HackTool - Sliver C2 Implant Activity Pattern | T1059 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_sliver_c2_execution_pattern.yml
from * metadata _id, _index, _version | where process.command_line like "*-NoExit -Command [Console]::OutputEncoding=[Text.UTF8Encoding]::UTF8*"
