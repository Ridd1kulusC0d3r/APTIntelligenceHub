// SQLite Chromium Profile Data DB Access | T1005, T1539, T1555.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_sqlite_chromium_profile_data.yml
from * metadata _id, _index, _version | where (process.pe.product=="SQLite" or ends_with(process.executable.caseless, "\\sqlite.exe") or ends_with(process.executable.caseless, "\\sqlite3.exe")) and (process.command_line like "*\\User Data\\*" or process.command_line like "*\\Opera Software\\*" or process.command_line like "*\\ChromiumViewer\\*") and (process.command_line like "*Login Data*" or process.command_line like "*Cookies*" or process.command_line like "*Web Data*" or process.command_line like "*History*" or process.command_line like "*Bookmarks*")
