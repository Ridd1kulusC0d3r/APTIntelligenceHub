// DLL Load via LSASS | T1547.008 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_susp_lsass_dll_load.yml
from * metadata _id, _index, _version | where (registry.path like "*\\CurrentControlSet\\Services\\NTDS\\DirectoryServiceExtPt*" or registry.path like "*\\CurrentControlSet\\Services\\NTDS\\LsaDbExtPt*") and not (process.executable.caseless=="C:\\Windows\\system32\\lsass.exe" and (winlog.event_data.Details in ("%%systemroot%%\\system32\\ntdsa.dll", "%%systemroot%%\\system32\\lsadb.dll")))
