// GUI Input Capture - macOS | T1056.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_gui_input_capture.yml
from * metadata _id, _index, _version | where ends_with(Image, "/osascript") and CommandLine like "*-e*" and CommandLine like "*display*" and CommandLine like "*dialog*" and CommandLine like "*answer*" and (CommandLine like "*admin*" or CommandLine like "*administrator*" or CommandLine like "*authenticate*" or CommandLine like "*authentication*" or CommandLine like "*credentials*" or CommandLine like "*pass*" or CommandLine like "*password*" or CommandLine like "*unlock*")
