// Port Forwarding Activity Via SSH.EXE | T1021.001, T1021.004, T1572 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_ssh_port_forward.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\ssh.exe") and (process.command_line like "* -R *" or process.command_line like "* /R *" or process.command_line like "* –R *" or process.command_line like "* —R *" or process.command_line like "* ―R *")
