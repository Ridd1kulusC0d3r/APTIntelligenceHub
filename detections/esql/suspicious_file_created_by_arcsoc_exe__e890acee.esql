// Suspicious File Created by ArcSOC.exe | T1105, T1127, T1133 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_arcsoc_susp_file_created.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\ArcSOC.exe") and (ends_with(file.path, ".ahk") or ends_with(file.path, ".aspx") or ends_with(file.path, ".au3") or ends_with(file.path, ".bat") or ends_with(file.path, ".cmd") or ends_with(file.path, ".dll") or ends_with(file.path, ".exe") or ends_with(file.path, ".hta") or ends_with(file.path, ".js") or ends_with(file.path, ".ps1") or ends_with(file.path, ".py") or ends_with(file.path, ".vbe") or ends_with(file.path, ".vbs") or ends_with(file.path, ".wsf"))
