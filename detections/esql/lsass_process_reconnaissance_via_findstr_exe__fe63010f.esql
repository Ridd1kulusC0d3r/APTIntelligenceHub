// LSASS Process Reconnaissance Via Findstr.EXE | T1552.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_findstr_lsass.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\find.exe") or ends_with(process.executable.caseless, "\\findstr.exe") or process.pe.original_file_name in ("FIND.EXE", "FINDSTR.EXE")) and process.command_line like "*lsass*" or process.command_line like "* -i \"lsass*" or process.command_line like "* /i \"lsass*" or process.command_line like "* –i \"lsass*" or process.command_line like "* —i \"lsass*" or process.command_line like "* ―i \"lsass*" or process.command_line like "* -i lsass.exe*" or process.command_line like "* /i lsass.exe*" or process.command_line like "* –i lsass.exe*" or process.command_line like "* —i lsass.exe*" or process.command_line like "* ―i lsass.exe*" or process.command_line like "*findstr \"lsass*" or process.command_line like "*findstr lsass*" or process.command_line like "*findstr.exe \"lsass*" or process.command_line like "*findstr.exe lsass*"
