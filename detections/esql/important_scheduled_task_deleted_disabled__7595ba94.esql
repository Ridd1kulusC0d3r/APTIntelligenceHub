// Important Scheduled Task Deleted/Disabled | T1053.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_susp_scheduled_task_delete_or_disable.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and (event.code in ("4699", "4701")) and (winlog.event_data.TaskName like "*\\Windows\\SystemRestore\\SR*" or winlog.event_data.TaskName like "*\\Windows\\Windows Defender\\*" or winlog.event_data.TaskName like "*\\Windows\\BitLocker*" or winlog.event_data.TaskName like "*\\Windows\\WindowsBackup\\*" or winlog.event_data.TaskName like "*\\Windows\\WindowsUpdate\\*" or winlog.event_data.TaskName like "*\\Windows\\UpdateOrchestrator\\Schedule*" or winlog.event_data.TaskName like "*\\Windows\\ExploitGuard*") and not (event.code=="4699" and ends_with(user.name, "$") and winlog.event_data.TaskName like "*\\Windows\\Windows Defender\\*")
