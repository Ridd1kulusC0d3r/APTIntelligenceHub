// AWS ElastiCache Security Group Created | T1136, T1136.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/aws/cloudtrail/aws_elasticache_security_group_created.yml
from * metadata _id, _index, _version | where eventSource=="elasticache.amazonaws.com" and eventName=="CreateCacheSecurityGroup"
