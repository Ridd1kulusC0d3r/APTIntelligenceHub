// Mustang Panda Dropper | T1587.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/TA/MustangPanda/proc_creation_win_apt_mustangpanda.yml
from * metadata _id, _index, _version | where process.command_line like "*Temp\\wtask.exe /create*" or process.command_line like "*%windir:~-3,1%%PUBLIC:~-9,1%*" or process.command_line like "*/tn \"Security Script *" or process.command_line like "*%windir:~-1,1%*" or process.command_line like "*/E:vbscript*" and process.command_line like "*C:\\Users\\*" and process.command_line like "*.txt*" and process.command_line like "*/F*" or ends_with(process.executable.caseless, "Temp\\winwsh.exe")
