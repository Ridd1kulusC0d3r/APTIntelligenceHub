// RDP Port Forwarding Rule Added Via Netsh.EXE | T1090 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_netsh_port_forwarding_3389.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\netsh.exe") or process.pe.original_file_name=="netsh.exe") and process.command_line like "* i*" and process.command_line like "* p*" and process.command_line like "*=3389*" and process.command_line like "* c*"
