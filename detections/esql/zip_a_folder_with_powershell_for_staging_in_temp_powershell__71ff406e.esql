// Zip A Folder With PowerShell For Staging In Temp - PowerShell | T1074.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_classic/posh_pc_susp_zip_compress.yml
from * metadata _id, _index, _version | where winlog.channel=="Windows PowerShell" and (winlog.event_data.Data like "*Compress-Archive -Path*-DestinationPath $env:TEMP*" or winlog.event_data.Data like "*Compress-Archive -Path*-DestinationPath*\\AppData\\Local\\Temp\\*" or winlog.event_data.Data like "*Compress-Archive -Path*-DestinationPath*:\\Windows\\Temp\\*")
