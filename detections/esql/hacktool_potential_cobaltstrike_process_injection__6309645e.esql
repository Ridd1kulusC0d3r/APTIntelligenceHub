// HackTool - Potential CobaltStrike Process Injection | T1055.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/create_remote_thread/create_remote_thread_win_hktl_cobaltstrike.yml
from * metadata _id, _index, _version | where ends_with(winlog.event_data.StartAddress, "0B80") or ends_with(winlog.event_data.StartAddress, "0C7C") or ends_with(winlog.event_data.StartAddress, "0C88")
