// Suspicious Camera and Microphone Access | T1123, T1125 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_susp_mic_cam_access.yml
from * metadata _id, _index, _version | where registry.path like "*\\Software\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore\\*" and registry.path like "*\\NonPackaged*" and (registry.path like "*microphone*" or registry.path like "*webcam*") and (registry.path like "*:#Windows#Temp#*" or registry.path like "*:#$Recycle.bin#*" or registry.path like "*:#Temp#*" or registry.path like "*:#Users#Public#*" or registry.path like "*:#Users#Default#*" or registry.path like "*:#Users#Desktop#*")
