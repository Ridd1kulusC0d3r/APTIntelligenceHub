// Suspicious External WebDAV Execution | T1566, T1584 | https://github.com/SigmaHQ/sigma/blob/master/rules/web/proxy_generic/proxy_webdav_external_execution.yml
from * metadata _id, _index, _version | where starts_with(`c-useragent`, "Microsoft-WebDAV-MiniRedir/") and `cs-method`=="GET" and (ends_with(`c-uri`, ".7z") or ends_with(`c-uri`, ".bat") or ends_with(`c-uri`, ".dat") or ends_with(`c-uri`, ".cmd") or ends_with(`c-uri`, ".exe") or ends_with(`c-uri`, ".js") or ends_with(`c-uri`, ".lnk") or ends_with(`c-uri`, ".ps1") or ends_with(`c-uri`, ".rar") or ends_with(`c-uri`, ".url") or ends_with(`c-uri`, ".vbe") or ends_with(`c-uri`, ".vbs") or ends_with(`c-uri`, ".zip")) and not (cidr_match(dst_ip, "127.0.0.0/8") or cidr_match(dst_ip, "10.0.0.0/8") or cidr_match(dst_ip, "172.16.0.0/12") or cidr_match(dst_ip, "192.168.0.0/16") or cidr_match(dst_ip, "169.254.0.0/16") or cidr_match(dst_ip, "::1/128") or cidr_match(dst_ip, "fe80::/10") or cidr_match(dst_ip, "fc00::/7"))
