// Potential Persistence Via Microsoft Office Startup Folder | T1137 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_office_startup_persistence.yml
from * metadata _id, _index, _version | where ((file.path like "*\\Microsoft\\Word\\STARTUP*" or file.path like "*\\Office*" and file.path like "*\\Program Files*" and file.path like "*\\STARTUP*") and (ends_with(file.path, ".doc") or ends_with(file.path, ".docm") or ends_with(file.path, ".docx") or ends_with(file.path, ".dot") or ends_with(file.path, ".dotm") or ends_with(file.path, ".rtf")) or (file.path like "*\\Microsoft\\Excel\\XLSTART*" or file.path like "*\\Office*" and file.path like "*\\Program Files*" and file.path like "*\\XLSTART*") and (ends_with(file.path, ".xls") or ends_with(file.path, ".xlsm") or ends_with(file.path, ".xlsx") or ends_with(file.path, ".xlt") or ends_with(file.path, ".xltm"))) and not (ends_with(process.executable.caseless, "\\WINWORD.exe") or ends_with(process.executable.caseless, "\\EXCEL.exe"))
