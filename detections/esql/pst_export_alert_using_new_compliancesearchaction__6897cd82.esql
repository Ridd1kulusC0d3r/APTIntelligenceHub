// PST Export Alert Using New-ComplianceSearchAction | T1114 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/m365/threat_management/microsoft365_pst_export_alert_using_new_compliancesearchaction.yml
from * metadata _id, _index, _version | where eventSource=="SecurityComplianceCenter" and Payload like "*New-ComplianceSearchAction*" and Payload like "*Export*" and Payload like "*pst*"
