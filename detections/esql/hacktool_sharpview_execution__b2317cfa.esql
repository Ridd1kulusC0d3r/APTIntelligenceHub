// HackTool - SharpView Execution | T1033, T1049, T1069.002, T1135, T1482 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_sharpview.yml
from * metadata _id, _index, _version | where process.pe.original_file_name=="SharpView.exe" or ends_with(process.executable.caseless, "\\SharpView.exe") or process.command_line like "*Add-RemoteConnection*" or process.command_line like "*Convert-ADName*" or process.command_line like "*ConvertFrom-SID*" or process.command_line like "*ConvertFrom-UACValue*" or process.command_line like "*Convert-SidToName*" or process.command_line like "*Export-PowerViewCSV*" or process.command_line like "*Find-DomainObjectPropertyOutlier*" or process.command_line like "*Find-DomainProcess*" or process.command_line like "*Find-DomainShare*" or process.command_line like "*Find-DomainUserEvent*" or process.command_line like "*Find-DomainUserLocation*" or process.command_line like "*Find-ForeignGroup*" or process.command_line like "*Find-ForeignUser*" or process.command_line like "*Find-GPOComputerAdmin*" or process.command_line like "*Find-GPOLocation*" or process.command_line like "*Find-Interesting*" or process.command_line like "*Find-LocalAdminAccess*" or process.command_line like "*Find-ManagedSecurityGroups*" or process.command_line like "*Get-CachedRDPConnection*" or process.command_line like "*Get-DFSshare*" or process.command_line like "*Get-DomainComputer*" or process.command_line like "*Get-DomainController*" or process.command_line like "*Get-DomainDFSShare*" or process.command_line like "*Get-DomainDNSRecord*" or process.command_line like "*Get-DomainFileServer*" or process.command_line like "*Get-DomainForeign*" or process.command_line like "*Get-DomainGPO*" or process.command_line like "*Get-DomainGroup*" or process.command_line like "*Get-DomainGUIDMap*" or process.command_line like "*Get-DomainManagedSecurityGroup*" or process.command_line like "*Get-DomainObject*" or process.command_line like "*Get-DomainOU*" or process.command_line like "*Get-DomainPolicy*" or process.command_line like "*Get-DomainSID*" or process.command_line like "*Get-DomainSite*" or process.command_line like "*Get-DomainSPNTicket*" or process.command_line like "*Get-DomainSubnet*" or process.command_line like "*Get-DomainTrust*" or process.command_line like "*Get-DomainUserEvent*" or process.command_line like "*Get-ForestDomain*" or process.command_line like "*Get-ForestGlobalCatalog*" or process.command_line like "*Get-ForestTrust*" or process.command_line like "*Get-GptTmpl*" or process.command_line like "*Get-GroupsXML*" or process.command_line like "*Get-LastLoggedOn*" or process.command_line like "*Get-LoggedOnLocal*" or process.command_line like "*Get-NetComputer*" or process.command_line like "*Get-NetDomain*" or process.command_line like "*Get-NetFileServer*" or process.command_line like "*Get-NetForest*" or process.command_line like "*Get-NetGPO*" or process.command_line like "*Get-NetGroupMember*" or process.command_line like "*Get-NetLocalGroup*" or process.command_line like "*Get-NetLoggedon*" or process.command_line like "*Get-NetOU*" or process.command_line like "*Get-NetProcess*" or process.command_line like "*Get-NetRDPSession*" or process.command_line like "*Get-NetSession*" or process.command_line like "*Get-NetShare*" or process.command_line like "*Get-NetSite*" or process.command_line like "*Get-NetSubnet*" or process.command_line like "*Get-NetUser*" or process.command_line like "*Get-PathAcl*" or process.command_line like "*Get-PrincipalContext*" or process.command_line like "*Get-RegistryMountedDrive*" or process.command_line like "*Get-RegLoggedOn*" or process.command_line like "*Get-WMIRegCachedRDPConnection*" or process.command_line like "*Get-WMIRegLastLoggedOn*" or process.command_line like "*Get-WMIRegMountedDrive*" or process.command_line like "*Get-WMIRegProxy*" or process.command_line like "*Invoke-ACLScanner*" or process.command_line like "*Invoke-CheckLocalAdminAccess*" or process.command_line like "*Invoke-Kerberoast*" or process.command_line like "*Invoke-MapDomainTrust*" or process.command_line like "*Invoke-RevertToSelf*" or process.command_line like "*Invoke-Sharefinder*" or process.command_line like "*Invoke-UserImpersonation*" or process.command_line like "*Remove-DomainObjectAcl*" or process.command_line like "*Remove-RemoteConnection*" or process.command_line like "*Request-SPNTicket*" or process.command_line like "*Set-DomainObject*" or process.command_line like "*Test-AdminAccess*"
