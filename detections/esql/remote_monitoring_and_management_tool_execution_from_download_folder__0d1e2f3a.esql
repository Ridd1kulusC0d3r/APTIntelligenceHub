// Remote Monitoring And Management Tool Execution From Download Folder | T1219 | Hub
from * metadata _id, _index, _version | where (process.executable.caseless like "*AteraAgent*" or process.executable.caseless like "*ScreenConnect*" or process.executable.caseless like "*SimpleHelp*" or process.executable.caseless like "*AnyDesk*" or process.executable.caseless like "*Syncro*" or process.executable.caseless like "*netbird*" or process.pe.product like "*Atera*" or process.pe.product like "*ScreenConnect*" or process.pe.product like "*SimpleHelp*" or process.pe.product like "*AnyDesk*") and (process.executable.caseless like "*\\Downloads\\*" or process.executable.caseless like "*\\AppData\\Local\\Temp\\*")
