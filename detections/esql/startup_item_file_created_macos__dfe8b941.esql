// Startup Item File Created - MacOS | T1037.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/file_event/file_event_macos_susp_startup_item_created.yml
from * metadata _id, _index, _version | where (starts_with(TargetFilename, "/Library/StartupItems/") or starts_with(TargetFilename, "/System/Library/StartupItems")) and ends_with(TargetFilename, ".plist")
