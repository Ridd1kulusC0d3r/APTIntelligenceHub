// RDP over Reverse SSH Tunnel WFP | T1021.001, T1090.001, T1090.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_rdp_reverse_tunnel.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="5156" and (source.port==3389 and (starts_with(destination.ip, "127.") or destination.ip=="::1") or destination.port==3389 and (starts_with(source.ip, "127.") or source.ip=="::1")) and not (winlog.event_data.FilterOrigin=="AppContainer Loopback" or ends_with(process.executable.caseless, "\\thor.exe") or ends_with(process.executable.caseless, "\\thor64.exe"))
