// Python One-Liners with Base64 Decoding - Linux | T1027.010, T1059.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_python_base64_encoded_execution.yml
from * metadata _id, _index, _version | where Image like "*/python*" and CommandLine like "*import*" and CommandLine like "*base64*" and CommandLine like "* -c*" and (CommandLine like "*.decode*" or CommandLine like "*b16decode*" or CommandLine like "*b32decode*" or CommandLine like "*b32hexdecode*" or CommandLine like "*b64decode*" or CommandLine like "*b85decode*" or CommandLine like "*z85decode*")
