// Potential Registry Persistence Attempt Via Windows Telemetry | T1053.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_telemetry_persistence.yml
from * metadata _id, _index, _version | where registry.path like "*\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\TelemetryController\\*" and ends_with(registry.path, "\\Command") and (winlog.event_data.Details like "*.bat*" or winlog.event_data.Details like "*.bin*" or winlog.event_data.Details like "*.cmd*" or winlog.event_data.Details like "*.dat*" or winlog.event_data.Details like "*.dll*" or winlog.event_data.Details like "*.exe*" or winlog.event_data.Details like "*.hta*" or winlog.event_data.Details like "*.jar*" or winlog.event_data.Details like "*.js*" or winlog.event_data.Details like "*.msi*" or winlog.event_data.Details like "*.ps*" or winlog.event_data.Details like "*.sh*" or winlog.event_data.Details like "*.vb*") and not (winlog.event_data.Details like "*\\system32\\CompatTelRunner.exe*" or winlog.event_data.Details like "*\\system32\\DeviceCensus.exe*")
