// CMSTP App Paths Registry Key Modification | T1218.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_cmstp_execution_by_registry.yml
from * metadata _id, _index, _version | where registry.path like "*SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths\\cmmgr32.exe\\*" and not (ends_with(registry.path, "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths\\cmmgr32.exe\\CmstpExtensionDll") and (winlog.event_data.Details in ("C:\\Windows\\System32\\cmcfg32.dll", "C:\\Windows\\SysWOW64\\cmcfg32.dll")) or winlog.event_data.Details=="(Empty)")
