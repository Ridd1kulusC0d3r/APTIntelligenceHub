// Suspicious Access to Sensitive File Extensions | T1039 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_susp_raccess_sensitive_fext.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="5145" and (ends_with(winlog.event_data.RelativeTargetName, ".bak") or ends_with(winlog.event_data.RelativeTargetName, ".dmp") or ends_with(winlog.event_data.RelativeTargetName, ".edb") or ends_with(winlog.event_data.RelativeTargetName, ".kirbi") or ends_with(winlog.event_data.RelativeTargetName, ".msg") or ends_with(winlog.event_data.RelativeTargetName, ".nsf") or ends_with(winlog.event_data.RelativeTargetName, ".nst") or ends_with(winlog.event_data.RelativeTargetName, ".oab") or ends_with(winlog.event_data.RelativeTargetName, ".ost") or ends_with(winlog.event_data.RelativeTargetName, ".pst") or ends_with(winlog.event_data.RelativeTargetName, ".rdp"))
