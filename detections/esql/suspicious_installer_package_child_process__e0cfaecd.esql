// Suspicious Installer Package Child Process | T1059, T1059.007, T1071, T1071.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_installer_susp_child_process.yml
from * metadata _id, _index, _version | where (ends_with(ParentImage, "/package_script_service") or ends_with(ParentImage, "/installer")) and (ends_with(Image, "/sh") or ends_with(Image, "/bash") or ends_with(Image, "/dash") or ends_with(Image, "/python") or ends_with(Image, "/ruby") or ends_with(Image, "/perl") or ends_with(Image, "/php") or ends_with(Image, "/javascript") or ends_with(Image, "/osascript") or ends_with(Image, "/tclsh") or ends_with(Image, "/curl") or ends_with(Image, "/wget")) and (CommandLine like "*preinstall*" or CommandLine like "*postinstall*")
