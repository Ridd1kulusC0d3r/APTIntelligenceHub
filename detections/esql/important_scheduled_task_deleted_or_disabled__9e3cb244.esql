// Important Scheduled Task Deleted or Disabled | T1489 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/taskscheduler/win_taskscheduler_susp_schtasks_delete_or_disable.yml
from * metadata _id, _index, _version | where winlog.channel=="Microsoft-Windows-TaskScheduler/Operational" and (event.code in ("141", "142")) and (winlog.event_data.TaskName like "*\\Windows\\SystemRestore\\SR*" or winlog.event_data.TaskName like "*\\Windows\\Windows Defender\\*" or winlog.event_data.TaskName like "*\\Windows\\BitLocker*" or winlog.event_data.TaskName like "*\\Windows\\WindowsBackup\\*" or winlog.event_data.TaskName like "*\\Windows\\WindowsUpdate\\*" or winlog.event_data.TaskName like "*\\Windows\\UpdateOrchestrator\\*" or winlog.event_data.TaskName like "*\\Windows\\ExploitGuard*") and not (winlog.event_data.UserName like "*AUTHORI*" or winlog.event_data.UserName like "*AUTORI*")
