// Operation Wocao Activity - Security | T1012, T1027, T1036.004, T1053.005, T1059.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/TA/Operation-Wocao/win_security_apt_wocao.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="4799" and starts_with(winlog.event_data.TargetUserName, "Administr") and ends_with(winlog.event_data.CallerProcessName, "\\checkadmin.exe")
