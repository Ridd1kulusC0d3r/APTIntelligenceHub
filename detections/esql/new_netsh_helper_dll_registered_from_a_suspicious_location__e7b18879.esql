// New Netsh Helper DLL Registered From A Suspicious Location | T1546.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_netsh_help_dll_persistence_susp_location.yml
from * metadata _id, _index, _version | where registry.path like "*\\SOFTWARE\\Microsoft\\NetSh*" and (winlog.event_data.Details like "*:\\Perflogs\\*" or winlog.event_data.Details like "*:\\Users\\Public\\*" or winlog.event_data.Details like "*:\\Windows\\Temp\\*" or winlog.event_data.Details like "*\\AppData\\Local\\Temp\\*" or winlog.event_data.Details like "*\\Temporary Internet*" or winlog.event_data.Details like "*:\\Users\\*" and winlog.event_data.Details like "*\\Favorites\\*" or winlog.event_data.Details like "*:\\Users\\*" and winlog.event_data.Details like "*\\Favourites\\*" or winlog.event_data.Details like "*:\\Users\\*" and winlog.event_data.Details like "*\\Contacts\\*" or winlog.event_data.Details like "*:\\Users\\*" and winlog.event_data.Details like "*\\Pictures\\*")
