// Remove Account From Domain Admin Group | T1531 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_susp_remove_adgroupmember.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*Remove-ADGroupMember*" and powershell.file.script_block_text like "*-Identity *" and powershell.file.script_block_text like "*-Members *"
