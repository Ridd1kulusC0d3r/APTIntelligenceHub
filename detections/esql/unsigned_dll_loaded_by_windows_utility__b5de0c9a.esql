// Unsigned DLL Loaded by Windows Utility | T1218.010, T1218.011 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/image_load/image_load_susp_unsigned_dll.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\InstallUtil.exe") or ends_with(process.executable.caseless, "\\RegAsm.exe") or ends_with(process.executable.caseless, "\\RegSvcs.exe") or ends_with(process.executable.caseless, "\\regsvr32.exe") or ends_with(process.executable.caseless, "\\rundll32.exe")) and not (file.code_signature.signed=="true" or file.code_signature.status in ("errorChaining", "errorCode_endpoint", "errorExpired", "trusted", "Valid") or file.code_signature.signed is null or file.code_signature.signed in ("", "-") or file.code_signature.status is null or file.code_signature.status in ("", "-") or (process.executable.caseless in ("C:\\Windows\\SysWOW64\\rundll32.exe", "C:\\Windows\\System32\\rundll32.exe")) and starts_with(file.path, "C:\\Windows\\Installer\\") and (ends_with(file.path, ".tmp-\\Microsoft.Deployment.WindowsInstaller.dll") or ends_with(file.path, ".tmp-\\Avira.OE.Setup.CustomActions.dll")) or (starts_with(process.executable.caseless, "C:\\Windows\\SysWOW64\\") or starts_with(process.executable.caseless, "C:\\Windows\\System32\\") or starts_with(process.executable.caseless, "C:\\Windows\\Microsoft.NET\\Framework64")) and ends_with(process.executable.caseless, "\\RegAsm.exe") and ends_with(file.path, ".dll") and starts_with(file.path, "C:\\Windows\\assembly\\NativeImages")) and not ((process.executable.caseless in ("C:\\Windows\\SysWOW64\\regsvr32.exe", "C:\\Windows\\System32\\regsvr32.exe")) and (starts_with(file.path, "C:\\Program Files (x86)\\K-Lite Codec Pack\\") or starts_with(file.path, "C:\\Program Files\\K-Lite Codec Pack\\")))
