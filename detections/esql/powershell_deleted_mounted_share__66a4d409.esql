// PowerShell Deleted Mounted Share | T1070.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_susp_mounted_share_deletion.yml
from * metadata _id, _index, _version | where (powershell.file.script_block_text like "*Remove-SmbShare*" or powershell.file.script_block_text like "*Remove-FileShare*") and not (powershell.file.script_block_text like "*FileShare.cdxml*" and powershell.file.script_block_text like "*Microsoft.PowerShell.Core\\Export-ModuleMember*" and powershell.file.script_block_text like "*ROOT/Microsoft/Windows/Storage/MSFT_FileShare*" and powershell.file.script_block_text like "*ObjectModelWrapper*" and powershell.file.script_block_text like "*Cmdletization.MethodParameter*")
