// PUA - Process Hacker Execution | T1543, T1564, T1622 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_pua_process_hacker.yml
from * metadata _id, _index, _version | where process.executable.caseless like "*\\ProcessHacker_*" or ends_with(process.executable.caseless, "\\ProcessHacker.exe") or process.pe.original_file_name in ("ProcessHacker.exe", "Process Hacker") or process.pe.description=="Process Hacker" or process.pe.product=="Process Hacker" or winlog.event_data.Hashes like "*MD5=68F9B52895F4D34E74112F3129B3B00D*" or winlog.event_data.Hashes like "*MD5=B365AF317AE730A67C936F21432B9C71*" or winlog.event_data.Hashes like "*SHA1=A0BDFAC3CE1880B32FF9B696458327CE352E3B1D*" or winlog.event_data.Hashes like "*SHA1=C5E2018BF7C0F314FED4FD7FE7E69FA2E648359E*" or winlog.event_data.Hashes like "*SHA256=D4A0FE56316A2C45B9BA9AC1005363309A3EDC7ACF9E4DF64D326A0FF273E80F*" or winlog.event_data.Hashes like "*SHA256=BD2C2CF0631D881ED382817AFCCE2B093F4E412FFB170A719E2762F250ABFEA4*" or winlog.event_data.Hashes like "*IMPHASH=3695333C60DEDECDCAFF1590409AA462*" or winlog.event_data.Hashes like "*IMPHASH=04DE0AD9C37EB7BD52043D2ECAC958DF*"
