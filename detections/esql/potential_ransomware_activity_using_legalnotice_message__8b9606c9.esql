// Potential Ransomware Activity Using LegalNotice Message | T1491.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_legalnotice_susp_message.yml
from * metadata _id, _index, _version | where (registry.path like "*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\LegalNoticeCaption*" or registry.path like "*\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\LegalNoticeText*") and (winlog.event_data.Details like "*encrypted*" or winlog.event_data.Details like "*Unlock-Password*" or winlog.event_data.Details like "*paying*")
