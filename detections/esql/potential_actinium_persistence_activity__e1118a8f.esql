// Potential ACTINIUM Persistence Activity | T1053, T1053.005 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2022/TA/ACTINIUM/proc_creation_win_apt_actinium_persistence.yml
from * metadata _id, _index, _version | where process.command_line like "*schtasks*" and process.command_line like "*create*" and process.command_line like "*wscript*" and process.command_line like "* /e:vbscript*"
