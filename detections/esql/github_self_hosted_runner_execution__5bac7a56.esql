// Github Self-Hosted Runner Execution | T1071, T1102.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_github_self_hosted_runner.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\Runner.Worker.exe") or process.pe.original_file_name=="Runner.Worker.dll") and process.command_line like "*spawnclient*" or (ends_with(process.executable.caseless, "\\Runner.Listener.exe") or process.pe.original_file_name=="Runner.Listener.dll") and (process.command_line like "*run*" or process.command_line like "*configure*")
