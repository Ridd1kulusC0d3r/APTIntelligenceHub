// System Information Discovery Using System_Profiler | T1082, T1497.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_system_profiler_discovery.yml
from * metadata _id, _index, _version | where (ends_with(Image, "/system_profiler") or CommandLine like "*system_profiler*") and (CommandLine like "*SPApplicationsDataType*" or CommandLine like "*SPHardwareDataType*" or CommandLine like "*SPNetworkDataType*" or CommandLine like "*SPUSBDataType*")
