// Suspicious LDAP-Attributes Used | T1001.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_susp_ldap_dataexchange.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="5136" and starts_with(winlog.event_data.AttributeValue, "") and (winlog.event_data.AttributeLDAPDisplayName in ("primaryInternationalISDNNumber", "otherFacsimileTelephoneNumber", "primaryTelexNumber"))
