// Suspicious SYSTEM User Process Creation | T1003, T1027, T1134 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_system_user_anomaly.yml
from * metadata _id, _index, _version | where (winlog.event_data.IntegrityLevel in ("System", "S-1-16-16384")) and (user.name like "*AUTHORI*" or user.name like "*AUTORI*") and (ends_with(process.executable.caseless, "\\calc.exe") or ends_with(process.executable.caseless, "\\cscript.exe") or ends_with(process.executable.caseless, "\\forfiles.exe") or ends_with(process.executable.caseless, "\\hh.exe") or ends_with(process.executable.caseless, "\\mshta.exe") or ends_with(process.executable.caseless, "\\ping.exe") or ends_with(process.executable.caseless, "\\wscript.exe") or process.command_line rlike "net\\s+user\\s+" or process.command_line like "* -NoP *" or process.command_line like "* -W Hidden *" or process.command_line like "* -decode *" or process.command_line like "* /decode *" or process.command_line like "* /urlcache *" or process.command_line like "* -urlcache *" or process.command_line like "* -e* JAB*" or process.command_line like "* -e* SUVYI*" or process.command_line like "* -e* SQBFAFgA*" or process.command_line like "* -e* aWV4I*" or process.command_line like "* -e* IAB*" or process.command_line like "* -e* PAA*" or process.command_line like "* -e* aQBlAHgA*" or process.command_line like "*vssadmin delete shadows*" or process.command_line like "*reg SAVE HKLM*" or process.command_line like "* -ma *" or process.command_line like "*Microsoft\\Windows\\CurrentVersion\\Run*" or process.command_line like "*.downloadstring(*" or process.command_line like "*.downloadfile(*" or process.command_line like "* /ticket:*" or process.command_line like "*dpapi::*" or process.command_line like "*event::clear*" or process.command_line like "*event::drop*" or process.command_line like "*id::modify*" or process.command_line like "*kerberos::*" or process.command_line like "*lsadump::*" or process.command_line like "*misc::*" or process.command_line like "*privilege::*" or process.command_line like "*rpc::*" or process.command_line like "*sekurlsa::*" or process.command_line like "*sid::*" or process.command_line like "*token::*" or process.command_line like "*vault::cred*" or process.command_line like "*vault::list*" or process.command_line like "* p::d *" or process.command_line like "*;iex(*" or process.command_line like "*MiniDump*") and not (process.command_line like "*ping*" and process.command_line like "*127.0.0.1*" and process.command_line like "* -n *" or ends_with(process.executable.caseless, "\\PING.EXE") and process.parent.command_line like "*\\DismFoDInstall.cmd*" or process.parent.executable.caseless like "*:\\Packages\\Plugins\\Microsoft.GuestConfiguration.ConfigurationforWindows\\*" or (process.parent.executable.caseless like "*:\\Program Files (x86)\\Java\\*" or process.parent.executable.caseless like "*:\\Program Files\\Java\\*") and ends_with(process.parent.executable.caseless, "\\bin\\javaws.exe") and (process.executable.caseless like "*:\\Program Files (x86)\\Java\\*" or process.executable.caseless like "*:\\Program Files\\Java\\*") and ends_with(process.executable.caseless, "\\bin\\jp2launcher.exe") and process.command_line like "* -ma *")
