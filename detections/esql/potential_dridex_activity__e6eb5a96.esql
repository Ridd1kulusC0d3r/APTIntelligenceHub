// Potential Dridex Activity | T1033, T1055, T1135 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/Malware/Dridex/proc_creation_win_malware_dridex.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\svchost.exe") and process.command_line like "*C:\\Users\\*" and process.command_line like "*\\Desktop\\*" and not starts_with(process.parent.executable.caseless, "C:\\Windows\\System32\\") or ends_with(process.parent.executable.caseless, "\\excel.exe") and ends_with(process.executable.caseless, "\\regsvr32.exe") and (process.command_line like "* -s *" or process.command_line like "*\\AppData\\Local\\Temp\\*") and not process.command_line like "*.dll*" or ends_with(process.parent.executable.caseless, "\\svchost.exe") and (ends_with(process.executable.caseless, "\\whoami.exe") and process.command_line like "* /all*" or (ends_with(process.executable.caseless, "\\net.exe") or ends_with(process.executable.caseless, "\\net1.exe")) and process.command_line like "* view*")
