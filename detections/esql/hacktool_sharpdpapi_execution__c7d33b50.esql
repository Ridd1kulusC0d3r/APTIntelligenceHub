// HackTool - SharpDPAPI Execution | T1134.001, T1134.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_sharp_dpapi_execution.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\SharpDPAPI.exe") or process.pe.original_file_name=="SharpDPAPI.exe" or (process.command_line like "* backupkey *" or process.command_line like "* blob *" or process.command_line like "* certificates *" or process.command_line like "* credentials *" or process.command_line like "* keepass *" or process.command_line like "* masterkeys *" or process.command_line like "* rdg *" or process.command_line like "* vaults *") and (process.command_line like "* {*" and process.command_line like "*}:*" or process.command_line like "* /file:*" or process.command_line like "* /machine*" or process.command_line like "* /mkfile:*" or process.command_line like "* /password:*" or process.command_line like "* /pvk:*" or process.command_line like "* /server:*" or process.command_line like "* /target:*" or process.command_line like "* /unprotect*")
