// Windows Network Access Suspicious desktop.ini Action | T1547.009 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_net_share_obj_susp_desktop_ini.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="5145" and winlog.event_data.ObjectType=="File" and ends_with(winlog.event_data.RelativeTargetName, "\\desktop.ini") and (winlog.event_data.AccessList like "*WriteData*" or winlog.event_data.AccessList like "*DELETE*" or winlog.event_data.AccessList like "*WriteDAC*" or winlog.event_data.AccessList like "*AppendData*" or winlog.event_data.AccessList like "*AddSubdirectory*")
