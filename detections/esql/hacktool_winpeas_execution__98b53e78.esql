// HackTool - winPEAS Execution | T1046, T1082, T1087 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_winpeas.yml
from * metadata _id, _index, _version | where process.pe.original_file_name=="winPEAS.exe" or ends_with(process.executable.caseless, "\\winPEASany_ofs.exe") or ends_with(process.executable.caseless, "\\winPEASany.exe") or ends_with(process.executable.caseless, "\\winPEASx64_ofs.exe") or ends_with(process.executable.caseless, "\\winPEASx64.exe") or ends_with(process.executable.caseless, "\\winPEASx86_ofs.exe") or ends_with(process.executable.caseless, "\\winPEASx86.exe") or process.command_line like "* applicationsinfo*" or process.command_line like "* browserinfo*" or process.command_line like "* eventsinfo*" or process.command_line like "* fileanalysis*" or process.command_line like "* filesinfo*" or process.command_line like "* processinfo*" or process.command_line like "* servicesinfo*" or process.command_line like "* windowscreds*" or process.command_line like "*https://github.com/carlospolop/PEASS-ng/releases/latest/download/*" or ends_with(process.parent.command_line, " -linpeas") or ends_with(process.command_line, " -linpeas")
