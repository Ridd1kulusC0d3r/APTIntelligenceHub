// User Added to Local Administrator Group | T1078, T1098 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_user_added_to_local_administrators.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="4732" and (starts_with(winlog.event_data.TargetUserName, "Administr") or winlog.event_data.TargetSid=="S-1-5-32-544") and not ends_with(user.name, "$")
