// Sofacy Trojan Loader Activity | T1059.003, T1218.011 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2018/TA/APT28/proc_creation_win_apt_sofacy.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\rundll32.exe") and (process.command_line like "*%LOCALAPPDATA%*" or process.command_line like "*\\AppData\\Local\\*") and (process.command_line like "*.dat\",*" or ends_with(process.command_line, ".dll #1") or ends_with(process.command_line, ".dll\" #1") or ends_with(process.command_line, ".dll\",#1")) and not process.command_line like "*\\AppData\\Local\\Temp\\*"
