// Potential Persistence Via Outlook LoadMacroProviderOnBoot Setting | T1008, T1137, T1546 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_office_outlook_enable_load_macro_provider_on_boot.yml
from * metadata _id, _index, _version | where ends_with(registry.path, "\\Outlook\\LoadMacroProviderOnBoot") and winlog.event_data.Details like "*0x00000001*"
