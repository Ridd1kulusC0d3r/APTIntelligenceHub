// Suspicious Child Process of Notepad++ Updater - GUP.Exe | T1195.002, T1557 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_gup_susp_child_process.yml
from * metadata _id, _index, _version | where ends_with(process.parent.executable.caseless, "\\gup.exe") and (ends_with(process.executable.caseless, "\\cmd.exe") or ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\pwsh.exe") or ends_with(process.executable.caseless, "\\cscript.exe") or ends_with(process.executable.caseless, "\\wscript.exe") or ends_with(process.executable.caseless, "\\mshta.exe") or process.command_line like "*bitsadmin*" or process.command_line like "*certutil*" or process.command_line like "*curl*" or process.command_line like "*finger*" or process.command_line like "*forfiles*" or process.command_line like "*regsvr32*" or process.command_line like "*rundll32*" or process.command_line like "*wget*")
