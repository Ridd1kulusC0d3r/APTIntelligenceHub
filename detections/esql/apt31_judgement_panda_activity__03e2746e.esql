// APT31 Judgement Panda Activity | T1003.001, T1560.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/TA/APT31/proc_creation_win_apt_apt31_judgement_panda.yml
from * metadata _id, _index, _version | where process.command_line like "*ldifde*" and process.command_line like "*-f -n*" and process.command_line like "*eprod.ldf*" or process.command_line like "*copy \\\\*" and process.command_line like "*c$*" and (process.command_line like "*\\aaaa\\procdump64.exe*" or process.command_line like "*\\aaaa\\netsess.exe*" or process.command_line like "*\\aaaa\\7za.exe*" or process.command_line like "*\\c$\\aaaa\\*")
