// Potential WinAPI Calls Via CommandLine | T1106 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_inline_win_api_access.yml
from * metadata _id, _index, _version | where (process.command_line like "*AddSecurityPackage*" or process.command_line like "*AdjustTokenPrivileges*" or process.command_line like "*Advapi32*" or process.command_line like "*CloseHandle*" or process.command_line like "*CreateProcessWithToken*" or process.command_line like "*CreatePseudoConsole*" or process.command_line like "*CreateRemoteThread*" or process.command_line like "*CreateThread*" or process.command_line like "*CreateUserThread*" or process.command_line like "*DangerousGetHandle*" or process.command_line like "*DuplicateTokenEx*" or process.command_line like "*EnumerateSecurityPackages*" or process.command_line like "*FreeHGlobal*" or process.command_line like "*FreeLibrary*" or process.command_line like "*GetDelegateForFunctionPointer*" or process.command_line like "*GetLogonSessionData*" or process.command_line like "*GetModuleHandle*" or process.command_line like "*GetProcAddress*" or process.command_line like "*GetProcessHandle*" or process.command_line like "*GetTokenInformation*" or process.command_line like "*ImpersonateLoggedOnUser*" or process.command_line like "*kernel32*" or process.command_line like "*LoadLibrary*" or process.command_line like "*memcpy*" or process.command_line like "*MiniDumpWriteDump*" or process.command_line like "*ntdll*" or process.command_line like "*OpenDesktop*" or process.command_line like "*OpenProcess*" or process.command_line like "*OpenProcessToken*" or process.command_line like "*OpenThreadToken*" or process.command_line like "*OpenWindowStation*" or process.command_line like "*PtrToString*" or process.command_line like "*QueueUserApc*" or process.command_line like "*ReadProcessMemory*" or process.command_line like "*RevertToSelf*" or process.command_line like "*RtlCreateUserThread*" or process.command_line like "*secur32*" or process.command_line like "*SetThreadToken*" or process.command_line like "*VirtualAlloc*" or process.command_line like "*VirtualFree*" or process.command_line like "*VirtualProtect*" or process.command_line like "*WaitForSingleObject*" or process.command_line like "*WriteInt32*" or process.command_line like "*WriteProcessMemory*" or process.command_line like "*ZeroFreeGlobalAllocUnicode*") and not (ends_with(process.executable.caseless, "\\MpCmdRun.exe") and process.command_line like "*GetLoadLibraryWAddress32*" or ends_with(process.parent.executable.caseless, "\\CompatTelRunner.exe") and (process.command_line like "*FreeHGlobal*" or process.command_line like "*PtrToString*" or process.command_line like "*kernel32*" or process.command_line like "*CloseHandle*"))
