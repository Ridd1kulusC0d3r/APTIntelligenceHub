// DNS TOR Proxies | T1048 | https://github.com/SigmaHQ/sigma/blob/master/rules/network/zeek/zeek_dns_torproxy.yml
from * metadata _id, _index, _version | where ends_with(query, ".hiddenservice.net") or ends_with(query, ".onion.ca") or ends_with(query, ".onion.cab") or ends_with(query, ".onion.casa") or ends_with(query, ".onion.city") or ends_with(query, ".onion.direct") or ends_with(query, ".onion.dog") or ends_with(query, ".onion.glass") or ends_with(query, ".onion.gq") or ends_with(query, ".onion.guide") or ends_with(query, ".onion.in.net") or ends_with(query, ".onion.ink") or ends_with(query, ".onion.it") or ends_with(query, ".onion.link") or ends_with(query, ".onion.lt") or ends_with(query, ".onion.lu") or ends_with(query, ".onion.ly") or ends_with(query, ".onion.mn") or ends_with(query, ".onion.network") or ends_with(query, ".onion.nu") or ends_with(query, ".onion.pet") or ends_with(query, ".onion.plus") or ends_with(query, ".onion.pt") or ends_with(query, ".onion.pw") or ends_with(query, ".onion.rip") or ends_with(query, ".onion.sh") or ends_with(query, ".onion.si") or ends_with(query, ".onion.to") or ends_with(query, ".onion.top") or ends_with(query, ".onion.ws") or ends_with(query, ".onion") or ends_with(query, ".s1.tor-gateways.de") or ends_with(query, ".s2.tor-gateways.de") or ends_with(query, ".s3.tor-gateways.de") or ends_with(query, ".s4.tor-gateways.de") or ends_with(query, ".s5.tor-gateways.de") or ends_with(query, ".t2w.pw") or ends_with(query, ".tor2web.ae.org") or ends_with(query, ".tor2web.blutmagie.de") or ends_with(query, ".tor2web.com") or ends_with(query, ".tor2web.fi") or ends_with(query, ".tor2web.io") or ends_with(query, ".tor2web.org") or ends_with(query, ".tor2web.xyz") or ends_with(query, ".torlink.co")
