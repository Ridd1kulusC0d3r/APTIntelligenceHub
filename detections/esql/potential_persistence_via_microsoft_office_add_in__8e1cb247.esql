// Potential Persistence Via Microsoft Office Add-In | T1137.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_office_addin_persistence.yml
from * metadata _id, _index, _version | where file.path like "*\\Microsoft\\Word\\Startup\\*" and ends_with(file.path, ".wll") or file.path like "*\\Microsoft\\Excel\\Startup\\*" and ends_with(file.path, ".xll") or file.path like "*Microsoft\\Excel\\XLSTART\\*" and ends_with(file.path, ".xlam") or file.path like "*\\Microsoft\\Addins\\*" and (ends_with(file.path, ".xlam") or ends_with(file.path, ".xla") or ends_with(file.path, ".ppam"))
