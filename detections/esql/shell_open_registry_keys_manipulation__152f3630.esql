// Shell Open Registry Keys Manipulation | T1546.001, T1548.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_shell_open_keys_manipulation.yml
from * metadata _id, _index, _version | where (winlog.event_data.EventType=="SetValue" and ends_with(registry.path, "Classes\\ms-settings\\shell\\open\\command\\SymbolicLinkValue") and winlog.event_data.Details like "*\\Software\\Classes\\{*" or ends_with(registry.path, "Classes\\ms-settings\\shell\\open\\command\\DelegateExecute") or winlog.event_data.EventType=="SetValue" and (ends_with(registry.path, "Classes\\ms-settings\\shell\\open\\command\\(Default)") or ends_with(registry.path, "Classes\\exefile\\shell\\open\\command\\(Default)"))) and not (winlog.event_data.Details=="(Empty)" or winlog.event_data.Details in ("{4813071a-41ad-44a2-9835-886d2f63ca30}", "{A56A841F-E974-45C1-8001-7E3F8A085917}", "{4ED3A719-CEA8-4BD9-910D-E252F997AFC2}", "{BFEC0C93-0B7D-4F2C-B09C-AFFFC4BDAE78}"))
