// Potential Base64 Decoded From Images | T1140 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_tail_base64_decode_from_image.yml
from * metadata _id, _index, _version | where ends_with(Image, "/bash") and CommandLine like "*tail*" and CommandLine like "*-c*" and CommandLine like "*base64*" and CommandLine like "*-d*" and CommandLine like "*>*" and (CommandLine like "*.avif*" or CommandLine like "*.gif*" or CommandLine like "*.jfif*" or CommandLine like "*.jpeg*" or CommandLine like "*.jpg*" or CommandLine like "*.pjp*" or CommandLine like "*.pjpeg*" or CommandLine like "*.png*" or CommandLine like "*.svg*" or CommandLine like "*.webp*")
