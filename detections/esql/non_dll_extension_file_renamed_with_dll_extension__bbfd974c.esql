// Non-DLL Extension File Renamed With DLL Extension | T1036.008 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/file/file_rename/file_rename_win_non_dll_to_dll_ext.yml
from * metadata _id, _index, _version | where ends_with(file.path, ".dll") and not (ends_with(winlog.event_data.SourceFilename, ".dll") or ends_with(winlog.event_data.SourceFilename, ".tmp") or winlog.event_data.SourceFilename=="" or winlog.event_data.SourceFilename is null or process.executable.caseless like "*:\\Windows\\WinSxS\\*" and ends_with(process.executable.caseless, "\\TiWorker.exe") or ends_with(process.executable.caseless, ":\\Windows\\System32\\wuauclt.exe") or file.path like "*:\\$WINDOWS.~BT\\Sources\\*" or process.executable.caseless like "*:\\Program Files (x86)\\*" or process.executable.caseless like "*:\\Program Files\\*") and not winlog.event_data.SourceFilename like "*\\SquirrelTemp\\temp*"
