// HackTool - Hashcat Password Cracker Execution | T1110.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_hashcat.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\hashcat.exe") or process.command_line like "*-a *" and process.command_line like "*-m 1000 *" and process.command_line like "*-r *"
