// Cred Dump Tools Dropped Files | T1003.001, T1003.002, T1003.003, T1003.004, T1003.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_cred_dump_tools_dropped_files.yml
from * metadata _id, _index, _version | where file.path like "*\\fgdump-log*" or file.path like "*\\kirbi*" or file.path like "*\\pwdump*" or file.path like "*\\pwhashes*" or file.path like "*\\wce_ccache*" or file.path like "*\\wce_krbtkts*" or ends_with(file.path, "\\cachedump.exe") or ends_with(file.path, "\\cachedump64.exe") or ends_with(file.path, "\\DumpExt.dll") or ends_with(file.path, "\\DumpSvc.exe") or ends_with(file.path, "\\Dumpy.exe") or ends_with(file.path, "\\fgexec.exe") or ends_with(file.path, "\\lsremora.dll") or ends_with(file.path, "\\lsremora64.dll") or ends_with(file.path, "\\NTDS.out") or ends_with(file.path, "\\procdump.exe") or ends_with(file.path, "\\procdump64.exe") or ends_with(file.path, "\\procdump64a.exe") or ends_with(file.path, "\\pstgdump.exe") or ends_with(file.path, "\\pwdump.exe") or ends_with(file.path, "\\SAM.out") or ends_with(file.path, "\\SECURITY.out") or ends_with(file.path, "\\servpw.exe") or ends_with(file.path, "\\servpw64.exe") or ends_with(file.path, "\\SYSTEM.out") or ends_with(file.path, "\\test.pwd") or ends_with(file.path, "\\wceaux.dll")
