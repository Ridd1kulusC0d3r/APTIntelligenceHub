// PowerShell Set-Acl On Windows Folder - PsScript | T1222 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_set_acl_susp_location.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*Set-Acl *" and powershell.file.script_block_text like "*-AclObject *" and (powershell.file.script_block_text like "*-Path \"C:\\Windows*" or powershell.file.script_block_text like "*-Path \"C:/Windows*" or powershell.file.script_block_text like "*-Path 'C:\\Windows*" or powershell.file.script_block_text like "*-Path 'C:/Windows*" or powershell.file.script_block_text like "*-Path C:\\Windows*" or powershell.file.script_block_text like "*-Path C:/Windows*" or powershell.file.script_block_text like "*-Path $env:windir*" or powershell.file.script_block_text like "*-Path \"$env:windir*" or powershell.file.script_block_text like "*-Path '$env:windir*") and (powershell.file.script_block_text like "*FullControl*" or powershell.file.script_block_text like "*Allow*")
