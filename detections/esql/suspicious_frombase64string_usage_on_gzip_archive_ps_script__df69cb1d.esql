// Suspicious FromBase64String Usage On Gzip Archive - Ps Script | T1132.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_frombase64string_archive.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*FromBase64String*" and powershell.file.script_block_text like "*MemoryStream*" and powershell.file.script_block_text like "*H4sI*"
