// Windows Defender Threat Detection Service Disabled | T1685 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/service_control_manager/win_system_defender_disabled.yml
from * metadata _id, _index, _version | where winlog.channel=="System" and event.code=="7036" and winlog.provider_name=="Service Control Manager" and (winlog.event_data.param1 in ("Windows Defender Antivirus Service", "Service antivirus Microsoft Defender")) and (winlog.event_data.param2 in ("stopped", "arrêté"))
