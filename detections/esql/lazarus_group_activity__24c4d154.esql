// Lazarus Group Activity | T1059 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2020/TA/Lazarus/proc_creation_win_apt_lazarus_group_activity.yml
from * metadata _id, _index, _version | where process.command_line like "*reg.exe save hklm\\sam %temp%\\~reg_sam.save*" or process.command_line like "*1q2w3e4r@#$@#$@#$*" or process.command_line like "* -hp1q2w3e4 *" or process.command_line like "*.dat data03 10000 -p *" or process.command_line like "*netstat -aon | find *" and process.command_line like "*ESTA*" and process.command_line like "* > %temp%\\~*" or process.command_line like "*.255 10 C:\\ProgramData\\IBM\\*" and process.command_line like "*.DAT*" or process.command_line like "* /c *" and process.command_line like "* -p 0x*" and (process.command_line like "*C:\\ProgramData\\*" or process.command_line like "*C:\\RECYCLER\\*") or process.command_line like "*rundll32 *" and process.command_line like "*C:\\ProgramData\\*" and (process.command_line like "*.bin,*" or process.command_line like "*.tmp,*" or process.command_line like "*.dat,*" or process.command_line like "*.io,*" or process.command_line like "*.ini,*" or process.command_line like "*.db,*")
