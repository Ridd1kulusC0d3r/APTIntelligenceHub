// Chromium Browser Instance Executed With Custom Extension | T1176.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_browsers_chromium_load_extension.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\brave.exe") or ends_with(process.executable.caseless, "\\chrome.exe") or ends_with(process.executable.caseless, "\\msedge.exe") or ends_with(process.executable.caseless, "\\opera.exe") or ends_with(process.executable.caseless, "\\vivaldi.exe")) and process.command_line like "*--load-extension=*"
