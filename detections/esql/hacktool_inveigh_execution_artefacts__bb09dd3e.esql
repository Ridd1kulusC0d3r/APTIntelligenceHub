// HackTool - Inveigh Execution Artefacts | T1219.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_hktl_inveigh_artefacts.yml
from * metadata _id, _index, _version | where ends_with(file.path, "\\Inveigh-Log.txt") or ends_with(file.path, "\\Inveigh-Cleartext.txt") or ends_with(file.path, "\\Inveigh-NTLMv1Users.txt") or ends_with(file.path, "\\Inveigh-NTLMv2Users.txt") or ends_with(file.path, "\\Inveigh-NTLMv1.txt") or ends_with(file.path, "\\Inveigh-NTLMv2.txt") or ends_with(file.path, "\\Inveigh-FormInput.txt") or ends_with(file.path, "\\Inveigh.dll") or ends_with(file.path, "\\Inveigh.exe") or ends_with(file.path, "\\Inveigh.ps1") or ends_with(file.path, "\\Inveigh-Relay.ps1")
