// CMSTP UAC Bypass via COM Object Access | T1218.003, T1548.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_uac_bypass_cmstp_com_object_access.yml
from * metadata _id, _index, _version | where ends_with(process.parent.executable.caseless, "\\DllHost.exe") and (process.parent.command_line like "* /Processid:{3E5FC7F9-9A51-4367-9063-A120244FBEC7}*" or process.parent.command_line like "* /Processid:{3E000D72-A845-4CD9-BD83-80C07C3B881F}*" or process.parent.command_line like "* /Processid:{BD54C901-076B-434E-B6C7-17C531F4AB41}*" or process.parent.command_line like "* /Processid:{D2E7041B-2927-42FB-8E9F-7CE93B6DC937}*" or process.parent.command_line like "* /Processid:{E9495B87-D950-4AB5-87A5-FF6D70BF3E90}*") and (winlog.event_data.IntegrityLevel in ("High", "System", "S-1-16-16384", "S-1-16-12288"))
