// HackTool - Rubeus Execution - ScriptBlock | T1003, T1550.003, T1558.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_hktl_rubeus.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*asreproast *" or powershell.file.script_block_text like "*dump /service:krbtgt *" or powershell.file.script_block_text like "*dump /luid:0x*" or powershell.file.script_block_text like "*kerberoast *" or powershell.file.script_block_text like "*createnetonly /program:*" or powershell.file.script_block_text like "*ptt /ticket:*" or powershell.file.script_block_text like "*/impersonateuser:*" or powershell.file.script_block_text like "*renew /ticket:*" or powershell.file.script_block_text like "*asktgt /user:*" or powershell.file.script_block_text like "*harvest /interval:*" or powershell.file.script_block_text like "*s4u /user:*" or powershell.file.script_block_text like "*s4u /ticket:*" or powershell.file.script_block_text like "*hash /password:*" or powershell.file.script_block_text like "*golden /aes256:*" or powershell.file.script_block_text like "*silver /user:*"
