// Meterpreter or Cobalt Strike Getsystem Service Installation - System | T1134.001, T1134.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/service_control_manager/win_system_meterpreter_or_cobaltstrike_getsystem_service_installation.yml
from * metadata _id, _index, _version | where winlog.channel=="System" and winlog.provider_name=="Service Control Manager" and event.code=="7045" and (winlog.event_data.ImagePath like "*/c*" and winlog.event_data.ImagePath like "*echo*" and winlog.event_data.ImagePath like "*\\pipe\\*" and (winlog.event_data.ImagePath like "*cmd*" or winlog.event_data.ImagePath like "*%COMSPEC%*") or winlog.event_data.ImagePath like "*rundll32*" and winlog.event_data.ImagePath like "*.dll,a*" and winlog.event_data.ImagePath like "*/p:*" or starts_with(winlog.event_data.ImagePath, "\\\\127.0.0.1\\ADMIN$\\"))
