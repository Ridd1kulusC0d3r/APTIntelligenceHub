// Suspicious Child Process Of Manage Engine ServiceDesk | T1102 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_java_manageengine_susp_child_process.yml
from * metadata _id, _index, _version | where process.parent.executable.caseless like "*\\ManageEngine\\ServiceDesk\\*" and process.parent.executable.caseless like "*\\java.exe*" and (ends_with(process.executable.caseless, "\\AppVLP.exe") or ends_with(process.executable.caseless, "\\bash.exe") or ends_with(process.executable.caseless, "\\bitsadmin.exe") or ends_with(process.executable.caseless, "\\calc.exe") or ends_with(process.executable.caseless, "\\certutil.exe") or ends_with(process.executable.caseless, "\\cscript.exe") or ends_with(process.executable.caseless, "\\curl.exe") or ends_with(process.executable.caseless, "\\forfiles.exe") or ends_with(process.executable.caseless, "\\mftrace.exe") or ends_with(process.executable.caseless, "\\mshta.exe") or ends_with(process.executable.caseless, "\\net.exe") or ends_with(process.executable.caseless, "\\net1.exe") or ends_with(process.executable.caseless, "\\notepad.exe") or ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\pwsh.exe") or ends_with(process.executable.caseless, "\\query.exe") or ends_with(process.executable.caseless, "\\reg.exe") or ends_with(process.executable.caseless, "\\schtasks.exe") or ends_with(process.executable.caseless, "\\scrcons.exe") or ends_with(process.executable.caseless, "\\sh.exe") or ends_with(process.executable.caseless, "\\systeminfo.exe") or ends_with(process.executable.caseless, "\\whoami.exe") or ends_with(process.executable.caseless, "\\wmic.exe") or ends_with(process.executable.caseless, "\\wscript.exe")) and not ((ends_with(process.executable.caseless, "\\net.exe") or ends_with(process.executable.caseless, "\\net1.exe")) and process.command_line like "* stop*")
