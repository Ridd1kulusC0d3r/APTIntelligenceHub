// UEFI Persistence Via Wpbbin - ProcessCreation | T1542.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_wpbbin_potential_persistence.yml
from * metadata _id, _index, _version | where process.executable.caseless=="C:\\Windows\\System32\\wpbbin.exe"
