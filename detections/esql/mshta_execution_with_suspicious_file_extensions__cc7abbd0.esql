// MSHTA Execution with Suspicious File Extensions | T1059.007, T1140, T1218.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_mshta_susp_execution.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\mshta.exe") or process.pe.original_file_name=="mshta.exe") and (process.command_line like "*.7z*" or process.command_line like "*.avi*" or process.command_line like "*.bat*" or process.command_line like "*.bmp*" or process.command_line like "*.conf*" or process.command_line like "*.csv*" or process.command_line like "*.dll*" or process.command_line like "*.doc*" or process.command_line like "*.gif*" or process.command_line like "*.gz*" or process.command_line like "*.ini*" or process.command_line like "*.jpe*" or process.command_line like "*.jpg*" or process.command_line like "*.json*" or process.command_line like "*.lnk*" or process.command_line like "*.log*" or process.command_line like "*.mkv*" or process.command_line like "*.mp3*" or process.command_line like "*.mp4*" or process.command_line like "*.pdf*" or process.command_line like "*.png*" or process.command_line like "*.ppt*" or process.command_line like "*.rar*" or process.command_line like "*.rtf*" or process.command_line like "*.svg*" or process.command_line like "*.tar*" or process.command_line like "*.tmp*" or process.command_line like "*.txt*" or process.command_line like "*.xls*" or process.command_line like "*.xml*" or process.command_line like "*.yaml*" or process.command_line like "*.yml*" or process.command_line like "*.zip*" or process.command_line like "*vbscript*")
