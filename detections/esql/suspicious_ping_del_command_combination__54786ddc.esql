// Suspicious Ping/Del Command Combination | T1070.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_cmd_ping_del_combined_execution.yml
from * metadata _id, _index, _version | where (process.command_line like "* -n *" or process.command_line like "* /n *" or process.command_line like "* –n *" or process.command_line like "* —n *" or process.command_line like "* ―n *") and process.command_line like "*Nul*" and (process.command_line like "* -f *" or process.command_line like "* /f *" or process.command_line like "* –f *" or process.command_line like "* —f *" or process.command_line like "* ―f *" or process.command_line like "* -q *" or process.command_line like "* /q *" or process.command_line like "* –q *" or process.command_line like "* —q *" or process.command_line like "* ―q *") and process.command_line like "*ping*" and process.command_line like "*del *"
