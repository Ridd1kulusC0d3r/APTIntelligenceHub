// Suspicious LNK Double Extension File Created | T1036.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_lnk_double_extension.yml
from * metadata _id, _index, _version | where ends_with(file.path, ".lnk") and (file.path like "*.doc.*" or file.path like "*.docx.*" or file.path like "*.jpg.*" or file.path like "*.pdf.*" or file.path like "*.ppt.*" or file.path like "*.pptx.*" or file.path like "*.xls.*" or file.path like "*.xlsx.*") and not file.path like "*\\AppData\\Roaming\\Microsoft\\Windows\\Recent\\*" and not ((ends_with(process.executable.caseless, "\\excel.exe") or ends_with(process.executable.caseless, "\\powerpnt.exe") or ends_with(process.executable.caseless, "\\winword.exe")) and file.path like "*\\AppData\\Roaming\\Microsoft\\Office\\Recent\\*" or ends_with(process.executable.caseless, "\\excel.exe") and file.path like "*\\AppData\\Roaming\\Microsoft\\Excel*" or ends_with(process.executable.caseless, "\\powerpnt.exe") and file.path like "*\\AppData\\Roaming\\Microsoft\\PowerPoint*" or ends_with(process.executable.caseless, "\\winword.exe") and file.path like "*\\AppData\\Roaming\\Microsoft\\Word*")
