// Suspicious SSL Connection | T1573 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_susp_ssl_keyword.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*System.Net.Security.SslStream*" and powershell.file.script_block_text like "*Net.Security.RemoteCertificateValidationCallback*" and powershell.file.script_block_text like "*.AuthenticateAsClient*"
