// Suspicious File Characteristics Due to Missing Fields | T1059.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_file_characteristics.yml
from * metadata _id, _index, _version | where (process.pe.description=="\?" and process.pe.file_version=="\?" or process.pe.description=="\?" and process.pe.product=="\?" or process.pe.description=="\?" and process.pe.company=="\?") and process.executable.caseless like "*\\Downloads\\*"
