// Network Connection Initiated To DevTunnels Domain | T1567.001, T1572 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_domain_devtunnels.yml
from * metadata _id, _index, _version | where network.direction=="true" and ends_with(destination.domain, ".devtunnels.ms")
