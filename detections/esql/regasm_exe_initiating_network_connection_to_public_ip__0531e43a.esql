// RegAsm.EXE Initiating Network Connection To Public IP | T1218.009 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/network_connection/net_connection_win_regasm_network_activity.yml
from * metadata _id, _index, _version | where network.direction=="true" and ends_with(process.executable.caseless, "\\regasm.exe") and not (cidr_match(destination.ip, "127.0.0.0/8") or cidr_match(destination.ip, "10.0.0.0/8") or cidr_match(destination.ip, "172.16.0.0/12") or cidr_match(destination.ip, "192.168.0.0/16") or cidr_match(destination.ip, "169.254.0.0/16") or cidr_match(destination.ip, "::1/128") or cidr_match(destination.ip, "fe80::/10") or cidr_match(destination.ip, "fc00::/7"))
