// Enumeration for 3rd Party Creds From CLI | T1552.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_registry_enumeration_for_credentials_cli.yml
from * metadata _id, _index, _version | where (process.command_line like "*\\Software\\Aerofox\\Foxmail\\V3.1*" or process.command_line like "*\\Software\\Aerofox\\FoxmailPreview*" or process.command_line like "*\\Software\\DownloadManager\\Passwords*" or process.command_line like "*\\Software\\FTPWare\\COREFTP\\Sites*" or process.command_line like "*\\Software\\IncrediMail\\Identities*" or process.command_line like "*\\Software\\Martin Prikryl\\WinSCP 2\\Sessions*" or process.command_line like "*\\Software\\Mobatek\\MobaXterm\\*" or process.command_line like "*\\Software\\OpenSSH\\Agent\\Keys*" or process.command_line like "*\\Software\\OpenVPN-GUI\\configs*" or process.command_line like "*\\Software\\ORL\\WinVNC3\\Password*" or process.command_line like "*\\Software\\Qualcomm\\Eudora\\CommandLine*" or process.command_line like "*\\Software\\RealVNC\\WinVNC4*" or process.command_line like "*\\Software\\RimArts\\B2\\Settings*" or process.command_line like "*\\Software\\SimonTatham\\PuTTY\\Sessions*" or process.command_line like "*\\Software\\SimonTatham\\PuTTY\\SshHostKeys\\*" or process.command_line like "*\\Software\\Sota\\FFFTP*" or process.command_line like "*\\Software\\TightVNC\\Server*" or process.command_line like "*\\Software\\WOW6432Node\\Radmin\\v3.0\\Server\\Parameters\\Radmin*") and not (ends_with(process.executable.caseless, "reg.exe") and (process.command_line like "*export*" or process.command_line like "*save*"))
