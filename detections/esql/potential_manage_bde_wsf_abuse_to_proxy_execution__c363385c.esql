// Potential Manage-bde.wsf Abuse To Proxy Execution | T1216 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_lolbin_manage_bde.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\wscript.exe") or process.pe.original_file_name=="wscript.exe") and process.command_line like "*manage-bde.wsf*" or (ends_with(process.parent.executable.caseless, "\\cscript.exe") or ends_with(process.parent.executable.caseless, "\\wscript.exe")) and process.parent.command_line like "*manage-bde.wsf*" and not ends_with(process.executable.caseless, "\\cmd.exe")
