// AD Object WriteDAC Access | T1222.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_ad_object_writedac_access.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="4662" and winlog.event_data.ObjectServer=="DS" and winlog.event_data.AccessMask=="0x40000" and (winlog.event_data.ObjectType in ("19195a5b-6da0-11d0-afd3-00c04fd930c9", "domainDNS"))
