// Potential Russian APT Credential Theft Activity | T1003.003, T1552.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2019/TA/Bear-APT-Activity/proc_creation_win_apt_bear_activity_gtr19.yml
from * metadata _id, _index, _version | where process.command_line like "*xcopy /S /E /C /Q /H \\\\*" and process.command_line like "*\\sysvol\\*" or process.command_line like "*adexplorer -snapshot \"\" c:\\users\\*" and process.command_line like "*\\downloads\\*" and process.command_line like "*.snp*"
