// Indicator Removal on Host - Clear Mac System Logs | T1685.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_clear_system_logs.yml
from * metadata _id, _index, _version | where (ends_with(Image, "/rm") or ends_with(Image, "/unlink") or ends_with(Image, "/shred")) and (CommandLine like "*/var/log*" or CommandLine like "*/Users/*" and CommandLine like "*/Library/Logs/*")
