// HackTool - Covenant PowerShell Launcher | T1059.001, T1564.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_covenant.yml
from * metadata _id, _index, _version | where process.command_line like "*-Sta*" and process.command_line like "*-Nop*" and process.command_line like "*-Window*" and process.command_line like "*Hidden*" and (process.command_line like "*-Command*" or process.command_line like "*-EncodedCommand*") or process.command_line like "*sv o (New-Object IO.MemorySteam);sv d *" or process.command_line like "*mshta file.hta*" or process.command_line like "*GruntHTTP*" or process.command_line like "*-EncodedCommand cwB2ACAAbwAgA*"
