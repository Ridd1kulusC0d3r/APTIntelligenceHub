// Exchange PowerShell Snap-Ins Usage | T1059.001, T1114 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_snapins_hafnium.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\pwsh.exe") or process.pe.original_file_name in ("PowerShell.EXE", "pwsh.dll")) and process.command_line like "*Add-PSSnapin*" and (process.command_line like "*Microsoft.Exchange.Powershell.Snapin*" or process.command_line like "*Microsoft.Exchange.Management.PowerShell.SnapIn*") and not (process.parent.executable.caseless=="C:\\Windows\\System32\\msiexec.exe" and process.command_line like "*$exserver=Get-ExchangeServer ([Environment]::MachineName) -ErrorVariable exerr 2> $null*")
