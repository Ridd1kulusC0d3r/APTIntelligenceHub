// Replace Desktop Wallpaper by Powershell | T1491.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_susp_wallpaper.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*Get-ItemProperty*" and powershell.file.script_block_text like "*Registry::*" and powershell.file.script_block_text like "*HKEY_CURRENT_USER\\Control Panel\\Desktop\\*" and powershell.file.script_block_text like "*WallPaper*" or powershell.file.script_block_text like "*SystemParametersInfo(20,0,*,3)*"
