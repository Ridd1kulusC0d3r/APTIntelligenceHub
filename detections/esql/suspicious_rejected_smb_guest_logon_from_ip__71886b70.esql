// Suspicious Rejected SMB Guest Logon From IP | T1110.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/smbclient/security/win_smbclient_security_susp_failed_guest_logon.yml
from * metadata _id, _index, _version | where winlog.channel=="Microsoft-Windows-SmbClient/Security" and event.code=="31017" and winlog.event_data.UserName=="" and starts_with(winlog.event_data.ServerName, "\\1")
