// Suspicious Child Process Of BgInfo.EXE | T1059.005, T1202, T1218 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_bginfo_suspicious_child_process.yml
from * metadata _id, _index, _version | where (ends_with(process.parent.executable.caseless, "\\bginfo.exe") or ends_with(process.parent.executable.caseless, "\\bginfo64.exe")) and (ends_with(process.executable.caseless, "\\calc.exe") or ends_with(process.executable.caseless, "\\cmd.exe") or ends_with(process.executable.caseless, "\\cscript.exe") or ends_with(process.executable.caseless, "\\mshta.exe") or ends_with(process.executable.caseless, "\\notepad.exe") or ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\pwsh.exe") or ends_with(process.executable.caseless, "\\wscript.exe") or process.executable.caseless like "*\\AppData\\Local\\*" or process.executable.caseless like "*\\AppData\\Roaming\\*" or process.executable.caseless like "*:\\Users\\Public\\*" or process.executable.caseless like "*:\\Temp\\*" or process.executable.caseless like "*:\\Windows\\Temp\\*" or process.executable.caseless like "*:\\PerfLogs\\*")
