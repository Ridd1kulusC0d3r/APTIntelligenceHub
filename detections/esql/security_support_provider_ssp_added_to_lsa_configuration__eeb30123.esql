// Security Support Provider (SSP) Added to LSA Configuration | T1547.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_ssp_added_lsa_config.yml
from * metadata _id, _index, _version | where (ends_with(registry.path, "\\Control\\Lsa\\Security Packages") or ends_with(registry.path, "\\Control\\Lsa\\OSConfig\\Security Packages")) and not (process.executable.caseless in ("C:\\Windows\\system32\\msiexec.exe", "C:\\Windows\\syswow64\\MsiExec.exe") or process.executable.caseless is null)
