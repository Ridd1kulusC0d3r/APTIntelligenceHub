// PowerShell Script Change Permission Via Set-Acl - PsScript | T1222 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_set_acl.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*Set-Acl *" and powershell.file.script_block_text like "*-AclObject *" and powershell.file.script_block_text like "*-Path *"
