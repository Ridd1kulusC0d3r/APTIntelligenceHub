// Suspicious Program Location Whitelisted In Firewall Via Netsh.EXE | T1686.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_netsh_fw_allow_program_in_susp_location.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\netsh.exe") or process.pe.original_file_name=="netsh.exe") and (process.command_line like "*firewall*" and process.command_line like "*add*" and process.command_line like "*allowedprogram*" or process.command_line like "*advfirewall*" and process.command_line like "*firewall*" and process.command_line like "*add*" and process.command_line like "*rule*" and process.command_line like "*action=allow*" and process.command_line like "*program=*") and (process.command_line like "*:\\$Recycle.bin\\*" or process.command_line like "*:\\RECYCLER.BIN\\*" or process.command_line like "*:\\RECYCLERS.BIN\\*" or process.command_line like "*:\\SystemVolumeInformation\\*" or process.command_line like "*:\\Temp\\*" or process.command_line like "*:\\Users\\Default\\*" or process.command_line like "*:\\Users\\Desktop\\*" or process.command_line like "*:\\Users\\Public\\*" or process.command_line like "*:\\Windows\\addins\\*" or process.command_line like "*:\\Windows\\cursors\\*" or process.command_line like "*:\\Windows\\debug\\*" or process.command_line like "*:\\Windows\\drivers\\*" or process.command_line like "*:\\Windows\\fonts\\*" or process.command_line like "*:\\Windows\\help\\*" or process.command_line like "*:\\Windows\\system32\\tasks\\*" or process.command_line like "*:\\Windows\\Tasks\\*" or process.command_line like "*:\\Windows\\Temp\\*" or process.command_line like "*\\Downloads\\*" or process.command_line like "*\\Local Settings\\Temporary Internet Files\\*" or process.command_line like "*\\Temporary Internet Files\\Content.Outlook\\*" or process.command_line like "*%Public%\\*" or process.command_line like "*%TEMP%*" or process.command_line like "*%TMP%*")
