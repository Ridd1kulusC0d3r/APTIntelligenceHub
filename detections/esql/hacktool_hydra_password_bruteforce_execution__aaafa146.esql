// HackTool - Hydra Password Bruteforce Execution | T1110, T1110.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_hydra.yml
from * metadata _id, _index, _version | where process.command_line like "*-u *" and process.command_line like "*-p *" and (process.command_line like "*^USER^*" or process.command_line like "*^PASS^*")
