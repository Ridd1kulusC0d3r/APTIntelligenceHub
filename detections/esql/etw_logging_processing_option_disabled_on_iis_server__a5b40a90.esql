// ETW Logging/Processing Option Disabled On IIS Server | T1505.004, T1685.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/iis-configuration/win_iis_logging_etw_disabled.yml
from * metadata _id, _index, _version | where event.code=="29" and ends_with(winlog.event_data.Configuration, "@logTargetW3C") and winlog.event_data.OldValue like "*ETW*" and not winlog.event_data.NewValue like "*ETW*"
