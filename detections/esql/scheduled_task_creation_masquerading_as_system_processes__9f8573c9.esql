// Scheduled Task Creation Masquerading as System Processes | T1036.004, T1036.005, T1053.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_schtasks_system_process.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\schtasks.exe") or process.pe.original_file_name=="schtasks.exe") and (process.command_line like "* -create *" or process.command_line like "* /create *" or process.command_line like "* –create *" or process.command_line like "* —create *" or process.command_line like "* ―create *") and (process.command_line like "* audiodg*" or process.command_line like "* conhost*" or process.command_line like "* dwm.exe*" or process.command_line like "* explorer*" or process.command_line like "* lsass*" or process.command_line like "* lsm*" or process.command_line like "* mmc*" or process.command_line like "* msiexec*" or process.command_line like "* regsvr32*" or process.command_line like "* rundll32*" or process.command_line like "* services*" or process.command_line like "* spoolsv*" or process.command_line like "* svchost*" or process.command_line like "* taskeng*" or process.command_line like "* taskhost*" or process.command_line like "* wininit*" or process.command_line like "* winlogon*")
