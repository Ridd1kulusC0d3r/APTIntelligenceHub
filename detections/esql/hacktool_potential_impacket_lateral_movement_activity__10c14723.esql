// HackTool - Potential Impacket Lateral Movement Activity | T1021.003, T1047 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_impacket_lateral_movement.yml
from * metadata _id, _index, _version | where (ends_with(process.parent.executable.caseless, "\\wmiprvse.exe") or ends_with(process.parent.executable.caseless, "\\mmc.exe") or ends_with(process.parent.executable.caseless, "\\explorer.exe") or ends_with(process.parent.executable.caseless, "\\services.exe")) and process.command_line like "*cmd.exe*" and process.command_line like "*/Q*" and process.command_line like "*/c*" and process.command_line like "*\\\\127.0.0.1\\*" and process.command_line like "*&1*" or (process.parent.command_line like "*svchost.exe -k netsvcs*" or process.parent.command_line like "*taskeng.exe*") and process.command_line like "*cmd.exe*" and process.command_line like "*/C*" and process.command_line like "*Windows\\Temp\\*" and process.command_line like "*&1*"
