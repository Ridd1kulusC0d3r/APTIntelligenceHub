// Defrag Deactivation | T1053.005 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2018/TA/Slingshot/proc_creation_win_apt_slingshot.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\schtasks.exe") and (process.command_line like "*/delete*" or process.command_line like "*/change*") and process.command_line like "*/TN*" and process.command_line like "*\\Microsoft\\Windows\\Defrag\\ScheduledDefrag*"
