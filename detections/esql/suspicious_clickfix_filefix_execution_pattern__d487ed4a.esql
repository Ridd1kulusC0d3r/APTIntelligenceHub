// Suspicious ClickFix/FileFix Execution Pattern | T1204.001, T1204.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_clickfix_filefix_execution.yml
from * metadata _id, _index, _version | where ends_with(process.parent.executable.caseless, "\\explorer.exe") and process.command_line like "*#*" and (process.command_line like "*account*" or process.command_line like "*anti-bot*" or process.command_line like "*botcheck*" or process.command_line like "*captcha*" or process.command_line like "*challenge*" or process.command_line like "*confirmation*" or process.command_line like "*fraud*" or process.command_line like "*human*" or process.command_line like "*identification*" or process.command_line like "*identificator*" or process.command_line like "*identity*" or process.command_line like "*robot*" or process.command_line like "*validation*" or process.command_line like "*verification*" or process.command_line like "*verify*")
