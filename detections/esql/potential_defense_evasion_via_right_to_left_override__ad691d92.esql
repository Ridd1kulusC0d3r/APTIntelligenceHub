// Potential Defense Evasion Via Right-to-Left Override | T1036.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_right_to_left_override.yml
from * metadata _id, _index, _version | where process.command_line like "*\\u202e*" or process.command_line like "*[U+202E]*" or process.command_line like "*‮*"
