// NTLMv1 Logon Between Client and Server | T1550.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/system/lsasrv/win_system_lsasrv_ntlmv1.yml
from * metadata _id, _index, _version | where winlog.channel=="System" and winlog.provider_name=="LsaSrv" and (event.code in ("6038", "6039"))
