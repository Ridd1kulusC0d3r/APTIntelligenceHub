// Suspicious Microsoft Office Child Process | T1047, T1204.002, T1218.010 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_office_susp_child_processes.yml
from * metadata _id, _index, _version | where (ends_with(process.parent.executable.caseless, "\\EQNEDT32.EXE") or ends_with(process.parent.executable.caseless, "\\EXCEL.EXE") or ends_with(process.parent.executable.caseless, "\\MSACCESS.EXE") or ends_with(process.parent.executable.caseless, "\\MSPUB.exe") or ends_with(process.parent.executable.caseless, "\\ONENOTE.EXE") or ends_with(process.parent.executable.caseless, "\\POWERPNT.exe") or ends_with(process.parent.executable.caseless, "\\VISIO.exe") or ends_with(process.parent.executable.caseless, "\\WINWORD.EXE") or ends_with(process.parent.executable.caseless, "\\wordpad.exe") or ends_with(process.parent.executable.caseless, "\\wordview.exe")) and (process.pe.original_file_name in ("bitsadmin.exe", "CertOC.exe", "CertUtil.exe", "Cmd.Exe", "CMSTP.EXE", "cscript.exe", "curl.exe", "HH.exe", "IEExec.exe", "InstallUtil.exe", "javaw.exe", "Microsoft.Workflow.Compiler.exe", "msdt.exe", "MSHTA.EXE", "msiexec.exe", "Msxsl.exe", "odbcconf.exe", "pcalua.exe", "PowerShell.EXE", "RegAsm.exe", "RegSvcs.exe", "REGSVR32.exe", "RUNDLL32.exe", "schtasks.exe", "ScriptRunner.exe", "wmic.exe", "WorkFolders.exe", "wscript.exe") or ends_with(process.executable.caseless, "\\AppVLP.exe") or ends_with(process.executable.caseless, "\\bash.exe") or ends_with(process.executable.caseless, "\\bitsadmin.exe") or ends_with(process.executable.caseless, "\\certoc.exe") or ends_with(process.executable.caseless, "\\certutil.exe") or ends_with(process.executable.caseless, "\\cmd.exe") or ends_with(process.executable.caseless, "\\cmstp.exe") or ends_with(process.executable.caseless, "\\control.exe") or ends_with(process.executable.caseless, "\\cscript.exe") or ends_with(process.executable.caseless, "\\curl.exe") or ends_with(process.executable.caseless, "\\forfiles.exe") or ends_with(process.executable.caseless, "\\hh.exe") or ends_with(process.executable.caseless, "\\ieexec.exe") or ends_with(process.executable.caseless, "\\installutil.exe") or ends_with(process.executable.caseless, "\\javaw.exe") or ends_with(process.executable.caseless, "\\mftrace.exe") or ends_with(process.executable.caseless, "\\Microsoft.Workflow.Compiler.exe") or ends_with(process.executable.caseless, "\\msbuild.exe") or ends_with(process.executable.caseless, "\\msdt.exe") or ends_with(process.executable.caseless, "\\mshta.exe") or ends_with(process.executable.caseless, "\\msidb.exe") or ends_with(process.executable.caseless, "\\msiexec.exe") or ends_with(process.executable.caseless, "\\msxsl.exe") or ends_with(process.executable.caseless, "\\odbcconf.exe") or ends_with(process.executable.caseless, "\\pcalua.exe") or ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\pwsh.exe") or ends_with(process.executable.caseless, "\\regasm.exe") or ends_with(process.executable.caseless, "\\regsvcs.exe") or ends_with(process.executable.caseless, "\\regsvr32.exe") or ends_with(process.executable.caseless, "\\rundll32.exe") or ends_with(process.executable.caseless, "\\schtasks.exe") or ends_with(process.executable.caseless, "\\scrcons.exe") or ends_with(process.executable.caseless, "\\scriptrunner.exe") or ends_with(process.executable.caseless, "\\sh.exe") or ends_with(process.executable.caseless, "\\svchost.exe") or ends_with(process.executable.caseless, "\\verclsid.exe") or ends_with(process.executable.caseless, "\\wmic.exe") or ends_with(process.executable.caseless, "\\workfolders.exe") or ends_with(process.executable.caseless, "\\wscript.exe") or process.executable.caseless like "*\\AppData\\*" or process.executable.caseless like "*\\Users\\Public\\*" or process.executable.caseless like "*\\ProgramData\\*" or process.executable.caseless like "*\\Windows\\Tasks\\*" or process.executable.caseless like "*\\Windows\\Temp\\*" or process.executable.caseless like "*\\Windows\\System32\\Tasks\\*")
