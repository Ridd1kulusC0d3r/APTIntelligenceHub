// Disabling Security Tools | T1686 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_security_tools_disabling.yml
from * metadata _id, _index, _version | where ends_with(Image, "/service") and CommandLine like "*iptables*" and CommandLine like "*stop*" or ends_with(Image, "/service") and CommandLine like "*ip6tables*" and CommandLine like "*stop*" or ends_with(Image, "/chkconfig") and CommandLine like "*iptables*" and CommandLine like "*stop*" or ends_with(Image, "/chkconfig") and CommandLine like "*ip6tables*" and CommandLine like "*stop*" or ends_with(Image, "/systemctl") and CommandLine like "*firewalld*" and CommandLine like "*stop*" or ends_with(Image, "/systemctl") and CommandLine like "*firewalld*" and CommandLine like "*disable*" or ends_with(Image, "/service") and CommandLine like "*cbdaemon*" and CommandLine like "*stop*" or ends_with(Image, "/chkconfig") and CommandLine like "*cbdaemon*" and CommandLine like "*off*" or ends_with(Image, "/systemctl") and CommandLine like "*cbdaemon*" and CommandLine like "*stop*" or ends_with(Image, "/systemctl") and CommandLine like "*cbdaemon*" and CommandLine like "*disable*" or ends_with(Image, "/setenforce") and CommandLine like "*0*" or ends_with(Image, "/systemctl") and CommandLine like "*stop*" and CommandLine like "*falcon-sensor*" or ends_with(Image, "/systemctl") and CommandLine like "*disable*" and CommandLine like "*falcon-sensor*"
