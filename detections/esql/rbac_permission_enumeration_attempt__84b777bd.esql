// RBAC Permission Enumeration Attempt | T1069.003, T1087.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/application/kubernetes/audit/kubernetes_audit_rbac_permisions_listing.yml
from * metadata _id, _index, _version | where verb=="create" and apiGroup=="authorization.k8s.io" and objectRef.resource=="selfsubjectrulesreviews"
