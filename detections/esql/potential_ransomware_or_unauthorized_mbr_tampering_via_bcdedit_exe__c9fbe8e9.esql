// Potential Ransomware or Unauthorized MBR Tampering Via Bcdedit.EXE | T1070, T1542.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_bcdedit_susp_execution.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\bcdedit.exe") or process.pe.original_file_name=="bcdedit.exe") and (process.command_line like "*delete*" or process.command_line like "*deletevalue*" or process.command_line like "*import*" or process.command_line like "*safeboot*" or process.command_line like "*network*")
