// Suspicious DNS Query for IP Lookup Service APIs | T1590 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/dns_query/dns_query_win_susp_external_ip_lookup.yml
from * metadata _id, _index, _version | where (dns.question.name in ("www.ip.cn", "l2.io") or dns.question.name like "*api.2ip.ua*" or dns.question.name like "*api.bigdatacloud.net*" or dns.question.name like "*api.ipify.org*" or dns.question.name like "*bot.whatismyipaddress.com*" or dns.question.name like "*canireachthe.net*" or dns.question.name like "*checkip.amazonaws.com*" or dns.question.name like "*checkip.dyndns.org*" or dns.question.name like "*curlmyip.com*" or dns.question.name like "*db-ip.com*" or dns.question.name like "*edns.ip-api.com*" or dns.question.name like "*eth0.me*" or dns.question.name like "*freegeoip.app*" or dns.question.name like "*geoipy.com*" or dns.question.name like "*getip.pro*" or dns.question.name like "*icanhazip.com*" or dns.question.name like "*ident.me*" or dns.question.name like "*ifconfig.io*" or dns.question.name like "*ifconfig.me*" or dns.question.name like "*ip-api.com*" or dns.question.name like "*ip.360.cn*" or dns.question.name like "*ip.anysrc.net*" or dns.question.name like "*ip.taobao.com*" or dns.question.name like "*ip.tyk.nu*" or dns.question.name like "*ipaddressworld.com*" or dns.question.name like "*ipapi.co*" or dns.question.name like "*ipconfig.io*" or dns.question.name like "*ipecho.net*" or dns.question.name like "*ipinfo.io*" or dns.question.name like "*ipip.net*" or dns.question.name like "*ipof.in*" or dns.question.name like "*ipv4.icanhazip.com*" or dns.question.name like "*ipv4bot.whatismyipaddress.com*" or dns.question.name like "*ipv6-test.com*" or dns.question.name like "*ipwho.is*" or dns.question.name like "*jsonip.com*" or dns.question.name like "*myexternalip.com*" or dns.question.name like "*seeip.org*" or dns.question.name like "*wgetip.com*" or dns.question.name like "*whatismyip.akamai.com*" or dns.question.name like "*whois.pconline.com.cn*" or dns.question.name like "*wtfismyip.com*") and not (ends_with(process.executable.caseless, "\\brave.exe") or process.executable.caseless in ("C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe") or process.executable.caseless in ("C:\\Program Files\\Mozilla Firefox\\firefox.exe", "C:\\Program Files (x86)\\Mozilla Firefox\\firefox.exe") or process.executable.caseless in ("C:\\Program Files (x86)\\Internet Explorer\\iexplore.exe", "C:\\Program Files\\Internet Explorer\\iexplore.exe") or ends_with(process.executable.caseless, "\\maxthon.exe") or starts_with(process.executable.caseless, "C:\\Program Files (x86)\\Microsoft\\EdgeWebView\\Application\\") or ends_with(process.executable.caseless, "\\WindowsApps\\MicrosoftEdge.exe") or process.executable.caseless in ("C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe", "C:\\Program Files\\Microsoft\\Edge\\Application\\msedge.exe") or (starts_with(process.executable.caseless, "C:\\Program Files (x86)\\Microsoft\\EdgeCore\\") or starts_with(process.executable.caseless, "C:\\Program Files\\Microsoft\\EdgeCore\\")) and (ends_with(process.executable.caseless, "\\msedge.exe") or ends_with(process.executable.caseless, "\\msedgewebview2.exe")) or ends_with(process.executable.caseless, "\\opera.exe") or ends_with(process.executable.caseless, "\\safari.exe") or ends_with(process.executable.caseless, "\\seamonkey.exe") or ends_with(process.executable.caseless, "\\vivaldi.exe") or ends_with(process.executable.caseless, "\\whale.exe"))
