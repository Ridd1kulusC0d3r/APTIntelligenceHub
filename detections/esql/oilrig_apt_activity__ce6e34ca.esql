// OilRig APT Activity | T1053.005, T1071.004, T1112, T1543.003 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2018/TA/OilRig/proc_creation_win_apt_oilrig_mar18.yml
from * metadata _id, _index, _version | where process.command_line like "*SC Scheduled Scan*" and process.command_line like "*\\microsoft\\Taskbar\\autoit3.exe*" or process.executable.caseless like "*\\Windows\\Temp\\DB\\*" and ends_with(process.executable.caseless, ".exe") or process.executable.caseless=="C:\\Windows\\system32\\Service.exe" and (process.command_line like "*i*" or process.command_line like "*u*") or ends_with(process.parent.executable.caseless, "\\local\\microsoft\\Taskbar\\autoit3.exe") and process.command_line like "*nslookup.exe*" and process.command_line like "*-q=TXT*"
