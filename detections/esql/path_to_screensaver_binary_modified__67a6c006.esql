// Path To Screensaver Binary Modified | T1546.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_event/registry_event_modify_screensaver_binary_path.yml
from * metadata _id, _index, _version | where ends_with(registry.path, "\\Control Panel\\Desktop\\SCRNSAVE.EXE") and not (ends_with(process.executable.caseless, "\\rundll32.exe") or ends_with(process.executable.caseless, "\\explorer.exe"))
