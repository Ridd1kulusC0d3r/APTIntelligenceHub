// Powershell Timestomp | T1070.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_timestomp.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*.CreationTime =*" or powershell.file.script_block_text like "*.LastWriteTime =*" or powershell.file.script_block_text like "*.LastAccessTime =*" or powershell.file.script_block_text like "*[IO.File]::SetCreationTime*" or powershell.file.script_block_text like "*[IO.File]::SetLastAccessTime*" or powershell.file.script_block_text like "*[IO.File]::SetLastWriteTime*"
