// ADSI-Cache File Creation By Uncommon Tool | T1001.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_adsi_cache_creation_by_uncommon_tool.yml
from * metadata _id, _index, _version | where file.path like "*\\Local\\Microsoft\\Windows\\SchCache\\*" and ends_with(file.path, ".sch") and not (ends_with(process.executable.caseless, ":\\Program Files\\Cylance\\Desktop\\CylanceSvc.exe") or ends_with(process.executable.caseless, ":\\Windows\\CCM\\CcmExec.exe") or ends_with(process.executable.caseless, ":\\windows\\system32\\dllhost.exe") or ends_with(process.executable.caseless, ":\\Windows\\system32\\dsac.exe") or ends_with(process.executable.caseless, ":\\Windows\\system32\\efsui.exe") or ends_with(process.executable.caseless, ":\\windows\\system32\\mmc.exe") or ends_with(process.executable.caseless, ":\\windows\\system32\\svchost.exe") or ends_with(process.executable.caseless, ":\\Windows\\System32\\wbem\\WmiPrvSE.exe") or ends_with(process.executable.caseless, ":\\windows\\system32\\WindowsPowerShell\\v1.0\\powershell.exe") or process.executable.caseless like "*:\\Windows\\ccmsetup\\autoupgrade\\ccmsetup*" or process.executable.caseless like "*:\\Program Files\\SentinelOne\\Sentinel Agent*" or process.executable.caseless like "*:\\Program Files\\*" and process.executable.caseless like "*\\Microsoft Office*" and ends_with(process.executable.caseless, "\\OUTLOOK.EXE")) and not (ends_with(process.executable.caseless, "\\LANDesk\\LDCLient\\ldapwhoami.exe") or ends_with(process.executable.caseless, ":\\Program Files\\Citrix\\Receiver StoreFront\\Services\\DefaultDomainServices\\Citrix.DeliveryServices.DomainServices.ServiceHost.exe"))
