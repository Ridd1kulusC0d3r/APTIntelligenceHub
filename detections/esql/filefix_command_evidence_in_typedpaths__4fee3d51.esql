// FileFix - Command Evidence in TypedPaths | T1204.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_filefix_typedpath_commands.yml
from * metadata _id, _index, _version | where ends_with(registry.path, "\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\TypedPaths\\url1") and winlog.event_data.Details like "*#*" and winlog.event_data.Details like "*http*" and (winlog.event_data.Details like "*account*" or winlog.event_data.Details like "*anti-bot*" or winlog.event_data.Details like "*botcheck*" or winlog.event_data.Details like "*captcha*" or winlog.event_data.Details like "*challenge*" or winlog.event_data.Details like "*confirmation*" or winlog.event_data.Details like "*fraud*" or winlog.event_data.Details like "*human*" or winlog.event_data.Details like "*identification*" or winlog.event_data.Details like "*identificator*" or winlog.event_data.Details like "*identity*" or winlog.event_data.Details like "*robot*" or winlog.event_data.Details like "*validation*" or winlog.event_data.Details like "*verification*" or winlog.event_data.Details like "*verify*" or winlog.event_data.Details like "*%comspec%*" or winlog.event_data.Details like "*bitsadmin*" or winlog.event_data.Details like "*certutil*" or winlog.event_data.Details like "*cmd*" or winlog.event_data.Details like "*cscript*" or winlog.event_data.Details like "*curl*" or winlog.event_data.Details like "*finger*" or winlog.event_data.Details like "*mshta*" or winlog.event_data.Details like "*powershell*" or winlog.event_data.Details like "*pwsh*" or winlog.event_data.Details like "*regsvr32*" or winlog.event_data.Details like "*rundll32*" or winlog.event_data.Details like "*schtasks*" or winlog.event_data.Details like "*wget*" or winlog.event_data.Details like "*wscript*")
