// Windows LAPS Credential Dump From Entra ID | T1098.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/azure/audit_logs/azure_auditlogs_laps_credential_dumping.yml
from * metadata _id, _index, _version | where category=="Device" and activityType like "*Recover device local administrator password*" and additionalDetails.additionalInfo like "*Successfully recovered local credential by device id*"
