// HackTool - Powerup Write Hijack DLL | T1574.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_hktl_powerup_dllhijacking.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\pwsh.exe")) and ends_with(file.path, ".bat")
