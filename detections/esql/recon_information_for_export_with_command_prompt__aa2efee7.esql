// Recon Information for Export with Command Prompt | T1119 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_recon.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\tree.com") or ends_with(process.executable.caseless, "\\WMIC.exe") or ends_with(process.executable.caseless, "\\doskey.exe") or ends_with(process.executable.caseless, "\\sc.exe") or process.pe.original_file_name in ("wmic.exe", "DOSKEY.EXE", "sc.exe")) and (process.parent.command_line like "* > %TEMP%\\*" or process.parent.command_line like "* > %TMP%\\*")
