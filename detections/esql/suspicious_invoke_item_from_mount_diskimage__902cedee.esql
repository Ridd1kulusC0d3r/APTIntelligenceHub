// Suspicious Invoke-Item From Mount-DiskImage | T1553.005 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_run_from_mount_diskimage.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*Mount-DiskImage *" and powershell.file.script_block_text like "*-ImagePath *" and powershell.file.script_block_text like "*Get-Volume*" and powershell.file.script_block_text like "*.DriveLetter*" and powershell.file.script_block_text like "*invoke-item *" and powershell.file.script_block_text like "*):\\*"
