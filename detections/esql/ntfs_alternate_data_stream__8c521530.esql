// NTFS Alternate Data Stream | T1059.001, T1564.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_ntfs_ads_access.yml
from * metadata _id, _index, _version | where (powershell.file.script_block_text like "*set-content*" or powershell.file.script_block_text like "*add-content*") and powershell.file.script_block_text like "*-stream*"
