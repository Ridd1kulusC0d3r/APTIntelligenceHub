// Access To Potentially Sensitive Sysvol Files By Uncommon Applications | T1552.006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_access/file_access_win_susp_gpo_files.yml
from * metadata _id, _index, _version | where starts_with(file.path, "\\") and file.path like "*\\sysvol\\*" and file.path like "*\\Policies\\*" and (ends_with(file.path, "audit.csv") or ends_with(file.path, "Files.xml") or ends_with(file.path, "GptTmpl.inf") or ends_with(file.path, "groups.xml") or ends_with(file.path, "Registry.pol") or ends_with(file.path, "Registry.xml") or ends_with(file.path, "scheduledtasks.xml") or ends_with(file.path, "scripts.ini") or ends_with(file.path, "services.xml")) and not (starts_with(process.executable.caseless, "C:\\Program Files (x86)\\") or starts_with(process.executable.caseless, "C:\\Program Files\\") or starts_with(process.executable.caseless, "C:\\Windows\\system32\\") or starts_with(process.executable.caseless, "C:\\Windows\\SysWOW64\\") or process.executable.caseless=="C:\\Windows\\explorer.exe")
