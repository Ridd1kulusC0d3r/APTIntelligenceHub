// Suspicious NTLM Authentication on the Printer Spooler Service | T1212 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_rundll32_ntlmrelay.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\rundll32.exe") or process.pe.original_file_name=="RUNDLL32.EXE") and process.command_line like "*C:\\windows\\system32\\davclnt.dll,DavSetCookie*" and process.command_line like "*http*" and (process.command_line like "*spoolss*" or process.command_line like "*srvsvc*" or process.command_line like "*/print/pipe/*")
