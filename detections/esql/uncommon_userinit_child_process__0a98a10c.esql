// Uncommon Userinit Child Process | T1037.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_userinit_uncommon_child_processes.yml
from * metadata _id, _index, _version | where ends_with(process.parent.executable.caseless, "\\userinit.exe") and not ends_with(process.executable.caseless, ":\\WINDOWS\\explorer.exe") and not (process.command_line like "*netlogon.bat*" or process.command_line like "*UsrLogon.cmd*" or process.command_line=="PowerShell.exe" or ends_with(process.executable.caseless, ":\\Windows\\System32\\proquota.exe") or ends_with(process.executable.caseless, ":\\Windows\\SysWOW64\\proquota.exe") or ends_with(process.executable.caseless, ":\\Program Files (x86)\\Citrix\\HDX\\bin\\cmstart.exe") or ends_with(process.executable.caseless, ":\\Program Files (x86)\\Citrix\\HDX\\bin\\icast.exe") or ends_with(process.executable.caseless, ":\\Program Files (x86)\\Citrix\\System32\\icast.exe") or ends_with(process.executable.caseless, ":\\Program Files\\Citrix\\HDX\\bin\\cmstart.exe") or ends_with(process.executable.caseless, ":\\Program Files\\Citrix\\HDX\\bin\\icast.exe") or ends_with(process.executable.caseless, ":\\Program Files\\Citrix\\System32\\icast.exe") or process.executable.caseless is null)
