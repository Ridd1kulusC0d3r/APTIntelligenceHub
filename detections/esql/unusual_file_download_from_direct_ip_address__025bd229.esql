// Unusual File Download from Direct IP Address | T1564.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/create_stream_hash/create_stream_hash_susp_ip_domains.yml
from * metadata _id, _index, _version | where winlog.event_data.Contents rlike "http[s]?://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}" and (file.path like "*.ps1:Zone*" or file.path like "*.bat:Zone*" or file.path like "*.exe:Zone*" or file.path like "*.vbe:Zone*" or file.path like "*.vbs:Zone*" or file.path like "*.dll:Zone*" or file.path like "*.one:Zone*" or file.path like "*.cmd:Zone*" or file.path like "*.hta:Zone*" or file.path like "*.xll:Zone*" or file.path like "*.lnk:Zone*")
