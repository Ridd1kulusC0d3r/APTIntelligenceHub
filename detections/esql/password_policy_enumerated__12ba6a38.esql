// Password Policy Enumerated | T1201 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_password_policy_enumerated.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="4661" and winlog.event_data.AccessList like "*%%5392*" and winlog.event_data.ObjectServer=="Security Account Manager"
