// Azure Active Directory Hybrid Health AD FS Service Delete | T1578.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/cloud/azure/activity_logs/azure_aadhybridhealth_adfs_service_delete.yml
from * metadata _id, _index, _version | where category=="Administrative" and resourceId like "*AdFederationService*" and operationName=="MICROSOFT.ADHYBRIDHEALTHSERVICE/SERVICES/DELETE"
