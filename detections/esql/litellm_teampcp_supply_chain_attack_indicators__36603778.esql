// LiteLLM / TeamPCP Supply Chain Attack Indicators | T1195.002, T1543.002, T1560.001 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2026/TA/TeamPCP/proc_creation_lnx_teampcp_litellm_supply_chain_attack_indicators.yml
from * metadata _id, _index, _version | where Image like "*/python3*" and CommandLine like "*exec(base64.b64decode('aW1wb3J0*" and CommandLine like "*kI2NF9TQ1JJUFQgPSAiYV*" or ends_with(Image, "/tar") and CommandLine like "*tpcp.tar.gz*" and CommandLine like "*payload.enc*" and CommandLine like "*session.key.enc*" or ends_with(Image, "/curl") and CommandLine like "*models.litellm.cloud*" and CommandLine like "*X-Filename: tpcp.tar.gz*" or ParentImage like "*/python3*" and CommandLine like "*systemctl*" and CommandLine like "*--user*" and CommandLine like "*sysmon*"
