// System Information Discovery Via Sysctl - MacOS | T1082, T1497.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_sysctl_discovery.yml
from * metadata _id, _index, _version | where (ends_with(Image, "/sysctl") or CommandLine like "*sysctl*") and (CommandLine like "*hw.*" or CommandLine like "*kern.*" or CommandLine like "*machdep.*")
