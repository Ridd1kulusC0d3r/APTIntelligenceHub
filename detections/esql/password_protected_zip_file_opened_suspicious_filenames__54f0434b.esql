// Password Protected ZIP File Opened (Suspicious Filenames) | T1027, T1036, T1105 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_susp_opened_encrypted_zip_filename.yml
from * metadata _id, _index, _version | where winlog.channel=="Security" and event.code=="5379" and winlog.event_data.TargetName like "*Microsoft_Windows_Shell_ZipFolder:filename*" and (winlog.event_data.TargetName like "*invoice*" or winlog.event_data.TargetName like "*new order*" or winlog.event_data.TargetName like "*rechnung*" or winlog.event_data.TargetName like "*factura*" or winlog.event_data.TargetName like "*delivery*" or winlog.event_data.TargetName like "*purchase*" or winlog.event_data.TargetName like "*order*" or winlog.event_data.TargetName like "*payment*")
