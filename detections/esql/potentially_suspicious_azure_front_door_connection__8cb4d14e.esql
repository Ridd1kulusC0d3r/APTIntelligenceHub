// Potentially Suspicious Azure Front Door Connection | T1090.004, T1102.002 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/network_connection/net_connection_win_susp_azurefd_connection.yml
from * metadata _id, _index, _version | where destination.domain like "*azurefd.net*" and not (ends_with(process.executable.caseless, "brave.exe") or ends_with(process.executable.caseless, "chrome.exe") or ends_with(process.executable.caseless, "chromium.exe") or ends_with(process.executable.caseless, "firefox.exe") or ends_with(process.executable.caseless, "msedge.exe") or ends_with(process.executable.caseless, "msedgewebview2.exe") or ends_with(process.executable.caseless, "opera.exe") or ends_with(process.executable.caseless, "vivaldi.exe") or ends_with(process.executable.caseless, "searchapp.exe") or destination.domain like "*afdxtest.z01.azurefd.net*" or destination.domain like "*fp-afd.azurefd.net*" or destination.domain like "*fp-afdx-bpdee4gtg6frejfd.z01.azurefd.net*" or destination.domain like "*roxy.azurefd.net*" or destination.domain like "*powershellinfraartifacts-gkhedzdeaghdezhr.z01.azurefd.net*" or destination.domain like "*storage-explorer-publishing-feapcgfgbzc2cjek.b01.azurefd.net*" or destination.domain like "*graph.azurefd.net*")
