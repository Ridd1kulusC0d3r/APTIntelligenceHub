// Suspicious Startup Folder Persistence | T1204.002, T1547.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_startup_folder_persistence.yml
from * metadata _id, _index, _version | where file.path like "*\\Windows\\Start Menu\\Programs\\Startup\\*" and (ends_with(file.path, ".bat") or ends_with(file.path, ".cmd") or ends_with(file.path, ".dll") or ends_with(file.path, ".hta") or ends_with(file.path, ".jar") or ends_with(file.path, ".js") or ends_with(file.path, ".jse") or ends_with(file.path, ".msi") or ends_with(file.path, ".ps1") or ends_with(file.path, ".psd1") or ends_with(file.path, ".psm1") or ends_with(file.path, ".scr") or ends_with(file.path, ".url") or ends_with(file.path, ".vba") or ends_with(file.path, ".vbe") or ends_with(file.path, ".vbs") or ends_with(file.path, ".wsf"))
