// Potentially Suspicious Desktop Background Change Using Reg.EXE | T1112, T1491.001 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_reg_desktop_background_change.yml
from * metadata _id, _index, _version | where (ends_with(process.executable.caseless, "\\reg.exe") or process.pe.original_file_name=="reg.exe") and process.command_line like "*add*" and (process.command_line like "*Control Panel\\Desktop*" or process.command_line like "*CurrentVersion\\Policies\\ActiveDesktop*" or process.command_line like "*CurrentVersion\\Policies\\System*") and (process.command_line like "*/v NoChangingWallpaper*" and process.command_line like "*/d 1*" or process.command_line like "*/v Wallpaper*" and process.command_line like "*/t REG_SZ*" or process.command_line like "*/v WallpaperStyle*" and process.command_line like "*/d 2*")
