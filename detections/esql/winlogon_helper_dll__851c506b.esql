// Winlogon Helper DLL | T1547.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_winlogon_helper_dll.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*CurrentVersion\\Winlogon*" and (powershell.file.script_block_text like "*Set-ItemProperty*" or powershell.file.script_block_text like "*New-Item*")
