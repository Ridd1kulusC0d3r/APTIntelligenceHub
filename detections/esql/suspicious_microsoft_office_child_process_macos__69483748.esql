// Suspicious Microsoft Office Child Process - MacOS | T1059.002, T1137.002, T1204.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_office_susp_child_processes.yml
from * metadata _id, _index, _version | where (ParentImage like "*Microsoft Word*" or ParentImage like "*Microsoft Excel*" or ParentImage like "*Microsoft PowerPoint*" or ParentImage like "*Microsoft OneNote*") and (ends_with(Image, "/bash") or ends_with(Image, "/curl") or ends_with(Image, "/dash") or ends_with(Image, "/fish") or ends_with(Image, "/osacompile") or ends_with(Image, "/osascript") or ends_with(Image, "/sh") or ends_with(Image, "/zsh") or ends_with(Image, "/python") or ends_with(Image, "/python3") or ends_with(Image, "/wget"))
