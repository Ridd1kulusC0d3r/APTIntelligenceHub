// Persistence Via Sticky Key Backdoor | T1546.008 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_cmd_sticky_keys_replace.yml
from * metadata _id, _index, _version | where process.command_line like "*copy *" and process.command_line like "*/y *" and process.command_line like "*C:\\windows\\system32\\cmd.exe C:\\windows\\system32\\sethc.exe*"
