// PowerShell Profile Modification | T1546.013 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_susp_powershell_profile.yml
from * metadata _id, _index, _version | where ends_with(file.path, "\\Microsoft.PowerShell_profile.ps1") or ends_with(file.path, "\\PowerShell\\profile.ps1") or ends_with(file.path, "\\Program Files\\PowerShell\\7-preview\\profile.ps1") or ends_with(file.path, "\\Program Files\\PowerShell\\7\\profile.ps1") or ends_with(file.path, "\\Windows\\System32\\WindowsPowerShell\\v1.0\\profile.ps1") or ends_with(file.path, "\\WindowsPowerShell\\profile.ps1")
