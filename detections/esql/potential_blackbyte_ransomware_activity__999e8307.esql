// Potential BlackByte Ransomware Activity | T1059.001, T1140, T1485, T1498 | https://github.com/SigmaHQ/sigma/blob/master/rules-emerging-threats/2021/Malware/BlackByte/proc_creation_win_malware_blackbyte_ransomware.yml
from * metadata _id, _index, _version | where starts_with(process.executable.caseless, "C:\\Users\\Public\\") and process.command_line like "* -single *" or process.command_line like "*del C:\\Windows\\System32\\Taskmgr.exe*" or process.command_line like "*;Set-Service -StartupType Disabled $*" or process.command_line like "*powershell -command \"$x =[System.Text.Encoding]::Unicode.GetString([System.Convert]::FromBase64String(*" or process.command_line like "* do start wordpad.exe /p *"
