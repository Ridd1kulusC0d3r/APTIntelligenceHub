// Suspicious ScreenSave Change by Reg.exe | T1546.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_reg_screensaver.yml
from * metadata _id, _index, _version | where ends_with(process.executable.caseless, "\\reg.exe") and (process.command_line like "*HKEY_CURRENT_USER\\Control Panel\\Desktop*" or process.command_line like "*HKCU\\Control Panel\\Desktop*") and (process.command_line like "*/v ScreenSaveActive*" and process.command_line like "*/t REG_SZ*" and process.command_line like "*/d 1*" and process.command_line like "*/f*" or process.command_line like "*/v ScreenSaveTimeout*" and process.command_line like "*/t REG_SZ*" and process.command_line like "*/d *" and process.command_line like "*/f*" or process.command_line like "*/v ScreenSaverIsSecure*" and process.command_line like "*/t REG_SZ*" and process.command_line like "*/d 0*" and process.command_line like "*/f*" or process.command_line like "*/v SCRNSAVE.EXE*" and process.command_line like "*/t REG_SZ*" and process.command_line like "*/d *" and process.command_line like "*.scr*" and process.command_line like "*/f*")
