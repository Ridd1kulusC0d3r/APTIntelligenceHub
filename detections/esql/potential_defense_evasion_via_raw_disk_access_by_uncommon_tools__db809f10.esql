// Potential Defense Evasion Via Raw Disk Access By Uncommon Tools | T1006 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/raw_access_thread/raw_access_thread_susp_disk_access_using_uncommon_tools.yml
from * metadata _id, _index, _version | where not (file.path like "*floppy*" or starts_with(process.executable.caseless, "C:\\$WINDOWS.~BT\\") or starts_with(process.executable.caseless, "C:\\Program Files (x86)\\") or starts_with(process.executable.caseless, "C:\\Program Files\\") or starts_with(process.executable.caseless, "C:\\Windows\\CCM\\") or starts_with(process.executable.caseless, "C:\\Windows\\explorer.exe") or starts_with(process.executable.caseless, "C:\\Windows\\servicing\\") or starts_with(process.executable.caseless, "C:\\Windows\\SoftwareDistribution\\") or starts_with(process.executable.caseless, "C:\\Windows\\System32\\") or starts_with(process.executable.caseless, "C:\\Windows\\SystemApps\\") or starts_with(process.executable.caseless, "C:\\Windows\\SysWOW64\\") or starts_with(process.executable.caseless, "C:\\Windows\\uus\\") or starts_with(process.executable.caseless, "C:\\Windows\\WinSxS\\") or process.executable.caseless in ("Registry", "System") or starts_with(process.executable.caseless, "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\") and (ends_with(process.executable.caseless, "\\MsMpEng.exe") or ends_with(process.executable.caseless, "\\MpDefenderCoreService.exe")) or starts_with(process.executable.caseless, "C:\\Users\\") and process.executable.caseless like "*\\AppData\\*" and process.executable.caseless like "*\\Microsoft\\*" or starts_with(process.executable.caseless, "C:\\Windows\\Temp\\") and (ends_with(process.executable.caseless, "\\Executables\\SSDUpdate.exe") or ends_with(process.executable.caseless, "\\HostMetadata\\NVMEHostmetadata.exe")) or process.executable.caseless is null or process.executable.caseless=="C:\\Windows\\ImmersiveControlPanel\\SystemSettings.exe" or starts_with(process.executable.caseless, "C:\\$WinREAgent\\Scratch\\")) and not (starts_with(process.executable.caseless, "C:\\Users\\") and process.executable.caseless like "*\\AppData\\Local\\GitHubDesktop\\app-*" and ends_with(process.executable.caseless, "\\resources\\app\\git\\mingw64\\bin\\git.exe") or starts_with(process.executable.caseless, "C:\\Windows\\Temp\\asgard2-agent\\") and ends_with(process.executable.caseless, "\\thor.exe") or starts_with(process.executable.caseless, "C:\\Users\\") and process.executable.caseless like "*\\AppData\\Local\\Keybase\\upd.exe*")
