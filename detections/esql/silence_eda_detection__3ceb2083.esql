// Silence.EDA Detection | T1059.001, T1071.004, T1529, T1572 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_apt_silence_eda.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*System.Diagnostics.Process*" and powershell.file.script_block_text like "*Stop-Computer*" and powershell.file.script_block_text like "*Restart-Computer*" and powershell.file.script_block_text like "*Exception in execution*" and powershell.file.script_block_text like "*$cmdargs*" and powershell.file.script_block_text like "*Close-Dnscat2Tunnel*" and powershell.file.script_block_text like "*set type=$LookupType`nserver*" and powershell.file.script_block_text like "*$Command | nslookup 2>&1 | Out-String*" and powershell.file.script_block_text like "*New-RandomDNSField*" and powershell.file.script_block_text like "*[Convert]::ToString($SYNOptions, 16)*" and powershell.file.script_block_text like "*$Session.Dead = $True*" and powershell.file.script_block_text like "*$Session[\"Driver\"] -eq*"
