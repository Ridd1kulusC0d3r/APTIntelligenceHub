// Web Server Process Spawning Shell Or Recon Commands (Webshell) | T1190, T1505.003 | Hub
from * metadata _id, _index, _version | where (ends_with(process.parent.executable.caseless, "\\w3wp.exe") or ends_with(process.parent.executable.caseless, "\\tomcat.exe") or ends_with(process.parent.executable.caseless, "\\tomcat8.exe") or ends_with(process.parent.executable.caseless, "\\tomcat9.exe") or ends_with(process.parent.executable.caseless, "\\java.exe") or ends_with(process.parent.executable.caseless, "\\httpd.exe") or ends_with(process.parent.executable.caseless, "\\nginx.exe") or ends_with(process.parent.executable.caseless, "\\UMWorkerProcess.exe")) and (ends_with(process.executable.caseless, "\\cmd.exe") or ends_with(process.executable.caseless, "\\powershell.exe") or ends_with(process.executable.caseless, "\\whoami.exe") or ends_with(process.executable.caseless, "\\net.exe") or ends_with(process.executable.caseless, "\\net1.exe") or ends_with(process.executable.caseless, "\\nltest.exe") or ends_with(process.executable.caseless, "\\certutil.exe") or ends_with(process.executable.caseless, "\\rundll32.exe"))
