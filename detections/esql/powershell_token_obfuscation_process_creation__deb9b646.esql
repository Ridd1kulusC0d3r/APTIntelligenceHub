// Powershell Token Obfuscation - Process Creation | T1027.009 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_powershell_token_obfuscation.yml
from * metadata _id, _index, _version | where (process.command_line rlike "\\w+`(?:\\w+|-|.)`[\\w+|\\s]" or process.command_line rlike "\"(?:\\{\\d\\})+\"\\s*-f" or process.command_line rlike "(?i)\\$\\{`?e`?n`?v`?:`?p`?a`?t`?h`?\\}") and not process.command_line like "*${env:path}*"
