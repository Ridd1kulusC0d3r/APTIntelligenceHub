// CodeIntegrity - Blocked Image/Driver Load For Policy Violation | T1543 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/code_integrity/win_codeintegrity_enforced_policy_block.yml
from * metadata _id, _index, _version | where winlog.channel=="Microsoft-Windows-CodeIntegrity/Operational" and event.code=="3077"
