// UAC Disabled | T1548.002 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/registry/registry_set/registry_set_uac_disable.yml
from * metadata _id, _index, _version | where registry.path like "*\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\EnableLUA*" and winlog.event_data.Details=="DWORD (0x00000000)"
