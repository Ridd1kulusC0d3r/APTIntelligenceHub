// Powershell Token Obfuscation - Powershell | T1027.009 | https://github.com/SigmaHQ/sigma/blob/master/rules-threat-hunting/windows/powershell/powershell_script/posh_ps_token_obfuscation.yml
from * metadata _id, _index, _version | where (powershell.file.script_block_text rlike "\\w+`(\\w+|-|.)`[\\w+|\\s]" or powershell.file.script_block_text rlike "\"(\\{\\d\\}){2,}\"\\s*-f" or powershell.file.script_block_text rlike "(?i)\\$\\{`?e`?n`?v`?:`?p`?a`?t`?h`?\\}") and not (powershell.file.script_block_text like "*${env:path}*" or powershell.file.script_block_text like "*it will return true or false instead*" or powershell.file.script_block_text like "*The function also prevents `Get-ItemProperty` from failing*" or starts_with(winlog.event_data.Path, "C:\\Program Files\\Microsoft\\Exchange Server\\") and ends_with(winlog.event_data.Path, "\\bin\\servicecontrol.ps1") and powershell.file.script_block_text like "*`r`n*")
