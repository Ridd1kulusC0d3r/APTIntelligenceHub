// User Added To Admin Group Via Sysadminctl | T1078.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_sysadminctl_add_user_to_admin_group.yml
from * metadata _id, _index, _version | where ends_with(Image, "/sysadminctl") and CommandLine like "* -addUser *" and CommandLine like "* -admin *"
