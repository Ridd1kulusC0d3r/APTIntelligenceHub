// Suspicious Parent Double Extension File Execution | T1036.007 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_susp_double_extension_parent.yml
from * metadata _id, _index, _version | where ends_with(process.parent.executable.caseless, ".doc.lnk") or ends_with(process.parent.executable.caseless, ".docx.lnk") or ends_with(process.parent.executable.caseless, ".xls.lnk") or ends_with(process.parent.executable.caseless, ".xlsx.lnk") or ends_with(process.parent.executable.caseless, ".ppt.lnk") or ends_with(process.parent.executable.caseless, ".pptx.lnk") or ends_with(process.parent.executable.caseless, ".rtf.lnk") or ends_with(process.parent.executable.caseless, ".pdf.lnk") or ends_with(process.parent.executable.caseless, ".txt.lnk") or ends_with(process.parent.executable.caseless, ".doc.js") or ends_with(process.parent.executable.caseless, ".docx.js") or ends_with(process.parent.executable.caseless, ".xls.js") or ends_with(process.parent.executable.caseless, ".xlsx.js") or ends_with(process.parent.executable.caseless, ".ppt.js") or ends_with(process.parent.executable.caseless, ".pptx.js") or ends_with(process.parent.executable.caseless, ".rtf.js") or ends_with(process.parent.executable.caseless, ".pdf.js") or ends_with(process.parent.executable.caseless, ".txt.js") or process.parent.command_line like "*.doc.lnk*" or process.parent.command_line like "*.docx.lnk*" or process.parent.command_line like "*.xls.lnk*" or process.parent.command_line like "*.xlsx.lnk*" or process.parent.command_line like "*.ppt.lnk*" or process.parent.command_line like "*.pptx.lnk*" or process.parent.command_line like "*.rtf.lnk*" or process.parent.command_line like "*.pdf.lnk*" or process.parent.command_line like "*.txt.lnk*" or process.parent.command_line like "*.doc.js*" or process.parent.command_line like "*.docx.js*" or process.parent.command_line like "*.xls.js*" or process.parent.command_line like "*.xlsx.js*" or process.parent.command_line like "*.ppt.js*" or process.parent.command_line like "*.pptx.js*" or process.parent.command_line like "*.rtf.js*" or process.parent.command_line like "*.pdf.js*" or process.parent.command_line like "*.txt.js*"
