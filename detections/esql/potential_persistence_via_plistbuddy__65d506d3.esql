// Potential Persistence Via PlistBuddy | T1543.001, T1543.004 | https://github.com/SigmaHQ/sigma/blob/master/rules/macos/process_creation/proc_creation_macos_persistence_via_plistbuddy.yml
from * metadata _id, _index, _version | where ends_with(Image, "/PlistBuddy") and CommandLine like "*RunAtLoad*" and CommandLine like "*true*" and (CommandLine like "*LaunchAgents*" or CommandLine like "*LaunchDaemons*")
