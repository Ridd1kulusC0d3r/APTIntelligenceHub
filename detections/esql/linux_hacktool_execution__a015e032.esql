// Linux HackTool Execution | T1587 | https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_susp_hktl_execution.yml
from * metadata _id, _index, _version | where ends_with(Image, "/crackmapexec") or ends_with(Image, "/havoc") or ends_with(Image, "/merlin-agent") or ends_with(Image, "/merlinServer-Linux-x64") or ends_with(Image, "/msfconsole") or ends_with(Image, "/msfvenom") or ends_with(Image, "/ps-empire server") or ends_with(Image, "/ps-empire") or ends_with(Image, "/sliver-client") or ends_with(Image, "/sliver-server") or ends_with(Image, "/Villain.py") or Image like "*/cobaltstrike*" or Image like "*/teamserver*" or ends_with(Image, "/autorecon") or ends_with(Image, "/httpx") or ends_with(Image, "/legion") or ends_with(Image, "/naabu") or ends_with(Image, "/netdiscover") or ends_with(Image, "/nuclei") or ends_with(Image, "/recon-ng") or Image like "*/sniper*" or ends_with(Image, "/dirb") or ends_with(Image, "/dirbuster") or ends_with(Image, "/eyewitness") or ends_with(Image, "/feroxbuster") or ends_with(Image, "/ffuf") or ends_with(Image, "/gobuster") or ends_with(Image, "/wfuzz") or ends_with(Image, "/whatweb") or ends_with(Image, "/joomscan") or ends_with(Image, "/nikto") or ends_with(Image, "/wpscan") or ends_with(Image, "/aircrack-ng") or ends_with(Image, "/bloodhound-python") or ends_with(Image, "/bpfdos") or ends_with(Image, "/ebpfki") or ends_with(Image, "/evil-winrm") or ends_with(Image, "/hashcat") or ends_with(Image, "/hoaxshell.py") or ends_with(Image, "/hydra") or ends_with(Image, "/john") or ends_with(Image, "/ncrack") or ends_with(Image, "/nxc-ubuntu-latest") or ends_with(Image, "/pidhide") or ends_with(Image, "/pspy32") or ends_with(Image, "/pspy32s") or ends_with(Image, "/pspy64") or ends_with(Image, "/pspy64s") or ends_with(Image, "/setoolkit") or ends_with(Image, "/sqlmap") or ends_with(Image, "/writeblocker") or Image like "*/linpeas*"
