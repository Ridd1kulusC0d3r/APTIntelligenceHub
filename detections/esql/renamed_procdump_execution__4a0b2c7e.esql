// Renamed ProcDump Execution | T1036.003 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_renamed_sysinternals_procdump.yml
from * metadata _id, _index, _version | where (process.pe.original_file_name=="procdump" or (process.command_line like "* -ma *" or process.command_line like "* /ma *" or process.command_line like "* –ma *" or process.command_line like "* —ma *" or process.command_line like "* ―ma *" or process.command_line like "* -mp *" or process.command_line like "* /mp *" or process.command_line like "* –mp *" or process.command_line like "* —mp *" or process.command_line like "* ―mp *") and (process.command_line like "* -accepteula*" or process.command_line like "* /accepteula*" or process.command_line like "* –accepteula*" or process.command_line like "* —accepteula*" or process.command_line like "* ―accepteula*")) and not (ends_with(process.executable.caseless, "\\procdump.exe") or ends_with(process.executable.caseless, "\\procdump64.exe") or ends_with(process.executable.caseless, "\\procdump64a.exe"))
