// Automated Collection Bookmarks Using Get-ChildItem PowerShell | T1217 | https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_get_childitem_bookmarks.yml
from * metadata _id, _index, _version | where powershell.file.script_block_text like "*Get-ChildItem*" and powershell.file.script_block_text like "* -Recurse *" and powershell.file.script_block_text like "* -Path *" and powershell.file.script_block_text like "* -Filter Bookmarks*" and powershell.file.script_block_text like "* -ErrorAction SilentlyContinue*" and powershell.file.script_block_text like "* -Force*"
